---
import PortalLayout from "../../layouts/PortalLayout.astro";
import Card from "../../components/portal/Card.astro";
import EmptyState from "../../components/portal/EmptyState.astro";
import { stats, surprise } from "../../lib/console-api";

const [surpriseResult, statsResult] = await Promise.all([surprise(), stats()]);

const items = surpriseResult.ok ? surpriseResult.data.items : [];
const current = surpriseResult.ok ? surpriseResult.data.current : null;
const statsData = statsResult.ok ? statsResult.data : null;

const surpriseError = !surpriseResult.ok ? surpriseResult.error : null;
---

<PortalLayout title="Surprise" current="surprise">
  <section class="surface">
    <header class="surface-head">
      <div>
        <p class="eyebrow">Surprise</p>
        <h1 class="title">What the brain picked for you</h1>
        {current && (current.bpm || current.key) && (
          <p class="current">
            Current project context: {current.bpm && <span>{current.bpm} BPM</span>}
            {current.key && <span> · {current.key}</span>}
          </p>
        )}
      </div>
      <button type="button" id="refresh" class="refresh">↻ Refresh</button>
    </header>

    {surpriseError && (
      <p class="error" role="alert">
        Couldn't reach the M1 brain ({surpriseError.kind}). Showing what we have.
      </p>
    )}

    {items.length === 0 ? (
      <EmptyState
        title="Nothing to surface yet"
        body={
          "The Surprise picker activates once audio + visual analysis runs. Today the catalog has voice memos with transcripts but no spectral or color signals yet, so the picker has nothing to rank. Use Library to browse the catalog directly."
        }
        stats={statsData}
      />
    ) : (
      <ul class="cards" id="surprise-cards">
        {items.map((item) => (
          <li><Card item={item} reasons={item.reasons} /></li>
        ))}
      </ul>
    )}
  </section>
</PortalLayout>

<script>
  // Refresh button: re-fetch /api/console/surprise and replace the card list.
  // Falls back to a full page reload if the in-place swap can't render.
  const btn = document.getElementById("refresh") as HTMLButtonElement | null;
  if (btn) {
    btn.addEventListener("click", async () => {
      btn.disabled = true;
      btn.textContent = "↻ ...";
      try {
        const res = await fetch("/api/console/surprise", { headers: { accept: "application/json" } });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data = await res.json();
        // Easiest correct rebuild: reload the page so server-rendered cards
        // stay consistent with the rest of the surface. The in-place swap
        // would require re-running the Astro Card component in the browser,
        // which is out of scope for Build 2.
        if (Array.isArray(data?.items)) {
          window.location.reload();
        }
      } catch (e) {
        console.error("[surprise] refresh failed", e);
      } finally {
        btn.disabled = false;
        btn.textContent = "↻ Refresh";
      }
    });
  }
</script>

<style>
  .surface {
    display: grid;
    gap: var(--space-6);
  }

  .surface-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-6);
    flex-wrap: wrap;
  }
  .eyebrow {
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--muted);
  }
  .title {
    font-size: var(--fs-title);
    font-weight: var(--fw-bold);
    letter-spacing: var(--ls-title);
    line-height: var(--lh-title);
    margin-top: var(--space-1);
  }
  .current {
    margin-top: var(--space-2);
    font-size: var(--fs-small);
    color: var(--muted);
  }

  .refresh {
    font: inherit;
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--accent);
    background: transparent;
    border: 1px solid var(--accent);
    padding: var(--space-2) var(--space-4);
    cursor: pointer;
    transition: background-color 200ms ease, color 200ms ease;
  }
  .refresh:hover:not(:disabled),
  .refresh:focus-visible:not(:disabled) {
    background: var(--accent);
    color: var(--bg);
  }
  .refresh:disabled {
    opacity: 0.6;
    cursor: progress;
  }

  .error {
    padding: var(--space-3) var(--space-4);
    border-left: 2px solid var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    font-size: var(--fs-small);
    color: var(--text);
  }

  .cards {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
  }
</style>
