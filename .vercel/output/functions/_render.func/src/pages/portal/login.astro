---
import "@fontsource-variable/geist";
import "../../styles/tokens.css";

const nextParam = Astro.url.searchParams.get("next") ?? "";
const hasError = Astro.url.searchParams.get("error") === "1";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Portal</title>
    <script is:inline>
      // Reuse the public site's theme bootstrap so the login surface matches
      // whatever theme Jon last left the site in. Falls back to Carbon.
      (() => {
        const valid = new Set(["dark", "powder", "field", "honey"]);
        try {
          const stored = localStorage.getItem("theme");
          document.documentElement.dataset.theme =
            stored && valid.has(stored) ? stored : "dark";
        } catch {
          document.documentElement.dataset.theme = "dark";
        }
      })();
    </script>
  </head>
  <body>
    <main class="auth">
      <form method="POST" action="/api/console/login" class="card">
        <p class="eyebrow">The Console</p>
        <h1 class="title">Portal</h1>
        <label class="field">
          <span class="label">Password</span>
          <input
            type="password"
            name="password"
            required
            autocomplete="current-password"
            autofocus
            spellcheck="false"
          />
        </label>
        <input type="hidden" name="next" value={nextParam} />
        <button type="submit">Enter</button>
        {hasError && <p class="error" role="alert">Wrong password.</p>}
      </form>
    </main>

    <style>
      body {
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: var(--space-8);
      }

      .auth {
        width: 100%;
        max-width: 22rem;
      }

      .card {
        display: grid;
        gap: var(--space-5);
        padding: var(--space-8);
        background: var(--bg);
        border: 1px solid var(--line);
      }

      .eyebrow {
        font-size: var(--fs-eyebrow);
        font-weight: var(--fw-semibold);
        letter-spacing: var(--ls-eyebrow);
        text-transform: uppercase;
        color: var(--muted);
      }

      .title {
        font-size: var(--fs-title);
        font-weight: var(--fw-bold);
        letter-spacing: var(--ls-title);
        line-height: var(--lh-title);
      }

      .field {
        display: grid;
        gap: var(--space-2);
      }
      .label {
        font-size: var(--fs-eyebrow);
        font-weight: var(--fw-semibold);
        letter-spacing: var(--ls-eyebrow);
        text-transform: uppercase;
        color: var(--muted);
      }
      input[type="password"] {
        font: inherit;
        color: var(--text);
        background: transparent;
        border: 0;
        border-bottom: 1px solid var(--line);
        padding: var(--space-2) 0;
        outline: none;
      }
      input[type="password"]:focus-visible {
        border-bottom-color: var(--accent);
      }

      button {
        font-size: var(--fs-eyebrow);
        font-weight: var(--fw-semibold);
        letter-spacing: var(--ls-eyebrow);
        text-transform: uppercase;
        color: var(--accent);
        background: transparent;
        border: 1px solid var(--accent);
        padding: var(--space-3) var(--space-4);
        cursor: pointer;
        transition: background-color 200ms ease, color 200ms ease;
      }
      button:hover,
      button:focus-visible {
        background: var(--accent);
        color: var(--bg);
      }

      .error {
        font-size: var(--fs-small);
        color: var(--accent);
      }
    </style>
  </body>
</html>
