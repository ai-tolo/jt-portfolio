{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/console/asset/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/console/asset-meta/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/console/login/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/console/logout/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/console/surprise/?$",
			"dest": "_render"
		},
		{
			"src": "^/portal/library/?$",
			"dest": "_render"
		},
		{
			"src": "^/portal/listen/?$",
			"dest": "_render"
		},
		{
			"src": "^/portal/login/?$",
			"dest": "_render"
		},
		{
			"src": "^/portal/projects/?$",
			"dest": "_render"
		},
		{
			"src": "^/portal/workbench/?$",
			"dest": "_render"
		},
		{
			"src": "^/portal/?$",
			"dest": "_render"
		},
		{
			"src": "^/404/?$",
			"dest": "_render"
		},
		{
			"src": "^/.*$",
			"dest": "_render",
			"status": 404
		}
	]
}