---
import fs from "node:fs/promises";
import path from "node:path";
import Layout from "../../layouts/Layout.astro";
import Footer from "../../components/Footer.astro";
import NotionBlocks from "../../components/NotionBlocks.astro";
import { getCaseStudies, getCaseStudyBySlug } from "../../lib/notion";

export async function getStaticPaths() {
  const studies = await getCaseStudies();
  return studies.map((s) => ({ params: { slug: s.slug } }));
}

const { slug } = Astro.params;
const study = await getCaseStudyBySlug(slug!);
if (!study) throw new Error(`Case study not found: ${slug}`);

const num = String(study.order).padStart(2, "0");
const description = study.subtitle || study.outcome;

// Bottom-of-page gallery: any media file dropped into
// public/case-studies/[slug]/ shows up automatically, sorted by filename.
// Excludes notion-prefixed files — those are inline images downloaded from
// Notion blocks by the prebuild script, and they render inline within the
// body, not in this gallery.
const galleryDir = path.join(process.cwd(), "public", "case-studies", slug!);
let galleryFiles: string[] = [];
try {
  const entries = await fs.readdir(galleryDir);
  galleryFiles = entries
    .filter((f) => /\.(png|jpg|jpeg|gif|webp|mp4|webm)$/i.test(f))
    .filter((f) => !f.startsWith("notion-"))
    .sort();
} catch {
  // No gallery folder for this slug. That's fine.
}
const isVideo = (f: string) => /\.(mp4|webm)$/i.test(f);
---

<Layout title={`${study.name} — Jon Tollefson`} description={description}>
  <main class="cs">
    <header class="cs-header">
      <div class="inner">
        <a class="back" href="/">← Index</a>

        <p class="num">Case Study {num}</p>
        <h1 class="title">{study.name}</h1>
        <p class="subtitle">{study.subtitle}</p>

        <dl class="meta">
          {study.role && (
            <div>
              <dt>Role</dt>
              <dd>{study.role}</dd>
            </div>
          )}
          {study.timeline && (
            <div>
              <dt>Timeline</dt>
              <dd>{study.timeline}</dd>
            </div>
          )}
          {study.tools.length > 0 && (
            <div>
              <dt>Tools</dt>
              <dd>{study.tools.join(", ")}</dd>
            </div>
          )}
          {study.tags.length > 0 && (
            <div>
              <dt>Tags</dt>
              <dd>{study.tags.join(" · ")}</dd>
            </div>
          )}
        </dl>

        {study.cover && (
          <figure class="cover">
            <img src={study.cover} alt={`${study.name} cover`} />
          </figure>
        )}
      </div>
    </header>

    <article class="cs-body">
      <div class="inner">
        <NotionBlocks blocks={study.blocks} />
      </div>
    </article>

    {galleryFiles.length > 0 && (
      <section class="visuals" aria-labelledby="visuals-label">
        <div class="inner">
          <p id="visuals-label" class="eyebrow">Visuals</p>
          <ul class="gallery">
            {galleryFiles.map((f) => (
              <li class="gallery-item">
                {isVideo(f) ? (
                  <video
                    src={`/case-studies/${slug}/${f}`}
                    controls
                    muted
                    loop
                    playsinline
                    preload="metadata"
                  ></video>
                ) : (
                  <img
                    src={`/case-studies/${slug}/${f}`}
                    alt=""
                    loading="lazy"
                  />
                )}
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    <nav class="cs-nav">
      <div class="inner">
        <a class="back" href="/#work">← Back to selected work</a>
      </div>
    </nav>
  </main>

  <Footer />
</Layout>

<style>
  .cs {
    padding-top: var(--space-8);
  }

  .cs-header {
    padding: var(--space-12) 0 var(--space-16);
  }
  .back {
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--accent);
    display: inline-block;
    margin-bottom: var(--space-16);
  }
  .back:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .num {
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: var(--space-4);
  }
  .title {
    font-size: clamp(3rem, 8vw, 5.5rem);
    font-weight: var(--fw-bold);
    letter-spacing: var(--ls-display);
    line-height: 0.95;
    margin-bottom: var(--space-4);
  }
  .subtitle {
    font-size: clamp(1.25rem, 2vw, 1.625rem);
    line-height: 1.3;
    color: var(--muted);
    max-width: 48ch;
    margin-bottom: var(--space-12);
  }

  .meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: var(--space-6);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding: var(--space-6) 0;
    margin-bottom: var(--space-16);
  }
  .meta div {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .meta dt {
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--muted);
  }
  .meta dd {
    margin: 0;
    font-size: 0.9375rem;
  }

  .cover {
    margin: 0;
  }
  .cover img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    background: var(--surface-1);
  }

  .cs-body {
    padding-bottom: var(--space-16);
  }

  /* Visuals gallery — pulls any file from /public/case-studies/[slug]/ */
  .visuals {
    padding: var(--space-12) 0 var(--space-16);
    border-top: 1px solid var(--line);
  }
  .visuals .eyebrow {
    margin-bottom: var(--space-8);
  }
  .gallery {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }
  .gallery-item {
    background: var(--surface-1);
    overflow: hidden;
    transition: background-color 280ms ease;
  }
  .gallery-item img,
  .gallery-item video {
    width: 100%;
    height: auto;
    display: block;
  }

  @media (min-width: 56rem) {
    .gallery {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-12);
    }
    /* Promote the first item to full-width hero */
    .gallery-item:first-child {
      grid-column: 1 / -1;
    }
  }

  .cs-nav {
    padding: var(--space-12) 0;
    border-top: 1px solid var(--line);
  }
</style>
