---
// RAYLU — the case study in the WORK room's material (Stream C, 2026-10-06), on CHS's frame. The reader opens the
// file the founders carried into their pitch meetings: the lead object is that file (RySet: five pages, each a
// canvas of its components; the hi-fi page is the product's primitives in their states), then the one number set
// apart, then the slice surface an investor operated mid-demo (RyLasso, behaviour unchanged from the old page), then
// the story card with UNDER THE HOOD folded inside. Every fact is the old page's; nothing new is claimed.
import Room from "../../components/case-study/room/Room.astro";
import RoomStory from "../../components/case-study/room/RoomStory.astro";
import RySet from "../../components/case-study/room/RySet.astro";
import RyLasso from "../../components/case-study/room/RyLasso.astro";
import "../../components/case-study/room/ry-tokens.css";

export const prerender = true;

// DRAFT (Jon edits): the read: second person, moments not topics
const BLOCKS = [
  { h: "You just got the link", p: "One file opens, each page dated as it was added. It ran demos without me there, and the founders could update the pitch on their own." },
  { h: "The product was in their heads", p: "Two founders, a deep ML product, nothing an investor could hold. The brief was to make it readable enough to fund and build. A sketch over Zoom in the morning, a clickable frame back that afternoon." },
  { h: "An investor makes a slice", p: "The prototype had to make an ML primitive legible to a non-engineer mid-demo: drag a box around a cluster and it becomes a named slice." },
  { h: "What followed", p: "The file went into engineering. Conversion Capital and Unusual Ventures led the seed, with angels including Arash Ferdowsi. I claim no causal chain. Raylu has since pivoted to AI sourcing for private-market investors, and raised an $8M Series A in late 2025." },
];

// DRAFT (Jon edits) · UNDER THE HOOD: true facts from the old page only (the outcome rides in the number line and the last moment)
const HOOD = [
  { k: "role", tool: "sole designer", html: "Six months of work, on and off, from January to October 2023." },
  { k: "the file", tool: "Figma", html: "Investor deck, product spec, engineering handoff and brand bible in one navigable workspace." },
  { k: "prototypes", tool: "Figma · Zoom", html: "Clickable hi-fi, its component patterns mapped 1:1 to the React build." },
];
---

<Room
  title="Raylu — Jonathan Tollefson"
  description="The brand and the clickable prototypes for Raylu, then an ML-tooling startup, in one Figma file the founders carried into the pitch meetings for their seed round."
  label="raylu · 2023"
  hook="I designed the Figma file Raylu, then an ML-tooling startup, carried into its seed pitch meetings."
  cls="ry"
>
  {/* DRAFT (Jon edits): the caption */}
  <figure class="rm-object">
    <RySet />
    <figcaption class="rm-cap">The file's five pages. The last one holds the prototype's components, each in its states.</figcaption>
  </figure>

  {/* DRAFT (Jon edits): the number line */}
  <p class="rm-number"><b>$4M</b><span>Raylu's seed round, closed in 2023</span></p>

  {/* DRAFT (Jon edits): the caption */}
  <figure class="rm-object">
    <RyLasso />
    <figcaption class="rm-cap">A screen from the clickable prototype. Drag a box around the green cluster, or press Enter.</figcaption>
  </figure>

  <RoomStory name="Raylu" blocks={BLOCKS} hood={HOOD} accent="#258c79" />
</Room>
