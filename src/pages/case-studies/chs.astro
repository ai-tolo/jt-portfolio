---
// CHS — the case study in the WORK room's material (Stream C, 2026-10-05). The reader is the non-technical employee
// who logs in lost; the page leads with the thing they put their hands on (the docs assistant, rebuilt as one product
// object: pick a role → the starters → a run), then THE SYSTEM (the design-system sheet behind it, inspectable, its
// tokens really driving the components), then the story card with UNDER THE HOOD folded inside. Art, not reality: the
// roles, the starters and the runs are invented examples that carry the story; the system facts are true.
import Room from "../../components/case-study/room/Room.astro";
import RoomStory from "../../components/case-study/room/RoomStory.astro";
import ChsTool from "../../components/case-study/room/ChsTool.astro";
import ChsSystem from "../../components/case-study/room/ChsSystem.astro";
import "../../components/case-study/room/chs-tokens.css";

export const prerender = true;

// the read: second person, moments not topics, half the words of the page it replaces
const BLOCKS = [
  { h: "You just got access", p: "You open the company's new AI platform and have no idea where to start. You should never need to know what an embedding is to get value from it." },
  { h: "You ask the docs", p: "When people didn't get it, the team's first reflex was more documentation. I put the docs inside the platform instead, as a chat that works like everything else there, so you learn it by using it." },
  { h: "The assistant starts with your job", p: "Research with the 250-person beta kept turning up three questions: what does this do for <em>my</em> job, how is it different from the GPT license I already have, and why does a knowledge base mean a ticket to engineering?" },
  { h: "What shipped", p: "The platform has been rolling out across the company since its March 2026 launch. Teams build their own models on internal data without engineering, and other internal tools have started to adopt its design system." },
];

// UNDER THE HOOD: the system facts, stage by stage (true; numbers real or absent)
const HOOD = [
  { k: "platform", tool: "Open WebUI", html: "Hosted on Azure, with knowledge bases, custom models, function calling and access to CHS data." },
  { k: "research", tool: "beta", html: "Biweekly sessions before launch." },
  { k: "surface", tool: "four patterns", html: "Task-flow docs, starter templates, messaging on how it differs from GPT, and the docs assistant above." },
  { k: "role", tool: "sole UX", html: "Embedded with engineering, November 2025 to now." },
];
---

<Room
  title="CHS — Jonathan Tollefson"
  description="I'm the only UX designer on the internal AI platform at CHS, a 10,000-person farm cooperative: its docs assistant and the design system behind it."
  label="chs · 2025 – now"
  hook="I design the internal AI platform at CHS, a 10,000-person farm cooperative."
  cls="chs"
>
  <figure class="rm-object">
    <ChsTool />
    <figcaption class="rm-cap">The platform's docs assistant. Pick a role, then run one of its starters.</figcaption>
  </figure>

  <p class="rm-number"><b>0</b><span>knowledge bases that needed a ticket to engineering since launch; in the beta, every one did</span></p>

  <figure class="rm-object">
    <ChsSystem />
    <figcaption class="rm-cap">The assistant's design system. Its tokens drive the window above and every component here, in either theme.</figcaption>
  </figure>

  <RoomStory name="CHS" blocks={BLOCKS} hood={HOOD} accent="#2a62d9" />
</Room>
