---
// CHS — the case study in the WORK room's material (Stream C, 2026-10-05). The reader is the non-technical employee
// who logs in lost; the page leads with the thing they put their hands on (the docs assistant, rebuilt as one product
// object: pick a role → the starters → a run), then THE SYSTEM (the design-system sheet behind it, inspectable, its
// tokens really driving the components), then the story card with UNDER THE HOOD folded inside. Art, not reality: the
// roles, the starters and the runs are invented examples that carry the story; the system facts are true.
import Room from "../../components/case-study/room/Room.astro";
import RoomStory from "../../components/case-study/room/RoomStory.astro";
import ChsTool from "../../components/case-study/room/ChsTool.astro";
import ChsSystem from "../../components/case-study/room/ChsSystem.astro";
import "../../components/case-study/room/chs-tokens.css";

export const prerender = true;

// the read: second person, moments not topics, half the words of the page it replaces
const BLOCKS = [
  { h: "You just got access", p: "The invite lands. The platform opens: it can build knowledge bases, train models on internal data, call functions, query CHS data. You have no idea where to start, and you should never need to know what an embedding is to get value from AI at work." },
  { h: "The gap was never the model", p: "I was the sole UX function on the platform team, embedded with engineering. When people didn't get it, the team's reflex was more docs. Mine was the opposite: the problem was the distance between what the platform could do and what you'd think to <em>ask</em>." },
  { h: "It already speaks your job", p: "Research with the 250-person beta kept surfacing three frictions, none about the model: what does this do for <em>my</em> job, how is it different from the GPT license I already have, and why does a knowledge base mean a ticket to engineering. So the assistant meets you at your role. Its starters are your real jobs, and the docs are the tool: you learn the model by using it." },
  { h: "What shipped", p: "Rolling across the company since the March launch. Teams stand up custom models on internal data themselves, first try, and other internal tools on Open WebUI have started inheriting the surface as their design system. The bottleneck is rarely the AI. It is the comprehension surface between capability and audience." },
];

// UNDER THE HOOD: the system facts, stage by stage (true; numbers real or absent)
const HOOD = [
  { k: "platform", tool: "Open WebUI", html: "An internal AI platform on Open WebUI over Azure: knowledge bases, custom models, function calling, CHS data, for a 10,000-person cooperative." },
  { k: "research", tool: "beta", html: "Biweekly sessions with a 250-person pre-launch beta, already licensed for GPT Enterprise: power users in name, a diagnostic cohort in practice." },
  { k: "surface", tool: "four patterns", html: "Task-flow docs, starter templates, differentiation messaging and a dogfooded docs-chat, built so the docs and the platform are the same gesture." },
  { k: "design", tool: "Figma", html: "Role-aware starters, the chat as the teaching surface, and a component set other internal tools now inherit." },
  { k: "measure", tool: "tickets", html: "The setup friction that defined the beta, a back-channel ping to engineering for every custom knowledge base, went to zero after launch." },
  { k: "role", tool: "sole UX", html: "Sole UX function, embedded with engineering, November 2025 to now; launched March 2026." },
];
---

<Room
  title="CHS — Jonathan Tollefson"
  description="Teaching AI to 10,000 employees: the comprehension surface between an internal AI platform and the people who had to use it, and the design system behind it."
  label="chs · 2025 – now"
  hook="Teaching AI to 10,000 employees."
  cls="chs"
>
  <figure class="rm-object">
    <ChsTool />
    <figcaption class="rm-cap">The docs assistant. Pick your role on the left; the starters are your real jobs. Run one.</figcaption>
  </figure>

  <p class="rm-number"><b>0</b><span>back-channel pings to engineering since launch</span></p>

  <figure class="rm-object">
    <ChsSystem />
    <figcaption class="rm-cap">The system behind it. The tokens drive every component on this page; flip the theme and watch them follow.</figcaption>
  </figure>

  <RoomStory name="CHS" blocks={BLOCKS} hood={HOOD} accent="#2a62d9" />
</Room>
