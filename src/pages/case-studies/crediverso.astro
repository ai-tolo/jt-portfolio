---
// Crediverso — the case study in the WORK room's material (Stream C, 2026-10-06). The reader is the Garcia who was
// invited in; the page leads with the thing they put their hands on (THE DOOR: the bilingual app as one phone, the
// "send your cousin $200" flow walked before and after, the tie that opens once both are walked), then the one number,
// then the story card with UNDER THE HOOD folded inside. Art, not reality: Juan, the balances and the cousin are the
// old mock's example; the facts in the story and the hood are the old page's own (no new numbers, no new dates).
import Room from "../../components/case-study/room/Room.astro";
import RoomStory from "../../components/case-study/room/RoomStory.astro";
import CvDoor from "../../components/case-study/room/CvDoor.astro";
import "../../components/case-study/room/cv-tokens.css";

export const prerender = true;

// DRAFT (Jon edits) · the read: second person, moments not topics
const BLOCKS = [
  { h: "Someone in your family brought you in", p: "The launch screen has the two buttons every bank has, then a third most banks would never ship: <em>I was invited by family</em>. Someone in your household already banks here. That line is the product." },
  { h: "Your cousin needs $200", p: "Two navs: family behind a tab in seven taps, or on the home in five. Both got real SWOTs; the matrix ran even. Fewer taps looked like the answer. That was the trap; the thesis broke the tie." },
  { h: "Maria reads in Spanish", p: "Maria, who invited you in, reads in Spanish, which runs about 25 to 30% longer. Every screen was laid out for her string first. Bilingual was never a translation pass; it set the hierarchy." },
  { h: "The door you walked through", p: "V1 shipped on iOS in November 2022, bilingual across every flow, family on the home, Move Money its own surface. The front door stopped losing people." },
];

// DRAFT (Jon edits) · UNDER THE HOOD: true facts from the old page only
const HOOD = [
  { k: "role", tool: "Figma · Jira · Slack", html: "UX design lead, three-person design team, February 2021 to November 2022; onboarding and credit card flows." },
  { k: "research", tool: "Zoom", html: "Interviews, analytics, social listening, teardowns, three avatars, 50+ usability participants. 79% say sending money home matters; 41M Americans are Spanish-dominant; 81% ask relatives to research purchases." },
  { k: "bilingual", tool: "ES first", html: "Spanish runs ~25–30% longer; layouts hold it." },
  { k: "family cards", tool: "Figma", html: "The household as a product object: a card each, funds moving between them." },
  { k: "the decision", tool: "SWOT", html: "7 taps against 5. Identity broke the tie: Combined, with Move Money its own surface." },
  { k: "shipped", tool: "iOS", html: "November 2022. Bounce 40% → 25%; the channel 700 → 2,100 before launch, on A/B-tested messaging; Figma primitives carried the next partner product." },
];
---

<Room
  title="Crediverso — Jonathan Tollefson"
  description="A bilingual bank where family is the front door: the onboarding and the nav decision behind it, walked before and after."
  label="crediverso · 2021 – 2022"
  hook="A bank you walk into through your family."
  cls="crediverso"
>
  <figure class="rm-object">
    <CvDoor />
    {/* DRAFT (Jon edits) */}
    <figcaption class="rm-cap">Send your cousin $200 both ways, in either language, then ship the nav you would.</figcaption>
  </figure>

  <p class="rm-number"><b>40 → 25 %</b><span>bounce at the front door, before and after the onboarding shipped</span></p>

  <RoomStory name="Crediverso" blocks={BLOCKS} hood={HOOD} accent="#5b54d6" />
</Room>

