---
// Crediverso — a bilingual bank where family is a product primitive. The
// spine: when two equally defensible options run even on the matrix, the
// product's identity breaks the tie. Theatrical build — the product speaks
// before Jon does.
//
//   00 · Cold open — the launch screen recreated in CSS; on scroll-in, the
//        third CTA ("I was invited by family") steps forward as the thesis.
//   01 · The pitch — lean. The tiebreaker pullquote lands as a setpiece.
//   02 · The research debrief — three findings arrive on a beat, tied to Mateo.
//   03 · Bilingual, lived — one UI string morphs EN→ES on scroll.
//   04 · Family as a primitive.
//   05 · The nav-bar SWOT — the participatory decision (the star).
//   06 · What shipped.
//   07 · What generalizes.
//
// Honors prefers-reduced-motion; all motion is IntersectionObserver-gated
// with a setTimeout fallback so headless/throttled tabs still resolve.

import CSLayout from "../../components/case-study/CSLayout.astro";
import CSHero from "../../components/case-study/CSHero.astro";
import CSSection from "../../components/case-study/CSSection.astro";
import CSPullquote from "../../components/case-study/CSPullquote.astro";
import CSStatGrid from "../../components/case-study/CSStatGrid.astro";
import CSLiveDemo from "../../components/case-study/CSLiveDemo.astro";
import CSFigure from "../../components/case-study/CSFigure.astro";
import CrediversoNavSwot from "../../components/case-study/showcase/CrediversoNavSwot.astro";

export const prerender = true;
---

<CSLayout
  title="Crediverso — Jon Tollefson"
  description="A bilingual bank where family is a product primitive, not a footnote. V1 of an iOS mobile banking app for the US Hispanic community."
  ogImage="/case-studies/crediverso/cover.png"
>
  <CSHero
    eyebrow="Case study 04 · February 2021 — November 2022"
    title="Crediverso"
    subtitle="A bilingual bank where family isn't a feature. It's the first thing you tap."
    cover="/case-studies/crediverso/cover.png"
    meta={[
      { label: "Role", value: "Designer · onboarding + credit card flows" },
      { label: "Timeline", value: "Feb 2021 — Nov 2022 (14-month V1)" },
      { label: "Team", value: "Three-person design team" },
      { label: "Outcome", value: "Shipped iOS · 15% bounce drop · 125% pre-launch growth" },
    ]}
  />

  {/* ─────── 00 · COLD OPEN — THE LAUNCH SCREEN ─────── */}
  <section class="cv-open" aria-label="The Crediverso launch screen" data-cv-open>
    <div class="cv-open-inner">
      <p class="cv-open-eyebrow">Before I say anything — look at the launch screen.</p>

      <div class="cv-launch" data-cv-launch>
        <div class="cv-launch-phone">
          <div class="cv-launch-photo" aria-hidden="true">
            <span class="cv-launch-photo-grain"></span>
          </div>
          <div class="cv-launch-sheet">
            <div class="cv-launch-mark">
              <span class="cv-launch-logo" aria-hidden="true"></span>
              <span class="cv-launch-word">crediverso</span>
            </div>
            <p class="cv-launch-tag">The First Bank for Latinos</p>

            <button type="button" class="cv-cta cv-cta-signup" tabindex="-1">Sign Up</button>
            <button type="button" class="cv-cta cv-cta-login" tabindex="-1">Log In</button>
            <button type="button" class="cv-cta cv-cta-family" data-cv-family tabindex="-1">
              I was invited by family
            </button>
          </div>
        </div>

        <div class="cv-open-read">
          <p class="cv-open-read-1">Two buttons you'd expect on any bank.</p>
          <p class="cv-open-read-2">
            And a third, smaller one most banks would never ship:
            <span class="cv-open-read-em">someone in your family already has an account, and they brought you in.</span>
          </p>
          <p class="cv-open-read-3">
            That line is the entire thesis, rendered in UI. Family isn't a feature
            bolted onto a banking app. It's the door.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* ─────── 01 · THE PITCH ─────── */}
  <CSSection num="01" title="The first credit checks in Spanish — then a whole bank" deck="Crediverso was the first US company to offer free credit checks in Spanish. The next move was an all-in-one bilingual bank for the same audience. I joined eight months in — three of us shipping V1 over fourteen months." noTopRule>
    <div class="prose-block">
      <p>The mandate was simple to say, hard to ship: a bilingual banking product for US Hispanic households, a market failed by fragmented, English-only financial tooling. The hard calls were never <em>whether</em> to ship bilingual. They were about which product identity drives a screen's hierarchy when two options are equally defensible.</p>

      <CSPullquote hero>
        When SWOTs resolve evenly, the tiebreaker is rarely "best UX." It's "which option reinforces the product's identity."
      </CSPullquote>

      <p>This is the story of one such call — the V1 nav bar — and the move I keep coming back to.</p>
    </div>

    <CSStatGrid
      stats={[
        { n: 14, label: "months, brief to App Store", color: "white" },
        { n: 3, label: "designers on the system team", color: "cyan" },
        { n: 15, label: "drop in primary-flow bounce", suffix: "%", color: "yellow" },
        { n: 125, label: "follower growth before launch", suffix: "%", color: "pink" },
      ]}
    />
  </CSSection>

  {/* ─────── 02 · THE RESEARCH DEBRIEF ─────── */}
  <CSSection num="02" title="What the research kept saying" deck="Zoom interviews, web analytics, social listening, competitor teardowns — synthesized into three avatars. Mateo was the gap-test: a user who feels at home in English is the wrong default for this product. Three findings set the V1 direction.">
    <div class="cv-debrief" data-cv-debrief>
      <figure class="cv-debrief-persona">
        <img
          src="/case-studies/crediverso/notion-35fed8d4704f802aaba4fabba59d3f49.png"
          alt="Mateo customer avatar card. Quotes: 'I had to apply for a credit card for my mom because she doesn't speak English.' 'I'm constantly researching remittance options to send money to my family.' Profile: 20-35, Mexico/Cuba/Puerto Rico, college-educated, $50-70k. Behavior: watches Univision and Telemundo, limited financial literacy."
          loading="lazy"
        />
        <figcaption>Mateo applied for a credit card <em>for his mom</em>. The avatar that kept the bilingual question honest.</figcaption>
      </figure>

      <ol class="cv-debrief-findings">
        <li class="cv-finding" data-cv-finding style="--i:0">
          <span class="cv-finding-n"><b data-cv-count data-to="79" data-suffix="%">0</b></span>
          <div class="cv-finding-body">
            <strong>say sending money home matters.</strong>
            <span>75% already use remittance services. Remittance is a primary banking job here — not an edge feature.</span>
          </div>
        </li>
        <li class="cv-finding" data-cv-finding style="--i:1">
          <span class="cv-finding-n"><b data-cv-count data-to="41" data-suffix="M">0</b></span>
          <div class="cv-finding-body">
            <strong>Americans are Spanish-dominant.</strong>
            <span>Preference for Spanish rises sharply as financial terminology gets denser. Bilingual is a core requirement, not a translation pass.</span>
          </div>
        </li>
        <li class="cv-finding" data-cv-finding style="--i:2">
          <span class="cv-finding-n"><b data-cv-count data-to="81" data-suffix="%">0</b></span>
          <div class="cv-finding-body">
            <strong>ask relatives to research purchases for them.</strong>
            <span>Financial decisions in this market are family-coordinated, not individual. That reframes the whole product.</span>
          </div>
        </li>
      </ol>
    </div>
  </CSSection>

  {/* ─────── 03 · BILINGUAL, LIVED ─────── */}
  <CSSection num="03" title="Bilingual isn't a translation layer" deck="Spanish at every step — not a pass over English screens. The information hierarchy of every screen has to breathe for the longer language. You can read that decision, or you can watch it happen.">
    <CSLiveDemo
      label="SCROLL · WATCH IT SWITCH"
      caption="The Family Card header, rendered both ways. Spanish runs ~25-30% longer than English here — the layout, the type, the wrapping all have to hold for the longer string. Designing for the longer language first is the difference between a product that works in two languages and one that feels designed in one."
      bleed
      pad="comfy"
    >
      <div class="cv-bili" data-cv-bili>
        <div class="cv-bili-phone">
          <span class="cv-bili-lang" data-cv-bili-lang>EN</span>
          <div class="cv-bili-card">
            <span class="cv-bili-eyebrow">FAMILY CARD</span>
            <h3 class="cv-bili-headline">
              <span class="cv-bili-en" data-cv-bili-en>Send money to the people who count on you.</span>
              <span class="cv-bili-es" data-cv-bili-es aria-hidden="true">Envía dinero a las personas que cuentan contigo.</span>
            </h3>
            <div class="cv-bili-row">
              <span class="cv-bili-avatars">👤👤👤👤</span>
              <span class="cv-bili-amt">$5,000.00</span>
            </div>
            <span class="cv-bili-btn" data-cv-bili-btn>
              <span data-cv-bili-en-btn>Move money</span>
              <span data-cv-bili-es-btn aria-hidden="true">Enviar dinero</span>
            </span>
          </div>
        </div>
        <p class="cv-bili-side">The information hierarchy has to breathe for the longer language.</p>
      </div>
    </CSLiveDemo>
  </CSSection>

  {/* ─────── 04 · FAMILY AS PRIMITIVE ─────── */}
  <CSSection num="04" title="Family as a primitive, not a footnote" deck="Family Cards turned household structure into a product object. Each member gets a card. Funds move between cards. The primary user sees their account and the family group at the same altitude — because that's how a Hispanic household reads 'this is mine, that is ours.'">
    <CSFigure
      src="/case-studies/crediverso/notion-35fed8d4704f80579fadcbd9b39006da.png"
      alt="A Garcia Family card annotated. Family balance $5,000.00 in a purple gradient surface. Avatar row of four members. Primary user: Harris. Buttons: Transactions and Spending Charts. Annotations: 'Contact photos similar to Apple OS makes for easy group visualization', 'Hidden menu to easily delete or edit family accounts', 'Key features clear and accessible.'"
      caption="The contact-photo affordance and the hidden three-dot menu aren't decoration. Family Cards became a primitive every later partner-product surface inherited as the app grew."
      width="wide"
      framed
    />
  </CSSection>

  {/* ─────── 05 · THE NAV-BAR SWOT (the star) ─────── */}
  <CSSection num="05" title="The decision the matrix couldn't make" deck="Split (a dedicated Family tab) or Combined (one Accounts surface, family on the home screen). Both defensible. Both got real SWOTs. Look at each one — the tiebreaker stays sealed until you've seen both.">
    <CSLiveDemo
      label="LIVE · YOU BREAK THE TIE"
      caption="The matrix ran even — Split optimized for single-user clarity, Combined for fewer taps. Tap-count favored Combined, but tap-count isn't what decided it. The decision resolved on the thesis."
      bleed
      pad="comfy"
    >
      <CrediversoNavSwot />
    </CSLiveDemo>

    <div class="prose-block">
      <p>The pattern carries. Should a third-party flow open inline or in a sheet? If the matrix runs even, the question becomes <em>which choice reads more like Crediverso.</em> Identity becomes load-bearing.</p>
    </div>
  </CSSection>

  {/* ─────── 06 · WHAT SHIPPED ─────── */}
  <CSSection num="06" title="What shipped" deck="V1 launched on iOS in November 2022 with full bilingual coverage across every flow. Onboarding and credit card surfaces were mine end-to-end. Family Cards, Move Money, and the Accounts home came out of the system team.">
    <CSFigure
      src="/case-studies/crediverso/notion-35fed8d4704f8093b5a2ebcea6b34fb3.png"
      alt="The Add Family Members screen. Headline: Invite Family Members. Avatar list of three members already linked: Harris (you), Maria (Mother), Jose (Father). Below: Invite new Crediverso Users form with a full-name input and a phone field with US flag. Primary action: Invite Member."
      caption="Inviting family ships in V1, inside Accounts — no separate research step on remittance rates. The act of inviting is the act of moving money."
      width="wide"
      framed
    />

    <CSStatGrid
      stats={[
        { n: 50, label: "usability test participants", suffix: "+", color: "white" },
        { n: 15, label: "drop in primary-flow bounce", suffix: "%", color: "yellow" },
        { n: 700, label: "followers pre-A/B-tested launch", color: "cyan" },
        { n: 2100, label: "followers at App Store release", color: "pink" },
      ]}
    />

    <div class="prose-block">
      <p>The 50-participant round validated the primary flows. A/B-tested launch messaging grew the channel 125% before the App Store hit. The Figma primitives built around the multi-product structure carried the next partner product into design with no redesign.</p>
    </div>
  </CSSection>

  {/* ─────── 07 · WHAT GENERALIZES ─────── */}
  <CSSection num="07" title="What generalizes" deck="Two things I'd carry into any product serving a multi-context audience.">
    <ul class="generalize">
      <li>
        <strong>The thesis is the tiebreaker.</strong>
        When two options run even on the matrix, the question becomes "which one reads more like the product we said we'd build." Not a UX heuristic — the only honest answer when the UX answer is "both."
      </li>
      <li>
        <strong>Bilingual is worth a second pass.</strong>
        Treating Spanish as a translation layer ships a product that works in two languages but feels designed in one. Treating it as a core requirement shapes every screen's hierarchy. That generalizes to any audience that moves between contexts.
      </li>
    </ul>

    <div class="prose-block">
      <p class="muted">Credit to my Crediverso collaborators on design, product, engineering, and marketing — and to the family of avatars (Juan, Mateo, Maria) who anchored every sprint.</p>
    </div>
  </CSSection>

  <div class="cs-foot">
    <a href="/#work" class="cs-foot-back">← back to selected work</a>
  </div>
</CSLayout>

<script>
  // ── 00 · the cold-open launch screen ──────────────────────────────────
  // On scroll-in, the third CTA ("I was invited by family") steps forward —
  // it sharpens, scales, glows — while the two ordinary buttons recede.
  (() => {
    const launch = document.querySelector<HTMLElement>("[data-cv-launch]");
    if (!launch) return;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const fire = () => launch.classList.add("isolate");

    if (reduce) {
      fire();
      return;
    }

    const io = new IntersectionObserver(
      (entries, obs) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            fire();
            obs.disconnect();
          }
        }
      },
      { threshold: 0.55 },
    );
    io.observe(launch);
    // Fallback: if the observer never fires (throttled/headless tab), force the
    // resolved state so the thesis never gets stuck blurred.
    window.setTimeout(fire, 2600);
  })();

  // ── 02 · the research debrief ─────────────────────────────────────────
  // Findings arrive one at a time on a beat; each number counts up and its
  // human context fades in just after.
  (() => {
    const debrief = document.querySelector<HTMLElement>("[data-cv-debrief]");
    if (!debrief) return;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const findings = Array.from(debrief.querySelectorAll<HTMLElement>("[data-cv-finding]"));

    const countUp = (el: HTMLElement) => {
      const to = Number(el.dataset.to || "0");
      const suffix = el.dataset.suffix || "";
      const final = `${to}${suffix}`;
      if (reduce) { el.textContent = final; return; }
      const ms = 900;
      const start = performance.now();
      const tick = (now: number) => {
        const t = Math.min(1, (now - start) / ms);
        const eased = 1 - Math.pow(1 - t, 3);
        el.textContent = `${Math.round(to * eased)}${suffix}`;
        if (t < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
      // Guarantee the final value even if rAF is throttled.
      window.setTimeout(() => { el.textContent = final; }, ms + 140);
    };

    const revealAll = () => {
      findings.forEach((f, idx) => {
        const num = f.querySelector<HTMLElement>("[data-cv-count]");
        const run = () => {
          f.classList.add("in");
          if (num) countUp(num);
        };
        if (reduce) { run(); return; }
        window.setTimeout(run, idx * 520);
      });
    };

    let done = false;
    const fire = () => { if (done) return; done = true; revealAll(); };

    if (reduce) { fire(); return; }
    const io = new IntersectionObserver(
      (entries, obs) => {
        for (const e of entries) {
          if (e.isIntersecting) { fire(); obs.disconnect(); }
        }
      },
      { threshold: 0.3 },
    );
    io.observe(debrief);
    // Fallback so the numbers never sit at 0 in a throttled tab.
    window.setTimeout(fire, 2800);
  })();

  // ── 03 · the bilingual scroll-morph ───────────────────────────────────
  // One UI string lives in English, then crossfades to Spanish as the reader
  // scrolls past a threshold. The language tag flips with it.
  (() => {
    const bili = document.querySelector<HTMLElement>("[data-cv-bili]");
    if (!bili) return;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const tag = bili.querySelector<HTMLElement>("[data-cv-bili-lang]");

    const toSpanish = () => {
      bili.classList.add("es");
      if (tag) tag.textContent = "ES";
    };

    if (reduce) {
      // No scroll choreography — show the decision plainly in Spanish (the
      // longer string the layout was designed around).
      toSpanish();
      return;
    }

    const toEnglish = () => {
      bili.classList.remove("es");
      if (tag) tag.textContent = "EN";
    };

    // Flip when the demo crosses the vertical center of the viewport. A symmetric
    // -45%/-45% rootMargin collapses the root to a thin mid-screen band, so the
    // trigger is independent of the element's height (robust on tall mobile
    // layouts where a 0.6 visibility ratio is never reachable). Scrolling back
    // up above the band un-flips, so the morph replays.
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            toSpanish();
          } else if (e.boundingClientRect.top > 0) {
            // left the band downward (element now below center) → reset to EN
            toEnglish();
          }
        }
      },
      { rootMargin: "-45% 0px -45% 0px", threshold: 0 },
    );
    io.observe(bili);
    // Fallback: ensure the Spanish state is reachable in a throttled tab.
    window.setTimeout(() => {
      if (!bili.classList.contains("es")) {
        const r = bili.getBoundingClientRect();
        if (r.top < window.innerHeight * 0.5) toSpanish();
      }
    }, 3000);
  })();
</script>

<style>
  .prose-block { max-width: 64ch; }
  .prose-block > .cs-pullquote { max-width: 64ch; }
  .prose-block .muted { color: rgba(245, 241, 232, 0.48); font-size: 14.5px; }
  .prose-block em { font-style: italic; color: var(--cs-text); }

  /* ───────────────────── 00 · COLD OPEN ───────────────────── */
  .cv-open {
    padding: 56px 0 24px;
  }
  .cv-open-inner {
    max-width: 1160px;
    margin: 0 auto;
    padding: 0 32px;
  }
  .cv-open-eyebrow {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(245, 241, 232, 0.5);
    margin: 0 0 28px;
  }
  .cv-launch {
    display: grid;
    grid-template-columns: minmax(230px, 280px) minmax(0, 1fr);
    gap: clamp(28px, 6vw, 72px);
    align-items: center;
  }
  @media (max-width: 760px) {
    .cv-launch { grid-template-columns: 1fr; gap: 36px; justify-items: center; }
  }

  /* the phone */
  .cv-launch-phone {
    width: 100%;
    max-width: 280px;
    border-radius: 30px;
    overflow: hidden;
    background: #0c1726;
    box-shadow:
      0 40px 90px -40px rgba(0, 0, 0, 0.85),
      0 0 0 1px rgba(245, 241, 232, 0.08),
      0 0 0 7px rgba(12, 23, 38, 0.9);
  }
  /* the lifestyle photo region — a warm gradient stand-in (asset-free) */
  .cv-launch-photo {
    position: relative;
    height: 168px;
    background:
      radial-gradient(120% 90% at 70% 20%, rgba(255, 196, 140, 0.5), transparent 55%),
      radial-gradient(90% 80% at 30% 60%, rgba(140, 90, 60, 0.55), transparent 60%),
      linear-gradient(160deg, #caa07a 0%, #9a6b4c 55%, #6f4733 100%);
  }
  .cv-launch-photo-grain {
    position: absolute;
    inset: 0;
    background-image: url("/speckles.svg");
    background-repeat: repeat;
    opacity: 0.14;
    mix-blend-mode: overlay;
  }
  /* the blue brand sheet */
  .cv-launch-sheet {
    position: relative;
    margin-top: -34px;
    padding: 22px 20px 24px;
    background: linear-gradient(165deg, #2ba3da 0%, #1f86c4 48%, #1c6fae 100%);
    border-radius: 26px 26px 0 0;
    text-align: center;
  }
  .cv-launch-mark {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-bottom: 6px;
  }
  .cv-launch-logo {
    width: 17px;
    height: 17px;
    border: 2px solid #f5f1e8;
    border-radius: 3px;
  }
  .cv-launch-word {
    font-family: "Geist Variable", ui-sans-serif, system-ui, sans-serif;
    font-weight: 700;
    font-size: 20px;
    letter-spacing: -0.01em;
    color: #f5f1e8;
  }
  .cv-launch-tag {
    font-family: "Geist Variable", ui-sans-serif, system-ui, sans-serif;
    font-size: 11px;
    color: rgba(245, 241, 232, 0.86);
    margin: 0 0 18px;
  }
  .cv-cta {
    display: block;
    width: 100%;
    border: none;
    border-radius: 9px;
    padding: 11px 12px;
    font-family: "Geist Variable", ui-sans-serif, system-ui, sans-serif;
    font-weight: 600;
    font-size: 13.5px;
    cursor: default;
    margin-bottom: 10px;
    transition: transform 600ms cubic-bezier(0.22, 1, 0.36, 1),
                opacity 600ms ease, filter 600ms ease, box-shadow 600ms ease;
  }
  .cv-cta-signup { background: #f5a623; color: #11283f; }
  .cv-cta-login { background: #7ec6ea; color: #11283f; }
  .cv-cta-family {
    background: transparent;
    color: rgba(245, 241, 232, 0.82);
    font-weight: 500;
    font-size: 12px;
    padding: 8px 12px;
    margin-bottom: 0;
    border-radius: 7px;
  }
  /* the isolate beat — the family CTA steps forward, the rest recede */
  .cv-launch.isolate .cv-cta-signup,
  .cv-launch.isolate .cv-cta-login {
    opacity: 0.34;
    filter: saturate(0.55) blur(0.6px);
    transform: scale(0.97);
  }
  .cv-launch.isolate .cv-cta-family {
    color: #f5f1e8;
    background: rgba(245, 241, 232, 0.12);
    box-shadow:
      0 0 0 1px rgba(245, 241, 232, 0.45),
      0 0 22px rgba(126, 198, 234, 0.5),
      0 0 44px rgba(126, 198, 234, 0.25);
    transform: scale(1.12);
    font-weight: 700;
  }

  /* the read-out beside the phone */
  .cv-open-read { max-width: 40ch; }
  .cv-open-read p {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 15px;
    line-height: 1.6;
    margin: 0 0 14px;
    color: rgba(245, 241, 232, 0.7);
    transition: opacity 600ms ease, transform 600ms ease;
  }
  .cv-open-read p:last-child { margin-bottom: 0; }
  .cv-open-read-em {
    color: #f5f1e8;
    font-style: italic;
  }
  /* before isolate, the punchline lines sit dimmed; they resolve with the beat */
  .cv-open-read-2,
  .cv-open-read-3 { opacity: 0.32; transform: translateY(4px); }
  .cv-launch.isolate .cv-open-read-2,
  .cv-launch.isolate .cv-open-read-3 { opacity: 1; transform: none; }
  .cv-launch.isolate .cv-open-read-3 { transition-delay: 160ms; }

  /* ───────────────────── 02 · DEBRIEF ───────────────────── */
