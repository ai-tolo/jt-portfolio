---
// ─────────────────────────────────────────────────────────────────────────
// FINISHABLE — flagship case study.
//
// The organizing question, asked in the open: I own Ableton, a wall of
// plugins, and three hardware synths — why build anything? Because songs
// were dying in three places no product touches, and each chapter is the
// tool that closes one of them, in workflow order:
//
//   open        — the question (FinHero)
//   chapter 01  — KNOW WHAT YOU HAVE · AudioDex (ChaosToBuckets + FileTransform;
//                 the forged card is itself the player — first listen)
//   chapter 02  — PLAY, DON'T FIDDLE · Signal Studio (StudioChapter: the
//                 homepage instrument grows into the DAW; arm the found sound
//                 into three engines; the groove assembles on one bar clock)
//   chapter 03  — TRUST YOUR EARS · Richard (the journey: fantasy → the blind
//                 loudness trap you take yourself → the do-less dial)
//   epilogue    — the flip, then the whole finished side (Finale)
//
// One sound the whole way (Audio 14.m4a → "head to toe"), each state heard
// once. Honors prefers-reduced-motion; no autoplay anywhere; one audio stage
// page-wide (bench:play claim/yield).
// ─────────────────────────────────────────────────────────────────────────
import CSLayout from "../../components/case-study/CSLayout.astro";
import FinHero from "../../components/case-study/atlas/FinHero.astro";
import Chapter from "../../components/case-study/atlas/Chapter.astro";
import ChaosToBuckets from "../../components/case-study/atlas/ChaosToBuckets.astro";
import FileTransform from "../../components/case-study/atlas/FileTransform.astro";
import StudioChapter from "../../components/case-study/atlas/StudioChapter.astro";
import TheBench from "../../components/case-study/atlas/TheBench.astro";
import EngineDial from "../../components/case-study/atlas/EngineDial.astro";
import TasteLoop from "../../components/case-study/atlas/TasteLoop.astro";
import Finale from "../../components/case-study/atlas/Finale.astro";

// the palette round — three REAL renders of the same 22s of "head to toe"
// through the engine's three hand-built arms, loudness-matched to a 0.1 LU
// spread (verified). Labels must EQUAL the TasteLoop palette ids below.
const JDG = "/case-studies/the-console/judge";
const round3 = {
  id: "r3-palettes", source: "head to toe", tag: "three chains, one source — blind",
  loudnessNote: "all three matched to −18.7 LUFS",
  takes: [
    { label: "warm · vocal-safe", file: `${JDG}/round-a.mp3`, ref: "air rolled off, de-harshed, glued — the vocal-first arm" },
    { label: "clean · do-less", file: `${JDG}/round-b.mp3`, ref: "the restraint arm — barely touched, most dynamic" },
    { label: "bright · forward", file: `${JDG}/round-c.mp3`, ref: "tilted up, glued, saturated — the forward arm" },
  ],
};

// the REAL taste card (verbatim from ~/automation/data/taste/jon.json) —
// leanings −1..+1, nudged by blind crowns; notes are its actual log lines
const CARD_LINES = [
  "n_votes: 8",
  "warmth: −0.02",
  "air: 0.00",
  "density: −0.008",
  "restraint: +0.205",
  "note: job 219 — picked raw over treatments → +restraint",
  "note: job 222 — chose 'clean'",
];
const PALETTES = [
  { id: "warm · vocal-safe", name: "warm · vocal-safe", born: "hand-built · eng_vocal_aware.py", rounds: 1, axis: "warmth" },
  { id: "clean · do-less", name: "clean · do-less", born: "hand-built · eng_clean.py", rounds: 2, axis: "restraint" },
  { id: "bright · forward", name: "bright · forward", born: "hand-built · eng_extended_chain.py", rounds: 0, axis: "air" },
];

export const prerender = true;
---

<CSLayout
  title="Finishable · Jon Tollefson"
  description="I own Ableton, a wall of plugins, and three hardware synths — and songs still weren't getting finished. Finishable is the three-tool system built where music actually dies: a catalog that knows what I have, a studio that turns found sound into playable instruments, and a blind listening test my own ears can't cheat."
  ogImage="/case-studies/the-console/cover.jpg"
>
  <FinHero
    meta={[
      { label: "Role", value: "Designer, builder, sole engineer" },
      { label: "Timeline", value: "May 2026 to present" },
      { label: "Stack", value: "Astro · Python · Pedalboard · FabFilter · Whisper · Claude" },
    ]}
  />

  {/* ═══════ CHAPTER 01 · KNOW WHAT YOU HAVE ═══════ */}
  <Chapter
    index="01"
    job="Know what you have"
    product="AudioDex — the catalog"
    tagline="Twenty thousand scattered recordings, read by sound, named, and made playable."
    accent="cyan"
    flush
  />
  <ChaosToBuckets />
  <div class="cs-bleed ft-mount"><FileTransform /></div>

  {/* ═══════ CHAPTER 02 · PLAY, DON'T FIDDLE ═══════ */}
  <Chapter
    index="02"
    job="Play, don't fiddle"
    product="Signal Studio — the workshop"
    tagline="Where a found sound becomes an instrument, and an instrument becomes a track idea."
    market="Ableton is the finish line. Nothing owned the starting line — the two a.m. minute between an idea and a playable groove."
    accent="violet"
    flush
  />
  <StudioChapter />

  {/* ═══════ CHAPTER 03 · TRUST YOUR EARS ═══════ */}
  <div id="engineer">
    <Chapter
      index="03"
      job="Trust your ears"
      product="Richard — the engineer"
      tagline="The last step — and the live frontier: an engineer that develops the more it gets used."
      market="LANDR and Ozone ship one fixed opinion about better. This one is growing its own — blind round by blind round."
      accent="green"
    />
  </div>

  <div class="eng">
    <p class="eng-fantasy">
      Version one was going to learn my taste from a million votes and become the
      best engineer in the world. That fantasy died honestly — what it left behind
      is a test I can't cheat, feeding an engine that develops through use.
      Take a round yourself:
    </p>

    <TheBench round={round3} />
    <p class="eng-matched">every take is loudness-matched — otherwise the loudest one always wins. there is no wrong crown, only taste.</p>

    <TasteLoop roundId="r3-palettes" cardFile="~/automation/data/taste/jon.json" cardLines={CARD_LINES} palettes={PALETTES} />

    <p class="eng-lesson">
      Its strongest leaning so far is restraint — the default is to do nothing:
    </p>
  </div>

  <div class="cs-bleed"><EngineDial /></div>

  {/* ═══════ EPILOGUE · the distance, then the destination ═══════ */}
  <div class="cs-bleed"><Finale /></div>
</CSLayout>

<style>
  /* the engineer chapter reads as one quiet column — a journey, not a console */
  .eng { max-width: 760px; margin: 0 auto; padding: 0 24px; }
  .eng-fantasy, .eng-lesson {
    font-family: "Space Grotesk Variable", "Space Grotesk", ui-sans-serif, system-ui, sans-serif;
    font-size: clamp(15px, 1.8vw, 18px);
    line-height: 1.6;
    color: rgba(245, 241, 232, 0.72);
    max-width: 56ch;
  }
  .eng-fantasy { margin: 0 0 26px; }
  .eng-lesson { margin: 34px 0 10px; }
  .eng-matched {
    margin: 14px 0 0; text-align: center;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11px; letter-spacing: 0.05em; color: rgba(245, 241, 232, 0.45);
  }

  /* the AudioDex machine fires straight off the chapter title; tighten the seam
     (longhand margins so the .cs-bleed margin-left trick survives) */
  .ft-mount { margin-top: -6px; margin-bottom: 0; }
</style>
