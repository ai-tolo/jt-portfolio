---
// ─────────────────────────────────────────────────────────────────────────
// FINISHABLE — the flagship, in the WORK room's material, focused (Stream C, 2026-10-06, Jon: "the modules feel a
// bit gimmicky, as though we've just been keeping stuff around because it's there").
//
// ONE live object leads: THE BENCH, the blind round. A stranger crowns a take without knowing which one is the
// untouched original; that is the claim the whole system rests on ("a test my own ears can't cheat"). Then the
// ledger's own number, set apart. Then the second object, THE RECORD: the 2 a.m. memo against the finished master,
// and the whole finished side to play out. The catalog and the studio are two of the four moments in the story
// card and rows in UNDER THE HOOD, with their real counts; their stages (ChaosToBuckets, StudioChapter), the taste
// card (TasteLoop) and the dial (EngineDial) stay on disk, unmounted.
// The numbers are READ FROM THE LEDGER (judge-ledger.json, the same dated harness snapshot /resume prints from) so
// no sentence here can drift stale. One sound the whole way (Audio 14.m4a → "head to toe"); no autoplay; one audio
// stage page-wide (bench:play claim/yield). Honors prefers-reduced-motion.
// ─────────────────────────────────────────────────────────────────────────
import Room from "../../components/case-study/room/Room.astro";
import RoomStory from "../../components/case-study/room/RoomStory.astro";
import TheBench from "../../components/case-study/atlas/TheBench.astro";
import Finale from "../../components/case-study/atlas/Finale.astro";
import { round3 } from "../../lib/finishable";
import judgeLedger from "../../lib/judge-ledger.json";

export const prerender = true;

const { rounds: ROUNDS, votes: VOTES, chose_original: ORIGINAL } = judgeLedger.blind;

// DRAFT (Jon edits): the read, second person, four moments: the question, the three tools in workflow order
const BLOCKS = [
  { h: "You own all of it too", p: "A DAW, a wall of plugins, synths that sound better than you need. The songs still die: lost across drives, stalled before a project exists, doubted into a fourth mix. No product I owned touched those three places, so I built one tool for each." },
  { h: "You know what you have", p: "The catalog reads every file by sound, not by name, and files it: inbox, jam, loops, field, tracks. The duplicates fold into each other. A voice memo from a junk drawer lands in tracks with a name it earned. That comes before making anything new." },
  { h: "You play before you fiddle", p: "The studio is this site's instrument, grown a room. Drop the found loop on an engine and drums, keys and bass enter on the bar; the stream holds the four bars you just played; you grab a loop, arrange it, print stems for Ableton. Ableton is the finish line. This is the starting line." },
  { h: "You took the blind round", p: `Three takes, loudness-matched, one of them untouched. You crowned one without knowing which. ${ROUNDS} rounds in, one rater, the leaning that keeps repeating is restraint: the default is to do nothing. The engine is steered by a taste card, an editable file and not a model, so I can read it and overrule it. The first finished record is in progress; side A plays out above.` },
];

// UNDER THE HOOD: the system facts, true (numbers real or absent)
const HOOD = [
  { k: "role", tool: "solo", html: "Designer, builder and sole engineer, May 2026 to now; the system runs on my desk daily." },
  { k: "stack", tool: "Python", html: "Astro for the surfaces; Python, Pedalboard and FabFilter for the audio; Whisper for the words; Claude in the loop." },
  { k: "the catalog", tool: "by sound", html: "20,279 files read by sound, deduplicated and filed into five bins: inbox 7,589 · jam 329 · loops 339 · field 1,389 · tracks 169." },
  { k: "the studio", tool: "Web Audio", html: "Three engines on one bar clock; a found sound armed into velocity-aware zones; loops grabbed from the stream, arranged on an 8-bar grid, printed as stems." },
  { k: "the engineer", tool: "blind A/B", html: `A blind, loudness-matched A/B (integrated LUFS) against the untouched original: ${ROUNDS} rounds, ${VOTES} votes, one rater; the chain Pro-Q 3 → Pro-C 2 → Saturn 2 → Pro-L 2; the taste card an editable file, not a model.` },
  { k: "the record", tool: "side A", html: "The 2 a.m. memo against the finished master on one scale, then the whole finished side with its measured peaks." },
];
---

<Room
  title="Finishable — Jonathan Tollefson"
  description="I own Ableton, a wall of plugins and three hardware synths, and songs still weren't getting finished. Finishable is three tools built where music dies: a catalog that knows what I have, a studio that turns found sound into playable instruments, and a blind listening test my own ears can't cheat."
  label="finishable · 2026 – now"
  hook="I own all of it. The songs still weren't getting finished."
  cls="fin-cs"
>
  {/* DRAFT (Jon edits): the three deaths, the chapters in one line */}
  <ul class="fn-deaths" aria-label="where songs die">
    <li><b>lost</b><span>twenty thousand fragments no tool could read</span></li>
    <li><b>stalled</b><span>ideas gone before a project was even set up</span></li>
    <li><b>doubted</b><span>mixes redone forever, with no honest way to compare them</span></li>
  </ul>

  {/* THE BENCH: the one object. Its caption ships inside it (one string for /judge and this page), so the figure adds none. */}
  <figure class="rm-object fn-object" id="engineer">
    <TheBench round={round3} />
  </figure>

  {/* the ledger's own number */}
  <p class="rm-number"><b>{ORIGINAL} / {VOTES}</b><span>blind, loudness-matched votes that went to the untouched original · {ROUNDS} rounds · one rater</span></p>

  {/* THE RECORD: the second object. */}
  <figure class="rm-object fn-object">
    <Finale />
    {/* DRAFT (Jon edits) */}
    <figcaption class="rm-cap">The 2 a.m. memo against the finished master, on one scale. Then keep listening: the whole side.</figcaption>
  </figure>

  <RoomStory name="Finishable" blocks={BLOCKS} hood={HOOD} accent="#1a8f55" />
</Room>

<style is:global>
  /* ── the deaths line under the hook ── */
  .fin-cs .rm-head { margin-bottom: var(--sp-6); }
  .fn-deaths { list-style: none; margin: 0 0 var(--sp-8); padding: 0; display: flex; flex-wrap: wrap; gap: 8px 32px; max-width: var(--rm-measure); }
  .fn-deaths li { display: flex; gap: 10px; align-items: baseline; font: 400 0.9375rem/1.5 var(--rm-sans); color: var(--rm-dim); }
  .fn-deaths b { font: 500 0.6875rem/1.6 var(--rm-mono); letter-spacing: 0.12em; text-transform: lowercase; color: var(--rm-ink); }

  /* ── the two objects on the paper: product surfaces that keep their skins; the page gives them the room's mono and
        its sans for their display face (three faces, no fourth), and hangs them on the column's left edge ── */
  .fin-cs { --cs-mono: var(--rm-mono); }
  .fin-cs :is(.tb, .fin-line) { font-family: var(--rm-sans); }
  /* the bench's own caption is the figure's caption: the room's caption face, on the column's left edge */
  .fin-cs .tb-caption { margin: var(--sp-6) 0 0; max-width: var(--rm-measure); text-align: left; font: 600 0.75rem/1.5 var(--rm-mono); letter-spacing: 0.04em; color: var(--rm-ink); }
  .fin-cs .fin-stage { margin-left: 0; padding: 0 0 var(--sp-6); align-items: flex-start; }
  .fin-cs .fin-line { text-align: left; margin-left: 0; color: var(--rm-ink); }
  .fin-cs .fin-line-quiet { color: var(--rm-dim); }
</style>
