---
// ─────────────────────────────────────────────────────────────────────────
// THE LATHE — flagship case study.
//
// A scroll-driven film in six acts. We follow one anonymous file —
// Audio 14.wav — from a lost glint in the chaos to a named, crowned,
// published master. The system is what does the transforming.
//
//   0 · Cold open      — the title card (AtlasHero)
//   1 · Chaos          — make the mess felt (ChaosToBuckets)
//   2 · The sweep      — one organizing motion into five bins
//   3 · The companion  — zoom to one track; Richard appears (RichardReveal)
//   4 · The brain      — taste → 6 variants → the rendition toggle → the loops
//   5 · Resolution     — what it solves, the scale, the meta-twist
//
// Supersedes the prose case study in place (route /case-studies/the-console,
// wired to the homepage card + cover). Backup: the-console.astro.bak-pre-atlas-*.
// Honors prefers-reduced-motion; all motion is IntersectionObserver-gated.
// ─────────────────────────────────────────────────────────────────────────
import CSLayout from "../../components/case-study/CSLayout.astro";
import CSSection from "../../components/case-study/CSSection.astro";
import CSPullquote from "../../components/case-study/CSPullquote.astro";
import CSLiveDemo from "../../components/case-study/CSLiveDemo.astro";
import AtlasHero from "../../components/case-study/atlas/AtlasHero.astro";
import ChaosToBuckets from "../../components/case-study/atlas/ChaosToBuckets.astro";
import FileTransform from "../../components/case-study/atlas/FileTransform.astro";
import RichardReveal from "../../components/case-study/atlas/RichardReveal.astro";
import TheBench from "../../components/case-study/atlas/TheBench.astro";
import RoundFrame from "../../components/case-study/atlas/RoundFrame.astro";
import TasteTrial from "../../components/case-study/atlas/TasteTrial.astro";
import LiveFrontier from "../../components/case-study/atlas/LiveFrontier.astro";
import VerdictLedger from "../../components/case-study/atlas/VerdictLedger.astro";
import Movement from "../../components/case-study/atlas/Movement.astro";
import SecretDoor from "../../components/case-study/atlas/SecretDoor.astro";

// Movement II — "You are the judge" round audio. take1/2/3 are real masters of
// "head to toe" (the case-study song = SONG_TITLE in FileTransform.astro, synced as the
// literal source: below + in SecretDoor.astro BUCKETS[0]). The untouched-original slot
// reuses a take as a PLACEHOLDER until the real raw render is dropped in.
const REN = "/case-studies/the-console/renditions";
const round1 = {
  id: "r1-stems", source: "head to toe", tag: "blind",
  takes: [
    { label: "the engine's master", file: `${REN}/take1.mp3`, ref: "split into stems, processed, glued back" },
    { label: "the untouched original", file: `${REN}/take3.mp3`, ref: "do nothing at all", isOriginal: true },
  ],
};
const round2 = {
  id: "r2-loudness", source: "head to toe", tag: "the same master, two levels",
  takes: [
    { label: "at reference level", file: `${REN}/take2.mp3`, ref: "the master, matched to a set loudness" },
    { label: "a few dB hotter", file: `${REN}/take2.mp3`, gain: 1.7, ref: "the very same master, just louder" },
  ],
};
const round3 = {
  id: "r3-fulltrack", source: "head to toe", tag: "blind · loudness-matched",
  loudnessNote: "All matched to one loudness, so you judge the mix, not the level.",
  takes: [
    { label: "bright · forward", file: `${REN}/take1.mp3`, ref: "matched toward a never-harsh top end" },
    { label: "warm · intimate", file: `${REN}/take2.mp3`, ref: "matched toward a recessed, in-the-room vocal" },
    { label: "open · unhyped", file: `${REN}/take3.mp3`, ref: "matched toward a big, open low end" },
  ],
};

export const prerender = true;
---

<CSLayout
  title="The Lathe · Jon Tollefson"
  description="The Lathe. Eight years of scattered sound, swept into one place that knows what it has and hands it back to you, smarter. A live, interactive case study about building an honest audio engine: blind, loudness-matched, inside your own library."
  ogImage="/case-studies/the-console/cover.jpg"
>
  <AtlasHero
    eyebrow="It makes my own music finishable. It never makes a note."
    title="The Lathe"
    subtitle="Eight years of scattered sound. One place that knows what it has, and hands it back to you, smarter."
    meta={[
      { label: "Role", value: "Designer, builder, sole engineer" },
      { label: "Timeline", value: "May 2026 to present" },
      { label: "Stack", value: "Astro · FastAPI · Python · Pedalboard · Whisper · Claude" },
    ]}
    glossary={{
      term: "lathe",
      ipa: "/leɪð/",
      pos: "noun",
      senses: [
        {
          tag: "the cutting lathe",
          text: "The machine that writes sound into matter. A heated sapphire rides the master and carves it live, one pass, no undo, as a single unbroken spiral valley in lacquer. Every swell, every transient, every held breath transcribed into a groove a needle can later re-sing. The last physical act of mastering: the moment a mix stops being a file and becomes a thing you can hold to the light.",
        },
        {
          tag: "the workshop root",
          text: "The oldest machine on the bench. It spins a rough piece against one fixed edge and turns it down to a true, symmetrical form. Chaos in, shape out.",
        },
      ],
      etymology: "Middle English, of Scandinavian root: a frame that holds the work, and turns it true.",
    }}
  />

  {/* ─────── 01 · THE WISH / THE MESS ─────── */}
  <CSSection
    title="Sit down to make something"
    deck="The blank session waits. You half-remember a vocal you sang into your phone last Tuesday. You open Finder. iCloud hasn't downloaded the file yet. By the time it shows up, the idea is gone."
    noTopRule
  >
    <div class="prose-block">
      <p>That moment, repeated a thousand times across eight years of writing music, is the gap this whole thing closes. Twenty thousand audio files: every voice memo, every jam, every bounce, every sample I've ever touched, scattered across four drives and iCloud and my desktop and friends' DMs. None of it findable. <span class="k-pink">Most of it never heard again.</span></p>
      <p>So I built a machine to <span class="k-cyan">sweep it all into one place</span>. Scroll.</p>
    </div>
  </CSSection>

  {/* ─────── ACT 1 + 2 · CHAOS → THE SWEEP (theater) ─────── */}
  <ChaosToBuckets />

  {/* ═══════ MOVEMENT I · AUDIODEX (the index) ═══════ */}
  <Movement
    index="I"
    kicker="the index"
    name="AudioDex"
    tagline="It reads, transcribes, and catalogs twenty thousand of my own scattered files, so for the first time I know what I have, and what's worth finishing."
    accent="cyan"
    flush
  />

  {/* the AudioDex module — fired straight off the Movement headline */}
  <div class="cs-bleed ft-mount"><FileTransform /></div>

  {/* ─────── the catalog knows what it has · beneath the module ─────── */}
  <CSSection
    title="It fills in its own entries"
    deck="Before AudioDex, every one of these was a dead name in a folder: a date and a number iOS picked. You just watched the kiln read one and write its own entry."
    noTopRule
  >
    <div class="prose-block">
      <p>That's <em>one</em> entry, the hardest kind. The other twenty thousand got the same treatment, most with no help from me: an auto-classifier reads each row's content, source, and length and files it: <strong>Jams</strong> and <strong>Field</strong> sort themselves (the first run filed 1,389 field rows and 329 jams untouched), <strong>Loops</strong> and <strong>Tracks</strong> stay curator-picked, <strong>Inbox</strong> holds the residue.</p>
      <p>Whisper hears the words, Claude <span class="k-cyan">titles and summarizes</span>, librosa stamps BPM and key. A date-and-a-number becomes a title, a sentence, and a searchable transcript. The pile becomes a thing that knows what it's holding.</p>
      <p>This is the opposite of a sample manager. Algonaut&nbsp;Atlas, Waves&nbsp;Cosmos: they organize clean one-shots you already chose to keep, by how they sound (<em>find me a kick</em>). <span class="adx">AudioDex</span> starts from the other end of the mess: twenty thousand unnamed, half-finished files, and the one question that blocks me: <strong>what do I even have, and what's worth finishing?</strong></p>
    </div>
  </CSSection>

  {/* ═══════ MOVEMENT II · RICHARD (the engineer) ═══════ */}
  <Movement
    index="II"
    kicker="the engineer"
    name="Richard"
    tagline="I stopped trying to build an engineer that learns me. I built a test honest enough to prove me wrong."
    accent="green"
    mark="richard"
  />

  {/* ─────── ACT 3 · THE COMPANION ─────── */}
  <CSSection title="Send it over" deck="Zoom all the way in on one row in Tracks: a finished song, mixed rough, on headphones, at 2 a.m. The next step was always the lonely one: master it, A/B it against records you love, decide if it's done. So I built someone to do it with.">
    <RichardReveal />
  </CSSection>

  {/* ─────── ACT 4 · YOU ARE THE JUDGE (the engineer's evolution, lived) ─────── */}
  <CSSection
    title="You are the judge"
    deck="Every idea I had about this engine had to survive one test: blind, loudness-matched, hold a number to crown your pick. Most of my ideas didn't survive it. Run it yourself and watch what your own ears do."
    noTopRule
  >
    <div class="cs-bleed">
      {/* Movement II console (4f) — the rounds bolted to one green backplate, the
          kiln's twin; decoration is aria-hidden, the .judge stack inside is unchanged */}
      <div class="judge-chassis">
      <span class="jc-conduit" aria-hidden="true"></span>
      <span class="jc-led" aria-hidden="true"></span>
      <span class="jc-brand" aria-hidden="true">RICHARD · BENCH</span>
      <span class="jc-serial" aria-hidden="true">MK·II · THE LATHE</span>
      <span class="jc-vents" aria-hidden="true"></span>
      <span class="jc-bolt jc-bolt-tl" aria-hidden="true"></span><span class="jc-bolt jc-bolt-tr" aria-hidden="true"></span>
      <span class="jc-bolt jc-bolt-bl" aria-hidden="true"></span><span class="jc-bolt jc-bolt-br" aria-hidden="true"></span>
      <div class="judge">
        <div class="judge-ledger"><VerdictLedger /></div>

        <RoundFrame
          index="01"
          phase="split it into parts"
          verdict="debunked"
          belief="The first engine split every track into stems and mastered each piece on its own. More separation, more control. Below: one take it built that way, one untouched. Crown the one that sounds better."
          overturn="Splitting the track injected artifacts no processing could hide. Blind, doing nothing kept winning, for me about two times in three."
          overturnOriginal="You just crowned the untouched original over the engine. So did I, about two times in three. Splitting the track left artifacts no processing could hide, so doing nothing won."
        >
          <TheBench round={round1} />
        </RoundFrame>

        <RoundFrame
          index="02"
          phase="measure before you trust your ears"
          verdict="held"
          belief="The same master, twice. One is a few dB hotter. Crown the one that sounds better."
          overturn="Whichever felt fuller and crisper was probably just louder. Nothing changed but the level. So every test from here on is loudness-matched and blind, and the level never gets a vote."
          overturnLouder="Gotcha. You crowned the louder one. It is the exact same master, a few dB hotter, and louder reads as fuller every single time. So every test from here on is loudness-matched and blind."
        >
          <TheBench round={round2} />
        </RoundFrame>

        <RoundFrame
          index="03"
          phase="stop splitting; master the whole track"
          verdict="held"
          belief="No stems this time. Each take is the whole track mastered toward a different record I love, all matched to one loudness. Crown your pick."
          overturn="With the artifacts gone, the masters finally beat doing nothing, and there was no single obvious winner. Which one wins turned out to depend on the track, not on me. That crack is where my next idea broke."
        >
          <TheBench round={round3} />
        </RoundFrame>

        {/* Round 04 · the apprentice — the debunk the visitor lives (reads the ledger) */}
        <TasteTrial />

        {/* Round 05 · the live frontier — the honest current edge (n=1, not shipped) */}
        <LiveFrontier />
      </div>
      </div>
    </div>
  </CSSection>

  {/* ─────── ACT 4d · HOW IT STANDS OUT ─────── */}
  <CSSection title="Why this isn't just another mastering button" deck="There's no shortage of AI that will master a track. There's nothing that masters yours inside your own library, and proves what it did, blind.">
    <div class="standout">
      <div class="so-row so-them">
        <span class="so-tag">Everyone else</span>
        <p>LANDR, Ozone, the rest are a <strong>stateless upload box</strong>: send a file, get a master, it forgets you. None reference the records you love. None live in your library. None prove what they did to your ear.</p>
      </div>
      <div class="so-row so-this">
        <span class="so-tag">The Lathe</span>
        <p>References the records I actually love, A/Bs them <strong>blind and loudness-matched</strong> (the method engineers insist on and nobody else bothers with), and lives inside my own library, where every comparison is measured, never guessed.</p>
      </div>
      <p class="so-foot">The blind, loudness-matched method is not a feature. It is the only honest one, and everyone else skips it. The point was never to beat a label release. It was to make eight years of my own work finishable, in my own ear.</p>
    </div>
  </CSSection>

  {/* ─────── RESOLUTION · the favorite-memory payoff ─────── */}
  <CSSection title="A date and a number becomes a favorite" deck="Audio 14.m4a came in a nameless 2 a.m. phone memo with terrible audio. It went out a finished song I keep coming back to.">
    <div class="prose-block">
      <p><span class="adx">AudioDex</span> found it in the pile and gave it a title: <span class="k-orange">head to toe</span>. <span class="rich">Richard</span> handed it back, measured blind against the records I love, and I could finally hear what it already had. I finished it. It is one of my favorite songs I have made, and the system never touched a note. It is not about fidelity. This recording is proof of that. It is about never losing the one that mattered.</p>
      <p>The calls I'm proudest of are the ones I refused to build:</p>
    </div>

    <ul class="wont">
      <li>It won't write my posts or pitch me song ideas.</li>
      <li>It won't push prompts or listen in on a session.</li>
      <li>It won't finish a track, or touch a single note.</li>
      <li>It won't make one creative decision for me.</li>
    </ul>

    <CSPullquote hero cite="The Lathe">
      Utility, not synthesis. The machine sorts, fingerprints, surfaces, and clears the friction. The artist still chooses, still drags, still arranges.
    </CSPullquote>
  </CSSection>

  {/* ─────── THE GATEWAY · the finale: step into the running console (key: "soundbender").
       The module is situated + the post-login view lives in SecretDoor.astro. ─────── */}
  <SecretDoor />

  <div class="cs-foot">
    <a href="/#work" class="cs-foot-back">← back to selected work</a>
  </div>
</CSLayout>

<style>
  .prose-block { max-width: 64ch; }
  .prose-block em { font-style: italic; color: var(--cs-text); }

  /* Movement II console (4f) — the rounds bolted to one green-keyed backplate, the
     twin of the kiln (Movement I, FileTransform .ft-console). Houses the .judge
     stack; every round inside it is unchanged. All decoration is aria-hidden and
     dimmer than the rounds, so the frame recedes and the rounds stay the focal
     point. Inside .cs-bleed, so margins are longhand (atlas gotcha #2). */
  .judge-chassis {
    position: relative;
    max-width: 1000px;
    margin-left: auto;
    margin-right: auto;
    padding: 48px 40px 56px;
    border-radius: 16px;
    border: 1px solid rgba(0, 0, 0, 0.6);
    isolation: isolate;
    background:
      radial-gradient(80% 70% at 50% 30%, rgba(36, 44, 58, 0.6), transparent 70%),
      repeating-linear-gradient(98deg, rgba(255, 255, 255, 0.012) 0 2px, transparent 2px 5px),
      linear-gradient(162deg, #2b313d 0%, #181c25 46%, #0f1219 100%);
    box-shadow: 0 60px 110px -44px rgba(0, 0, 0, 0.92), inset 0 2px 0 rgba(255, 255, 255, 0.14), inset 0 -5px 12px rgba(0, 0, 0, 0.6), inset 0 0 0 1px rgba(0, 255, 77, 0.05);
  }
  .judge-chassis::before { /* inner recessed bezel — same recipe as the kiln */
    content: ""; position: absolute; inset: 14px; border-radius: 12px; pointer-events: none;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.5), inset 0 2px 6px rgba(0, 0, 0, 0.45), inset 0 -1px 0 rgba(255, 255, 255, 0.05);
  }
  .judge-chassis > .judge { position: relative; z-index: 1; }
  /* On the backplate, let every round fill its own 760 max-width so the modules
     read as uniform bays (the flex column otherwise shrink-to-fits each round to
     its content). Additive: the rounds' own max-width is unchanged, they just fill it. */
  .judge > :global(.rf), .judge > :global(.tt), .judge > :global(.lf) { width: 100%; }

  /* chassis plates + fasteners, lifted from the kiln's ft-chassis and ft-bolt rules
     and greened. The serial deliberately reads MK·II to the kiln's MK·I: one
     production run, two consoles. */
  .jc-brand { position: absolute; left: 50px; bottom: 18px; font-family: "Space Grotesk Variable", "Space Grotesk", ui-sans-serif, system-ui, sans-serif; font-weight: 700; font-size: 12px; letter-spacing: 0.34em; text-transform: uppercase; color: rgba(245, 241, 232, 0.34); }
  .jc-serial { position: absolute; right: 34px; bottom: 19px; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 9px; letter-spacing: 0.22em; text-transform: uppercase; color: rgba(245, 241, 232, 0.24); }
  .jc-vents { position: absolute; left: 50%; bottom: 16px; transform: translateX(-50%); width: 120px; height: 12px; border-radius: 3px; background: repeating-linear-gradient(90deg, rgba(0, 0, 0, 0.4) 0 2px, rgba(245, 241, 232, 0.06) 2px 5px); opacity: 0.6; }
  .jc-led {
    position: absolute; left: 32px; bottom: 19px; width: 8px; height: 8px; border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #d8ffe4, #00ff4d);
    box-shadow: 0 0 8px rgba(0, 255, 77, 0.8);
    animation: jc-hum 5s ease-in-out infinite;
  }
  @keyframes jc-hum { 0%, 100% { opacity: 0.55; } 50% { opacity: 0.9; } }
  .jc-bolt { position: absolute; width: 11px; height: 11px; border-radius: 50%; background: radial-gradient(circle at 38% 32%, #535a67, #14171d); box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.55), 0 1px 0 rgba(255, 255, 255, 0.06); }
  .jc-bolt::after { content: ""; position: absolute; inset: 3px; border-top: 1px solid rgba(0, 0, 0, 0.5); transform: rotate(40deg); }
  .jc-bolt-tl { top: 16px; left: 16px; } .jc-bolt-tr { top: 16px; right: 16px; } .jc-bolt-bl { bottom: 16px; left: 16px; } .jc-bolt-br { bottom: 16px; right: 16px; }
  /* a short feed line into the console top, gesturing up toward the Movement II pillar */
  .jc-conduit {
    position: absolute; top: -18px; left: 50%; transform: translateX(-50%);
    width: 3px; height: 30px; border-radius: 2px;
    background: linear-gradient(180deg, rgba(0, 255, 77, 0) 0%, rgba(0, 255, 77, 0.22) 100%);
  }
  .jc-conduit::after {
    content: ""; position: absolute; top: -3px; left: 50%; transform: translateX(-50%);
    width: 7px; height: 7px; border-radius: 50%;
    background: rgba(0, 255, 77, 0.5); box-shadow: 0 0 7px rgba(0, 255, 77, 0.55);
  }

  /* "You are the judge" — the round stack. Centers inside the chassis above; inner
     column stays 880 with longhand margins (atlas gotcha #2). */
  .judge { max-width: 880px; margin-left: auto; margin-right: auto; padding: 0 24px; display: flex; flex-direction: column; gap: 46px; }
  .judge-ledger { margin-bottom: 2px; }
  @media (max-width: 720px) {
    .judge { padding: 0 16px; gap: 36px; }
    /* the chassis tightens and sheds its crowded bottom band on narrow screens;
       the brand + the MK·II serial (the same-machine tie) and top bolts stay */
    .judge-chassis { padding: 28px 14px 40px; border-radius: 12px; }
    .jc-vents, .jc-led, .jc-bolt-bl, .jc-bolt-br { display: none; }
    .jc-brand { left: 16px; bottom: 15px; font-size: 9px; letter-spacing: 0.2em; }
    .jc-serial { right: 16px; bottom: 15px; font-size: 8px; }
  }
  @media (prefers-reduced-motion: reduce) { .jc-led { animation: none; } }

  /* the AudioDex module fires straight off the Movement headline; tighten the
     gap to the explanation that sits beneath it (longhand margins so the
     .cs-bleed margin-left trick survives — atlas gotcha #2) */
  .ft-mount { margin-top: -6px; margin-bottom: -34px; }

  /* inline accent helpers — used sparingly to color key phrases and to track the
     two halves the way the Movement pillars do (AudioDex = cyan, Richard = green) */
  .adx { color: var(--brand-cyan); font-weight: 600; }
  .rich { color: var(--brand-green); font-weight: 600; }
  .k-cyan { color: var(--brand-cyan); }
  .k-green { color: var(--brand-green); }
  .k-pink { color: var(--brand-pink); }
  .k-orange { color: var(--brand-orange); }

  .wont {
    list-style: none; padding: 0; margin: 24px 0 8px; max-width: 64ch;
    display: grid; grid-template-columns: 1fr 1fr; gap: 6px 22px;
  }
  @media (max-width: 720px) { .wont { grid-template-columns: 1fr; } }
  .wont li {
    position: relative; padding-left: 22px;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 13px; color: rgba(245, 241, 232, 0.88); line-height: 1.5;
  }
  .wont li::before { content: "·"; position: absolute; left: 6px; color: var(--brand-pink); font-weight: 700; }

  .standout { max-width: 72ch; display: flex; flex-direction: column; gap: 12px; }
  .standout p { margin: 0; max-width: none; }
  .so-row { border-radius: 8px; padding: 15px 18px 15px 20px; }
  .so-row p { font-size: 17px; line-height: 1.65; }
  .so-tag { display: inline-block; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 11px; letter-spacing: 0.28em; text-transform: uppercase; margin-bottom: 8px; }
  .so-them { border: 1px solid var(--cs-line); border-left: 3px solid var(--cs-line-strong); background: rgba(245, 241, 232, 0.02); }
  .so-them .so-tag { color: var(--cs-text-dim); }
  .so-them p { color: var(--cs-text-muted); }
  .so-this { border: 1px solid rgba(0, 255, 77, 0.22); border-left: 3px solid var(--brand-green); background: rgba(0, 255, 77, 0.04); }
  .so-this .so-tag { color: var(--brand-green); }
  .so-foot { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 13px; line-height: 1.6; color: var(--cs-text-muted); margin-top: 6px; }
  .so-foot em { color: var(--cs-text); font-style: italic; }

  .cs-foot { text-align: center; padding: 64px 0 0; }
  .cs-foot-back {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--brand-orange);
    text-decoration: none;
    padding: 8px 16px;
    border: 1px solid rgba(255, 90, 60, 0.32);
    border-radius: 2px;
    transition: color 160ms ease, border-color 160ms ease, background 160ms ease;
  }
  .cs-foot-back:hover {
    color: #f5f1e8;
    border-color: var(--brand-orange);
    background: rgba(255, 90, 60, 0.08);
  }
</style>
