---
// ─────────────────────────────────────────────────────────────────────────
// FINISHABLE — the flagship, in the WORK room's material (Stream C, 2026-10-06).
//
// The question stays the open: I own Ableton, a wall of plugins, three hardware
// synths; why build anything? Because songs were dying in three places no
// product touches, and each chapter is the tool that closes one of them, in
// workflow order. Every object of the old page is kept with its behaviour:
//
//   chapter 01  — KNOW WHAT YOU HAVE · the Catalog (ChaosToBuckets)
//   chapter 02  — PLAY, DON'T FIDDLE · the Studio (StudioChapter)
//   chapter 03  — TRUST YOUR EARS · the Engineer (TheBench + TasteLoop + EngineDial)
//   chapter 04  — FINISH · the record (Finale)
//
// What changed is the clothes: the Room frame (label · hook · the objects on the
// paper, each with a mono caption · the story card with UNDER THE HOOD inside),
// the chapter marks in the room's faces, the prose between the objects cut by
// half. The objects are product surfaces and keep their own skins; the page
// hands them the room's mono and maps their display face to the room's sans
// (the .fin-cs block below) so the page has three faces and no fourth.
// One sound the whole way (Audio 14.m4a → "head to toe"); no autoplay; one
// audio stage page-wide (bench:play claim/yield). Honors prefers-reduced-motion.
// ─────────────────────────────────────────────────────────────────────────
import Room from "../../components/case-study/room/Room.astro";
import RoomStory from "../../components/case-study/room/RoomStory.astro";
import ChaosToBuckets from "../../components/case-study/atlas/ChaosToBuckets.astro";
import StudioChapter from "../../components/case-study/atlas/StudioChapter.astro";
import TheBench from "../../components/case-study/atlas/TheBench.astro";
import EngineDial from "../../components/case-study/atlas/EngineDial.astro";
import TasteLoop from "../../components/case-study/atlas/TasteLoop.astro";
import Finale from "../../components/case-study/atlas/Finale.astro";
import { round3, CARD_LINES, PALETTES } from "../../lib/finishable";
// The rounds count is READ FROM THE LEDGER (the same dated harness snapshot
// /resume prints from) so the sentence below can never drift stale again.
import judgeLedger from "../../lib/judge-ledger.json";

export const prerender = true;

const ROUNDS = judgeLedger.blind.rounds;

// the chapter marks: the job is the moment, the product rides under it (DRAFT (Jon edits): the taglines)
const CHAPTERS = [
  { n: "01", product: "the catalog", job: "Know what you have", tag: "Twenty thousand scattered recordings, read by sound, named, and made playable." },
  { n: "02", product: "the studio", job: "Play, don't fiddle", tag: "Where a found sound becomes an instrument, and an instrument becomes a track idea." },
  { n: "03", product: "the engineer", job: "Trust your ears", tag: "An engineer that has to beat doing nothing, blind." },
  { n: "04", product: "the record", job: "Finish", tag: "" },
];

// DRAFT (Jon edits): the read, second person, four moments: what you just did on the page and what is behind it
const BLOCKS = [
  { h: "You own all of it too", p: "A DAW, a wall of plugins, synths that sound better than you need. The songs still die: lost across drives, stalled before a project exists, doubted into a fourth mix. No product I owned touched those three places, so I built one tool for each." },
  { h: "You sorted twenty thousand files", p: "The catalog reads every file by sound, not by name, and files it: inbox, jam, loops, field, tracks. The duplicates fold into each other. The memo from a junk drawer lands in tracks with a name it earned. Knowing what you have comes before making anything new." },
  { h: "You played a band", p: "The studio is this site's instrument, grown a room. Drop the found loop on an engine and drums, keys and bass enter on the bar. The stream was listening the whole time; you grab four bars, arrange them, print stems for Ableton. Ableton is the finish line. This is the starting line." },
  { h: "You took the blind round", p: `Three takes, loudness-matched, one of them untouched. You crown one without knowing which. ${ROUNDS} rounds in, one rater, the leaning that keeps repeating is restraint. The engine is steered by a taste card, an editable file and not a model, so I can read it and overrule it. Side A plays out above.` },
];

// UNDER THE HOOD: the system facts, true (numbers real or absent)
const HOOD = [
  { k: "role", tool: "solo", html: "Designer, builder and sole engineer, May 2026 to now; the system runs on my desk daily." },
  { k: "stack", tool: "Python", html: "Astro for the surfaces; Python, Pedalboard and FabFilter for the audio; Whisper for the words; Claude in the loop." },
  { k: "the catalog", tool: "by sound", html: "20,279 files read by sound, deduplicated and filed into five bins: inbox 7,589 · jam 329 · loops 339 · field 1,389 · tracks 169." },
  { k: "the studio", tool: "Web Audio", html: "Three engines on one bar clock; a found sound armed into velocity-aware zones; loops grabbed from the stream, arranged on an 8-bar grid, printed as stems." },
  { k: "the engineer", tool: "blind A/B", html: `A blind, loudness-matched A/B (integrated LUFS) against the untouched original, ${ROUNDS} rounds by one rater; the chain Pro-Q 3 → Pro-C 2 → Saturn 2 → Pro-L 2; the taste card an editable file, not a model.` },
  { k: "the record", tool: "side A", html: "The 2 a.m. memo against the finished master on one scale, then the whole finished side with its measured peaks." },
];
---

<Room
  title="Finishable — Jonathan Tollefson"
  description="I own Ableton, a wall of plugins and three hardware synths, and songs still weren't getting finished. Finishable is three tools built where music dies: a catalog that knows what I have, a studio that turns found sound into playable instruments, and a blind listening test my own ears can't cheat."
  label="finishable · 2026 – now"
  hook="I own all of it. The songs still weren't getting finished."
  cls="fin-cs"
>
  {/* DRAFT (Jon edits): the three deaths, the chapters in one line */}
  <ul class="fn-deaths" aria-label="where songs die">
    <li><b>lost</b><span>twenty thousand fragments no tool could read</span></li>
    <li><b>stalled</b><span>ideas gone before a project was even set up</span></li>
    <li><b>doubted</b><span>mixes redone forever, with no honest way to compare them</span></li>
  </ul>

  {/* ═══════ 01 · KNOW WHAT YOU HAVE ═══════ */}
  <header class="fn-ch">
    <p class="rm-label">{CHAPTERS[0].n} · {CHAPTERS[0].product}</p>
    <h2 class="rm-m">{CHAPTERS[0].job}</h2>
    <p class="fn-tag">{CHAPTERS[0].tag}</p>
  </header>
  <figure class="rm-object fn-object">
    <ChaosToBuckets />
    {/* DRAFT (Jon edits) */}
    <figcaption class="rm-cap">Scroll. The files sort themselves by sound into five bins; the duplicates fold away; the memo lands last.</figcaption>
  </figure>

  {/* ═══════ 02 · PLAY, DON'T FIDDLE ═══════ */}
  <header class="fn-ch">
    <p class="rm-label">{CHAPTERS[1].n} · {CHAPTERS[1].product}</p>
    <h2 class="rm-m">{CHAPTERS[1].job}</h2>
    <p class="fn-tag">{CHAPTERS[1].tag}</p>
  </header>
  <figure class="rm-object fn-object">
    <StudioChapter />
    {/* DRAFT (Jon edits) */}
    <figcaption class="rm-cap">Carry the loop to an engine. The band enters on the bar. Then grab four bars from the stream and arrange them.</figcaption>
  </figure>

  {/* ═══════ 03 · TRUST YOUR EARS ═══════ */}
  <div id="engineer">
    <header class="fn-ch">
      <p class="rm-label">{CHAPTERS[2].n} · {CHAPTERS[2].product}</p>
      <h2 class="rm-m">{CHAPTERS[2].job}</h2>
      <p class="fn-tag">{CHAPTERS[2].tag}</p>
    </header>
  </div>
  <div class="rm-read fn-read">
    {/* DRAFT (Jon edits) */}
    <p>
      Version one was going to learn my taste from a million votes. Under a blind, loudness-matched A/B it was
      overfitting a biased evaluator, and that fantasy died honestly. What it left behind is a test I can't cheat.
      Take a round yourself:
    </p>
  </div>
  <figure class="rm-object fn-object">
    {/* the caption ships INSIDE TheBench, so /judge and this page can never say two different things about it */}
    <TheBench round={round3} />
    <TasteLoop roundId="r3-palettes" cardFile="~/automation/data/taste/jon.json" cardLines={CARD_LINES} palettes={PALETTES} />
  </figure>
  <figure class="rm-object fn-object">
    <EngineDial />
    {/* DRAFT (Jon edits) */}
    <figcaption class="rm-cap">That restraint, live on the dial: the chain grows or shrinks between do less and do more.</figcaption>
  </figure>

  {/* ═══════ 04 · FINISH ═══════ */}
  <header class="fn-ch">
    <p class="rm-label">{CHAPTERS[3].n} · {CHAPTERS[3].product}</p>
    <h2 class="rm-m">{CHAPTERS[3].job}</h2>
  </header>
  <figure class="rm-object fn-object">
    <Finale />
  </figure>

  <RoomStory name="Finishable" blocks={BLOCKS} hood={HOOD} accent="#1a8f55" />
</Room>

<style is:global>
  /* ── the room's rhythm on the flagship: the deaths line under the hook, the chapter marks, the taglines ── */
  .fin-cs .rm-head { margin-bottom: var(--sp-6); }
  .fn-deaths { list-style: none; margin: 0 0 var(--sp-12); padding: 0; display: flex; flex-wrap: wrap; gap: 8px 32px; max-width: var(--rm-measure); }
  .fn-deaths li { display: flex; gap: 10px; align-items: baseline; font: 400 0.9375rem/1.5 var(--rm-sans); color: var(--rm-dim); }
  .fn-deaths b { font: 500 0.6875rem/1.6 var(--rm-mono); letter-spacing: 0.12em; text-transform: lowercase; color: var(--rm-ink); }
  .fn-ch { margin: var(--sp-12) 0 var(--sp-6); }
  .fn-ch .rm-label { margin-bottom: 8px; }
  .fn-ch .rm-m { margin: 0; font-size: 1.75rem; }
  .fn-ch .fn-tag { margin: 8px 0 0; max-width: var(--rm-measure); font: 400 1rem/1.6 var(--rm-sans); color: var(--rm-dim); }
  .fin-cs .rm-read { margin-top: 0; }
  .fin-cs .fn-read p { color: var(--rm-ink); }
  .fin-cs .fn-object + .fn-ch { margin-top: var(--sp-12); }
  .fin-cs .rm-read + .fn-object { margin-top: var(--sp-6); }

  /* ── the objects on the paper: they are product surfaces and keep their skins; the page gives them the room's
        mono and its sans for their display face (three faces, no fourth), and keeps them inside the 1080 column ── */
  .fin-cs { --cs-mono: var(--rm-mono); }
  .fin-cs :is(.sx-direction, .sx-tower-name, .sx .sx-gear p, .sx .sx-handoff, .ed-mod-name, .fin-line, .tl-chain-name, .tb) { font-family: var(--rm-sans); }
  /* (.fin-cs is the article inside .cs-main, so the override is article → section) */
  .fin-cs .sx.cs-bleed { width: 100%; margin-left: 0; transform: none; }
  .fin-cs .sx { padding-left: 0; padding-right: 0; }
  /* the studio's own two intro lines read on the room's paper in the room's inks */
  .fin-cs .sx .sx-origin, .fin-cs .sx .sx-direction { margin-left: 0; margin-right: 0; max-width: var(--rm-measure); text-align: left; color: var(--rm-dim); font-style: normal; }
  .fin-cs .sx .sx-gear, .fin-cs .sx .sx-handoff { margin-left: 0; margin-right: 0; }
  .fin-cs .sx .sx-handoff { color: var(--rm-ink); }
  .fin-cs .sx .sx-handoff a { color: inherit; }
  /* the bench's caption and the finale's lines in the room's ink */
  .fin-cs .tb-caption { color: var(--rm-dim); }
  .fin-cs .fin-line { color: var(--rm-ink); }
  .fin-cs .fin-line-quiet { color: var(--rm-dim); }
  .fin-cs .fin-stage { margin-left: 0; padding: 0 0 var(--sp-6); align-items: flex-start; }
  .fin-cs .fin-line { text-align: left; margin-left: 0; }
  /* the catalog's sticky stage: the room column is its measure */
  .fin-cs .ctb { margin-top: 0; }
</style>
