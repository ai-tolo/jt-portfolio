---
// ─────────────────────────────────────────────────────────────────────────
// FINISHABLE — the flagship, in the WORK room's material, focused (Stream C, 2026-10-06, Jon: "the modules feel a
// bit gimmicky, as though we've just been keeping stuff around because it's there").
//
// ONE live object leads: THE BENCH, the blind round. A stranger crowns a take without knowing which one is the
// untouched original; that is the claim the whole system rests on ("a test my own ears can't cheat"). Then the
// ledger's own number, set apart. Then the second object, THE RECORD: the 2 a.m. memo against the finished master,
// and the whole song to play. Round 2 (2026-10-06, Jon: "is it a website? is it an app? a program?"): the hook says
// what Finishable is; the list under it names the three programs; the bench's tag and reveal lines are this page's
// (ROUND overrides round3's, lib/finishable.ts untouched). The catalog and the studio are two of the four moments in the story
// card and rows in UNDER THE HOOD, with their real counts; their stages (ChaosToBuckets, StudioChapter), the taste
// card (TasteLoop) and the dial (EngineDial) stay on disk, unmounted.
// The numbers are READ FROM THE LEDGER (judge-ledger.json, the same dated harness snapshot /resume prints from) so
// no sentence here can drift stale. One sound the whole way (Audio 14.m4a → "head to toe"); no autoplay; one audio
// stage page-wide (bench:play claim/yield). Honors prefers-reduced-motion.
// ─────────────────────────────────────────────────────────────────────────
import Room from "../../components/case-study/room/Room.astro";
import RoomStory from "../../components/case-study/room/RoomStory.astro";
import TheBench from "../../components/case-study/atlas/TheBench.astro";
import Finale from "../../components/case-study/atlas/Finale.astro";
import { round3 } from "../../lib/finishable";
import judgeLedger from "../../lib/judge-ledger.json";

export const prerender = true;

const { rounds: ROUNDS, votes: VOTES, chose_original: ORIGINAL } = judgeLedger.blind;

// the bench in this page's words: round3's takes, a plain tag and plain reveal lines (lib/finishable.ts is not this lane's)
const REFS = [
  "air shelf up, tilted to flat, glued",
  "a ceiling and little else; the most dynamic of the three",
  "air rolled off, de-harshed, warm tube",
];
const ROUND = { ...round3, tag: "three masters · blind", takes: round3.takes.map((t, i) => ({ ...t, ref: REFS[i] })) };

// DRAFT (Jon edits): the read, second person, four moments: the question, the three tools in workflow order
const BLOCKS = [
  { h: "You own more than enough", p: "A DAW, a wall of plugins and synths that sound better than you need, and the songs still die: lost across drives, stalled before a project exists, mixed a fourth time with no honest way to compare. No product I owned touched those three places, so I built one program for each." },
  { h: "You know what you've recorded", p: "The catalog reads every recording by sound, folds the duplicates together and files the rest, so a voice memo you forgot comes back with a name." },
  { h: "You play before you set anything up", p: "Drop a recording into the studio and play it as an instrument, with drums, keys and bass on one clock. Grab a loop of your last four bars, arrange it and print stems for Ableton." },
  { h: "You judge blind", p: `The engineer masters a song several ways at matched loudness, puts the untouched mix among them, and you choose without knowing which is which. ${ROUNDS} rounds in, my picks lean toward restraint, often no processing at all. Its preferences are a file I can read, edit and overrule. The first record is in progress; the song above is on it.` },
];

// DRAFT (Jon edits) · UNDER THE HOOD: the system facts, true (numbers real or absent)
const HOOD = [
  { k: "role", tool: "solo", html: "Designer and builder, May 2026 to now; I use it every day." },
  { k: "stack", tool: "Python", html: "Astro for the surfaces; Python, Pedalboard and FabFilter for the audio; Whisper for the words; Claude in the loop." },
  { k: "the catalog", tool: "by sound", html: "20,279 files read by sound, deduplicated and filed into five bins." },
  { k: "the studio", tool: "Web Audio", html: "Drums, keys and bass on one bar clock; a found sound mapped into velocity-aware zones; loops grabbed from the last four bars, arranged on an 8-bar grid, printed as stems." },
  { k: "the engineer", tool: "blind A/B", html: "Loudness-matched by integrated LUFS against the untouched mix; the chain Pro-Q 3 → Pro-C 2 → Saturn 2 → Pro-L 2; the taste card, an editable file." },
  { k: "the record", tool: "head to toe", html: "Every waveform is measured from its audio file." },
];
---

<Room
  title="Finishable — Jonathan Tollefson"
  description="I own Ableton, a wall of plugins and three hardware synths, and songs still weren't getting finished. Finishable is three tools built where music dies: a catalog that knows what I have, a studio that turns found sound into playable instruments, and a blind listening test my own ears can't cheat."
  label="finishable · 2026 – now"
  hook="Finishable is three programs I built and run on my own computer to finish my songs."
  cls="fin-cs"
>
  {/* DRAFT (Jon edits): the three programs, one line each */}
  <ul class="fn-deaths" aria-label="the three programs">
    <li><b>catalog</b><span>names every recording I've made by what it sounds like</span></li>
    <li><b>studio</b><span>turns a found sound into a playable instrument</span></li>
    <li><b>engineer</b><span>masters a song; I rate its versions blind against the untouched mix</span></li>
  </ul>

  {/* THE BENCH: the one object. Its caption ships inside it (one string for /judge and this page), so the figure adds none. */}
  <figure class="rm-object fn-object" id="engineer">
    <TheBench round={ROUND} />
  </figure>

  {/* the ledger's own number */}
  <p class="rm-number"><b>{ORIGINAL} / {VOTES}</b><span>of my blind, loudness-matched votes went to the untouched mix over the engineer's masters · {ROUNDS} rounds · one rater</span></p>

  {/* THE RECORD: the second object. */}
  <figure class="rm-object fn-object">
    <Finale />
    {/* DRAFT (Jon edits) */}
    <figcaption class="rm-cap">A phone memo and the master it became: the same 18 seconds in sync, both waveforms on one scale. Switch between them as it plays.</figcaption>
  </figure>

  <RoomStory name="Finishable" blocks={BLOCKS} hood={HOOD} accent="#1a8f55" />
</Room>

<style is:global>
  /* ── the deaths line under the hook ── */
  .fin-cs .rm-head { margin-bottom: var(--sp-6); }
  .fn-deaths { list-style: none; margin: 0 0 var(--sp-8); padding: 0; display: flex; flex-wrap: wrap; gap: 8px 32px; max-width: var(--rm-measure); }
  .fn-deaths li { display: flex; gap: 10px; align-items: baseline; font: 400 0.9375rem/1.5 var(--rm-sans); color: var(--rm-dim); }
  .fn-deaths b { font: 500 0.6875rem/1.6 var(--rm-mono); letter-spacing: 0.12em; text-transform: lowercase; color: var(--rm-ink); }

  /* ── the two objects on the paper: product surfaces that keep their skins and wear the room's faces themselves
        (TheBench + Finale read --rm-sans / --rm-mono: three faces, no fourth); the page hangs them on the column's left edge ── */
  /* the bench's own caption is the figure's caption: the room's caption face, on the column's left edge */
  .fin-cs .tb-caption { margin: var(--sp-6) 0 0; max-width: var(--rm-measure); text-align: left; font: 600 0.75rem/1.5 var(--rm-mono); letter-spacing: 0.04em; color: var(--rm-ink); }
  .fin-cs .fin-stage { margin-left: 0; padding: 0 0 var(--sp-6); align-items: flex-start; }
</style>
