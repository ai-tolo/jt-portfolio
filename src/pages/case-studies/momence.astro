---
// Momence — restrained cut. Notion drives metadata; this file owns the body.
//
// ONE argument: name the four categories hiding in the mess first, and one
// customer profile becomes four businesses with zero net-new components.
// "Decompose before you draw. The schema is the contract; the layout is the
// implementation." Proof of fast, raw structural thinking under a clock —
// 48 hours, one screenshot, no users. The honesty is the punchline, not an
// apology: structural insight needs a model, not a marathon.
//
// Arc (one study, one argument):
//   hero            — masthead + skim-path thesis
//   the mess        — full-bleed, flat: the antagonist (undifferentiated
//                     density) on screen BEFORE any solution
//   decompose       — first-person reasoning beat → the annotated four-noun
//                     read (light reveal) → the thesis as a hero pull-quote
//   the payoff      — the tenant switcher, promoted to the section spine:
//                     you named the four; watch what they buy you
//   the surfaces    — ONE small supporting strip: same four, two form factors
//   the close       — the honest constraints reframed as the takeaway
//
// Visual intent (resolves the split-brain): the cream/mono editorial page is
// the analytical lens; every white card / framed screenshot is the specimen
// under it. Stated once, at the switcher.
//
// Astro gotchas honored: no {JSON} inside <script> bodies; .cs-bleed margins
// use longhand; the light reveal is IntersectionObserver-gated with a
// setTimeout fallback; prefers-reduced-motion shows final states.

import CSLayout from "../../components/case-study/CSLayout.astro";
import CSHero from "../../components/case-study/CSHero.astro";
import CSShortVersion from "../../components/case-study/CSShortVersion.astro";
import CSSection from "../../components/case-study/CSSection.astro";
import CSPullquote from "../../components/case-study/CSPullquote.astro";
import CSStatGrid from "../../components/case-study/CSStatGrid.astro";
import CSFigure from "../../components/case-study/CSFigure.astro";
import MomenceTenantSwitcher from "../../components/case-study/showcase/MomenceTenantSwitcher.astro";

export const prerender = true;
---

<CSLayout
  title="Momence — Jon Tollefson"
  description="Name the four categories hiding in the mess first, and one customer profile becomes four businesses with zero net-new components. A 48-hour take-home redesign of Momence's customer profile."
  ogImage="/case-studies/momence/cover.png"
>
  <CSHero
    eyebrow="May 2023"
    title="Momence"
    subtitle="One customer profile. Four businesses. Same four categories, reshuffled."
    cover="/case-studies/momence/cover.png"
    meta={[
      { label: "Role", value: "Sole designer · 48-hour take-home" },
      { label: "Timeline", value: "May 2023 · 48 hours, brief to submission" },
      { label: "Stack", value: "Figma" },
      { label: "Audience", value: "Studio and wellness admins" },
    ]}
  />

  <CSShortVersion rows={[
    { k: "the take-home", v: "48 hours, one screenshot, a written spec for a single yoga-studio admin: rebuild Momence's customer profile." },
    { k: "what I did", v: "Read the multi-tenant problem into the single-tenant brief: four categories that bend per tenant, rendered for web and mobile." },
    { k: "the outcome", v: "Brief to submission in 48 hours; the schema is the argument." },
  ]} />

  {/* ─────── THE MESS · the antagonist, on screen before any solution ─────── */}
  <section class="mo-mess cs-bleed" aria-label="The original Momence customer profile">
    <div class="mo-mess-inner">
      <p class="mo-mess-eyebrow">The brief</p>
      <h2 class="mo-mess-line">One screenshot. A wall of fields. Forty-eight hours.</h2>
      <p class="mo-mess-sub">
        This is the entire customer profile Momence already had — identity, money,
        behavior, and configuration, every field at the same flat weight. No hierarchy.
        No per-business flex. No mobile. The brief said redesign. The real problem was
        that nothing in here had a <em>name</em>.
      </p>
      <figure class="mo-mess-fig">
        <div class="mo-mess-frame">
          <img
            src="/case-studies/momence/notion-35fed8d4704f805591b2d6d7268dc597.png"
            alt="The original Momence customer profile, un-annotated: a dense two-column screen. A left identity rail (avatar, contact, membership, store credit, documents, custom info fields, customer tags) sits beside active subscriptions, active packs, and a long recent-activity feed mixing check-ins, payments, and email threads — every region rendered at the same flat visual weight."
          />
        </div>
      </figure>
    </div>
  </section>

  {/* ─────── DECOMPOSE · name the four nouns, then draw ─────── */}
  <CSSection
    title="Decompose before you draw"
    noTopRule
    deck="Before I drew a single box, I named what was actually in the mess. The first artifact wasn't a layout — it was four nouns."
  >
    <div class="mo-reveal-fig" data-mo-reveal>
      <CSFigure
        src="/case-studies/momence/notion-35fed8d4704f80d2acc0f7e4dfb69326.png"
        alt="The same Momence profile, annotated. Four large color-coded labels overlay regions of the UI: “Client Contact” on the left identity rail, “Business-Specific” on the active subscriptions and active packs, “User Interactions” on the recent-activity feed, and “Flex / Custom Fields” on the bottom-left custom info area."
        caption="Four functional categories sit under every Momence profile: Client Contact (identity, comms), Business-Specific (financials, subscriptions, credits), Flex Fields (per-tenant custom config), and User Interactions (activity, messages, notes). Name them first, and everything downstream can reshuffle per business without losing coherence — or adding a single net-new component."
        width="wide"
        framed
      />
    </div>

    <CSPullquote hero>
      Decompose before you draw. The schema is the contract. The layout is the implementation.
    </CSPullquote>

    <CSStatGrid
      stats={[
        { n: 4, label: "functional categories in the schema", color: "cyan" },
        { n: 4, label: "tenants, zero net-new components", color: "pink" },
        { n: 2, label: "form factors paired (web + mobile)", color: "yellow" },
        { n: 48, suffix: "h", label: "from brief to submission", color: "white" },
      ]}
    />
  </CSSection>

  {/* ─────── THE PAYOFF · the switcher, promoted to the section spine ─────── */}
  <CSSection
    title="You named the four. Watch what they buy you"
    deck="One customer — Yaz Kahrouf — dropped into a yoga studio, a B2B coaching practice, a pilates reformer, a wellness spa. The schema on the left never changes. Only which category gets to lead. It's already cycling — take it over."
  >
    <MomenceTenantSwitcher />
    <p class="mo-specimen-note">
      The white card is the specimen; this cream-and-mono page is the lens on it. Same
      four categories every time — yoga leads with sessions attended, coaching with hours
      and a contract value, pilates with reformer sessions, wellness with treatments. One
      profile, four businesses, zero net-new components.
    </p>
  </CSSection>

  {/* ─────── THE SURFACES · one small supporting strip ─────── */}
  <CSSection
    title="The same four, rendered"
    deck="Schema first, surfaces second. Web and mobile aren't two designs — they're the same four categories re-prioritized for two readers. Nothing net-new; just a different lead for a different screen."
  >
    <div class="mo-surfaces">
      <figure class="mo-surface mo-surface-web">
        <span class="mo-surface-tag">web · 1366px</span>
        <div class="mo-surface-frame framed">
          <img
            src="/case-studies/momence/notion-35fed8d4704f80e58a8fc06ae0e94090.png"
            alt="The Momence web customer detail redesign. Left rail: Yaz Kahrouf identity, custom info fields, customer tags. Center: large KPI cards (Sessions Attended 44, Total Spend $863.65), Active Subscriptions chips, Available Credits, Email Subscriptions toggle. Center-right: a Recent Activity feed with category filters and date-sorted entries mixing check-ins, payments, and email threads. Right rail: collapsible Upcoming Events calendar, Documents, Automations, Attachments, Tickets."
            loading="lazy"
          />
        </div>
        <figcaption>Full width gives Business-Specific and User Interactions room to lead; a collapsible right rail keeps events, documents, automations, and tickets one click away. Same four categories, more breathing room.</figcaption>
      </figure>

      <figure class="mo-surface mo-surface-mobile">
        <span class="mo-surface-tag">mobile · 360px</span>
        <div class="mo-surface-frame framed">
          <img
            src="/case-studies/momence/notion-35fed8d4704f80d58efffafb4bad62dd.png"
            alt="The Momence mobile customer detail. A dark hero band with a YK avatar, the name Yaz Kahrouf, and a joined-August-2022 line noting attendance today. Below it: mobile and email fields, three tab buttons (Info, Activity, More), two KPI cards reading $863.65 total spend and 44 sessions attended, an active-subscriptions chip row, a tags chip row, and available-credits and email-subscriptions rows. A bottom tab bar carries Overview, Customers, Support, and Settings."
            loading="lazy"
          />
        </div>
        <figcaption>360px. The same four categories re-stack so the most time-sensitive one leads for an admin glancing between classes; collapsible flex menus keep density without losing thumb-reach.</figcaption>
      </figure>
    </div>
  </CSSection>

  {/* ─────── THE CLOSE · the honest constraints, reframed as the point ─────── */}
  <CSSection title="One screenshot, 48 hours, no users" deck="The honest version — and why it's the argument, not the apology.">
    <div class="prose-block">
      <p>48 hours from brief to submission. One screenshot to work from. A written spec for a single yoga-studio admin. Not shipped. Every decision mine.</p>
      <p>That used to read like a column of caveats. It's the opposite. The four-category schema didn't come from a research budget or a quarter of iteration — it came from looking at the mess and naming what was in it. That's the part that travels to any data-dense admin redesign.</p>
    </div>

    <CSPullquote>
      Structural insight doesn't need a marathon. It needs a model.
    </CSPullquote>
  </CSSection>

  <div class="cs-foot">
    <a href="/#work" class="cs-foot-back">← back to selected work</a>
  </div>
</CSLayout>

<script>
  // Light reveal: fade/lift figures in when they scroll into view. IO-gated;
  // a setTimeout fallback guarantees the visible state even where IO/transition
  // are throttled (headless preview). prefers-reduced-motion shows them shown.
  // NOT a field-migration animation — just a settle.
  (() => {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const els = document.querySelectorAll<HTMLElement>("[data-mo-reveal]");
    if (!els.length) return;
    // Reveal = add the class so CSS fades/rises the figure in. Then SNAP-GUARANTEE
    // the end-state: some headless / background tabs throttle CSS transitions,
    // which would otherwise leave the centerpiece stuck at opacity 0. Forcing the
    // transition off shortly after (well past the 800ms fade) resolves the element
    // to its final state regardless. In a foreground tab the fade has already
    // finished by then, so this is a no-op there — the reveal still plays.
    const reveal = (el: HTMLElement) => {
      el.classList.add("is-in");
      window.setTimeout(() => { el.style.transition = "none"; }, reduce ? 0 : 900);
    };
    if (reduce || !("IntersectionObserver" in window)) {
      els.forEach(reveal);
      return;
    }
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          reveal(e.target as HTMLElement);
          io.unobserve(e.target);
        }
      }
    }, { threshold: 0.3 });
    els.forEach((el) => {
      io.observe(el);
      // Safety net: if the observer never fires (no scroll reaches it, or the
      // tab throttles IO), reveal anyway so the figure is never stuck invisible.
      window.setTimeout(() => reveal(el), 1600);
    });
  })();
</script>

<style>
  /* .prose-block carries no rules of its own — the paragraphs inherit the
     house prose settings (measure, size, rhythm) from CSLayout's .cs-main. */

  /* ── the mess: full-bleed, flat antagonist ───────────────────────────── */
  .mo-mess {
    /* longhand margins — shorthand would reset the .cs-bleed margin-left:50% */
    margin-top: 0;
    margin-bottom: 0;
    padding: clamp(72px, 10vw, 120px) 32px;
    border-bottom: 1px solid var(--cs-line);
    background: radial-gradient(70% 80% at 50% 0%, color-mix(in srgb, var(--brand-orange) 5%, transparent), transparent 70%);
    overflow: hidden;
  }
  .mo-mess-inner {
    max-width: 1160px;
    margin: 0 auto;
  }
  .mo-mess-eyebrow {
    font-family: var(--cs-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--cs-text-dim);
    margin: 0 0 12px;
  }
  .mo-mess-line {
    font-family: var(--cs-mono);
    font-style: italic;
    font-weight: 700;
    font-size: clamp(28px, 4.5vw, 42px);
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--cs-text);
    margin: 0;
    max-width: 24ch;
  }
  .mo-mess-sub {
    font-weight: 400;
    font-size: clamp(16px, 1.6vw, 18px);
    line-height: 1.5;
    color: var(--cs-text-muted);
    margin: 18px 0 0;
    max-width: 60ch;
  }
  .mo-mess-sub em { font-style: normal; color: var(--cs-text); }
  .mo-mess-fig { margin: 48px 0 0; }
  .mo-mess-frame {
    background: var(--cs-text);
    border: 1px solid var(--cs-line);
    border-radius: 4px;
    padding: 16px;
    overflow: hidden;
  }
  .mo-mess-frame img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 2px;
  }

  /* ── light reveal for the annotated centerpiece ──────────────────────── */
  .mo-reveal-fig {
    opacity: 0;
    transform: translateY(16px) scale(0.99);
    transition: opacity 800ms ease, transform 800ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .mo-reveal-fig.is-in { opacity: 1; transform: none; }

  /* ── specimen / lens note (stated once) ──────────────────────────────── */
  .mo-specimen-note {
    font-family: var(--cs-mono);
    font-style: italic;
    font-size: 13px;
    color: var(--cs-text-muted);
    line-height: 1.55;
    margin: 18px 0 0;
    max-width: 64ch;
  }

  /* ── paired surfaces (web + mobile) — supporting strip ───────────────── */
  .mo-surfaces {
    display: grid;
    grid-template-columns: minmax(0, 1.62fr) minmax(0, 1fr);
    gap: 22px;
    align-items: start;
    margin-top: 32px;
    margin-bottom: 32px;
  }
  @media (max-width: 880px) {
    .mo-surfaces { grid-template-columns: 1fr; gap: 28px; }
  }
  .mo-surface { margin: 0; }
  .mo-surface-tag {
    display: inline-block;
    font-family: var(--cs-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.28em;
    color: var(--cs-text-dim);
    margin-bottom: 12px;
  }
  .mo-surface-frame {
    overflow: hidden;
    border-radius: 4px;
  }
  .mo-surface-frame.framed {
    background: var(--cs-text);
    border: 1px solid var(--cs-line);
    padding: 16px;
  }
  .mo-surface-mobile .mo-surface-frame.framed { padding: 16px 22px; }
  .mo-surface-frame img { display: block; width: 100%; height: auto; }
  .mo-surface figcaption {
    font-family: var(--cs-mono);
    font-style: italic;
    font-size: 13px;
    color: var(--cs-text-muted);
    line-height: 1.5;
    margin-top: 12px;
    max-width: 60ch;
  }

  /* .cs-foot / .cs-foot-back live in CSLayout now — one quiet lowercase
     mono line shared by all five studies. Nothing page-local here. */

  @media (prefers-reduced-motion: reduce) {
    .mo-reveal-fig { transition: none; }
  }
</style>
