---
// Momence — theatrical cut. Notion drives metadata; this file owns the body.
//
// Spine: decompose before you draw. The four-category schema is the contract;
// the layout is the implementation. ONE customer profile (Yaz Kahrouf)
// reshuffles its entire priority order across four tenants using the SAME
// four primitives — and that reshuffle IS the case study.
//
// Structure (say less, show more):
//   hero
//   01 · the reshuffle, live      — the switcher leads, auto-cycling, before
//                                     the argument. Concept proves itself first.
//   ——  decompose-before-you-draw  — the annotated four-category read +
//                                     the thesis as a pull-quote (was §01–03)
//   ——  interstitial               — "A snapshot is data. A snapshot with
//                                     direction is product." full-bleed, on scroll
//   02 · the surfaces              — web + mobile, paired cinematically
//   03 · what generalizes          — two moves + the 48h note
//
// Astro gotchas honored: no {JSON} inside <script> bodies (none needed here);
// .cs-bleed margins use longhand; scroll-motion is IntersectionObserver-gated
// with a setTimeout fallback; prefers-reduced-motion shows final states.

import CSLayout from "../../components/case-study/CSLayout.astro";
import CSHero from "../../components/case-study/CSHero.astro";
import CSSection from "../../components/case-study/CSSection.astro";
import CSPullquote from "../../components/case-study/CSPullquote.astro";
import CSStatGrid from "../../components/case-study/CSStatGrid.astro";
import CSLiveDemo from "../../components/case-study/CSLiveDemo.astro";
import CSFigure from "../../components/case-study/CSFigure.astro";
import MomenceTenantSwitcher from "../../components/case-study/showcase/MomenceTenantSwitcher.astro";

export const prerender = true;
---

<CSLayout
  title="Momence — Jon Tollefson"
  description="One customer profile that reshuffles to fit each business. 48-hour take-home redesign of Momence's customer profile: a four-category schema, modular by tenant, paired desktop and mobile."
  ogImage="/case-studies/momence/cover.png"
>
  <CSHero
    eyebrow="Case study 05 · May 2023 — 48-hour take-home"
    title="Momence"
    subtitle="One customer profile. Four businesses. Same four primitives, reshuffled."
    cover="/case-studies/momence/cover.png"
    meta={[
      { label: "Role", value: "Sole designer · self-initiated case study" },
      { label: "Timeline", value: "May 2023 · 48 hours, brief to submission" },
      { label: "Stack", value: "Figma" },
      { label: "Audience", value: "Yoga / coaching / wellness admins" },
    ]}
  />

  {/* ─────── 01 · THE RESHUFFLE, LIVE (lead with the proof) ─────── */}
  <CSSection
    num="01"
    title="Watch one profile become four"
    deck="One customer — Yaz Kahrouf — across a yoga studio, a B2B coaching practice, a pilates reformer, a wellness spa. It's cycling on its own. Watch the lead number, the flex fields, the labels reshuffle. Then take it over."
    noTopRule
  >
    <CSLiveDemo
      label="LIVE · IT'S ALREADY MOVING"
      caption="Yoga leads with Sessions attended. Coaching leads with Hours coached and a contract value. Pilates leads with Reformer sessions and apparatus preference. Wellness leads with Treatments YTD and pressure-pref flex fields. The schema on the left never changes — only which primitive gets to lead."
      bleed
      pad="comfy"
    >
      <MomenceTenantSwitcher />
    </CSLiveDemo>
  </CSSection>

  {/* ─────── DECOMPOSE BEFORE YOU DRAW (was §01–03, collapsed) ─────── */}
  <CSSection
    num="02"
    title="Decompose before you draw"
    deck="What you just watched only works because nothing was drawn until the schema was named. The existing profile was dense but flat — identity, finance, behavior, and config all at the same visual weight, no hierarchy, no tenant flex, no mobile. So the first move wasn't a layout. It was four categories."
  >
    <CSFigure
      src="/case-studies/momence/notion-35fed8d4704f80d2acc0f7e4dfb69326.png"
      alt="The existing Momence customer profile annotated. Four large color-coded labels overlay regions of the UI: 'Client Contact' on the left identity rail, 'Business-Specific' on the active subscriptions and active packs sections, 'User Interactions' on the recent activity feed, and 'Flex / Custom Fields' on the bottom-left custom info area."
      caption="Four functional categories sit under every Momence customer profile: Client Contact (identity, comms), Business-Specific (financials, subscriptions, credits), Flex Fields (per-tenant custom config), and User Interactions (activity, messages, notes). Name them first, and the layout downstream can reshuffle per tenant without losing coherence — or a single net-new component."
      width="wide"
      framed
    />

    <CSPullquote hero>
      Decompose before you draw. The schema is the contract. The layout is the implementation.
    </CSPullquote>

    <CSStatGrid
      stats={[
        { n: 4, label: "functional categories in the schema", color: "cyan" },
        { n: 4, label: "tenants, zero net-new components", color: "pink" },
        { n: 2, label: "form factors paired (web + mobile)", color: "yellow" },
        { n: 48, suffix: "h", label: "from brief to submission", color: "white" },
      ]}
    />
  </CSSection>

  {/* ─────── INTERSTITIAL · the best sentence, at cinematic scale ─────── */}
  <section class="mo-interstitial cs-bleed" data-mo-reveal aria-label="A snapshot is data. A snapshot with direction is product.">
    <p class="mo-interstitial-line">
      <span>A snapshot is data.</span>
      <span class="mo-interstitial-turn">A snapshot with direction is product.</span>
    </p>
  </section>

  {/* ─────── 03 · THE SURFACES (web + mobile, paired) ─────── */}
  <CSSection
    num="03"
    title="The same hierarchy, two form factors"
    deck="Downstream of the schema, two surfaces. Web leads with KPI cards that carry trend (+11% over 3 months, +17% last month) so a number reads as movement, not a static value. Mobile collapses the same four primitives for a thumb — time-sensitive context first, full record one tap below."
  >
    <div class="mo-surfaces">
      <figure class="mo-surface mo-surface-web">
        <span class="mo-surface-tag">WEB · 1366px</span>
        <div class="mo-surface-frame framed">
          <img
            src="/case-studies/momence/notion-35fed8d4704f80e58a8fc06ae0e94090.png"
            alt="The Momence web customer detail redesign. Left rail: Yaz Kahrouf identity, custom info fields, customer tags. Center: large KPI cards (Sessions Attended 44 +11%, Total Spend $863.65 +17%), Active Subscriptions chips, Available Credits, Email Subscriptions toggle. Center-right: a Recent Activity feed with category filters and date-sorted entries mixing check-ins, payments, and email threads. Right rail: collapsible Upcoming Events calendar, Documents, Automations, Attachments, Tickets."
            loading="lazy"
          />
        </div>
        <figcaption>KPIs lead with trend. The Recent Activity feed unifies messages, payments, check-ins, and emails behind one set of macro icons; a collapsible right rail holds events, documents, automations, and tickets.</figcaption>
      </figure>

      <figure class="mo-surface mo-surface-mobile">
        <span class="mo-surface-tag">MOBILE · 360px</span>
        <div class="mo-surface-frame framed">
          <img
            src="/case-studies/momence/notion-35fed8d4704f80d58efffafb4bad62dd.png"
            alt="The Momence mobile customer detail. Dark hero band with avatar 'YK' and 'Yaz Kahrouf', 'Joined Aug 2022 · Attended today.' Below: mobile/email fields, three tab buttons (Info, Activity, More). Two KPI cards: $863.65 Total Spend +17% and 44 Sessions Attended +11%. Active Subscriptions chip row, Tags chip row, Available Credits and Email Subscriptions rows. Bottom tab bar: Overview / Customers / Support / Settings."
            loading="lazy"
          />
        </div>
        <figcaption>360px. Collapsible flex menus keep density without losing thumb-reach. Status indicators (Attended today, +11%) lead so an admin walking back from class scans the same hierarchy as the desktop reader.</figcaption>
      </figure>
    </div>

    <CSFigure
      src="/case-studies/momence/notion-35fed8d4704f802384e5f160d438fb5f.png"
      alt="The Recent Activity panel detailed. Custom macro icons distinguish activity type (orange person for check-in, black dollar for payment, blue email). An email subject line expands inline with the message body when relevant. Annotations: 'Filter content by category or input custom search', 'Integrated email to provide full context of client interactions', 'Custom macro icons to quickly distinguish activity type', 'Easily navigate to full activity page'."
      caption="Activity is the one surface that has to carry messages, payments, check-ins, and email threads at once. Macro icons collapse the type-distinction into a glance; expanded email previews keep the actual message in context."
      width="wide"
      framed
    />
  </CSSection>

  {/* ─────── 04 · WHAT GENERALIZES ─────── */}
  <CSSection num="04" title="What generalizes" deck="The two moves I'd repeat on any data-dense admin redesign.">
    <ul class="generalize">
      <li>
        <strong>Decompose before you draw.</strong>
        Naming the four functional categories before any layout work is the move. Without it, "drag to rearrange" becomes drag-to-rearrange chaos. With it, modularity becomes a customer-tailoring feature instead of a usability tax — one schema, four tenants, no redesign cycle.
      </li>
      <li>
        <strong>A snapshot is data. A snapshot with direction is product.</strong>
        Trend indicators on KPI cards move users from "read the number" to "act on the movement." That's where data-dense admin tools earn their keep — turning a state read into an action prompt.
      </li>
    </ul>

    <div class="prose-block">
      <p class="muted">48 hours from brief to submission, working from one screenshot of the existing customer profile and a written spec for a yoga studio admin. Not shipped. All design decisions are mine.</p>
    </div>
  </CSSection>

  <div class="cs-foot">
    <a href="/#work" class="cs-foot-back">← back to selected work</a>
  </div>
</CSLayout>

<script>
  // Fade the full-bleed interstitial in when it scrolls into view. IO-gated;
  // a setTimeout fallback guarantees the visible state even where IO/transition
  // are throttled (headless preview). prefers-reduced-motion shows it shown.
  (() => {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const els = document.querySelectorAll<HTMLElement>("[data-mo-reveal]");
    if (!els.length) return;
    if (reduce || !("IntersectionObserver" in window)) {
      els.forEach((el) => el.classList.add("is-in"));
      return;
    }
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          (e.target as HTMLElement).classList.add("is-in");
          io.unobserve(e.target);
        }
      }
    }, { threshold: 0.45 });
    els.forEach((el) => {
      io.observe(el);
      // Fallback: if the observer never fires (throttled headless tab), reveal
      // anyway so the line is never stuck invisible.
      window.setTimeout(() => el.classList.add("is-in"), 1600);
    });
  })();
</script>

<style>
  .prose-block { max-width: 64ch; }
  .prose-block .muted { color: rgba(245, 241, 232, 0.48); font-size: 14.5px; }

  /* ── full-bleed interstitial ─────────────────────────────────────────── */
  .mo-interstitial {
    /* longhand margins — shorthand would reset the .cs-bleed margin-left:50% */
    margin-top: 40px;
    margin-bottom: 40px;
    min-height: 62vh;
    display: grid;
    place-items: center;
    padding: 80px 32px;
    background:
      radial-gradient(60% 80% at 50% 50%, rgba(255, 90, 60, 0.05), transparent 70%),
      linear-gradient(180deg, transparent 0%, rgba(255, 39, 97, 0.02) 50%, transparent 100%);
    border-top: 1px solid rgba(245, 241, 232, 0.06);
    border-bottom: 1px solid rgba(245, 241, 232, 0.06);
    overflow: hidden;
  }
  .mo-interstitial-line {
    margin: 0;
    max-width: 22ch;
    text-align: center;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-style: italic;
    font-weight: 700;
    font-size: clamp(30px, 6.4vw, 76px);
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: rgba(245, 241, 232, 0.30);
  }
  .mo-interstitial-line span {
    display: block;
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 900ms ease, transform 900ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .mo-interstitial-turn {
    background: linear-gradient(90deg, #ff2761 0%, #ff5a3c 50%, #ffb347 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
    margin-top: 0.12em;
  }
  .mo-interstitial.is-in .mo-interstitial-line span { opacity: 1; transform: none; }
  .mo-interstitial.is-in .mo-interstitial-line span:first-child { transition-delay: 60ms; }
  .mo-interstitial.is-in .mo-interstitial-turn { transition-delay: 380ms; }

  /* ── paired surfaces (web + mobile) ──────────────────────────────────── */
  .mo-surfaces {
    display: grid;
    grid-template-columns: minmax(0, 1.62fr) minmax(0, 1fr);
    gap: 22px;
    align-items: start;
    margin-top: 32px;
    margin-bottom: 32px;
  }
  @media (max-width: 880px) {
    .mo-surfaces { grid-template-columns: 1fr; gap: 28px; }
  }
  .mo-surface { margin: 0; }
  .mo-surface-tag {
    display: inline-block;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(245, 241, 232, 0.45);
    margin-bottom: 10px;
  }
  .mo-surface-frame {
    overflow: hidden;
    border-radius: 4px;
  }
  .mo-surface-frame.framed {
    background: #f5f1e8;
    border: 1px solid var(--cs-line);
    padding: 16px;
  }
  .mo-surface-mobile .mo-surface-frame.framed { padding: 16px 22px; }
  .mo-surface-frame img { display: block; width: 100%; height: auto; }
  .mo-surface figcaption {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-style: italic;
    font-size: 12.5px;
    color: rgba(245, 241, 232, 0.55);
    line-height: 1.5;
    margin-top: 14px;
    max-width: 60ch;
  }

  /* ── what-generalizes list ───────────────────────────────────────────── */
  .generalize {
    list-style: none;
    padding: 0;
    margin: 18px 0 28px;
    display: grid;
    gap: 18px;
    max-width: 64ch;
  }
  .generalize li {
    padding: 16px 18px;
    border: 1px solid var(--cs-line);
    border-radius: 4px;
    background: rgba(245, 241, 232, 0.02);
    font-size: 15px;
    line-height: 1.55;
    color: rgba(245, 241, 232, 0.85);
  }
  .generalize li strong {
    display: block;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-style: italic;
    font-size: 15px;
    color: var(--brand-orange);
    margin-bottom: 6px;
    letter-spacing: -0.005em;
  }

  .cs-foot {
    text-align: center;
    padding: 64px 0 0;
  }
  .cs-foot-back {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--brand-orange);
    text-decoration: none;
    padding: 8px 16px;
    border: 1px solid rgba(255, 90, 60, 0.32);
    border-radius: 2px;
    transition: color 160ms ease, border-color 160ms ease, background 160ms ease;
  }
  .cs-foot-back:hover {
    color: #f5f1e8;
    border-color: var(--brand-orange);
    background: rgba(255, 90, 60, 0.08);
  }

  @media (prefers-reduced-motion: reduce) {
    .mo-interstitial-line span { transition: none; }
  }
</style>
