---
// SIGNAL STUDIO — the flagship study, a PRODUCT PITCH in the WORK room's material (2026-10-15; replaces the-console).
// Round two (Jon: "way too wordy … doesn't sound human or creative or funny"): the page is OBJECTS with his lines
// beside them, nothing longer than a breath. Round four (2026-10-19, the co-partner interview, five challenges):
// FIVE SCENES (the take · grab · the radar · print, stacks, export · the hands; the library cut, "fine with the library
// not being in there"), the pipeline box retired (the stacks scene is the pipeline), the card rewritten from his
// thesis ("there should be a mastering Ableton and a jam version of Ableton, and that just doesn't exist"), the hood
// cut to what the 2026-10-19 law audit proved or the tree counts. The controller is an AMENITY, not the interface
// (Jon: "a luxury so I don't even need to touch my computer", "a way to keep looking out the window"). The name ships
// as Signal Studio (both names are placeholders, his call: "whatever is easiest"). Spine: ~/signal-studio-ideation/
// positioning-2026-10-19.md. Shot list: docs/STUDIO-SHOTS.md.
//
// THE RULINGS: silent (muted captures, no audio); the streaming service never named ("the song you're listening to");
// the study leads the block; nothing on the page is his diary (the scenes are anyone's).
//
// THE SLOTS: a capture names `public/case-studies/signal-studio/<name>.webm` (+ `<name>.webp` poster); a drawing names
// `<name>.svg` or `<name>.webp`. Each is an HONEST EMPTY FRAME (a 1px outline, the caption centred) until the file
// exists at build time (fs.existsSync). Only on-screen videos play; reduced motion = paused with controls.
//
// Every line is DRAFT for Jon's pass. The lines are his, from the 2026-10-19 interview, lightly cut, none invented.
import fs from "node:fs";
import path from "node:path";
import Room from "../../components/case-study/room/Room.astro";
import RoomStory from "../../components/case-study/room/RoomStory.astro";

export const prerender = true;

const ACCENT = "#2a5bd7";
const dir = path.join(process.cwd(), "public", "case-studies", "signal-studio");
const first = (names: string[]) => names.map((f) => (fs.existsSync(path.join(dir, f)) ? `/case-studies/signal-studio/${f}` : null)).find(Boolean) ?? null;

// DRAFT (Jon edits) · THE SCENES: a recording beside one of his lines. `shot` is what the frame will hold (and the
// pending caption until it does); the scene list and its dependencies live in docs/STUDIO-SHOTS.md.
type Scene = { name: string; shot: string; k: string; line: string };
const SCENES: Scene[] = [
  { name: "take", shot: "drums and keys running, nothing armed; a take cut out afterwards", k: "it was already listening", line: "How much would you pay for every session you thought was recording and wasn't?" },
  { name: "grab", shot: "a song playing on the laptop; one key; four bars become a chip", k: "anything you're listening to", line: "One click and it works. It regiments the bars and has a spot for it. No new track, no picking a color." },
  { name: "radar", shot: "a mic picked; a progression played out loud; the chord, the scale and the tempo land on the glass", k: "the radar", line: "Ableton doesn't even care about key. The radar hears the room and names the chord, the scale, the tempo." },
  { name: "stacks", shot: "hold print: the drums freeze into a chip and the grid empties; four stacks switched on the bar line; export, one wav per chip", k: "print · stacks · export", line: "Grab it, loop it, compartmentalize it. Then Ableton gets the stems and does what it's good at." },
  { name: "hands", shot: "one phrase on the laptop keys, then a MIDI keyboard, then the controller, eyes out the window", k: "laptop · midi · controller", line: "The controller is a luxury: my main things at my fingertips, eyes out the window." },
].map((p) => ({ ...p, src: first([`${p.name}.webm`]), poster: first([`${p.name}.webp`]) }));

// DRAFT (Jon edits) · THE DRAWINGS: slots for Jon's own assets, one line each
const ART = [
  { name: "bench", cap: "the three engines, any sound through any of them", k: "the ultimate consolidation", line: "My synth through the drum engine. My bass through the synth engine. Every effect on every instrument, on one page." },
  { name: "everyway", cap: "every way I've recorded, drawn as one room", k: "works no matter what", line: "Stand-up pianos, intense synthesizers, a tiny keyboard on the road. Anything that can send MIDI immediately works." },
].map((a) => ({ ...a, src: first([`${a.name}.svg`, `${a.name}.webp`]) }));

// the old ritual, in order (Jon: "a specific, intense, scientific environment")
const RITUAL = ["outlets", "power switches", "the interface", "a software update", "arm the channels", "the one loose cable"];

// DRAFT (Jon edits) · the card: three short blocks, his thesis from the interview
const BLOCKS = [
  { h: "A jam version of Ableton", p: "There should be a mastering Ableton and a jam Ableton. The second one didn't exist, so I built it. Past a certain point the things you don't need get in the way of the things you do." },
  { h: "Zero threshold", p: "No arming, no channels, no “save this as a project?”. Producing a sound, grabbing it, looping it, compartmentalizing it: one click each, on two pages. The beauty is the whole experience, not any one trick." },
  { h: "It's real and I have it", p: "Who cares if Da Vinci had the helicopter engineered and no website for it. It runs on my laptop, with whatever I plug into it." },
];

// UNDER THE HOOD: read from ~/sites/signal-studio-page (branch `page`, read-only) and the law audit of 2026-10-19
// (~/signal-studio-ideation/law-audit-2026-10-19.md). Only PROVEN laws and plain counts; nothing the audit calls weak
// or untested is stated as measured (the 48 kHz, 600 s, 24-bit and "one click to Ableton" rows of round three are gone).
const HOOD = [
  { k: "stack", tool: "Vite + TypeScript", html: "A browser app, no framework. Web Audio on the audio thread, IndexedDB for everything saved. 958 tracked files, 225 of them tests." },
  { k: "laws", tool: "177, numbered", html: "Each rule is written down in plain words before it is built. The audit of 2026-10-19 proved 91 of them by test and names the rest weak or untested." },
  { k: "record", tool: "the loopback", html: "The output is captured all the time; a take is cut out after the fact. A crash loses at most about two seconds. ARM is for a microphone, and only a click opens one." },
  { k: "clock", tool: "one lattice", html: "Chips, drums and bass share one clock: a chip's downbeat and a drum's land under 2 ms apart. Each sound is booked early by its own path's latency." },
  { k: "chip", tool: "warp", html: "A chip owns its sound and its effects. Off the tempo by more than 1 % it warps with its pitch held; on and off are a ramp at the next bar line." },
  { k: "rip", tool: "MIDI", html: "My hardware played note by note over MIDI and kept as voices: 212 from the MODX, browsed the way the synth browses them. The room travels." },
  { k: "radar", tool: "essentia.js", html: "A microphone into a worker: chroma into chord detection, a key extractor, a rhythm extractor for the tempo." },
  { k: "hands", tool: "Web MIDI + WebHID", html: "Any MIDI keyboard, through a velocity curve fitted to my playing. A DualSense over WebHID: square grabs, cross starts the drums, the right stick is reverb and delay, the touchpad is the EQ." },
  { k: "stacks", tool: "landing", html: "Loops of any beat count and a dice on every tower (FB24), then PRINT, SWITCH and EXPORT (one WAV per chip per stack) are decided and landing. This page shows them from the brief, not from the shipped build." },
];
---

<Room
  title="Signal Studio — Jonathan Tollefson"
  description="Signal Studio is a music studio in a browser tab, two pages, built around my own instrument: always listening, anything you hear becomes a chip, the radar names the key, and Ableton gets the stems."
  label="signal studio · 2026 – now"
  hook="One click away from sounds being made and recorded."
  cls="sg-cs"
>
  {/* DRAFT (Jon edits): the line under the hook */}
  <p class="sg-claim">A music studio in a browser tab, two pages, built around my own <a href="/signal">instrument</a>. Ableton is more powerful. This is more usable, and it works no matter what I plug into it.</p>

  {/* THE RITUAL: the old way, struck through, then the new way. The page draws this one itself. */}
  <figure class="sg-ritual" aria-label="the old ritual, then the new one">
    <ol class="sg-ritual-old">
      {RITUAL.map((r) => <li>{r}</li>)}
    </ol>
    <p class="sg-ritual-new"><b>laptop.</b> <span>play.</span></p>
    {/* DRAFT (Jon edits) */}
    <figcaption class="sg-cap">Honestly, I don't even need to plug anything in.</figcaption>
  </figure>

  {/* THE SCENES: a recording beside one line */}
  <div class="sg-pillars">
    {SCENES.map((pl) => (
      <section class="sg-pillar" id={`pillar-${pl.name}`} aria-labelledby={`pillar-${pl.name}-h`}>
        <figure class="sg-fig" data-pending={pl.src ? undefined : ""}>
          <div class="sg-frame">
            {pl.src ? (
              <video class="sg-video" src={pl.src} poster={pl.poster ?? undefined} muted playsinline loop preload="metadata" aria-label={pl.shot} />
            ) : (
              <p class="sg-pending">{pl.shot}</p>
            )}
          </div>
          {pl.src && <figcaption class="sg-placard">{pl.shot}</figcaption>}
        </figure>
        <div class="sg-pitch">
          <p class="sg-k" id={`pillar-${pl.name}-h`}>{pl.k}</p>
          <p class="sg-line">{pl.line}</p>
        </div>
      </section>
    ))}
  </div>

  {/* THE DRAWINGS: Jon's assets, honest slots until they land */}
  <div class="sg-pillars sg-arts">
    {ART.map((a) => (
      <section class="sg-pillar sg-art" id={`art-${a.name}`} aria-labelledby={`art-${a.name}-h`}>
        <figure class="sg-fig" data-pending={a.src ? undefined : ""}>
          <div class="sg-frame sg-frame-art">
            {a.src ? <img class="sg-img" src={a.src} alt={a.cap} loading="lazy" /> : <p class="sg-pending">{a.cap}</p>}
          </div>
        </figure>
        <div class="sg-pitch">
          <p class="sg-k" id={`art-${a.name}-h`}>{a.k}</p>
          <p class="sg-line">{a.line}</p>
        </div>
      </section>
    ))}
  </div>

  <RoomStory name="Signal Studio" blocks={BLOCKS} hood={HOOD} accent={ACCENT} />
</Room>

<script>
  // on-screen captures play; off-screen pause; reduced motion holds still with controls
  {
    const vids = Array.from(document.querySelectorAll<HTMLVideoElement>(".sg-video"));
    if (vids.length) {
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) vids.forEach((v) => { v.pause(); v.controls = true; });
      else {
        const io = new IntersectionObserver((es) => es.forEach((e) => { const v = e.target as HTMLVideoElement; if (e.isIntersecting) void v.play().catch(() => {}); else v.pause(); }), { threshold: 0.25 });
        vids.forEach((v) => io.observe(v));
      }
    }
  }
</script>

<style is:global>
  /* ── the claim ── */
  .sg-cs .rm-head { margin-bottom: var(--sp-4); }
  .sg-cs .rm-hook { max-width: 18ch; font-size: 2.75rem; }
  @media (max-width: 720px) { .sg-cs .rm-hook { font-size: 2.125rem; } }
  /* three classes deep on every <p>: Room's `.room-cs .cs-main :where(p)` reset (two classes) otherwise wins */
  .room-cs .sg-cs .sg-claim { max-width: var(--rm-measure); margin: 0 0 var(--sp-12); font: 400 1.125rem/1.55 var(--rm-sans); color: var(--rm-ink); text-wrap: pretty; }

  /* ── the ritual: six steps struck through, then two words ── */
  .sg-ritual { margin: 0 0 var(--sp-12); padding: var(--sp-8) 0; border-top: 1px solid color-mix(in oklab, var(--rm-ink) 12%, transparent); border-bottom: 1px solid color-mix(in oklab, var(--rm-ink) 12%, transparent); }
  .sg-ritual-old { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 28px; counter-reset: step; }
  .sg-ritual-old li { font: 500 1.125rem/1.4 var(--rm-display); color: var(--rm-dim); text-decoration: line-through; text-decoration-thickness: 1.5px; text-decoration-color: color-mix(in oklab, var(--rm-ink) 55%, transparent); }
  .sg-ritual-old li::before { counter-increment: step; content: counter(step, decimal-leading-zero); display: inline-block; margin-right: 8px; font: 500 0.6875rem/1 var(--rm-mono); letter-spacing: 0.12em; color: var(--rm-dim); }
  .sg-cs .sg-ritual .sg-ritual-new { margin: var(--sp-6) 0 0; font: 500 2.25rem/1.1 var(--rm-display); letter-spacing: -0.015em; color: var(--rm-ink); }
  .sg-ritual-new span { color: var(--rm-dim); }
  .sg-cap { margin: var(--sp-6) 0 0; max-width: var(--rm-measure); font: 600 0.75rem/1.5 var(--rm-mono); letter-spacing: 0.04em; color: var(--rm-ink); }

  /* ── the pillars: a frame beside one line ── */
  .sg-pillars { display: flex; flex-direction: column; }
  .sg-pillar { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--sp-6) var(--sp-12); align-items: start; padding: var(--sp-8) 0 var(--sp-12); border-top: 1px solid color-mix(in oklab, var(--rm-ink) 12%, transparent); }
  .sg-pillars:not(.sg-arts) .sg-pillar:first-child { border-top: 0; padding-top: 0; }
  @media (min-width: 900px) {
    .sg-pillar { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); padding-top: var(--sp-12); }
    .sg-pillars:not(.sg-arts) .sg-pillar:first-child { padding-top: 0; }
  }
  .sg-fig { display: flex; flex-direction: column; align-items: center; gap: 14px; margin: 0; min-width: 0; }
  .sg-frame { box-sizing: border-box; width: 100%; aspect-ratio: 16 / 9; overflow: hidden; display: grid; place-items: center; }
  .sg-frame-art { aspect-ratio: 3 / 2; }
  .sg-video, .sg-img { grid-area: 1 / 1; display: block; width: 100%; height: 100%; object-fit: cover; }
  .sg-img { object-fit: contain; }
  /* THE PENDING FRAME: a hairline at 18 %, square, no fill, the caption centred. Nothing that pretends to be a frame. */
  .sg-fig[data-pending] .sg-frame { border: 1px solid color-mix(in oklab, var(--rm-dim) 18%, transparent); transition: border-color 560ms ease; }
  .sg-cs .sg-fig .sg-pending { grid-area: 1 / 1; max-width: 34ch; margin: 0; padding: 0 24px; text-align: center; font: 500 0.6875rem/1.5 var(--rm-mono); letter-spacing: 0.12em; text-transform: lowercase; color: var(--rm-dim); text-wrap: balance; }
  .sg-placard { max-width: 44ch; margin: 0; font: 500 0.6875rem/1.5 var(--rm-mono); letter-spacing: 0.06em; text-align: center; color: var(--rm-dim); text-wrap: balance; }
  /* the pitch: a mono kicker, then the line in the display face */
  .sg-pitch { min-width: 0; }
  .sg-cs .sg-pitch .sg-k { margin: 0 0 var(--sp-3); font: 500 0.6875rem/1.5 var(--rm-mono); letter-spacing: 0.12em; text-transform: lowercase; color: var(--rm-dim); }
  .sg-cs .sg-pitch .sg-line { margin: 0; max-width: 22ch; font: 500 1.5rem/1.3 var(--rm-display); letter-spacing: -0.01em; color: var(--rm-ink); text-wrap: pretty; }
  @media (max-width: 720px) { .sg-cs .sg-pitch .sg-line { font-size: 1.3125rem; max-width: none; } }

</style>
