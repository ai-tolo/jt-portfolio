---
import Layout from "../../layouts/Layout.astro";
import ResumeRenderer from "../../components/ResumeRenderer.astro";
import ResumeShell from "../../components/resume/ResumeShell.astro";
import PrintResume from "../../components/resume/PrintResume.astro";
import Footer from "../../components/Footer.astro";
import { getResumes, getResumeBySlug } from "../../lib/resumes";

export const prerender = true;

export async function getStaticPaths() {
  const all = await getResumes();
  return all.map((r) => ({ params: { slug: r.slug } }));
}

const { slug } = Astro.params;
const resume = await getResumeBySlug(slug!);
if (!resume) throw new Error(`Resume not found: ${slug}`);
---

<Layout
  title={`${resume.header.name} — Resume`}
  description={`${resume.header.name} resume tailored for ${resume.tailoredFor ?? "general"}.`}
>
  <main class="resume-page">
    <ResumeShell>
      <ResumeRenderer resume={resume} />
    </ResumeShell>
    {/* print-only curated one-pager; the interactive sheet above is screen-only */}
    <PrintResume resume={resume} />
  </main>

  <Footer />
</Layout>

<style>
  .resume-page {
    padding: var(--space-8) 0 var(--space-16);
  }
</style>
