---
import Layout from "../../layouts/Layout.astro";
import ResumeRenderer from "../../components/ResumeRenderer.astro";
import Footer from "../../components/Footer.astro";
import { getResumes, getResumeBySlug } from "../../lib/resumes";

export async function getStaticPaths() {
  const all = await getResumes();
  return all.map((r) => ({ params: { slug: r.slug } }));
}

const { slug } = Astro.params;
const resume = await getResumeBySlug(slug!);
if (!resume) throw new Error(`Resume not found: ${slug}`);
---

<Layout
  title={`${resume.header.name} — Resume`}
  description={`${resume.header.name} resume tailored for ${resume.tailoredFor ?? "general"}.`}
>
  <main class="resume-page">
    <div class="actions print-hide">
      <button class="print-btn" type="button" id="print-btn">Print or save as PDF</button>
    </div>

    <ResumeRenderer resume={resume} />
  </main>

  <Footer />
</Layout>

<style>
  .resume-page {
    padding: var(--space-8) 0 0;
  }
  .actions {
    max-width: 56rem;
    margin: 0 auto;
    padding: 0 var(--content-pad);
    display: flex;
    justify-content: flex-end;
    align-items: center;
    margin-bottom: var(--space-8);
  }
  .print-btn {
    font-family: inherit;
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--text);
    background: transparent;
    border: 1px solid var(--line);
    padding: var(--space-2) var(--space-4);
    cursor: pointer;
    transition: border-color 200ms ease;
  }
  .print-btn:hover {
    border-color: var(--accent);
  }
</style>

<script>
  document.getElementById("print-btn")?.addEventListener("click", () => {
    window.print();
  });
</script>
