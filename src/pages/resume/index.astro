---
import Layout from "../../layouts/Layout.astro";
import ResumeRenderer from "../../components/ResumeRenderer.astro";
import ResumeShell from "../../components/resume/ResumeShell.astro";
import PrintResume from "../../components/resume/PrintResume.astro";
import AwayRail from "../../components/studio/AwayRail.astro";
import { getDefaultResume } from "../../lib/resumes";

export const prerender = true;

const resume = await getDefaultResume();
if (!resume) throw new Error("No default resume marked Active in the Resumes database.");
---

<Layout
  title={`${resume.header.name} — Resume`}
  description={`${resume.header.name} resume. ${resume.header.title}.`}
  hideThemeSelector={true}
  chromeless={true}
>
  {/* Two views, one page (Jon, 2026-08-20): the PRINTABLE sheet is the
      default, shown as paper on the studio's light ground; the interactive
      experience lives behind the second tab (its dark canvas comes with it).
      Print styles untouched either way — PrintResume owns the PDF. */}
  <div class="resume-world" data-resume-view="paper">
    <AwayRail variant="light" resume={false} />
    <main class="resume-page">
      <div class="view-tabs" data-view-tabs>
        <div class="vt-center">
          <button type="button" data-view-btn="paper" aria-pressed="true">paper</button>
          <button type="button" data-view-btn="interactive" aria-pressed="false" class="vt-live">
            interactive
            <span class="vt-lamp" aria-hidden="true"></span>
          </button>
        </div>
        <button type="button" class="vt-pdf" data-view-print>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
            stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 4v10" /><path d="m7.5 10.5 4.5 4.5 4.5-4.5" /><path d="M5 19h14" />
          </svg>
          print · save as pdf
        </button>
      </div>
      <div class="paper-stage">
        <PrintResume />
      </div>
      <ResumeShell>
        <ResumeRenderer resume={resume} />
      </ResumeShell>
    </main>
  </div>
</Layout>

<script>
  const world = document.querySelector<HTMLElement>("[data-resume-view]");
  const btns = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-view-btn]"));
  const setView = (v: string) => {
    world?.setAttribute("data-resume-view", v);
    btns.forEach((b) => b.setAttribute("aria-pressed", String(b.getAttribute("data-view-btn") === v)));
    history.replaceState(null, "", v === "interactive" ? "#interactive" : window.location.pathname);
    // The shell's page-flags measure their targets and re-place on resize;
    // they were display:none at load (paper is the default), so every rect
    // read zero. Re-fire the measurer once the shell is actually visible.
    if (v === "interactive") requestAnimationFrame(() => window.dispatchEvent(new Event("resize")));
  };
  btns.forEach((b) => b.addEventListener("click", () => setView(b.getAttribute("data-view-btn") || "paper")));
  document.querySelector("[data-view-print]")?.addEventListener("click", () => window.print());
  if (window.location.hash === "#interactive") setView("interactive");
</script>

<style is:global>
  .resume-page {
    padding: var(--space-8) 0 var(--space-16);
    min-height: 100svh;
  }
  @media (min-width: 900px) {
    .resume-page {
      padding-left: 92px;
    }
  }

  @media screen {
    /* the two views swap; each brings its own canvas */
    .resume-world[data-resume-view="paper"] {
      background: #e9e8e5;
    }
    .resume-world[data-resume-view="paper"] .rs-root {
      display: none;
    }
    .resume-world[data-resume-view="interactive"] .paper-stage {
      display: none;
    }
    /* the interactive view keeps the case-study dark canvas — the light
       rail flips with it so the chrome never fights the room */
    .resume-world[data-resume-view="interactive"] .awayrail.light {
      background: #101216;
      border-right-color: rgba(160, 190, 230, 0.12);
    }
    .resume-world[data-resume-view="interactive"] .awayrail.light .ar-chip {
      border-color: rgba(232, 236, 244, 0.28);
      background: rgba(232, 236, 244, 0.06);
      color: #e8ecf4;
    }
    .resume-world[data-resume-view="interactive"] .awayrail.light .ar-word {
      color: #8f98a8;
    }

    /* ── the tabs: paper/interactive dead-center; the pdf action keeps to
       the right edge ────────────────────────────────────────────────── */
    .view-tabs {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      padding: 6px 20px 26px;
      font-family: "IBM Plex Mono", ui-monospace, monospace;
    }
    .vt-center {
      grid-column: 2;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .view-tabs button {
      appearance: none;
      cursor: pointer;
      font: inherit;
      font-size: 0.76rem;
      letter-spacing: 0.07em;
      padding: 9px 16px;
      border-radius: 10px;
      border: 1px solid rgba(20, 18, 16, 0.28);
      background: transparent;
      color: #45423c;
      transition: background 160ms ease, color 160ms ease, border-color 160ms ease;
    }
    .view-tabs button:hover {
      background: rgba(20, 18, 16, 0.07);
    }
    .view-tabs button[aria-pressed="true"] {
      background: #141210;
      border-color: #141210;
      color: #f5f2ea;
    }
    .view-tabs button:focus-visible {
      outline: 2px solid #141210;
      outline-offset: 2px;
    }
    /* ── the interactive key: an instrument keycap with its lamp on. Dark
       face on either canvas; press it and it sinks, the lamp goes ember —
       the machine's own language (dark-until-power, one lamp). */
    .vt-live {
      position: relative;
      isolation: isolate;
      border-color: #2a2f3a;
      background: linear-gradient(180deg, #1d212b 0%, #12151c 55%, #0e1117 100%);
      color: #e8ecf4;
      padding-right: 26px;
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.07),
        0 2px 0 #05070c,
        0 4px 10px rgba(5, 7, 12, 0.3);
      transition: transform 120ms ease, box-shadow 120ms ease, color 160ms ease;
    }
    .vt-live:hover {
      background: linear-gradient(180deg, #222736 0%, #141822 55%, #0e1117 100%);
      transform: translateY(1px);
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.07),
        0 1px 0 #05070c,
        0 3px 8px rgba(5, 7, 12, 0.3);
    }
    .vt-live[aria-pressed="true"] {
      background: linear-gradient(180deg, #0e1117 0%, #12151c 100%);
      border-color: #2a2f3a;
      color: #0ec4fc;
      transform: translateY(2px);
      box-shadow: inset 0 2px 6px rgba(0, 0, 0, 0.55);
    }
    .vt-lamp {
      position: absolute;
      top: 50%;
      right: 10px;
      transform: translateY(-50%);
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: #0ec4fc;
      box-shadow: 0 0 7px rgba(14, 196, 252, 0.9);
    }
    .vt-live[aria-pressed="true"] .vt-lamp {
      background: #ff5432;
      box-shadow: 0 0 8px rgba(255, 84, 50, 0.9);
    }
    .vt-live::before {
      content: "";
      position: absolute;
      inset: -3px;
      border-radius: 13px;
      border: 1.5px solid rgba(14, 196, 252, 0.45);
      box-shadow: 0 0 10px rgba(14, 196, 252, 0.3);
      pointer-events: none;
      z-index: -1;
    }
    @media (prefers-reduced-motion: no-preference) {
      .vt-live::before {
        animation: vt-ring 5.4s ease-in-out infinite;
      }
      .vt-lamp {
        animation: vt-lamp 2.6s ease-in-out infinite;
      }
      @keyframes vt-lamp {
        0%, 100% { opacity: 0.55; }
        50% { opacity: 1; }
      }
      @keyframes vt-ring {
        0%, 100% {
          border-color: rgba(14, 196, 252, 0.45);
          box-shadow: 0 0 10px rgba(14, 196, 252, 0.3);
        }
        38% {
          border-color: rgba(155, 108, 255, 0.5);
          box-shadow: 0 0 14px rgba(155, 108, 255, 0.4);
        }
        70% {
          border-color: rgba(255, 180, 77, 0.45);
          box-shadow: 0 0 12px rgba(255, 180, 77, 0.35);
        }
      }
    }
    .vt-pdf {
      grid-column: 3;
      justify-self: end;
      display: inline-flex;
      align-items: center;
      gap: 7px;
      border-color: transparent !important;
      text-decoration: underline;
      text-underline-offset: 4px;
    }
    .vt-pdf svg {
      width: 14px;
      height: 14px;
    }
    .vt-pdf:hover {
      background: transparent !important;
      color: #141210;
    }
    /* dark-canvas clothes for the same tabs (the keycap dresses itself) */
    .resume-world[data-resume-view="interactive"] .view-tabs button:not(.vt-live) {
      border-color: rgba(232, 236, 244, 0.28);
      color: #8f98a8;
    }
    .resume-world[data-resume-view="interactive"] .view-tabs button:not(.vt-live):hover {
      background: rgba(232, 236, 244, 0.08);
    }
    .resume-world[data-resume-view="interactive"] .view-tabs button:not(.vt-live)[aria-pressed="true"] {
      background: #e8ecf4;
      border-color: #e8ecf4;
      color: #101216;
    }
    .resume-world[data-resume-view="interactive"] .vt-pdf {
      border-color: transparent !important;
      color: #8f98a8;
    }
    .resume-world[data-resume-view="interactive"] .vt-pdf:hover {
      color: #e8ecf4;
    }

    /* ── the paper, as paper: white letter sheet on the studio ground ── */
    .paper-stage {
      display: grid;
      justify-items: center;
      padding: 0 20px 90px;
    }
    .paper-stage .print-resume {
      width: min(8.5in, 100%);
      background: #ffffff;
      padding: clamp(26px, 5vw, 58px) clamp(22px, 5vw, 62px);
      border: 1px solid rgba(90, 74, 50, 0.25);
      border-radius: 4px;
      box-shadow: 0 26px 60px -30px rgba(20, 12, 4, 0.45);
    }
  }

  @media print {
    .view-tabs {
      display: none !important;
    }
    .resume-world {
      background: #ffffff !important;
    }
    .paper-stage {
      display: block !important;
      padding: 0 !important;
    }
  }
  /* small phones: the tab row stacks (top-level media — nesting inside
     the screen block was unreliable through the CSS pipeline) */
  @media screen and (max-width: 460px) {
    .view-tabs {
      grid-template-columns: 1fr;
      row-gap: 10px;
      justify-items: center;
    }
    .vt-center {
      grid-column: 1;
    }
    .vt-pdf {
      grid-column: 1;
      justify-self: center;
      white-space: nowrap;
    }
  }
</style>
