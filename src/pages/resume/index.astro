---
// /resume — the ANNOTATED SHEET (Jon, 2026-08-25). One document: the
// ATS one-pager is the only résumé on the page, and the interactive
// proofs hang off it as Post-it flags. Tap a flag and its proof module
// unfolds in a dock under the sheet. This retires the paper/interactive
// toggle and the Notion-driven screen résumé — resume-print.ts is the
// single source of truth for résumé prose.
//
// The PDF button serves a real asset: public/jonathan-tollefson-resume.pdf.
// REGENERATE IT after any content change (headless Chrome printToPDF of
// this page; keep it ONE page — verify with pypdf).
import Layout from "../../layouts/Layout.astro";
import PrintResume from "../../components/resume/PrintResume.astro";
import AwayRail from "../../components/studio/AwayRail.astro";
import ProofAgentLoop from "../../components/resume/ProofAgentLoop.astro";
import ProofJudge from "../../components/resume/ProofJudge.astro";
import ProofDbtPipeline from "../../components/resume/ProofDbtPipeline.astro";
import ProofSignalKeys from "../../components/resume/ProofSignalKeys.astro";
import { CASE_LINKS } from "../../lib/case-links";

// The sheet's chrome is IBM Plex Mono (bundled locally, house rule: no CDN
// fonts). 120+ elements on this page declared the face without the page ever
// loading it — the screen résumé was falling back to Menlo. Same weights the
// homepage imports; PrintResume.astro declares no mono, so the print/ATS
// sheet is untouched.
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";

export const prerender = true;

// The marks: drawn marginalia in the editor's red — one ink, like a
// careful reader annotated the document. Each opens its proof IN PLACE
// beneath the bullet it backs (set finalized per the panel verdict).
const MARKS = [
  { key: "agent", word: "watch it", side: "right",
    target: '[data-pr-org="Finishable: the Engineer"] li[data-bi="0"]' },
  { key: "judge", word: "the catch", side: "left",
    target: '[data-pr-org="Finishable: the Engineer"] li[data-bi="1"]' },
  { key: "signal", word: "play it", side: "right",
    target: '[data-pr-org="SIGNAL"] li[data-bi="0"]' },
  { key: "parser", word: "trace it", side: "left",
    target: '[data-pr-org="CHS Inc."] li[data-bi="2"]' },
];
---

<Layout
  title="Résumé — Jonathan Tollefson"
  description="Jonathan Tollefson résumé. Design Engineer — interface design, front-end, applied AI."
>
  <div class="resume-world" data-resume-view="paper">
    <AwayRail resume={false} />
    <main class="resume-page">
      <div class="r-actions">
        <a class="r-pdf" href="/jonathan-tollefson-resume.pdf" download="jonathan-tollefson-resume.pdf">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
            stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 4v10" /><path d="m7.5 10.5 4.5 4.5 4.5-4.5" /><path d="M5 19h14" />
          </svg>
          download pdf
        </a>
        <a class="r-li" href="https://linkedin.com/in/jtollefson123" aria-label="LinkedIn" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
            stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="3" />
            <path d="M8 11v5" /><path d="M8 8v.01" />
            <path d="M12 16v-5" /><path d="M16 16v-3a2 2 0 0 0-4 0" />
          </svg>
        </a>
      </div>

      <div class="paper-stage">
        <div class="sheet-wrap" data-sheet>
          <PrintResume />
          {MARKS.map((m) => (
            <button
              type="button"
              class={`r-mark r-mark-${m.side}`}
              data-mark={m.key}
              data-mark-target={m.target}
              aria-expanded="false"
              aria-controls={`proof-${m.key}`}
            >
              <svg class="r-mark-oval" viewBox="0 0 100 42" preserveAspectRatio="none" fill="none"
                stroke="currentColor" stroke-width="3.2" stroke-linecap="round" aria-hidden="true">
                <path pathLength="1" d="M50 5.5C26 4 7 11 6.2 21c-.8 10.5 17.5 16.5 43 15.5 25.6-1 45-7.5 44.6-16.5C93.4 11 76 4.6 56 5.2" />
              </svg>
              {/* the leader: a hairline from the oval to the baseline of the
                  line it annotates; its path is laid by place() every frame */}
              <svg class="r-mark-lead" aria-hidden="true">
                <path pathLength="1" d="" />
              </svg>
              <span class="r-mark-word">{m.word}</span>
            </button>
          ))}

          {/* the dock: panels float into the parted paper at their bullet */}
          <div class="proof-dock" data-dock>
          <section id="proof-agent" class="proof-panel" data-proof-panel="agent" hidden aria-label="The mastering run, live">
            <ProofAgentLoop />
          </section>
          <section id="proof-judge" class="proof-panel" data-proof-panel="judge" hidden aria-label="The blind judge, live">
            <ProofJudge />
          </section>
          <section id="proof-parser" class="proof-panel" data-proof-panel="parser" hidden aria-label="The dbt parser, live">
            <ProofDbtPipeline />
          </section>
          <section id="proof-signal" class="proof-panel" data-proof-panel="signal" hidden aria-label="Five playable keys">
            <ProofSignalKeys />
          </section>
          </div>
        </div>

        {/* the shelf under the sheet (2026-08-31 IA: homepage = Builds
            only; the job case studies live with the résumé now). Model 1 —
            typographic links, no button clothes; model 2's inline overlay
            experiences are a later pass. Screen-only: the print guard
            below keeps the ATS/PDF contract sealed. Ledes = canon carried
            from the shipped homepage shelf (src/lib/case-links.ts). */}
        <nav class="r-studies" aria-label="Case studies">
          <p class="r-studies-t">case studies</p>
          <ul>
            {CASE_LINKS.map((c) => (
              <li>
                <a href={`/case-studies/${c.slug}`}>{c.name}</a>
                <p set:html={c.lede} />
              </li>
            ))}
          </ul>
        </nav>

        <footer class="lfloor">
          <span class="lfloor-lines">
            <a href="mailto:jtollefson123@gmail.com">jtollefson123@gmail.com</a>
            <span>minneapolis, mn</span>
          </span>
          <span class="lfloor-right">
            <a class="lfloor-li" href="https://linkedin.com/in/jtollefson123" aria-label="LinkedIn" target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3" /><path d="M8 11v5" /><path d="M8 8v.01" /><path d="M12 16v-5" /><path d="M16 16v-3a2 2 0 0 0-4 0" /></svg></a>
          </span>
        </footer>
      </div>
    </main>
  </div>
</Layout>

<script>
  // Marginalia mechanics: each mark sits in the sheet margin at its bullet;
  // opening one reserves a gap under the bullet's entry (the paper parts)
  // and floats the proof panel into it, with focus mode dimming the rest.
  // The sheet's DOM is never touched — the print/ATS contract stays sealed.
  const wrap = document.querySelector<HTMLElement>("[data-sheet]");
  const marks = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-mark]"));
  const panels = Array.from(document.querySelectorAll<HTMLElement>("[data-proof-panel]"));

  const entryOf = (sel: string) => document.querySelector(sel)?.closest<HTMLElement>(".pr-entry") ?? null;

  // Geometry of a mark (form pass, Jon: yes, 2026-09-09): the oval sits in
  // the margin a hand's breadth above the FIRST line of its bullet, and a
  // hairline leader leaves its lower inner quadrant for the baseline of that
  // line, ending in the gutter before the bullet glyph (left marks) or just
  // past the line's last glyph (right marks). Horizontally each mark keeps
  // GAP px of paper between the oval and the text column; when the viewport
  // (right) or the fixed rail (left) has no room for that, the mark slides
  // in and the leader shortens rather than the page growing a scrollbar.
  const GAP = 26;
  const LIFT = 14;
  const rail = document.querySelector<HTMLElement>(".awayrail");
  const sheet = document.querySelector<HTMLElement>(".print-resume");
  const rangeOf = document.createRange();
  const firstLineOf = (t: Element) => {
    rangeOf.selectNodeContents(t);
    const rects = rangeOf.getClientRects();
    return rects.length ? rects[0] : t.getBoundingClientRect();
  };
  const leadPath = (x0: number, y0: number, x1: number, y1: number, bow: number) => {
    // a lazy S: two control points nudged off the chord in opposite
    // directions, so the hairline reads as a hand stroke, not a ruler
    const dx = x1 - x0, dy = y1 - y0;
    const len = Math.hypot(dx, dy) || 1;
    const nx = -dy / len, ny = dx / len;
    const c1x = x0 + dx * 0.34 + nx * len * 0.09 * bow;
    const c1y = y0 + dy * 0.34 + ny * len * 0.09 * bow;
    const c2x = x0 + dx * 0.7 - nx * len * 0.05 * bow;
    const c2y = y0 + dy * 0.7 - ny * len * 0.05 * bow;
    const f = (n: number) => n.toFixed(1);
    return `M${f(x0)} ${f(y0)}C${f(c1x)} ${f(c1y)} ${f(c2x)} ${f(c2y)} ${f(x1)} ${f(y1)}`;
  };

  const place = () => {
    if (!wrap) return;
    const base = wrap.getBoundingClientRect();
    const docW = document.documentElement.clientWidth;
    const railRight = rail && getComputedStyle(rail).position === "fixed" && window.innerWidth >= 900
      ? rail.getBoundingClientRect().right : 0;
    const scs = sheet ? getComputedStyle(sheet) : null;
    const padL = scs ? parseFloat(scs.paddingLeft) || 0 : 0;
    const padR = scs ? parseFloat(scs.paddingRight) || 0 : 0;
    for (const m of marks) {
      const t = document.querySelector(m.dataset.markTarget || "");
      if (!t) {
        m.removeAttribute("data-placed");
        continue;
      }
      const r = t.getBoundingClientRect();
      const line = firstLineOf(t);
      const lineMid = line.top + line.height / 2;
      const baseline = line.bottom - 0.275 * (parseFloat(getComputedStyle(t).fontSize) || 13);
      const mw = m.offsetWidth, mh = m.offsetHeight;
      const left = m.classList.contains("r-mark-left");
      m.style.top = `${Math.round(lineMid - LIFT - base.top)}px`;
      m.setAttribute("data-placed", "");
      const lead = m.querySelector<SVGPathElement>(".r-mark-lead path");
      if (!mw || !mh || !lead) continue;

      // horizontal seat: GAP of paper before the column, clamped to the room
      let ext: number;
      if (left) {
        const want = mw + GAP - padL;
        const room = base.left - railRight - 2;
        ext = Math.min(want, room);
        m.style.left = `${Math.round(-ext)}px`;
        m.style.right = "";
      } else {
        const want = mw + GAP - padR;
        const room = docW - base.right - 2;
        ext = Math.min(want, room);
        m.style.right = `${Math.round(-ext)}px`;
        m.style.left = "";
      }

      // the leader, in the button's own (pre-transform) coordinates
      const bx = m.offsetLeft;
      const by = m.offsetTop - mh / 2;
      const rot = (parseFloat(getComputedStyle(m).getPropertyValue("--r-rot")) || 0) * Math.PI / 180;
      const cx = mw / 2, cy = mh / 2;
      const toLocal = (wx: number, wy: number) => {
        const vx = wx - bx - cx, vy = wy - by - cy;
        const c = Math.cos(-rot), s = Math.sin(-rot);
        return [cx + vx * c - vy * s, cy + vx * s + vy * c];
      };
      // start: the oval's lower inner quadrant (ellipse fitted to the path)
      const rx = 0.442 * mw, ry = 0.39 * mh, ocy = 0.495 * mh;
      const sx = left ? cx + rx * 0.766 : cx - rx * 0.766;
      const sy = ocy + ry * 0.643;
      // end: on the baseline, in the gutter (left) or past the last glyph (right)
      let ex: number;
      if (left) ex = r.left - 5 - base.left;
      else ex = Math.min(r.right + 2, Math.max(line.right + 9, r.right - 56)) - base.left;
      const [lx, ly] = toLocal(ex, baseline - 1 - base.top);
      lead.setAttribute("d", leadPath(sx, sy, lx, ly, left ? 1 : -1));
    }
  };

  let openKey: string | null = null;
  const closeAll = () => {
    openKey = null;
    wrap?.removeAttribute("data-focus");
    document.querySelectorAll("[data-lit]").forEach((e) => e.removeAttribute("data-lit"));
    document.querySelectorAll("[data-lit-line]").forEach((e) => e.removeAttribute("data-lit-line"));
    for (const p of panels) {
      p.hidden = true;
      p.style.top = "";
    }
    for (const m of marks) m.setAttribute("aria-expanded", "false");
    document.querySelectorAll<HTMLElement>(".pr-entry").forEach((e) => (e.style.paddingBottom = ""));
    place();
  };

  const open = (key: string) => {
    closeAll();
    openKey = key;
    const mark = marks.find((m) => m.dataset.mark === key);
    const panel = panels.find((p) => p.dataset.proofPanel === key);
    const entry = mark ? entryOf(mark.dataset.markTarget || "") : null;
    if (!mark || !panel || !entry || !wrap) return;
    // measure the panel offscreen, then reserve the gap and float it in.
    // Positions are padding-aware (entry rects include the reserved gap)
    // and re-derived once the 340ms padding transition settles, so opening
    // one proof while another is closing can never land the panel low.
    panel.hidden = false;
    panel.style.visibility = "hidden";
    const h = panel.getBoundingClientRect().height;
    const contentBottom = () => {
      const base = wrap.getBoundingClientRect();
      const eb = entry.getBoundingClientRect();
      const pad = parseFloat(getComputedStyle(entry).paddingBottom) || 0;
      return Math.round(eb.bottom - pad - base.top);
    };
    panel.style.top = `${contentBottom() + 14}px`;
    entry.style.paddingBottom = `${Math.round(h + 26)}px`;
    panel.style.visibility = "";
    document.querySelector(mark.dataset.markTarget || "")?.setAttribute("data-lit-line", "");
    entry.setAttribute("data-lit", "");
    wrap.setAttribute("data-focus", "");
    mark.setAttribute("aria-expanded", "true");
    place();
    window.setTimeout(() => panel.scrollIntoView({ behavior: "smooth", block: "nearest" }), 60);
  };

  marks.forEach((m) => {
    m.addEventListener("mouseenter", () =>
      document.querySelector(m.dataset.markTarget || "")?.setAttribute("data-hover-line", ""));
    m.addEventListener("mouseleave", () =>
      document.querySelector(m.dataset.markTarget || "")?.removeAttribute("data-hover-line"));
    m.addEventListener("click", (e) => {
      e.stopPropagation();
      openKey === m.dataset.mark ? closeAll() : open(m.dataset.mark as string);
    });
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && openKey) closeAll();
  });
  document.addEventListener("click", (e) => {
    if (!openKey) return;
    const t = e.target as HTMLElement;
    if (!t.closest("[data-proof-panel]") && !t.closest("[data-mark]")) closeAll();
  });

  place();
  window.addEventListener("resize", () => {
    window.setTimeout(() => {
      if (openKey) { const k = openKey; closeAll(); open(k); }
      else place();
    }, 120);
  });
  window.addEventListener("load", place);
  if (document.fonts?.ready) document.fonts.ready.then(place);

  // UNBREAKABLE placement: the sheet is OBSERVED, not guessed at. The gap
  // transitions animate entry heights frame by frame; the ResizeObserver
  // fires through the whole animation, so the marks and the open panel
  // ride the paper instead of chasing it with timers.
  const seatOpenPanel = () => {
    if (!openKey || !wrap) return;
    const mark = marks.find((x) => x.dataset.mark === openKey);
    const panel = panels.find((x) => x.dataset.proofPanel === openKey);
    const entry = mark ? entryOf(mark.dataset.markTarget || "") : null;
    if (!mark || !panel || !entry) return;
    const base = wrap.getBoundingClientRect();
    const eb = entry.getBoundingClientRect();
    const pad = parseFloat(getComputedStyle(entry).paddingBottom) || 0;
    panel.style.top = `${Math.round(eb.bottom - pad - base.top) + 14}px`;
  };
  if ("ResizeObserver" in window) {
    const ro = new ResizeObserver(() => {
      place();
      seatOpenPanel();
    });
    const sheetEl = document.querySelector(".print-resume");
    if (sheetEl) ro.observe(sheetEl);
    document.querySelectorAll(".pr-entry").forEach((e) => ro.observe(e));
    // the marks themselves re-measure when their face loads (the leader
    // hangs off the oval's edge, so a wider word moves its start point)
    marks.forEach((m) => ro.observe(m));
  }

  // The pen: once, when the sheet enters the viewport, each oval is drawn
  // (stroke-dashoffset 1 → 0 on a pathLength=1 path) and its leader is
  // stroked after it, marks staggered 120ms apart. Under reduced motion
  // nothing is armed: the ovals are simply present from the first paint.
  const still = window.matchMedia?.("(prefers-reduced-motion: reduce)").matches;
  if (!still && wrap && "IntersectionObserver" in window) {
    marks.forEach((m, i) => {
      m.style.setProperty("--r-delay", `${i * 120}ms`);
      m.setAttribute("data-draw", "");
    });
    const io = new IntersectionObserver((entries) => {
      if (!entries.some((e) => e.isIntersecting)) return;
      io.disconnect();
      marks.forEach((m) => m.setAttribute("data-draw", "on"));
    }, { threshold: 0 });
    io.observe(wrap);
  }
</script>

<style is:global>
  .resume-page {
    padding: 30px 0 90px;
    min-height: 100svh;
  }
  @media (min-width: 900px) {
    .resume-page {
      padding-left: var(--railw, 110px);
    }
  }

  @media screen {
    /* ground rides the sitewide day/night tokens (tokens.css is light-
       first since 2026-08-28, so the old anti-black-band !important pin
       is gone — html/body already match, and flip at night) */
    .resume-world {
      background: var(--bg);
      transition: background 560ms ease;
      /* the marks are seated to the viewport edge at the narrowest widths;
         their hover lift (scale) must never become a horizontal scrollbar */
      overflow-x: clip;
    }

    /* ── actions row: one honest control + one quiet hint ── */
    .r-actions {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 14px;
      max-width: 8.5in;
      margin: 0 auto;
      /* align with the sheet's inner type column, not its outer edge */
      padding: 0 clamp(22px, 5vw, 62px) 18px;
      font-family: "IBM Plex Mono", ui-monospace, monospace;
    }
    .r-pdf {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      font-size: 0.76rem;
      letter-spacing: 0.07em;
      color: var(--text);
      text-decoration: underline;
      text-underline-offset: 4px;
    }
    .r-pdf svg {
      width: 14px;
      height: 14px;
    }
    .r-pdf:hover {
      color: var(--accent);
    }
    .r-li {
      display: inline-flex;
      padding: 8px;
      margin: -8px;
      color: var(--text);
    }
    .r-li svg {
      width: 21px;
      height: 21px;
    }
    .r-li:hover,
    .r-li:focus-visible {
      color: var(--accent);
    }


    .lfloor {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 20px;
      /* width, not just max-width: as a centered grid item it otherwise
         shrink-wraps on phones and drifts off the sheet's left rhythm */
      width: 100%;
      max-width: 8.5in;
      margin: 48px auto 0;
      padding: 22px 20px 8px;
      border-top: 1px solid rgba(90, 74, 50, 0.2);
      font-family: "IBM Plex Mono", ui-monospace, monospace;
      font-size: 0.74rem;
      letter-spacing: 0.04em;
      color: var(--muted);
    }
    html[data-night] .lfloor {
      border-top-color: #1c222e;
    }
    .lfloor-lines {
      display: flex;
      flex-direction: column;
      gap: 5px;
    }
    .lfloor a {
      color: var(--text);
      text-decoration: underline;
      text-underline-offset: 4px;
      transition: color 160ms ease;
    }
    .lfloor a:hover,
    .lfloor a:focus-visible {
      color: var(--accent);
    }
    .lfloor-li {
      display: inline-flex;
      padding: 8px;
      margin: -8px;
    }
    .lfloor-li svg {
      width: 21px;
      height: 21px;
    }
    .lfloor-right {
      display: inline-flex;
      align-items: center;
      gap: 14px;
    }

    /* ── the case studies, under the sheet: typographic links, no button
       clothes — the name IS the control, the lede sits beneath it ── */
    .r-studies {
      width: 100%;
      max-width: 8.5in;
      margin: 56px auto 0;
      padding: 0 20px;
    }
    .r-studies-t {
      margin: 0 0 22px;
      font-family: "IBM Plex Mono", ui-monospace, monospace;
      font-size: 0.72rem;
      letter-spacing: 0.09em;
      color: var(--muted);
    }
    .r-studies ul {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 28px;
    }
    .r-studies a {
      font-family: "IBM Plex Sans", ui-sans-serif, system-ui, sans-serif;
      font-size: 1.14rem;
      font-weight: 600;
      letter-spacing: -0.01em;
      color: var(--text);
      text-decoration: underline;
      text-underline-offset: 5px;
      text-decoration-thickness: 1px;
      text-decoration-color: color-mix(in srgb, currentColor 30%, transparent);
      transition: color 160ms ease, text-decoration-color 160ms ease;
    }
    .r-studies a:hover,
    .r-studies a:focus-visible {
      color: var(--accent);
      text-decoration-color: currentColor;
    }
    .r-studies li p {
      margin: 7px 0 0;
      font-size: 0.9rem;
      line-height: 1.6;
      color: var(--muted);
      max-width: 62ch;
    }
    .r-studies li p strong {
      font-weight: 600;
      color: var(--text);
    }

    /* ── the sheet, as paper ── */
    .paper-stage {
      display: grid;
      justify-items: center;
      padding: 0 20px 60px;
    }
    .sheet-wrap {
      position: relative;
      width: min(8.5in, 100%);
    }
    .paper-stage .print-resume {
      width: 100%;
      background: #ffffff;
      padding: clamp(26px, 5vw, 58px) clamp(22px, 5vw, 62px);
      border: 1px solid rgba(90, 74, 50, 0.25);
      border-radius: 4px;
      box-shadow: 0 26px 60px -30px rgba(20, 12, 4, 0.45);
      transition: background 560ms ease, border-color 560ms ease;
    }
    /* night: the paper goes dark with the room (Jon's sheet rule, made
       sitewide 2026-08-28) — same clothes as the homepage sheets; the
       sheet's INKS flip inside PrintResume.astro, screen-only */
    html[data-night] .paper-stage .print-resume {
      background: #0b0e14;
      border-color: #1c222e;
    }
    .paper-stage .print-resume .pr-li-icon {
      color: #56565e;
    }
    html[data-night] .paper-stage .print-resume .pr-li-icon {
      color: #8a94a5;
    }
    .paper-stage .print-resume .pr-li-icon:hover {
      color: var(--accent);
    }

    /* ── the marks: a reader's red pen circling a word in the margin,
       half on the paper, half on the desk ── */
    .r-mark {
      display: none;
    }
    /* 1000px, not 900px: the marks hang off the sheet at `left/right: -30px`,
       which pushed the document past the viewport from 900 to 999px
