---
// /resume — the ANNOTATED SHEET (Jon, 2026-08-25). One document: the
// ATS one-pager is the only résumé on the page, and the interactive
// proofs hang off it as Post-it flags. Tap a flag and its proof module
// unfolds in a dock under the sheet. This retires the paper/interactive
// toggle and the Notion-driven screen résumé — resume-print.ts is the
// single source of truth for résumé prose.
//
// The PDF button serves a real asset: public/jonathan-tollefson-resume.pdf.
// REGENERATE IT after any content change (headless Chrome printToPDF of
// this page; keep it ONE page — verify with pypdf).
import Layout from "../../layouts/Layout.astro";
import PrintResume from "../../components/resume/PrintResume.astro";
import AwayRail from "../../components/studio/AwayRail.astro";
import ProofAgentLoop from "../../components/resume/ProofAgentLoop.astro";
import ProofJudge from "../../components/resume/ProofJudge.astro";
import ProofDbtPipeline from "../../components/resume/ProofDbtPipeline.astro";
import ProofGrowth from "../../components/resume/ProofGrowth.astro";

export const prerender = true;

// The flags: four proofs, anchored to the exact bullets they back.
// Desktop-only (the flags are a pointer experience); phones get the
// clean sheet and the same PDF.
const FLAGS = [
  { key: "agent", label: "watch a run", side: "right", accent: "#0ec4fc",
    target: '[data-pr-org="Finishable — the Engineer"] li[data-bi="0"]' },
  { key: "judge", label: "the judge", side: "right", accent: "#00d44a",
    target: '[data-pr-org="Finishable — the Engineer"] li[data-bi="2"]' },
  { key: "parser", label: "run the parser", side: "left", accent: "#ffb347",
    target: '[data-pr-org="CHS Inc."] li[data-bi="2"]' },
  { key: "growth", label: "the numbers", side: "left", accent: "#ff2761",
    target: '[data-pr-org="Crediverso"] li[data-bi="1"]' },
];
---

<Layout
  title="Jonathan Tollefson — Resume"
  description="Jonathan Tollefson résumé. Design Engineer — interface design, front-end, applied AI."
  hideThemeSelector={true}
  chromeless={true}
>
  <div class="resume-world" data-resume-view="paper">
    <AwayRail variant="light" resume={false} />
    <main class="resume-page">
      <div class="r-actions">
        <a class="r-pdf" href="/jonathan-tollefson-resume.pdf" download="jonathan-tollefson-resume.pdf">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
            stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 4v10" /><path d="m7.5 10.5 4.5 4.5 4.5-4.5" /><path d="M5 19h14" />
          </svg>
          download pdf
        </a>
        <p class="r-hint">the flags open the proof behind a line</p>
      </div>

      <div class="paper-stage">
        <div class="sheet-wrap" data-sheet>
          <PrintResume />
          {FLAGS.map((f) => (
            <button
              type="button"
              class={`r-flag r-flag-${f.side}`}
              style={`--fa:${f.accent}`}
              data-flag={f.key}
              data-flag-target={f.target}
              aria-expanded="false"
              aria-controls={`proof-${f.key}`}
            >
              {f.label}
            </button>
          ))}
        </div>

        {/* the dock: one proof unfolds at a time, under the sheet — lift a
            flag and the studio shows through the paper */}
        <div class="proof-dock" data-dock>
          <section id="proof-agent" class="proof-panel" data-proof-panel="agent" hidden aria-label="The mastering run, live">
            <ProofAgentLoop />
          </section>
          <section id="proof-judge" class="proof-panel" data-proof-panel="judge" hidden aria-label="The blind judge, live">
            <ProofJudge />
          </section>
          <section id="proof-parser" class="proof-panel" data-proof-panel="parser" hidden aria-label="The dbt parser, live">
            <ProofDbtPipeline />
          </section>
          <section id="proof-growth" class="proof-panel" data-proof-panel="growth" hidden aria-label="The Crediverso numbers">
            <ProofGrowth />
          </section>
        </div>
      </div>
    </main>
  </div>
</Layout>

<script>
  // Flag placement: each flag sits at its target bullet's vertical position,
  // hanging off the sheet edge. Measured against the sheet wrap; re-placed
  // on resize and after fonts settle. Screen-only, >=900px (CSS gates).
  const wrap = document.querySelector<HTMLElement>("[data-sheet]");
  const flags = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-flag]"));
  const panels = Array.from(document.querySelectorAll<HTMLElement>("[data-proof-panel]"));

  const place = () => {
    if (!wrap) return;
    const base = wrap.getBoundingClientRect();
    for (const f of flags) {
      const t = document.querySelector(f.dataset.flagTarget || "");
      if (!t) continue;
      const r = t.getBoundingClientRect();
      f.style.top = `${Math.round(r.top - base.top + r.height / 2)}px`;
    }
    wrap.setAttribute("data-flags-placed", "");
  };

  let openKey: string | null = null;
  const setOpen = (key: string | null) => {
    openKey = key;
    for (const p of panels) p.hidden = p.dataset.proofPanel !== key;
    for (const f of flags) f.setAttribute("aria-expanded", String(f.dataset.flag === key));
    if (key) {
      const p = panels.find((x) => x.dataset.proofPanel === key);
      p?.scrollIntoView({ behavior: "smooth", block: "nearest" });
    }
  };
  flags.forEach((f) =>
    f.addEventListener("click", () => setOpen(openKey === f.dataset.flag ? null : (f.dataset.flag as string)))
  );
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && openKey) setOpen(null);
  });

  place();
  window.addEventListener("resize", () => window.setTimeout(place, 120));
  window.addEventListener("load", place);
  if (document.fonts?.ready) document.fonts.ready.then(place);
</script>

<style is:global>
  .resume-page {
    padding: 30px 0 90px;
    min-height: 100svh;
  }
  @media (min-width: 900px) {
    .resume-page {
      padding-left: 92px;
    }
  }

  @media screen {
    .resume-world {
      background: #e9e8e5;
    }

    /* ── actions row: one honest control + one quiet hint ── */
    .r-actions {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 14px;
      max-width: 8.5in;
      margin: 0 auto;
      padding: 0 20px 18px;
      font-family: "IBM Plex Mono", ui-monospace, monospace;
    }
    .r-pdf {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      font-size: 0.76rem;
      letter-spacing: 0.07em;
      color: #141210;
      text-decoration: underline;
      text-underline-offset: 4px;
    }
    .r-pdf svg {
      width: 14px;
      height: 14px;
    }
    .r-pdf:hover {
      color: #b33a2a;
    }
    .r-hint {
      margin: 0;
      font-size: 0.68rem;
      letter-spacing: 0.05em;
      color: #6a6660;
    }
    @media (max-width: 899px) {
      .r-hint {
        display: none; /* flags are desktop-only */
      }
      .r-actions {
        justify-content: center;
      }
    }

    /* ── the sheet, as paper ── */
    .paper-stage {
      display: grid;
      justify-items: center;
      padding: 0 20px 60px;
    }
    .sheet-wrap {
      position: relative;
      width: min(8.5in, 100%);
    }
    .paper-stage .print-resume {
      width: 100%;
      background: #ffffff;
      padding: clamp(26px, 5vw, 58px) clamp(22px, 5vw, 62px);
      border: 1px solid rgba(90, 74, 50, 0.25);
      border-radius: 4px;
      box-shadow: 0 26px 60px -30px rgba(20, 12, 4, 0.45);
    }
    .paper-stage .print-resume .pr-li-icon {
      color: #56565e;
    }
    .paper-stage .print-resume .pr-li-icon:hover {
      color: #b33a2a;
    }

    /* ── the flags: Post-its hanging off the sheet edges ── */
    .r-flag {
      display: none;
    }
    @media (min-width: 900px) {
      .r-flag {
        display: block;
        position: absolute;
        z-index: 2;
        padding: 7px 14px 7px 12px;
        border: 0;
        cursor: pointer;
        font-family: "IBM Plex Mono", ui-monospace, monospace;
        font-size: 0.72rem;
        letter-spacing: 0.04em;
        line-height: 1;
        color: #141210;
        background: color-mix(in srgb, var(--fa) 42%, #fff);
        border-radius: 3px 8px 8px 3px;
        box-shadow: 0 3px 10px -4px rgba(20, 12, 4, 0.5);
        transform: translate(78%, -50%) rotate(1.4deg);
        transition: transform 140ms ease, box-shadow 140ms ease;
        white-space: nowrap;
        opacity: 0;
      }
      [data-flags-placed] .r-flag {
        opacity: 1;
      }
      .r-flag-left {
        left: -14px;
        transform: translate(-78%, -50%) rotate(-1.6deg);
        border-radius: 8px 3px 3px 8px;
      }
      .r-flag-right {
        right: -14px;
      }
      .r-flag:hover,
      .r-flag:focus-visible {
        box-shadow: 0 5px 14px -4px rgba(20, 12, 4, 0.55);
      }
      .r-flag-left:hover,
      .r-flag-left:focus-visible {
        transform: translate(-84%, -50%) rotate(-1.6deg);
      }
      .r-flag-right:hover,
      .r-flag-right:focus-visible {
        transform: translate(84%, -50%) rotate(1.4deg);
      }
      .r-flag[aria-expanded="true"] {
        outline: 2px solid var(--fa);
        outline-offset: 1px;
      }
      .r-flag:focus-visible {
        outline: 2px solid #141210;
        outline-offset: 2px;
      }
    }

    /* ── the dock: dark card under the sheet — the studio under the paper ── */
    .proof-dock {
      width: min(8.5in, 100%);
      margin: 0 auto;
    }
    .proof-panel {
      margin-top: 18px;
      padding: clamp(16px, 3vw, 28px);
      background: #101216;
      border: 1px solid rgba(160, 190, 230, 0.16);
      border-radius: 8px;
      box-shadow: 0 26px 60px -30px rgba(20, 12, 4, 0.5);
    }
  }

  @media print {
    .r-actions,
    .r-flag,
    .proof-dock,
    .r-hint {
      display: none !important;
    }
    .resume-page,
    .resume-world {
      min-height: 0 !important;
      padding: 0 !important;
      margin: 0 !important;
    }
    .resume-world {
      background: #ffffff !important;
    }
    .paper-stage {
      display: block !important;
      padding: 0 !important;
    }
    .sheet-wrap {
      width: 100% !important;
    }
  }
</style>
