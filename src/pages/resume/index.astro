---
// /resume — the ANNOTATED SHEET (Jon, 2026-08-25). One document: the
// ATS one-pager is the only résumé on the page, and the interactive
// proofs hang off it as index tabs cut from the sheet's edge (Jon,
// 2026-09-18). Press a tab and its proof module unfolds in place. This retires the paper/interactive
// toggle and the Notion-driven screen résumé — resume-print.ts is the
// single source of truth for résumé prose.
//
// The PDF button serves a real asset: public/jonathan-tollefson-resume.pdf.
// REGENERATE IT after any content change (headless Chrome printToPDF of
// this page; keep it ONE page — verify with pypdf).
import Layout from "../../layouts/Layout.astro";
import PrintResume from "../../components/resume/PrintResume.astro";
import AwayRail from "../../components/studio/AwayRail.astro";
import ProofAgentLoop from "../../components/resume/ProofAgentLoop.astro";
import ProofJudge from "../../components/resume/ProofJudge.astro";
import ProofDbtPipeline from "../../components/resume/ProofDbtPipeline.astro";
import ProofSignalKeys from "../../components/resume/ProofSignalKeys.astro";
import { CASE_LINKS } from "../../lib/case-links";
import SiteFloor from "../../components/studio/SiteFloor.astro";

// The page's own words are in the work room's material (2026-10-06):
// JetBrains Mono labels, Instrument Sans body, Outfit names (Layout.astro
// loads them). IBM Plex Mono stays loaded for the SITEWIDE chrome only: the
// rail (AwayRail) and the floor (SiteFloor) declare it on every page, as on
// the case studies; without it they fell back to the system mono here.
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";

export const prerender = true;

// The marks: four index tabs standing off the sheet's outer edge, each
// on the first line of the bullet it backs; press one and its proof opens
// IN PLACE beneath that bullet. Wordless to the eye — `word` is the tab's
// accessible name only (the pen ovals + words were retired 2026-09-18).
// Targets key on the sheet's org strings + bullet positions (resume-print.ts):
// the run (bullet 0) and the evidence clause (bullet 2, since 2026-10-06) of
// the mastering agent, the instrument's one bullet, and the dbt tool (CHS
// bullet 1). A reworded sheet must re-check these or the tabs silently detach.
// Each tab's panel follows it in the DOM (the panels are absolutely placed,
// so the order is free): Tab from an open tab lands inside its own proof.
const MARKS = [
  { key: "agent", word: "watch it", side: "right", Proof: ProofAgentLoop,
    label: "One run of the mastering agent",
    target: '[data-pr-org="AI mastering agent"] li[data-bi="0"]' },
  { key: "judge", word: "the catch", side: "left", Proof: ProofJudge,
    label: "The blind test's ledger",
    target: '[data-pr-org="AI mastering agent"] li[data-bi="2"]' },
  { key: "signal", word: "play it", side: "right", Proof: ProofSignalKeys,
    label: "Five playable notes",
    target: '[data-pr-org="Browser instrument"] li[data-bi="0"]' },
  { key: "parser", word: "trace it", side: "left", Proof: ProofDbtPipeline,
    label: "The dbt lineage parser on a sample project",
    target: '[data-pr-org="CHS Inc."] li[data-bi="1"]' },
];

// The case studies live in a row UNDER the sheet, not inside it (Jon,
// 2026-09-21; this returns the 2026-08-31 shelf and un-links the org names).
// The flagship joins the three job studies; its lede is the case study's own
// "what I built" line, the others are the canon ledes in case-links.ts.
const STUDIES = [
  {
    slug: "the-console",
    name: "Finishable",
    // DRAFT (2026-10-06, the writing law): what the study holds, plainly
    lede: "A catalog of my audio files, a studio that turns found sounds into playable instruments, and the blind listening test behind the mastering agent.",
  },
  ...CASE_LINKS,
];
---

<Layout
  title="Résumé · Jonathan Tollefson"
  description="Résumé of Jonathan Tollefson, design engineer: front-end, audio tools, and applied AI."
>
  <div class="resume-world" data-resume-view="paper">
    <AwayRail resume={false} home="house" />
    <main class="resume-page">
      <div class="r-actions">
        <a class="r-pdf" href="/jonathan-tollefson-resume.pdf" download="jonathan-tollefson-resume.pdf">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
            stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 4v10" /><path d="m7.5 10.5 4.5 4.5 4.5-4.5" /><path d="M5 19h14" />
          </svg>
          download pdf
        </a>
        <a class="r-li" href="https://linkedin.com/in/jtollefson123" aria-label="LinkedIn" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
            stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="3" />
            <path d="M8 11v5" /><path d="M8 8v.01" />
            <path d="M12 16v-5" /><path d="M16 16v-3a2 2 0 0 0-4 0" />
          </svg>
        </a>
      </div>

      <div class="paper-stage">
        <div class="sheet-wrap" data-sheet data-riffle>
          {/* THE STACK (2026-09-22): the résumé is the top page; the four
              case studies are the sheets beneath it — their edges show under
              its bottom edge, their tabs above its top edge. Screen-only. */}
          <div class="r-stack" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
          <div class="r-stack-tabs">
            {STUDIES.map((c, k) => (
              <a class="r-stack-tab" href={`#study-${c.slug}`} style={`--k:${k}`}><span class="r-stack-word">{c.name}</span></a>
            ))}
          </div>
          <PrintResume />
          {/* the dock: each tab, then its panel, which floats into the parted
              paper at its bullet */}
          <div class="proof-dock" data-dock>
            {MARKS.map(({ Proof, ...m }) => (
              <>
                <button
                  type="button"
                  class={`r-mark r-mark-${m.side}`}
                  data-mark={m.key}
                  data-mark-target={m.target}
                  aria-expanded="false"
                  aria-controls={`proof-${m.key}`}
                >
                  {/* nothing to read on the tab; the word is its accessible name */}
                  <span class="r-mark-word">{m.word}</span>
                </button>
                <section id={`proof-${m.key}`} class="proof-panel" data-proof-panel={m.key} hidden aria-label={m.label}>
                  <Proof />
                </section>
              </>
            ))}
          </div>
        </div>

        {/* the case studies, under the sheet: typographic links, no button
            clothes. Screen-only: the print guard below keeps the ATS/PDF
            contract sealed. */}
        <nav class="r-studies" aria-label="Case studies">
          <p class="r-studies-t">case studies</p>
          <ul>
            {STUDIES.map((c) => (
              <li id={`study-${c.slug}`}>
                <a href={`/case-studies/${c.slug}`}>{c.name}</a>
                <p set:html={c.lede} />
              </li>
            ))}
          </ul>
        </nav>

        {/* the floor: the sitewide object (SiteFloor.astro, email + LinkedIn) */}
        <SiteFloor />
      </div>
    </main>
  </div>
</Layout>

<script>
  // THE STACK: as the page arrives the study tabs rise from behind the sheet
  // and the edges beneath slide out, once per load, after the type has
  // landed; any hand completes it at once. Reduced motion: simply drawn. A
  // tab scrolls to its study and holds that row's underline.
  {
    const wrap = document.querySelector<HTMLElement>(".sheet-wrap[data-riffle]");
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (wrap) {
      const settle = () => { wrap.setAttribute("data-riffle-skip", ""); wrap.removeAttribute("data-riffle"); };
      if (reduce) settle();
      else {
        const now = () => { settle(); off(); };
        const off = () => ["pointerdown", "keydown", "wheel", "touchstart"].forEach((t) => window.removeEventListener(t, now, true));
        ["pointerdown", "keydown", "wheel", "touchstart"].forEach((t) => window.addEventListener(t, now, { capture: true, passive: true }));
        (document.fonts?.ready ?? Promise.resolve()).then(() => window.setTimeout(() => { wrap.removeAttribute("data-riffle"); window.setTimeout(off, 900); }, 250));
      }
    }
    document.querySelectorAll<HTMLAnchorElement>(".r-stack-tab").forEach((a) => {
      a.addEventListener("click", (e) => {
        const li = document.getElementById((a.getAttribute("href") ?? "").slice(1));
        if (!li) return;
        e.preventDefault();
        li.scrollIntoView({ behavior: reduce ? "instant" : "smooth", block: "start" });
        li.setAttribute("data-hit", "");
        window.setTimeout(() => li.removeAttribute("data-hit"), 1600);
      });
    });
  }

  // Tab mechanics: each tab sits at the sheet's edge on its bullet's first
  // line; opening one reserves a gap under the bullet's entry (the paper
  // parts) and floats the proof panel into it, with focus mode dimming the
  // rest. The sheet's DOM is never touched — the print/ATS contract stays
  // sealed.
  const wrap = document.querySelector<HTMLElement>("[data-sheet]");
  const marks = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-mark]"));
  const panels = Array.from(document.querySelectorAll<HTMLElement>("[data-proof-panel]"));

  const entryOf = (sel: string) => document.querySelector(sel)?.closest<HTMLElement>(".pr-entry") ?? null;

  // A tab's vertical centre sits on the FIRST line of the bullet it backs
  // — the position is the pointer, so there is no leader. The seat off the
  // sheet's edge is a CSS constant (right: 100% / left: 100%): nothing here
  // writes left or right, so nothing can push the page wider than the
  // viewport (this repo's most-recurring regression).
  const rangeOf = document.createRange();
  const firstLineOf = (t: Element) => {
    rangeOf.selectNodeContents(t);
    const rects = rangeOf.getClientRects();
    return rects.length ? rects[0] : t.getBoundingClientRect();
  };
  const place = () => {
    if (!wrap) return;
    const base = wrap.getBoundingClientRect();
    for (const m of marks) {
      const t = document.querySelector(m.dataset.markTarget || "");
      if (!t) {
        m.removeAttribute("data-placed");
        continue;
      }
      const line = firstLineOf(t);
      m.style.top = `${Math.round(line.top + line.height / 2 - base.top)}px`;
      m.setAttribute("data-placed", "");
    }
  };

  let openKey: string | null = null;
  const closeAll = () => {
    openKey = null;
    wrap?.removeAttribute("data-focus");
    document.querySelectorAll("[data-lit]").forEach((e) => e.removeAttribute("data-lit"));
    document.querySelectorAll("[data-lit-line]").forEach((e) => e.removeAttribute("data-lit-line"));
    for (const p of panels) {
      p.hidden = true;
      p.style.top = "";
    }
    for (const m of marks) m.setAttribute("aria-expanded", "false");
    document.querySelectorAll<HTMLElement>(".pr-entry").forEach((e) => (e.style.paddingBottom = ""));
    place();
  };

  const open = (key: string) => {
    closeAll();
    openKey = key;
    const mark = marks.find((m) => m.dataset.mark === key);
    const panel = panels.find((p) => p.dataset.proofPanel === key);
    const entry = mark ? entryOf(mark.dataset.markTarget || "") : null;
    if (!mark || !panel || !entry || !wrap) return;
    // measure the panel offscreen, then reserve the gap and float it in.
    // Positions are padding-aware (entry rects include the reserved gap)
    // and re-derived once the 340ms padding transition settles, so opening
    // one proof while another is closing can never land the panel low.
    panel.hidden = false;
    panel.style.visibility = "hidden";
    const h = panel.getBoundingClientRect().height;
    const contentBottom = () => {
      const base = wrap.getBoundingClientRect();
      const eb = entry.getBoundingClientRect();
      const pad = parseFloat(getComputedStyle(entry).paddingBottom) || 0;
      return Math.round(eb.bottom - pad - base.top);
    };
    panel.style.top = `${contentBottom() + 14}px`;
    entry.style.paddingBottom = `${Math.round(h + 26)}px`;
    panel.style.visibility = "";
    document.querySelector(mark.dataset.markTarget || "")?.setAttribute("data-lit-line", "");
    entry.setAttribute("data-lit", "");
    wrap.setAttribute("data-focus", "");
    mark.setAttribute("aria-expanded", "true");
    place();
    window.setTimeout(() => panel.scrollIntoView({ behavior: "smooth", block: "nearest" }), 60);
  };

  marks.forEach((m) => {
    m.addEventListener("mouseenter", () =>
      document.querySelector(m.dataset.markTarget || "")?.setAttribute("data-hover-line", ""));
    m.addEventListener("mouseleave", () =>
      document.querySelector(m.dataset.markTarget || "")?.removeAttribute("data-hover-line"));
    m.addEventListener("click", (e) => {
      e.stopPropagation();
      openKey === m.dataset.mark ? closeAll() : open(m.dataset.mark as string);
    });
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && openKey) closeAll();
  });
  document.addEventListener("click", (e) => {
    if (!openKey) return;
    const t = e.target as HTMLElement;
    if (!t.closest("[data-proof-panel]") && !t.closest("[data-mark]")) closeAll();
  });

  place();
  window.addEventListener("resize", () => {
    window.setTimeout(() => {
      if (openKey) { const k = openKey; closeAll(); open(k); }
      else place();
    }, 120);
  });
  window.addEventListener("load", place);
  if (document.fonts?.ready) document.fonts.ready.then(place);

  // UNBREAKABLE placement: the sheet is OBSERVED, not guessed at. The gap
  // transitions animate entry heights frame by frame; the ResizeObserver
  // fires through the whole animation, so the marks and the open panel
  // ride the paper instead of chasing it with timers.
  const seatOpenPanel = () => {
    if (!openKey || !wrap) return;
    const mark = marks.find((x) => x.dataset.mark === openKey);
    const panel = panels.find((x) => x.dataset.proofPanel === openKey);
    const entry = mark ? entryOf(mark.dataset.markTarget || "") : null;
    if (!mark || !panel || !entry) return;
    const base = wrap.getBoundingClientRect();
    const eb = entry.getBoundingClientRect();
    const pad = parseFloat(getComputedStyle(entry).paddingBottom) || 0;
    panel.style.top = `${Math.round(eb.bottom - pad - base.top) + 14}px`;
  };
  if ("ResizeObserver" in window) {
    const ro = new ResizeObserver(() => {
      place();
      seatOpenPanel();
    });
    const sheetEl = document.querySelector(".print-resume");
    if (sheetEl) ro.observe(sheetEl);
    document.querySelectorAll(".pr-entry").forEach((e) => ro.observe(e));
  }
</script>

<style is:global>
  .resume-page {
    padding: 30px 0 90px;
    min-height: 100svh;
  }
  @media (min-width: 900px) {
    .resume-page {
      padding-left: var(--railw, 110px);
    }
  }

  @media screen {
    /* ground rides the sitewide day/night tokens (tokens.css is light-
       first since 2026-08-28, so the old anti-black-band !important pin
       is gone — html/body already match, and flip at night) */
    .resume-world {
      /* the work room's material for the chrome (2026-10-06): its three faces,
         hairlines at 18 % ink; the sheet's width and inner gutter are shared by
         the actions row, the case studies and the floor so all four align */
      --sheet-w: 880px;
      --sheet-pad: clamp(20px, 5vw, 56px);
      --r-mono: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
      --r-sans: "Instrument Sans", "Helvetica Neue", Arial, sans-serif;
      --r-display: "Outfit", "Instrument Sans", "Helvetica Neue", Arial, sans-serif;
      --r-line: color-mix(in oklab, var(--text) 18%, transparent);
      background: var(--bg);
      transition: background 560ms ease;
      /* the marks are seated to the viewport edge at the narrowest widths;
         their hover lift (scale) must never become a horizontal scrollbar */
      overflow-x: clip;
    }

    /* ── actions row: one honest control + one quiet hint ── */
    .r-actions {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      max-width: var(--sheet-w);
      margin: 0 auto;
      /* align with the sheet's inner type column, not its outer edge */
      padding: 0 var(--sheet-pad) 24px;
      font-family: var(--r-mono);
    }
    /* the room's link grammar: a hairline underline that goes to full ink */
    .r-pdf {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 0.75rem;
      font-weight: 500;
      letter-spacing: 0.04em;
      color: var(--text);
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-decoration-color: color-mix(in oklab, currentColor 32%, transparent);
      text-underline-offset: 4px;
      transition: text-decoration-color 140ms ease;
    }
    .r-pdf svg {
      width: 14px;
      height: 14px;
    }
    .r-pdf:hover,
    .r-pdf:focus-visible {
      text-decoration-color: currentColor;
    }
    .r-li {
      display: inline-flex;
      padding: 8px;
      margin: -8px;
      color: var(--text);
    }
    .r-li svg {
      width: 21px;
      height: 21px;
    }
    .r-li:hover,
    .r-li:focus-visible {
      color: var(--accent);
    }


    /* ── the case studies, under the sheet: typographic links, no button
       clothes — the name IS the control, the lede sits beneath it ── */
    .r-studies {
      width: 100%;
      max-width: var(--sheet-w);
      margin: 64px auto 0;
      padding: 0 var(--sheet-pad);
    }
    .r-studies-t {
      margin: 0 0 24px;
      font: 500 0.6875rem/1.5 var(--r-mono);
      letter-spacing: 0.12em;
      text-transform: lowercase;
      color: var(--muted);
    }
    .r-studies ul {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 32px;
    }
    .r-studies a {
      font: 500 1.375rem/1.25 var(--r-display);
      letter-spacing: -0.01em;
      color: var(--text);
      text-decoration: underline;
      text-underline-offset: 5px;
      text-decoration-thickness: 1px;
      text-decoration-color: color-mix(in oklab, currentColor 32%, transparent);
      transition: text-decoration-color 160ms ease;
    }
    .r-studies a:hover,
    .r-studies a:focus-visible {
      text-decoration-color: currentColor;
    }
    .r-studies li p {
      margin: 8px 0 0;
      font: 400 1rem/1.6 var(--r-sans);
      color: var(--muted);
      max-width: 36rem;
    }
    .r-studies li p strong {
      font-weight: 600;
      color: var(--text);
    }

    /* the floor — the sitewide object (SiteFloor.astro); this page owns
       its placement: the sheet's width (a centred grid item would
       shrink-wrap), a hairline above, under the case-study row */
    .floor {
      width: 100%;
      max-width: var(--sheet-w);
      margin: 48px auto 0;
      padding: 24px var(--sheet-pad) 8px;
      border-top: 1px solid var(--r-line);
    }

    /* ── THE STACK (2026-09-22, Jon: "knowing that case studies are beneath
       the résumé"): the sheet is the top page of a stack. Four sheets lie
       under it — their edges show below the résumé's bottom edge, where the
       page used to simply end — and each wears a paper tab above the
       résumé's top edge, one per case study, left to right in the list's
       order: the index-tab language one level up. A tab is a same-page link
       to its study; hover deepens it (depth is the hand), a press scrolls to
       the row and holds its underline. On a first visit the tabs rise and
       the edges slide out once. Screen-only: print hides both. ── */
    .sheet-wrap {
      isolation: isolate; /* the stack paints under the sheet, over the ground */
    }
    .r-stack i {
      position: absolute;
      /* each sheet a touch narrower than the one above it, so every edge
         reads as its own page rather than one thick slab */
      inset: 0 calc(var(--n) * 4px);
      z-index: -1;
      background: #ffffff;
      border: 1px solid color-mix(in oklab, #141210 16%, transparent);
      border-radius: 0;
      transform: translateY(calc(var(--n) * 5px));
      transition: transform 320ms cubic-bezier(0.2, 0.7, 0.3, 1) calc(var(--n) * 60ms), background 560ms ease, border-color 560ms ease;
    }
    /* the higher the sheet, the higher it paints: each edge shows below the
       one above it */
    .r-stack i:nth-child(1) { --n: 1; z-index: -1; }
    .r-stack i:nth-child(2) { --n: 2; z-index: -2; }
    .r-stack i:nth-child(3) { --n: 3; z-index: -3; }
    .r-stack i:nth-child(4) { --n: 4; z-index: -4; }
    /* flat paper on paper (the work room's recipe): no shadows anywhere */
    html[data-night] .r-stack i {
      background: #1c1c1f;
      border-color: color-mix(in oklab, #e8ecf4 16%, transparent);
    }
    .r-stack-tabs {
      position: absolute;
      top: 0;
      left: 50%;
      z-index: -1;
      display: flex;
      gap: 6px;
      transform: translateX(-50%);
    }
    .r-stack-tab {
      position: relative;
      display: block;
      width: 28px;
      height: 24px;
      margin-top: -12px; /* 12px stands above the résumé's top edge; the rest is tucked under it */
      background: #ffffff;
      border: 1px solid color-mix(in oklab, #141210 16%, transparent);
      border-radius: 0;
      transition: transform 160ms cubic-bezier(0.2, 0.7, 0.3, 1), background 560ms ease, border-color 560ms ease;
    }
    /* a 34 × 44 hand, reaching up into the clear ground above the paper */
    .r-stack-tab::after {
      content: "";
      position: absolute;
      inset: -20px -3px 0;
    }
    .r-stack-tab:hover,
    .r-stack-tab:focus-visible {
      transform: translateY(-6px);
    }
    .r-stack-tab:focus-visible {
      outline: 2px solid var(--text);
      outline-offset: 2px;
    }
    html[data-night] .r-stack-tab {
      background: #1c1c1f;
      border-color: color-mix(in oklab, #e8ecf4 16%, transparent);
    }
    .r-stack-word {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    /* the first visit's riffle: tabs start tucked under the sheet and the
       edges flush with it; releasing data-riffle lets both come out, the tabs
       one after another */
    .sheet-wrap[data-riffle] .r-stack-tab {
      transform: translateY(13px);
    }
    .sheet-wrap[data-riffle] .r-stack i {
      transform: none;
    }
    .sheet-wrap:not([data-riffle-skip]) .r-stack-tab {
      transition: transform 240ms cubic-bezier(0.2, 0.7, 0.3, 1) calc(160ms + var(--k) * 110ms), background 560ms ease, border-color 560ms ease;
    }
    .sheet-wrap[data-riffle-skip] .r-stack-tab,
    .sheet-wrap[data-riffle-skip] .r-stack i {
      transition-delay: 0s;
    }
    @media (prefers-reduced-motion: reduce) {
      .sheet-wrap[data-riffle] .r-stack-tab {
        transform: none;
      }
      .sheet-wrap[data-riffle] .r-stack i {
        transform: translateY(calc(var(--n) * 5px));
      }
      .r-stack i,
      .r-stack-tab {
        transition: background 560ms ease, border-color 560ms ease;
      }
    }
    /* the row a tab sent you to holds its underline a moment */
    .r-studies li {
      scroll-margin-top: 24px;
    }
    .r-studies li[data-hit] a {
      text-decoration-color: currentColor;
    }
    /* phones: a flick past the paper's end settles on the case studies */
    @media (max-width: 899px) {
      html:has(.resume-world) {
        scroll-snap-type: y proximity;
      }
      .r-studies {
        scroll-snap-align: start;
        scroll-margin-top: 24px;
