---
// THE STUDIO — the homepage (spec: NOTES-STUDIO-SPEC.md, binding).
//
// One straight-down view of a sunlit desk; the five objects on it ARE the
// navigation. The page is thin on purpose: Layout owns title/meta/OG (no
// regression from the outgoing homepage), StudioDesk owns the desk shell +
// room chassis, the rooms/ components own each interior, Footer owns contact.
//
// DISPOSITION of the retired comet homepage (hard boundary: nothing silently
// vanishes — all of it stays in git history on main):
//   · <AboutSignal/> (the ~880vh comet choreography)  → RETIRED. Its three
//     descriptor lines are the Work room's plain bio (rooms/WorkRoom.astro).
//   · The HeroName masthead ("Jonathan Tollefson")    → the etched name on the
//     desk (StudioDesk keeps a real <h1>); the role/eyebrow copy → Work room.
//   · The #work Card Deck selector (rail, hover tones, broadcast sound toggle,
//     per-project accents, --boot veil)               → CUT. Its load-bearing
//     content — the five case-study links in RANK order — is the Work room.
//   · "Full resume →"                                 → Work room + the desk's
//     text index (résumé stays ≤ 1 click from arrival).
//   · <SignalMachine/> + the /more mobile swap        → moved WHOLESALE,
//     unchanged, to /signal (src/pages/signal.astro). The desk's SIGNAL object
//     dims the room, then navigates there (D2).
//   · <Footer/>                                       → kept; contact email added.
// 2026-08-12: the desk-composition homepage (StudioDesk + rooms) is RETIRED in
// place of the one-page skeleton (StudioOne) — Jon's direction: approachable,
// whole site visible from the hero, floating-pill nav. StudioDesk.astro and
// the room components stay in the tree (git history + manifest reuse).
import Layout from "../layouts/Layout.astro";
import StudioOne from "../components/studio/StudioOne.astro";

// The IBM Plex layer is the studio's locked type (bundled locally, house
// rule: no CDN fonts). Only the weights the desk + rooms actually set.
import "@fontsource/ibm-plex-sans/400.css";
import "@fontsource/ibm-plex-sans/500.css";
import "@fontsource/ibm-plex-sans/600.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";

export const prerender = true;

// 2026-08-31: the ranked case-study shelf DISSOLVED into BUILDS (three
// story pieces, copy in components/studio/builds-copy.ts). The homepage no
// longer reads Notion at all; chs/crediverso/raylu surface on /resume
// (src/lib/case-links.ts), momence keeps its URL off-shelf.
---

<Layout
  title="Jonathan Tollefson — Design Engineer · audio & real-time web"
  description="Builds browser instruments and audio tools — Web Audio, React/TypeScript, and a mastering engine that grades its own output blind. Minneapolis; remote-US."
>
  <main>
    <StudioOne />
  </main>
</Layout>

<style>
  main {
    /* The desk is the whole first view; it sets its own height under the
       sticky header. No page padding of its own. */
    padding: 0;
  }
</style>
