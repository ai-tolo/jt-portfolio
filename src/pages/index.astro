---
import Layout from "../layouts/Layout.astro";
import WorkEntry from "../components/WorkEntry.astro";
import Footer from "../components/Footer.astro";
import { getCaseStudies } from "../lib/notion";

export const prerender = true;

const works = await getCaseStudies();
---

<Layout title="Jonathan Tollefson — User Experience Architect">
  <main>
    <section class="hero">
      <div class="inner hero-layout">
        <span class="eyebrow hero-meta">2026 · Minneapolis</span>

        <div class="hero-main">
          <h1 class="name" aria-label="Jon Tollefson">
            <span class="chunk" aria-hidden="true">Jon</span>
            <span class="chunk" aria-hidden="true">Tol</span>
            <span class="chunk" aria-hidden="true">lef</span>
            <span class="chunk" aria-hidden="true">son</span>
          </h1>

          <div class="tagline-wrap">
            <p class="tagline">
              <span>Senior product designer.</span>
              <span>Data-heavy enterprise applications.</span>
              <span class="muted">Soundbender after hours.</span>
            </p>
          </div>
        </div>

        <div class="hero-foot">
          <a class="hero-scroll" href="#work">
            <span class="hero-scroll-label">Selected work</span>
            <span class="hero-scroll-glyph" aria-hidden="true">↓</span>
          </a>
        </div>
      </div>
    </section>

    <section class="section about" id="about" aria-labelledby="about-label">
      <div class="inner about-grid">
        <span id="about-label" class="eyebrow">About</span>
        <div class="prose">
          <p>
            Senior product designer working the seam between research, interaction, and front-end. Currently embedded with engineering at CHS on enterprise AI and BI products.
          </p>
          <p>
            Previously: an early-stage AI tooling startup, a bilingual fintech launch, and a string of earlier product engagements.
          </p>
          <p>
            Outside the day job I <a href="https://substack.com/@diaryofasoundbender" target="_blank" rel="noopener noreferrer">write about sound</a> on Substack. Sound design and product design have a lot in common the more I do them. Both build intentional worlds out of structured attention, and I think empathy is a primary component for getting there.
          </p>
          <p class="muted">
            Available for senior product and UX roles, contract or direct-hire. Minneapolis (hybrid or remote), or New York City for the right opportunity.
          </p>
        </div>
      </div>
    </section>

    <section class="section work" id="work" aria-labelledby="work-label">
      <div class="inner">
        <header class="work-head">
          <span id="work-label" class="eyebrow">Selected work</span>
          <span class="work-head-count">
            <span class="work-head-n">{String(works.length).padStart(2, "0")}</span>
            <span class="work-head-of">case studies</span>
          </span>
          <span class="work-head-hint">
            <kbd>↑</kbd><kbd>↓</kbd>
            <span>to step</span>
          </span>
        </header>

        <ol class="list" data-work-list>
          {works.map((w, i) => (
            <li class:list={["work-item", { "work-item-featured": i === 0 }]}>
              <WorkEntry
                index={w.order}
                name={w.name}
                subtitle={w.subtitle}
                outcome={w.outcome}
                role={w.role}
                timeline={w.timeline}
                tools={w.tools}
                tags={w.tags.slice(0, 4)}
                slug={w.slug}
                cover={w.cover}
                featured={i === 0}
              />
            </li>
          ))}
        </ol>

        <div class="work-foot">
          <a class="work-foot-link" href="/resume">
            <span>Full resume</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  {/* Work-list behavior: scroll-linked reveal, subtle parallax on the
      cover image, and arrow-key navigation between entries. All scoped
      to the home page. */}
  <script>
    type Entry = HTMLAnchorElement & { __weIn?: boolean };

    const list = document.querySelector<HTMLOListElement>("[data-work-list]");
    if (list) {
      const entries = Array.from(list.querySelectorAll<Entry>(".we"));

      /* ── Reveal-on-scroll ──────────────────────────────────────── */
      const io = new IntersectionObserver((records) => {
        for (const r of records) {
          if (r.isIntersecting) {
            (r.target as Entry).classList.add("we-in");
            io.unobserve(r.target);
          }
        }
      }, { threshold: 0.18 });
      entries.forEach((e) => io.observe(e));

      /* ── Subtle parallax ───────────────────────────────────────────
         Each cover frame translates a fraction of its distance from the
         viewport center. Capped at ±28px. Skipped on reduced motion. */
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const frames = list.querySelectorAll<HTMLElement>("[data-we-parallax]");

      const update = () => {
        const vh = window.innerHeight;
        frames.forEach((f) => {
          const r = f.getBoundingClientRect();
          const center = r.top + r.height / 2;
          const dist = (center - vh / 2) / vh;          // -0.5 .. 0.5 typical
          const y = Math.max(-28, Math.min(28, -dist * 36));
          f.style.setProperty("--we-parallax", `${y.toFixed(1)}px`);
          f.style.transform = `translate3d(0, ${y.toFixed(1)}px, 0)`;
        });
      };

      let ticking = false;
      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          update();
          ticking = false;
        });
      };

      if (!reduce) {
        update();
        window.addEventListener("scroll", onScroll, { passive: true });
        window.addEventListener("resize", onScroll);
      }

      /* ── Arrow-key step ─────────────────────────────────────────── */
      const findCurrent = (): number => {
        const vh = window.innerHeight;
        let nearest = 0;
        let nearestDist = Infinity;
        entries.forEach((e, i) => {
          const r = e.getBoundingClientRect();
          const center = r.top + r.height / 2;
          const d = Math.abs(center - vh / 2);
          if (d < nearestDist) { nearestDist = d; nearest = i; }
        });
        return nearest;
      };

      document.addEventListener("keydown", (e) => {
        if (e.metaKey || e.ctrlKey || e.altKey || e.shiftKey) return;
        const t = e.target as HTMLElement | null;
        const tag = t?.tagName?.toLowerCase();
        if (tag === "input" || tag === "textarea" || t?.isContentEditable) return;
        if (e.key !== "ArrowDown" && e.key !== "ArrowUp") return;

        // Only step when the work list is on screen.
        const headerR = list.getBoundingClientRect();
        const vh = window.innerHeight;
        if (headerR.bottom < 0 || headerR.top > vh) return;

        const i = findCurrent();
        const next = e.key === "ArrowDown" ? i + 1 : i - 1;
        if (next < 0 || next >= entries.length) return;
        e.preventDefault();
        entries[next].scrollIntoView({ behavior: "smooth", block: "center" });
      });
    }
  </script>
</Layout>

<style>
  main {
    padding-top: var(--space-8);
  }

  /* Hero — kept as the chunk-clipping vocabulary. Adds a small
     descender link to "Selected work" so the page invites a scroll. */
  .hero {
    padding: var(--space-8) 0 var(--space-4);
  }
  .hero-layout {
    min-height: calc(100svh - var(--space-32));
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }
  .hero-meta {
    align-self: flex-start;
  }
  .hero-main {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-8);
  }

  .name {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    margin: 0;
  }
  .chunk {
    display: block;
    width: fit-content;
    background: var(--ink);
    color: var(--ink-fg);
    font-size: clamp(3.5rem, 13vw, 8.25rem);
    font-weight: var(--fw-bold);
    letter-spacing: var(--ls-display);
    line-height: 0.82;
    text-transform: uppercase;
    transition: background-color 280ms cubic-bezier(0.2, 0, 0, 1),
                color 280ms cubic-bezier(0.2, 0, 0, 1);
    animation: clip-in 700ms cubic-bezier(0.2, 0, 0, 1) backwards;
  }
  .chunk:nth-child(1) {
    padding: 0.30em 0.42em 0.10em 0.30em;
    animation-delay: 60ms;
  }
  .chunk:nth-child(2) {
    padding: 0.08em 0.58em 0.20em 0.16em;
    margin-left: 0.10em;
    animation-delay: 140ms;
  }
  .chunk:nth-child(3) {
    padding: 0.10em 0.30em 0.06em 0.48em;
    animation-delay: 220ms;
  }
  .chunk:nth-child(4) {
    padding: 0.04em 0.52em 0.32em 0.22em;
    margin-left: 0.06em;
    animation-delay: 300ms;
  }

  .tagline-wrap {
    align-self: flex-start;
  }
  .tagline {
    display: flex;
    flex-direction: column;
    gap: 0;
    width: fit-content;
    max-width: 22ch;
    padding: 0.3em 0 0.3em 1.4rem;
    background: transparent;
    color: var(--text);
    border-left: 2px solid var(--accent);
    font-size: clamp(1.5rem, 2.6vw, 2.25rem);
    line-height: 1.25;
    font-weight: var(--fw-medium);
    letter-spacing: -0.005em;
    transition: color 280ms cubic-bezier(0.2, 0, 0, 1),
                border-color 280ms cubic-bezier(0.2, 0, 0, 1);
    animation: clip-in 700ms cubic-bezier(0.2, 0, 0, 1) 380ms backwards;
  }
  .tagline .muted {
    color: var(--muted);
  }

  .hero-foot {
    align-self: flex-start;
    margin-top: auto;
    animation: clip-in 700ms cubic-bezier(0.2, 0, 0, 1) 540ms backwards;
  }
  .hero-scroll {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: var(--fs-eyebrow);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
    padding: 8px 0;
    border-bottom: 1px solid var(--line);
    transition: color 200ms ease, border-color 200ms ease;
  }
  .hero-scroll:hover,
  .hero-scroll:focus-visible {
    color: var(--text);
    border-color: var(--accent);
  }
  .hero-scroll-glyph {
    display: inline-block;
    animation: scroll-bob 2.2s ease-in-out infinite;
  }
  @keyframes scroll-bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(3px); }
  }

  @keyframes clip-in {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .chunk,
    .tagline,
    .hero-foot {
      animation: none;
    }
    .hero-scroll-glyph { animation: none; }
  }

  @media (min-width: 56rem) {
    .hero-main {
      flex-direction: row;
      align-items: center;
      justify-content: flex-start;
      gap: var(--space-16);
    }
    .tagline-wrap {
      flex: 0 1 auto;
      align-self: center;
    }
  }

  /* Generic section */
  .section {
    padding: var(--space-16) 0;
    border-top: 1px solid var(--line);
  }

  /* About */
  .about-grid {
    display: grid;
    gap: var(--space-6);
  }
  .prose {
    display: grid;
    gap: var(--space-4);
    max-width: 64ch;
    font-size: 1.1875rem;
    font-weight: var(--fw-medium);
    line-height: 1.55;
  }
  .prose .muted {
    color: var(--muted);
  }
  .prose a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    transition: text-decoration-thickness 160ms ease;
  }
  .prose a:hover,
  .prose a:focus-visible {
    text-decoration-thickness: 2px;
  }

  @media (min-width: 56rem) {
    .about-grid {
      grid-template-columns: 12rem 1fr;
      gap: var(--space-16);
      align-items: start;
    }
  }

  /* Work head — eyebrow + count + keyboard hint */
  .work-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
    padding-bottom: var(--space-8);
    margin-bottom: var(--space-4);
  }
  .work-head-count {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
  }
  .work-head-n {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-weight: var(--fw-bold);
    font-size: clamp(1.25rem, 2.4vw, 1.75rem);
    color: var(--ink);
    background: var(--ink);
    color: var(--ink-fg);
    padding: 0.10em 0.36em;
    letter-spacing: 0.04em;
  }
  .work-head-of {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: var(--fs-eyebrow);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--muted);
  }
  .work-head-hint {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.75rem;
    color: var(--muted);
  }
  .work-head-hint kbd {
    font-family: inherit;
    font-size: 0.7rem;
    padding: 2px 6px;
    border: 1px solid var(--line);
    border-radius: 3px;
    color: var(--text);
    background: var(--surface-1);
    line-height: 1;
  }

  /* Work list — a cinematic gallery grid. First entry features full-width;
     the rest fall into a two-up grid. Collapses to one column on small
     screens. */
  .work .list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-8);
  }
  .work-item { min-width: 0; }
  .work-item-featured { grid-column: 1 / -1; }
  @media (max-width: 55.99rem) {
    .work .list { grid-template-columns: 1fr; gap: var(--space-6); }
  }

  .work-foot {
    padding: var(--space-12) 0 var(--space-4);
    border-top: 1px solid var(--line);
    margin-top: var(--space-8);
  }
  .work-foot-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: var(--fs-eyebrow);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--accent);
    text-decoration: none;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--accent);
    transition: color 200ms ease, background 200ms ease;
  }
  .work-foot-link:hover,
  .work-foot-link:focus-visible {
    color: var(--bg);
    background: var(--accent);
  }
</style>
