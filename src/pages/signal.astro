---
// SIGNAL · THE PORTFOLIO REBUILD (branch `signal`, 2026-09-23). Its own page; the homepage keeps the
// old instrument until Jon swaps them by hand. R0 = the contact sheet: three looks of ONE anatomy
// (NOTES-SIGNAL-R0.md §6) rendered at the device's true size, the host fits them to the viewport.
// Phones and coarse pointers get a still and one line (Law 2), nothing more.
import Layout from "../layouts/Layout.astro";
import AwayRail from "../components/studio/AwayRail.astro";
import LookA from "../components/signal/look/LookA.astro";
import LookB from "../components/signal/look/LookB.astro";
import LookC from "../components/signal/look/LookC.astro";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "@fontsource/ibm-plex-sans/400.css";
import "@fontsource/orbitron/500.css";

export const prerender = true;

const LOOKS = [
  { id: "a", word: "the studio's own" },
  { id: "b", word: "carbon · glass · keycaps" },
  { id: "c", word: "the panel" },
];
---

<Layout title="SIGNAL — Jonathan Tollefson" description="A browser instrument: drums, bass, keys. Play it with the keyboard.">
  <AwayRail home="house" />
  <main class="sig-page" data-look="a">
    <div class="sig-host" id="sig-host">
      <div class="sig-fit" id="sig-fit">
        <div class="sig-device" id="sig-device">
          <LookA />
          <LookB />
          <LookC />
        </div>
      </div>
    </div>
    <nav class="sig-looks" aria-label="Contact sheet">
      {LOOKS.map((l) => (
        <button type="button" class="sig-look" data-pick={l.id} aria-pressed={l.id === "a" ? "true" : "false"}>
          <b>{l.id}</b><span>{l.word}</span>
        </button>
      ))}
    </nav>
    <div class="sig-phone" aria-hidden="false">
      <div class="sig-still" role="img" aria-label="SIGNAL, a browser instrument"></div>
      <p class="sig-line">SIGNAL is played with a keyboard and a mouse. Open it on a desk.</p>
    </div>
  </main>
</Layout>

<style>
  .sig-page {
    min-height: 100svh;
    background: var(--bg);
    color: var(--ink);
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    padding: 40px 24px 60px;
    box-sizing: border-box;
    transition: background 560ms ease, color 560ms ease;
  }
  @media (min-width: 900px) { .sig-page { padding-left: calc(var(--railw, 110px) + 24px); } }

  /* THE HOST FIT: the device is 1120 px, always. The host scales it (never the device's own CSS) —
     zoom = min(1.34, content width / 1120), the homepage law. Height follows the scaled box. */
  .sig-host { width: 100%; max-width: 1560px; display: flex; justify-content: center; align-items: flex-start; }
  .sig-fit { width: 1120px; transform-origin: top center; transform: scale(var(--sig-zoom, 1)); }
  .sig-device { width: 1120px; position: relative; }
  /* one look at a time; the others stay in the DOM so the switch is instant and screenshots can pin any */
  .sig-device :global(.look) { display: none; }
  .sig-page[data-look="a"] .sig-device :global(.look-a),
  .sig-page[data-look="b"] .sig-device :global(.look-b),
  .sig-page[data-look="c"] .sig-device :global(.look-c) { display: block; }

  .sig-looks { display: flex; gap: 10px; }
  .sig-look {
    font: inherit; font-size: 0.75rem; letter-spacing: 0.04em;
    display: inline-flex; gap: 10px; align-items: baseline;
    padding: 8px 12px; border: 1px solid var(--line); border-radius: 6px;
    background: transparent; color: var(--muted); cursor: pointer;
  }
  .sig-look b { font-weight: 500; color: var(--ink); text-transform: uppercase; }
  .sig-look[aria-pressed="true"] { border-color: var(--ink); color: var(--ink); }
  .sig-look:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }

  .sig-phone { display: none; }
  @media (max-width: 899px), (pointer: coarse) {
    .sig-host, .sig-looks { display: none; }
    .sig-phone { display: flex; flex-direction: column; gap: 16px; align-items: center; text-align: center; padding-top: 10vh; }
    .sig-still { width: min(88vw, 420px); aspect-ratio: 1120 / 800; border-radius: 12px; background: #0b0d12 url("/s/signal-still.webp") center / cover no-repeat; border: 1px solid var(--line); }
    .sig-line { margin: 0; max-width: 32ch; font-size: 0.8125rem; color: var(--muted); line-height: 1.5; }
  }
</style>

<script>
  // the look switch (?look=a|b|c or the three buttons) and the host fit
  const page = document.querySelector<HTMLElement>(".sig-page");
  const host = document.getElementById("sig-host");
  const fit = document.getElementById("sig-fit");
  const device = document.getElementById("sig-device");
  if (page && host && fit && device) {
    const pick = (id: string, push = true) => {
      if (!["a", "b", "c"].includes(id)) return;
      page.dataset.look = id;
      page.querySelectorAll<HTMLButtonElement>(".sig-look").forEach((b) => b.setAttribute("aria-pressed", b.dataset.pick === id ? "true" : "false"));
      if (push) { const u = new URL(location.href); u.searchParams.set("look", id); history.replaceState(null, "", u); }
      refit();
    };
    page.querySelectorAll<HTMLButtonElement>(".sig-look").forEach((b) => b.addEventListener("click", () => pick(b.dataset.pick || "a")));
    const q = new URL(location.href).searchParams.get("look");
    if (q) pick(q, false);
    document.addEventListener("keydown", (e) => { if (e.key === "1" || e.key === "2" || e.key === "3") pick("abc"[Number(e.key) - 1]); });
    // fit: scale the 1120 device to the host's content width, cap 1.34; reserve the scaled height
    function refit() {
      const w = host!.clientWidth;
      const z = Math.min(1.34, Math.max(0.5, w / 1120));
      fit!.style.setProperty("--sig-zoom", z.toFixed(4));
      const shown = device!.querySelector<HTMLElement>(".look:not([style*='display: none'])");
      const h = (shown ? shown.getBoundingClientRect().height / z : device!.offsetHeight) || device!.offsetHeight;
      host!.style.height = Math.ceil(h * z) + "px";
    }
    new ResizeObserver(refit).observe(host);
    requestAnimationFrame(refit);
    window.addEventListener("load", refit);
  }
</script>
