---
// SIGNAL · THE PORTFOLIO REBUILD (branch `signal`, 2026-09-23). Its own page, and since R2 the homepage's play room
// mounts the same component (src/components/studio/StudioOne.astro). src/components/signal/Signal.astro is the device
// (the power, the legend and the brief under it), src/signal/main.ts boots it. The R0 contact sheet's three looks stay
// in src/components/signal/look/ (unused). The device is 1120 px, always; this page fits it the way the homepage's
// host does (zoom, the same caps), so the two read the same. Phones and coarse pointers get a still and one line
// (Law 2), nothing more.
import Layout from "../layouts/Layout.astro";
import AwayRail from "../components/studio/AwayRail.astro";
import Signal from "../components/signal/Signal.astro";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "@fontsource/ibm-plex-sans/400.css";
import "@fontsource/orbitron/500.css";

export const prerender = true;
---

<Layout title="SIGNAL — Jonathan Tollefson" description="A browser instrument: drums, bass, keys. Play it with the keyboard.">
  <AwayRail home="house" />
  <main class="sig-page">
    <div class="sig-host" id="sig-host">
      <div class="sig-fit" id="sig-fit">
        <Signal />
      </div>
    </div>
    <div class="sig-phone" aria-hidden="false">
      <div class="sig-still" role="img" aria-label="SIGNAL, a browser instrument"></div>
      <p class="sig-line">SIGNAL is played with a keyboard and a mouse. Open it on a desk.</p>
    </div>
  </main>
</Layout>

<style>
  .sig-page {
    min-height: 100svh;
    background: var(--bg);
    color: var(--ink);
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    padding: 40px 24px 60px;
    box-sizing: border-box;
    transition: background 560ms ease, color 560ms ease;
  }
  @media (min-width: 900px) { .sig-page { padding-left: calc(var(--railw, 110px) + 24px); } }

  /* THE HOST FIT (the homepage's, StudioOne.astro: .live-signal .sgm / .sgm .device): the device is 1280 px, always
     (types.ts DEVICE_W), and `zoom` scales it (never the device's own CSS), so its layout box IS its drawn size: the
     page flows around it, nothing to reserve. #sig-fit is .sgm's parent, the fit's measure. The script sets --sig-zoom
     from BOTH axes (R3): 98 % of the column, or the viewport's height less the page's own padding, whichever binds. */
  .sig-host { width: 100%; max-width: 1560px; display: flex; justify-content: center; align-items: flex-start; }
  .sig-fit { width: 100%; min-width: 0; }
  .sig-fit :global(.sgm) { width: fit-content; margin-inline: auto; }
  .sig-fit :global(.sgm .device) { width: 1280px; zoom: var(--sig-zoom, 1); }   /* = types.ts DEVICE_W */
  /* the site's dot cursor (Cursor.astro) is redundant over the instrument: the material restores the system cursor
     there (pointer on caps, ns-resize on knobs, ew-resize on the glass, grab on nodes) */
  :global(body:has(.sig:hover) .cursor-dot) { visibility: hidden !important; }

  .sig-phone { display: none; }
  @media (max-width: 899px), (pointer: coarse) {
    .sig-host { display: none; }
    .sig-phone { display: flex; flex-direction: column; gap: 16px; align-items: center; text-align: center; padding-top: 10vh; }
    .sig-still { width: min(88vw, 420px); aspect-ratio: 1120 / 873; border-radius: 12px; background: #0b0d12 url("/s/signal-still.webp") center / cover no-repeat; border: 1px solid var(--line); }
    .sig-line { margin: 0; max-width: 32ch; font-size: 0.8125rem; color: var(--muted); line-height: 1.5; }
  }
</style>

<script>
  // THE FIT (R3; the homepage's host, StudioOne.astro, keeps the same law): zoom = min(0.98 · the measure's width ÷
  // DEVICE_W, (the viewport's height − the page's vertical padding) ÷ the device's own height), floor 0.25. The device
  // stands at 97–99 % of the column wherever the height allows and never touches the nav rail; on a short screen the
  // height binds and the whole device still shows. The old height-cap table is retired.
  const fitEl = document.getElementById("sig-fit");
  const devEl = document.getElementById("sig-device");
  if (fitEl && devEl) {
    const REF = 1280;            // = types.ts DEVICE_W
    const WIDTH_SHARE = 0.98;    // a 2 % margin: 1 % each side of the column
    const PAGE_V = 100;          // .sig-page's padding: 40 top + 60 bottom
    let last = "";
    const fit = (): void => {
      const w = fitEl.clientWidth;
      if (w <= 0) return;   // hidden (the phone layout): nothing to fit
      const h = devEl.offsetHeight || 808;   // the device's UNZOOMED height (offsetHeight ignores zoom)
      const byW = (WIDTH_SHARE * w) / REF;
      const byH = Math.max(120, window.innerHeight - PAGE_V) / h;
      const z = Math.max(0.25, Math.min(byW, byH)).toFixed(4);
      if (z === last) return;
      last = z;
      fitEl.style.setProperty("--sig-zoom", z);
    };
    fit();
    new ResizeObserver(fit).observe(fitEl);
    new ResizeObserver(fit).observe(devEl);
    window.addEventListener("resize", fit, { passive: true });
  }

  // THE ROOM LAW (the homepage's, StudioOne.astro): scrolled mostly out of view, the instrument powers off through its
  // own disc (the same click the host sends).
  const sgm = document.getElementById("sgm");
  if (sgm) {
    new IntersectionObserver(([e]) => {
      const st = sgm.getAttribute("data-state");
      if (e && e.intersectionRatio < 0.35 && (st === "boot" || st === "live")) document.getElementById("pwr")?.click();
    }, { threshold: [0, 0.35] }).observe(sgm);
  }
</script>
