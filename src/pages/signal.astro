---
// SIGNAL · THE PORTFOLIO REBUILD (branch `signal`, 2026-09-23). Its own page; the homepage keeps the
// old instrument until Jon swaps them by hand. R1 = the instrument, live (look B: carbon · glass · keycaps):
// src/components/signal/Signal.astro is the device, src/signal/main.ts boots it. The R0 contact sheet's three
// looks stay in src/components/signal/look/ (unused; ?look= does nothing now). The device is 1120 px, always;
// the host fits it to the viewport. Phones and coarse pointers get a still and one line (Law 2), nothing more.
import Layout from "../layouts/Layout.astro";
import AwayRail from "../components/studio/AwayRail.astro";
import Signal from "../components/signal/Signal.astro";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "@fontsource/ibm-plex-sans/400.css";
import "@fontsource/orbitron/500.css";

export const prerender = true;
---

<Layout title="SIGNAL — Jonathan Tollefson" description="A browser instrument: drums, bass, keys. Play it with the keyboard.">
  <AwayRail home="house" />
  <main class="sig-page">
    <div class="sig-host" id="sig-host">
      <div class="sig-fit" id="sig-fit">
        <Signal />
      </div>
    </div>
    <div class="sig-phone" aria-hidden="false">
      <div class="sig-still" role="img" aria-label="SIGNAL, a browser instrument"></div>
      <p class="sig-line">SIGNAL is played with a keyboard and a mouse. Open it on a desk.</p>
    </div>
  </main>
</Layout>

<style>
  .sig-page {
    min-height: 100svh;
    background: var(--bg);
    color: var(--ink);
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    padding: 40px 24px 60px;
    box-sizing: border-box;
    transition: background 560ms ease, color 560ms ease;
  }
  @media (min-width: 900px) { .sig-page { padding-left: calc(var(--railw, 110px) + 24px); } }

  /* THE HOST FIT: the device is 1120 px, always. The host scales it (never the device's own CSS) —
     zoom = min(1.34, content width / 1120), the homepage law. Height follows the scaled box. */
  .sig-host { width: 100%; max-width: 1560px; display: flex; justify-content: center; align-items: flex-start; }
  .sig-fit { width: 1120px; flex: none; transform-origin: top center; transform: scale(var(--sig-zoom, 1)); }
  .sig-fit :global(.sig-device) { width: 1120px; }
  /* the site's dot cursor (Cursor.astro) is redundant over the instrument: the material restores the system cursor
     there (pointer on caps, ns-resize on knobs, ew-resize on the glass, grab on nodes) */
  :global(body:has(.sig:hover) .cursor-dot) { visibility: hidden !important; }

  .sig-phone { display: none; }
  @media (max-width: 899px), (pointer: coarse) {
    .sig-host { display: none; }
    .sig-phone { display: flex; flex-direction: column; gap: 16px; align-items: center; text-align: center; padding-top: 10vh; }
    .sig-still { width: min(88vw, 420px); aspect-ratio: 1120 / 873; border-radius: 12px; background: #0b0d12 url("/s/signal-still.webp") center / cover no-repeat; border: 1px solid var(--line); }
    .sig-line { margin: 0; max-width: 32ch; font-size: 0.8125rem; color: var(--muted); line-height: 1.5; }
  }
</style>

<script>
  // the host fit: scale the 1120 device to the host's content width (cap 1.34), reserve the scaled height; it follows
  // the host's width AND the device's own height (the views mount after the boot, the device grows into its strata)
  const host = document.getElementById("sig-host");
  const fit = document.getElementById("sig-fit");
  const device = document.getElementById("sig-device");
  if (host && fit && device) {
    const refit = (): void => {
      const w = host.clientWidth;
      if (!w) return;
      const z = Math.min(1.34, Math.max(0.5, w / 1120));
      fit.style.setProperty("--sig-zoom", z.toFixed(4));
      host.style.height = Math.ceil(device.offsetHeight * z) + "px";
    };
    const ro = new ResizeObserver(refit);
    ro.observe(host);
    ro.observe(device);
    requestAnimationFrame(refit);
    window.addEventListener("load", refit);
  }
</script>
