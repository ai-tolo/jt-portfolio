---
import PortalLayout from "../../layouts/PortalLayout.astro";
import { trashList } from "../../lib/console-api";
import type { Asset } from "../../lib/console-types";

const res = await trashList({ limit: 100 });
let items: (Asset & { trashed_at: string })[] = [];
let total = 0;
let fetchError: string | null = null;
if (res.ok) {
  items = res.data.items;
  total = res.data.total;
} else {
  fetchError = res.error.kind === "http" ? `HTTP ${res.error.status}` : res.error.kind;
}

function formatDate(iso: string | null | undefined): string {
  if (!iso) return "";
  try {
    return new Date(iso).toLocaleString(undefined, {
      year: "numeric", month: "short", day: "numeric", hour: "numeric", minute: "2-digit",
    });
  } catch {
    return iso;
  }
}
---

<PortalLayout title="Trash" current="library">
  <section class="surface">
    <header class="surface-head">
      <div>
        <p class="eyebrow">Trash</p>
        <h1 class="title">Trashed items</h1>
        <p class="subtitle">
          Hidden from Surprise / Library / Diary / Sounds. The file on disk is untouched.
          Restore anytime.
        </p>
      </div>
      <a class="back" href="/portal/library">← Library</a>
    </header>

    {fetchError && (
      <p class="error" role="alert">Couldn't load: {fetchError}</p>
    )}

    {!fetchError && total === 0 && (
      <p class="empty">Trash is empty.</p>
    )}

    {items.length > 0 && (
      <>
        <p class="count"><strong>{total}</strong> {total === 1 ? "item" : "items"} in trash</p>
        <ul class="list" role="list">
          {items.map((item) => {
            const name = item.display_name || item.filename;
            return (
              <li class="trashed" data-path={item.path}>
                <div class="meta">
                  <span class="eyebrow">{item.category.replace(/_/g, " ")}</span>
                  <span class="when">Trashed {formatDate(item.trashed_at)}</span>
                </div>
                <h2 class="name" title={item.filename}>{name}</h2>
                {item.summary && <p class="summary">{item.summary}</p>}
                <div class="actions">
                  <button type="button" class="restore" data-action="restore" data-path={item.path}>
                    ↺ Restore
                  </button>
                </div>
              </li>
            );
          })}
        </ul>
      </>
    )}
  </section>
</PortalLayout>

<script>
  document.addEventListener("click", async (e) => {
    const target = e.target as HTMLElement | null;
    const btn = target?.closest<HTMLButtonElement>('[data-action="restore"][data-path]');
    if (!btn) return;
    const path = btn.dataset.path!;
    const li = btn.closest<HTMLElement>(".trashed");
    if (li) li.dataset.restoring = "true";
    btn.disabled = true;
    try {
      const res = await fetch("/api/console/items-trashed", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ path, trashed: false }),
      });
      if (!res.ok) {
        if (li) li.removeAttribute("data-restoring");
        btn.disabled = false;
        btn.title = `Restore failed (HTTP ${res.status})`;
        return;
      }
      if (li) li.remove();
    } catch {
      if (li) li.removeAttribute("data-restoring");
      btn.disabled = false;
      btn.title = "Restore failed (network)";
    }
  });
</script>

<style>
  .surface { display: grid; gap: var(--space-5); }
  .surface-head { display: flex; justify-content: space-between; align-items: flex-end; gap: var(--space-6); flex-wrap: wrap; }
  .eyebrow { font-size: var(--fs-eyebrow); font-weight: var(--fw-semibold); letter-spacing: var(--ls-eyebrow); text-transform: uppercase; color: var(--muted); }
  .title { font-size: var(--fs-title); font-weight: var(--fw-bold); letter-spacing: var(--ls-title); margin-top: var(--space-1); }
  .subtitle { color: var(--muted); max-width: 50ch; line-height: 1.55; font-size: var(--fs-small); margin-top: var(--space-2); }
  .back { font-size: var(--fs-eyebrow); font-weight: var(--fw-semibold); letter-spacing: var(--ls-eyebrow); text-transform: uppercase; color: var(--muted); }
  .back:hover { color: var(--accent); }

  .count { font-size: var(--fs-small); color: var(--muted); }
  .count strong { color: var(--accent); }
  .empty { color: var(--muted); padding: var(--space-8) 0; text-align: center; }

  .list {
    list-style: none; padding: 0; margin: 0;
    display: grid; gap: var(--space-4);
  }
  .trashed {
    display: grid; gap: var(--space-2);
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--ink) 4%, transparent);
  }
  .trashed[data-restoring="true"] { opacity: 0.4; pointer-events: none; }
  .trashed .meta {
    display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-4);
  }
  .when { font-size: var(--fs-eyebrow); color: var(--muted); }
  .trashed .name { font-size: 1rem; font-weight: var(--fw-semibold); margin: 0; word-break: break-word; }
  .summary { font-size: var(--fs-small); color: var(--muted); line-height: 1.5; margin: 0; max-width: 60ch; }
  .actions { display: flex; gap: var(--space-3); }
  .restore {
    font: inherit; font-size: var(--fs-eyebrow); font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-eyebrow); text-transform: uppercase;
    background: transparent; color: var(--text);
    border: 1px solid var(--line); padding: 6px 10px; cursor: pointer;
    transition: border-color 160ms, color 160ms;
  }
  .restore:hover, .restore:focus-visible { border-color: var(--accent); color: var(--accent); }
  .restore:disabled { opacity: 0.4; cursor: wait; }

  .error {
    padding: var(--space-3) var(--space-4);
    border-left: 2px solid var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    font-size: var(--fs-small);
  }
</style>
