---
import PortalLayout from "../../layouts/PortalLayout.astro";
import Card from "../../components/portal/Card.astro";
import { staleList } from "../../lib/console-api";
import type { Asset, StaleSort } from "../../lib/console-api";

const PAGE_SIZE = 50;
const SORT_LABELS: Record<StaleSort, string> = {
  recent: "Newest indexed first",
  oldest: "Oldest indexed first",
};
const VALID_SORTS = Object.keys(SORT_LABELS) as StaleSort[];

const url = Astro.url;
const sortParam = (url.searchParams.get("sort") ?? "recent") as StaleSort;
const sort: StaleSort = VALID_SORTS.includes(sortParam) ? sortParam : "recent";
const limit = (() => {
  const n = parseInt(url.searchParams.get("limit") ?? "", 10);
  return Number.isFinite(n) && n > 0 ? Math.min(n, 500) : PAGE_SIZE;
})();

let items: Asset[] = [];
let total = 0;
let fetchError: string | null = null;

const res = await staleList({ sort, limit });
if (res.ok) {
  items = res.data.items;
  total = res.data.total;
} else {
  fetchError = res.error.kind === "http" ? `HTTP ${res.error.status}` : res.error.kind;
}

const truncated = limit < total;
const nextLimit = Math.min(limit + PAGE_SIZE, 500);
const buildHref = (overrides: Record<string, string | null>): string => {
  const p = new URLSearchParams(url.searchParams);
  for (const [k, v] of Object.entries(overrides)) {
    if (v === null) p.delete(k);
    else p.set(k, v);
  }
  const qs = p.toString();
  return qs ? `/portal/stale?${qs}` : "/portal/stale";
};
---

<PortalLayout title="Stale queue" current="library">
  <section class="surface">
    <header class="surface-head">
      <div>
        <p class="eyebrow">Curation · Stale queue</p>
        <h1 class="title">Things the system has but hasn't done anything with</h1>
        <p class="lede">
          Never surfaced. Not referenced by any <code>.als</code> project. No summary, no tags.
          The intersection of "indexed" and "ignored." Trash, rename, or flip to public from here.
        </p>
      </div>
    </header>

    <form method="GET" action="/portal/stale" class="controls" role="search" aria-label="Stale queue controls">
      <label class="sort-pick">
        Sort by
        <select name="sort" onchange="this.form.submit()">
          {VALID_SORTS.map((s) => (
            <option value={s} selected={s === sort}>{SORT_LABELS[s]}</option>
          ))}
        </select>
      </label>
      <noscript><button type="submit">Apply</button></noscript>
      <a class="back-link" href="/portal/library">← back to Library</a>
      <a class="back-link" href="/portal/trash">view Trash →</a>
    </form>

    {fetchError ? (
      <p class="error" role="alert">Couldn't load: {fetchError}</p>
    ) : (
      <>
        <div class="result-meta">
          <p class="count">
            <strong>{items.length.toLocaleString()}</strong> of {total.toLocaleString()} candidates
            <span class="muted"> · {SORT_LABELS[sort].toLowerCase()}</span>
          </p>
        </div>

        {items.length === 0 ? (
          <p class="no-results">Nothing stale. Either everything's been touched, or you've already cleaned up.</p>
        ) : (
          <ul class="cards">
            {items.map((item) => (
              <li><Card item={item} /></li>
            ))}
          </ul>
        )}

        {truncated && items.length > 0 && (
          <p class="load-more-wrap">
            <a class="load-more" href={buildHref({ limit: String(nextLimit) })}>
              Load more ({Math.min(nextLimit, total).toLocaleString()} of {total.toLocaleString()})
            </a>
          </p>
        )}
      </>
    )}
  </section>
</PortalLayout>

<style>
  .surface {
    display: grid;
    gap: var(--space-6);
  }
  .surface-head { display: grid; gap: var(--space-3); }
  .eyebrow {
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--muted);
  }
  .title {
    font-size: var(--fs-title);
    font-weight: var(--fw-bold);
    letter-spacing: var(--ls-title);
    line-height: var(--lh-title);
    margin-top: var(--space-1);
  }
  .lede {
    color: var(--muted);
    font-size: var(--fs-small);
    line-height: 1.55;
    max-width: 60ch;
  }
  .lede code {
    font-family: inherit;
    background: var(--ink);
    color: var(--ink-fg);
    padding: 1px 6px;
    font-size: 11px;
    letter-spacing: 0.08em;
  }

  .controls {
    display: flex;
    gap: var(--space-4);
    align-items: center;
    flex-wrap: wrap;
  }
  .sort-pick {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--muted);
  }
  .sort-pick select {
    font: inherit;
    color: var(--text);
    background: transparent;
    border: 1px solid var(--line);
    padding: var(--space-2) var(--space-3);
    text-transform: none;
    letter-spacing: 0;
    cursor: pointer;
  }
  .back-link {
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--muted);
  }
  .back-link:hover { color: var(--accent); }

  .result-meta { display: flex; gap: var(--space-4); flex-wrap: wrap; }
  .count { font-size: var(--fs-small); }
  .count strong { color: var(--accent); }
  .count .muted { color: var(--muted); }

  .error {
    padding: var(--space-3) var(--space-4);
    border-left: 2px solid var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    font-size: var(--fs-small);
  }
  .no-results { color: var(--muted); font-style: italic; }

  .cards {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
  }

  .load-more-wrap { text-align: center; }
  .load-more {
    display: inline-block;
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--accent);
    border: 1px solid var(--accent);
    padding: var(--space-3) var(--space-6);
    text-decoration: none;
    transition: background-color 200ms ease, color 200ms ease;
  }
  .load-more:hover, .load-more:focus-visible {
    background: var(--accent);
    color: var(--bg);
  }
</style>
