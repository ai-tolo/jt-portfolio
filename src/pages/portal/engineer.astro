  /* Dim the side that isn't playing. data-dim is toggled by
     reflectSide. transition: none forces the new value in immediately;
     without it, the parent's transition declaration was queueing
     the change and never firing in some browser states. */
  .ab-side[data-dim="true"] {
    opacity: 0.36 !important;
    filter: saturate(0.55) !important;
    transition: none !important;
  }
  .ab-side[data-dim="true"]:hover {
    opacity: 0.8 !important;
    filter: none !important;
  }
</style>

<script>
  // Pair-tinder controller. The pair surfaces a single shared waveform
  // (the source track's pre-rendered PNG) with one playhead. Two audio
  // elements hold the A and B variants and stay synced on currentTime;
  // toggling A/B is an instant swap, not a stop/restart, so the curator
  // hears the same moment in both versions. Click the waveform to seek,
  // arrows to step ±10s, space to play/pause.
  //
  // Audio is opus-transcoded via /api/console/asset?...&variant=opus.

  const audioA = new Audio();
  const audioB = new Audio();
  // Third element for the source asset. The new model: neither A nor B
  // selected means "play the original" — so audioOriginal is the implicit
  // default. All three stay synced on currentTime; tapping A/B is a pure
  // source-toggle (never affects play/pause). Space-bar is the sole play
  // control.
  const audioOriginal = new Audio();
  for (const a of [audioA, audioB, audioOriginal]) {
    a.preload = "auto";
  }
  let activePairEl: HTMLElement | null = null;
  // null = "original is playing"; "a" or "b" = that variant is playing.
  let currentSide: "a" | "b" | null = null;
  let currentSolo: string | null = null;
  let playheadRaf: number | null = null;

  // Undo + retry-zone removed 2026-05-27 evening: vote is final, no
  // ⌘Z undo, no per-pair "try this axis again". The path to fresh
  // mixes is now exclusively through the Winners section's "Make more
  // mixes" button. Keeps the Mix Faceoff focused on listening + voting
  // and gives the curator a clean "submitted, that's it" feel.

  function urlForSide(pair: HTMLElement, side: "a" | "b" | null): string {
    // Original: source asset, never affected by solo (solo only varies
    // the per-stem treatment of a variant — original has no stem chain).
    if (side === null) return pair.dataset.sourceAudioUrl || "";
    if (!currentSolo) {
      return (side === "a" ? pair.dataset.urlA : pair.dataset.urlB) ?? "";
    }
    try {
      const json = side === "a" ? pair.dataset.stemUrlsA : pair.dataset.stemUrlsB;
      const map = JSON.parse(json || "{}") as Record<string, string>;
      // Fall back to bus URL if this side lacks the soloed stem (e.g. it
      // was muted in this variant's plan).
      return map[currentSolo] || (side === "a" ? pair.dataset.urlA : pair.dataset.urlB) || "";
    } catch {
      return (side === "a" ? pair.dataset.urlA : pair.dataset.urlB) ?? "";
    }
  }

  function refreshSoloBar(pair: HTMLElement) {
    pair.querySelectorAll<HTMLElement>(
      "[data-solo-stem], [data-solo-full]"
    ).forEach((btn) => {
      let active = false;
      if (btn.hasAttribute("data-solo-full")) active = currentSolo === null;
      else active = btn.dataset.soloStem === currentSolo;
      if (active) btn.dataset.active = "true";
      else delete btn.dataset.active;
    });
  }

  function applyCurrentUrls(pair: HTMLElement, restartIfPlaying = true) {
    const t = activeAudio().currentTime;
    const wasPlaying = !activeAudio().paused;
    audioA.src = urlForSide(pair, "a");
    audioB.src = urlForSide(pair, "b");
    // audioOriginal.src is reassigned to source on every pair change in
    // setActivePair, but it might have been swapped to a stem for solo
    // listening… actually no, solo never touches audioOriginal. So leave
    // its src alone here; it always holds the source asset URL for the
    // current pair.
    const restore = () => {
      for (const a of allAudios()) {
        try { a.currentTime = t; } catch {}
      }
    };
    restore();
    audioA.addEventListener("loadedmetadata", restore, { once: true });
    audioB.addEventListener("loadedmetadata", restore, { once: true });
    if (wasPlaying && restartIfPlaying) {
      activeAudio().play().catch(() => {});
    }
  }

  function setSolo(stem: string | null) {
    const pair = activePairEl;
    if (!pair) return;
    if (currentSolo === stem) return;
    currentSolo = stem;
    refreshSoloBar(pair);
    applyCurrentUrls(pair);
  }

  function activePair(): HTMLElement | null {
    return document.querySelector<HTMLElement>(".pair-active");
  }

  function activeAudio(): HTMLAudioElement {
    if (currentSide === "a") return audioA;
    if (currentSide === "b") return audioB;
    return audioOriginal;
  }

  function allAudios(): HTMLAudioElement[] {
    return [audioA, audioB, audioOriginal];
  }

  // Loudness-matched A/B. Past votes were biased toward whichever clip was
  // loudest — the already-mastered source, and the louder dynamics pole
  // (modern_compressed renders ~6 dB hotter than vintage_open). We normalize
  // playback so A, B and ORIGINAL all sit at the QUIETEST clip's integrated
  // LUFS: every gain is <= 0 dB, so this only attenuates (no clipping, no
  // boost past unity). Clips without a measured LUFS (older renders) stay at
  // unity, and the readout says the match is unavailable.
  function lufsNum(v: string | undefined): number | null {
    if (v === undefined || v === "") return null;
    const n = parseFloat(v);
    return Number.isFinite(n) ? n : null;
  }

  function applyLoudnessMatch(pair: HTMLElement) {
    const aL = lufsNum(pair.dataset.aLufs);
    const bL = lufsNum(pair.dataset.bLufs);
    const sL = lufsNum(pair.dataset.sourceLufs);
    const finite = [aL, bL, sL].filter((x): x is number => x !== null);
    const target = finite.length >= 2 ? Math.min(...finite) : null;
    const vol = (clip: number | null): number => {
      if (target === null || clip === null) return 1;
      return Math.min(1, Math.max(0, Math.pow(10, (target - clip) / 20)));
    };
    audioA.volume = vol(aL);
    audioB.volume = vol(bL);
    audioOriginal.volume = vol(sL);

    const el = pair.querySelector<HTMLElement>("[data-loudness]");
    if (!el) return;
    if (target === null) {
      el.textContent = "loudness match unavailable — re-render this track to enable";
      return;
    }
    // Blind: don't print per-take LUFS / peak — that would leak which chip is
    // which, and louder is not better. Just confirm all three are matched.
    el.textContent =
      `🔊 all three takes level-matched to ${target.toFixed(1)} LUFS — vote on tone, not loudness`;
  }

  function fmtTime(s: number): string {
    if (!Number.isFinite(s) || s < 0) return "0:00";
    const m = Math.floor(s / 60);
    const r = Math.floor(s % 60);
    return `${m}:${String(r).padStart(2, "0")}`;
  }

  // No-op since the now-playing line was removed from the pair foot in
  // the May 22 UI refresh. Kept as a defensive stub so older call sites
  // don't throw. Diagnostic text we'd have shown now goes to console.
  function setNowPlaying(_pair: HTMLElement, label: string) {
    if (label) console.debug("[engineer]", label);
  }

  function updateTime(pair: HTMLElement) {
    const a = activeAudio();
    const dur = Number(pair.dataset.duration || a.duration || 0);
    const node = pair.querySelector<HTMLElement>("[data-time]");
    if (node) {
      node.textContent = `${fmtTime(a.currentTime)} / ${fmtTime(dur)}`;
    }
    const ph = pair.querySelector<HTMLElement>("[data-playhead]");
    if (ph && dur > 0) {
      ph.hidden = false;
      ph.style.left = `${Math.min(100, (a.currentTime / dur) * 100)}%`;
    }
  }

  function tickPlayhead() {
    const pair = activePairEl;
    if (!pair) return;
    updateTime(pair);
    playheadRaf = requestAnimationFrame(tickPlayhead);
  }

  function startTicking() {
    if (playheadRaf !== null) return;
    playheadRaf = requestAnimationFrame(tickPlayhead);
  }

  function stopTicking() {
    if (playheadRaf !== null) {
      cancelAnimationFrame(playheadRaf);
      playheadRaf = null;
    }
  }

  function setPlayButton(pair: HTMLElement, state: "playing" | "paused" | "loading") {
    const btn = pair.querySelector<HTMLElement>("[data-toggle-play]");
    if (btn) btn.dataset.state = state;
  }

  // Buffering visual (#1): toggle the shimmer sweep over the active pair's
  // waveform. The play-button spinner (setPlayButton "loading") is the paired
  // signal. Long uncached sources stall on first byte over the Funnel — these
  // two make that visible instead of a frozen, silent UI.
  function setBuffering(pair: HTMLElement | null, on: boolean) {
    if (!pair) return;
    const wave = pair.querySelector<HTMLElement>("[data-stage-waveform]");
    if (!wave) return;
    if (on) wave.setAttribute("data-buffering", "true");
    else wave.removeAttribute("data-buffering");
  }

  function setActivePair(pair: HTMLElement) {
    activePairEl = pair;
    currentSolo = null;
    // Default to original (null side) when a source URL is available;
    // fall back to A if not (e.g. retry-only jobs missing source path —
    // shouldn't happen in practice but better than no audio).
    const hasOriginal = !!pair.dataset.sourceAudioUrl;
    currentSide = hasOriginal ? null : "a";
    // Pause everything first to stop bleed-through from the previous
    // pair, then assign and eagerly load so the first tap has buffer
    // ready.
    for (const a of allAudios()) a.pause();
    audioA.src = pair.dataset.urlA || "";
    audioB.src = pair.dataset.urlB || "";
    audioOriginal.src = pair.dataset.sourceAudioUrl || "";
    for (const a of allAudios()) {
      a.load();
      a.currentTime = 0;
    }
    applyLoudnessMatch(pair);
    setPlayButton(pair, "paused");
    updateTime(pair);
    reflectSide(pair, currentSide);
    refreshSoloBar(pair);
  }

  function reflectSide(pair: HTMLElement, side: "a" | "b" | null) {
    pair.dataset.side = side ?? "original";
    // Highlight whichever of the three blind chips is the active source — the
    // ORIGINAL chip carries data-now-side, the two variants data-side-btn — and
    // dim the other two. Symmetric on purpose: the ORIGINAL is no longer
    // singled out, and nothing here writes an identity label. (#4 blind voting)
    pair.querySelectorAll<HTMLElement>("[data-side-btn], [data-now-side]").forEach((btn) => {
      const isActive = btn.hasAttribute("data-now-side")
        ? side === null
        : btn.dataset.sideBtn === side;
      btn.classList.toggle("ab-side-active", isActive);
      if (isActive) btn.removeAttribute("data-dim");
      else btn.setAttribute("data-dim", "true");
    });
  }

  async function togglePlay() {
    const pair = activePairEl;
    if (!pair) return;
    const a = activeAudio();
    if (a.paused) {
      // Show the spinner + waveform shimmer while the first byte is in flight;
      // the 'playing' listener clears them once audio actually starts. (#1)
      setPlayButton(pair, "loading");
      setBuffering(pair, true);
      try {
        await a.play();
        setPlayButton(pair, "playing");
        startTicking();
      } catch (e) {
        setBuffering(pair, false);
        setPlayButton(pair, "paused");
        setNowPlaying(pair, `play failed: ${(e as Error).message ?? e}`);
      }
    } else {
      a.pause();
      setPlayButton(pair, "paused");
      stopTicking();
    }
  }

  function switchSide(side: "a" | "b") {
    const pair = activePairEl;
    if (!pair) return;
    // Pure source-toggle. Never affects play/pause (space-bar owns that).
    // If the target side is already the active one, deselect → original.
    // Otherwise switch to it. CurrentTime + play state are preserved
    // across the swap so the curator never loses their place.
    const target: "a" | "b" | null = side === currentSide ? null : side;
    const prev = activeAudio();
    const t = prev.currentTime;
    const wasPlaying = !prev.paused;
    prev.pause();
    currentSide = target;
    const next = activeAudio();
    next.currentTime = t;
    reflectSide(pair, target);
    if (wasPlaying) {
      setPlayButton(pair, "loading");
      setBuffering(pair, true);
      next.play().then(() => {
        setPlayButton(pair, "playing");
        startTicking();
      }).catch(() => { setBuffering(pair, false); });
    }
  }

  function seekTo(seconds: number) {
    const pair = activePairEl;
    if (!pair) return;
    const dur = Number(pair.dataset.duration || activeAudio().duration || 0);
    const t = Math.max(0, Math.min(dur || Infinity, seconds));
    for (const a of allAudios()) {
      try { a.currentTime = t; } catch {}
    }
    updateTime(pair);
  }

  function skipBy(delta: number) {
    seekTo(activeAudio().currentTime + delta);
  }

  function seekFromClick(e: MouseEvent) {
    const pair = activePairEl;
    if (!pair) return;
    const wave = pair.querySelector<HTMLElement>("[data-stage-waveform]");
    if (!wave) return;
    const rect = wave.getBoundingClientRect();
    const fraction = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
    const dur = Number(pair.dataset.duration || activeAudio().duration || 0);
    if (dur > 0) seekTo(fraction * dur);
  }

  function stopAll() {
    for (const a of allAudios()) {
      a.pause();
      a.currentTime = 0;
    }
    stopTicking();
  }

  function getComment(pair: HTMLElement): string {
    const ta = pair.querySelector<HTMLTextAreaElement>("[data-comment]");
    return ta?.value.trim() ?? "";
  }

  async function commit(
    pair: HTMLElement,
    choice: "a" | "b" | "skip" | "original",
  ) {
    // Capture playback state BEFORE we stop both audios so advancePair
    // can decide whether to keep the listening session going on the next
    // pair (matches the tinder feel of "I'm in flow, keep me there").
    const wasPlaying =
      !audioA.paused || !audioB.paused || !audioOriginal.paused;
    stopAll();
    setPlayButton(pair, "paused");
    pair.dataset.continuePlayback = wasPlaying ? "true" : "false";
    const jobId = Number(pair.dataset.jobId);
    const axis = pair.dataset.axis ?? null;
    const aId = Number(pair.dataset.a);
    const bId = Number(pair.dataset.b);
    // ORIGINAL and skip both leave chosen_variant_id null; the engine
    // differentiates via the chose_original flag.
    const chosen = choice === "a" ? aId : choice === "b" ? bId : null;
    const comment = getComment(pair);
    setNowPlaying(pair, "recording…");
    const res = await fetch("/api/console/mix-judgement", {
      method: "POST",
      headers: { "content-type": "application/json" },
      body: JSON.stringify({
        job_id: jobId,
        variant_a_id: aId,
        variant_b_id: bId,
        chosen_variant_id: chosen,
        chose_original: choice === "original",
        axis,
        comment: comment || null,
      }),
    });
    if (!res.ok) {
      setNowPlaying(pair, `judgement failed: HTTP ${res.status}`);
      return;
    }
    // Vote is final — drop the pair from the DOM and move on. No undo
    // window, no retry zone. If the curator wants more mixes for this
    // source, they hit Make more mixes in the Winners section.
    advancePair(pair);
  }

  function advancePair(pair: HTMLElement) {
    const continuePlayback = pair.dataset.continuePlayback === "true";
    // Stop + reset all audios FIRST so the next pair's audio sources
    // load fresh and the previous pair's playback can't bleed in.
    stopAll();
    // Detach src from each shared audio element so the browser releases
    // the previous buffers cleanly. setActivePair on the next pair will
    // re-point them to fresh URLs.
    audioA.removeAttribute("src");
    audioB.removeAttribute("src");
    audioOriginal.removeAttribute("src");
    audioA.load();
    audioB.load();
    audioOriginal.load();

    const next = pair.nextElementSibling as HTMLElement | null;
    pair.classList.remove("pair-active");
    pair.remove(); // drop the voted pair entirely so it can't impact next playback

    if (next?.matches?.(".pair")) {
      next.classList.add("pair-active");
      setActivePair(next);
      next.scrollIntoView({ behavior: "smooth", block: "center" });
      // If the curator was actively listening, keep them listening — start
      // the next pair automatically so flow isn't broken. Play activeAudio()
      // (NOT audioA): setActivePair just set currentSide to null = ORIGINAL
      // (or "a" only when the pair has no source) and reflectSide labeled the
      // pill to match. Hard-coding audioA here played Mix A while the pill
      // still read ORIGINAL — the post-vote desync that forced an A→ORIGINAL
      // re-tap to resync. activeAudio() keeps the element that actually plays
      // in lockstep with currentSide + the reflected side. (fixed 2026-06-01)
      if (continuePlayback) {
        activeAudio().play().then(() => {
          setPlayButton(next, "playing");
          startTicking();
        }).catch(() => {
          // Browser blocked autoplay (rare since this trace from a real
          // user-gesture commit). Curator hits a side or space to resume.
        });
      }
    } else {
      // No more pairs left in this session — reload so the server
      // surfaces fresh pairs (or shows the empty state).
      window.location.reload();
    }
  }

  // retryAxis removed 2026-05-27 evening: per-pair "try this axis again"
  // CTA is gone. To render fresh variants, the curator uses Make more
  // mixes in the Winners section (covers all three axes at once and
  // works even when Pair Tinder is empty).

  // Hold-to-vote / hold-to-skip mechanics. Mirrors the buckets card
  // trash-hold pattern: 650ms press fills a power-up bar; release before
  // the bar finishes is a tap (passes through to the existing click
  // handler for the side switch). Release after fills the bar fires
  // commit and suppresses the trailing click so we don't double-trigger
  // switchSide right after committing. Duration kept in lockstep with
  // the CSS transition above — change both together.
  const HOLD_MS = 650;
  const HOLD_CLICK_SUPPRESS_MS = 220;
  let holdTimer: number | null = null;
  let holdButton: HTMLElement | null = null;
  let lastHoldCommitAt = 0;

  function cancelHold() {
    if (holdTimer !== null) {
      window.clearTimeout(holdTimer);
      holdTimer = null;
    }
    if (holdButton) {
      holdButton.removeAttribute("data-holding");
      holdButton = null;
    }
  }

  function startHold(
    btn: HTMLElement,
    choice: "a" | "b" | "skip" | "original",
  ) {
    if (holdTimer !== null) return;
    const pair = btn.closest<HTMLElement>(".pair");
    if (!pair) return;
    if (pair.dataset.committed === "true" && choice !== "skip") return;
    holdButton = btn;
    btn.setAttribute("data-holding", "true");
    holdTimer = window.setTimeout(() => {
      holdTimer = null;
      lastHoldCommitAt = Date.now();
      btn.removeAttribute("data-holding");
      holdButton = null;
      commit(pair, choice);
    }, HOLD_MS);
  }

  document.addEventListener("pointerdown", (e) => {
    const target = e.target as HTMLElement;
    const holdBtn = target.closest<HTMLElement>("[data-hold]");
    if (!holdBtn) return;
    const choice = holdBtn.dataset.hold;
    if (
      choice !== "a" &&
      choice !== "b" &&
      choice !== "skip" &&
      choice !== "original"
    ) {
      return;
    }
    startHold(holdBtn, choice);
  });

  document.addEventListener("pointerup", () => cancelHold());
  document.addEventListener("pointercancel", () => cancelHold());
  document.addEventListener("pointerleave", () => cancelHold(), true);
  // Cancel hold if the pointer leaves the specific button (delegated).
  document.addEventListener("pointerout", (e) => {
    const target = e.target as HTMLElement;
    if (!holdButton) return;
    if (target.closest("[data-hold]") === holdButton) {
      const related = (e as PointerEvent).relatedTarget as HTMLElement | null;
      if (!related || related.closest("[data-hold]") !== holdButton) {
        cancelHold();
      }
    }
  });

  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    const ap = activePair();
    if (!ap) return;

    // Transport: skip ±N, toggle play
    const skip = target.closest<HTMLElement>("[data-skip]");
    if (skip) {
      skipBy(Number(skip.dataset.skip));
      return;
    }
    if (target.closest("[data-toggle-play]")) {
      togglePlay();
      return;
    }

    // A/B switch — tap behavior. Suppress when the click immediately
    // follows a hold-commit so we don't switch playback to the variant
    // the curator just voted on/off the queue.
    const sideBtn = target.closest<HTMLElement>("[data-side-btn]");
    if (sideBtn) {
      if (Date.now() - lastHoldCommitAt < HOLD_CLICK_SUPPRESS_MS) return;
      switchSide(sideBtn.dataset.sideBtn as "a" | "b");
      // Drop focus from the side button so the browser's native space=
      // click on it doesn't fight the document-level space=togglePlay
      // handler. Without this, focus stays on the button and pressing
      // space re-fires switchSide instead of cleanly toggling play.
      sideBtn.blur();
      return;
    }

    // ORIGINAL pill tap — when A or B is the active playback, tapping
    // the pill returns to ORIGINAL (mirrors tap-to-deselect on A/B).
    // Tap on the pill when ORIGINAL is already active is a no-op.
    // The hold gesture is handled separately by startHold() above; this
    // click handler only fires on release-before-fill (a real tap).
    const nowSideBtn = target.closest<HTMLElement>("[data-now-side]");
    if (nowSideBtn) {
      if (Date.now() - lastHoldCommitAt < HOLD_CLICK_SUPPRESS_MS) return;
      if (currentSide !== null) switchSide(currentSide);
      nowSideBtn.blur();
      return;
    }

    // Click anywhere on the waveform = seek
    if (target.closest("[data-stage-waveform]")) {
      seekFromClick(e);
      return;
    }

    // Solo bar: stem-name pill / FULL MIX / ORIGINAL source
    const soloFull = target.closest<HTMLElement>("[data-solo-full]");
    if (soloFull) {
      setSolo(null);
      return;
    }
    const soloOriginal = target.closest<HTMLElement>("[data-solo-original]");
    if (soloOriginal) {
      setSolo(currentSolo === "_original" ? null : "_original");
      return;
    }
    const soloStem = target.closest<HTMLElement>("[data-solo-stem]");
    if (soloStem) {
      const next = soloStem.dataset.soloStem ?? null;
      setSolo(currentSolo === next ? null : next);
      return;
    }

    // Per-pair retry-zone CTAs (NEXT PAIR / TRY THIS AXIS AGAIN) were
    // removed 2026-05-27 evening. Vote → next pair, no in-place retry.
    // If you want fresh variants, hit Make more mixes in Winners.
  });

  document.addEventListener("keydown", (e) => {
    // ⌘Z undo removed 2026-05-27 evening. Vote is final; recovery
    // lives at the higher level (Uncrown on a king card, or Make more
    // mixes to render fresh variants). Skip everything below for
    // ⌘Z / ⌃Z so the browser's native undo handles textareas.
    const isUndo =
      (e.metaKey || e.ctrlKey) && !e.shiftKey && e.key.toLowerCase() === "z";
    if (isUndo) {
      return;
    }
    // Ignore other shortcuts when typing in inputs.
    const tag = (document.activeElement?.tagName ?? "").toLowerCase();
    if (tag === "input" || tag === "textarea") return;
    const pair = activePair();
    if (!pair) return;
    const k = e.key.toLowerCase();
    if (pair.dataset.committed === "true") {
      if (k === "n" || k === "enter") { e.preventDefault(); advancePair(pair); }
      return;
    }
    // A/B switch (instant, doesn't commit). Arrow keys seek ±10s. Space
    // toggles play/pause on the active side regardless of which button
    // has focus (and even if no button has focus). Enter commits the
    // currently-playing side as the vote. Escape skips.
    if (k === "a") { e.preventDefault(); switchSide("a"); }
    else if (k === "b") { e.preventDefault(); switchSide("b"); }
    else if (k === " ") { e.preventDefault(); togglePlay(); }
    else if (k === "arrowleft") { e.preventDefault(); skipBy(-10); }
    else if (k === "arrowright") { e.preventDefault(); skipBy(10); }
    else if (k === "enter") {
      e.preventDefault();
      // Enter commits whatever's currently playing. When neither A nor B
      // is selected (currentSide is null), ORIGINAL is playing — Enter
      // commits ORIGINAL. Matches the gesture model where the user can
      // just listen and press Enter to vote what they hear.
      commit(pair, currentSide ?? "original");
    }
    else if (k === "escape") { e.preventDefault(); commit(pair, "skip"); }
  });

  // All three elements (incl. audioOriginal, now the default side) need the
  // end/metadata handlers: when ORIGINAL plays through, reset the play button
  // and stop the playhead loop just like A/B. Omitting audioOriginal here
  // left the button stuck "playing" and the rAF ticking after the source
  // ended.
  for (const a of allAudios()) {
    a.addEventListener("ended", () => {
      const pair = activePairEl;
      if (pair) { setPlayButton(pair, "paused"); setBuffering(pair, false); }
      stopTicking();
    });
    a.addEventListener("loadedmetadata", () => {
      const pair = activePairEl;
      if (pair) updateTime(pair);
    });
    // Loading / buffering visuals (#1). Only the active source actually plays,
    // so guard on activeAudio() and drive the active pair's spinner + shimmer.
    a.addEventListener("playing", () => {
      if (a !== activeAudio()) return;
      const pair = activePairEl;
      if (!pair) return;
      setBuffering(pair, false);
      setPlayButton(pair, "playing");
      startTicking();
    });
    a.addEventListener("canplay", () => {
      if (a === activeAudio()) setBuffering(activePairEl, false);
    });
    a.addEventListener("waiting", () => {
      if (a !== activeAudio()) return;
      const pair = activePairEl;
      if (!pair) return;
      setBuffering(pair, true);
      setPlayButton(pair, "loading");
    });
    a.addEventListener("stalled", () => {
      if (a === activeAudio()) setBuffering(activePairEl, true);
    });
    a.addEventListener("seeked", () => {
      if (a === activeAudio()) setBuffering(activePairEl, false);
    });
    a.addEventListener("error", () => {
      const pair = activePairEl;
      if (pair) { setBuffering(pair, false); setPlayButton(pair, "paused"); }
      stopTicking();
    });
  }

  // Initialize: first .pair-active becomes the active pair.
  const initial = activePair();
  if (initial) setActivePair(initial);

  // ── Winners controller (Phase 3 + Phase 4 sync) ──────────────────
  // Per-card model: each card holds N audio elements (source + winners),
  // all pre-loaded against the same source duration. Clicking ▶ on a row
  // swaps which audio is active WITHOUT restarting — currentTime is
  // carried over from the previously-active audio, so the curator hears
  // "the same moment" in each version. Click the waveform to seek all
  // audios together; the playhead overlay tracks the active audio.
  //
  // Only one card can play at a time. Clicking ▶ in a different card
  // pauses the previous card.

  type CardController = {
    card: HTMLElement;
    audios: Array<{ row: HTMLElement; btn: HTMLButtonElement; audio: HTMLAudioElement }>;
    activeIndex: number;
    wave: HTMLElement | null;
    playhead: HTMLElement | null;
    timeLabel: HTMLElement | null;
    rafId: number | null;
    pause: () => void;
  };

  const allControllers: CardController[] = [];
  let activeCard: CardController | null = null;

  // fmtTime is reused from the pair-tinder controller above.
  function fmtTimeOrDash(s: number): string {
    return Number.isFinite(s) && s > 0 ? fmtTime(s) : "—:—";
  }

  function pauseOtherCards(except: CardController) {
    for (const c of allControllers) {
      if (c !== except) c.pause();
    }
  }

  document.querySelectorAll<HTMLElement>(".winners-card").forEach((card) => {
    const wave = card.querySelector<HTMLElement>("[data-winners-wave]");
    const playhead = card.querySelector<HTMLElement>("[data-winners-playhead]");
    const timeLabel = card.querySelector<HTMLElement>("[data-winners-time]");
    const rows = Array.from(card.querySelectorAll<HTMLElement>(".winner"));
    const audios: CardController["audios"] = [];

    rows.forEach((row) => {
      const btn = row.querySelector<HTMLButtonElement>(".winner-play");
      if (!btn) return;
      const url = btn.dataset.audioUrl || "";
      if (!url) return;
      const audio = new Audio();
      audio.preload = "auto";
      audio.src = url;
      audios.push({ row, btn, audio });
    });

    if (audios.length === 0) return;

    const ctrl: CardController = {
      card,
      audios,
      activeIndex: 0,
      wave,
      playhead,
      timeLabel,
      rafId: null,
      pause: () => {
        const a = ctrl.audios[ctrl.activeIndex]?.audio;
        if (a && !a.paused) a.pause();
        renderState();
      },
    };
    allControllers.push(ctrl);

    // Buffering state for this card (#1): true while the active take's first
    // byte / a re-buffer is in flight. Drives the play-button spinner (via
    // renderState) + the waveform shimmer.
    let buffering = false;
    function setBuffering(on: boolean) {
      buffering = on;
      if (ctrl.wave) {
        if (on) ctrl.wave.setAttribute("data-buffering", "true");
        else ctrl.wave.removeAttribute("data-buffering");
      }
      renderState();
    }

    function active(): HTMLAudioElement {
      return ctrl.audios[ctrl.activeIndex].audio;
    }

    function renderState() {
      const a = active();
      // Per-row button state + active-source halo. The active row shows a
      // spinner while buffering (#1), otherwise play/pause.
      ctrl.audios.forEach(({ row, btn }, i) => {
        const isActive = i === ctrl.activeIndex;
        btn.dataset.state = isActive
          ? (buffering ? "loading" : a.paused ? "paused" : "playing")
          : "paused";
        row.dataset.activeSource = isActive ? "true" : "false";
      });
      // Time label.
      if (ctrl.timeLabel) {
        const dur = a.duration;
        ctrl.timeLabel.textContent = `${fmtTimeOrDash(a.currentTime)} / ${fmtTimeOrDash(dur)}`;
      }
      // Playhead position. Always visible — at 0% when paused-at-zero,
      // moves as currentTime advances. The CSS rule keeps it shown even
      // when the legacy `hidden` attribute is set elsewhere.
      if (ctrl.playhead) {
        const dur = a.duration;
        const frac = dur && a.currentTime > 0
          ? Math.max(0, Math.min(1, a.currentTime / dur))
          : 0;
        ctrl.playhead.style.left = `${frac * 100}%`;
        ctrl.playhead.removeAttribute("hidden");
      }
    }

    function tick() {
      renderState();
      const a = active();
      if (a.paused) {
        ctrl.rafId = null;
        return;
      }
      ctrl.rafId = requestAnimationFrame(tick);
    }

    function swapTo(i: number, play = true) {
      const prev = active();
      const t = prev.currentTime;
      if (!prev.paused) prev.pause();
      ctrl.activeIndex = i;
      const next = active();
      try {
        next.currentTime = t;
      } catch {
        // currentTime can throw if metadata isn't loaded yet; ignore.
      }
      if (play) {
        setBuffering(true);
        next
          .play()
          .then(() => {
            pauseOtherCards(ctrl);
            activeCard = ctrl;
            if (ctrl.rafId == null) ctrl.rafId = requestAnimationFrame(tick);
          })
          .catch((e) => {
            console.warn("winners audio play failed", e);
            setBuffering(false);
            renderState();
          });
      }
      renderState();
    }

    function toggle() {
      const a = active();
      if (a.paused) {
        setBuffering(true);
        a.play()
          .then(() => {
            pauseOtherCards(ctrl);
            activeCard = ctrl;
            if (ctrl.rafId == null) ctrl.rafId = requestAnimationFrame(tick);
          })
          .catch((e) => { console.warn("winners audio play failed", e); setBuffering(false); });
      } else {
        a.pause();
      }
      renderState();
    }

    ctrl.audios.forEach(({ btn, audio }, i) => {
      btn.addEventListener("click", () => {
        if (i === ctrl.activeIndex) {
          toggle();
        } else {
          // Carry over the active position so the curator hears the SAME
          // moment in the new variant — the whole point of sync'd compare.
          swapTo(i, true);
        }
      });
      audio.addEventListener("ended", () => {
        if (i === ctrl.activeIndex) setBuffering(false);
        renderState();
      });
      // Playhead recovery net: the rAF `tick` loop self-stops on pause and is
      // otherwise only re-armed by explicit play() calls (toggle/swap/seek).
      // If playback resumes on its own after a buffer stall, `playing` fires
      // and we restart the loop; timeupdate also keeps the cursor advancing in
      // background tabs (where rAF is throttled) and revives a dead loop.
      audio.addEventListener("playing", () => {
        if (i !== ctrl.activeIndex) return;
        setBuffering(false); // first byte arrived / stall recovered (#1)
        if (ctrl.rafId == null) ctrl.rafId = requestAnimationFrame(tick);
      });
      // Buffering visuals (#1): spinner + waveform shimmer while the active
      // take's first byte / a re-buffer is in flight.
      audio.addEventListener("canplay", () => {
        if (i === ctrl.activeIndex) setBuffering(false);
      });
      audio.addEventListener("waiting", () => {
        if (i === ctrl.activeIndex) setBuffering(true);
      });
      audio.addEventListener("stalled", () => {
        if (i === ctrl.activeIndex) setBuffering(true);
      });
      audio.addEventListener("seeked", () => {
        if (i === ctrl.activeIndex) setBuffering(false);
      });
      audio.addEventListener("timeupdate", () => {
        if (i !== ctrl.activeIndex) return;
        renderState();
        if (ctrl.rafId == null && !audio.paused) {
          ctrl.rafId = requestAnimationFrame(tick);
        }
      });
    });

    // Click-to-seek on the waveform. Sets currentTime on every audio in
    // this card so a subsequent swap stays in sync. If metadata hasn't
    // loaded yet (`a.duration` is NaN), defer the seek to the next
    // `loadedmetadata` event so the curator's click isn't dropped.
    if (wave) {
      const applySeekFraction = (frac: number) => {
        const a = active();
        const dur = a.duration;
        if (!dur || !Number.isFinite(dur)) {
          const handler = () => {
            const dur2 = a.duration;
            if (dur2 && Number.isFinite(dur2)) {
              applySeekFraction(frac);
            }
            a.removeEventListener("loadedmetadata", handler);
          };
          a.addEventListener("loadedmetadata", handler);
          return;
        }
        const newTime = frac * dur;
        ctrl.audios.forEach(({ audio }) => {
          try {
            audio.currentTime = newTime;
          } catch {
            /* not yet loaded; ignore */
          }
        });
        if (a.paused) {
          a.play()
            .then(() => {
              pauseOtherCards(ctrl);
              activeCard = ctrl;
              if (ctrl.rafId == null) ctrl.rafId = requestAnimationFrame(tick);
            })
            .catch(() => {});
        }
        renderState();
      };
      wave.addEventListener("click", (e) => {
        const rect = wave.getBoundingClientRect();
        const x = (e as MouseEvent).clientX - rect.left;
        const frac = Math.max(0, Math.min(1, x / rect.width));
        applySeekFraction(frac);
      });
    }

    // Initial render so the time label shows "0:00 / —:—" until metadata
    // lands; loadedmetadata then re-renders with the real duration.
    renderState();
    active().addEventListener("loadedmetadata", renderState);
  });

  // Always-visible playhead: replace the old guarded show/hide with a
  // standing pin that just moves. The CSS counter-spec `[hidden]` rule
  // is overridden to keep it visible at 0% on paused-zero state. We
  // override renderState below by wrapping it via runtime monkey-patch
  // would be ugly; cleaner: every renderState call ALREADY sets left%,
  // and we leave the element visible. To do that without changing the
  // inner function, walk all playheads once and remove the `hidden`
  // attribute. From here on, only `display:none` via the data-collapsed
  // CSS rule hides them (which is what we want).
  document.querySelectorAll<HTMLElement>("[data-winners-playhead]").forEach((p) => {
    p.removeAttribute("hidden");
    p.style.left = "0%";
  });

  // ── Expand / collapse cards on header click ────────────────────────
  document.querySelectorAll<HTMLButtonElement>("[data-winners-toggle]").forEach((head) => {
    head.addEventListener("click", () => {
      const card = head.closest<HTMLElement>(".winners-card");
      if (!card) return;
      const wasCollapsed = card.dataset.collapsed === "true";
      card.dataset.collapsed = wasCollapsed ? "false" : "true";
      head.setAttribute("aria-expanded", String(wasCollapsed));
    });
  });

  // ── Champion crown (with optional feedback) ────────────────────────
  // Reads the per-card feedback textarea and forwards it as `comment`
  // so the planner sees the curator's reasoning alongside future
  // "Make more mixes" jobs. Page reloads on success so the king-mode
  // server-rendered shape replaces the voting-mode markup cleanly.
  //
  // Two crown shapes share this handler:
  //   - variant crown (data-champion-variant-id): standard king pick
  //   - ORIGINAL crown (data-champion-is-original="true"): declares the
  //     source beats every variant; the engine sets champion_is_original.
  //     Terminal — no new mixes are generated (the curator crowns ORIGINAL
  //     precisely because the variants are worse). spawn_more is omitted so
  //     the engine default (false) applies. The "+ Make more mixes" action
  //     remains available if they do want another batch.
  document.querySelectorAll<HTMLButtonElement>(".winner-crown").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const jobId = Number(btn.dataset.championJobId);
      const isOriginal = btn.dataset.championIsOriginal === "true";
      const card = btn.closest<HTMLElement>(".winners-card");
      const feedback = card?.querySelector<HTMLTextAreaElement>("[data-feedback-input]");
      const comment = feedback?.value?.trim() || null;
      btn.dataset.busy = "true";
      const body = isOriginal
        ? {
            job_id: jobId,
            variant_id: null,
            is_original: true,
            comment,
          }
        : {
            job_id: jobId,
            variant_id: Number(btn.dataset.championVariantId),
            comment,
          };
      const res = await fetch("/api/console/mix-champion", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify(body),
      });
      btn.dataset.busy = "false";
      if (!res.ok) {
        console.warn("set champion failed", res.status);
        return;
      }
      // Server-rendered re-render of the card (now in king mode) is
      // simpler than rebuilding the DOM client-side. ORIGINAL crowns are
      // terminal, so the reloaded card shows the ORIGINAL-king state with
      // no in-flight badge.
      location.reload();
    });
  });

  // ── King action strip: Make more / Publish / Uncrown / Dismiss ────
  document.querySelectorAll<HTMLButtonElement>(".winners-action-btn").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const action = btn.dataset.action;
      const jobId = Number(btn.dataset.jobId);
      const card = btn.closest<HTMLElement>(".winners-card");
      const feedback = card?.querySelector<HTMLTextAreaElement>("[data-feedback-input]");
      const feedbackText = feedback?.value?.trim() || null;
      btn.dataset.busy = "true";

      try {
        if (action === "make-more") {
          const sourceAssetId = Number(btn.dataset.sourceAssetId);
          const res = await fetch("/api/console/mix-jobs-create", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({
              source_asset_id: sourceAssetId,
              parent_job_id: jobId,
              feedback_text: feedbackText || "(continue refining)",
            }),
          });
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          location.reload();
        } else if (action === "publish-toggle") {
          const currentlyPublic = btn.dataset.currentlyPublic === "true";
          const res = await fetch("/api/console/mix-publish-king", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({
              job_id: jobId,
              publish: !currentlyPublic,
            }),
          });
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          location.reload();
        } else if (action === "uncrown") {
          const res = await fetch("/api/console/mix-champion", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({ job_id: jobId, variant_id: null }),
          });
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          location.reload();
        } else if (action === "dismiss") {
          const res = await fetch("/api/console/mix-dismiss", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({ job_id: jobId, dismissed: true }),
          });
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          location.reload();
        }
      } catch (e) {
        console.warn("[winners action]", action, "failed:", e);
        btn.dataset.busy = "false";
      }
    });
  });

  // ── Keyboard support for the focused winners card ─────────────────
  // Space toggles play/pause, ←/→ seek ±10s. Only intercepts when the
  // user isn't typing in an input/textarea AND a winners card is the
  // most-recently-active audio source. Otherwise lets pair-tinder
  // handlers above take their turn.
  document.addEventListener("keydown", (e) => {
    const target = e.target as HTMLElement | null;
    if (target && (target.tagName === "TEXTAREA" || target.tagName === "INPUT")) return;
    if (!activeCard) return;
    const a = activeCard.audios[activeCard.activeIndex]?.audio;
    if (!a) return;
    if (e.key === " " || e.code === "Space") {
      e.preventDefault();
      if (a.paused) {
        a.play().catch(() => {});
      } else {
        a.pause();
      }
    } else if (e.key === "ArrowLeft") {
      e.preventDefault();
      try { a.currentTime = Math.max(0, a.currentTime - 10); } catch {}
      activeCard.audios.forEach(({ audio }) => {
        try { audio.currentTime = a.currentTime; } catch {}
      });
    } else if (e.key === "ArrowRight") {
      e.preventDefault();
      const dur = a.duration;
      const t = Math.min(dur || a.currentTime + 10, a.currentTime + 10);
      try { a.currentTime = t; } catch {}
      activeCard.audios.forEach(({ audio }) => {
        try { audio.currentTime = a.currentTime; } catch {}
      });
    }
  });
</script>

{/* Phase B: project ↔ track actions on Winners cards. Isolated IIFE so it
    can't collide with the page's main module script (see System &
    Automation Known limits: duplicate top-level decls abort an Astro
    module silently). Event-delegated off document. */}
<script>
  (() => {
    async function postJSON(url: string, body: unknown) {
      const res = await fetch(url, {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify(body),
      });
      return res;
    }

    async function openProject(projectId: number, btn: HTMLButtonElement) {
      const orig = btn.textContent;
      btn.disabled = true;
      btn.textContent = "opening…";
      try {
        const res = await postJSON("/api/console/projects-open", { project_asset_id: projectId });
        if (res.ok) {
          btn.textContent = "✓ opened on M3";
          setTimeout(() => { btn.textContent = orig; btn.disabled = false; }, 2500);
        } else {
          const e = await res.json().catch(() => ({}));
          alert("Open failed: " + JSON.stringify(e.error ?? e));
          btn.textContent = orig;
          btn.disabled = false;
        }
      } catch (err) {
        alert("Open failed: " + String(err));
        btn.textContent = orig;
        btn.disabled = false;
      }
    }

    async function linkFlow(sourceId: number) {
      const q = window.prompt(
        "Link this track to a project — type part of the .als name.\n(Leave blank to UNLINK.)",
      );
      if (q === null) return; // cancelled
      if (q.trim() === "") {
        await postJSON("/api/console/assets-link-project", {
          asset_id: sourceId,
          project_asset_id: null,
        });
        location.reload();
        return;
      }
      let hits: Array<{ asset_id: number; filename: string; display_name?: string | null }> = [];
      try {
        const res = await fetch(`/api/console/projects-search?q=${encodeURIComponent(q)}`);
        const data = await res.json();
        hits = data.projects ?? [];
      } catch {
        alert("Search failed.");
        return;
      }
      if (!hits.length) {
        alert("No projects matched “" + q + "”.");
        return;
      }
      const top = hits.slice(0, 8);
      const list = top
        .map((p, i) => `${i + 1}) ${(p.display_name || p.filename).replace(/\.als$/i, "")}`)
        .join("\n");
      const pick = window.prompt(`Pick a project:\n${list}\n\nEnter a number 1–${top.length}:`);
      if (pick === null) return;
      const idx = parseInt(pick, 10) - 1;
      if (!(idx >= 0 && idx < top.length)) {
        alert("Invalid choice.");
        return;
      }
      await postJSON("/api/console/assets-link-project", {
        asset_id: sourceId,
        project_asset_id: top[idx].asset_id,
      });
      location.reload();
    }

    document.addEventListener("click", (ev) => {
      const t = (ev.target as HTMLElement)?.closest<HTMLButtonElement>(
        "[data-project-icon]",
      );
      if (!t) return;
      ev.preventDefault();
      const sourceId = Number(t.getAttribute("data-source-asset-id"));
      const projAttr = t.getAttribute("data-project-asset-id") || "";
      const projectId = projAttr ? Number(projAttr) : null;
      const shift = (ev as MouseEvent).shiftKey;
      // Has a project + plain click → open in Ableton.
      // No project, or shift-click → link / change / unlink flow.
      if (projectId && !shift) {
        openProject(projectId, t);
      } else {
        linkFlow(sourceId);
      }
    });
  })();
</script>
