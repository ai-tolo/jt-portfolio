<script>
  // Pair-tinder controller. The pair surfaces a single shared waveform
  // (the source track's pre-rendered PNG) with one playhead. Two audio
  // elements hold the A and B variants and stay synced on currentTime;
  // toggling A/B is an instant swap, not a stop/restart, so the curator
  // hears the same moment in both versions. Click the waveform to seek,
  // arrows to step ±10s, space to play/pause.
  //
  // Audio is opus-transcoded via /api/console/asset?...&variant=opus.

  const audioA = new Audio();
  const audioB = new Audio();
  for (const a of [audioA, audioB]) {
    a.preload = "auto";
  }
  let activePairEl: HTMLElement | null = null;
  let currentSide: "a" | "b" = "a";
  let currentSolo: string | null = null;
  let playheadRaf: number | null = null;

  // Undo state. Remembers the most recent commit for a 5-second window so
  // ⌘Z / ⌃Z can withdraw the judgement and restore the pair we were on.
  // Only one commit is undo-able at a time — a second commit replaces the
  // window. Keeps the mental model simple.
  type UndoEntry = {
    judgementId: number;
    originalPair: HTMLElement;
    originalOpacity: string;
    originalCommitted: string;
    advancedTo: HTMLElement | null;
    expiresAt: number;
    timeoutId: number;
  };
  let pendingUndo: UndoEntry | null = null;
  const UNDO_WINDOW_MS = 5000;

  function showUndoToast(label: string, autoHideMs: number) {
    const node = document.querySelector<HTMLElement>("[data-undo-toast]");
    if (!node) return;
    node.textContent = label;
    node.hidden = false;
    if ((node as any)._hideTimer) {
      window.clearTimeout((node as any)._hideTimer);
    }
    (node as any)._hideTimer = window.setTimeout(() => {
      node.hidden = true;
      node.textContent = "";
    }, autoHideMs);
  }

  function clearPendingUndo() {
    if (pendingUndo) {
      window.clearTimeout(pendingUndo.timeoutId);
      pendingUndo = null;
    }
  }

  function armUndo(entry: Omit<UndoEntry, "expiresAt" | "timeoutId">, choiceLabel: string) {
    clearPendingUndo();
    const timeoutId = window.setTimeout(() => {
      pendingUndo = null;
      const node = document.querySelector<HTMLElement>("[data-undo-toast]");
      if (node) { node.hidden = true; node.textContent = ""; }
    }, UNDO_WINDOW_MS);
    pendingUndo = {
      ...entry,
      expiresAt: Date.now() + UNDO_WINDOW_MS,
      timeoutId,
    };
    showUndoToast(`${choiceLabel} · ⌘Z to undo`, UNDO_WINDOW_MS);
  }

  async function undoLastCommit() {
    const u = pendingUndo;
    if (!u) return;
    if (Date.now() > u.expiresAt) return;
    pendingUndo = null;
    window.clearTimeout(u.timeoutId);
    showUndoToast("undoing…", 4000);
    const res = await fetch("/api/console/mix-judgement-withdraw", {
      method: "POST",
      headers: { "content-type": "application/json" },
      body: JSON.stringify({ judgement_id: u.judgementId }),
    });
    if (!res.ok) {
      showUndoToast(`undo failed (HTTP ${res.status})`, 3000);
      return;
    }
    // Restore the pair we just judged.
    stopAll();
    if (u.advancedTo) {
      u.advancedTo.classList.remove("pair-active");
    }
    u.originalPair.style.opacity = u.originalOpacity;
    if (u.originalCommitted) {
      u.originalPair.dataset.committed = u.originalCommitted;
    } else {
      delete u.originalPair.dataset.committed;
    }
    // Always re-hide the retry zone on undo — if the curator wanted to
    // retry, they'd recommit with the (still-typed) comment.
    const zone = u.originalPair.querySelector<HTMLElement>("[data-retry-zone]");
    if (zone) zone.hidden = true;
    u.originalPair.classList.add("pair-active");
    setActivePair(u.originalPair);
    u.originalPair.scrollIntoView({ behavior: "smooth", block: "center" });
    showUndoToast("vote undone", 2200);
  }

  function urlForSide(pair: HTMLElement, side: "a" | "b"): string {
    if (!currentSolo) {
      return (side === "a" ? pair.dataset.urlA : pair.dataset.urlB) ?? "";
    }
    try {
      const json = side === "a" ? pair.dataset.stemUrlsA : pair.dataset.stemUrlsB;
      const map = JSON.parse(json || "{}") as Record<string, string>;
      // Fall back to bus URL if this side lacks the soloed stem (e.g. it
      // was muted in this variant's plan).
      return map[currentSolo] || (side === "a" ? pair.dataset.urlA : pair.dataset.urlB) || "";
    } catch {
      return (side === "a" ? pair.dataset.urlA : pair.dataset.urlB) ?? "";
    }
  }

  function refreshSoloBar(pair: HTMLElement) {
    pair.querySelectorAll<HTMLElement>("[data-solo-stem], [data-solo-full]").forEach((btn) => {
      let active = false;
      if (btn.hasAttribute("data-solo-full")) active = currentSolo === null;
      else active = btn.dataset.soloStem === currentSolo;
      if (active) btn.dataset.active = "true";
      else delete btn.dataset.active;
    });
  }

  function applyCurrentUrls(pair: HTMLElement, restartIfPlaying = true) {
    const t = activeAudio().currentTime;
    const wasPlaying = !activeAudio().paused;
    audioA.src = urlForSide(pair, "a");
    audioB.src = urlForSide(pair, "b");
    // Restore playhead position on both elements (they buffer-load
    // asynchronously; setting currentTime before metadata loads is silently
    // discarded, so set again after canplay).
    const restore = () => {
      try { audioA.currentTime = t; } catch {}
      try { audioB.currentTime = t; } catch {}
    };
    restore();
    audioA.addEventListener("loadedmetadata", restore, { once: true });
    audioB.addEventListener("loadedmetadata", restore, { once: true });
    if (wasPlaying && restartIfPlaying) {
      activeAudio().play().catch(() => {});
    }
  }

  function setSolo(stem: string | null) {
    const pair = activePairEl;
    if (!pair) return;
    if (currentSolo === stem) return;
    currentSolo = stem;
    refreshSoloBar(pair);
    applyCurrentUrls(pair);
  }

  function activePair(): HTMLElement | null {
    return document.querySelector<HTMLElement>(".pair-active");
  }

  function activeAudio(): HTMLAudioElement {
    return currentSide === "a" ? audioA : audioB;
  }

  function inactiveAudio(): HTMLAudioElement {
    return currentSide === "a" ? audioB : audioA;
  }

  function fmtTime(s: number): string {
    if (!Number.isFinite(s) || s < 0) return "0:00";
    const m = Math.floor(s / 60);
    const r = Math.floor(s % 60);
    return `${m}:${String(r).padStart(2, "0")}`;
  }

  // No-op since the now-playing line was removed from the pair foot in
  // the May 22 UI refresh. Kept as a defensive stub so older call sites
  // don't throw. Diagnostic text we'd have shown now goes to console.
  function setNowPlaying(_pair: HTMLElement, label: string) {
    if (label) console.debug("[engineer]", label);
  }

  function updateTime(pair: HTMLElement) {
    const a = activeAudio();
    const dur = Number(pair.dataset.duration || a.duration || 0);
    const node = pair.querySelector<HTMLElement>("[data-time]");
    if (node) {
      node.textContent = `${fmtTime(a.currentTime)} / ${fmtTime(dur)}`;
    }
    const ph = pair.querySelector<HTMLElement>("[data-playhead]");
    if (ph && dur > 0) {
      ph.hidden = false;
      ph.style.left = `${Math.min(100, (a.currentTime / dur) * 100)}%`;
    }
  }

  function tickPlayhead() {
    const pair = activePairEl;
    if (!pair) return;
    updateTime(pair);
    playheadRaf = requestAnimationFrame(tickPlayhead);
  }

  function startTicking() {
    if (playheadRaf !== null) return;
    playheadRaf = requestAnimationFrame(tickPlayhead);
  }

  function stopTicking() {
    if (playheadRaf !== null) {
      cancelAnimationFrame(playheadRaf);
      playheadRaf = null;
    }
  }

  function setPlayButton(pair: HTMLElement, state: "playing" | "paused") {
    const btn = pair.querySelector<HTMLElement>("[data-toggle-play]");
    if (btn) btn.dataset.state = state;
  }

  function setActivePair(pair: HTMLElement) {
    activePairEl = pair;
    currentSide = (pair.dataset.side as "a" | "b") || "a";
    currentSolo = null;
    // Pause first so stale playback from the previous pair doesn't bleed
    // through during the src swap. Then assign and explicitly call
    // load() so the browser begins fetching immediately (without this
    // some browsers wait for play() before kicking off the network
    // request, which adds a ~200ms gap on the first tap).
    audioA.pause();
    audioB.pause();
    audioA.src = pair.dataset.urlA || "";
    audioB.src = pair.dataset.urlB || "";
    audioA.load();
    audioB.load();
    audioA.currentTime = 0;
    audioB.currentTime = 0;
    setPlayButton(pair, "paused");
    updateTime(pair);
    reflectSide(pair, currentSide);
    refreshSoloBar(pair);
  }

  function reflectSide(pair: HTMLElement, side: "a" | "b") {
    pair.dataset.side = side;
    pair.querySelectorAll<HTMLElement>("[data-side-btn]").forEach((btn) => {
      btn.classList.toggle("ab-side-active", btn.dataset.sideBtn === side);
    });
    const label = pair.querySelector<HTMLElement>(`[data-side-btn="${side}"] .ab-label`);
    setNowPlaying(pair, `now playing: ${side.toUpperCase()} · ${label?.textContent ?? ""}`);
  }

  async function togglePlay() {
    const pair = activePairEl;
    if (!pair) return;
    const a = activeAudio();
    if (a.paused) {
      try {
        await a.play();
        setPlayButton(pair, "playing");
        startTicking();
      } catch (e) {
        setNowPlaying(pair, `play failed: ${(e as Error).message ?? e}`);
      }
    } else {
      a.pause();
      setPlayButton(pair, "paused");
      stopTicking();
    }
  }

  function switchSide(side: "a" | "b") {
    const pair = activePairEl;
    if (!pair) return;
    // Tapping the already-active side toggles playback on it. That makes
    // A/B do double-duty as side selectors AND a "start listening" gesture
    // when the pair was paused (which is the default state after a pair
    // change).
    if (side === currentSide) {
      const a = activeAudio();
      if (a.paused) {
        a.play().then(() => {
          setPlayButton(pair, "playing");
          startTicking();
        }).catch(() => {});
      }
      return;
    }
    const prev = activeAudio();
    const t = prev.currentTime;
    prev.pause();
    currentSide = side;
    const next = activeAudio();
    next.currentTime = t;
    reflectSide(pair, side);
    // Always play after a side switch — tapping A or B is the natural
    // "start playing this version" gesture in a tinder-style UI.
    next.play().then(() => {
      setPlayButton(pair, "playing");
      startTicking();
    }).catch(() => {});
  }

  function seekTo(seconds: number) {
    const pair = activePairEl;
    if (!pair) return;
    const dur = Number(pair.dataset.duration || activeAudio().duration || 0);
    const t = Math.max(0, Math.min(dur || Infinity, seconds));
    audioA.currentTime = t;
    audioB.currentTime = t;
    updateTime(pair);
  }

  function skipBy(delta: number) {
    seekTo(activeAudio().currentTime + delta);
  }

  function seekFromClick(e: MouseEvent) {
    const pair = activePairEl;
    if (!pair) return;
    const wave = pair.querySelector<HTMLElement>("[data-stage-waveform]");
    if (!wave) return;
    const rect = wave.getBoundingClientRect();
    const fraction = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
    const dur = Number(pair.dataset.duration || activeAudio().duration || 0);
    if (dur > 0) seekTo(fraction * dur);
  }

  function stopAll() {
    audioA.pause();
    audioB.pause();
    audioA.currentTime = 0;
    audioB.currentTime = 0;
    stopTicking();
  }

  function getComment(pair: HTMLElement): string {
    const ta = pair.querySelector<HTMLTextAreaElement>("[data-comment]");
    return ta?.value.trim() ?? "";
  }

  async function commit(pair: HTMLElement, choice: "a" | "b" | "skip") {
    // Capture playback state BEFORE we stop both audios so advancePair
    // can decide whether to keep the listening session going on the next
    // pair (matches the tinder feel of "I'm in flow, keep me there").
    const wasPlaying = !audioA.paused || !audioB.paused;
    // Capture undo seed BEFORE we mutate anything so an undo can fully
    // restore the state of this pair.
    const originalOpacity = pair.style.opacity;
    const originalCommitted = pair.dataset.committed ?? "";
    stopAll();
    setPlayButton(pair, "paused");
    pair.dataset.continuePlayback = wasPlaying ? "true" : "false";
    const jobId = Number(pair.dataset.jobId);
    const axis = pair.dataset.axis ?? null;
    const aId = Number(pair.dataset.a);
    const bId = Number(pair.dataset.b);
    const chosen = choice === "a" ? aId : choice === "b" ? bId : null;
    const comment = getComment(pair);
    setNowPlaying(pair, "recording…");
    const res = await fetch("/api/console/mix-judgement", {
      method: "POST",
      headers: { "content-type": "application/json" },
      body: JSON.stringify({
        job_id: jobId,
        variant_a_id: aId,
        variant_b_id: bId,
        chosen_variant_id: chosen,
        axis,
        comment: comment || null,
      }),
    });
    if (!res.ok) {
      setNowPlaying(pair, `judgement failed: HTTP ${res.status}`);
      return;
    }
    const judgementBody = await res.json() as { judgement_id: number; ok: boolean };
    const choiceLabel =
      choice === "skip" ? "skipped" :
      choice === "a" ? "voted A" : "voted B";

    // If the curator left a comment, surface the retry-this-axis CTA in
    // place; otherwise advance to the next pair immediately.
    if (comment) {
      const zone = pair.querySelector<HTMLElement>("[data-retry-zone]");
      const msg = pair.querySelector<HTMLElement>("[data-retry-msg]");
      if (zone) zone.hidden = false;
      if (msg) msg.textContent = `recorded: "${comment.slice(0, 80)}${comment.length > 80 ? "…" : ""}"`;
      pair.dataset.committed = "true";
      setNowPlaying(pair, "");
      armUndo({
        judgementId: judgementBody.judgement_id,
        originalPair: pair,
        originalOpacity,
        originalCommitted,
        advancedTo: null,
      }, choiceLabel);
      return;
    }
    // Capture the about-to-be-active next pair reference for undo before
    // advancePair fires.
    const nextPair = pair.nextElementSibling as HTMLElement | null;
    const advancedTo = nextPair?.matches?.(".pair") ? nextPair : null;
    advancePair(pair);
    armUndo({
      judgementId: judgementBody.judgement_id,
      originalPair: pair,
      originalOpacity,
      originalCommitted,
      advancedTo,
    }, choiceLabel);
  }

  function advancePair(pair: HTMLElement) {
    const continuePlayback = pair.dataset.continuePlayback === "true";
    stopAll();
    pair.classList.remove("pair-active");
    pair.style.opacity = "0.35";
    const next = pair.nextElementSibling as HTMLElement | null;
    if (next?.matches?.(".pair")) {
      next.classList.add("pair-active");
      setActivePair(next);
      next.scrollIntoView({ behavior: "smooth", block: "center" });
      // If the curator was actively listening, keep them listening — start
      // the next pair's A side automatically so flow isn't broken.
      if (continuePlayback) {
        audioA.play().then(() => {
          setPlayButton(next, "playing");
          startTicking();
        }).catch(() => {
          // Browser blocked autoplay (rare since this trace from a real
          // user-gesture commit). Curator hits A or play to resume.
        });
      }
    } else {
      window.location.reload();
    }
  }

  async function retryAxis(pair: HTMLElement) {
    const sourceAssetId = Number(pair.dataset.sourceAssetId);
    const jobId = Number(pair.dataset.jobId);
    const axis = pair.dataset.axis ?? null;
    const feedback = getComment(pair);
    if (!sourceAssetId || !axis || !feedback) return;
    const btn = pair.querySelector<HTMLButtonElement>("[data-retry]");
    const msg = pair.querySelector<HTMLElement>("[data-retry-msg]");
    if (btn) btn.dataset.busy = "true";
    if (msg) msg.textContent = "queueing retry…";
    const res = await fetch("/api/console/mix-jobs-create", {
      method: "POST",
      headers: { "content-type": "application/json" },
      body: JSON.stringify({
        source_asset_id: sourceAssetId,
        retry_axis: axis,
        feedback_text: feedback,
        parent_job_id: jobId,
      }),
    });
    if (!res.ok) {
      if (msg) msg.textContent = `retry failed: HTTP ${res.status}`;
      if (btn) btn.dataset.busy = "";
      return;
    }
    const data = (await res.json()) as { job_id: number };
    if (msg) {
      msg.textContent = `retry queued (job ${data.job_id}). New variants for ${axis} will appear in ~5 min on reload.`;
    }
    if (btn) {
      btn.disabled = true;
      btn.dataset.busy = "";
      btn.textContent = `RETRY QUEUED · job ${data.job_id}`;
    }
    // Auto-advance after a retry so the curator can keep judging while the
    // new variants render in the background.
    setTimeout(() => advancePair(pair), 1600);
  }

  // Hold-to-vote / hold-to-skip mechanics. Mirrors the buckets card
  // trash-hold pattern: 450ms press fills a power-up bar; release before
  // the bar finishes is a tap (passes through to the existing click
  // handler for the side switch). Release after fills the bar fires
  // commit and suppresses the trailing click so we don't double-trigger
  // switchSide right after committing.
  const HOLD_MS = 450;
  const HOLD_CLICK_SUPPRESS_MS = 220;
  let holdTimer: number | null = null;
  let holdButton: HTMLElement | null = null;
  let lastHoldCommitAt = 0;

  function cancelHold() {
    if (holdTimer !== null) {
      window.clearTimeout(holdTimer);
      holdTimer = null;
    }
    if (holdButton) {
      holdButton.removeAttribute("data-holding");
      holdButton = null;
    }
  }

  function startHold(btn: HTMLElement, choice: "a" | "b" | "skip") {
    if (holdTimer !== null) return;
    const pair = btn.closest<HTMLElement>(".pair");
    if (!pair) return;
    if (pair.dataset.committed === "true" && choice !== "skip") return;
    holdButton = btn;
    btn.setAttribute("data-holding", "true");
    holdTimer = window.setTimeout(() => {
      holdTimer = null;
      lastHoldCommitAt = Date.now();
      btn.removeAttribute("data-holding");
      holdButton = null;
      commit(pair, choice);
    }, HOLD_MS);
  }

  document.addEventListener("pointerdown", (e) => {
    const target = e.target as HTMLElement;
    const holdBtn = target.closest<HTMLElement>("[data-hold]");
    if (!holdBtn) return;
    const choice = holdBtn.dataset.hold;
    if (choice !== "a" && choice !== "b" && choice !== "skip") return;
    startHold(holdBtn, choice);
  });

  document.addEventListener("pointerup", () => cancelHold());
  document.addEventListener("pointercancel", () => cancelHold());
  document.addEventListener("pointerleave", () => cancelHold(), true);
  // Cancel hold if the pointer leaves the specific button (delegated).
  document.addEventListener("pointerout", (e) => {
    const target = e.target as HTMLElement;
    if (!holdButton) return;
    if (target.closest("[data-hold]") === holdButton) {
      const related = (e as PointerEvent).relatedTarget as HTMLElement | null;
      if (!related || related.closest("[data-hold]") !== holdButton) {
        cancelHold();
      }
    }
  });

  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    const ap = activePair();
    if (!ap) return;

    // Transport: skip ±N, toggle play
    const skip = target.closest<HTMLElement>("[data-skip]");
    if (skip) {
      skipBy(Number(skip.dataset.skip));
      return;
    }
    if (target.closest("[data-toggle-play]")) {
      togglePlay();
      return;
    }

    // A/B switch — tap behavior. Suppress when the click immediately
    // follows a hold-commit so we don't switch playback to the variant
    // the curator just voted on/off the queue.
    const sideBtn = target.closest<HTMLElement>("[data-side-btn]");
    if (sideBtn) {
      if (Date.now() - lastHoldCommitAt < HOLD_CLICK_SUPPRESS_MS) return;
      switchSide(sideBtn.dataset.sideBtn as "a" | "b");
      return;
    }

    // Click anywhere on the waveform = seek
    if (target.closest("[data-stage-waveform]")) {
      seekFromClick(e);
      return;
    }

    // Solo bar: stem-name pill or FULL MIX restore
    const soloFull = target.closest<HTMLElement>("[data-solo-full]");
    if (soloFull) {
      setSolo(null);
      return;
    }
    const soloStem = target.closest<HTMLElement>("[data-solo-stem]");
    if (soloStem) {
      const next = soloStem.dataset.soloStem ?? null;
      setSolo(currentSolo === next ? null : next);
      return;
    }

    // Retry zone: NEXT PAIR (data-pick="next") + retry CTA. The old
    // SKIP / PICK A / PICK B buttons were removed in the May 22 UI
    // refresh - hold A/B/× handles those now.
    const pickBtn = target.closest<HTMLElement>("[data-pick]");
    if (pickBtn) {
      const pair = pickBtn.closest<HTMLElement>(".pair");
      if (!pair) return;
      const choice = pickBtn.dataset.pick;
      if (choice === "next") {
        advancePair(pair);
        return;
      }
    }
    const retryBtn = target.closest<HTMLElement>("[data-retry]");
    if (retryBtn) {
      const pair = retryBtn.closest<HTMLElement>(".pair");
      if (!pair) return;
      retryAxis(pair);
    }
  });

  document.addEventListener("keydown", (e) => {
    // ⌘Z / ⌃Z = undo last commit. Works even when focus is in the comment
    // textarea so accidental commits can be retracted without losing your
    // typed notes. Shift+⌘Z is reserved for the browser's redo so we
    // explicitly don't claim it.
    const isUndo =
      (e.metaKey || e.ctrlKey) && !e.shiftKey && e.key.toLowerCase() === "z";
    if (isUndo) {
      if (pendingUndo) {
        e.preventDefault();
        undoLastCommit();
      }
      return;
    }
    // Ignore other shortcuts when typing in inputs.
    const tag = (document.activeElement?.tagName ?? "").toLowerCase();
    if (tag === "input" || tag === "textarea") return;
    const pair = activePair();
    if (!pair) return;
    const k = e.key.toLowerCase();
    if (pair.dataset.committed === "true") {
      if (k === "n" || k === "enter") { e.preventDefault(); advancePair(pair); }
      return;
    }
    // A/B switch (instant, doesn't commit). Arrow keys seek ±10s.
    // Enter commits the currently-playing side as the vote. Escape skips.
    // Space play/pause + 1/2 pick + S skip were removed in the May 22
    // refresh in favor of the visible hold-to-vote / hold-to-skip UI.
    if (k === "a") { e.preventDefault(); switchSide("a"); }
    else if (k === "b") { e.preventDefault(); switchSide("b"); }
    else if (k === "arrowleft") { e.preventDefault(); skipBy(-10); }
    else if (k === "arrowright") { e.preventDefault(); skipBy(10); }
    else if (k === "enter") { e.preventDefault(); commit(pair, currentSide); }
    else if (k === "escape") { e.preventDefault(); commit(pair, "skip"); }
  });

  for (const a of [audioA, audioB]) {
    a.addEventListener("ended", () => {
      const pair = activePairEl;
      if (pair) setPlayButton(pair, "paused");
      stopTicking();
    });
    a.addEventListener("loadedmetadata", () => {
      const pair = activePairEl;
      if (pair) updateTime(pair);
    });
  }

  // Initialize: first .pair-active becomes the active pair.
  const initial = activePair();
  if (initial) setActivePair(initial);
</script>
