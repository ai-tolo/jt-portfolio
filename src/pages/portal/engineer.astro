---
import PortalLayout from "../../layouts/PortalLayout.astro";
import { listMixJobs, listMixPairs } from "../../lib/console-api";
import type {
  MixJobSummary,
  MixJobStatus,
  MixPairItem,
} from "../../lib/console-types";

// Engineer (Build 5) lobby page. Lists mix jobs by status and surfaces
// A/B pairs awaiting judgement. Phase 0 lands the lifecycle plumbing
// (queue, worker, status tracking); Phase 1 fills in real variant
// rendering, at which point the "Pair Tinder" section becomes live.
//
// Graceful fallback when the engine is unreachable: page renders with
// empty buckets + a small notice, mirroring rotation.astro's pattern.

let jobs: MixJobSummary[] = [];
let pairs: MixPairItem[] = [];
let usingMock = true;
let fetchError: string | null = null;

try {
  const jobsRes = await listMixJobs(50);
  if (jobsRes.ok) {
    jobs = jobsRes.data.items;
    usingMock = false;
  } else {
    fetchError =
      jobsRes.error.kind === "http"
        ? `engine returned ${jobsRes.error.status}`
        : "engine unreachable";
  }
  // Bumped from 10 → 30 so multiple ready jobs surface their pairs at once.
  // The engine already orders ready jobs oldest-first, so newer renders
  // appear at the bottom of the page.
  const pairsRes = await listMixPairs(30);
  if (pairsRes.ok) pairs = pairsRes.data.items;
} catch (e) {
  fetchError = e instanceof Error ? e.message : "unknown error";
}

const ACTIVE: MixJobStatus[] = ["pending", "splitting_stems", "rendering"];
const TERMINAL_OK: MixJobStatus[] = ["ready", "complete", "noop_complete"];

const activeJobs = jobs.filter((j) => ACTIVE.includes(j.status));
const readyJobs = jobs.filter((j) => j.status === "ready");
const completedJobs = jobs.filter((j) =>
  ["complete", "noop_complete"].includes(j.status),
);
const errorJobs = jobs.filter((j) => j.status === "error");

const STATUS_LABEL: Record<MixJobStatus, string> = {
  pending: "queued",
  splitting_stems: "splitting stems",
  rendering: "rendering variants",
  ready: "ready to judge",
  complete: "all judgements collected",
  noop_complete: "Phase 0 noop · awaiting real renderer",
  error: "errored",
};

function jobTitle(j: MixJobSummary): string {
  return (
    j.source_display_name ||
    j.source_filename ||
    `asset ${j.source_asset_id}`
  );
}

function fmtTime(iso: string | null): string {
  if (!iso) return "—";
  const d = new Date(iso.replace(" ", "T") + (iso.endsWith("Z") ? "" : "Z"));
  if (Number.isNaN(d.getTime())) return iso;
  return d.toLocaleString("en-US", {
    month: "short",
    day: "numeric",
    hour: "numeric",
    minute: "2-digit",
  });
}

// Helper kept un-typed because Astro's template-body parser treats
// `<string, string>` generic syntax as a JSX tag and fails to compile
// when the function is invoked inside the .map() in the template.
function stemSoloUrls(sf) {
  if (!sf) return {};
  const out = {};
  for (const [name, path] of Object.entries(sf)) {
    out[name] = `/api/console/asset?path=${encodeURIComponent(path)}&variant=opus`;
  }
  return out;
}
---

<PortalLayout title="Engineer · Portal" current="engineer">
  <section class="engineer">
    <header class="intro">
      <h1>Engineer</h1>
      <p class="lede">
        Send a track here from <a href="/portal/buckets/tracks">Buckets</a>. The
        engineer-worker on M1 picks it up, renders A/B variants along three
        taste axes (focal, space, dynamics), and surfaces them below as pairs
        to judge. Phase 0 lands the lifecycle; renders go live in Phase 1.
      </p>
      {fetchError && (
        <p class="notice">Engine unreachable: {fetchError}. Showing empty state.</p>
      )}
    </header>

    <div class="cols">
      <section class="col">
        <h2>In flight <span class="count">{activeJobs.length}</span></h2>
        {activeJobs.length === 0 ? (
          <p class="empty">Nothing in flight.</p>
        ) : (
          <ul class="job-list">
            {activeJobs.map((j) => (
              <li class="job">
                <div class="job-title">{jobTitle(j)}</div>
                <div class="job-meta">
                  <span class={`status status-${j.status}`}>{STATUS_LABEL[j.status]}</span>
                  <span class="started">started {fmtTime(j.started_at)}</span>
                </div>
              </li>
            ))}
          </ul>
        )}
      </section>

      <section class="col">
        <h2>Ready to judge <span class="count">{readyJobs.length}</span></h2>
        {readyJobs.length === 0 ? (
          <p class="empty">No pairs awaiting judgement.</p>
        ) : (
          <ul class="job-list">
            {readyJobs.map((j) => (
              <li class="job">
                <div class="job-title">{jobTitle(j)}</div>
                <div class="job-meta">
                  <span class="status status-ready">{j.variant_count} variants · {j.judgement_count} judged</span>
                </div>
              </li>
            ))}
          </ul>
        )}
      </section>

      <section class="col">
        <h2>Completed <span class="count">{completedJobs.length}</span></h2>
        {completedJobs.length === 0 ? (
          <p class="empty">No completed jobs yet.</p>
        ) : (
          <ul class="job-list">
            {completedJobs.slice(0, 10).map((j) => (
              <li class="job">
                <div class="job-title">{jobTitle(j)}</div>
                <div class="job-meta">
                  <span class={`status status-${j.status}`}>{STATUS_LABEL[j.status]}</span>
                  <span class="finished">finished {fmtTime(j.finished_at)}</span>
                </div>
              </li>
            ))}
          </ul>
        )}
      </section>

      {errorJobs.length > 0 && (
        <section class="col col-error">
          <h2>Errored <span class="count">{errorJobs.length}</span></h2>
          <ul class="job-list">
            {errorJobs.map((j) => (
              <li class="job">
                <div class="job-title">{jobTitle(j)}</div>
                <div class="job-error">{j.error}</div>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>

    <section class="pair-tinder">
      <h2>
        Pair tinder
        <span class="hint">tap A/B to switch · hold A/B to vote · hold × to skip · ← → seek · ⌘Z undo</span>
        <span class="undo-toast" data-undo-toast aria-live="polite" hidden></span>
      </h2>
      {pairs.length === 0 ? (
        <p class="empty">
          No pairs to judge. Send a track from <a href="/portal/buckets/tracks">Buckets</a> and come back when its job is "ready to judge".
        </p>
      ) : (
        <ul class="pair-list">
          {pairs.map((p, i) => {
            const waveSrc = p.source_waveform_sha1
              ? `/api/console/waveform?sha1=${p.source_waveform_sha1}`
              : null;
            const aUrl = p.variant_a.asset_path
              ? `/api/console/asset?path=${encodeURIComponent(p.variant_a.asset_path)}&variant=opus`
              : "";
            const bUrl = p.variant_b.asset_path
              ? `/api/console/asset?path=${encodeURIComponent(p.variant_b.asset_path)}&variant=opus`
              : "";
            // Build a {stem_name: opus_url} map per side for solo playback.
            const stemUrlsA = stemSoloUrls(p.variant_a.stem_files);
            const stemUrlsB = stemSoloUrls(p.variant_b.stem_files);
            return (
              <li
                class={`pair${i === 0 ? " pair-active" : ""}`}
                data-pair
                data-job-id={p.job_id}
                data-axis={p.axis}
                data-a={p.variant_a.id}
                data-b={p.variant_b.id}
                data-source-asset-id={p.source_asset_id}
                data-duration={p.source_duration_seconds ?? ""}
                data-side="a"
                data-url-a={aUrl}
                data-url-b={bUrl}
                data-stem-urls-a={JSON.stringify(stemUrlsA)}
                data-stem-urls-b={JSON.stringify(stemUrlsB)}
              >
                <div class="pair-head">
                  <h3 class="pair-source">{p.job_source_display}</h3>
                  <button
                    type="button"
                    class="pair-skip-x"
                    data-hold="skip"
                    aria-label="Hold to skip this pair"
                    title="Hold to skip"
                  ><span class="hold-fill" aria-hidden="true"></span><span class="hold-glyph">×</span></button>
                </div>

                <div class="pair-stage">
                  <div class="pair-waveform" data-stage-waveform>
                    {waveSrc ? (
                      <img src={waveSrc} alt="" loading="lazy" />
                    ) : (
                      <div class="pair-waveform-fallback">no waveform for source</div>
                    )}
                    <div class="pair-playhead" data-playhead hidden></div>
                  </div>
                  <div class="pair-transport">
                    <button class="transport-btn" data-skip="-10" aria-label="Back 10 seconds">⏮</button>
                    <button class="transport-btn transport-play" data-toggle-play aria-label="Play / pause">▶</button>
                    <button class="transport-btn" data-skip="10" aria-label="Forward 10 seconds">⏭</button>
                    <span class="pair-time" data-time>0:00 / —:—</span>
                    <div class="ab-switch" role="group" aria-label="Switch between variant A and B. Tap to switch playback. Hold to vote.">
                      <button class="ab-side ab-side-active" data-side-btn="a" data-hold="a" title="Tap to switch · hold to vote A">
                        <span class="hold-fill" aria-hidden="true"></span>
                        <span class="ab-key">A</span>
                        <span class="ab-label">{p.variant_a.pole.replace(/_/g, " ")}</span>
                      </button>
                      <button class="ab-side" data-side-btn="b" data-hold="b" title="Tap to switch · hold to vote B">
                        <span class="hold-fill" aria-hidden="true"></span>
                        <span class="ab-key">B</span>
                        <span class="ab-label">{p.variant_b.pole.replace(/_/g, " ")}</span>
                      </button>
                    </div>
                  </div>

                  <div class="pair-translation">
                    {[
                      { side: "a" as const, variant: p.variant_a },
                      { side: "b" as const, variant: p.variant_b },
                    ].map(({ side, variant }) => {
                      const tr = variant.translation;
                      const flags = tr?.summary_flags ?? [];
                      return (
                        <div class={`translation-strip translation-${side}`} title={flags.length > 0 ? `translation flags for variant ${side.toUpperCase()}` : "translation check clean"}>
                          {flags.length === 0 ? (
                            <span class="translation-clean">✓ translates clean</span>
                          ) : (
                            flags.slice(0, 4).map((f) => (
                              <span class="translation-flag">⚠ {f}</span>
                            ))
                          )}
                          {flags.length > 4 && (
                            <span class="translation-more">+{flags.length - 4} more</span>
                          )}
                        </div>
                      );
                    })}
                  </div>

                  {(Object.keys(stemUrlsA).length > 0 || Object.keys(stemUrlsB).length > 0) && (
                    <div class="pair-solo-bar">
                      <span class="solo-bar-label">solo</span>
                      <button class="solo-btn solo-btn-full" data-solo-full data-active="true">FULL MIX</button>
                      {[...new Set([...Object.keys(stemUrlsA), ...Object.keys(stemUrlsB)])].map((stem) => (
                        <button class="solo-btn" data-solo-stem={stem}>{stem}</button>
                      ))}
                    </div>
                  )}

                  <div class="pair-reasoning">
                    {[
                      { side: "a" as const, variant: p.variant_a },
                      { side: "b" as const, variant: p.variant_b },
                    ].map(({ side, variant }) => {
                      const plan = variant.plan;
                      return (
                        <details class={`plan-card plan-${side}`} data-plan-side={side}>
                          <summary>
                            <span class="plan-side-tag">{side.toUpperCase()}</span>
                            <span class="plan-philosophy">
                              {plan?.philosophy_summary ?? "no plan recorded"}
                            </span>
                            <span class="plan-toggle">▾</span>
                          </summary>
                          {plan ? (
                            <div class="plan-body">
                              {Object.entries(plan.stems ?? {}).map(([name, stem]) => (
                                <div class="plan-stem">
                                  <div class="plan-stem-head">
                                    <span class="plan-stem-name">{name}</span>
                                    <span class="plan-stem-role">{stem.role}</span>
                                    {typeof stem.level_offset_db === "number" && stem.level_offset_db !== 0 && (
                                      <span class="plan-stem-level">
                                        {stem.level_offset_db > 0 ? "+" : ""}{stem.level_offset_db.toFixed(1)} dB
                                      </span>
                                    )}
                                  </div>
                                  {(stem.moves ?? []).length === 0 ? (
                                    <div class="plan-move plan-move-noop">left alone</div>
                                  ) : (
                                    <ul class="plan-moves">
                                      {stem.moves.map((m) => {
                                        const params: string[] = [];
                                        if (typeof m.freq_hz === "number") params.push(`${Math.round(m.freq_hz)}Hz`);
                                        if (typeof m.gain_db === "number") params.push(`${m.gain_db > 0 ? "+" : ""}${m.gain_db.toFixed(1)}dB`);
                                        if (typeof m.q === "number" && m.type !== "compressor") params.push(`Q${m.q.toFixed(2)}`);
                                        if (typeof m.threshold_db === "number") params.push(`thr ${m.threshold_db.toFixed(1)}dB`);
                                        if (typeof m.ratio === "number") params.push(`${m.ratio}:1`);
                                        if (typeof m.attack_ms === "number") params.push(`atk ${m.attack_ms}ms`);
                                        if (typeof m.release_ms === "number") params.push(`rel ${m.release_ms}ms`);
                                        if (typeof m.wet_level === "number") params.push(`wet ${m.wet_level.toFixed(2)}`);
                                        if (typeof m.room_size === "number") params.push(`room ${m.room_size.toFixed(2)}`);
                                        if (typeof m.drive_db === "number") params.push(`drive ${m.drive_db.toFixed(1)}dB`);
                                        if (typeof m.position === "number") params.push(`pan ${m.position.toFixed(2)}`);
                                        if (typeof m.width === "number") params.push(`width ${m.width.toFixed(2)}`);
                                        return (
                                          <li>
                                            <span class="plan-move-head">
                                              <span class="plan-move-type">{m.type.replace(/_/g, " ")}</span>
                                              {params.length > 0 && <span class="plan-move-params">{params.join(" · ")}</span>}
                                            </span>
                                            {m.reasoning && <span class="plan-move-why">{m.reasoning}</span>}
                                          </li>
                                        );
                                      })}
                                    </ul>
                                  )}
                                </div>
                              ))}
                              {(plan.relationships ?? []).length > 0 && (
                                <div class="plan-relationships">
                                  <div class="plan-stem-head">
                                    <span class="plan-stem-name">relationships</span>
                                  </div>
                                  <ul class="plan-moves">
                                    {plan.relationships.map((r) => (
                                      <li>
                                        <span class="plan-move-head">
                                          <span class="plan-move-type">{r.type.replace(/_/g, " ")}</span>
                                          <span class="plan-move-params">
                                            {r.trigger_stem ?? "?"} → {r.target_stem ?? "?"}
                                            {typeof r.amount_db === "number" && ` · ${r.amount_db.toFixed(1)}dB`}
                                          </span>
                                        </span>
                                        {r.reasoning && <span class="plan-move-why">{r.reasoning}</span>}
                                      </li>
                                    ))}
                                  </ul>
                                </div>
                              )}
                              {(plan.bus?.moves ?? []).length > 0 && (
                                <div class="plan-stem">
                                  <div class="plan-stem-head">
                                    <span class="plan-stem-name">bus</span>
                                    <span class="plan-stem-role">target {plan.bus.target_lufs} LUFS</span>
                                  </div>
                                  <ul class="plan-moves">
                                    {plan.bus.moves.map((m) => {
                                      const params: string[] = [];
                                      if (typeof m.freq_hz === "number") params.push(`${Math.round(m.freq_hz)}Hz`);
                                      if (typeof m.gain_db === "number") params.push(`${m.gain_db > 0 ? "+" : ""}${m.gain_db.toFixed(1)}dB`);
                                      if (typeof m.threshold_db === "number") params.push(`thr ${m.threshold_db.toFixed(1)}dB`);
                                      if (typeof m.ratio === "number") params.push(`${m.ratio}:1`);
                                      if (typeof m.drive_db === "number") params.push(`drive ${m.drive_db.toFixed(1)}dB`);
                                      return (
                                        <li>
                                          <span class="plan-move-head">
                                            <span class="plan-move-type">{m.type.replace(/_/g, " ")}</span>
                                            {params.length > 0 && <span class="plan-move-params">{params.join(" · ")}</span>}
                                          </span>
                                          {m.reasoning && <span class="plan-move-why">{m.reasoning}</span>}
                                        </li>
                                      );
                                    })}
                                  </ul>
                                </div>
                              )}
                              {((plan as any).sections ?? []).length > 0 && (
                                <div class="plan-stem">
                                  <div class="plan-stem-head">
                                    <span class="plan-stem-name">sections</span>
                                    <span class="plan-stem-role">{(plan as any).sections.length} per-section overrides</span>
                                  </div>
                                  <ul class="plan-moves">
                                    {(plan as any).sections.map((s: any) => {
                                      const stemOverrides = s.stems ? Object.entries(s.stems) : [];
                                      return (
                                        <li>
                                          <span class="plan-move-head">
                                            <span class="plan-move-type">{s.label ?? "section"}</span>
                                            <span class="plan-move-params">
                                              {typeof s.start_s === "number" ? `${s.start_s.toFixed(1)}-${s.end_s.toFixed(1)}s` : ""}
                                            </span>
                                          </span>
                                          {s.reasoning && <span class="plan-move-why">{s.reasoning}</span>}
                                          {stemOverrides.length > 0 && (
                                            <span class="plan-section-detail">
                                              {stemOverrides.map(([name, ov]: any) => {
                                                const d = ov.level_offset_delta_db;
                                                const ex = (ov.extra_moves ?? []).length;
                                                const parts: string[] = [];
                                                if (typeof d === "number" && d !== 0) parts.push(`${d > 0 ? "+" : ""}${d.toFixed(1)}dB`);
                                                if (ex > 0) parts.push(`+${ex} move${ex > 1 ? "s" : ""}`);
                                                return parts.length > 0
                                                  ? `${name}: ${parts.join(" · ")}`
                                                  : null;
                                              }).filter(Boolean).join("  ·  ")}
                                            </span>
                                          )}
                                        </li>
                                      );
                                    })}
                                  </ul>
                                </div>
                              )}
                            </div>
                          ) : null}
                        </details>
                      );
                    })}
                  </div>
                </div>

                <textarea
                  class="comment"
                  data-comment
                  rows="2"
                  placeholder="Notes (optional). What worked, what didn't, what you'd change."
                ></textarea>

                <div class="pair-retry" data-retry-zone hidden>
                  <span class="retry-msg" data-retry-msg></span>
                  <div class="retry-actions">
                    <button class="retry-btn retry-btn-secondary" data-pick="next">NEXT PAIR</button>
                    <button class="retry-btn" data-retry>TRY THIS AXIS AGAIN</button>
                  </div>
                </div>
              </li>
            );
          })}
        </ul>
      )}
    </section>
  </section>
</PortalLayout>

<style>
  .engineer {
    max-width: 1100px;
    margin: 0 auto;
    padding: 24px 16px 64px;
    color: var(--ink);
  }
  .intro h1 {
    font-size: 28px;
    margin: 0 0 6px;
    letter-spacing: 0.02em;
  }
  .lede {
    margin: 0 0 12px;
    opacity: 0.78;
    line-height: 1.45;
    max-width: 640px;
  }
  .lede a { color: var(--accent, currentColor); }
  .notice {
    font-size: 13px;
    color: #b54;
    background: rgba(181, 84, 68, 0.08);
    padding: 8px 12px;
    border-radius: 4px;
    margin: 8px 0 0;
  }
  .cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 16px;
    margin: 24px 0;
  }
  .col h2 {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin: 0 0 10px;
    opacity: 0.7;
  }
  .col .count {
    background: var(--ink);
    color: var(--ink-fg);
    padding: 1px 7px;
    border-radius: 99px;
    font-size: 11px;
    margin-left: 4px;
  }
  .col-error h2 { color: #b54; }
  .empty {
    font-size: 13px;
    opacity: 0.55;
    margin: 0;
  }
  .job-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .job {
    background: rgba(0,0,0,0.04);
    padding: 8px 10px;
    border-radius: 4px;
  }
  .job-title {
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 2px;
  }
  .job-meta {
    font-size: 11px;
    opacity: 0.6;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .status {
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .status-pending { color: #b85; }
  .status-splitting_stems, .status-rendering { color: #58a; }
  .status-ready { color: #5a8; }
  .status-noop_complete { color: #777; }
  .status-complete { color: #5a8; }
  .status-error { color: #b54; }
  .job-error {
    font-size: 12px;
    color: #b54;
    margin-top: 4px;
    word-break: break-word;
  }
  .pair-tinder {
    margin-top: 32px;
    padding-top: 20px;
    border-top: 1px solid rgba(0,0,0,0.08);
  }
  .pair-tinder h2 {
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin: 0 0 12px;
    display: flex;
    align-items: baseline;
    gap: 12px;
  }
  .pair-tinder h2 .hint {
    font-size: 10.5px;
    letter-spacing: 0.08em;
    opacity: 0.5;
    font-weight: 500;
  }
  /* Ephemeral toast that appears for ~5s after each commit. Tells the
     curator what was voted and reminds them of the ⌘Z undo affordance. */
  .pair-tinder h2 .undo-toast {
    font-size: 11px;
    letter-spacing: 0.04em;
    text-transform: none;
    font-weight: 600;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    color: #ffd28a;
    background: rgba(255, 184, 77, 0.12);
    border: 1px solid rgba(255, 184, 77, 0.42);
    padding: 4px 10px;
    border-radius: 999px;
    animation: undo-toast-pop 200ms ease-out;
  }
  .pair-tinder h2 .undo-toast[hidden] { display: none; }
  @keyframes undo-toast-pop {
    from { transform: translateY(-2px) scale(0.96); opacity: 0; }
    to { transform: translateY(0) scale(1); opacity: 1; }
  }
  .pair-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .pair {
    background: rgba(0,0,0,0.04);
    padding: 14px;
    border-radius: 6px;
    border: 1px solid transparent;
  }
  .pair-active {
    border-color: rgba(14, 196, 252, 0.4);
  }
  .pair-head {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }
  /* Title mirrors the Bucket card: italic monospace, ~17px, terminal-green
     so the eye lands on the source name first. No editing affordance and
     no border - this view is read-only. */
  .pair-source {
    margin: 0;
    flex: 1;
    min-width: 0;
    font: 700 17px/1.1 ui-monospace, SFMono-Regular, Menlo, monospace;
    font-style: italic;
    color: #00ff4d;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  /* .pair-axis removed in the May 22 refresh — the axis is already
     conveyed by the A/B button labels (e.g. "FORWARD BRIGHT" vs
     "RECESSED WARM" obviously implies the focal axis). Keeping the
     selector definition out so an accidental re-add doesn't restyle. */

  /* Hold-to-skip × — small square on the left of the pair head. Same
     hold pattern as the buckets trash-hold: data-holding="true" triggers
     a 0.45s CSS fill that visually fills the button as the curator commits
     to skipping. Tapping (release before 450ms) is a no-op. */
  .pair-skip-x {
    position: relative;
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    background: transparent;
    color: rgba(245, 241, 232, 0.55);
    border: 1px solid rgba(255, 110, 33, 0.32);
    border-radius: 4px;
    cursor: pointer;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    font: 700 16px/1 ui-sans-serif, system-ui, sans-serif;
    transition: color 160ms ease, border-color 160ms ease;
    touch-action: none; /* keep hold gesture intact on touch screens */
  }
  .pair-skip-x:hover {
    color: #ff6e21;
    border-color: #ff6e21;
  }
  /* Same radial-fill pattern as buckets' trash-hold but tuned to the
     smaller × button. The fill grows from the centre and reaches the
     button edges at exactly 0.45s, matching the A/B power-up so all
     three "hold to commit" actions share the same physical feel. */
  .pair-skip-x .hold-fill {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, #ff2761 0%, #ff6e21 70%);
    transform-origin: center;
    transform: scale(0);
    border-radius: 50%;
    opacity: 0;
    transition: none;
    pointer-events: none;
  }
  .pair-skip-x[data-holding="true"] .hold-fill {
    transform: scale(2.4);
    opacity: 1;
    transition: transform 0.45s ease-out, opacity 0.18s ease-out;
  }
  .pair-skip-x[data-holding="true"] {
    color: #0e0c14;
    border-color: #ff2761;
    box-shadow: 0 0 14px rgba(255, 39, 97, 0.55);
  }
  .pair-skip-x .hold-glyph {
    position: relative;
    z-index: 1;
  }
  .pair-stage {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .pair-waveform {
    position: relative;
    background: rgba(14, 196, 252, 0.05);
    border: 1px solid rgba(14, 196, 252, 0.18);
    border-radius: 4px;
    height: 96px;
    cursor: pointer;
    overflow: hidden;
  }
  .pair-waveform img {
    width: 100%;
    height: 100%;
    object-fit: fill;
    display: block;
    opacity: 0.78;
    pointer-events: none;
