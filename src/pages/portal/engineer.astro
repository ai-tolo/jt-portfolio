  /* ORIGINAL pill — promoted from <span> to <button> in Phase 5
     (2026-05-27). Hold-to-vote ORIGINAL using the same 650ms gesture
     vocabulary as A/B/skip. When data-kind="original" the pill is also
     the active playback indicator and gets amped scale + cream glow so
     "ORIGINAL is selected" reads as a deliberate choice, not a default
     fallback. data-kind="a"|"b" reflects what's playing (small/muted)
     while keeping the pill always available as the ORIGINAL-vote target. */
  .pair-now-side {
    position: relative;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 4px 8px;
    border-radius: 3px;
    background: rgba(245, 241, 232, 0.06);
    border: 1px solid rgba(245, 241, 232, 0.16);
    color: rgba(245, 241, 232, 0.7);
    flex-shrink: 0;
    cursor: pointer;
    overflow: hidden;
    touch-action: none;
    user-select: none;
    transition:
      background 140ms ease,
      color 140ms ease,
      border-color 140ms ease,
      box-shadow 140ms ease,
      transform 140ms ease;
  }
  .pair-now-side:hover {
    color: var(--ink);
    border-color: rgba(245, 241, 232, 0.4);
  }
  .pair-now-side[data-kind="a"] {
    background: rgba(14, 196, 252, 0.10);
    border-color: rgba(14, 196, 252, 0.35);
    color: #6fdfff;
  }
  .pair-now-side[data-kind="b"] {
    background: rgba(255, 59, 110, 0.10);
    border-color: rgba(255, 59, 110, 0.35);
    color: #ffb6c8;
  }
  /* Active state — ORIGINAL is the current playback. Cream/neutral
     amping so it reads as a peer of the cyan-A / pink-B active states. */
  .pair-now-side[data-kind="original"] {
    background: rgba(245, 241, 232, 0.18);
    border-color: rgba(245, 241, 232, 0.7);
    color: var(--ink);
    transform: scale(1.04);
    box-shadow:
      0 0 20px rgba(245, 241, 232, 0.28),
      0 0 0 2px rgba(245, 241, 232, 0.4),
      inset 0 0 10px rgba(255, 255, 255, 0.10);
  }
  /* Hold-to-vote power-up — same linear sweep as the A/B buttons but in
     cream so it coheres with the ORIGINAL pill's identity. Duration kept
     in lockstep with HOLD_MS in the controller below; change both
     together. */
  .pair-now-side .hold-fill {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background:
      linear-gradient(90deg, transparent 0%, transparent 82%,
                            rgba(255, 255, 255, 0.6) 96%,
                            rgba(255, 255, 255, 0.95) 100%),
      linear-gradient(90deg, rgba(245, 241, 232, 0.55) 0%, #fff8e6 100%);
    box-shadow:
      inset 0 0 16px rgba(255, 255, 255, 0.22),
      0 0 18px rgba(245, 241, 232, 0.55);
    transform-origin: left center;
    transform: scaleX(0);
    transition: none;
    pointer-events: none;
    z-index: 0;
  }
  .pair-now-side[data-holding="true"] .hold-fill {
    transform: scaleX(1);
    transition: transform 0.65s linear;
  }
  .pair-now-side[data-holding="true"] {
    color: #0d060f;
    border-color: rgba(245, 241, 232, 0.85);
  }
  .pair-now-side .now-side-label {
    position: relative;
    z-index: 1;
  }
  /* A/B switch fills the remaining row width so the buttons get big enough
     for the variant labels to read at a glance. A uses the M1 cyan, B uses
     the M3 pink (same tokens the StatusBar uses) so the two sides are
     immediately distinguishable even before the active highlight. */
  .ab-switch {
    display: flex;
    flex: 1;
    min-width: 220px;
    gap: 6px;
  }
  .ab-side {
    position: relative;
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: transparent;
    border: 1px solid;
    border-radius: 4px;
    padding: 12px 18px;
    cursor: pointer;
    font-family: inherit;
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-weight: 700;
    overflow: hidden;
    transition: background 140ms ease, color 140ms ease,
                border-color 140ms ease, transform 80ms ease;
    touch-action: none; /* preserve hold gesture on touch devices */
    user-select: none;
  }
  .ab-side:hover {
    transform: translateY(-1px);
  }
  /* Power-up fill — full-button width sweep in the button's own accent
     color (cyan for A, pink for B) with a bright white leading edge.
     Coheres with the button's identity instead of pasting a foreign
     bar on top, and stays visible against both inactive (transparent)
     and active (solid-color) states because the leading edge always
     contrasts. Linear timing so the curator gets honest, predictable
     progress feedback. Duration kept in lockstep with HOLD_MS below —
     change both together. */
  .ab-side .hold-fill {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    transform-origin: left center;
    transform: scaleX(0);
    transition: none;
    pointer-events: none;
    z-index: 2;
    overflow: hidden;
  }
  /* Blind voting (#4): one neutral hold-fill for all three takes — no per-side
     cyan/pink that would distinguish the chips. */
  .ab-side-blind .hold-fill {
    background:
      linear-gradient(90deg, transparent 0%, transparent 82%,
                            rgba(255, 255, 255, 0.55) 96%,
                            rgba(255, 255, 255, 0.9) 100%),
      linear-gradient(90deg, rgba(255, 150, 80, 0.5) 0%, #ffd23d 100%);
    box-shadow: inset 0 0 16px rgba(255, 255, 255, 0.22),
                0 0 18px rgba(255, 150, 80, 0.55);
  }
  .ab-side[data-holding="true"] .hold-fill {
    transform: scaleX(1);
    transition: transform 0.65s linear;
  }
  .ab-side[data-holding="true"] {
    box-shadow: inset 0 0 18px rgba(255, 255, 255, 0.18);
  }
  .ab-side .ab-key, .ab-side .ab-label {
    position: relative;
    z-index: 3;
  }
  /* Blind voting (#4): the three take-chips are visually IDENTICAL regardless
     of role, so neither position nor colour reveals which is the source or
     which reference each is. One neutral inactive look + one neutral active
     look (the active look is forced in the is:global block below, which also
     beats the dev-mode scoping quirk). */
  .ab-side-blind {
    color: #ece3f2;
    border-color: rgba(236, 227, 242, 0.30);
    background: rgba(236, 227, 242, 0.05);
  }
  .ab-side-blind:hover {
    border-color: rgba(236, 227, 242, 0.7);
    background: rgba(236, 227, 242, 0.13);
    color: #ffffff;
  }
  /* Card-wide ambient wash — identical for ANY active take so "no tint =
     original" can't leak. */
  .pair:has(.ab-side-blind.ab-side-active) {
    background: linear-gradient(
      180deg,
      rgba(255, 150, 80, 0.07),
      rgba(0, 0, 0, 0.04)
    );
    border-color: rgba(255, 180, 90, 0.34);
  }
  .ab-side {
    transition:
      background 140ms ease,
      color 140ms ease,
      border-color 140ms ease,
      box-shadow 140ms ease,
      transform 140ms ease,
      opacity 160ms ease,
      filter 160ms ease;
  }
  .ab-key {
    font-size: 15px;
    font-weight: 900;
    letter-spacing: 0.04em;
  }
  .ab-label {
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.08em;
  }
  /* Transport controls (skip/play/skip/time) shouldn't compete with the
     A/B switch for space — pin them to their natural width. */
  .pair-transport .transport-btn,
  .pair-transport .pair-time {
    flex-shrink: 0;
  }

  /* Solo bar — click a stem name to hear just that processed stem on both
     A and B sides. "FULL MIX" restores the bus output. Useful diagnostic
     for understanding what each stem chain actually does. */
  .pair-solo-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
    margin-top: 4px;
    padding: 4px 0;
  }
  .solo-bar-label {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.45;
    margin-right: 4px;
  }
  .solo-btn {
    background: transparent;
    color: rgba(245, 241, 232, 0.65);
    border: 1px solid rgba(245, 241, 232, 0.18);
    border-radius: 999px;
    padding: 5px 12px;
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: lowercase;
    cursor: pointer;
    font-family: inherit;
    transition: background 120ms ease, border-color 120ms ease, color 120ms ease;
  }
  .solo-btn:hover {
    color: var(--ink);
    border-color: rgba(245, 241, 232, 0.4);
  }
  .solo-btn[data-active="true"] {
    background: rgba(255, 184, 77, 0.16);
    border-color: #ffb84d;
    color: #ffd28a;
    box-shadow: 0 0 12px rgba(255, 184, 77, 0.25);
  }
  .solo-btn-full {
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  /* ORIGINAL pill — distinct slate-blue tone so it reads as "neither A
     nor B nor a stem" but rather as the source reference. */
  .solo-btn-original {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(245, 241, 232, 0.78);
    border-color: rgba(245, 241, 232, 0.32);
  }
  .solo-btn-original:hover {
    color: var(--ink);
    border-color: rgba(245, 241, 232, 0.55);
  }
  .solo-btn-original[data-active="true"] {
    background: rgba(245, 241, 232, 0.14);
    border-color: rgba(245, 241, 232, 0.72);
    color: var(--ink);
    box-shadow: 0 0 12px rgba(245, 241, 232, 0.18);
  }

  /* Translation flags now live inline inside each plan-card. A compact
     "⚠ N concerns" badge sits next to the philosophy text; expanding the
     plan card reveals the full list as orange chips. Keeps the per-side
     context tight to the variant it describes instead of taking its own
     row above the reasoning. */
  .plan-warnings {
    display: inline-block;
    margin-left: 8px;
    padding: 2px 8px;
    border-radius: 999px;
    background: rgba(255, 110, 33, 0.14);
    color: #ff8a3d;
    border: 1px solid rgba(255, 110, 33, 0.36);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.02em;
    white-space: nowrap;
    vertical-align: middle;
    cursor: help;
  }
  .plan-warnings-detail {
    padding: 8px 12px 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .plan-warning-chip {
    font-size: 10.5px;
    line-height: 1;
    padding: 4px 8px;
    border-radius: 999px;
    font-weight: 600;
    background: rgba(255, 110, 33, 0.12);
    color: #ff8a3d;
    border: 1px solid rgba(255, 110, 33, 0.32);
  }

  /* Reasoning panels — one collapsible disclosure per variant, themed to
     match the A/B switch (cyan for A, pink for B) so the curator's eye
     associates the plan text with the audio they just heard. */
  .pair-reasoning {
    margin-top: 4px;
  }
  /* Master-mode description: one shared toggle, both A+B expand together. (#5) */
  .pair-why {
    border: 1px solid rgba(245, 241, 232, 0.12);
    border-radius: 4px;
    background: rgba(0, 0, 0, 0.16);
    overflow: hidden;
  }
  .pair-why > summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 7px 10px;
    color: rgba(245, 241, 232, 0.6);
    font: 600 10.5px ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .pair-why > summary::-webkit-details-marker { display: none; }
  .pair-why[open] > summary {
    color: var(--ink);
    border-bottom: 1px solid rgba(245, 241, 232, 0.1);
  }
  .pair-why-caret { transition: transform 140ms ease; }
  .pair-why[open] .pair-why-caret { transform: rotate(180deg); }
  .pair-why-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: rgba(245, 241, 232, 0.08);
  }
  .pair-why-col {
    background: #130d18;
    padding: 9px 11px;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  .pair-why-col.plan-a { box-shadow: inset 3px 0 0 rgba(14, 196, 252, 0.5); }
  .pair-why-col.plan-b { box-shadow: inset 3px 0 0 rgba(255, 59, 110, 0.5); }
  .pair-why-head { display: flex; align-items: baseline; gap: 8px; }
  .pair-why-side { font: 800 12px ui-monospace, SFMono-Regular, Menlo, monospace; }
  .plan-a .pair-why-side { color: #6fdfff; }
  .plan-b .pair-why-side { color: #ffb6c8; }
  .pair-why-pole { font-size: 11px; color: rgba(245, 241, 232, 0.7); text-transform: capitalize; }
  .pair-why-ref { font-size: 12px; color: rgba(245, 241, 232, 0.85); }
  .pair-why-ref strong { color: #00ff4d; font-style: italic; }
  .pair-why-text { font-size: 11.5px; color: rgba(245, 241, 232, 0.6); line-height: 1.4; }
  .pair-why-qa {
    display: flex; flex-wrap: wrap; gap: 8px;
    font: 600 10px ui-monospace, SFMono-Regular, Menlo, monospace;
    color: rgba(245, 241, 232, 0.5); letter-spacing: 0.04em;
  }
  .pair-why-qa-warn { color: #ffb84d; }
  .pair-why-flags { display: flex; flex-wrap: wrap; gap: 4px; }
  .plan-card {
    background: rgba(0, 0, 0, 0.16);
    border: 1px solid;
    border-radius: 4px;
    padding: 0;
    font-size: 12px;
    line-height: 1.45;
    overflow: hidden;
  }
  .plan-a { border-color: rgba(14, 196, 252, 0.32); }
  .plan-b { border-color: rgba(255, 59, 110, 0.32); }
  .plan-card[open] {
    background: rgba(0, 0, 0, 0.28);
  }
  .plan-card summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    user-select: none;
  }
  .plan-card summary::-webkit-details-marker { display: none; }
  .plan-side-tag {
    flex-shrink: 0;
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.1em;
    padding: 3px 8px;
    border-radius: 3px;
  }
  .plan-a .plan-side-tag {
    background: rgba(14, 196, 252, 0.22);
    color: #0ec4fc;
  }
  .plan-b .plan-side-tag {
    background: rgba(255, 59, 110, 0.22);
    color: #ff3b6e;
  }
  .plan-philosophy {
    flex: 1;
    font-size: 12px;
    line-height: 1.4;
    color: rgba(245, 241, 232, 0.85);
  }
  .plan-toggle {
    flex-shrink: 0;
    opacity: 0.5;
    font-size: 12px;
    transition: transform 140ms ease;
  }
  .plan-card[open] .plan-toggle { transform: rotate(180deg); }
  .plan-body {
    padding: 0 12px 12px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .plan-stem, .plan-relationships {
    padding: 8px 10px;
    background: rgba(245, 241, 232, 0.03);
    border-radius: 3px;
    border-left: 2px solid rgba(245, 241, 232, 0.12);
  }
  .plan-a .plan-stem, .plan-a .plan-relationships {
    border-left-color: rgba(14, 196, 252, 0.5);
  }
  .plan-b .plan-stem, .plan-b .plan-relationships {
    border-left-color: rgba(255, 59, 110, 0.5);
  }
  .plan-stem-head {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 6px;
    flex-wrap: wrap;
  }
  .plan-stem-name {
    font-weight: 700;
    text-transform: uppercase;
    font-size: 10.5px;
    letter-spacing: 0.08em;
    color: var(--ink);
  }
  .plan-stem-role {
    font-size: 10.5px;
    opacity: 0.55;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  .plan-stem-level {
    font-size: 10.5px;
    font-weight: 700;
    color: #ffb84d;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  .plan-moves {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .plan-moves li {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .plan-move-head {
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
  }
  .plan-move-type {
    font-weight: 700;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink);
  }
  .plan-move-params {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 10.5px;
    color: rgba(245, 241, 232, 0.6);
  }
  .plan-move-why {
    font-size: 11.5px;
    line-height: 1.4;
    color: rgba(245, 241, 232, 0.7);
    font-style: italic;
  }
  .plan-move-noop {
    font-size: 11px;
    opacity: 0.45;
    font-style: italic;
  }
  .plan-section-detail {
    font-size: 10.5px;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    color: rgba(245, 241, 232, 0.55);
    padding-top: 2px;
  }
  /* Collapse to single column on narrower viewports. */
  @media (max-width: 720px) {
    .pair-why-grid { grid-template-columns: 1fr; }
  }
  /* Active-side panel gets a subtle ring so the eye is drawn to it. */
  .pair-active[data-side="a"] .plan-a {
    box-shadow: 0 0 0 1px rgba(14, 196, 252, 0.32) inset;
  }
  .pair-active[data-side="b"] .plan-b {
    box-shadow: 0 0 0 1px rgba(255, 59, 110, 0.32) inset;
  }
  .pick-btn {
    background: transparent;
    color: var(--ink);
    border: 1px solid rgba(245, 241, 232, 0.3);
    padding: 8px 14px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    border-radius: 3px;
    cursor: pointer;
    transition: background 120ms ease, border-color 120ms ease;
  }
  .pick-btn:hover {
    background: rgba(0, 255, 77, 0.1);
    border-color: #00ff4d;
    color: #00ff4d;
  }
  .pick-a:hover { color: #00ff4d; }
  .pick-b:hover { color: #00ff4d; }
  .pair-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 12px;
    font-size: 11px;
    gap: 10px;
    flex-wrap: wrap;
  }
  .pair-foot .now-playing { flex: 1; }
  .skip-btn {
    background: transparent;
    color: rgba(245, 241, 232, 0.5);
    border: 1px solid rgba(245, 241, 232, 0.18);
    padding: 5px 12px;
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.1em;
    border-radius: 3px;
    cursor: pointer;
  }
  .skip-btn:hover { color: #ff6e21; border-color: #ff6e21; }
  .now-playing {
    opacity: 0.55;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  .comment {
    width: 100%;
    margin-top: 12px;
    padding: 10px 12px;
    background: rgba(0, 0, 0, 0.18);
    border: 1px solid rgba(245, 241, 232, 0.12);
    border-radius: 4px;
    color: var(--ink);
    font-family: inherit;
    font-size: 13px;
    line-height: 1.4;
    resize: vertical;
    min-height: 48px;
    box-sizing: border-box;
  }
  .comment::placeholder {
    color: rgba(245, 241, 232, 0.35);
  }
  .comment:focus {
    outline: none;
    border-color: rgba(14, 196, 252, 0.4);
    background: rgba(0, 0, 0, 0.28);
  }
  .pair-retry {
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px dashed rgba(245, 241, 232, 0.12);
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .pair-retry[hidden] {
    display: none;
  }
  .retry-msg {
    font-size: 11px;
    opacity: 0.65;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    flex: 1;
    min-width: 0;
  }
  .retry-btn {
    background: rgba(255, 184, 77, 0.08);
    color: #ffb84d;
    border: 1px solid rgba(255, 184, 77, 0.42);
    padding: 8px 14px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    border-radius: 3px;
    cursor: pointer;
    transition: background 120ms ease, transform 120ms ease;
  }
  .retry-btn:hover {
    background: rgba(255, 184, 77, 0.18);
    color: #ffd28a;
    border-color: #ffd28a;
  }
  .retry-btn[data-busy="true"] {
    opacity: 0.6;
    cursor: progress;
  }
  .retry-actions {
    display: flex;
    gap: 8px;
    flex-shrink: 0;
  }
  .retry-btn-secondary {
    background: transparent;
    color: rgba(245, 241, 232, 0.6);
    border-color: rgba(245, 241, 232, 0.2);
  }
  .retry-btn-secondary:hover {
    background: rgba(245, 241, 232, 0.05);
    color: var(--ink);
    border-color: rgba(245, 241, 232, 0.4);
  }

  /* ── Winners (Phase 3, 2026-05-27) ───────────────────────────── */
  /* Per-job per-axis winners. Source row up top so the curator can A/B
     back to the original. Champion crown is a sticky cross-axis vote. */
  .winners {
    margin-top: 36px;
    padding-top: 22px;
    border-top: 1px solid rgba(0,0,0,0.08);
  }
  .winners h2 {
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin: 0 0 12px;
    display: flex;
    align-items: baseline;
    gap: 12px;
  }
  .winners h2 .hint {
    font-size: 10.5px;
    letter-spacing: 0.08em;
    opacity: 0.5;
    font-weight: 500;
    text-transform: none;
  }
  .winners-subhead {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    opacity: 0.55;
    margin: 24px 0 10px;
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .winners-subhead .hint {
    font-size: 10px;
    letter-spacing: 0.06em;
    opacity: 0.6;
    text-transform: none;
    font-weight: 500;
  }
  .winners-summary {
    font-size: 12px;
    opacity: 0.72;
    margin: 0;
  }
  .winners-summary-cta {
    opacity: 0.55;
    margin-left: 4px;
  }
  .winners-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .winners-card {
    background: rgba(0, 0, 0, 0.06);
    border: 1px solid rgba(245, 241, 232, 0.12);
    border-radius: 6px;
    padding: 14px;
  }
  /* Crowned cards wear a faint gold halo so the champion job stands out. */
  .winners-card-crowned {
    border-color: rgba(255, 184, 77, 0.42);
    box-shadow: 0 0 18px rgba(255, 184, 77, 0.10);
  }
  /* ORIGINAL is the king — the source beat every mix. A distinct cool/cream
     border (vs the variant-king gold) so it reads differently at a glance;
     these cards are also sorted to the bottom of the list (#2). */
  .winners-card[data-king-is-original="true"] {
    border-color: rgba(245, 241, 232, 0.5);
    box-shadow: 0 0 16px rgba(245, 241, 232, 0.12),
                inset 0 0 0 1px rgba(245, 241, 232, 0.06);
  }
  /* Published to Sounds → the expand chevron glows green (status as a visual
     cue, no inline "public" text needed) (#2). */
  .winners-card[data-king-public="true"] .winners-chevron {
    color: #00ff4d;
    text-shadow: 0 0 8px rgba(0, 255, 77, 0.7);
  }
  /* King-round candidates — subtle cyan edge so "3 fresh candidates to crown"
     reads as its own actionable state (#4). */
  .winners-card[data-is-king-round="true"] {
    border-color: rgba(14, 196, 252, 0.4);
  }
  /* Published is the loudest state — the whole card glows green (the chevron
     alone was too subtle), so "live on Sounds" is obvious at a glance. Placed
     last so it wins over the crowned-gold / original-cream borders. (#3) */
  .winners-card[data-king-public="true"] {
    border-color: rgba(0, 255, 77, 0.55);
    box-shadow: 0 0 22px rgba(0, 255, 77, 0.18),
                inset 0 0 0 1px rgba(0, 255, 77, 0.12);
  }
  /* Far-right action cluster in the card header: ↗ ⧉ ✕. (#2 · #4) */
  .winners-head-actions {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
  }
  .winners-hint-king {
    color: #ffd28a !important;
  }
  .winners-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 10px;
    flex-wrap: wrap;
  }
  .winners-source {
    margin: 0;
    flex: 1;
    min-width: 0;
    font: 700 17px/1.1 ui-monospace, SFMono-Regular, Menlo, monospace;
    font-style: italic;
    color: #00ff4d;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .winners-head-right {
    display: flex;
    gap: 10px;
    align-items: baseline;
    flex-shrink: 0;
  }
  .winners-axes {
    font: 600 10.5px ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: 0.08em;
    opacity: 0.6;
    text-transform: uppercase;
  }
  .winners-champion-tag {
    font: 700 10.5px ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: 0.06em;
    color: #ffd28a;
    background: rgba(255, 184, 77, 0.14);
    border: 1px solid rgba(255, 184, 77, 0.45);
    padding: 3px 9px;
    border-radius: 999px;
    text-transform: uppercase;
  }
  .winners-wave {
    position: relative;
    background: rgba(14, 196, 252, 0.04);
    border: 1px solid rgba(14, 196, 252, 0.14);
    border-radius: 4px;
    height: 56px;
    overflow: hidden;
    margin-bottom: 10px;
    cursor: pointer;
  }
  .winners-wave img {
    width: 100%;
    height: 100%;
    object-fit: fill;
    opacity: 0.58;
    display: block;
    pointer-events: none;
  }
  .winners-playhead {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 2px;
    background: #ff3b6e;
    box-shadow: 0 0 6px rgba(255, 59, 110, 0.7);
    pointer-events: none;
    transition: left 80ms linear;
    z-index: 1;
  }
  .winners-time {
    position: absolute;
    right: 8px;
    bottom: 6px;
    font: 600 10.5px ui-monospace, SFMono-Regular, Menlo, monospace;
    color: rgba(245, 241, 232, 0.7);
    background: rgba(0, 0, 0, 0.45);
    padding: 2px 6px;
    border-radius: 3px;
    letter-spacing: 0.04em;
    pointer-events: none;
  }
  /* The active audio source pulses faintly so the eye can find which
     row is "the one playing right now" while toggling between them. */
  .winner[data-active-source="true"] {
    background: rgba(14, 196, 252, 0.12);
    border-color: rgba(14, 196, 252, 0.5);
    box-shadow: inset 0 0 12px rgba(14, 196, 252, 0.10);
  }
  .winner-source[data-active-source="true"] {
    background: rgba(245, 241, 232, 0.12);
    border-color: rgba(245, 241, 232, 0.5);
    box-shadow: inset 0 0 12px rgba(245, 241, 232, 0.10);
  }
  .winner-row {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .winner {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 10px;
    background: rgba(245, 241, 232, 0.03);
    border: 1px solid rgba(245, 241, 232, 0.08);
    border-radius: 4px;
    transition: background 120ms ease, border-color 120ms ease;
  }
  .winner-source {
