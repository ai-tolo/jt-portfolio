  /* A/B switch fills the remaining row width so the buttons get big enough
     for the variant labels to read at a glance. A uses the M1 cyan, B uses
     the M3 pink (same tokens the StatusBar uses) so the two sides are
     immediately distinguishable even before the active highlight. */
  .ab-switch {
    display: flex;
