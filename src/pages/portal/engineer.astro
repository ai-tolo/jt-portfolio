---
import PortalLayout from "../../layouts/PortalLayout.astro";
import {
  listMixJobs,
  listMixPairs,
  listMixWinners,
} from "../../lib/console-api";
import type {
  MixJobSummary,
  MixJobStatus,
  MixPairItem,
  WinnersJob,
} from "../../lib/console-types";

// Engineer (Build 5) lobby page. Lists mix jobs by status and surfaces
// A/B pairs awaiting judgement. Phase 0 lands the lifecycle plumbing
// (queue, worker, status tracking); Phase 1 fills in real variant
// rendering, at which point the "Pair Tinder" section becomes live.
// Phase 3 (2026-05-27) replaces the Completed column with a Winners
// section — per-job per-axis winners with inline playback and a
// cross-axis champion pick.
//
// Graceful fallback when the engine is unreachable: page renders with
// empty buckets + a small notice, mirroring rotation.astro's pattern.

let jobs: MixJobSummary[] = [];
let pairs: MixPairItem[] = [];
let winners: WinnersJob[] = [];
let usingMock = true;
let fetchError: string | null = null;

try {
  const jobsRes = await listMixJobs(50);
  if (jobsRes.ok) {
    jobs = jobsRes.data.items;
    usingMock = false;
  } else {
    fetchError =
      jobsRes.error.kind === "http"
        ? `engine returned ${jobsRes.error.status}`
        : "engine unreachable";
  }
  // Bumped from 10 → 30 so multiple ready jobs surface their pairs at once.
  // The engine already orders ready jobs oldest-first, so newer renders
  // appear at the bottom of the page.
  const pairsRes = await listMixPairs(30);
  if (pairsRes.ok) pairs = pairsRes.data.items;
  // include_partial defaults to true so the curator sees in-progress
  // jobs alongside fully-decided ones.
  const winnersRes = await listMixWinners({ limit: 50 });
  if (winnersRes.ok) winners = winnersRes.data.items;
} catch (e) {
  fetchError = e instanceof Error ? e.message : "unknown error";
}

// Split winners into "complete" (all 3 axes) and "in progress" (1-2)
// so the top of the Winners section foregrounds the value-rich shape.
const completeWinners = winners.filter((w) => w.axes_decided >= 3);
const partialWinners = winners.filter((w) => w.axes_decided < 3);
const kingCount = winners.filter((w) => w.champion_variant_id !== null).length;
const readyToCrown = winners.filter(
  (w) => w.axes_decided >= 3 && w.champion_variant_id === null,
).length;

// Cluster Winners into stage groups so the list reads at a glance and
// PUBLISHED tracks group together (the Sounds page folded in here, 2026-06-03):
//   0 In progress (voting / ready-to-crown / king-round)
//   1 Crowned (a variant king, not yet published)
//   2 Published (live on the public /sounds route) — auto-grouped
//   3 Original wins (the source still beats every mix)
const winnerRank = (w: WinnersJob): number =>
  w.king_is_public ? 2
  : w.champion_is_original ? 3
  : w.champion_variant_id !== null ? 1
  : 0;
const WINNER_GROUP_LABEL: Record<number, string> = {
  0: "In progress",
  1: "Crowned",
  2: "Published",
  3: "Original wins",
};
const sortedWinners = [...winners].sort((a, b) => winnerRank(a) - winnerRank(b));

const AXIS_ORDER = ["focal", "space", "dynamics"] as const;

// Deterministic Fisher–Yates (seeded LCG) — stable per seed so a card's blind
// order doesn't reshuffle on every render, yet varies card-to-card. Used to
// shuffle the ORIGINAL in among the king candidates so the crown can't be
// biased by which slot is the source. (#4 blind voting)
function blindShuffle<T>(arr: T[], seed: number): T[] {
  const a = arr.slice();
  let s = ((seed % 2147483647) + 2147483647) % 2147483647 || 1;
  for (let i = a.length - 1; i > 0; i--) {
    s = (s * 48271) % 2147483647;
    const j = s % (i + 1);
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}
function winnerAudioUrl(asset_path: string | null): string {
  return asset_path
    ? `/api/console/asset?path=${encodeURIComponent(asset_path)}&variant=opus`
    : "";
}
function sourceAudioUrl(asset_path: string | null): string {
  return asset_path
    ? `/api/console/asset?path=${encodeURIComponent(asset_path)}&variant=opus`
    : "";
}

const ACTIVE: MixJobStatus[] = ["pending", "splitting_stems", "rendering"];
const TERMINAL_OK: MixJobStatus[] = ["ready", "complete", "noop_complete"];

const activeJobs = jobs.filter((j) => ACTIVE.includes(j.status));
const readyJobs = jobs.filter((j) => j.status === "ready");
const completedJobs = jobs.filter((j) =>
  ["complete", "noop_complete"].includes(j.status),
);
const errorJobs = jobs.filter((j) => j.status === "error");
// Only surface an error when it's ACTIONABLE: the source has no successful
// (ready/complete) job. A stale failure a later render already succeeded for is
// just noise (e.g. the pre-_ensure_wav .m4a "Format not recognised" jobs, since
// superseded) — hide it entirely so the count is never misleading. (#6)
const succeededSources = new Set(
  jobs
    .filter((j) => ["ready", "complete", "noop_complete"].includes(j.status))
    .map((j) => j.source_asset_id),
);
const actionableErrors = errorJobs.filter(
  (j) => !succeededSources.has(j.source_asset_id),
);

const STATUS_LABEL: Record<MixJobStatus, string> = {
  pending: "queued",
  splitting_stems: "splitting stems",
  rendering: "rendering variants",
  ready: "ready to judge",
  complete: "all judgements collected",
  noop_complete: "Phase 0 noop · awaiting real renderer",
  error: "errored",
};

function jobTitle(j: MixJobSummary): string {
  return (
    j.source_display_name ||
    j.source_filename ||
    `asset ${j.source_asset_id}`
  );
}

function fmtTime(iso: string | null): string {
  if (!iso) return "—";
  const d = new Date(iso.replace(" ", "T") + (iso.endsWith("Z") ? "" : "Z"));
  if (Number.isNaN(d.getTime())) return iso;
  return d.toLocaleString("en-US", {
    month: "short",
    day: "numeric",
    hour: "numeric",
    minute: "2-digit",
  });
}

// Helper kept un-typed because Astro's template-body parser treats
// `<string, string>` generic syntax as a JSX tag and fails to compile
// when the function is invoked inside the .map() in the template.
function stemSoloUrls(sf) {
  if (!sf) return {};
  const out = {};
  for (const [name, path] of Object.entries(sf)) {
    out[name] = `/api/console/asset?path=${encodeURIComponent(path)}&variant=opus`;
  }
  return out;
}
---

<PortalLayout title="Engineer · Portal" current="engineer">
  <section class="engineer">
    <header class="intro">
      <h1>Engineer</h1>
      <p class="lede">
        Send a track from <a href="/portal/buckets/all">Buckets</a>, vote on
        the pairs below, and crown a king mix in <a href="#winners">Winners</a>.
        Publish a king and it groups under <a href="#winners">Published in Winners</a>.
      </p>
      {fetchError && (
        <p class="notice">Engine unreachable: {fetchError}. Showing empty state.</p>
      )}
    </header>

    {/* The old in-flight / pairs / winners / errored status pills were
        removed — they duplicated the sections below and the counts read as
        misleading. Errors now surface ONLY when actionable: an unsuperseded
        failure, with a way to fix it (retry / dismiss). (#6) */}
    {actionableErrors.length > 0 && (
      <div class="engineer-errors" role="alert">
        <p class="engineer-errors-head">
          {actionableErrors.length} {actionableErrors.length === 1 ? "mix" : "mixes"} failed to render — retry or dismiss.
        </p>
        <ul class="engineer-errors-list">
          {actionableErrors.map((j) => (
            <li class="engineer-error-row" data-job-id={j.id}>
              <div class="engineer-error-meta">
                <span class="engineer-error-title">{jobTitle(j)}</span>
                <span class="engineer-error-reason" title={j.error ?? ""}>
                  {(j.error ?? "render failed").split("\n")[0].slice(0, 140)}
                </span>
              </div>
              <div class="engineer-error-actions">
                <button
                  class="winners-action-btn err-action"
                  type="button"
                  data-action="make-more"
                  data-job-id={j.id}
                  data-source-asset-id={j.source_asset_id}
                  title="Re-render this track from scratch (the .m4a transcode + master pipeline are fixed now)"
                >↻ Retry render</button>
                <button
                  class="winners-action-btn err-action err-dismiss"
                  type="button"
                  data-action="dismiss"
                  data-job-id={j.id}
                  title="Hide this failed job"
                >✕ Dismiss</button>
              </div>
            </li>
          ))}
        </ul>
      </div>
    )}

    <section class="pair-tinder">
      <h2>
        Mix Faceoff
        <span class="hint">tap A/B to switch · hold A/B/ORIGINAL to vote · hold × to skip · space play/pause · ← → seek</span>
      </h2>
      {pairs.length === 0 ? (
        <p class="empty">
          No pairs to judge. Send a track from <a href="/portal/buckets/tracks">Buckets</a> and come back when its job is "ready to judge".
        </p>
      ) : (
        <ul class="pair-list">
          {pairs.map((p, i) => {
            const waveSrc = p.source_waveform_sha1
              ? `/api/console/waveform?sha1=${p.source_waveform_sha1}`
              : null;
            const aUrl = p.variant_a.asset_path
              ? `/api/console/asset?path=${encodeURIComponent(p.variant_a.asset_path)}&variant=opus`
              : "";
            const bUrl = p.variant_b.asset_path
              ? `/api/console/asset?path=${encodeURIComponent(p.variant_b.asset_path)}&variant=opus`
              : "";
            // Build a {stem_name: opus_url} map per side for solo playback.
            const stemUrlsA = stemSoloUrls(p.variant_a.stem_files);
            const stemUrlsB = stemSoloUrls(p.variant_b.stem_files);
            // Blind voting: present the three takes (variant A / variant B /
            // ORIGINAL) as identical, numbered chips in a per-pair-shuffled
            // order, so neither the source nor any reference's reputation can
            // bias the vote. The role wiring (data-side-btn / data-now-side /
            // data-hold) is unchanged, so the server still records the true
            // variant_a_id / variant_b_id / chose_original. Identities are
            // revealed only in the opt-in "reveal" toggle and after a crown.
            const BLIND_PERMS = [
              ["a", "b", "o"], ["a", "o", "b"], ["b", "a", "o"],
              ["b", "o", "a"], ["o", "a", "b"], ["o", "b", "a"],
            ] as const;
            const blindOrder = BLIND_PERMS[((p.job_id % 6) + 6) % 6];
            const blindMeta = {
              a: { role: "a", pole: p.variant_a.pole as string | null, ref: (p.variant_a.plan?.reference ?? null) as string | null },
              b: { role: "b", pole: p.variant_b.pole as string | null, ref: (p.variant_b.plan?.reference ?? null) as string | null },
              o: { role: "o", pole: null as string | null, ref: null as string | null },
            };
            const blindOpts = blindOrder.map((r, idx) => ({ ...blindMeta[r as "a" | "b" | "o"], n: idx + 1 }));
            return (
              <li
                class={`pair${i === 0 ? " pair-active" : ""}`}
                data-pair
                data-job-id={p.job_id}
                data-axis={p.axis}
                data-a={p.variant_a.id}
                data-b={p.variant_b.id}
                data-source-asset-id={p.source_asset_id}
                data-duration={p.source_duration_seconds ?? ""}
                data-side="a"
                data-url-a={aUrl}
                data-url-b={bUrl}
                data-stem-urls-a={JSON.stringify(stemUrlsA)}
                data-stem-urls-b={JSON.stringify(stemUrlsB)}
                data-source-audio-url={p.source_audio_path
                  ? `/api/console/asset?path=${encodeURIComponent(p.source_audio_path)}&variant=opus`
                  : ""}
                data-source-lufs={p.source_lufs ?? ""}
                data-a-lufs={p.variant_a.output_lufs ?? ""}
                data-b-lufs={p.variant_b.output_lufs ?? ""}
                data-a-peak={p.variant_a.true_peak_dbfs ?? ""}
                data-b-peak={p.variant_b.true_peak_dbfs ?? ""}
                data-a-qa={p.variant_a.qa_flag ? "1" : ""}
                data-b-qa={p.variant_b.qa_flag ? "1" : ""}
              >
                <div class="pair-head">
                  <h3 class="pair-source">{p.job_source_display}</h3>
                  <button
                    type="button"
                    class="pair-skip-x"
                    data-hold="skip"
                    aria-label="Hold to skip this pair"
                    title="Hold to skip"
                  ><span class="hold-fill" aria-hidden="true"></span><span class="hold-glyph">×</span></button>
                </div>

                <div class="pair-stage">
                  <div class="pair-waveform" data-stage-waveform>
                    {waveSrc ? (
                      <img src={waveSrc} alt="" loading="lazy" />
                    ) : (
                      <div class="pair-waveform-fallback">no waveform for source</div>
                    )}
                    <div class="pair-playhead" data-playhead hidden></div>
                  </div>
                  <div class="pair-transport">
                    <button class="transport-btn" data-skip="-10" aria-label="Back 10 seconds">⏮</button>
                    <button class="transport-btn transport-play" data-toggle-play aria-label="Play / pause">▶</button>
                    <button class="transport-btn" data-skip="10" aria-label="Forward 10 seconds">⏭</button>
                    <span class="pair-time" data-time>0:00 / —:—</span>
                    <div class="ab-switch" role="group" aria-label="Three blind takes — tap a number to audition, hold it to vote. Identities are hidden; use ‘reveal’ below to see them.">
                      {blindOpts.map((o) => (
                        o.role === "o" ? (
                          <button class="ab-side ab-side-blind" data-now-side data-hold="original" title="Tap to audition · hold to vote this take">
                            <span class="hold-fill" aria-hidden="true"></span>
                            <span class="ab-key">{o.n}</span>
                          </button>
                        ) : (
                          <button class="ab-side ab-side-blind" data-side-btn={o.role} data-hold={o.role} title="Tap to audition · hold to vote this take">
                            <span class="hold-fill" aria-hidden="true"></span>
                            <span class="ab-key">{o.n}</span>
                          </button>
                        )
                      ))}
                    </div>
                  </div>

                  <div class="pair-loudness" data-loudness aria-live="polite"></div>

                  {(Object.keys(stemUrlsA).length > 0 || Object.keys(stemUrlsB).length > 0) && (
                    <div class="pair-solo-bar">
                      <span class="solo-bar-label">solo</span>
                      <button class="solo-btn solo-btn-full" data-solo-full data-active="true">FULL MIX</button>
                      {[...new Set([...Object.keys(stemUrlsA), ...Object.keys(stemUrlsB)])].map((stem) => (
                        <button class="solo-btn" data-solo-stem={stem}>{stem}</button>
                      ))}
                    </div>
                  )}

                  <div class="pair-reasoning">
                    {/* One shared toggle expands BOTH descriptions together —
                        master mode has no per-stem moves to expand into, so the
                        old per-card details opened onto nothing. (#5) */}
                    <details class="pair-why" data-pair-why>
                      <summary>
                        <span class="pair-why-caret" aria-hidden="true">▾</span>
                        <span class="pair-why-label">🔍 reveal what each take is (spoils the blind)</span>
                      </summary>
                      <div class="pair-why-grid">
                        {blindOpts.map((o) => {
                          const variant = o.role === "a" ? p.variant_a : o.role === "b" ? p.variant_b : null;
                          const plan = variant?.plan;
                          // Master philosophy reads "Mastered toward X (pole) — why";
                          // drop the prefix so the why stands on its own.
                          const why =
                            plan?.philosophy_summary?.split(" — ").slice(1).join(" — ") ||
                            plan?.philosophy_summary ||
                            "";
                          const flags = variant?.translation?.summary_flags ?? [];
                          return (
                            <div class="pair-why-col">
                              <div class="pair-why-head">
                                <span class="pair-why-side">#{o.n}</span>
                                <span class="pair-why-pole">{o.role === "o" ? "ORIGINAL" : (o.pole ?? "").replace(/_/g, " ")}</span>
                              </div>
                              {o.role === "o" ? (
                                <div class="pair-why-ref">your unprocessed source</div>
                              ) : (o.ref && (
                                <div class="pair-why-ref">toward <strong>{o.ref}</strong></div>
                              ))}
                              {why && <div class="pair-why-text">{why}</div>}
                              {variant && (
                                <div class="pair-why-qa">
                                  {typeof variant.output_lufs === "number" && (
                                    <span>{variant.output_lufs.toFixed(1)} LUFS</span>
                                  )}
                                  {typeof variant.true_peak_dbfs === "number" && (
                                    <span>{variant.true_peak_dbfs.toFixed(1)} dBTP</span>
                                  )}
                                  {variant.qa_flag && <span class="pair-why-qa-warn">⚠ check</span>}
                                </div>
                              )}
                              {flags.length > 0 && (
                                <div class="pair-why-flags">
                                  {flags.map((f) => (
                                    <span class="plan-warning-chip">⚠ {f}</span>
                                  ))}
                                </div>
                              )}
                            </div>
                          );
                        })}
                      </div>
                    </details>
                  </div>
                </div>

                <textarea
                  class="comment"
                  data-comment
                  rows="2"
                  placeholder="Notes (optional). What worked, what didn't, what you'd change."
                ></textarea>

              </li>
            );
          })}
        </ul>
      )}
    </section>

    <section class="winners" id="winners">
      <h2>
        Winners
        <span class="hint">collapse / expand · cross-compare to crown a king · publish or dismiss</span>
      </h2>
      {winners.length === 0 ? (
        <p class="empty">
          No winners yet. Vote on a pair above and the source track lands here once its first vote is cast.
        </p>
      ) : (
        <ul class="winners-list">
          {sortedWinners.map((w) => {
            const sourceUrl = sourceAudioUrl(w.source_audio_path);
            const waveSrc = w.source_waveform_sha1
              ? `/api/console/waveform?sha1=${w.source_waveform_sha1}`
              : null;
            // King detection. variantKing matches when a real variant
            // has been crowned. isOriginalKing matches when the curator
            // chose the unprocessed source over every variant (Phase 5).
            // The two are mutually exclusive but downstream code only
            // needs `hasKing` for branching.
            const variantKing = w.winners.find(
              (v) =>
                !v.is_original && v.variant_id === w.champion_variant_id,
            );
            const isOriginalKing = w.champion_is_original;
            const hasKing = !!variantKing || isOriginalKing;
            // Filter the variant axis-winners list. Per-axis ORIGINAL
            // votes count toward axes_decided but don't get their own
            // row — the ORIGINAL row at the top of the card represents
            // the source for all of them.
            const variantWinners = w.winners.filter((v) => !v.is_original);
            const title = w.source_display_name || w.source_filename || `asset ${w.source_asset_id}`;
            const isKingRound = w.is_king_round === true;
            const inFlightKing = w.in_flight_kind === "king";
            // Collapsed card stays uniform: just the two left actions (↗ open in
            // Buckets, ⧉ open project) + the title. Status is encoded visually,
            // not as inline text (#2): green chevron = published; a distinct
            // border + bottom-grouped sort = ORIGINAL still beats every mix.
            return (
              <li
                class={`winners-card${hasKing ? " winners-card-crowned" : ""}`}
                data-winners-job-id={w.job_id}
                data-collapsed="true"
                data-axes-decided={w.axes_decided}
                data-has-king={hasKing ? "true" : "false"}
                data-king-is-original={isOriginalKing ? "true" : "false"}
                data-king-public={w.king_is_public ? "true" : "false"}
                data-is-king-round={isKingRound ? "true" : "false"}
              >
                <div class="winners-head">
                  <button
                    class="winners-toggle"
                    type="button"
                    data-winners-toggle
                    aria-expanded="false"
                    aria-controls={`winners-body-${w.job_id}`}
                    title={isOriginalKing
                      ? "ORIGINAL is king — the source beats every mix"
                      : (w.king_is_public ? "Published to Sounds" : "Expand")}
                  >
                    <span class="winners-chevron" aria-hidden="true">▸</span>
                    <span class="winners-source">{title}</span>
                  </button>
                  {w.in_flight_job_id && (
                    <span
                      class="winners-inflight-tag"
                      title={inFlightKing
                        ? "Engineer-worker is synthesizing king candidates from your picks"
                        : `Engineer-worker is ${w.in_flight_status === "splitting_stems" ? "splitting stems" : w.in_flight_status === "rendering" ? "rendering new mixes" : "preparing"}`}
                    >
                      <span class="winners-inflight-dot" aria-hidden="true"></span>
                      {w.in_flight_status === "splitting_stems"
                        ? "splitting stems"
                        : inFlightKing
                          ? `synthesizing king · ${w.in_flight_variants_done ?? 0}/${w.in_flight_variants_expected}`
                          : w.in_flight_status === "rendering"
                            ? `rendering ${w.in_flight_variants_done ?? 0}/${w.in_flight_variants_expected}`
                            : "queued"}
                    </span>
                  )}
                  {/* Action cluster on the far RIGHT: open-in-Buckets, open
                      project, dismiss. (#2 link buttons right · #4 dismiss = X) */}
                  <div class="winners-head-actions">
                    <a
                      class="winners-open-source"
                      href={`/portal/buckets/all?focus=${w.source_asset_id}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      title="Open this track in Buckets (new tab)"
                      aria-label="Open source track in Buckets"
                    >↗</a>
                    {/* Phase B: source .als project. Linked = solid amber,
                        auto-match = dashed amber, empty = faint grey. Click opens
                        in Ableton (or links, when empty); shift-click changes. */}
                    <button
                      type="button"
                      class:list={["winners-project-icon", w.project_asset_id ? (w.project_match === "linked" ? "is-linked" : "is-auto") : "is-empty"]}
                      data-project-icon
                      data-source-asset-id={w.source_asset_id}
                      data-project-asset-id={w.project_asset_id ?? ""}
                      title={w.project_asset_id
                        ? `Open "${(w.project_display_name || w.project_filename || "").replace(/\.als$/i, "")}" in Ableton (M3)${w.project_match === "linked" ? " — linked" : ` — auto-matched (${w.project_match})`}. Shift-click to change / unlink.`
                        : "No project linked. Click to find + link the source .als."}
                      aria-label={w.project_asset_id ? "Open source project in Ableton (shift-click to change)" : "Link source project"}
                    >⧉</button>
                    <button
                      class="winners-action-btn winners-dismiss-x"
                      type="button"
                      data-action="dismiss"
                      data-job-id={w.job_id}
                      title="Dismiss — hide this track from Winners"
                      aria-label="Dismiss this track from Winners"
                    >✕</button>
                  </div>
                </div>

                <div
                  class="winners-body"
                  id={`winners-body-${w.job_id}`}
                  hidden
                >
                  {waveSrc && (
                    <div class="winners-wave" data-winners-wave>
                      <img src={waveSrc} alt="" loading="lazy" />
                      <div class="winners-playhead" data-winners-playhead></div>
                      <span class="winners-time" data-winners-time>0:00 / —:—</span>
                    </div>
                  )}

                  <ul class="winner-row">
                    {hasKing ? (
                      /* CROWNED (post-crown reveal): the decision is made, so the
                         source + the king mix are shown by their real identity. */
                      <Fragment>
                        <li
                          class={`winner winner-source${isOriginalKing ? " winner-champion winner-source-king" : ""}`}
                          data-winner-kind="source"
                        >
                          <button class="winner-play" type="button" data-audio-url={sourceUrl} aria-label="Play original source">▶</button>
                          <div class="winner-meta">
                            <span class="winner-label">{isOriginalKing ? "♛ ORIGINAL" : "Original"}</span>
                            <span class="winner-sub">{isOriginalKing ? "your king mix" : "unprocessed source"}</span>
                          </div>
                          {isOriginalKing && (
                            <button class="winners-action-btn winner-uncrown-x" type="button" data-action="uncrown" data-job-id={w.job_id} title="Uncrown — compare the mixes again" aria-label="Uncrown ORIGINAL">✕</button>
                          )}
                        </li>
                        {variantKing && (
                          <li class="winner winner-champion" data-winner-variant-id={variantKing.variant_id}>
                            <button class="winner-play" type="button" data-audio-url={winnerAudioUrl(variantKing.asset_path)} aria-label="Play king mix">▶</button>
                            <div class="winner-meta">
                              <span class="winner-label">♛ {variantKing.reference || variantKing.color}</span>
                              <span class="winner-sub">{variantKing.reference ? `your king mix · ${variantKing.color}` : "your king mix"}</span>
                            </div>
                            <button class="winners-action-btn winner-uncrown-x" type="button" data-action="uncrown" data-job-id={w.job_id} title="Uncrown — compare the candidates again" aria-label="Uncrown">✕</button>
                          </li>
                        )}
                      </Fragment>
                    ) : (isKingRound || w.axes_decided >= 3) ? (
                      /* CROWNABLE + BLIND: the ORIGINAL is shuffled in among the
                         candidate mixes, each shown only as an anonymous "Take N",
                         so the crown follows sound — not reputation or "the
                         original". Real identity is revealed after a crown (above)
                         or via the faceoff's reveal toggle. (#4) */
                      blindShuffle(
                        [
                          { kind: "source" as const, audioUrl: sourceUrl, variantId: null as number | null },
                          ...variantWinners.map((v) => ({ kind: "variant" as const, audioUrl: winnerAudioUrl(v.asset_path), variantId: v.variant_id })),
                        ],
                        w.job_id,
                      ).map((opt, idx) => (
                        <li class="winner" data-winner-kind={opt.kind} data-winner-variant-id={opt.variantId ?? undefined}>
                          <button class="winner-play" type="button" data-audio-url={opt.audioUrl} aria-label={`Play take ${idx + 1}`}>▶</button>
                          <div class="winner-meta">
                            <span class="winner-label">Take {idx + 1}</span>
                            <span class="winner-sub">{isKingRound ? "king candidate" : "candidate"}</span>
                          </div>
                          <button
                            class="winner-crown"
                            type="button"
                            data-champion-job-id={w.job_id}
                            data-champion-is-original={opt.kind === "source" ? "true" : undefined}
                            data-champion-variant-id={opt.kind === "variant" ? opt.variantId : undefined}
                            aria-label="Crown this take as king"
                            title="Crown this take as your king"
                          >♛</button>
                        </li>
                      ))
                    ) : (
                      /* VOTING (still <3 axes decided, not a king round). No crown
                         yet — picks happen in the blind faceoff above. The source
                         is a read-only comparison anchor; axis winners so far are
                         anonymised. */
                      <Fragment>
                        <li class="winner winner-source" data-winner-kind="source">
                          <button class="winner-play" type="button" data-audio-url={sourceUrl} aria-label="Play original source">▶</button>
                          <div class="winner-meta">
                            <span class="winner-label">Original</span>
                            <span class="winner-sub">unprocessed source — for comparison</span>
                          </div>
                        </li>
                        {variantWinners.map((v, vi) => (
                          <li class="winner" data-winner-variant-id={v.variant_id}>
                            <button class="winner-play" type="button" data-audio-url={winnerAudioUrl(v.asset_path)} aria-label={`Play take ${vi + 1}`}>▶</button>
                            <div class="winner-meta">
                              <span class="winner-label">Take {vi + 1}</span>
                              <span class="winner-sub">won its axis in the faceoff</span>
                            </div>
                          </li>
                        ))}
                        {AXIS_ORDER.filter((a) => !w.winners.some((v) => v.axis === a)).map(() => (
                          <li class="winner winner-pending">
                            <span class="winner-pending-glyph">·</span>
                            <div class="winner-meta">
                              <span class="winner-label">— pending</span>
                              <span class="winner-sub">vote in the faceoff above</span>
                            </div>
                          </li>
                        ))}
                      </Fragment>
                    )}
                  </ul>

                  {/* Unified action strip — same shape across all three
                      Winners states (voting / ready-to-crown / king) so
                      the curator always has a forward path. "Make more
                      mixes" is always present; Publish / Uncrown only
                      surface when a king is crowned. */}
                  <div class="winners-actions">
                    {hasKing && w.champion_comment && (
                      <p class="winners-king-comment" title="Your note when crowning">
                        <span class="comment-quote">“</span>{w.champion_comment}<span class="comment-quote">”</span>
                      </p>
                    )}
                    {!hasKing && isKingRound && (
                      <p class="winners-hint winners-hint-king">
                        ♛ King candidates — {w.synthesis_summary || "3 fresh masters synthesized from your A/B picks"}. Listen blind and crown the Take you love (your unprocessed original is shuffled in among them — reveal each in the faceoff above).
                      </p>
                    )}
                    {!hasKing && !isKingRound && w.axes_decided >= 3 && (
                      <p class="winners-hint">Listen blind and tap ♛ on the Take you love to crown your king (your original is shuffled in among them), or render a fresh batch below.</p>
                    )}
                    {!hasKing && !isKingRound && w.axes_decided < 3 && (
                      <p class="winners-hint">
                        {3 - w.axes_decided} more mix{3 - w.axes_decided === 1 ? "" : "es"} left to vote on in the Mix Faceoff above. Or skip ahead with Make more mixes for a fresh batch.
                      </p>
                    )}
                    <textarea
                      class="winners-feedback"
                      data-feedback-input
                      rows="2"
                      placeholder="Notes for the planner (optional). What worked, what didn't, what to try next."
                    ></textarea>
                    <div class="winners-action-row">
                      <button
                        class="winners-action-btn winners-make-more"
                        type="button"
                        data-action="make-more"
                        data-job-id={w.job_id}
                        data-source-asset-id={w.source_asset_id}
                      >+ Make more mixes</button>
                      {hasKing && (
                        <button
                          class={`winners-action-btn winners-publish${w.king_is_public ? " is-public" : ""}`}
                          type="button"
                          data-action="publish-toggle"
                          data-job-id={w.job_id}
                          data-currently-public={w.king_is_public ? "true" : "false"}
                        >{w.king_is_public ? "● Published" : "→ Publish to Sounds"}</button>
                      )}
                      {/* Uncrown moved to a ✕ on the king row; Dismiss moved to
                          a ✕ in the card header (#4). */}
                    </div>
                  </div>
                </div>
              </li>
            );
          })}
        </ul>
      )}
    </section>
  </section>
</PortalLayout>

<style>
