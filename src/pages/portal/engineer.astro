  .pair-waveform-fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    font-size: 12px;
    opacity: 0.5;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  .pair-playhead {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 2px;
    background: #ff3b6e;
    box-shadow: 0 0 6px rgba(255, 59, 110, 0.7);
    pointer-events: none;
    transition: left 80ms linear;
