---
import "@fontsource-variable/geist";
import "../../styles/tokens.css";

const nextParam = Astro.url.searchParams.get("next") ?? "";
const hasError = Astro.url.searchParams.get("error") === "1";
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="theme-color" content="#070409" />
    <title>Tolo.Cloud</title>
  </head>
  <body>
    <main class="stage">
      <form method="POST" action="/api/console/login" class="card" aria-label="Sign in to Tolo.Cloud">
        <h1 class="wordmark">Tolo<span class="dot">.</span>Cloud</h1>
        <div class="row">
          <input
            type="password"
            name="password"
            required
            autocomplete="current-password"
            autofocus
            spellcheck="false"
            placeholder="passphrase"
            aria-label="Passphrase"
            aria-invalid={hasError ? "true" : undefined}
          />
          <button type="submit" class="enter" aria-label="Enter">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>
        <input type="hidden" name="next" value={nextParam} />
        {hasError && <p class="error" role="alert">Wrong passphrase.</p>}
      </form>
    </main>

    <style>
      :global(html), :global(body) { margin: 0; background: #070409; }
      .stage {
        min-height: 100svh;
        display: grid;
        place-items: center;
        padding: 24px;
        font-family: "Geist Variable", ui-sans-serif, system-ui, -apple-system, sans-serif;
        color: #e8edf4;
        cursor: auto;
        /* Pure-CSS gradient room — no image fetch, instant paint. */
        background:
          radial-gradient(125% 80% at 50% -10%, rgba(255, 59, 110, 0.18), transparent 60%),
          radial-gradient(125% 90% at 50% 112%, rgba(14, 196, 252, 0.16), transparent 55%),
          #070409;
      }
      .card {
        width: min(380px, 100%);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 22px;
        text-align: center;
      }
      .wordmark {
        margin: 0;
        font-family: ui-monospace, "SF Mono", SFMono-Regular, Menlo, monospace;
        font-weight: 700;
        font-size: clamp(28px, 7vw, 40px);
        letter-spacing: -0.02em;
        background: linear-gradient(96deg, #ff3b6e, #ff6e21);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }
      .dot { -webkit-text-fill-color: #0ec4fc; color: #0ec4fc; }
      .row {
        display: flex;
        width: 100%;
        gap: 8px;
        padding: 6px;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.14);
        border-radius: 12px;
        transition: border-color 160ms ease, box-shadow 160ms ease;
      }
      .row:focus-within {
        border-color: rgba(255, 59, 110, 0.55);
        box-shadow: 0 0 0 3px rgba(255, 59, 110, 0.15);
      }
      .row input {
        flex: 1;
        min-width: 0;
        background: transparent;
        border: none;
        outline: none;
        color: #fff;
        /* 16px keeps iOS from zooming the viewport on focus. */
        font: 500 16px/1 "Geist Variable", ui-sans-serif, system-ui, sans-serif;
        padding: 12px 14px;
      }
      .row input::placeholder { color: rgba(232, 237, 244, 0.4); letter-spacing: 0.02em; }
      .enter {
        flex-shrink: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        border: none;
        border-radius: 9px;
        cursor: pointer;
        color: #fff;
        background: linear-gradient(135deg, #ff3b6e, #ff6e21);
        transition: filter 140ms ease, transform 80ms ease;
      }
      .enter:hover { filter: brightness(1.1); }
      .enter:active { transform: scale(0.96); }
      .enter svg { width: 20px; height: 20px; }
      .error { margin: 0; color: #ff8aab; font-size: 13px; }
    </style>
  </body>
</html>
