---
import PortalLayout from "../../../layouts/PortalLayout.astro";
import BucketCard from "../../../components/portal/buckets/BucketCard.astro";
import BucketsFilters from "../../../components/portal/buckets/BucketsFilters.astro";
import { getBucketsList, getTopTags } from "../../../lib/console-api";
import type {
  BucketCategory,
  BucketSort,
  BucketView,
  TopTag,
} from "../../../lib/console-types";

// `BucketView` includes "all" (the unified surface) plus the five
// assignable buckets. The sub-tab strip was removed 2026-05-18; the
// default landing is /portal/buckets/all and Category/Sort handle
// browsing. Named-bucket URLs (e.g. /portal/buckets/loop) still resolve
// for anyone bookmarking them.
const VALID_BUCKETS: BucketView[] = ["all", "inbox", "jam", "loops", "field", "tracks", "trash"];
const VALID_CATEGORIES: BucketCategory[] = ["all", "jam", "loops", "field", "tracks", "other", "cleanup"];
const VALID_SORTS: BucketSort[] = ["recent", "oldest", "longest", "shortest", "most-used", "stars"];

const bucketParam = Astro.params.bucket ?? "all";
if (!VALID_BUCKETS.includes(bucketParam as BucketView)) {
  return Astro.redirect("/portal/buckets/all", 307);
}
const bucket = bucketParam as BucketView;

const url = Astro.url;
const categoryRaw = (url.searchParams.get("category") ?? "all").trim();
const sortRaw = url.searchParams.get("sort") ?? "recent";
const q = (url.searchParams.get("q") ?? "").trim();
const tagsRaw = (url.searchParams.get("tags") ?? "").trim();

const category: BucketCategory = VALID_CATEGORIES.includes(categoryRaw as BucketCategory)
  ? (categoryRaw as BucketCategory)
  : "all";
const sort: BucketSort = VALID_SORTS.includes(sortRaw as BucketSort)
  ? (sortRaw as BucketSort)
  : "recent";

// Active tag tokens parsed from ?tags=. Each is lowercase + de-duped so
// the query sent to the engine matches what's rendered as "active" in the
// chip strip. Empty list means no tag filter.
const activeTags: string[] = Array.from(
  new Set(
    tagsRaw
      .split(",")
      .map((t) => t.trim().toLowerCase())
      .filter(Boolean),
  ),
);
const tagsParam = activeTags.join(",");

// Grid + top-tags fire in parallel — both are server-side and independent.
// Top-tags reflects what's available in the bucket+category view BEFORE
// the active filter, so the strip stays stable as the curator AND-narrows.
const [primary, topTagsRes] = await Promise.all([
  getBucketsList(bucket, { sort, q, category, tags: tagsParam }),
  getTopTags(bucket, category, 10),
]);

const items = primary.ok ? primary.data.items : [];
const total = primary.ok ? primary.data.total : 0;
const fetchError = primary.ok
  ? null
  : primary.error.kind === "http"
    ? `HTTP ${primary.error.status}`
    : primary.error.kind;

const topTags: TopTag[] = topTagsRes.ok ? topTagsRes.data.tags : [];

const BUCKET_TITLE: Record<BucketView, string> = {
  all: "All",
  inbox: "Inbox",
  jam: "Jam",
  loops: "Loops",
  field: "Field",
  tracks: "Tracks",
  trash: "Trash",
};
---

<PortalLayout title={`Buckets · ${BUCKET_TITLE[bucket]}`} current="buckets">
  <section class="buckets-page" data-bucket={bucket}>
    <BucketsFilters
      bucket={bucket}
      category={category}
      sort={sort}
      q={q}
      activeTags={activeTags}
      topTags={topTags}
    />

    {fetchError ? (
      <p class="error" role="alert">Couldn't load: {fetchError}</p>
    ) : items.length === 0 ? (
      <p class="empty">Nothing here yet. Try a different filter.</p>
    ) : (
      <>
        <p class="count">
          <strong>{total.toLocaleString()}</strong>
          {bucket === "all" ? " items" : ` in ${BUCKET_TITLE[bucket]}`}
          {items.length < total && ` (${items.length} loaded)`}
        </p>
        <ul class="cards" role="list">
          {items.map((item, idx) => (
            <li><BucketCard item={item} index={idx} /></li>
          ))}
        </ul>
      </>
    )}
  </section>
</PortalLayout>

<style>
  .buckets-page {
    display: grid;
    gap: var(--space-5);
  }
  .count {
    font-size: var(--fs-small);
    color: var(--muted);
    margin: 0;
  }
  .count strong { color: var(--accent); }

  .empty { color: var(--muted); font-style: italic; }
  .error {
    padding: var(--space-3) var(--space-4);
    border-left: 2px solid var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    font-size: var(--fs-small);
  }

  /* One card per row. Title leads, sub-title (duration + BPM) sits
     beneath, waveform + tiles below that. Date column on the right,
     archive trash at the far right. Generous gap so each card reads
     as its own artifact, not a row in a list. */
  .cards {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 24px;
    grid-template-columns: 1fr;
  }
</style>

{/* Page-level controller for keyboard triage + per-card actions. Vanilla JS
    in a script tag mirrors the pattern PortalLayout uses for its global
    queue / trash / rename / public-toggle wiring. Scoped via .buckets-page
    so it does not run on other tabs. */}
<script>
  type BucketName = "inbox" | "jam" | "loops" | "field" | "tracks" | "trash";

  const root = document.querySelector<HTMLElement>(".buckets-page");
  if (root) {
    const cards = () =>
      Array.from(root.querySelectorAll<HTMLElement>("[data-bucket-card]"));

    const focusCard = (idx: number) => {
      const all = cards();
      if (all.length === 0) return;
      const clamped = Math.max(0, Math.min(all.length - 1, idx));
      const target = all[clamped];
      all.forEach((c) => c.removeAttribute("data-focused"));
      target.setAttribute("data-focused", "true");
      target.focus();
    };

    const focusedCard = (): HTMLElement | null => {
      const active = document.activeElement as HTMLElement | null;
      if (active && active.matches?.("[data-bucket-card]")) return active;
      const marked = root.querySelector<HTMLElement>('[data-bucket-card][data-focused="true"]');
      return marked ?? null;
    };

    const setStatus = (card: HTMLElement, text: string, tone: "" | "ok" | "err" = "") => {
      const line = card.querySelector<HTMLElement>("[data-status-line]");
      if (!line) return;
      line.textContent = text;
      if (tone) line.setAttribute("data-tone", tone);
      else line.removeAttribute("data-tone");
      if (text) {
        window.setTimeout(() => {
          if (line.textContent === text) {
            line.textContent = "";
            line.removeAttribute("data-tone");
          }
        }, 2200);
      }
    };

    // ── Bucket assignment ────────────────────────────────────────────────
    const assignBucket = async (card: HTMLElement, bucket: BucketName) => {
      const assetId = card.dataset.assetId;
      if (!assetId) return;
      card.setAttribute("data-pending", "true");
      try {
        const res = await fetch("/api/console/buckets-assign", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ asset_id: Number(assetId), bucket }),
        });
        if (!res.ok) {
          setStatus(card, `Assign failed (HTTP ${res.status})`, "err");
          return;
        }
        card.dataset.bucket = bucket;
        // Reflect new state on the bucket-action buttons (active highlight
        // tracks the assigned bucket; only one is active at a time).
        card.querySelectorAll<HTMLElement>('[data-action="bucket"]').forEach((b) => {
          b.classList.toggle("active", b.dataset.bucket === bucket);
        });
        setStatus(card, `→ ${bucket.replace("_", " ")}`, "ok");
      } catch {
        setStatus(card, "Assign failed (network)", "err");
      } finally {
        card.removeAttribute("data-pending");
      }
    };

    // ── Kudos ticker — increment by 1 per click, unbounded count ────────
    const bumpKudos = async (card: HTMLElement) => {
      const assetId = card.dataset.assetId;
      if (!assetId) return;
      const btn = card.querySelector<HTMLElement>('[data-action="kudos"]');
      const counter = card.querySelector<HTMLElement>("[data-kudos-count]");
      // Optimistic: bump the local count immediately so the click feels
      // instant. Roll back on failure.
      const before = Number(counter?.textContent ?? "0") || 0;
      if (counter) counter.textContent = String(before + 1);
      if (btn) btn.classList.add("has");
      btn?.setAttribute("data-pulsing", "true");
      window.setTimeout(() => btn?.removeAttribute("data-pulsing"), 320);
      try {
        const res = await fetch("/api/console/buckets-kudos", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ asset_id: Number(assetId) }),
        });
        if (!res.ok) {
          if (counter) counter.textContent = String(before);
          if (before === 0) btn?.classList.remove("has");
          setStatus(card, `Kudos failed (HTTP ${res.status})`, "err");
          return;
        }
        const data = await res.json();
        if (counter && typeof data.kudos === "number") counter.textContent = String(data.kudos);
        card.dataset.quality = String(data.kudos ?? before + 1);
      } catch {
        if (counter) counter.textContent = String(before);
        if (before === 0) btn?.classList.remove("has");
        setStatus(card, "Kudos failed (network)", "err");
      }
    };

    // ── Tag edits (× and + on chips in the expanded panel) ───────────────
    // Single source of truth for the current tag list is the rendered DOM.
    // Each save sends the full updated list to /items/tags; the engine
    // normalizes (lowercase, dedupe, trim) and writes back. UI is
    // optimistic — we update the DOM first, then POST. On error we restore.
    const collectCardTags = (card: HTMLElement): string[] => {
      const chips = card.querySelectorAll<HTMLElement>(".chip-tag[data-tag-value]");
      const out: string[] = [];
      chips.forEach((c) => {
        const v = c.dataset.tagValue;
        if (v && !out.includes(v)) out.push(v);
      });
      return out;
    };

    const persistTags = async (card: HTMLElement, tags: string[]) => {
      const path = card.dataset.path;
      if (!path) return false;
      try {
        const res = await fetch("/api/console/items-tags", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ path, tags }),
        });
        if (!res.ok) {
          setStatus(card, `Tag save failed (HTTP ${res.status})`, "err");
          return false;
        }
        return true;
      } catch {
        setStatus(card, "Tag save failed (network)", "err");
        return false;
      }
    };

    const removeTag = async (card: HTMLElement, xBtn: HTMLElement) => {
      const tag = xBtn.dataset.tag;
      if (!tag) return;
      const chip = xBtn.closest<HTMLElement>(".chip-tag");
      const current = collectCardTags(card);
      const next = current.filter((t) => t !== tag);
      // Optimistic remove. Hide the chip; restore on error.
      if (chip) chip.style.display = "none";
      const ok = await persistTags(card, next);
      if (!ok && chip) chip.style.display = "";
      else if (chip) chip.remove();
    };

    const startAddTag = (card: HTMLElement, addBtn: HTMLElement) => {
      // Replace "+ add" chip with an inline input. Enter commits; Escape
      // or blur-without-value cancels. Result re-renders as a new tag chip
      // inserted before the (re-shown) "+ add" chip.
      if (addBtn.classList.contains("editing")) return;
      addBtn.classList.add("editing");
      const input = document.createElement("input");
      input.type = "text";
      input.className = "chip-add-input";
      input.maxLength = 40;
      input.placeholder = "new tag…";
      const finish = (commitValue: string | null) => {
        addBtn.classList.remove("editing");
        input.replaceWith(addBtn);
        if (commitValue) {
          const clean = commitValue.trim().toLowerCase();
          if (!clean) return;
          const current = collectCardTags(card);
          if (current.includes(clean)) return;  // dedupe client-side
          // Optimistic add: render the chip immediately, then persist.
          const chip = document.createElement("span");
          chip.className = "chip chip-tag";
          chip.dataset.tagValue = clean;
          chip.textContent = clean;
          const xb = document.createElement("button");
          xb.type = "button";
          xb.className = "chip-x";
          xb.dataset.action = "tag-remove";
          xb.dataset.path = card.dataset.path ?? "";
          xb.dataset.tag = clean;
          xb.setAttribute("aria-label", `Remove tag ${clean}`);
          xb.textContent = "×";
          chip.appendChild(xb);
          addBtn.parentElement?.insertBefore(chip, addBtn);
          persistTags(card, [...current, clean]).then((ok) => {
            if (!ok) chip.remove();
          });
        }
      };
      addBtn.replaceWith(input);
      input.focus();
      input.addEventListener("keydown", (ev) => {
        if (ev.key === "Enter") {
          ev.preventDefault();
          finish(input.value);
        } else if (ev.key === "Escape") {
          ev.preventDefault();
          finish(null);
        }
      });
      input.addEventListener("blur", () => finish(input.value || null), { once: true });
    };

    // ── Dup-group reveal ─────────────────────────────────────────────────
    // Click the DUP badge to fetch all rows sharing this row's
    // content_sha1. Renders an inline list with canonical highlighted plus
    // a "go to" link per sibling. Lets the curator see the full group
    // before trashing — never accidentally trash the canonical or last copy.
    const revealDupGroup = async (card: HTMLElement, chip: HTMLElement) => {
      const assetId = card.dataset.assetId;
      const target = card.querySelector<HTMLElement>("[data-dup-target]");
      if (!assetId || !target) return;
      if (chip.dataset.loaded === "true") {
        target.hidden = !target.hidden;
        return;
      }
      target.hidden = false;
      target.textContent = "Loading group…";
      try {
        const res = await fetch(`/api/console/buckets-dup-group?asset_id=${assetId}`);
        if (!res.ok) {
          target.textContent = `Dup-group failed (HTTP ${res.status})`;
          return;
        }
        const data = await res.json();
        const sibs = Array.isArray(data.siblings) ? data.siblings : [];
        if (sibs.length === 0) {
          target.textContent = "No siblings — this is the only copy.";
          chip.dataset.loaded = "true";
          return;
        }
        const html = sibs
          .map((s: {
            asset_id: number;
            display_name: string | null;
            filename: string | null;
            path: string;
            bucket: string | null;
            duration_seconds: number | null;
            is_canonical?: boolean;
            discarded_at?: string | null;
          }) => {
            const name = s.display_name || s.filename || s.path.split("/").pop();
            const tag = s.is_canonical ? "<b>CANONICAL</b>" : "dup";
            const bucket = s.bucket || "inbox";
            const trashed = s.discarded_at ? " <i>(trashed)</i>" : "";
            const here = String(s.asset_id) === assetId ? " ← <i>this row</i>" : "";
            const href = `/portal/buckets/${bucket}?focus=${s.asset_id}`;
            const safeName = String(name).replace(/[<>&]/g, (c) =>
              c === "<" ? "&lt;" : c === ">" ? "&gt;" : "&amp;",
            );
            return `<li>[${tag}] <a href="${href}">${safeName}</a> · ${bucket}${trashed}${here}</li>`;
          })
          .join("");
        target.innerHTML = `<ul class="dup-list">${html}</ul>`;
        chip.dataset.loaded = "true";
      } catch {
        target.textContent = "Dup-group failed (network)";
      }
    };

    // ── Lineage reveal ───────────────────────────────────────────────────
    const revealLineage = async (card: HTMLElement, chip: HTMLElement) => {
      const assetId = card.dataset.assetId;
      const target = card.querySelector<HTMLElement>("[data-lineage-target]");
      if (!assetId || !target) return;
      if (chip.dataset.loaded === "true") {
        target.hidden = !target.hidden;
        return;
      }
      try {
        const res = await fetch(`/api/console/buckets-lineage?asset_id=${assetId}`);
        if (!res.ok) {
          target.hidden = false;
          target.textContent = `Lineage failed (HTTP ${res.status})`;
          return;
        }
        const data = await res.json();
        const lines: string[] = [];
        if (data.parent) {
          const name = data.parent.display_name || data.parent.path.split("/").pop();
          lines.push(`<b>parent:</b> ${name} (${data.parent.bucket ?? "inbox"})`);
        }
        if (Array.isArray(data.children) && data.children.length > 0) {
          const kids = data.children
            .map((c: { display_name: string | null; path: string; bucket: string | null }) =>
              c.display_name || c.path.split("/").pop())
            .join(", ");
          lines.push(`<b>children:</b> ${kids}`);
        }
        target.innerHTML = lines.length > 0 ? lines.join("<br>") : "<i>No related rows.</i>";
        target.hidden = false;
        chip.dataset.loaded = "true";
      } catch {
        target.hidden = false;
        target.textContent = "Lineage failed (network)";
      }
    };

    // ── Promote to Live (Task F, .wav-only Phase 1) ─────────────────────
    const promoteToLive = async (card: HTMLElement) => {
      const assetId = card.dataset.assetId;
      if (!assetId) return;
      // Refuse double-click if already in flight.
      if (card.getAttribute("data-pending") === "true") return;
      const row = card.querySelector<HTMLElement>("[data-promote-row]");
      const btn = row?.querySelector<HTMLButtonElement>('[data-action="promote-to-live"]');
      card.setAttribute("data-pending", "true");
      if (btn) {
        btn.disabled = true;
        btn.textContent = "Normalizing…";
      }
      setStatus(card, "Promoting…");
      try {
        const res = await fetch("/api/console/buckets-promote", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ asset_id: Number(assetId) }),
        });
        if (!res.ok) {
          let detail = `HTTP ${res.status}`;
          try {
            const body = await res.json();
            if (body?.error?.message) detail = body.error.message;
            else if (typeof body?.detail === "string") detail = body.detail;
          } catch {}
          setStatus(card, `Promote failed: ${detail}`, "err");
          if (btn) {
            btn.disabled = false;
            btn.textContent = "→ Promote to Live";
          }
          return;
        }
        const data = (await res.json()) as {
          live_loop_path: string;
          filename: string;
        };
        card.dataset.liveLoopPath = data.live_loop_path;
        if (row) {
          row.innerHTML = "";
          const badge = document.createElement("span");
          badge.className = "promoted-badge";
          badge.title = `In Live's browser: ${data.live_loop_path}`;
          badge.textContent = "✓ In Live";
          row.appendChild(badge);
        }
        setStatus(card, `Promoted: ${data.filename}`, "ok");
      } catch {
        setStatus(card, "Promote failed (network)", "err");
        if (btn) {
          btn.disabled = false;
          btn.textContent = "→ Promote to Live";
        }
      } finally {
        card.removeAttribute("data-pending");
      }
    };

    // ── Audition (real audio via /api/console/asset) ─────────────────────
    // Singleton audio element; one card plays at a time. The waveform PNG
    // doubles as a seek bar — click anywhere on the image to jump there,
    // and a playhead line tracks currentTime / duration during playback.
    let audio: HTMLAudioElement | null = null;
    let activeCard: HTMLElement | null = null;

    const fmtTime = (s: number): string => {
      if (!Number.isFinite(s) || s < 0) return "0:00";
      const m = Math.floor(s / 60);
      const r = Math.floor(s % 60);
      return `${m}:${String(r).padStart(2, "0")}`;
    };

    const setAuditionBtnState = (card: HTMLElement, playing: boolean) => {
      const btn = card.querySelector<HTMLButtonElement>('[data-action="audition"]');
      if (!btn) return;
      btn.setAttribute("aria-pressed", playing ? "true" : "false");
      const first = btn.firstChild;
      if (first) first.textContent = playing ? "⏸ " : "▶ ";
    };

    const updatePlayhead = () => {
      if (!activeCard || !audio) return;
      // Loop wraparound — applied BEFORE reading currentTime for the visual
      // position so the playhead never overshoots the end cap. -0.02s
      // lookahead leaves room for the seek to settle without an audible click.
      if (loopBounds && activeCard === loopBounds.card &&
          audio.currentTime >= loopBounds.endSec - 0.02) {
        audio.currentTime = loopBounds.startSec;
      }
      const playhead = activeCard.querySelector<HTMLElement>("[data-playhead]");
      const time = activeCard.querySelector<HTMLElement>("[data-waveform-time]");
      const cropPlayhead = activeCard.querySelector<HTMLElement>(
        "[data-cropper-playhead]",
      );
      const dur = audio.duration;
      if (Number.isFinite(dur) && dur > 0) {
        const pct = (audio.currentTime / dur) * 100;
        if (playhead) {
          playhead.style.left = `${pct}%`;
          playhead.hidden = false;
        }
        if (cropPlayhead) {
          cropPlayhead.style.left = `${pct}%`;
          cropPlayhead.hidden = false;
        }
      }
      if (time) {
        const durStr = Number.isFinite(dur) && dur > 0 ? fmtTime(dur) : "—";
        time.textContent = `${fmtTime(audio.currentTime)} / ${durStr}`;
        time.hidden = false;
      }
    };

    const clearPlayheadUI = (card: HTMLElement | null) => {
      if (!card) return;
      const playhead = card.querySelector<HTMLElement>("[data-playhead]");
      const time = card.querySelector<HTMLElement>("[data-waveform-time]");
      const cropPlayhead = card.querySelector<HTMLElement>("[data-cropper-playhead]");
      if (playhead) {
        playhead.hidden = true;
        playhead.style.left = "0";
      }
      if (cropPlayhead) {
        cropPlayhead.hidden = true;
        cropPlayhead.style.left = "0";
      }
      if (time) {
        time.hidden = true;
        time.textContent = "";
      }
    };

    const clearAllPlayheadsExcept = (keep: HTMLElement | null) => {
      cards().forEach((c) => {
        if (c === keep) return;
        clearPlayheadUI(c);
      });
    };

    const stopActive = () => {
      if (audio) audio.pause();
      if (activeCard) {
        setAuditionBtnState(activeCard, false);
        clearPlayheadUI(activeCard);
      }
      activeCard = null;
    };

    const ensureAudio = (): HTMLAudioElement => {
      if (audio) return audio;
      audio = new Audio();
      // "auto" lets the browser pre-buffer ahead of the playhead as soon
      // as src is set. The proxy now sets cache-control: private, max-age=
      // 3600 so the buffered ranges stick in the browser cache across
      // seeks — without it, every seek burned an RTT over Tailscale Funnel.
      audio.preload = "auto";
      audio.addEventListener("timeupdate", updatePlayhead);
      audio.addEventListener("loadedmetadata", updatePlayhead);
      audio.addEventListener("durationchange", updatePlayhead);
      audio.addEventListener("ended", () => {
        if (activeCard) {
          setAuditionBtnState(activeCard, false);
          // Park playhead at end so the user sees where playback finished.
          const ph = activeCard.querySelector<HTMLElement>("[data-playhead]");
          if (ph) ph.style.left = "100%";
        }
        activeCard = null;
      });
      audio.addEventListener("error", () => {
        if (activeCard) setStatus(activeCard, "Audio failed to load", "err");
        stopActive();
      });
      return audio;
    };

    const playCard = async (card: HTMLElement, seekFraction?: number) => {
      const path = card.dataset.path;
      if (!path) return;
      const a = ensureAudio();

      // Same card already loaded → toggle or seek.
      if (activeCard === card) {
        if (seekFraction !== undefined && Number.isFinite(a.duration) && a.duration > 0) {
          a.currentTime = seekFraction * a.duration;
          if (a.paused) {
            try { await a.play(); } catch {}
          }
          updatePlayhead();
          return;
        }
        if (a.paused) {
          try { await a.play(); setAuditionBtnState(card, true); } catch {}
        } else {
          a.pause();
          setAuditionBtnState(card, false);
        }
        return;
      }

      // Switch cards. Wipe any lingering playheads (e.g. an ended-state
      // card that nulled activeCard before this switch).
      stopActive();
      clearAllPlayheadsExcept(card);
      activeCard = card;
      setAuditionBtnState(card, true);
      // Long files (>10min) request the opus-transcoded variant — a 33min
      // WAV at 356MB becomes ~22MB and streams reliably over Funnel.
      const durSec = Number(card.dataset.durationSeconds);
      const variant = Number.isFinite(durSec) && durSec > 600 ? "&variant=opus" : "";
      a.src = `/api/console/asset?path=${encodeURIComponent(path)}${variant}`;

      const startAtFraction = () => {
        if (seekFraction === undefined) return;
        if (Number.isFinite(a.duration) && a.duration > 0) {
          a.currentTime = seekFraction * a.duration;
        } else {
          a.addEventListener(
            "loadedmetadata",
            () => { a.currentTime = seekFraction * a.duration; },
            { once: true },
          );
        }
      };

      try {
        await a.play();
        startAtFraction();
      } catch {
        setStatus(card, "Audio play failed", "err");
        stopActive();
      }
    };

    const toggleAudition = (card: HTMLElement) => {
      playCard(card);
    };

    const seekFromWaveform = (e: MouseEvent, card: HTMLElement) => {
      const wf = card.querySelector<HTMLElement>(".waveform");
      if (!wf || wf.getAttribute("data-seekable") !== "true") return;
      // First click on a card not currently playing → play from start.
      // Subsequent clicks while this card is active → seek to click x.
      if (activeCard !== card) {
        playCard(card);
        return;
      }
      const rect = wf.getBoundingClientRect();
      const fraction = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
      playCard(card, fraction);
    };

    // ── Crop tool: Apple-style trim handles inside the Crop tab ────────
    // Opening <details class="card-cropper"> initializes a default
    // selection (BPM-snapped 4 bars when bpm is known, else 5s centered),
    // renders the bar grid + draggable end caps + dim masks, and wires
    // pointer drag handlers. The Export button POSTs the
    // [start_sec, end_sec] region to /api/console/extract-loop → engine
    // ffmpeg-loudnorms into _Soundbending/loops/extracted/ + inserts a
    // child row with parent_id=<this card> for the lineage chip.
    //
    // State map is keyed by card so multiple cards can each have their
    // own crop pending. WeakMap so closing a card naturally GCs its state.
    type CropperState = {
      card: HTMLElement;
      surface: HTMLElement;
      wf: HTMLElement;
      startSec: number;
      endSec: number;
      durationSec: number;
      bpm: number | null;
      barSec: number | null;
      snapThresholdSec: number;
    };
    const cropperStates = new WeakMap<HTMLElement, CropperState>();

    // Loop playback bounds. When set, updatePlayhead enforces a
    // currentTime-jump from endSec back to startSec so the audio loops
    // tightly within the crop selection. Only one card loops at a time.
    let loopBounds: { card: HTMLElement; startSec: number; endSec: number } | null = null;

    // Push the current cropper selection into loopBounds whenever the
    // cropper is active for this card. Also clamps audio.currentTime back
    // inside the new bounds (whether playing or paused) so the playhead
    // never lives outside the loop frame.
    const syncCropBounds = (card: HTMLElement, st: CropperState) => {
      if (!loopBounds || loopBounds.card !== card) return;
      loopBounds.startSec = st.startSec;
      loopBounds.endSec = st.endSec;
      if (audio && activeCard === card &&
          (audio.currentTime < st.startSec || audio.currentTime > st.endSec)) {
        audio.currentTime = st.startSec;
        updatePlayhead();
      }
    };

    // Dismisses the keyboard hint after the curator has clearly engaged
    // (any handle drag, play, scrub, or export). Called once per cropper open.
    const dismissCropHint = (card: HTMLElement) => {
      const hint = card.querySelector<HTMLElement>("[data-cropper-hint]");
      if (hint) hint.dataset.fade = "true";
    };

    const fmtCropTime = (s: number): string => {
      if (!Number.isFinite(s) || s < 0) return "0:00.0";
      const m = Math.floor(s / 60);
      const r = s - m * 60;
      return `${m}:${r.toFixed(1).padStart(4, "0")}`;
    };

    // Returns { bars, snapped:true } when the selection length is an integer
    // bar count AND the start aligns with a bar boundary — the readout shows
    // "N bars · snapped" in that case so the curator knows the loop will
    // actually loop. Tolerance accounts for snap precision.
    const cropBarsIfSnapped = (
      state: CropperState,
    ): { bars: number } | null => {
      if (!state.barSec || state.barSec <= 0) return null;
      const len = state.endSec - state.startSec;
      const barsExact = len / state.barSec;
      const bars = Math.round(barsExact);
      if (bars < 1) return null;
      const tol = 0.05;
      if (Math.abs(barsExact - bars) > tol) return null;
      const startBars = state.startSec / state.barSec;
      if (Math.abs(startBars - Math.round(startBars)) > tol) return null;
      return { bars };
    };

    const updateCropperUI = (state: CropperState) => {
      const { wf, startSec, endSec, durationSec } = state;
      const startPct = (startSec / durationSec) * 100;
      const endPct = (endSec / durationSec) * 100;
      const frame = wf.querySelector<HTMLElement>("[data-cropper-frame]");
      const maskL = wf.querySelector<HTMLElement>("[data-cropper-mask-left]");
      const maskR = wf.querySelector<HTMLElement>("[data-cropper-mask-right]");
      if (frame) {
        frame.style.left = `${startPct}%`;
        frame.style.width = `${Math.max(0, endPct - startPct)}%`;
      }
      if (maskL) maskL.style.width = `${startPct}%`;
      if (maskR) maskR.style.width = `${Math.max(0, 100 - endPct)}%`;
      const startLabel = wf.querySelector<HTMLElement>(
        '[data-cropper-time="start"]',
      );
      const endLabel = wf.querySelector<HTMLElement>(
        '[data-cropper-time="end"]',
      );
      if (startLabel) startLabel.textContent = fmtCropTime(startSec);
      if (endLabel) endLabel.textContent = fmtCropTime(endSec);
      const readout = state.card.querySelector<HTMLElement>(
        "[data-cropper-readout]",
      );
      if (readout) {
        const len = endSec - startSec;
        const barsInfo = cropBarsIfSnapped(state);
        let html =
          `<span class="cropper-readout-range">${fmtCropTime(startSec)} → ${fmtCropTime(endSec)}</span>` +
          ` · <span class="cropper-readout-len">${len.toFixed(2)}s</span>`;
        if (barsInfo) {
          const noun = barsInfo.bars === 1 ? "bar" : "bars";
          html += ` · <span class="cropper-readout-bars">${barsInfo.bars} ${noun}</span>`;
          html += ` <span class="cropper-readout-snap">· snapped</span>`;
        }
        readout.innerHTML = html;
      }
    };

    // Draw the bar grid (only when bpm known). Each bar = 4 beats; every
    // `phraseEvery`-th gets the brighter "phrase" treatment so longer
    // boundaries are visually distinct. Density-aware: skip bar ticks
    // entirely when pixels-per-bar drops below 3 (visual noise).
    const renderCropperBarTicks = (state: CropperState) => {
      const ticksRoot = state.wf.querySelector<HTMLElement>(
        "[data-cropper-bar-ticks]",
      );
      if (!ticksRoot) return;
      ticksRoot.innerHTML = "";
      if (!state.barSec || state.barSec <= 0) return;
      const wfRect = state.wf.getBoundingClientRect();
      if (wfRect.width <= 0) return;
      const totalBars = Math.floor(state.durationSec / state.barSec);
      if (totalBars < 1) return;
      const pxPerBar = wfRect.width / totalBars;
      if (pxPerBar < 3) return;
      const phraseEvery = pxPerBar >= 14 ? 4 : pxPerBar >= 8 ? 8 : 16;
      const frag = document.createDocumentFragment();
      for (let i = 1; i < totalBars; i++) {
        const pct = ((i * state.barSec) / state.durationSec) * 100;
        const tick = document.createElement("div");
        tick.className =
          i % phraseEvery === 0 ? "cropper-bar-tick phrase" : "cropper-bar-tick";
        tick.style.left = `${pct}%`;
        frag.appendChild(tick);
      }
      ticksRoot.appendChild(frag);
    };

    // Default crop spans the entire track. The curator drags the end caps
    // inward to trim — at which point bar snapping kicks in (handled in
    // initCropper's pointer handlers). Starting at the full track keeps the
    // mental model simple: "enter crop, hit play, hear the whole thing
    // loop. Then trim down."
    const computeDefaultCrop = (
      durationSec: number,
      _bpm: number | null,
      _barSec: number | null,
    ): { startSec: number; endSec: number } => {
      return { startSec: 0, endSec: durationSec };
    };

    const initCropper = (card: HTMLElement, surface: HTMLElement) => {
      const wf = surface.querySelector<HTMLElement>("[data-cropper-waveform]");
      if (!wf) return;
      const durationSec = Number(card.dataset.durationSeconds);
      if (!Number.isFinite(durationSec) || durationSec <= 0) return;
      const bpmRaw = Number(card.dataset.bpm);
      const bpm = Number.isFinite(bpmRaw) && bpmRaw > 0 ? bpmRaw : null;
      const barSec = bpm ? (60 / bpm) * 4 : null;
      const { startSec, endSec } = computeDefaultCrop(durationSec, bpm, barSec);
      const wfRect = wf.getBoundingClientRect();
      const snapThresholdSec =
        wfRect.width > 0 ? (8 / wfRect.width) * durationSec : 0.1;
      const state: CropperState = {
        card, surface, wf, startSec, endSec, durationSec, bpm, barSec,
        snapThresholdSec,
      };
      cropperStates.set(card, state);
      renderCropperBarTicks(state);
      // Re-show the keyboard hint on each fresh crop-mode entry.
      const hint = surface.querySelector<HTMLElement>("[data-cropper-hint]");
      if (hint) delete hint.dataset.fade;

      // Wire handle drag once per element (bound flag prevents duplicates).
      const handles = wf.querySelectorAll<HTMLElement>("[data-cropper-handle]");
      handles.forEach((h) => {
        if (h.dataset.bound === "true") return;
        h.dataset.bound = "true";
        h.addEventListener("pointerdown", (e) => {
          if (e.button !== 0 && e.pointerType === "mouse") return;
          e.preventDefault();
          // Don't let the frame's own pointerdown also start a region drag.
          e.stopPropagation();
          h.setPointerCapture(e.pointerId);
          h.dataset.dragging = "true";
        });
        h.addEventListener("pointermove", (e) => {
          if (!h.hasPointerCapture(e.pointerId)) return;
          const st = cropperStates.get(card);
          if (!st) return;
          const rect = st.wf.getBoundingClientRect();
          const x = Math.max(rect.left, Math.min(rect.right, e.clientX));
          const fraction = (x - rect.left) / rect.width;
          let sec = fraction * st.durationSec;
          // Snap to nearest bar if close enough (in pixels → seconds).
          if (st.barSec && st.barSec > 0) {
            const nearestBar = Math.round(sec / st.barSec) * st.barSec;
            if (Math.abs(sec - nearestBar) < st.snapThresholdSec) {
              sec = nearestBar;
            }
          }
          sec = Math.max(0, Math.min(st.durationSec, sec));
          const minGap = 0.1;
          const which = h.dataset.cropperHandle;
          if (which === "start") {
            st.startSec = Math.min(sec, st.endSec - minGap);
          } else {
            st.endSec = Math.max(sec, st.startSec + minGap);
          }
          updateCropperUI(st);
          syncCropBounds(card, st);
        });
        const release = (e: PointerEvent) => {
          if (h.hasPointerCapture(e.pointerId)) h.releasePointerCapture(e.pointerId);
          delete h.dataset.dragging;
        };
        h.addEventListener("pointerup", release);
        h.addEventListener("pointercancel", release);
      });

      // Wire frame-drag (slides the entire loop). Captures initial selection
      // + cursor X; on move, shifts both startSec/endSec by the delta. The
      // handle pointerdowns stopPropagation, so this never fires on a handle.
      const frame = wf.querySelector<HTMLElement>("[data-cropper-frame]");
      if (frame && frame.dataset.bound !== "true") {
        frame.dataset.bound = "true";
        let frameDragStart: { x: number; startSec: number; endSec: number } | null = null;
        frame.addEventListener("pointerdown", (e) => {
          if (e.button !== 0 && e.pointerType === "mouse") return;
          // Defensive: skip if the click somehow landed on a handle anyway.
          if ((e.target as HTMLElement)?.closest(".cropper-handle")) return;
          e.preventDefault();
          frame.setPointerCapture(e.pointerId);
          frame.dataset.dragging = "true";
          const st = cropperStates.get(card);
          if (!st) return;
          frameDragStart = { x: e.clientX, startSec: st.startSec, endSec: st.endSec };
        });
        frame.addEventListener("pointermove", (e) => {
          if (!frame.hasPointerCapture(e.pointerId) || !frameDragStart) return;
          const st = cropperStates.get(card);
          if (!st) return;
          const rect = st.wf.getBoundingClientRect();
          const deltaPx = e.clientX - frameDragStart.x;
          const deltaSec = (deltaPx / rect.width) * st.durationSec;
          const selLen = frameDragStart.endSec - frameDragStart.startSec;
          let newStart = frameDragStart.startSec + deltaSec;
          newStart = Math.max(0, Math.min(st.durationSec - selLen, newStart));
          if (st.barSec && st.barSec > 0) {
            const nearestBar = Math.round(newStart / st.barSec) * st.barSec;
            if (Math.abs(newStart - nearestBar) < st.snapThresholdSec) {
              newStart = Math.max(0, Math.min(st.durationSec - selLen, nearestBar));
            }
          }
          st.startSec = newStart;
          st.endSec = newStart + selLen;
          updateCropperUI(st);
          syncCropBounds(card, st);
        });
        const releaseFrame = (e: PointerEvent) => {
          if (frame.hasPointerCapture(e.pointerId)) frame.releasePointerCapture(e.pointerId);
          delete frame.dataset.dragging;
          frameDragStart = null;
        };
        frame.addEventListener("pointerup", releaseFrame);
        frame.addEventListener("pointercancel", releaseFrame);
      }

      updateCropperUI(state);
    };

    const teardownCropper = (card: HTMLElement) => {
      cropperStates.delete(card);
    };

    // Eagerly load the audio for this card and seek to startSec so the
    // playhead can render at the left cap immediately on crop-mode entry
    // and the first spacebar press starts playback without an initial
    // seek delay. Sets loopBounds so subsequent skip / wraparound logic
    // sees the correct range even before any play happens.
    const preloadCropAudio = (card: HTMLElement) => {
      const state = cropperStates.get(card);
      if (!state) return;
      const a = ensureAudio();
      if (activeCard !== card) {
        stopActive();
        clearAllPlayheadsExcept(card);
        activeCard = card;
        const path = card.dataset.path;
        if (!path) return;
        const variant =
          Number.isFinite(state.durationSec) && state.durationSec > 600
            ? "&variant=opus" : "";
        a.src = `/api/console/asset?path=${encodeURIComponent(path)}${variant}`;
      }
      loopBounds = { card, startSec: state.startSec, endSec: state.endSec };
      const seekAndShowPlayhead = () => {
        const st = cropperStates.get(card);
        if (!st) return;
        a.currentTime = st.startSec;
        const ph = card.querySelector<HTMLElement>("[data-cropper-playhead]");
        if (ph) {
          ph.style.left = `${(st.startSec / st.durationSec) * 100}%`;
          ph.hidden = false;
        }
      };
      if (a.readyState >= 1) {
        seekAndShowPlayhead();
      } else {
        a.addEventListener("loadedmetadata", seekAndShowPlayhead, { once: true });
      }
    };

    // Spacebar in crop mode toggles play/pause. Resume-aware: if audio is
    // already loaded for this card, just resume from currentTime (which
    // crop-mode bounds enforcement guarantees is within the loop). If
    // audio is paused outside the loop bounds (shouldn't happen in
    // practice — bounds-clamp prevents it), snap back to start first.
    const toggleCropPlay = async (card: HTMLElement) => {
      const state = cropperStates.get(card);
      if (!state) return;
      const a = ensureAudio();
      // Switch source if a different card is currently active.
      if (activeCard !== card) {
        preloadCropAudio(card);
        // preloadCropAudio's seek may be async (waits for loadedmetadata);
        // wait for it before play so currentTime is at startSec.
        if (a.readyState < 1) {
          await new Promise<void>((resolve) => {
            a.addEventListener("loadedmetadata", () => resolve(), { once: true });
          });
        }
      }
      if (audio && !audio.paused) {
        audio.pause();
        return;
      }
      // About to play. Make sure currentTime is within bounds.
      if (a.currentTime < state.startSec || a.currentTime > state.endSec) {
        a.currentTime = state.startSec;
        if (Math.abs(a.currentTime - state.startSec) > 0.05) {
          await new Promise<void>((resolve) => {
            const onSeeked = () => {
              a.removeEventListener("seeked", onSeeked);
              resolve();
            };
            a.addEventListener("seeked", onSeeked);
          });
        }
      }
      loopBounds = { card, startSec: state.startSec, endSec: state.endSec };
      try {
        await a.play();
        updatePlayhead();
      } catch {
        if (audio) audio.pause();
      }
    };

    // Skip the playhead by deltaSec, clamped within the loop bounds. Works
    // while playing OR paused; the playhead visual updates immediately.
    const skipInLoop = (card: HTMLElement, deltaSec: number) => {
      const state = cropperStates.get(card);
      if (!state || !audio || activeCard !== card) return;
      let newTime = audio.currentTime + deltaSec;
      newTime = Math.max(state.startSec, Math.min(state.endSec, newTime));
      audio.currentTime = newTime;
      updatePlayhead();
      dismissCropHint(card);
    };

    // Enter/exit crop mode: swaps the wave-row with the cropper-surface via
    // [data-crop-mode] on the card root. Crop mode owns audio playback for
    // its card — entering stops normal audition on this card, exiting stops
    // any loop that was playing.
    const enterCropMode = (card: HTMLElement) => {
      document
        .querySelectorAll<HTMLElement>('[data-bucket-card][data-crop-mode="true"]')
        .forEach((c) => { if (c !== card) exitCropMode(c); });
      const surface = card.querySelector<HTMLElement>("[data-cropper-surface]");
      if (!surface) return;
      if (activeCard === card) stopActive();
      card.dataset.cropMode = "true";
      initCropper(card, surface);
      // Eagerly load + seek to startSec so the playhead is visible at the
      // left cap immediately and the first spacebar press plays without an
      // initial seek delay.
      preloadCropAudio(card);
      // The catalog's duration_seconds is sometimes stale (we hit a case
      // where catalog said 180s but the file was actually 317s). Probe the
      // audio's real metadata silently; if it differs significantly, update
      // state + re-derive the default selection so handles land on the
      // correct file positions and Export trims the right range. Uses a
      // throwaway audio element so it doesn't disturb the main playback
      // singleton.
      const path = card.dataset.path;
      if (!path) return;
      const probe = new Audio();
      probe.preload = "metadata";
      probe.src = `/api/console/asset?path=${encodeURIComponent(path)}`;
      probe.addEventListener("loadedmetadata", () => {
        const st = cropperStates.get(card);
        const actual = probe.duration;
        if (!st || !Number.isFinite(actual) || actual <= 0) return;
        if (Math.abs(actual - st.durationSec) < 0.5) return;
        st.durationSec = actual;
        const { startSec, endSec } = computeDefaultCrop(actual, st.bpm, st.barSec);
        st.startSec = startSec;
        st.endSec = endSec;
        const wfRect = st.wf.getBoundingClientRect();
        st.snapThresholdSec =
          wfRect.width > 0 ? (8 / wfRect.width) * actual : 0.1;
        renderCropperBarTicks(st);
        updateCropperUI(st);
        card.dataset.durationSeconds = String(actual);
        // If a loop is already playing for this card, refresh its bounds.
        if (loopBounds?.card === card) {
          loopBounds.startSec = st.startSec;
          loopBounds.endSec = st.endSec;
        }
      }, { once: true });
    };

    const exitCropMode = (card: HTMLElement) => {
      if (loopBounds?.card === card) {
        if (audio) audio.pause();
        loopBounds = null;
      }
      card.removeAttribute("data-crop-mode");
      teardownCropper(card);
    };

    const commitExportCrop = async (card: HTMLElement) => {
      const state = cropperStates.get(card);
      if (!state) return;
      const exportBtn = card.querySelector<HTMLButtonElement>(
        '[data-action="export-crop"]',
      );
      if (exportBtn?.dataset.busy === "true") return;
      if (exportBtn) exportBtn.dataset.busy = "true";
      const len = state.endSec - state.startSec;
      setStatus(card, `Exporting ${len.toFixed(2)}s…`);
      try {
        const res = await fetch("/api/console/extract-loop", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({
            asset_id: Number(card.dataset.assetId),
            start_sec: state.startSec,
            end_sec: state.endSec,
          }),
        });
        if (!res.ok) {
          let detail = `HTTP ${res.status}`;
          try {
            const body = await res.json();
            if (body?.error?.message) detail = body.error.message;
            else if (body?.error?.kind === "http") detail = `engine HTTP ${body.error.status}`;
            else if (typeof body?.detail === "string") detail = body.detail;
          } catch {}
          setStatus(card, `Export failed: ${detail}`, "err");
          if (exportBtn) exportBtn.dataset.busy = "";
          return;
        }
        const data = (await res.json()) as {
          new_asset_id: number;
          output_path: string;
          duration_sec: number;
        };
        setStatus(
          card,
          `✓ Exported · ${data.duration_sec.toFixed(2)}s (asset ${data.new_asset_id})`,
          "ok",
        );
        if (exportBtn) exportBtn.dataset.busy = "";
        // Stay in crop mode after a successful export — the curator may
        // want to cut another loop from the same source without re-entering.
      } catch {
        setStatus(card, "Export failed (network)", "err");
        if (exportBtn) exportBtn.dataset.busy = "";
      }
    };

    // ── Stem splitter: POST + 5s status poll ───────────────────────────
    // Stores job_id on the card via data-stem-job-id so a re-render can
    // pick the poll back up (page reload still loses it — TODO if curators
    // ask for resume across reloads, persist to sessionStorage).
    const STEM_POLL_MS = 5000;
    const activeStemPolls = new Map<HTMLElement, number>();

    const setStemProgress = (
      card: HTMLElement,
      text: string,
      tone: "" | "ok" | "err" = "",
    ) => {
      const span = card.querySelector<HTMLElement>("[data-stem-progress]");
      if (!span) return;
      span.textContent = text;
      if (tone) span.setAttribute("data-tone", tone);
      else span.removeAttribute("data-tone");
    };

    const stopStemPoll = (card: HTMLElement) => {
      const id = activeStemPolls.get(card);
      if (id !== undefined) {
        window.clearInterval(id);
        activeStemPolls.delete(card);
      }
    };

    const pollStemJob = async (card: HTMLElement, jobId: number) => {
      try {
        const res = await fetch(
          `/api/console/split-stems-status?job_id=${jobId}`,
        );
        if (!res.ok) {
          setStemProgress(card, `Status check failed (HTTP ${res.status})`, "err");
          return;
        }
        const data = (await res.json()) as {
          status: "running" | "done" | "failed";
          progress?: number;
          error?: string;
          stem_asset_ids?: number[];
        };
        if (data.status === "running") {
          const pct = typeof data.progress === "number"
            ? ` ${Math.round(data.progress * 100)}%`
            : "";
          setStemProgress(card, `Splitting…${pct}`);
        } else if (data.status === "done") {
          stopStemPoll(card);
          const n = data.stem_asset_ids?.length ?? 0;
          setStemProgress(
            card,
            n > 0 ? `✓ ${n} stems ready — reload to see siblings` : "✓ Done",
            "ok",
          );
          card.querySelectorAll<HTMLButtonElement>('[data-action="split-stems"]')
            .forEach((b) => { b.dataset.busy = ""; });
          card.removeAttribute("data-stem-job-id");
        } else if (data.status === "failed") {
          stopStemPoll(card);
          setStemProgress(card, `Failed: ${data.error ?? "unknown"}`, "err");
          card.querySelectorAll<HTMLButtonElement>('[data-action="split-stems"]')
            .forEach((b) => { b.dataset.busy = ""; });
          card.removeAttribute("data-stem-job-id");
        }
      } catch {
        setStemProgress(card, "Status check failed (network)", "err");
      }
    };

    const setEngineerStatus = (
      card: HTMLElement,
      msg: string,
      tone?: "ok" | "err",
    ) => {
      const node = card.querySelector<HTMLElement>("[data-engineer-status]");
      if (!node) return;
      node.textContent = msg;
      if (tone) node.dataset.tone = tone;
      else delete node.dataset.tone;
    };

    const sendToEngineer = async (card: HTMLElement) => {
      const assetId = card.dataset.assetId;
      if (!assetId) return;
      const buttons = card.querySelectorAll<HTMLButtonElement>(
        '[data-action="send-to-engineer"]',
      );
      buttons.forEach((b) => { b.dataset.busy = "true"; });
      setEngineerStatus(card, "Queueing…");
      try {
        const res = await fetch("/api/console/mix-jobs-create", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ source_asset_id: Number(assetId) }),
        });
        if (!res.ok) {
          let detail = `HTTP ${res.status}`;
          try {
            const body = await res.json();
            if (body?.error?.message) detail = body.error.message;
            else if (typeof body?.detail === "string") detail = body.detail;
          } catch {}
          setEngineerStatus(card, `Failed: ${detail}`, "err");
          buttons.forEach((b) => { b.dataset.busy = ""; });
          return;
        }
        const data = (await res.json()) as { job_id: number; status: string };
        setEngineerStatus(
          card,
          `✓ job ${data.job_id} (${data.status}) — see Engineer tab`,
          "ok",
        );
        buttons.forEach((b) => { b.dataset.busy = ""; });
      } catch {
        setEngineerStatus(card, "Kickoff failed (network)", "err");
        buttons.forEach((b) => { b.dataset.busy = ""; });
      }
    };

    const startSplitStems = async (card: HTMLElement, mode: "2" | "4") => {
      if (card.dataset.stemJobId) {
        setStemProgress(card, "Already running — wait for it to finish", "err");
        return;
      }
      const assetId = card.dataset.assetId;
      if (!assetId) return;
      const buttons = card.querySelectorAll<HTMLButtonElement>(
        '[data-action="split-stems"]',
      );
      buttons.forEach((b) => { b.dataset.busy = "true"; });
      setStemProgress(card, "Kicking off Demucs…");
      try {
        const res = await fetch("/api/console/split-stems", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ asset_id: Number(assetId), mode }),
        });
        if (!res.ok) {
          let detail = `HTTP ${res.status}`;
          try {
            const body = await res.json();
            if (body?.error?.message) detail = body.error.message;
            else if (typeof body?.detail === "string") detail = body.detail;
          } catch {}
          setStemProgress(card, `Failed: ${detail}`, "err");
          buttons.forEach((b) => { b.dataset.busy = ""; });
          return;
        }
        const data = (await res.json()) as { job_id: number };
        card.dataset.stemJobId = String(data.job_id);
        setStemProgress(card, `Splitting… (job ${data.job_id})`);
        // First poll immediate, then setInterval. Engine may have already
        // started reporting progress within the first second.
        pollStemJob(card, data.job_id);
        const intervalId = window.setInterval(
          () => pollStemJob(card, data.job_id),
          STEM_POLL_MS,
        );
        activeStemPolls.set(card, intervalId);
      } catch {
        setStemProgress(card, "Kickoff failed (network)", "err");
        buttons.forEach((b) => { b.dataset.busy = ""; });
      }
    };

    // ── Hold-to-archive (0.45s press) + Undo window ──────────────────────
    // The button's fill bar climbs over 0.45s via CSS while the curator
    // holds; after the timeout the card flips to "data-archiving" and
    // assignBucket(card, "trash") commits server-side. An inline status
    // line offers a 6-second Undo window that reverses to the previous
    // bucket if the curator changes their mind.
    const HOLD_MS = 450;
    const UNDO_MS = 6000;
    let trashTimer: number | null = null;
    let activeTrashBtn: HTMLElement | null = null;

    const cancelTrashHold = () => {
      if (trashTimer !== null) {
        window.clearTimeout(trashTimer);
        trashTimer = null;
      }
      if (activeTrashBtn) {
        activeTrashBtn.removeAttribute("data-holding");
        activeTrashBtn = null;
      }
    };

    const offerUndo = (card: HTMLElement, prevBucket: BucketName) => {
      const status = card.querySelector<HTMLElement>("[data-status-line]");
      if (!status) return;
      const safe = prevBucket === "trash" ? "inbox" : prevBucket;
      status.innerHTML = `<span class="undo-text">Archived.</span> <button type="button" class="undo-btn" data-action="undo-archive" data-prev="${safe}">Undo</button>`;
      status.setAttribute("data-tone", "ok");
      // Auto-fade the offer after UNDO_MS; the card stays archived.
      window.setTimeout(() => {
        if (status.textContent && status.textContent.startsWith("Archived")) {
          status.textContent = "";
          status.removeAttribute("data-tone");
        }
      }, UNDO_MS);
    };

    const startTrashHold = (btn: HTMLElement) => {
      if (trashTimer !== null) return;
      activeTrashBtn = btn;
      btn.setAttribute("data-holding", "true");
      trashTimer = window.setTimeout(() => {
        const card = btn.closest<HTMLElement>("[data-bucket-card]");
        if (card) {
          const prev = (card.dataset.bucket as BucketName | undefined) ?? "inbox";
          card.setAttribute("data-archiving", "true");
          assignBucket(card, "trash");
          offerUndo(card, prev);
        }
        cancelTrashHold();
      }, HOLD_MS);
    };

    root.addEventListener("pointerdown", (e) => {
      const btn = (e.target as HTMLElement)?.closest<HTMLElement>(
        '[data-action="trash-hold"]',
      );
      if (btn) {
        e.preventDefault();
        startTrashHold(btn);
      }
    });
    document.addEventListener("pointerup", cancelTrashHold);
    document.addEventListener("pointercancel", cancelTrashHold);
    root.addEventListener("pointerleave", cancelTrashHold);

    // ── Click handlers (delegated) ───────────────────────────────────────
    root.addEventListener("click", (e) => {
      const t = e.target as HTMLElement | null;
      if (!t) return;
      // Waveform click → seek (or start playback at that position).
      const wfHit = t.closest<HTMLElement>(".waveform");
      if (wfHit && wfHit.getAttribute("data-seekable") === "true") {
        const card = wfHit.closest<HTMLElement>("[data-bucket-card]");
        if (card) {
          seekFromWaveform(e, card);
          return;
        }
      }
      const btn = t.closest<HTMLElement>("[data-action]");
      if (!btn) return;
      const card = btn.closest<HTMLElement>("[data-bucket-card]");
      if (!card) return;

      const action = btn.dataset.action;
      switch (action) {
        case "audition":
          toggleAudition(card);
          break;
        case "kudos":
          bumpKudos(card);
          break;
        case "undo-archive": {
          const prev = (btn.dataset.prev as BucketName | undefined) ?? "inbox";
          card.removeAttribute("data-archiving");
          assignBucket(card, prev);
          const status = card.querySelector<HTMLElement>("[data-status-line]");
          if (status) {
            status.textContent = "Restored.";
            status.setAttribute("data-tone", "ok");
            window.setTimeout(() => {
              if (status.textContent === "Restored.") {
                status.textContent = "";
                status.removeAttribute("data-tone");
              }
            }, 2200);
          }
          break;
        }
        case "lineage":
          revealLineage(card, btn);
          break;
        case "dup-group":
          revealDupGroup(card, btn);
          break;
        case "tag-remove":
          removeTag(card, btn);
          break;
        case "tag-add":
          startAddTag(card, btn);
          break;
        case "promote-to-live":
          promoteToLive(card);
          break;
        case "enter-crop":
          enterCropMode(card);
          break;
        case "exit-crop":
          exitCropMode(card);
          break;
        case "export-crop":
          commitExportCrop(card);
          break;
        case "split-stems": {
          const mode = btn.dataset.mode === "2" || btn.dataset.mode === "4"
            ? btn.dataset.mode
            : null;
          if (mode) startSplitStems(card, mode);
          break;
        }
        case "send-to-engineer":
          sendToEngineer(card);
          break;
        case "bucket": {
          const target = btn.dataset.bucket as BucketName | undefined;
          if (!target) break;
          // Exclusive: clicking a different tab switches the card; clicking
          // the already-active tab is a no-op. The previous toggle-to-inbox
          // behavior was confusing — a `loop` row that you re-clicked LOOP
          // on would silently revert to Inbox. Pure radio semantics now.
          const current = card.dataset.bucket as BucketName | undefined;
          if (current === target) break;
          assignBucket(card, target);
          break;
        }
      }
    });

    // Track focused state for the keyboard handler when the user clicks a
    // card body (browsers handle focus already; we just mirror it into
    // data-focused so styles match).
    root.addEventListener("focusin", (e) => {
      const t = e.target as HTMLElement | null;
      const card = t?.closest<HTMLElement>("[data-bucket-card]");
      if (!card) return;
      cards().forEach((c) => c.removeAttribute("data-focused"));
      card.setAttribute("data-focused", "true");
    });

    // ── Keyboard handler ─────────────────────────────────────────────────
    document.addEventListener("keydown", (e) => {
      // Don't hijack typing in form fields.
      const tag = (e.target as HTMLElement | null)?.tagName?.toLowerCase();
      if (tag === "input" || tag === "textarea" || (e.target as HTMLElement)?.isContentEditable) {
        return;
      }
      // Only act when we're on the buckets page.
      if (!document.body.contains(root)) return;
      // Don't fight other site shortcuts.
      if (e.metaKey || e.ctrlKey || e.altKey) return;

      const all = cards();
      if (all.length === 0) return;

      const currentEl = focusedCard();
      const currentIdx = currentEl ? all.indexOf(currentEl) : -1;

      // Arrow navigation. ↑/↓ always move between cards. ←/→ also move
      // between cards by default, but in crop mode they're repurposed as
      // in-loop scrub (±1s, clamped within bounds) since the focused crop
      // surface needs left/right for navigation more than the card grid does.
      const inCrop = currentEl?.dataset.cropMode === "true";
      if (e.key === "ArrowDown") {
        e.preventDefault();
        const next = currentIdx < 0 ? 0 : (currentIdx + 1) % all.length;
        focusCard(next);
        return;
      }
      if (e.key === "ArrowUp") {
        e.preventDefault();
        const prev = currentIdx < 0 ? 0 : (currentIdx - 1 + all.length) % all.length;
        focusCard(prev);
        return;
      }
      if (e.key === "ArrowRight") {
        e.preventDefault();
        if (inCrop && currentEl) {
          skipInLoop(currentEl, +1);
        } else {
          const next = currentIdx < 0 ? 0 : (currentIdx + 1) % all.length;
          focusCard(next);
        }
        return;
      }
      if (e.key === "ArrowLeft") {
        e.preventDefault();
        if (inCrop && currentEl) {
          skipInLoop(currentEl, -1);
        } else {
          const prev = currentIdx < 0 ? 0 : (currentIdx - 1 + all.length) % all.length;
          focusCard(prev);
        }
        return;
      }

      if (!currentEl) return;

      if (e.key === " ") {
        e.preventDefault();
        // In crop mode, spacebar plays/pauses the loop selection; otherwise
        // it plays the full track via the small waveform's audition path.
        if (currentEl.dataset.cropMode === "true") {
          toggleCropPlay(currentEl);
          dismissCropHint(currentEl);
        } else {
          toggleAudition(currentEl);
        }
        return;
      }
      if (e.key === "Escape") {
        currentEl.blur();
        currentEl.removeAttribute("data-focused");
        return;
      }
      if (e.key === "Enter") {
        e.preventDefault();
        // Detail drawer is a future deliverable. For now, surface the path
        // in the status line so the curator can confirm what's focused.
        setStatus(currentEl, currentEl.dataset.path ?? "(no path)", "ok");
        return;
      }

      const key = e.key.toLowerCase();
      if (key === "j") { e.preventDefault(); assignBucket(currentEl, "jam"); return; }
      if (key === "l") { e.preventDefault(); assignBucket(currentEl, "loops"); return; }
      if (key === "f") { e.preventDefault(); assignBucket(currentEl, "field"); return; }
      if (key === "t") { e.preventDefault(); assignBucket(currentEl, "tracks"); return; }
      // Trash is intentionally not on the keyboard — the hold-button on
      // the card's bottom-right corner is the only way to delete.

      // K (or +) adds kudos to the focused card.
      if (e.key === "k" || e.key === "+") {
        e.preventDefault();
        bumpKudos(currentEl);
      }
    });

    // Auto-focus the first card so arrows work without a click first.
    // If the URL carries `?focus=N` (came from a lineage chip click on
    // another bucket page), prefer that card — scroll it into view and
    // pulse its border so the curator sees the navigation target instead
    // of landing somewhere arbitrary in a possibly-long list.
    const focusParam = new URLSearchParams(window.location.search).get("focus");
    const all = cards();
    const focusIdx = focusParam
      ? all.findIndex((c) => c.dataset.assetId === focusParam)
      : -1;
    if (focusIdx >= 0) {
      const target = all[focusIdx];
      target.setAttribute("data-focused", "true");
      target.setAttribute("data-lineage-arrived", "true");
      target.scrollIntoView({ block: "center", behavior: "auto" });
      // Clear the highlight class after the pulse finishes so re-entries
      // re-trigger it.
      window.setTimeout(
        () => target.removeAttribute("data-lineage-arrived"),
        2400,
      );
    } else if (all[0]) {
      all[0].setAttribute("data-focused", "true");
    }

    // ── Random button: pick a card in the current view ──────────────────
    const pickRandomCard = () => {
      const all = cards();
      if (all.length === 0) return;
      const idx = Math.floor(Math.random() * all.length);
      const target = all[idx];
      target.scrollIntoView({ block: "center", behavior: "auto" });
      focusCard(idx);
    };
    root.addEventListener("click", (e) => {
      const t = e.target as HTMLElement | null;
      if (t?.closest('[data-action="random"]')) {
        e.preventDefault();
        pickRandomCard();
      }
    });

    // ── Debounced search input → SPA-style page swap ─────────────────────
    // Updating the URL with ?q= would trigger a full reload; instead we
    // fetch the new server-rendered HTML, parse it, and swap the cards
    // section + count in place. Audio is stopped first since cards may be
    // replaced. The audition singleton + activeCard pointer get reset.
    const searchInput = root.querySelector<HTMLInputElement>("[data-search-input]");
    if (searchInput) {
      let debounce: number | null = null;
      let lastFetched = searchInput.value;

      const fetchAndSwap = async () => {
        const newQ = searchInput.value.trim();
        if (newQ === lastFetched.trim()) return;
        lastFetched = newQ;
        // Build URL preserving existing params, updating only q.
        const u = new URL(window.location.href);
        if (newQ) u.searchParams.set("q", newQ);
        else u.searchParams.delete("q");
        history.replaceState({}, "", u.toString());
        stopActive();
        root.setAttribute("data-searching", "true");
        try {
          const res = await fetch(u.toString(), { headers: { accept: "text/html" } });
          if (!res.ok) {
            root.setAttribute("data-search-error", "true");
            return;
          }
          const html = await res.text();
          const doc = new DOMParser().parseFromString(html, "text/html");
          const newCards = doc.querySelector(".cards");
          const newCount = doc.querySelector(".count");
          const newEmpty = doc.querySelector(".empty");
          const newError = doc.querySelector(".error");
          // Replace the count line, the cards UL, and any empty/error
          // states. Swap whichever pair exists on both sides.
          const oldCount = root.querySelector(".count");
          const oldCards = root.querySelector(".cards");
          const oldEmpty = root.querySelector(".empty");
          const oldError = root.querySelector(".error");
          oldCount?.replaceWith(newCount?.cloneNode(true) ?? document.createTextNode(""));
          if (oldCards && newCards) {
            oldCards.replaceWith(newCards.cloneNode(true));
          } else if (oldCards && !newCards) {
            oldCards.remove();
          } else if (!oldCards && newCards) {
            root.appendChild(newCards.cloneNode(true));
          }
          if (oldEmpty) oldEmpty.remove();
          if (oldError) oldError.remove();
          if (newEmpty) root.appendChild(newEmpty.cloneNode(true));
          if (newError) root.appendChild(newError.cloneNode(true));
          // Refocus the first card so keyboard nav works post-swap.
          const f = cards()[0];
          if (f) f.setAttribute("data-focused", "true");
          root.removeAttribute("data-search-error");
        } catch {
          root.setAttribute("data-search-error", "true");
        } finally {
          root.removeAttribute("data-searching");
        }
      };

      searchInput.addEventListener("input", () => {
        if (debounce !== null) window.clearTimeout(debounce);
        debounce = window.setTimeout(fetchAndSwap, 300);
      });
      // Enter immediately commits + blurs to dismiss mobile keyboard.
      searchInput.addEventListener("keydown", (e) => {
        if (e.key === "Enter") {
          e.preventDefault();
          if (debounce !== null) window.clearTimeout(debounce);
          fetchAndSwap();
          searchInput.blur();
        }
      });
    }
  }
</script>
