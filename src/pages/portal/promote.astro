---
import PortalLayout from "../../layouts/PortalLayout.astro";
import BucketCard from "../../components/portal/buckets/BucketCard.astro";
import { getPromoteCandidates } from "../../lib/console-api";

const res = await getPromoteCandidates(100);
const items = res.ok ? res.data.items : [];
const total = res.ok ? res.data.total_candidates : 0;
const loaded = res.ok ? res.data.returned : 0;
const fetchError = res.ok
  ? null
  : res.error.kind === "http"
    ? `HTTP ${res.error.status}`
    : res.error.kind;
---

<PortalLayout title="Promote" current="promote">
  <section class="buckets-page promote-page" data-bucket="loops" data-view="promote">
    <header class="promote-head">
      <h1>Promote-ready loops</h1>
      <p class="promote-sub">
        Ranked by promotion-readiness — BPM + key set, 1.5–8s duration, high loop density. Click a waveform to audition; <strong>→ Promote to Live</strong> copies + loudnorms into Live's browser at <code>_Soundbending/loops/</code>.
      </p>
    </header>

    {fetchError ? (
      <p class="error" role="alert">Couldn't load: {fetchError}</p>
    ) : items.length === 0 ? (
      <p class="empty">No candidates — everything ready has been promoted.</p>
    ) : (
      <>
        <p class="count"><strong>{total}</strong> ready · {loaded} loaded</p>
        <div class="bucket-grid">
          {items.map((item, i) => (
            <BucketCard item={item} index={i} currentBucket="loops" />
          ))}
        </div>
      </>
    )}
  </section>
</PortalLayout>

<style>
  .promote-page {
    padding: 0 16px 80px;
    max-width: 980px;
    margin: 0 auto;
  }
  .promote-head {
    margin: 24px 0 18px;
  }
  .promote-head h1 {
    font-size: 22px;
    font-weight: 700;
    margin: 0 0 6px;
    color: var(--ink);
  }
  .promote-sub {
    font-size: 13px;
    line-height: 1.5;
    color: var(--ink-muted, #888);
    margin: 0;
  }
  .promote-sub code {
    font-size: 12px;
    background: rgba(0,0,0,0.05);
    padding: 1px 5px;
    border-radius: 3px;
  }
  .count {
    font-size: 13px;
    color: var(--ink-muted, #888);
    margin: 16px 0;
  }
  .count strong {
    color: var(--accent, #ff4f8b);
    font-weight: 700;
  }
  .bucket-grid {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .error, .empty {
    padding: 18px;
    text-align: center;
    color: var(--ink-muted, #888);
  }
  .error { color: var(--err, #d33); }
</style>

<script>
  // Minimal controller for the promote-candidates view.
  // Reuses BucketCard's DOM shape but only handles audition + promote-to-live
  // — the full Buckets-page controller (bucket assign, rename, tag edit,
  // trash hold, keyboard nav) is out of scope here. The card buttons for
  // those actions are hidden via CSS below.

  const root = document.querySelector<HTMLElement>(".promote-page");
  if (root) {
    const cards = () =>
      Array.from(root.querySelectorAll<HTMLElement>("[data-bucket-card]"));

    // Pre-expand every card so the Promote button is visible without an
    // extra click — the whole point of this surface is fast triage.
    cards().forEach((c) => {
      const panel = c.querySelector<HTMLElement>("[data-expanded]");
      if (panel) panel.hidden = false;
      c.setAttribute("data-expanded-open", "true");
    });

    const setStatus = (card: HTMLElement, text: string, tone: "" | "ok" | "err" = "") => {
      const line = card.querySelector<HTMLElement>("[data-status-line]");
      if (!line) return;
      line.textContent = text;
      if (tone) line.setAttribute("data-tone", tone);
      else line.removeAttribute("data-tone");
    };

    // ── Audition ────────────────────────────────────────────────────────
    let audio: HTMLAudioElement | null = null;
    let activeCard: HTMLElement | null = null;

    const fmtTime = (s: number): string => {
      if (!Number.isFinite(s) || s < 0) return "0:00";
      const m = Math.floor(s / 60);
      const r = Math.floor(s % 60);
      return `${m}:${String(r).padStart(2, "0")}`;
    };

    const updatePlayhead = () => {
      if (!audio || !activeCard) return;
      const playhead = activeCard.querySelector<HTMLElement>("[data-playhead]");
      const time = activeCard.querySelector<HTMLElement>("[data-waveform-time]");
      const dur = audio.duration;
      if (playhead && Number.isFinite(dur) && dur > 0) {
        playhead.style.left = `${(audio.currentTime / dur) * 100}%`;
        playhead.hidden = false;
      }
      if (time) {
        const durStr = Number.isFinite(dur) && dur > 0 ? fmtTime(dur) : "—";
        time.textContent = `${fmtTime(audio.currentTime)} / ${durStr}`;
        time.hidden = false;
      }
    };

    const clearPlayheadUI = (card: HTMLElement | null) => {
      if (!card) return;
      const playhead = card.querySelector<HTMLElement>("[data-playhead]");
      const time = card.querySelector<HTMLElement>("[data-waveform-time]");
      if (playhead) { playhead.hidden = true; playhead.style.left = "0"; }
      if (time) { time.hidden = true; time.textContent = ""; }
    };

    const stopActive = () => {
      if (audio) audio.pause();
      if (activeCard) clearPlayheadUI(activeCard);
      activeCard = null;
    };

    const ensureAudio = (): HTMLAudioElement => {
      if (audio) return audio;
      audio = new Audio();
      audio.preload = "auto";
      audio.addEventListener("timeupdate", updatePlayhead);
      audio.addEventListener("loadedmetadata", updatePlayhead);
      audio.addEventListener("ended", () => {
        if (activeCard) {
          const ph = activeCard.querySelector<HTMLElement>("[data-playhead]");
          if (ph) ph.style.left = "100%";
        }
        activeCard = null;
      });
      audio.addEventListener("error", () => {
        if (activeCard) setStatus(activeCard, "Audio failed to load", "err");
        stopActive();
      });
      return audio;
    };

    const playCard = async (card: HTMLElement, seekFraction?: number) => {
      const path = card.dataset.path;
      if (!path) return;
      const a = ensureAudio();

      if (activeCard === card) {
        if (seekFraction !== undefined && Number.isFinite(a.duration) && a.duration > 0) {
          a.currentTime = seekFraction * a.duration;
          if (a.paused) { try { await a.play(); } catch {} }
          updatePlayhead();
          return;
        }
        if (a.paused) { try { await a.play(); } catch {} }
        else a.pause();
        return;
      }

      stopActive();
      cards().forEach((c) => { if (c !== card) clearPlayheadUI(c); });
      activeCard = card;
      // Long files request the opus-transcoded variant. Promote candidates
      // are 1.5–8s loops so the gate effectively never fires here, but
      // keep parity with the Buckets page wire-up for consistency.
      const durSec = Number(card.dataset.durationSeconds);
      const variant = Number.isFinite(durSec) && durSec > 600 ? "&variant=opus" : "";
      a.src = `/api/console/asset?path=${encodeURIComponent(path)}${variant}`;
      try { await a.play(); } catch {
        setStatus(card, "Audio play failed", "err");
        stopActive();
      }
    };

    // ── Promote-to-Live ─────────────────────────────────────────────────
    const promoteToLive = async (card: HTMLElement) => {
      const assetId = card.dataset.assetId;
      if (!assetId) return;
      if (card.getAttribute("data-pending") === "true") return;
      const btn = card.querySelector<HTMLButtonElement>('[data-action="promote-to-live"]');
      card.setAttribute("data-pending", "true");
      if (btn) { btn.disabled = true; btn.textContent = "Normalizing…"; }
      setStatus(card, "Promoting…");
      try {
        const res = await fetch("/api/console/buckets-promote", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ asset_id: Number(assetId) }),
        });
        if (!res.ok) {
          let detail = `HTTP ${res.status}`;
          try {
            const body = await res.json();
            if (body?.error?.message) detail = body.error.message;
            else if (typeof body?.detail === "string") detail = body.detail;
          } catch {}
          setStatus(card, `Promote failed: ${detail}`, "err");
          if (btn) { btn.disabled = false; btn.textContent = "→ Promote to Live"; }
          return;
        }
        const data = (await res.json()) as { live_loop_path: string; filename: string };
        card.dataset.liveLoopPath = data.live_loop_path;
        // Swap the button for an "In Live" badge — the row matches what
        // BucketCard renders when live_loop_path is set on initial render.
        const dd = btn?.closest("dd");
        if (dd) {
          dd.innerHTML = "";
          const badge = document.createElement("span");
          badge.className = "promoted-badge";
          badge.title = `In Live's browser: ${data.live_loop_path}`;
          badge.textContent = "✓ In Live";
          dd.appendChild(badge);
        }
        setStatus(card, `Promoted: ${data.filename}`, "ok");
        card.setAttribute("data-promoted", "true");
      } catch {
        setStatus(card, "Promote failed (network)", "err");
        if (btn) { btn.disabled = false; btn.textContent = "→ Promote to Live"; }
      } finally {
        card.removeAttribute("data-pending");
      }
    };

    // ── Event delegation ────────────────────────────────────────────────
    root.addEventListener("click", (e) => {
      const t = e.target as HTMLElement | null;
      if (!t) return;
      // Waveform click → audition or seek.
      const wfHit = t.closest<HTMLElement>(".waveform");
      if (wfHit && wfHit.getAttribute("data-seekable") === "true") {
        const card = wfHit.closest<HTMLElement>("[data-bucket-card]");
        if (!card) return;
        if (activeCard !== card) {
          playCard(card);
          return;
        }
        const rect = wfHit.getBoundingClientRect();
        const fraction = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
        playCard(card, fraction);
        return;
      }
      const btn = t.closest<HTMLElement>("[data-action]");
      if (!btn) return;
      const card = btn.closest<HTMLElement>("[data-bucket-card]");
      if (!card) return;
      if (btn.dataset.action === "promote-to-live") {
        promoteToLive(card);
      }
    });
  }
</script>

<style is:global>
  /* On the Promote surface, hide BucketCard's triage controls so the
     curator only sees audition + Promote. Bucket assignment, rename,
     trash-hold, public toggle, tag editing all live elsewhere. */
  .promote-page [data-bucket-card] .category-bar,
  .promote-page [data-bucket-card] [data-action="trash-hold"],
  .promote-page [data-bucket-card] [data-action="toggle-public"],
  .promote-page [data-bucket-card] [data-action="tag-add"],
  .promote-page [data-bucket-card] [data-action="tag-remove"],
  .promote-page [data-bucket-card] [data-action="dup-group"],
  .promote-page [data-bucket-card] [data-action="studio-arm"],
  .promote-page [data-bucket-card] .exp-studio,
  .promote-page [data-bucket-card] .exp-studio-dt,
  .promote-page [data-bucket-card] .flag-studio,
  .promote-page [data-bucket-card] .chip-x {
    display: none !important;
  }
  /* The card's title button is wired to rename — we don't handle rename
     on this surface, so neutralize the click target but keep the text
     visible (it's the filename). */
  .promote-page [data-bucket-card] [data-action="rename"] {
    pointer-events: none;
    cursor: default;
  }
  /* Fade promoted cards so the eye drops to the next unhit candidate. */
  .promote-page [data-bucket-card][data-promoted="true"] {
    opacity: 0.45;
  }
</style>
