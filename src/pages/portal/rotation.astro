---
import PortalLayout from "../../layouts/PortalLayout.astro";
import { rotationThisWeek } from "../../lib/console-api";

interface RotationPick {
  path: string;
  title: string;
  category: string;
  durationSeconds: number;
  createdAt: string;
  bpm: number | null;
  key: string | null;
  tags: string[];
  summary: string | null;
  excerpt: string | null;
}

const mockPick: RotationPick = {
  path: "/example/path.wav",
  title: "Example pick (mock — engine unreachable)",
  category: "song",
  durationSeconds: 247,
  createdAt: "2025-05-14T19:32:00Z",
  bpm: 84,
  key: "G minor",
  tags: ["unreleased", "vocal", "slow"],
  summary:
    "Mid-tempo song sketch in G minor. (This is mock data shown when the M1 brain is unreachable; the real rotation pick will appear once the engine is up.)",
  excerpt: null,
};

let pick: RotationPick = mockPick;
let usingMock = true;
let reasons: string[] = [];
let weekOfISO: string | null = null;
let pickedAtISO: string | null = null;

try {
  const res = await rotationThisWeek();
  if (res.ok && res.data.pick) {
    const a = res.data.pick.asset;
    const tags = (a.tags ?? "").split(",").map((t) => t.trim()).filter(Boolean);
    pick = {
      path: a.path,
      title: a.filename || a.path,
      category: a.category ?? "unknown",
      durationSeconds: a.duration_seconds ?? 0,
      createdAt: a.modified,
      bpm: a.bpm ?? null,
      key: a.key ?? null,
      tags,
      summary: a.summary,
      excerpt: null,
    };
    reasons = res.data.pick.reasons ?? [];
    weekOfISO = res.data.pick.weekOf;
    pickedAtISO = res.data.pick.pickedAt;
    usingMock = false;
  }
} catch {
  // keep mock; never fail the page
}

const weekOf = (weekOfISO
  ? new Date(weekOfISO)
  : new Date()
).toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

function formatDuration(s: number): string {
  const m = Math.floor(s / 60);
  const r = s % 60;
  return `${m}:${String(r).padStart(2, "0")}`;
}

function formatDate(iso: string): string {
  return new Date(iso).toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}
---

<PortalLayout title="Rotation" current="surprise" bare={true}>
  <article class="rotation-page">
    <header class="rotation-head">
      <p class="eyebrow">The Rotation</p>
      <p class="week">Week of {weekOf}</p>
    </header>

    <section class="pick">
      <h1 class="title">{pick.title}</h1>

      <dl class="meta">
        <div>
          <dt>Category</dt>
          <dd>{pick.category.replace(/_/g, " ")}</dd>
        </div>
        <div>
          <dt>Created</dt>
          <dd>{formatDate(pick.createdAt)}</dd>
        </div>
        <div>
          <dt>Length</dt>
          <dd>{formatDuration(pick.durationSeconds)}</dd>
        </div>
        {pick.bpm !== null && (
          <div>
            <dt>BPM</dt>
            <dd>{pick.bpm}</dd>
          </div>
        )}
        {pick.key !== null && (
          <div>
            <dt>Key</dt>
            <dd>{pick.key}</dd>
          </div>
        )}
      </dl>

      {pick.summary && (
        <p class="summary">{pick.summary}</p>
      )}

      {pick.excerpt && (
        <blockquote class="excerpt"><p>{pick.excerpt}</p></blockquote>
      )}

      {pick.tags.length > 0 && (
        <ul class="tags" aria-label="Tags">
          {pick.tags.map((t) => <li>{t}</li>)}
        </ul>
      )}

      {reasons.length > 0 && (
        <p class="reasons" aria-label="Why this was picked">
          <span class="reasons-label">Why:</span>
          {reasons.join(" · ")}
        </p>
      )}
    </section>

    {usingMock && (
      <p class="mock-banner screen-only" role="status">
        Mock data shown — the M1 engine isn't reachable from this dev session right now.
      </p>
    )}

    <footer class="rotation-foot">
      <p>The Console — Weekly Rotation</p>
      <p class="path-hint">{pick.path}</p>
    </footer>

    <p class="print-hint screen-only">
      Press <kbd>Cmd</kbd> + <kbd>P</kbd> to print or save as PDF.
    </p>
  </article>
</PortalLayout>

<style>
  .rotation-page {
    max-width: 38rem;
    margin: 0 auto;
    padding: var(--space-12) var(--content-pad) var(--space-12);
    display: grid;
    gap: var(--space-8);
    color: var(--text);
  }

  .rotation-head {
    display: grid;
    gap: var(--space-1);
    border-bottom: 1px solid var(--line);
    padding-bottom: var(--space-4);
  }
  .eyebrow {
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--muted);
    margin: 0;
  }
  .week {
    font-size: var(--fs-small);
    color: var(--muted);
    margin: 0;
  }

  .pick {
    display: grid;
    gap: var(--space-5);
  }
  .title {
    font-size: var(--fs-title);
    font-weight: var(--fw-bold);
    letter-spacing: var(--ls-title);
    line-height: var(--lh-title);
    margin: 0;
  }

  .meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 8rem), 1fr));
    gap: var(--space-3) var(--space-5);
    margin: 0;
    padding: var(--space-4) 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .meta div { display: grid; gap: 2px; }
  .meta dt {
    font-size: 11px;
    font-weight: var(--fw-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .meta dd {
    margin: 0;
    font-size: var(--fs-body);
    line-height: 1.3;
  }

  .summary {
    font-size: 18px;
    line-height: 1.55;
    font-weight: 500;
    margin: 0;
  }

  .excerpt {
    border-left: 2px solid var(--muted);
    padding-left: var(--space-4);
    margin: 0;
    font-style: italic;
    color: var(--muted);
  }
  .excerpt p { margin: 0; }

  .tags {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .tags li {
    display: inline-block;
    font-size: 11px;
    font-weight: var(--fw-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    border: 1px solid var(--line);
    padding: 4px 8px;
  }

  .rotation-foot {
    border-top: 1px solid var(--line);
    padding-top: var(--space-4);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    display: grid;
    gap: var(--space-1);
  }
  .rotation-foot p { margin: 0; }
  .path-hint {
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    text-transform: none;
    letter-spacing: 0;
    font-size: 10px;
    color: color-mix(in srgb, var(--muted) 70%, transparent);
    overflow-wrap: anywhere;
  }

  .print-hint {
    font-size: var(--fs-small);
    color: var(--muted);
    text-align: center;
  }
  .print-hint kbd {
    font: inherit;
    border: 1px solid var(--line);
    padding: 1px 6px;
  }

  .reasons {
    margin: 0;
    font-size: var(--fs-small);
    color: var(--muted);
    font-style: italic;
    line-height: 1.5;
  }
  .reasons-label {
    color: var(--accent);
    font-style: normal;
    font-weight: var(--fw-semibold);
    text-transform: uppercase;
    font-size: var(--fs-eyebrow);
    letter-spacing: var(--ls-eyebrow);
    margin-right: 6px;
  }

  .mock-banner {
    margin: 0;
    padding: var(--space-3) var(--space-4);
    border-left: 2px solid var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    font-size: var(--fs-small);
    color: var(--muted);
  }

  /* Print stylesheet: clean one-page artifact. Forces grayscale-friendly
     output regardless of theme tokens. */
  @media print {
    @page {
      size: letter;
      margin: 0.75in 0.75in 1in 0.75in;
    }
    :global(body) {
      background: white !important;
    }
    :global(body::before) {
      display: none !important;
    }
    :global(.cursor),
    :global(.theme-selector) {
      display: none !important;
    }
    .screen-only {
      display: none !important;
    }
    .rotation-page {
      max-width: none;
      padding: 0;
      color: #111;
    }
    .eyebrow,
    .week,
    .meta dt,
    .tags li,
    .rotation-foot,
    .excerpt {
      color: #555;
    }
    .meta,
    .rotation-head,
    .rotation-foot {
      border-color: #999;
    }
    .tags li {
      border-color: #999;
    }
  }
</style>
