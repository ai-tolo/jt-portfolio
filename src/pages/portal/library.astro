---
import PortalLayout from "../../layouts/PortalLayout.astro";
import Card from "../../components/portal/Card.astro";
import EmptyState from "../../components/portal/EmptyState.astro";
import { search, stats } from "../../lib/console-api";
import type { Asset } from "../../lib/console-types";

const PAGE_SIZE = 25;

const url = Astro.url;
const q = (url.searchParams.get("q") ?? "").trim();
const limit = (() => {
  const n = parseInt(url.searchParams.get("limit") ?? "", 10);
  return Number.isFinite(n) && n > 0 ? Math.min(n, 500) : PAGE_SIZE;
})();
const category = url.searchParams.get("category") ?? "all";

let results: Asset[] = [];
let searchError: string | null = null;
let truncated = false;

if (q.length > 0) {
  const res = await search(q, { limit });
  if (res.ok) {
    results = res.data.results;
    // M1 returns up to `limit` items; if we got exactly `limit`, more may exist
    truncated = results.length === limit;
  } else {
    searchError = res.error.kind === "http" ? `HTTP ${res.error.status}` : res.error.kind;
  }
}

// Client-side filter chip applies if category != "all". Pre-filter on the
// server so the "X results" count matches what's rendered. The chip itself
// is a regular link that updates the URL.
const filtered =
  category === "all"
    ? results
    : results.filter((r) => r.category === category);

const categoriesPresent = Array.from(new Set(results.map((r) => r.category))).sort();

const statsResult = q.length === 0 ? await stats() : null;
const statsData = statsResult?.ok ? statsResult.data : null;

const nextLimit = limit + PAGE_SIZE;
const buildHref = (overrides: Record<string, string | null>): string => {
  const p = new URLSearchParams(url.searchParams);
  for (const [k, v] of Object.entries(overrides)) {
    if (v === null) p.delete(k);
    else p.set(k, v);
  }
  const qs = p.toString();
  return qs ? `/portal/library?${qs}` : "/portal/library";
};
---

<PortalLayout title="Library" current="library">
  <section class="surface">
    <header class="surface-head">
      <div>
        <p class="eyebrow">Library</p>
        <h1 class="title">Search the catalog</h1>
      </div>
    </header>

    <form method="GET" action="/portal/library" class="search-form" role="search">
      <input
        type="search"
        name="q"
        value={q}
        placeholder="Search transcripts, summaries, tags…"
        autocomplete="off"
        spellcheck="false"
        aria-label="Search the catalog"
      />
      <button type="submit">Search</button>
      {q && (
        <a class="reset" href="/portal/library">Clear</a>
      )}
    </form>

    {q.length === 0 ? (
      <EmptyState
        title="Type to search"
        body={"Search runs across transcripts, summaries, tags, and filenames. The M1 returns the most relevant matches."}
        stats={statsData}
      />
    ) : searchError ? (
      <p class="error" role="alert">Search failed: {searchError}</p>
    ) : (
      <>
        <div class="result-meta">
          <p class="count">
            <strong>{filtered.length}</strong> {filtered.length === 1 ? "result" : "results"}
            {category !== "all" && <> in <code>{category}</code></>}
            <span class="muted"> for "{q}"</span>
          </p>

          {categoriesPresent.length > 1 && (
            <ul class="chips" role="list" aria-label="Filter by category">
              <li>
                <a
                  href={buildHref({ category: null })}
                  class:list={["chip", { active: category === "all" }]}
                >all ({results.length})</a>
              </li>
              {categoriesPresent.map((c) => (
                <li>
                  <a
                    href={buildHref({ category: c })}
                    class:list={["chip", { active: category === c }]}
                  >{c.replace(/_/g, " ")} ({results.filter((r) => r.category === c).length})</a>
                </li>
              ))}
            </ul>
          )}
        </div>

        {filtered.length === 0 ? (
          <p class="no-results">No matches{category !== "all" && <> in this category</>}.</p>
        ) : (
          <ul class="cards">
            {filtered.map((item) => (
              <li><Card item={item} /></li>
            ))}
          </ul>
        )}

        {truncated && filtered.length > 0 && (
          <p class="load-more-wrap">
            <a class="load-more" href={buildHref({ limit: String(nextLimit) })}>
              Load more ({nextLimit} total)
            </a>
          </p>
        )}
      </>
    )}
  </section>
</PortalLayout>

<style>
  .surface {
    display: grid;
    gap: var(--space-6);
  }

  .surface-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-6);
    flex-wrap: wrap;
  }
  .eyebrow {
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--muted);
  }
  .title {
    font-size: var(--fs-title);
    font-weight: var(--fw-bold);
    letter-spacing: var(--ls-title);
    line-height: var(--lh-title);
    margin-top: var(--space-1);
  }

  .search-form {
    display: flex;
    gap: var(--space-3);
    align-items: stretch;
    flex-wrap: wrap;
  }
  input[type="search"] {
    flex: 1;
    min-width: 14rem;
    font: inherit;
    color: var(--text);
    background: transparent;
    border: 1px solid var(--line);
    padding: var(--space-3) var(--space-4);
    outline: none;
    transition: border-color 160ms ease;
  }
  input[type="search"]:focus-visible {
    border-color: var(--accent);
  }
  .search-form button {
    font: inherit;
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--accent);
    background: transparent;
    border: 1px solid var(--accent);
    padding: var(--space-3) var(--space-5);
    cursor: pointer;
    transition: background-color 200ms ease, color 200ms ease;
  }
  .search-form button:hover,
  .search-form button:focus-visible {
    background: var(--accent);
    color: var(--bg);
  }
  .reset {
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--muted);
    align-self: center;
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-underline-offset: 4px;
  }
  .reset:hover { color: var(--accent); text-decoration-color: var(--accent); }

  .result-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }
  .count { font-size: var(--fs-small); }
  .count strong { color: var(--accent); }
  .count code {
    font-family: inherit;
    background: var(--ink);
    color: var(--ink-fg);
    padding: 1px 6px;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .count .muted { color: var(--muted); }

  .chips {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .chip {
    display: inline-block;
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--muted);
    border: 1px solid var(--line);
    padding: 5px 9px;
    text-decoration: none;
    transition: color 160ms ease, border-color 160ms ease;
  }
  .chip:hover { color: var(--text); border-color: var(--text); }
  .chip.active {
    color: var(--bg);
    background: var(--accent);
    border-color: var(--accent);
  }

  .error {
    padding: var(--space-3) var(--space-4);
    border-left: 2px solid var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    font-size: var(--fs-small);
  }
  .no-results { color: var(--muted); font-style: italic; }

  .cards {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
  }

  .load-more-wrap { text-align: center; }
  .load-more {
    display: inline-block;
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--accent);
    border: 1px solid var(--accent);
    padding: var(--space-3) var(--space-6);
    text-decoration: none;
    transition: background-color 200ms ease, color 200ms ease;
  }
  .load-more:hover, .load-more:focus-visible {
    background: var(--accent);
    color: var(--bg);
  }
</style>
