---
import PortalLayout from "../../layouts/PortalLayout.astro";
import Card from "../../components/portal/Card.astro";
import { search, browse } from "../../lib/console-api";
import type { Asset, BrowseSort } from "../../lib/console-api";

const PAGE_SIZE = 25;
const SORT_LABELS: Record<BrowseSort, string> = {
  recent: "Most recent",
  oldest: "Oldest first",
  longest: "Longest first",
  shortest: "Shortest first",
  "most-used": "Used in most projects",
};
const VALID_SORTS = Object.keys(SORT_LABELS) as BrowseSort[];

const url = Astro.url;
const q = (url.searchParams.get("q") ?? "").trim();
const sortParam = (url.searchParams.get("sort") ?? "recent") as BrowseSort;
const sort: BrowseSort = VALID_SORTS.includes(sortParam) ? sortParam : "recent";
const limit = (() => {
  const n = parseInt(url.searchParams.get("limit") ?? "", 10);
  return Number.isFinite(n) && n > 0 ? Math.min(n, 500) : PAGE_SIZE;
})();
const category = url.searchParams.get("category") ?? "all";
const contentType = url.searchParams.get("content_type") ?? "all";

let results: Asset[] = [];
let fetchError: string | null = null;
let total = 0;
let truncated = false;
let mode: "search" | "browse" = q.length > 0 ? "search" : "browse";

if (mode === "search") {
  const res = await search(q, { limit });
  if (res.ok) {
    results = res.data.results;
    total = results.length;
    truncated = results.length === limit;
  } else {
    fetchError = res.error.kind === "http" ? `HTTP ${res.error.status}` : res.error.kind;
  }
} else {
  const res = await browse({
    sort,
    limit,
    category: category !== "all" ? category : undefined,
    content_type: contentType !== "all" ? contentType : undefined,
  });
  if (res.ok) {
    results = res.data.results;
    total = res.data.total;
    truncated = limit < total;
  } else {
    fetchError = res.error.kind === "http" ? `HTTP ${res.error.status}` : res.error.kind;
  }
}

// For search mode we still apply client-side category/content_type filters
// because /search doesn't accept those params. For browse mode the engine
// has already filtered, so the filter is a no-op.
const filtered = mode === "search"
  ? results.filter(
      (r) =>
        (category === "all" || r.category === category) &&
        (contentType === "all" || r.content_type === contentType),
    )
  : results;

const categoriesPresent = Array.from(new Set(results.map((r) => r.category))).sort();
const contentTypesPresent = Array.from(
  new Set(results.map((r) => r.content_type).filter((c): c is string => !!c)),
).sort();

const nextLimit = limit + PAGE_SIZE;
const buildHref = (overrides: Record<string, string | null>): string => {
  const p = new URLSearchParams(url.searchParams);
  for (const [k, v] of Object.entries(overrides)) {
    if (v === null) p.delete(k);
    else p.set(k, v);
  }
  const qs = p.toString();
  return qs ? `/portal/library?${qs}` : "/portal/library";
};
---

<PortalLayout title="Library" current="library">
  <section class="surface">
    <header class="surface-head">
      <div>
        <p class="eyebrow">Library</p>
        <h1 class="title">{mode === "search" ? `Results for "${q}"` : "Browse the catalog"}</h1>
      </div>
    </header>

    <form method="GET" action="/portal/library" class="search-form" role="search">
      <input
        type="search"
        name="q"
        value={q}
        placeholder="Search transcripts, summaries, tags, names…"
        autocomplete="off"
        spellcheck="false"
        aria-label="Search the catalog"
      />
      {mode === "browse" && (
        <label class="sort-pick">
          Sort by
          <select name="sort" onchange="this.form.submit()">
            {VALID_SORTS.map((s) => (
              <option value={s} selected={s === sort}>{SORT_LABELS[s]}</option>
            ))}
          </select>
        </label>
      )}
      <button type="submit">{mode === "search" ? "Search" : "Apply"}</button>
      {(q || sort !== "recent" || category !== "all" || contentType !== "all") && (
        <a class="reset" href="/portal/library">Clear</a>
      )}
    </form>

    {fetchError ? (
      <p class="error" role="alert">Couldn't load: {fetchError}</p>
    ) : (
      <>
        <div class="result-meta">
          <p class="count">
            <strong>{filtered.length}</strong> of {total.toLocaleString()} {filtered.length === 1 ? "result" : "results"}
            {category !== "all" && <> in <code>{category}</code></>}
            {contentType !== "all" && <> · <code>{contentType}</code></>}
            {mode === "browse" && <span class="muted"> · {SORT_LABELS[sort].toLowerCase()}</span>}
            <a class="trash-link" href="/portal/stale">view stale queue →</a>
            <a class="trash-link" href="/portal/trash">view trash →</a>
          </p>

          {categoriesPresent.length > 1 && (
            <ul class="chips" role="list" aria-label="Filter by category">
              <li>
                <a
                  href={buildHref({ category: null })}
                  class:list={["chip", { active: category === "all" }]}
                >all</a>
              </li>
              {categoriesPresent.map((c) => (
                <li>
                  <a
                    href={buildHref({ category: c })}
                    class:list={["chip", { active: category === c }]}
                  >{c.replace(/_/g, " ")}</a>
                </li>
              ))}
            </ul>
          )}

          {contentTypesPresent.length > 1 && (
            <ul class="chips chips-content" role="list" aria-label="Filter by content type">
              <li>
                <a
                  href={buildHref({ content_type: null })}
                  class:list={["chip", { active: contentType === "all" }]}
                >any type</a>
              </li>
              {contentTypesPresent.map((ct) => (
                <li>
                  <a
                    href={buildHref({ content_type: ct })}
                    class:list={["chip", { active: contentType === ct }]}
                  >{ct}</a>
                </li>
              ))}
            </ul>
          )}
        </div>

        {filtered.length === 0 ? (
          <p class="no-results">Nothing matches{(category !== "all" || contentType !== "all") && <> with these filters</>}.</p>
        ) : (
          <ul class="cards">
            {filtered.map((item) => (
              <li><Card item={item} /></li>
            ))}
          </ul>
        )}

        {truncated && filtered.length > 0 && (
          <p class="load-more-wrap">
            <a class="load-more" href={buildHref({ limit: String(nextLimit) })}>
              Load more ({Math.min(nextLimit, total).toLocaleString()} of {total.toLocaleString()})
            </a>
          </p>
        )}
      </>
    )}
  </section>
</PortalLayout>

<style>
  .surface {
    display: grid;
    gap: var(--space-6);
  }

  .surface-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-6);
    flex-wrap: wrap;
  }
  .eyebrow {
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--muted);
  }
  .title {
    font-size: var(--fs-title);
    font-weight: var(--fw-bold);
    letter-spacing: var(--ls-title);
    line-height: var(--lh-title);
    margin-top: var(--space-1);
  }

  .search-form {
    display: flex;
    gap: var(--space-3);
    align-items: center;
    flex-wrap: wrap;
  }
  .sort-pick {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--muted);
  }
  .sort-pick select {
    font: inherit;
    color: var(--text);
    background: transparent;
    border: 1px solid var(--line);
    padding: var(--space-2) var(--space-3);
    text-transform: none;
    letter-spacing: 0;
    cursor: pointer;
  }
  input[type="search"] {
    flex: 1;
    min-width: 14rem;
    font: inherit;
    color: var(--text);
    background: transparent;
    border: 1px solid var(--line);
    padding: var(--space-3) var(--space-4);
    outline: none;
    transition: border-color 160ms ease;
  }
  input[type="search"]:focus-visible {
    border-color: var(--accent);
  }
  .search-form button {
    font: inherit;
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--accent);
    background: transparent;
    border: 1px solid var(--accent);
    padding: var(--space-3) var(--space-5);
    cursor: pointer;
    transition: background-color 200ms ease, color 200ms ease;
  }
  .search-form button:hover,
  .search-form button:focus-visible {
    background: var(--accent);
    color: var(--bg);
  }
  .reset {
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--muted);
    align-self: center;
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-underline-offset: 4px;
  }
  .reset:hover { color: var(--accent); text-decoration-color: var(--accent); }

  .result-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }
  .count { font-size: var(--fs-small); }
  .count strong { color: var(--accent); }
  .count code {
    font-family: inherit;
    background: var(--ink);
    color: var(--ink-fg);
    padding: 1px 6px;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .count .muted { color: var(--muted); }
  .trash-link {
    margin-left: var(--space-3);
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--muted);
  }
  .trash-link:hover { color: var(--accent); }

  .chips {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .chip {
    display: inline-block;
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--muted);
    border: 1px solid var(--line);
    padding: 5px 9px;
    text-decoration: none;
    transition: color 160ms ease, border-color 160ms ease;
  }
  .chip:hover { color: var(--text); border-color: var(--text); }
  .chip.active {
    color: var(--bg);
    background: var(--accent);
    border-color: var(--accent);
  }

  .error {
    padding: var(--space-3) var(--space-4);
    border-left: 2px solid var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    font-size: var(--fs-small);
  }
  .no-results { color: var(--muted); font-style: italic; }

  .cards {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
  }

  .load-more-wrap { text-align: center; }
  .load-more {
    display: inline-block;
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--accent);
    border: 1px solid var(--accent);
    padding: var(--space-3) var(--space-6);
    text-decoration: none;
    transition: background-color 200ms ease, color 200ms ease;
  }
  .load-more:hover, .load-more:focus-visible {
    background: var(--accent);
    color: var(--bg);
  }
</style>
