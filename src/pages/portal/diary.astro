---
import PortalLayout from "../../layouts/PortalLayout.astro";
import EmptyState from "../../components/portal/EmptyState.astro";
import { getRecentEntries, type DiaryEntry } from "../../lib/diary-notion";
import { diaryCandidates, surprise } from "../../lib/console-api";
import type { LyricCandidate, SurpriseItem } from "../../lib/console-types";

const url = Astro.url;
const ok = url.searchParams.get("ok") === "1";
const errorKind = url.searchParams.get("error");

let entries: DiaryEntry[] = [];
let fetchError: string | null = null;
try {
  entries = await getRecentEntries(50);
} catch (e) {
  fetchError = e instanceof Error ? e.message : "fetch failed";
}

let candidates: LyricCandidate[] = [];
try {
  const res = await diaryCandidates({ limit: 8, minScore: 0.6 });
  if (res.ok) candidates = res.data.candidates;
} catch {
  // engine unreachable; skip candidates section
}

// ── Song Pitch (Spark) ─────────────────────────────────────────────────────
// Pair a random thought from the Notion diary with a random audio seed from
// the Surprise picker. The juxtaposition is the pitch; the user's brain does
// the connecting. Nothing is synthesized.
let pitchThought: DiaryEntry | null = null;
let pitchSeed: SurpriseItem | null = null;
if (entries.length > 0) {
  pitchThought = entries[Math.floor(Math.random() * entries.length)];
}
try {
  // mark=false so browsing the Diary doesn't pollute the surfaced-recency
  // signal on the picker; the Surprise tab is still the canonical surface.
  const sres = await surprise({ n: 8, mark: false });
  if (sres.ok && sres.data.items.length > 0) {
    pitchSeed = sres.data.items[Math.floor(Math.random() * sres.data.items.length)];
  }
} catch {
  // engine unreachable; skip the seed half
}

function audioCtx(seed: SurpriseItem): string {
  const bits: string[] = [];
  if (seed.duration_seconds) {
    const m = Math.floor(seed.duration_seconds / 60);
    const s = Math.floor(seed.duration_seconds % 60);
    bits.push(`${m}:${String(s).padStart(2, "0")}`);
  }
  if (seed.bpm) bits.push(`${Math.round(seed.bpm)} BPM`);
  if (seed.key) bits.push(seed.key);
  if (seed.mood) bits.push(seed.mood.split(",")[0].trim());
  return bits.join(" · ");
}

function seedTitle(seed: SurpriseItem): string {
  return seed.display_name || seed.filename;
}

function relativeTime(iso: string): string {
  const then = new Date(iso).getTime();
  const now = Date.now();
  const diff = Math.max(0, now - then);
  const m = Math.floor(diff / 60_000);
  if (m < 1) return "just now";
  if (m < 60) return `${m}m ago`;
  const h = Math.floor(m / 60);
  if (h < 24) return `${h}h ago`;
  const d = Math.floor(h / 24);
  if (d < 30) return `${d}d ago`;
  return new Date(iso).toLocaleDateString();
}

const errorMessage =
  errorKind === "empty"
    ? "Capture was empty."
    : errorKind === "parse"
      ? "Couldn't read the form."
      : errorKind === "notion"
        ? "Couldn't save to Notion. Check the function logs."
        : null;
---

<PortalLayout title="Diary" current="diary">
  <section class="surface">
    <header class="surface-head">
      <div>
        <p class="eyebrow">Diary</p>
        <h1 class="title">Thoughts &amp; Lyrics</h1>
      </div>
    </header>

    {(pitchThought || pitchSeed) && (
      <section class="pitch" aria-labelledby="pitch-heading">
        <header class="pitch-head">
          <p class="pitch-eyebrow" id="pitch-heading">Song pitch</p>
          <a class="shuffle" href={url.pathname} aria-label="Shuffle pitch">↻ Shuffle</a>
        </header>
        <div class="pitch-cols">
          <div class="pitch-col pitch-thought">
            <p class="pitch-side-eyebrow">Thought</p>
            {pitchThought ? (
              <blockquote class="pitch-text">{pitchThought.text}</blockquote>
            ) : (
              <p class="pitch-empty">No diary entries yet.</p>
            )}
          </div>
          <div class="pitch-col pitch-seed">
            <p class="pitch-side-eyebrow">Seed</p>
            {pitchSeed ? (
              <>
                <p class="pitch-title">{seedTitle(pitchSeed)}</p>
                {pitchSeed.summary && <p class="pitch-summary">{pitchSeed.summary}</p>}
                <p class="pitch-ctx">{audioCtx(pitchSeed)}</p>
                <audio
                  controls
                  preload="none"
                  src={`/api/console/asset?path=${encodeURIComponent(pitchSeed.path)}`}
                ></audio>
              </>
            ) : (
              <p class="pitch-empty">Engine unreachable — no seed available.</p>
            )}
          </div>
        </div>
      </section>
    )}

    <form method="POST" action="/api/console/diary" class="capture">
      <label class="visually-hidden" for="capture-text">Capture a thought or lyric</label>
      <textarea
        id="capture-text"
        name="text"
        rows="3"
        placeholder="Capture a thought, lyric fragment, or anything worth keeping."
        required
        autocomplete="off"
        spellcheck="false"
      ></textarea>
      <div class="capture-row">
        {errorMessage && <p class="error" role="alert">{errorMessage}</p>}
        {ok && <p class="ok" role="status">Saved.</p>}
        <button type="submit">Save</button>
      </div>
    </form>

    {candidates.length > 0 && (
      <section class="candidates" aria-labelledby="candidates-heading">
        <header class="candidates-head">
          <h2 id="candidates-heading" class="candidates-title">From your voice memos</h2>
          <p class="candidates-hint">Fragments that look like they could be lyrics. Click <strong>Capture</strong> to add to your Thoughts &amp; Lyrics page.</p>
        </header>
        <ul class="candidate-list" role="list">
          {candidates.map((c) => (
            <li class="candidate">
              <p class="candidate-text">"{c.fragment}"</p>
              <p class="candidate-meta">
                <span class="score">{(c.score * 100).toFixed(0)}%</span>
                <span class="reasons">{c.reasons.join(" · ")}</span>
              </p>
              <p class="candidate-source">from <code>{c.asset.filename}</code></p>
              <form method="POST" action="/api/console/diary" class="candidate-form">
                <input type="hidden" name="text" value={c.fragment} />
                <button type="submit" class="candidate-capture">Capture</button>
              </form>
            </li>
          ))}
        </ul>
      </section>
    )}

    {fetchError ? (
      <p class="error" role="alert">Couldn't load entries: {fetchError}</p>
    ) : entries.length === 0 ? (
      <EmptyState
        title="No entries yet"
        body="Anything you save here lands in the Thoughts & Lyrics page in your Notion KB."
      />
    ) : (
      <ul class="entries" role="list">
        {entries.map((e) => (
          <li class="entry">
            <p class="text">{e.text}</p>
            <p class="meta"><time datetime={e.createdAt}>{relativeTime(e.createdAt)}</time></p>
          </li>
        ))}
      </ul>
    )}
  </section>
</PortalLayout>

<style>
  .surface {
    display: grid;
    gap: var(--space-6);
  }

  .surface-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-6);
    flex-wrap: wrap;
  }
  .eyebrow {
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--muted);
  }
  .title {
    font-size: var(--fs-title);
    font-weight: var(--fw-bold);
    letter-spacing: var(--ls-title);
    line-height: var(--lh-title);
    margin-top: var(--space-1);
  }

  .pitch {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-5);
    border: 1px solid var(--accent);
    background: color-mix(in srgb, var(--accent) 4%, transparent);
  }
  .pitch-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
  }
  .pitch-eyebrow {
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--accent);
    margin: 0;
  }
  .shuffle {
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
    padding: 4px 10px;
    border: 1px solid var(--line);
    transition: border-color 160ms ease, color 160ms ease;
  }
  .shuffle:hover, .shuffle:focus-visible {
    border-color: var(--accent);
    color: var(--accent);
  }
  .pitch-cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-5);
  }
  @media (max-width: 640px) {
    .pitch-cols { grid-template-columns: 1fr; }
  }
  .pitch-col {
    display: grid;
    gap: var(--space-3);
  }
  .pitch-side-eyebrow {
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--muted);
    margin: 0;
  }
  .pitch-text {
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.5;
    border-left: 2px solid var(--accent);
    padding-left: var(--space-3);
    color: var(--text);
    font-style: italic;
  }
  .pitch-title {
    margin: 0;
    font-size: 1rem;
    font-weight: var(--fw-semibold);
    color: var(--text);
    word-break: break-word;
  }
  .pitch-summary {
    margin: 0;
    font-size: var(--fs-small);
    color: var(--muted);
    line-height: 1.5;
    max-width: 50ch;
  }
  .pitch-ctx {
    margin: 0;
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .pitch audio {
    width: 100%;
    max-width: 28rem;
  }
  .pitch-empty {
    color: var(--muted);
    font-style: italic;
    margin: 0;
  }

  .capture {
    display: grid;
    gap: var(--space-3);
  }
  textarea {
    font: inherit;
    color: var(--text);
    background: transparent;
    border: 1px solid var(--line);
    padding: var(--space-3) var(--space-4);
    outline: none;
    resize: vertical;
    transition: border-color 160ms ease;
  }
  textarea:focus-visible {
    border-color: var(--accent);
  }

  .capture-row {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }
  .capture-row button {
    font: inherit;
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--accent);
    background: transparent;
    border: 1px solid var(--accent);
    padding: var(--space-3) var(--space-5);
    cursor: pointer;
    transition: background-color 200ms ease, color 200ms ease;
  }
  .capture-row button:hover,
  .capture-row button:focus-visible {
    background: var(--accent);
    color: var(--bg);
  }
  .ok {
    font-size: var(--fs-small);
    color: var(--muted);
  }
  .error {
    padding: var(--space-2) var(--space-3);
    border-left: 2px solid var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    font-size: var(--fs-small);
  }

  .entries {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-4);
  }
  .entry {
    padding: var(--space-4);
    border: 1px solid var(--line);
    display: grid;
    gap: var(--space-2);
  }
  .text {
    margin: 0;
    white-space: pre-wrap;
    font-size: var(--fs-body);
    line-height: 1.55;
  }
  .meta {
    margin: 0;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }

  .candidates {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-4);
    border: 1px dashed var(--line);
  }
  .candidates-head { display: grid; gap: var(--space-1); }
  .candidates-title {
    margin: 0;
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--muted);
  }
  .candidates-hint {
    margin: 0;
    font-size: var(--fs-small);
    color: var(--muted);
  }
  .candidate-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-3);
  }
  .candidate {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    background: color-mix(in srgb, var(--accent) 4%, transparent);
    border-left: 2px solid var(--accent);
  }
  .candidate-text {
    margin: 0;
    font-size: var(--fs-body);
    font-style: italic;
    line-height: 1.4;
  }
  .candidate-meta {
    margin: 0;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    display: flex;
    gap: var(--space-3);
    align-items: baseline;
    flex-wrap: wrap;
  }
  .candidate-meta .score {
    color: var(--accent);
    font-weight: var(--fw-semibold);
  }
  .candidate-source {
    margin: 0;
    font-size: 11px;
    color: var(--muted);
  }
  .candidate-source code {
    font-family: inherit;
    background: var(--ink);
    color: var(--ink-fg);
    padding: 1px 5px;
  }
  .candidate-form { margin: 0; }
  .candidate-capture {
    font: inherit;
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--accent);
    background: transparent;
    border: 1px solid var(--accent);
    padding: 4px 10px;
    cursor: pointer;
    transition: background-color 200ms ease, color 200ms ease;
  }
  .candidate-capture:hover, .candidate-capture:focus-visible {
    background: var(--accent);
    color: var(--bg);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
