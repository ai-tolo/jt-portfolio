---
import PortalLayout from "../../layouts/PortalLayout.astro";
import EmptyState from "../../components/portal/EmptyState.astro";
import { getRecentEntries, type DiaryEntry } from "../../lib/diary-notion";
import { diaryCandidates } from "../../lib/console-api";
import type { LyricCandidate } from "../../lib/console-types";

const url = Astro.url;
const ok = url.searchParams.get("ok") === "1";
const errorKind = url.searchParams.get("error");

let entries: DiaryEntry[] = [];
let fetchError: string | null = null;
try {
  entries = await getRecentEntries(50);
} catch (e) {
  fetchError = e instanceof Error ? e.message : "fetch failed";
}

let candidates: LyricCandidate[] = [];
try {
  const res = await diaryCandidates({ limit: 8, minScore: 0.6 });
  if (res.ok) candidates = res.data.candidates;
} catch {
  // engine unreachable; skip candidates section
}

function relativeTime(iso: string): string {
  const then = new Date(iso).getTime();
  const now = Date.now();
  const diff = Math.max(0, now - then);
  const m = Math.floor(diff / 60_000);
  if (m < 1) return "just now";
  if (m < 60) return `${m}m ago`;
  const h = Math.floor(m / 60);
  if (h < 24) return `${h}h ago`;
  const d = Math.floor(h / 24);
  if (d < 30) return `${d}d ago`;
  return new Date(iso).toLocaleDateString();
}

const errorMessage =
  errorKind === "empty"
    ? "Capture was empty."
    : errorKind === "parse"
      ? "Couldn't read the form."
      : errorKind === "notion"
        ? "Couldn't save to Notion. Check the function logs."
        : null;
---

<PortalLayout title="Diary" current="diary">
  <section class="surface">
    <header class="surface-head">
      <div>
        <p class="eyebrow">Diary</p>
        <h1 class="title">Thoughts &amp; Lyrics</h1>
      </div>
    </header>

    <form method="POST" action="/api/console/diary" class="capture">
      <label class="visually-hidden" for="capture-text">Capture a thought or lyric</label>
      <textarea
        id="capture-text"
        name="text"
        rows="3"
        placeholder="Capture a thought, lyric fragment, or anything worth keeping."
        required
        autocomplete="off"
        spellcheck="false"
      ></textarea>
      <div class="capture-row">
        {errorMessage && <p class="error" role="alert">{errorMessage}</p>}
        {ok && <p class="ok" role="status">Saved.</p>}
        <button type="submit">Save</button>
      </div>
    </form>

    {candidates.length > 0 && (
      <section class="candidates" aria-labelledby="candidates-heading">
        <header class="candidates-head">
          <h2 id="candidates-heading" class="candidates-title">From your voice memos</h2>
          <p class="candidates-hint">Fragments that look like they could be lyrics. Click <strong>Capture</strong> to add to your Thoughts &amp; Lyrics page.</p>
        </header>
        <ul class="candidate-list" role="list">
          {candidates.map((c) => (
            <li class="candidate">
              <p class="candidate-text">"{c.fragment}"</p>
              <p class="candidate-meta">
                <span class="score">{(c.score * 100).toFixed(0)}%</span>
                <span class="reasons">{c.reasons.join(" · ")}</span>
              </p>
              <p class="candidate-source">from <code>{c.asset.filename}</code></p>
              <form method="POST" action="/api/console/diary" class="candidate-form">
                <input type="hidden" name="text" value={c.fragment} />
                <button type="submit" class="candidate-capture">Capture</button>
              </form>
            </li>
          ))}
        </ul>
      </section>
    )}

    {fetchError ? (
      <p class="error" role="alert">Couldn't load entries: {fetchError}</p>
    ) : entries.length === 0 ? (
      <EmptyState
        title="No entries yet"
        body="Anything you save here lands in the Thoughts & Lyrics page in your Notion KB."
      />
    ) : (
      <ul class="entries" role="list">
        {entries.map((e) => (
          <li class="entry">
            <p class="text">{e.text}</p>
            <p class="meta"><time datetime={e.createdAt}>{relativeTime(e.createdAt)}</time></p>
          </li>
        ))}
      </ul>
    )}
  </section>
</PortalLayout>

<style>
  .surface {
    display: grid;
    gap: var(--space-6);
  }

  .surface-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-6);
    flex-wrap: wrap;
  }
  .eyebrow {
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--muted);
  }
  .title {
    font-size: var(--fs-title);
    font-weight: var(--fw-bold);
    letter-spacing: var(--ls-title);
    line-height: var(--lh-title);
    margin-top: var(--space-1);
  }

  .capture {
    display: grid;
    gap: var(--space-3);
  }
  textarea {
    font: inherit;
    color: var(--text);
    background: transparent;
    border: 1px solid var(--line);
    padding: var(--space-3) var(--space-4);
    outline: none;
    resize: vertical;
    transition: border-color 160ms ease;
  }
  textarea:focus-visible {
    border-color: var(--accent);
  }

  .capture-row {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }
  .capture-row button {
    font: inherit;
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--accent);
    background: transparent;
    border: 1px solid var(--accent);
    padding: var(--space-3) var(--space-5);
    cursor: pointer;
    transition: background-color 200ms ease, color 200ms ease;
  }
  .capture-row button:hover,
  .capture-row button:focus-visible {
    background: var(--accent);
    color: var(--bg);
  }
  .ok {
    font-size: var(--fs-small);
    color: var(--muted);
  }
  .error {
    padding: var(--space-2) var(--space-3);
    border-left: 2px solid var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    font-size: var(--fs-small);
  }

  .entries {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-4);
  }
  .entry {
    padding: var(--space-4);
    border: 1px solid var(--line);
    display: grid;
    gap: var(--space-2);
  }
  .text {
    margin: 0;
    white-space: pre-wrap;
    font-size: var(--fs-body);
    line-height: 1.55;
  }
  .meta {
    margin: 0;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }

  .candidates {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-4);
    border: 1px dashed var(--line);
  }
  .candidates-head { display: grid; gap: var(--space-1); }
  .candidates-title {
    margin: 0;
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--muted);
  }
  .candidates-hint {
    margin: 0;
    font-size: var(--fs-small);
    color: var(--muted);
  }
  .candidate-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-3);
  }
  .candidate {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    background: color-mix(in srgb, var(--accent) 4%, transparent);
    border-left: 2px solid var(--accent);
  }
  .candidate-text {
    margin: 0;
    font-size: var(--fs-body);
    font-style: italic;
    line-height: 1.4;
  }
  .candidate-meta {
    margin: 0;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    display: flex;
    gap: var(--space-3);
    align-items: baseline;
    flex-wrap: wrap;
  }
  .candidate-meta .score {
    color: var(--accent);
    font-weight: var(--fw-semibold);
  }
  .candidate-source {
    margin: 0;
    font-size: 11px;
    color: var(--muted);
  }
  .candidate-source code {
    font-family: inherit;
    background: var(--ink);
    color: var(--ink-fg);
    padding: 1px 5px;
  }
  .candidate-form { margin: 0; }
  .candidate-capture {
    font: inherit;
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--accent);
    background: transparent;
    border: 1px solid var(--accent);
    padding: 4px 10px;
    cursor: pointer;
    transition: background-color 200ms ease, color 200ms ease;
  }
  .candidate-capture:hover, .candidate-capture:focus-visible {
    background: var(--accent);
    color: var(--bg);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
