---
import PortalLayout from "../../layouts/PortalLayout.astro";
import DeskView from "../../components/portal/DeskView.astro";
import { getDeskPlan, type DeskPlan } from "../../lib/desk-notion";

let plan: DeskPlan;
try {
  plan = await getDeskPlan();
} catch (e) {
  plan = {
    spine: null, otherArcs: [], weeks: [], onTheDesk: [], beats: [],
    error: e instanceof Error ? e.message : "failed to load the plan",
  };
}
---

<PortalLayout title="The Desk" current="desk">
  <DeskView plan={plan} />
</PortalLayout>
