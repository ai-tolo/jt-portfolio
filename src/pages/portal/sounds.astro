---
import PortalLayout from "../../layouts/PortalLayout.astro";
import { listSounds } from "../../lib/console-api";
import type { SoundsItem } from "../../lib/console-types";

// /portal/sounds — curator-side staging surface for the public Sounds
// page. Lists every asset flagged public=1, grouped by `collection`
// label, with inline player + rename-collection + unpublish controls.
//
// Lineage to the engineer pipeline surfaces when present so the
// curator can jump back to the king mix on /portal/engineer for
// further refinement.
//
// Public-facing read-only view stays at uxjon.com/sounds (the older
// file at src/pages/sounds.astro). This page is the editor.

let items: SoundsItem[] = [];
let collections: string[] = [];
let fetchError: string | null = null;

try {
  const res = await listSounds();
  if (res.ok) {
    items = res.data.items;
    collections = res.data.collections;
  } else {
    fetchError =
      res.error.kind === "http"
        ? `engine returned ${res.error.status}`
        : "engine unreachable";
  }
} catch (e) {
  fetchError = e instanceof Error ? e.message : "unknown error";
}

// Group items by collection in display order. NULL collection lands
// under "(no collection)" at the end.
const ungrouped: SoundsItem[] = [];
const grouped: Map<string, SoundsItem[]> = new Map();
for (const c of collections) grouped.set(c, []);
for (const item of items) {
  if (item.collection) {
    if (!grouped.has(item.collection)) grouped.set(item.collection, []);
    grouped.get(item.collection)!.push(item);
  } else {
    ungrouped.push(item);
  }
}

function trackTitle(item: SoundsItem): string {
  if (item.display_name) return item.display_name;
  return item.filename.replace(/\.[^.]+$/, "");
}

function fmtDuration(sec: number | null | undefined): string {
  if (!sec || !Number.isFinite(sec)) return "—:—";
  const m = Math.floor(sec / 60);
  const s = Math.floor(sec % 60);
  return `${m}:${String(s).padStart(2, "0")}`;
}

function audioUrl(path: string): string {
  return `/api/console/asset?path=${encodeURIComponent(path)}&variant=opus`;
}
---

<PortalLayout title="Sounds · Portal" current="sounds">
  <section class="sounds-portal">
    <header class="intro">
      <h1>Sounds</h1>
      <p class="lede">
        Your staging surface for finished mixes. Tracks land here when
        you publish a king from <a href="/portal/engineer">Engineer</a>.
        Group them into collections (EP ideas, album drafts) or
        unpublish. The public-facing view lives at <a href="/sounds" target="_blank" rel="noopener">/sounds</a>.
      </p>
      {fetchError && (
        <p class="notice">Engine unreachable: {fetchError}.</p>
      )}
    </header>

    <div class="counter-row">
      <span class="counter">
        <span class="num">{items.length}</span>
        <span class="lbl">published</span>
      </span>
      <span class="counter">
        <span class="num">{collections.length}</span>
        <span class="lbl">collections</span>
      </span>
      <span class="counter">
        <span class="num">{ungrouped.length}</span>
        <span class="lbl">ungrouped</span>
      </span>
    </div>

    {items.length === 0 ? (
      <p class="empty">
        Nothing published yet. Crown a king on a Winners card in
        <a href="/portal/engineer">Engineer</a> and click "Publish to Sounds"
        to populate this surface.
      </p>
    ) : (
      <div class="groups">
        {Array.from(grouped.entries()).map(([collection, groupItems]) => (
          <section class="group" data-collection={collection}>
            <h2 class="group-head">
              <span class="group-title">{collection}</span>
              <span class="group-count">{groupItems.length}</span>
            </h2>
            <ul class="track-list">
              {groupItems.map((item) => (
                <li class="track" data-asset-id={item.asset_id} data-track-row>
                  <button
                    class="track-play"
                    type="button"
                    data-audio-url={audioUrl(item.path)}
                    aria-label={`Play ${trackTitle(item)}`}
                  >▶</button>
                  <div class="track-meta">
                    <span class="track-title">{trackTitle(item)}</span>
                    <span class="track-sub">
                      {fmtDuration(item.duration_seconds)}
                      {item.source_display_name && (
                        <> · from <span class="track-source">{item.source_display_name}</span></>
                      )}
                    </span>
                  </div>
                  <input
                    class="track-collection"
                    type="text"
                    data-collection-input
                    value={item.collection || ""}
                    placeholder="collection"
                    aria-label="Collection label"
                  />
                  <button
                    class="track-unpublish"
                    type="button"
                    data-unpublish
                    aria-label="Unpublish this track"
                    title="Unpublish"
                  >✕</button>
                </li>
              ))}
            </ul>
          </section>
        ))}

        {ungrouped.length > 0 && (
          <section class="group group-ungrouped">
            <h2 class="group-head">
              <span class="group-title">(no collection)</span>
              <span class="group-count">{ungrouped.length}</span>
            </h2>
            <ul class="track-list">
              {ungrouped.map((item) => (
                <li class="track" data-asset-id={item.asset_id} data-track-row>
                  <button
                    class="track-play"
                    type="button"
                    data-audio-url={audioUrl(item.path)}
                    aria-label={`Play ${trackTitle(item)}`}
                  >▶</button>
                  <div class="track-meta">
                    <span class="track-title">{trackTitle(item)}</span>
                    <span class="track-sub">
                      {fmtDuration(item.duration_seconds)}
                      {item.source_display_name && (
                        <> · from <span class="track-source">{item.source_display_name}</span></>
                      )}
                    </span>
                  </div>
                  <input
                    class="track-collection"
                    type="text"
                    data-collection-input
                    value={item.collection || ""}
                    placeholder="collection (e.g. Audio Amnesia EP)"
                    aria-label="Collection label"
                  />
                  <button
                    class="track-unpublish"
                    type="button"
                    data-unpublish
                    aria-label="Unpublish this track"
                    title="Unpublish"
                  >✕</button>
                </li>
              ))}
            </ul>
          </section>
        )}
      </div>
    )}
  </section>
</PortalLayout>

<style>
  .sounds-portal {
    max-width: 1100px;
    margin: 0 auto;
    padding: 24px 16px 64px;
    color: var(--ink);
  }
  .intro h1 {
    font-size: 28px;
    margin: 0 0 6px;
    letter-spacing: 0.02em;
  }
  .lede {
    margin: 0 0 12px;
    opacity: 0.78;
    line-height: 1.45;
    max-width: 640px;
  }
  .lede a { color: #0ec4fc; }
  .notice {
    font-size: 13px;
    color: #b54;
    background: rgba(181, 84, 68, 0.08);
    padding: 8px 12px;
    border-radius: 4px;
    margin: 8px 0 0;
  }
  .counter-row {
    display: flex;
    gap: 16px;
    margin: 16px 0 24px;
  }
  .counter {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    padding: 6px 12px;
    border-radius: 999px;
    background: rgba(245, 241, 232, 0.05);
    border: 1px solid rgba(245, 241, 232, 0.18);
  }
  .counter .num {
    font: 800 13px ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  .counter .lbl {
    font-size: 10.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.7;
  }
  .empty {
    font-size: 13px;
    opacity: 0.7;
    line-height: 1.5;
  }
  .empty a { color: #0ec4fc; }
  .groups {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .group-head {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin: 0 0 10px;
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .group-title {
    font-weight: 700;
    color: #00ff4d;
  }
  .group-count {
    background: var(--ink);
    color: var(--ink-fg);
    padding: 1px 7px;
    border-radius: 99px;
    font-size: 11px;
  }
  .group-ungrouped .group-title {
    color: rgba(245, 241, 232, 0.55);
    font-style: italic;
  }
  .track-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .track {
    display: grid;
    grid-template-columns: 36px 1fr 200px 32px;
    gap: 10px;
    align-items: center;
    padding: 8px 12px;
    background: rgba(245, 241, 232, 0.04);
    border: 1px solid rgba(245, 241, 232, 0.12);
    border-radius: 4px;
  }
  .track-play {
    width: 28px;
    height: 28px;
    border-radius: 4px;
    background: #0ec4fc;
    color: #0d060f;
    border: 1px solid #0ec4fc;
    font-size: 0;
    cursor: pointer;
    font-weight: 700;
    transition: background 120ms ease, transform 80ms ease;
  }
  .track-play::before { content: "▶"; font-size: 11px; }
  .track-play[data-state="playing"] { background: #ff3b6e; border-color: #ff3b6e; color: #fff; }
  .track-play[data-state="playing"]::before { content: "■"; }
  .track-play:hover { transform: translateY(-1px); }
  .track-meta {
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
  }
  .track-title {
    font: 700 13px ui-monospace, SFMono-Regular, Menlo, monospace;
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .track-sub {
    font: 500 11px ui-monospace, SFMono-Regular, Menlo, monospace;
    color: rgba(245, 241, 232, 0.55);
  }
  .track-source { color: #6fdfff; }
  .track-collection {
    background: rgba(0, 0, 0, 0.18);
    border: 1px solid rgba(245, 241, 232, 0.18);
    border-radius: 3px;
    padding: 6px 8px;
    color: var(--ink);
    font: 500 12px ui-monospace, SFMono-Regular, Menlo, monospace;
    width: 100%;
    box-sizing: border-box;
  }
  .track-collection::placeholder { color: rgba(245, 241, 232, 0.35); }
  .track-collection:focus {
    outline: none;
    border-color: rgba(14, 196, 252, 0.55);
  }
  .track-unpublish {
    width: 28px;
    height: 28px;
    border-radius: 4px;
    background: transparent;
    color: rgba(255, 110, 33, 0.65);
    border: 1px solid rgba(255, 110, 33, 0.32);
    font-size: 13px;
    cursor: pointer;
    transition: all 120ms ease;
  }
  .track-unpublish:hover {
    color: #ff6e21;
    border-color: #ff6e21;
    background: rgba(255, 110, 33, 0.10);
  }
  @media (max-width: 640px) {
    .track {
      grid-template-columns: 36px 1fr 32px;
      grid-template-rows: auto auto;
    }
    .track-collection {
      grid-column: 1 / -1;
    }
  }
</style>

<script>
  // ── Sounds page controller ────────────────────────────────────────
  // Singleton audio so only one track plays at a time. Click ▶ to play
  // or stop. Collection input commits on blur or Enter. Unpublish (✕)
  // POSTs sounds-update with public=false then drops the row from the
  // DOM. Page reloads on collection commit so group memberships
  // re-render correctly (cheap, server-side does the grouping).

  const audio = new Audio();
  audio.preload = "auto";
  let activeBtn: HTMLButtonElement | null = null;

  function setBtnState(btn: HTMLButtonElement | null, state: "playing" | "paused") {
    if (btn) btn.dataset.state = state;
  }

  audio.addEventListener("ended", () => {
    if (activeBtn) setBtnState(activeBtn, "paused");
    activeBtn = null;
  });

  document.querySelectorAll<HTMLButtonElement>(".track-play").forEach((btn) => {
    btn.addEventListener("click", () => {
      const url = btn.dataset.audioUrl;
      if (!url) return;
      if (activeBtn === btn) {
        if (audio.paused) {
          audio.play().catch(() => {});
          setBtnState(btn, "playing");
        } else {
          audio.pause();
          setBtnState(btn, "paused");
        }
        return;
      }
      if (activeBtn) setBtnState(activeBtn, "paused");
      activeBtn = btn;
      audio.src = url;
      audio.currentTime = 0;
      audio.play()
        .then(() => setBtnState(btn, "playing"))
        .catch(() => {
          setBtnState(btn, "paused");
          activeBtn = null;
        });
    });
  });

  document.querySelectorAll<HTMLInputElement>("[data-collection-input]").forEach((input) => {
    const commit = async () => {
      const row = input.closest<HTMLElement>("[data-track-row]");
      if (!row) return;
      const assetId = Number(row.dataset.assetId);
      const newValue = input.value.trim();
      const orig = input.defaultValue;
      if (newValue === orig) return;
      const res = await fetch("/api/console/sounds-update", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ asset_id: assetId, collection: newValue }),
      });
      if (!res.ok) {
        console.warn("collection update failed", res.status);
        input.value = orig;
        return;
      }
      // Reload so server-side grouping re-renders correctly.
      location.reload();
    };
    input.addEventListener("blur", commit);
    input.addEventListener("keydown", (e) => {
      if (e.key === "Enter") {
        e.preventDefault();
        input.blur();
      }
    });
  });

  document.querySelectorAll<HTMLButtonElement>("[data-unpublish]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const row = btn.closest<HTMLElement>("[data-track-row]");
      if (!row) return;
      const assetId = Number(row.dataset.assetId);
      btn.disabled = true;
      const res = await fetch("/api/console/sounds-update", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ asset_id: assetId, public: false }),
      });
      if (!res.ok) {
        console.warn("unpublish failed", res.status);
        btn.disabled = false;
        return;
      }
      row.style.opacity = "0.3";
      setTimeout(() => {
        location.reload();
      }, 250);
    });
  });
</script>
