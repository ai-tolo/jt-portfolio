---
import PortalLayout from "../../layouts/PortalLayout.astro";

const BUILD_3_ACTIONS = [
  {
    id: "new-project",
    label: "Drop into new project",
    detail: "Opens Ableton's recording template, splits stems at loop points, drops them in.",
  },
  {
    id: "add-existing",
    label: "Add to existing project",
    detail: "Tempo-conforms the file and fires it into the next empty clip slot of the selected track.",
  },
  {
    id: "stem-split",
    label: "Separate stems",
    detail: "Splits this file into stems and saves them next to the original.",
  },
  {
    id: "open-brief",
    label: "Open with brief",
    detail: "Opens the project with a one-page resume summary of where you left off.",
  },
  {
    id: "send-preview",
    label: "Send private preview",
    detail: "Uploads as a private SoundCloud link with optional expiry and open-tracking.",
  },
];
---

<PortalLayout title="Workbench" current="workbench">
  <section class="surface">
    <header class="surface-head">
      <div>
        <p class="eyebrow">Workbench</p>
        <h1 class="title">Items you're working with</h1>
        <p class="subtitle" id="queue-summary">Loading…</p>
      </div>

      <div class="head-actions">
        <a class="listen-cta" id="listen-cta" href="/portal/listen?from=workbench">
          Send to listening room →
        </a>
      </div>
    </header>

    <p class="hint">
      Queue state lives in your browser (localStorage). <strong>Public</strong> ships items to <a href="/sounds">/sounds</a> right now. The other actions run inside Ableton via the Max for Live device, whose webview is scaffolded; the <code>.amxd</code> patcher is the remaining step before they go live.
    </p>

    <div id="empty" class="empty" hidden>
      <h2>Queue is empty</h2>
      <p>Add items to your queue from Surprise, Library, or Projects with the <strong>+ Queue</strong> button. They land here and persist across reloads.</p>
    </div>

    <ul id="queue-list" class="queue-list" aria-live="polite"></ul>

    {/* Stub action button row, repeated per card via JS template */}
    <template id="card-tpl">
      <li class="wb-card" data-path="">
        <header class="meta">
          <span class="eyebrow-row">Queued</span>
          <button type="button" class="remove" data-action="unqueue" data-path="" aria-label="Remove from queue">✕</button>
        </header>
        <h3 class="name"></h3>
        <p class="summary"></p>
        <ul class="tags"></ul>
        <p class="added"></p>

        <footer class="actions">
          {BUILD_3_ACTIONS.map((a) => (
            <button type="button" class="action" data-action-id={a.id} disabled title={`${a.detail} — pending Build 3 .amxd.`}>
              {a.label}
            </button>
          ))}
          <button type="button" class="action public-toggle" data-action="toggle-public" aria-pressed="false" title="Mark this item public on /sounds">
            ○ Public
          </button>
          <a class="action listen" data-listen-href="">Listen →</a>
        </footer>
      </li>
    </template>
  </section>
</PortalLayout>

<script>
  const QUEUE_KEY = "portal:queue";
  type QueueEntry = { path: string; addedAt: number };

  const readQueue = (): QueueEntry[] => {
    try {
      const raw = localStorage.getItem(QUEUE_KEY);
      return raw ? JSON.parse(raw) : [];
    } catch {
      return [];
    }
  };

  // Cache of last-known asset metadata per path. Populated on render so we
  // can show summaries / tags without an extra round-trip per card.
  const metaCache = new Map<string, any>();

  async function fetchMeta(path: string): Promise<any | null> {
    if (metaCache.has(path)) return metaCache.get(path);
    try {
      const url = `/api/console/asset-meta?path=${encodeURIComponent(path)}`;
      const res = await fetch(url, { headers: { accept: "application/json" } });
      if (!res.ok) return null;
      const data = await res.json();
      metaCache.set(path, data);
      return data;
    } catch {
      return null;
    }
  }

  function shortDate(ms: number): string {
    try {
      return new Date(ms).toLocaleString(undefined, {
        year: "numeric",
        month: "short",
        day: "numeric",
        hour: "numeric",
        minute: "2-digit",
      });
    } catch {
      return String(ms);
    }
  }

  function fileLabel(asset: any | null, fallback: string): string {
    if (asset?.filename) return asset.filename;
    const parts = fallback.split("/");
    return parts[parts.length - 1] || fallback;
  }

  function tagList(asset: any | null): string[] {
    if (!asset?.tags) return [];
    return String(asset.tags)
      .split(",")
      .map((t: string) => t.trim())
      .filter(Boolean)
      .slice(0, 5);
  }

  async function render() {
    const list = document.getElementById("queue-list") as HTMLUListElement;
    const empty = document.getElementById("empty") as HTMLDivElement;
    const summary = document.getElementById("queue-summary") as HTMLParagraphElement;
    const cta = document.getElementById("listen-cta") as HTMLAnchorElement;
    const tpl = document.getElementById("card-tpl") as HTMLTemplateElement;
    if (!list || !empty || !summary || !cta || !tpl) return;

    const q = readQueue().sort((a, b) => b.addedAt - a.addedAt);

    summary.textContent =
      q.length === 0
        ? "Nothing queued yet"
        : q.length === 1
          ? "1 item queued"
          : `${q.length} items queued`;

    cta.style.opacity = q.length === 0 ? "0.4" : "1";
    cta.style.pointerEvents = q.length === 0 ? "none" : "auto";

    if (q.length === 0) {
      empty.hidden = false;
      list.replaceChildren();
      return;
    }
    empty.hidden = true;

    const nodes = await Promise.all(
      q.map(async (entry) => {
        const meta = await fetchMeta(entry.path);
        const node = (tpl.content.firstElementChild!.cloneNode(true) as HTMLLIElement);
        node.dataset.path = entry.path;
        node.querySelector(".name")!.textContent = fileLabel(meta, entry.path);
        node.querySelector(".summary")!.textContent = meta?.summary ?? "";
        if (!meta?.summary) (node.querySelector(".summary") as HTMLElement).hidden = true;
        (node.querySelector(".added") as HTMLElement).textContent = `Added ${shortDate(entry.addedAt)}`;
        (node.querySelector(".remove") as HTMLButtonElement).dataset.path = entry.path;
        const tagsUl = node.querySelector(".tags") as HTMLUListElement;
        tagsUl.replaceChildren(
          ...tagList(meta).map((t) => {
            const li = document.createElement("li");
            li.textContent = t;
            return li;
          }),
        );
        if (tagsUl.children.length === 0) tagsUl.hidden = true;
        const listenA = node.querySelector(".listen") as HTMLAnchorElement;
        listenA.href = `/portal/listen?from=single&path=${encodeURIComponent(entry.path)}`;
        const pubBtn = node.querySelector(".public-toggle") as HTMLButtonElement;
        pubBtn.dataset.path = entry.path;
        applyPublicState(pubBtn, meta?.public === 1);
        return node;
      }),
    );

    list.replaceChildren(...nodes);
  }

  function applyPublicState(btn: HTMLButtonElement, isPublic: boolean) {
    btn.setAttribute("aria-pressed", isPublic ? "true" : "false");
    btn.textContent = isPublic ? "● Public" : "○ Public";
    btn.classList.toggle("on", isPublic);
  }

  // Click handling for toggle-public lives in PortalLayout (global). When it
  // fires, we drop the affected path from metaCache so the next render reads
  // fresh state instead of the pre-toggle value.
  window.addEventListener("portal:public-changed", (e) => {
    const path = (e as CustomEvent<{ path: string }>).detail?.path;
    if (path) metaCache.delete(path);
  });

  render();
  window.addEventListener("portal:queue-changed", render);
  window.addEventListener("portal:queue-removed", render);
  window.addEventListener("pageshow", render);
</script>

<style>
  .surface { display: grid; gap: var(--space-5); }
  .surface-head { display: flex; justify-content: space-between; align-items: flex-end; gap: var(--space-6); flex-wrap: wrap; }
  .eyebrow { font-size: var(--fs-eyebrow); font-weight: var(--fw-semibold); letter-spacing: var(--ls-eyebrow); text-transform: uppercase; color: var(--muted); }
  .title { font-size: var(--fs-title); font-weight: var(--fw-bold); letter-spacing: var(--ls-title); line-height: var(--lh-title); margin-top: var(--space-1); }
  .subtitle { color: var(--muted); margin-top: var(--space-2); font-size: var(--fs-small); }

  .listen-cta {
    display: inline-block;
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--accent);
    border: 1px solid var(--accent);
    padding: var(--space-3) var(--space-5);
    text-decoration: none;
    transition: background-color 200ms ease, color 200ms ease;
  }
  .listen-cta:hover, .listen-cta:focus-visible { background: var(--accent); color: var(--bg); }

  .hint {
    color: var(--muted);
    font-size: var(--fs-small);
    line-height: 1.55;
    max-width: 60ch;
  }

  .empty {
    border: 1px dashed var(--line);
    padding: var(--space-8);
    display: grid;
    gap: var(--space-3);
    max-width: 48rem;
  }
  /* `display: grid` on .empty would otherwise override the [hidden] attribute's
     default display:none. Explicit rule restores it. */
  .empty[hidden] { display: none; }
  .empty h2 { font-size: var(--fs-title); font-weight: var(--fw-bold); letter-spacing: var(--ls-title); }
  .empty p { color: var(--muted); line-height: 1.55; }

  .queue-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-4);
  }
  .wb-card {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-5);
    background: color-mix(in srgb, var(--ink) 6%, transparent);
    border: 1px solid var(--line);
  }
  .wb-card .meta { display: flex; justify-content: space-between; gap: var(--space-3); align-items: center; }
  .eyebrow-row { font-size: var(--fs-eyebrow); font-weight: var(--fw-semibold); letter-spacing: var(--ls-eyebrow); text-transform: uppercase; color: var(--muted); }

  .remove {
    font: inherit;
    font-size: 14px;
    line-height: 1;
    color: var(--muted);
    background: transparent;
    border: 1px solid var(--line);
    width: 24px;
    height: 24px;
    cursor: pointer;
    transition: color 160ms ease, border-color 160ms ease;
  }
  .remove:hover, .remove:focus-visible { color: var(--accent); border-color: var(--accent); }

  .wb-card .name { font-size: 1.0625rem; font-weight: var(--fw-semibold); word-break: break-all; }
  .wb-card .summary { font-size: var(--fs-small); line-height: 1.55; color: var(--text); max-width: 60ch; }
  .wb-card .added { font-size: var(--fs-eyebrow); color: var(--muted); }

  .tags { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 4px 6px; }
  .tags li { font-size: 11px; font-weight: var(--fw-medium); color: var(--muted); border: 1px solid var(--line); padding: 2px 6px; }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding-top: var(--space-2);
    border-top: 1px dashed var(--line);
  }
  .action {
    font: inherit;
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    padding: 6px 10px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--muted);
    cursor: not-allowed;
    text-decoration: none;
  }
  .action.listen {
    color: var(--text);
    cursor: pointer;
  }
  .action.listen:hover, .action.listen:focus-visible { border-color: var(--accent); color: var(--accent); }
  .action:disabled {
    opacity: 0.55;
  }
  .action.public-toggle {
    cursor: pointer;
    color: var(--text);
  }
  .action.public-toggle:hover,
  .action.public-toggle:focus-visible {
    border-color: var(--accent);
    color: var(--accent);
  }
  .action.public-toggle.on {
    border-color: var(--accent);
    color: var(--accent);
  }
</style>
