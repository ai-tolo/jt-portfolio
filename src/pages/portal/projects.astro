  /* ── Hold-to-archive × (mirrors engineer .pair-skip-x) ─────────────
     650ms radial-fill hold to commit; a tap is a no-op. Top-right of the
     card head. Duration kept in lockstep with ARCH_HOLD_MS below. */
  .proj-archive-x {
    position: relative;
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    align-self: center;
    background: transparent;
    color: rgba(245, 241, 232, 0.45);
    border: 1px solid rgba(255, 110, 33, 0.3);
