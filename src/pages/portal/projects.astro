    cursor: pointer;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    font: 700 14px/1 ui-sans-serif, system-ui, sans-serif;
    transition: color 160ms ease, border-color 160ms ease;
    touch-action: none;
  }
  .proj-archive-x:hover { color: #ff6e21; border-color: #ff6e21; }
  .proj-archive-x .hold-fill {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, #ff2761 0%, #ff6e21 70%);
    transform-origin: center;
    transform: scale(0);
    border-radius: 50%;
    opacity: 0;
    transition: none;
    pointer-events: none;
