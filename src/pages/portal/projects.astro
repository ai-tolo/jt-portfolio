<script>
  // Single audio element shared across project rows. Click "Audition
  // bounced" to start playback; click again to stop.
  const root = document.querySelector<HTMLElement>(".projects-page");
  if (root) {
    let audio: HTMLAudioElement | null = null;
    let activeCard: HTMLElement | null = null;

    const setStatus = (card: HTMLElement, text: string, tone: "" | "ok" | "err" = "") => {
      // Card-level actions (open/reveal/archive/collection) report in the
      // manage row — cards with prints/stems have earlier status lines, so a
      // bare "first [data-status-line]" would land in the wrong row.
      const line =
        card.querySelector<HTMLElement>(".proj-manage-row [data-status-line]") ??
        card.querySelector<HTMLElement>("[data-status-line]");
      if (!line) return;
      line.textContent = text;
      if (tone) line.setAttribute("data-tone", tone);
      else line.removeAttribute("data-tone");
    };

    const setBtnLabel = (card: HTMLElement, label: string) => {
      const btn = card.querySelector<HTMLButtonElement>('[data-action="audition-bounce"]');
      if (btn) btn.textContent = label;
    };

    const stopActive = () => {
      if (audio) audio.pause();
      if (activeCard) {
        setBtnLabel(activeCard, "▶ Audition bounced render");
        setStatus(activeCard, "");
      }
      activeCard = null;
    };

    // ── Phase B: open-in-Ableton + archive (delegated click) ──────────
    const projPostJSON = async (url: string, body: unknown) =>
      fetch(url, {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify(body),
      });

    root.addEventListener("click", async (e) => {
      const target = e.target as HTMLElement | null;
      const card = target?.closest<HTMLElement>(".proj-card");
      if (!card) return;
      const assetId = Number(card.getAttribute("data-asset-id"));
      if (!Number.isFinite(assetId)) return;

      const openBtn = target?.closest<HTMLButtonElement>('[data-action="open-project"]');
      if (openBtn) {
        const orig = openBtn.textContent;
        openBtn.disabled = true;
        openBtn.textContent = "opening…";
        setStatus(card, "");
        try {
          const res = await projPostJSON("/api/console/projects-open", { project_asset_id: assetId });
          if (res.ok) {
            openBtn.textContent = "✓ opened on M3";
            setStatus(card, "Launched in Ableton", "ok");
            setTimeout(() => { openBtn.textContent = orig; openBtn.disabled = false; }, 2500);
          } else {
            const er = await res.json().catch(() => ({}));
            setStatus(card, "Open failed: " + JSON.stringify(er.error ?? er), "err");
            openBtn.textContent = orig;
            openBtn.disabled = false;
          }
        } catch (err) {
          setStatus(card, "Open failed: " + String(err), "err");
          openBtn.textContent = orig;
          openBtn.disabled = false;
        }
        return;
      }

      const revealBtn = target?.closest<HTMLButtonElement>('[data-action="reveal-project"]');
      if (revealBtn) {
        if (revealBtn.disabled) return;
        const orig = revealBtn.textContent;
        revealBtn.disabled = true;
        revealBtn.textContent = "revealing…";
        setStatus(card, "");
        try {
          const res = await projPostJSON("/api/console/projects-reveal", { project_asset_id: assetId });
          if (res.ok) {
            revealBtn.textContent = "✓ revealed";
            setStatus(card, "Revealed in Finder on M3", "ok");
            setTimeout(() => { revealBtn.textContent = orig; revealBtn.disabled = false; setStatus(card, ""); }, 2000);
          } else {
            const msg = res.status === 404
              ? "Not reachable from this Mac — connect the T7 (or it hasn't synced)"
              : "Reveal failed";
            setStatus(card, msg, "err");
            revealBtn.textContent = orig;
            revealBtn.disabled = false;
          }
        } catch (err) {
          setStatus(card, "Reveal failed: " + String(err), "err");
          revealBtn.textContent = orig;
          revealBtn.disabled = false;
        }
        return;
      }

      const stemRevealBtn = target?.closest<HTMLButtonElement>('[data-action="reveal-stem"]');
      if (stemRevealBtn) {
        const sid = Number(stemRevealBtn.dataset.stemAssetId);
        if (!Number.isFinite(sid)) return;
        const row = stemRevealBtn.closest<HTMLElement>(".proj-export-row");
        const setRow = (t: string, tone: "" | "ok" | "err" = "") => {
          const line = row?.querySelector<HTMLElement>("[data-status-line]");
          if (!line) return;
          line.textContent = t;
          if (tone) line.setAttribute("data-tone", tone);
          else line.removeAttribute("data-tone");
        };
        const orig = stemRevealBtn.textContent;
        stemRevealBtn.disabled = true;
        stemRevealBtn.textContent = "…";
        setRow("");
        try {
          const res = await projPostJSON("/api/console/projects-reveal", { project_asset_id: sid });
          setRow(res.ok ? "revealed on M3" : (res.status === 404 ? "not on this Mac (connect T7?)" : "reveal failed"), res.ok ? "ok" : "err");
        } catch {
          setRow("reveal failed", "err");
        }
        stemRevealBtn.textContent = orig;
        stemRevealBtn.disabled = false;
        return;
      }

      const unarchiveBtn = target?.closest<HTMLButtonElement>('[data-action="unarchive-project"]');
      if (unarchiveBtn) {
        unarchiveBtn.disabled = true;
        const res = await projPostJSON("/api/console/projects-archive", {
          project_asset_id: assetId,
          archived: false,
        });
        if (res.ok) location.reload();
        else { setStatus(card, "Unarchive failed", "err"); unarchiveBtn.disabled = false; }
        return;
      }
    });

    // Collection label: commit on blur (focusout) or Enter. Mirrors the
    // Sounds page commit-on-blur pattern.
    const commitCollection = async (input: HTMLInputElement) => {
      const card = input.closest<HTMLElement>(".proj-card");
      if (!card) return;
      const assetId = Number(card.getAttribute("data-asset-id"));
      if (!Number.isFinite(assetId)) return;
      const value = input.value.trim();
      const res = await projPostJSON("/api/console/projects-update", {
        project_asset_id: assetId,
        collection: value || null,
      });
      setStatus(card, res.ok ? "Collection saved" : "Save failed", res.ok ? "ok" : "err");
      if (res.ok) setTimeout(() => setStatus(card, ""), 1500);
    };
    root.addEventListener("focusout", (e) => {
      const input = (e.target as HTMLElement | null)?.closest<HTMLInputElement>(
        '[data-action="collection-input"]',
      );
      if (input) commitCollection(input);
    });
    root.addEventListener("keydown", (e) => {
      const ke = e as KeyboardEvent;
      if (ke.key !== "Enter") return;
      const input = (ke.target as HTMLElement | null)?.closest<HTMLInputElement>(
        '[data-action="collection-input"]',
      );
      if (input) { ke.preventDefault(); input.blur(); }
    });

    root.addEventListener("click", async (e) => {
      const btn = (e.target as HTMLElement | null)?.closest<HTMLElement>(
        '[data-action="audition-bounce"]',
      );
      if (!btn) return;
      const card = btn.closest<HTMLElement>(".proj-card");
      if (!card) return;
      const path = card.dataset.bouncedPath;
      if (!path) return;

      // Toggle if same card.
      if (activeCard === card && audio && !audio.paused) {
        audio.pause();
        setBtnLabel(card, "▶ Audition bounced render");
        setStatus(card, "Paused");
        return;
      }
      stopActive();
      if (!audio) {
        audio = new Audio();
        audio.preload = "auto";
        audio.addEventListener("ended", () => {
          if (activeCard) {
            setBtnLabel(activeCard, "▶ Audition bounced render");
            setStatus(activeCard, "");
          }
          activeCard = null;
        });
        audio.addEventListener("error", () => {
          if (activeCard) setStatus(activeCard, "Failed to load", "err");
          stopActive();
        });
      }
      activeCard = card;
      setBtnLabel(card, "■ Stop");
      setStatus(card, "Streaming…");
      // Same opus-variant gate as Buckets: long renders transcode on M1.
      // We don't have duration on /projects rows so always request opus
      // for safety — bounced renders are usually full songs (>10min often
      // false, but a 200MB WAV is still painful raw). Skip if size hints
      // become available later.
      audio.src = `/api/console/asset?path=${encodeURIComponent(path)}&variant=opus`;
      try {
        await audio.play();
        setStatus(card, "Playing");
      } catch {
        setStatus(card, "Play failed", "err");
        stopActive();
      }
    });

    // Keyboard scrub for the active audition (bounced render or print).
    // ←/→ nudge ±5s on the shared <audio> singleton, matching the Buckets
    // cards and the shared WaveformPlayer. Ignores typing + modifier combos.
    document.addEventListener("keydown", (e) => {
      if (e.key !== "ArrowLeft" && e.key !== "ArrowRight") return;
      const tag = (e.target as HTMLElement | null)?.tagName?.toLowerCase();
      if (
        tag === "input" ||
        tag === "textarea" ||
        (e.target as HTMLElement | null)?.isContentEditable
      )
        return;
      if (e.metaKey || e.ctrlKey || e.altKey) return;
      const auditioning =
        activeCard !== null ||
        document.querySelector('.proj-print-row[data-playing="true"]') !== null;
      if (!audio || !auditioning) return;
      e.preventDefault();
      const STEP = 5;
      if (e.key === "ArrowLeft") {
        try {
          audio.currentTime = Math.max(0, audio.currentTime - STEP);
        } catch {}
      } else {
        const dur = audio.duration;
        const cap = Number.isFinite(dur) && dur > 0 ? dur : audio.currentTime + STEP;
        try {
          audio.currentTime = Math.min(cap, audio.currentTime + STEP);
        } catch {}
      }
    });

    // ── Print linker ────────────────────────────────────────────────────
    // Click a suggestion chip OR pick from the fallback <select> to link
    // a pending print to a project. On success the row dims and the
    // suggestions disable; on failure the status line shows the reason.
    const linkPrint = async (row: HTMLElement, projectId: number) => {
      const path = row.dataset.pendingPath;
      if (!path) return;
      if (row.getAttribute("data-pending") === "true") return;
      row.setAttribute("data-pending", "true");
      const buttons = row.querySelectorAll<HTMLButtonElement>('[data-action="link-print"]');
      const select = row.querySelector<HTMLSelectElement>('[data-action="link-print-select"]');
      buttons.forEach((b) => (b.disabled = true));
      if (select) select.disabled = true;
      const setRowStatus = (text: string, tone: "" | "ok" | "err" = "") => {
        const line = row.querySelector<HTMLElement>("[data-status-line]");
        if (!line) return;
        line.textContent = text;
        if (tone) line.setAttribute("data-tone", tone);
        else line.removeAttribute("data-tone");
      };
      setRowStatus("Linking…");
      try {
        const res = await fetch("/api/console/prints-link", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ path, project_asset_id: projectId }),
        });
        if (!res.ok) {
          let detail = `HTTP ${res.status}`;
          try {
            const body = await res.json();
            if (body?.error?.message) detail = body.error.message;
            else if (typeof body?.detail === "string") detail = body.detail;
          } catch {}
          setRowStatus(`Link failed: ${detail}`, "err");
          buttons.forEach((b) => (b.disabled = false));
          if (select) select.disabled = false;
          row.removeAttribute("data-pending");
          return;
        }
        row.setAttribute("data-linked", "true");
        setRowStatus("✓ Linked. Refresh to see the print on its project card.", "ok");
      } catch {
        setRowStatus("Link failed (network)", "err");
        buttons.forEach((b) => (b.disabled = false));
        if (select) select.disabled = false;
        row.removeAttribute("data-pending");
      }
    };

    root.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement | null)?.closest<HTMLElement>(
        '[data-action="link-print"]',
      );
      if (!btn) return;
      const row = btn.closest<HTMLElement>(".pending-row");
      const id = Number(btn.dataset.projectId);
      if (!row || !Number.isFinite(id)) return;
      linkPrint(row, id);
    });
    root.addEventListener("change", (e) => {
      const sel = (e.target as HTMLElement | null)?.closest<HTMLSelectElement>(
        '[data-action="link-print-select"]',
      );
      if (!sel || !sel.value) return;
      const row = sel.closest<HTMLElement>(".pending-row");
      const id = Number(sel.value);
      if (!row || !Number.isFinite(id)) return;
      linkPrint(row, id);
    });

    // ── Inline print player + unlink ────────────────────────────────
    // Reuses the same singleton audio element used by audition-bounce, so
    // playing a print on one card stops a bounce playing on another.
    const setPrintRowStatus = (
      row: HTMLElement, text: string, tone: "" | "ok" | "err" = "",
    ) => {
      const line = row.querySelector<HTMLElement>("[data-status-line]");
      if (!line) return;
      line.textContent = text;
      if (tone) line.setAttribute("data-tone", tone);
      else line.removeAttribute("data-tone");
    };

    const stopPrintIfActive = () => {
      if (audio && !audio.paused) audio.pause();
      const playing = document.querySelector<HTMLElement>(
        '.proj-print-row[data-playing="true"]',
      );
      if (playing) {
        playing.removeAttribute("data-playing");
        const btn = playing.querySelector<HTMLButtonElement>(
          '[data-action="audition-print"]',
        );
        if (btn) { btn.removeAttribute("data-playing"); btn.textContent = "▶"; }
      }
    };

    root.addEventListener("click", async (e) => {
      const btn = (e.target as HTMLElement | null)?.closest<HTMLElement>(
        '[data-action="audition-print"]',
      );
      if (!btn) return;
      const row = btn.closest<HTMLElement>(".proj-print-row");
      const path = row?.dataset.printPath;
      if (!row || !path) return;
      const isPlayingThis = row.getAttribute("data-playing") === "true";
      stopActive(); // halt any bounce playback
      stopPrintIfActive();
      if (isPlayingThis) return; // toggle off
      if (!audio) {
        audio = new Audio();
        audio.preload = "auto";
        audio.addEventListener("ended", () => stopPrintIfActive());
        audio.addEventListener("error", () => {
          const playing = document.querySelector<HTMLElement>(
            '.proj-print-row[data-playing="true"]',
          );
          if (playing) setPrintRowStatus(playing, "Failed to load (iCloud may not have synced yet)", "err");
          stopPrintIfActive();
        });
      }
      row.setAttribute("data-playing", "true");
      btn.setAttribute("data-playing", "true");
      btn.textContent = "■";
      setPrintRowStatus(row, "Streaming…");
      audio.src = `/api/console/asset?path=${encodeURIComponent(path)}&variant=opus`;
      try {
        await audio.play();
        setPrintRowStatus(row, "");
      } catch {
        setPrintRowStatus(row, "Play failed", "err");
        stopPrintIfActive();
      }
    });

    root.addEventListener("click", async (e) => {
      const btn = (e.target as HTMLElement | null)?.closest<HTMLElement>(
        '[data-action="unlink-print"]',
      );
      if (!btn) return;
      const row = btn.closest<HTMLElement>(".proj-print-row");
      const assetId = Number(btn.dataset.printAssetId);
      if (!row || !Number.isFinite(assetId)) return;
      if (row.getAttribute("data-pending") === "true") return;
      row.setAttribute("data-pending", "true");
      setPrintRowStatus(row, "Unlinking…");
      try {
        const res = await fetch("/api/console/prints-unlink", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ asset_id: assetId }),
        });
        if (!res.ok) {
          let detail = `HTTP ${res.status}`;
          try {
            const body = await res.json();
            if (body?.error?.message) detail = body.error.message;
            else if (typeof body?.detail === "string") detail = body.detail;
          } catch {}
          setPrintRowStatus(row, `Unlink failed: ${detail}`, "err");
          row.removeAttribute("data-pending");
          return;
        }
        row.setAttribute("data-unlinked", "true");
        setPrintRowStatus(row, "Unlinked. Refresh to remove.", "ok");
      } catch {
        setPrintRowStatus(row, "Unlink failed (network)", "err");
        row.removeAttribute("data-pending");
      }
    });

    // ── Batch linker: same gesture, all rows in the group ─────────────
    const linkBatch = async (group: HTMLElement, projectId: number) => {
      let paths: string[] = [];
      try {
        paths = JSON.parse(group.dataset.groupPaths || "[]");
      } catch {}
      if (!paths.length) return;
      const batchStatus = group.querySelector<HTMLElement>("[data-batch-status]");
      const setBatchStatus = (text: string, tone: "" | "ok" | "err" = "") => {
        if (!batchStatus) return;
        batchStatus.textContent = text;
        if (tone) batchStatus.setAttribute("data-tone", tone);
        else batchStatus.removeAttribute("data-tone");
      };
      const buttons = group.querySelectorAll<HTMLButtonElement>(
        '[data-action="link-print-batch"]',
      );
      const selects = group.querySelectorAll<HTMLSelectElement>(
        '[data-action="link-print-batch-select"]',
      );
      buttons.forEach((b) => (b.disabled = true));
      selects.forEach((s) => (s.disabled = true));
      setBatchStatus(`Linking ${paths.length}…`);
      // Fire in parallel; the engine is idempotent on path. Each row
      // gets its own dim on success.
      const results = await Promise.allSettled(
        paths.map((path) =>
          fetch("/api/console/prints-link", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({ path, project_asset_id: projectId }),
          }).then((r) => (r.ok ? r.json() : Promise.reject(new Error(`HTTP ${r.status}`)))),
        ),
      );
      let ok = 0;
      results.forEach((res, i) => {
        const path = paths[i];
        const row = group.querySelector<HTMLElement>(
          `.pending-row[data-pending-path="${CSS.escape(path)}"]`,
        );
        if (!row) return;
        if (res.status === "fulfilled") {
          row.setAttribute("data-linked", "true");
          ok += 1;
        } else {
          const line = row.querySelector<HTMLElement>("[data-status-line]");
          if (line) {
            line.textContent = `failed: ${res.reason?.message ?? res.reason}`;
            line.setAttribute("data-tone", "err");
          }
        }
      });
      if (ok === paths.length) {
        setBatchStatus(`✓ All ${paths.length} linked. Refresh to see them on the project card.`, "ok");
      } else {
        setBatchStatus(`${ok}/${paths.length} linked. ${paths.length - ok} failed — see individual rows.`, "err");
        buttons.forEach((b) => (b.disabled = false));
        selects.forEach((s) => (s.disabled = false));
      }
    };

    root.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement | null)?.closest<HTMLElement>(
        '[data-action="link-print-batch"]',
      );
      if (!btn) return;
      const group = btn.closest<HTMLElement>(".pending-group");
      const id = Number(btn.dataset.projectId);
      if (!group || !Number.isFinite(id)) return;
      linkBatch(group, id);
    });
    root.addEventListener("change", (e) => {
      const sel = (e.target as HTMLElement | null)?.closest<HTMLSelectElement>(
        '[data-action="link-print-batch-select"]',
      );
      if (!sel || !sel.value) return;
      const group = sel.closest<HTMLElement>(".pending-group");
      const id = Number(sel.value);
      if (!group || !Number.isFinite(id)) return;
      linkBatch(group, id);
    });

    // ── Hold-to-archive × (mirrors engineer .pair-skip-x; 650ms commit;
    //    a tap is a no-op). Kept in lockstep with the .proj-archive-x CSS. ──
    const ARCH_HOLD_MS = 650;
    let archTimer: number | null = null;
    let archBtn: HTMLElement | null = null;
    const cancelArch = () => {
      if (archTimer !== null) { window.clearTimeout(archTimer); archTimer = null; }
      if (archBtn) { archBtn.removeAttribute("data-holding"); archBtn = null; }
    };
    const startArch = (btn: HTMLElement) => {
      if (archTimer !== null) return;
      const card = btn.closest<HTMLElement>(".proj-card");
      if (!card) return;
      archBtn = btn;
      btn.setAttribute("data-holding", "true");
      archTimer = window.setTimeout(async () => {
        archTimer = null;
        btn.removeAttribute("data-holding");
        archBtn = null;
        const assetId = Number(card.getAttribute("data-asset-id"));
        if (!Number.isFinite(assetId)) return;
        setStatus(card, "Archiving…");
        try {
          const res = await projPostJSON("/api/console/projects-archive", { project_asset_id: assetId, archived: true });
          if (res.ok) location.reload();
          else setStatus(card, "Archive failed", "err");
        } catch { setStatus(card, "Archive failed", "err"); }
      }, ARCH_HOLD_MS);
    };
    document.addEventListener("pointerdown", (e) => {
      const b = (e.target as HTMLElement | null)?.closest<HTMLElement>('[data-hold="archive"]');
      if (b) startArch(b);
    });
    document.addEventListener("pointerup", cancelArch);
    document.addEventListener("pointercancel", cancelArch);
    document.addEventListener("pointerout", (e) => {
      if (!archBtn) return;
      const t = e.target as HTMLElement | null;
      if (t?.closest('[data-hold="archive"]') === archBtn) {
        const rel = (e as PointerEvent).relatedTarget as HTMLElement | null;
        if (!rel || rel.closest('[data-hold="archive"]') !== archBtn) cancelArch();
      }
    });

    // ── Sort + filter toolbar (client-side; default = recently modified) ──
    const list = root.querySelector<HTMLElement>(".proj-list");
    if (list) {
      const sortSel = root.querySelector<HTMLSelectElement>("[data-sort]");
      const filterBtns = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-filter]"));
      const countEl = root.querySelector<HTMLElement>("[data-proj-count]");
      const cards = Array.from(list.querySelectorAll<HTMLElement>(".proj-card"));
      const headers = Array.from(list.querySelectorAll<HTMLElement>(".proj-group-header"));
      const originalOrder = Array.from(list.children) as HTMLElement[];
      let curFilter = "all";
      const numAttr = (el: HTMLElement, a: string) => Number(el.getAttribute(a)) || 0;
      const tsAttr = (el: HTMLElement, a: string) => {
        const v = el.getAttribute(a);
        const t = v ? Date.parse(v) : NaN;
        return Number.isFinite(t) ? t : 0;
      };
      const sorters: Record<string, (a: HTMLElement, b: HTMLElement) => number> = {
        modified: (a, b) => tsAttr(b, "data-modified") - tsAttr(a, "data-modified"),
        created: (a, b) => tsAttr(b, "data-created") - tsAttr(a, "data-created"),
        oldest: (a, b) => tsAttr(a, "data-modified") - tsAttr(b, "data-modified"),
        dense: (a, b) => numAttr(b, "data-clips") - numAttr(a, "data-clips"),
        recordings: (a, b) => numAttr(b, "data-recorded") - numAttr(a, "data-recorded"),
      };
      const passes = (c: HTMLElement) => {
        if (curFilter === "recordings") return numAttr(c, "data-recorded") > 0;
        if (curFilter === "exports") return c.getAttribute("data-has-exports") === "1";
        if (curFilter === "revealable") return c.getAttribute("data-revealable") === "1";
        return true;
      };
      const apply = () => {
        const sort = sortSel?.value || "modified";
        if (sort === "collection" && curFilter === "all") {
          originalOrder.forEach((n) => list.appendChild(n));
          headers.forEach((h) => (h.style.display = ""));
          cards.forEach((c) => (c.style.display = ""));
          if (countEl) countEl.textContent = `${cards.length} projects`;
          return;
        }
        headers.forEach((h) => (h.style.display = "none"));
        const visible = cards.filter(passes);
        const hidden = cards.filter((c) => !passes(c));
        visible.sort(sorters[sort] || sorters.modified);
        visible.forEach((c) => { c.style.display = ""; list.appendChild(c); });
        hidden.forEach((c) => { c.style.display = "none"; });
        if (countEl) countEl.textContent = `${visible.length} of ${cards.length}`;
      };
      sortSel?.addEventListener("change", apply);
      filterBtns.forEach((b) =>
        b.addEventListener("click", () => {
          curFilter = b.getAttribute("data-filter") || "all";
          filterBtns.forEach((x) => x.classList.toggle("is-active", x === b));
          apply();
        }),
      );
      apply();
    }
  }
</script>
