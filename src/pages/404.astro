---
// The site's own 404. Without this Astro serves its framework default (dark,
// Astro-branded, no way home) for every dead URL — measured live on
// /writing, /case-studies, /portal, /sounds, /resume/delta-srux (2026-09-09
// QA audit). Same chrome as the away pages: the rail, quiet mono, day/night.
import Layout from "../layouts/Layout.astro";
import AwayRail from "../components/studio/AwayRail.astro";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-sans/400.css";

export const prerender = true;
---

<Layout title="not found — Jonathan Tollefson" description="That page isn't here.">
  <AwayRail />
  <main class="nf">
    <p class="nf-code">404</p>
    <p class="nf-line">that page isn't here.</p>
    <p class="nf-links">
      <a href="/">the studio</a><span class="nf-sep" aria-hidden="true"> · </span><a href="/resume">résumé</a>
    </p>
  </main>
</Layout>

<style>
  .nf {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 14px;
    padding: 34px 20px 110px;
    background: var(--bg);
    color: var(--ink);
    font-family: "IBM Plex Sans", ui-sans-serif, system-ui, sans-serif;
    transition: background 560ms ease, color 560ms ease;
  }
  @media (min-width: 900px) {
    .nf {
      padding-left: calc(var(--railw, 110px) + clamp(28px, 5vw, 54px));
    }
  }
  .nf-code {
    margin: 0;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.6875rem;
    letter-spacing: 0.22em;
    color: var(--muted);
  }
  .nf-line {
    margin: 0;
    font-size: clamp(1.25rem, 2.4vw, 1.75rem);
    line-height: 1.2;
    text-wrap: balance;
  }
  .nf-links {
    margin: 6px 0 0;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .nf-links a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-color: var(--accent);
  }
  .nf-links a:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }
</style>
