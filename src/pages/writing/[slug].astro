---
// /writing/<slug> — one Diary of a Soundbender post, full text ON the site
// (Jon, 2026-08-16: homepage shows preview tiles; essays live here, sourced
// from writing-manifest.json — the Substack is the origin, not the venue).
import Layout from "../../layouts/Layout.astro";
import AwayRail from "../../components/studio/AwayRail.astro";
import writing from "../../components/studio/rooms/writing-manifest.json";

export const prerender = true;

export function getStaticPaths() {
  return (writing.posts ?? []).map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Post {
  slug: string;
  title: string;
  date: string;
  subtitle?: string;
  cover?: string | null;
  paragraphs: string[];
}
const { post } = Astro.props as { post: Post };
const fmtDate = (iso: string) => {
  const d = new Date(iso + "T12:00:00");
  return isNaN(d.getTime()) ? iso : d.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" });
};
---

<Layout
  title={`${post.title} — Jonathan Tollefson`}
  description={post.subtitle || `Diary of a Soundbender — ${post.title}`}
  ogImage={post.cover || undefined}
  hideThemeSelector={true}
  chromeless={true}
>
  <AwayRail variant="light" />
  <main class="wpage">
    <article class="wpost">
      <header class="whead">
        <h1>{post.title}</h1>
        {post.subtitle && <p class="wsub">{post.subtitle}</p>}
        <p class="wmeta">Diary of a Soundbender · {fmtDate(post.date)}</p>
      </header>
      {post.cover && <img class="wcover" src={post.cover} alt="" />}
      {post.paragraphs.map((para) => <p class="wp">{para}</p>)}
      {/* provenance + the follow path a reader asked for (review, 2026-08-25) */}
      <p class="wsource">
        from <a href={`https://jontolo.substack.com/p/${post.slug}`} target="_blank" rel="noopener noreferrer">Diary of a Soundbender — read on Substack →</a>
      </p>
    </article>

    <footer class="lfloor">
      <span class="lfloor-lines">
        <a href="mailto:jtollefson123@gmail.com">jtollefson123@gmail.com</a>
        <span>minneapolis, mn</span>
      </span>
      <span class="lfloor-right">
        <a class="lfloor-li" href="https://linkedin.com/in/jtollefson123" aria-label="LinkedIn" target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3" /><path d="M8 11v5" /><path d="M8 8v.01" /><path d="M12 16v-5" /><path d="M16 16v-3a2 2 0 0 0-4 0" /></svg></a>
        <a href="/resume">résumé</a>
      </span>
    </footer>
  </main>
</Layout>

<style>
  :global(html),
  :global(body) {
    background: #e9e8e5;
  }
  .wpage {
    min-height: 100svh;
    background: #e9e8e5;
    color: #141210;
    font-family: "IBM Plex Sans", ui-sans-serif, system-ui, sans-serif;
    padding: 34px 20px 110px;
    cursor: auto;
  }
  .wpage :global(a),
  .wpage :global(button) {
    cursor: pointer;
  }
  @media (min-width: 900px) {
    .wpage {
      padding-left: 92px;
    }
  }
  .wpost {
    max-width: 660px;
    margin: 0 auto;
    background: rgba(248, 244, 234, 0.96);
    border: 1px solid rgba(90, 74, 50, 0.25);
    border-radius: 8px;
    padding: clamp(28px, 5vw, 54px);
    box-shadow: 0 18px 44px -24px rgba(20, 12, 4, 0.35);
  }
  .whead h1 {
    margin: 0 0 10px;
    font-size: clamp(1.4rem, 3.2vw, 1.9rem);
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
  .wsub {
    margin: 0 0 12px;
    font-size: 1rem;
    line-height: 1.5;
    color: #6a6660;
  }
  .wmeta {
    margin: 0 0 26px;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    color: #6a6660;
  }
  .wcover {
    width: 100%;
    border-radius: 6px;
    border: 1px solid rgba(90, 74, 50, 0.25);
    margin: 0 0 28px;
    display: block;
  }
  .wp {
    margin: 0 0 16px;
    font-size: 1rem;
    line-height: 1.7;
  }
  .wp:last-child {
    margin-bottom: 0;
  }
  .lfloor {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    max-width: 660px;
    margin: 48px auto 0;
    padding: 22px 20px 8px;
    border-top: 1px solid rgba(90, 74, 50, 0.2);
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.74rem;
    letter-spacing: 0.04em;
    color: #6a6660;
  }
  .lfloor-lines {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  .lfloor a {
    color: #141210;
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: color 160ms ease;
  }
  .lfloor a:hover,
  .lfloor a:focus-visible {
    color: #b33a2a;
  }
  .lfloor-li {
    display: inline-flex;
    padding: 8px;
    margin: -8px;
  }
  .lfloor-li svg {
    width: 21px;
    height: 21px;
  }
  .lfloor-right {
    display: inline-flex;
    align-items: center;
    gap: 14px;
  }

  .wsource {
    margin: 26px 0 0;
    padding-top: 14px;
    border-top: 1px solid rgba(90, 74, 50, 0.2);
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: #6a6660;
  }
  .wsource a {
    color: #141210;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
