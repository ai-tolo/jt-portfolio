---
// /catalog — the Catalog's standalone door (2026-08-19 narrative restructure:
// one story at /case-studies/the-console, artifacts as their own doors).
// The full console device (FileTransform) lives HERE at full size; the story
// page keeps only the pile→shape move and links through. Static, client-side,
// sample corpus bundled — the door rule: nothing here may depend on anything
// private.
import CSLayout from "../components/case-study/CSLayout.astro";
import Chapter from "../components/case-study/atlas/Chapter.astro";
import FileTransform from "../components/case-study/atlas/FileTransform.astro";

export const prerender = true;
---

<CSLayout
  title="the Catalog — Jonathan Tollefson"
  description="Twenty thousand scattered recordings, read by sound, named, and made playable — the Catalog is Finishable's first instrument, live."
>
  <Chapter
    index="—"
    job="Know what you have"
    product="the Catalog"
    tagline="The whole catalog, live. Drop into a bin; every file was read by sound, not by filename."
    accent="cyan"
    flush
  />
  <div class="cs-bleed"><FileTransform /></div>

  <p class="door-back">
    This is one instrument of three.
    <a href="/case-studies/the-console">Read the whole Finishable story →</a>
  </p>
</CSLayout>

<style>
  /* the door line wears the house chrome: the route's one mono token, the
     same rem size as .cs-foot-back, and the same brand-orange hover */
  .door-back {
    max-width: 760px;
    margin: 44px auto 80px;
    padding: 0 24px;
    font-family: var(--cs-mono);
    font-size: 0.78rem;
    letter-spacing: 0.03em;
    color: rgba(245, 241, 232, 0.55);
  }
  .door-back a {
    color: var(--brand-cyan);
    text-decoration: underline;
    text-underline-offset: 4px;
    margin-left: 6px;
    transition: color 160ms ease;
  }
  .door-back a:hover,
  .door-back a:focus-visible {
    color: var(--brand-orange);
  }
</style>
