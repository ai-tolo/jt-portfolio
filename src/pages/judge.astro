---
// /judge — the Engineer's standalone door (2026-08-19 narrative restructure).
// One blind, loudness-matched round, runnable entirely in the browser: three
// real renders of the same source, matched to −18.7 LUFS, crown one. This is
// the AI-evaluation artifact in linkable form — a Submittable field or a
// recruiter thread can point HERE. Static; audio bundled; nothing private.
import CSLayout from "../components/case-study/CSLayout.astro";
import Chapter from "../components/case-study/atlas/Chapter.astro";
import TheBench from "../components/case-study/atlas/TheBench.astro";
import { round3 } from "../lib/finishable";

export const prerender = true;
---

<CSLayout
  title="the Judge · Finishable · Jon Tollefson"
  description="A blind, loudness-matched listening test you can take right now: three real mastering chains, one source, no labels until you crown one."
>
  <Chapter
    index="—"
    job="Trust your ears"
    product="the Engineer's bench"
    tagline="Three chains, one source, no labels. Every take matched to −18.7 LUFS — otherwise the loudest one always wins."
    accent="green"
    flush
  />

  <div class="judge-room">
    <TheBench round={round3} />
    <p class="judge-matched">there is no wrong crown, only taste.</p>
    <p class="judge-why">
      Why blind: an earlier version of this engine learned my taste and steered
      toward it — under a blind, loudness-matched A/B it turned out to be
      overfitting a biased evaluator. The test outlived the model. Any change
      the engine proposes now has to beat doing nothing, here, blind.
    </p>
  </div>

  <p class="door-back">
    This bench is one instrument of three.
    <a href="/case-studies/the-console">Read the whole Finishable story →</a>
  </p>
</CSLayout>

<style>
  .judge-room {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .judge-matched {
    margin: 14px 0 0;
    text-align: center;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11px;
    letter-spacing: 0.05em;
    color: rgba(245, 241, 232, 0.45);
  }
  .judge-why {
    max-width: 56ch;
    margin: 40px auto 0;
    font-family: "Space Grotesk Variable", "Space Grotesk", ui-sans-serif, system-ui, sans-serif;
    font-size: clamp(14px, 1.7vw, 16.5px);
    line-height: 1.65;
    color: rgba(245, 241, 232, 0.72);
  }
  .door-back {
    max-width: 900px;
    margin: 54px auto 80px;
    padding: 0 24px;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 12.5px;
    letter-spacing: 0.03em;
    color: rgba(245, 241, 232, 0.55);
  }
  .door-back a {
    color: var(--brand-green);
    text-decoration: underline;
    text-underline-offset: 4px;
    margin-left: 6px;
  }
</style>
