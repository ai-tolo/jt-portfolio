---
// Renders a structured Resume AST as the on-screen interactive document.
// Screen-only: in print this whole sheet hides and resume/PrintResume.astro
// (the curated one-page PDF) takes over.

import type { ResumeAST } from "../lib/resumes";
import type { RichTextItemResponse } from "@notionhq/client/build/src/api-endpoints";
import RichText from "./RichText.astro";
import ResumeTab from "./resume/ResumeTab.astro";
import ResumeTimeline from "./resume/ResumeTimeline.astro";
import SkillsConstellation from "./resume/SkillsConstellation.astro";
import ProofDbtPipeline from "./resume/ProofDbtPipeline.astro";
import ProofDesignSystem from "./resume/ProofDesignSystem.astro";
import ProofGrowth from "./resume/ProofGrowth.astro";
import ProofUsability from "./resume/ProofUsability.astro";
import ProofAgentLoop from "./resume/ProofAgentLoop.astro";
import ProofJudge from "./resume/ProofJudge.astro";

interface Props {
  resume: ResumeAST;
}

const { resume } = Astro.props;
const { header, preamble, sections, tailoredFor } = resume;

const plainText = (rt: RichTextItemResponse[]) => rt.map((t) => t.plain_text).join("");
// Keep in lockstep with the slug used inside ResumeTimeline + SkillsConstellation
// so the timeline bars and skill chips can find their role cards.
const companySlug = (s: string) =>
  s.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");

// Match a bullet to an interactive proof by company + keyword. Resilient to
// small wording changes: if nothing matches, the bullet renders as plain text.
// Faithful-content rule: the bullet text is always rendered verbatim; a proof
// only ADORNS the claim it can demonstrate, and never replaces the words.
// `label` is the handwritten shorthand on the Post-it flag (short + a little
// cryptic, to invite a click); `color` is the fun flag color, `ink` its label
// color (picked for contrast), `side` the edge it hangs off, `rot` its tilt.
type Proof = {
  id: string; label: string; color: string; ink: string;
  side: "left" | "right"; rot: number; aria: string;
};
function proofFor(company: string, text: string): Proof | null {
  const c = company.toLowerCase();
  const t = text.toLowerCase();
  if (c.includes("chs")) {
    if (t.includes("dbt"))
      return { id: "dbt", label: "run parser", color: "#54C842", ink: "#123a0e", side: "right", rot: -3, aria: "Run the dbt documentation parser" };
  }
  if (c.includes("raylu")) {
    if (t.includes("component set"))
      return { id: "designsystem", label: "open sys", color: "#9A77F0", ink: "#ffffff", side: "left", rot: 2.5, aria: "Open the live design system" };
  }
  if (c.includes("crediverso")) {
    if (t.includes("bounce") || t.includes("usability"))
      return { id: "usability", label: "see test", color: "#FF8A38", ink: "#3a1e05", side: "right", rot: -2, aria: "See the usability test result" };
    if (t.includes("follower") || t.includes("125") || t.includes("growth"))
      return { id: "growth", label: "grow", color: "#F45D9B", ink: "#ffffff", side: "left", rot: 3, aria: "Watch the follower growth" };
  }
  // The Engineer (the build section): the two jars that carry the design-engineer story.
  if (c.includes("engineer")) {
    if (t.includes("renders several masters") || t.includes("agent, not a button"))
      return { id: "agentloop", label: "the loop", color: "#4D7CFE", ink: "#ffffff", side: "left", rot: -3, aria: "Play the agent loop" };
    if (t.includes("evaluator") || t.includes("shelved"))
      return { id: "judge", label: "the judge", color: "#F5B524", ink: "#3a2705", side: "right", rot: 2.5, aria: "See the evaluation insight" };
  }
  return null;
}

// Precompute the flag set (rendered in one layer so they can hang off either
// edge and be positioned against their target rows by script). The timeline
// flag leads; the rest follow their bullets.
type TabDef = {
  panelId: string; targetId: string; label: string; color: string;
  ink: string; side: "left" | "right"; rot: number; aria: string;
};
const tabDefs: TabDef[] = [];
const buildsSection = sections.find((s) => s.kind === "builds");
const expSection = sections.find((s) => s.kind === "experience");
// The Gantt shows the whole shape: current builds plus employment, newest first.
const timelineRoles = [
  ...(buildsSection && buildsSection.kind === "builds" ? buildsSection.roles : []),
  ...(expSection && expSection.kind === "experience" ? expSection.roles : []),
];
// The timeline flag leads (it hangs on the experience heading).
if (expSection && expSection.kind === "experience") {
  tabDefs.push({
    panelId: "panel-timeline", targetId: "exp-head", label: "timeline",
    color: "#15C2E6", ink: "#06323a", side: "left", rot: -3, aria: "Show the experience timeline",
  });
}
// Proof flags follow their bullets, across both the builds and experience roles.
for (const sec of [buildsSection, expSection]) {
  if (!sec || (sec.kind !== "builds" && sec.kind !== "experience")) continue;
  for (const r of sec.roles) {
    for (const b of r.bullets) {
      const proof = proofFor(r.company, plainText(b));
      if (proof) {
        tabDefs.push({
          panelId: `panel-${proof.id}`, targetId: `bullet-${proof.id}`,
          label: proof.label, color: proof.color, ink: proof.ink,
          side: proof.side, rot: proof.rot, aria: proof.aria,
        });
      }
    }
  }
}
---

<article class:list={["resume", { "is-tailored": !!tailoredFor }]} lang="en">
  <div class="rz-scrim r-live" data-scrim aria-hidden="true"></div>
  {tailoredFor && (
    <p class="tailored" aria-label="Tailored for">
      <span class="tailored-label">Tailored for</span> {tailoredFor}
    </p>
  )}

  <header class="resume-header">
    <h1 class="name">{header.name}</h1>
    {header.title && <p class="title">{header.title}</p>}
    {header.contact.length > 0 && (
      <p class="contact">
        {header.contact.map((c, i) => (
          <>
            {i > 0 && <span class="sep" aria-hidden="true"> · </span>}
            <span>{c}</span>
          </>
        ))}
      </p>
    )}
  </header>

  {sections.map((s) => {
    if (s.kind === "summary" || s.kind === "outside") {
      return (
        <section class={`section section-${s.kind}`}>
          <h2 class="section-title">{s.title}</h2>
          <div class="section-body">
            {s.paragraphs.map((p) => (
              <p><RichText rich={p} /></p>
            ))}
          </div>
        </section>
      );
    }

    if (s.kind === "experience" || s.kind === "builds") {
      const isExp = s.kind === "experience";
      return (
        <section class={`section section-${s.kind}`}>
          <h2 class="section-title" id={isExp ? "exp-head" : "builds-head"}>{s.title}</h2>
          {isExp && (
            <div class="proof-wrap r-live" id="panel-timeline" data-proof-wrap data-open="false">
              <div class="proof-inner"><ResumeTimeline roles={timelineRoles} /></div>
            </div>
          )}
          <div class="section-body">
            {s.roles.map((r) => (
              <div class="role" data-company={companySlug(r.company)}>
                <div class="role-head">
                  <h3 class="role-company">
                    {r.company}
                    {r.location && <span class="role-location"> — {r.location}</span>}
                  </h3>
                  {r.dates && <span class="role-dates">{r.dates}</span>}
                </div>
                {r.title && <p class="role-title">{r.title}</p>}
                {r.bullets.length > 0 && (
                  <ul class="role-bullets">
                    {r.bullets.map((b) => {
                      const proof = proofFor(r.company, plainText(b));
                      const panelId = proof ? `panel-${proof.id}` : undefined;
                      return (
                        <li
                          class:list={["role-bullet", { "has-proof": !!proof }]}
                          id={proof ? `bullet-${proof.id}` : undefined}
                        >
                          <span class="bullet-line"><RichText rich={b} /></span>
                          {proof && panelId && (
                            <div class="proof-wrap r-live" id={panelId} data-proof-wrap data-open="false">
                              <div class="proof-inner">
                                {proof.id === "dbt" && <ProofDbtPipeline />}
                                {proof.id === "designsystem" && <ProofDesignSystem />}
                                {proof.id === "usability" && <ProofUsability />}
                                {proof.id === "growth" && <ProofGrowth />}
                                {proof.id === "agentloop" && <ProofAgentLoop />}
                                {proof.id === "judge" && <ProofJudge />}
                              </div>
                            </div>
                          )}
                        </li>
                      );
                    })}
                  </ul>
                )}
              </div>
            ))}
            {!isExp && (
              <a class="builds-case-link" href="/case-studies/the-console">
                Case study: Finishable<span class="bcl-arrow" aria-hidden="true"> →</span>
              </a>
            )}
          </div>
        </section>
      );
    }

    if (s.kind === "education") {
      return (
        <section class="section section-education">
          <h2 class="section-title">{s.title}</h2>
          <div class="section-body">
            {s.schools.map((sc) => (
              <div class="school">
                <div class="school-head">
                  <h3 class="school-institution">
                    {sc.institution}
                    {sc.location && <span class="school-location"> — {sc.location}</span>}
                  </h3>
                  {sc.dates && <span class="school-dates">{sc.dates}</span>}
                </div>
                {sc.degree && <p class="school-degree">{sc.degree}</p>}
                {sc.honors && <p class="school-honors">{sc.honors}</p>}
              </div>
            ))}
          </div>
        </section>
      );
    }

    if (s.kind === "tools") {
      return (
        <section class="section section-tools">
          <h2 class="section-title">{s.title}</h2>
          <SkillsConstellation groups={s.groups} />
        </section>
      );
    }

    // generic fallback
    return (
      <section class={`section section-generic`}>
        <h2 class="section-title">{s.title}</h2>
        <div class="section-body">
          {/* Plain blocks are rendered minimally — used as a graceful fallback */}
          {s.blocks.map((b: any) => {
            if (b.type === "paragraph") {
              return <p><RichText rich={b.paragraph.rich_text} /></p>;
            }
            if (b.type === "bulleted_list_item") {
              return <p>• <RichText rich={b.bulleted_list_item.rich_text} /></p>;
            }
            return null;
          })}
        </div>
      </section>
    );
  })}

  <div class="rtab-layer r-live" data-tab-layer>
    {tabDefs.map((t) => (
      <ResumeTab
        label={t.label}
        color={t.color}
        ink={t.ink}
        side={t.side}
        rot={t.rot}
        controls={t.panelId}
        target={t.targetId}
        ariaLabel={t.aria}
      />
    ))}
  </div>
</article>

<style>
  /* ──── Screen styles ──── */
  .resume {
    max-width: 56rem;
    margin: 0 auto;
    padding: var(--space-16) var(--content-pad) var(--space-24);
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--text);
  }

  .tailored {
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: var(--space-8);
    border-left: 2px solid var(--accent);
    padding-left: var(--space-3);
  }
  .tailored-label {
    color: var(--accent);
  }

  .resume-header {
    margin-bottom: var(--space-12);
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--line);
  }
  .name {
    font-family: "Space Grotesk Variable", "Space Grotesk", ui-sans-serif, system-ui, sans-serif;
    font-size: clamp(2.75rem, 5.6vw, 4rem);
    font-weight: var(--fw-bold);
    letter-spacing: -0.035em;
    line-height: 0.96;
    margin-bottom: var(--space-4);
  }
  .title {
    position: relative;
    display: inline-block;
    font-size: 1.1875rem;
    font-weight: var(--fw-medium);
    color: var(--text);
    padding-left: 2.25rem;
    margin-bottom: var(--space-5);
  }
  .title::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 1.5rem;
    height: 2px;
    background: var(--accent);
  }
  .contact {
    font-size: 0.875rem;
    color: var(--text);
    font-weight: var(--fw-medium);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    opacity: 0.85;
  }
  .contact .sep {
    color: var(--accent);
    opacity: 0.7;
  }

  .section {
    margin-bottom: var(--space-12);
  }
  .section-title {
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--line);
  }

  .section-summary p,
  .section-outside p {
    font-size: 1rem;
    margin-bottom: var(--space-3);
    color: var(--text);
    font-weight: var(--fw-medium);
    line-height: 1.55;
  }

  /* Experience */
  .role {
    margin-bottom: var(--space-6);
    page-break-inside: avoid;
    break-inside: avoid;
  }
  .role-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    margin-bottom: var(--space-1);
  }
  .role-company {
    font-size: 1.0625rem;
    font-weight: var(--fw-bold);
    letter-spacing: -0.01em;
    color: var(--text);
  }
  .role-location {
    font-weight: var(--fw-medium);
    color: var(--text);
    opacity: 0.7;
  }
  .role-dates {
    font-size: 0.875rem;
    color: var(--text);
    font-weight: var(--fw-medium);
    opacity: 0.75;
    white-space: nowrap;
  }
  .role-title {
    font-size: 0.9375rem;
    font-style: italic;
    font-weight: var(--fw-medium);
    color: var(--text);
    margin-bottom: var(--space-2);
  }
  .role-bullets {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .role-bullets li {
    padding-left: 1.5rem;
    position: relative;
    margin-bottom: var(--space-2);
    line-height: 1.55;
    font-weight: var(--fw-medium);
    color: var(--text);
  }
  .role-bullets li::before {
    content: "→";
    position: absolute;
    left: 0;
    top: 0;
    width: 1rem;
    color: var(--accent);
    font-weight: var(--fw-bold);
  }

  /* The door from the builds to their case study (screen-only by nature:
     print renders PrintResume, which carries its own case-study link). */
  .builds-case-link {
    display: inline-flex;
    align-items: baseline;
    margin-top: var(--space-3);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
    padding-bottom: 1px;
    transition: border-color 200ms ease;
  }
  .builds-case-link:hover,
  .builds-case-link:focus-visible {
    border-bottom-color: var(--accent);
    outline: none;
  }
  .bcl-arrow { display: inline-block; transition: transform 200ms ease; }
  .builds-case-link:hover .bcl-arrow,
  .builds-case-link:focus-visible .bcl-arrow { transform: translateX(3px); }

  /* Education */
  .school {
    margin-bottom: var(--space-4);
    page-break-inside: avoid;
    break-inside: avoid;
  }
  .school-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    margin-bottom: var(--space-1);
  }
  .school-institution {
    font-size: 1.0625rem;
    font-weight: var(--fw-bold);
    letter-spacing: -0.01em;
    color: var(--text);
  }
  .school-location {
    font-weight: var(--fw-medium);
    color: var(--text);
    opacity: 0.7;
  }
  .school-dates {
    font-size: 0.875rem;
    color: var(--text);
    font-weight: var(--fw-medium);
    opacity: 0.75;
    white-space: nowrap;
  }
  .school-degree {
    font-size: 0.9375rem;
    font-style: italic;
    font-weight: var(--fw-medium);
    color: var(--text);
  }
  .school-honors {
    font-size: 0.875rem;
    color: var(--text);
    opacity: 0.75;
  }

  /* ──── Live proof affordances: Post-it flags + focus dim (screen only) ──── */
  @media screen {
    .resume {
      position: relative;
      max-width: none;
      /* how far a flag hangs off the sheet edge; shrinks with the viewport so
         it never overflows the gutter, tucking flush on small screens */
      --rtab-hang: clamp(0px, calc((100vw - 59rem) / 2), 52px);
    }
  }
  .bullet-line { display: inline; }

  /* the spotlight scrim: dims the whole page; the active claim, its panel, and
     the open flag are raised above it (the case-study focus pattern) */
  .rz-scrim {
    position: absolute;
    inset: 0;
    z-index: 20;
    background: var(--surface-1);
    opacity: 0;
    pointer-events: none;
    transition: opacity 420ms ease;
  }
  .resume[data-focus] .rz-scrim { opacity: 0.84; pointer-events: auto; }
  .rz-lit { position: relative; z-index: 30; }

  .rtab-layer { position: absolute; inset: 0; z-index: 25; pointer-events: none; }
  .rtab-layer :global(.rtab) { pointer-events: auto; }
  .rtab-layer :global(.rtab.rz-lit) { z-index: 31; }
  .resume[data-focus] .rtab-layer :global(.rtab:not(.rz-lit)) { opacity: 0.12; }

  .proof-wrap {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 420ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .proof-wrap[data-open="true"] { grid-template-rows: 1fr; margin: var(--space-3) 0 var(--space-2); }
  .proof-inner { overflow: hidden; min-height: 0; }

  /* Mobile: skip the hanging flags + focus dim entirely. People don't dig into
     the interactive proofs on a phone, and the narrow gutters leave no room to
     hang flags cleanly. The résumé just reads as a clean page; the skills field
     below still breathes. */
  @media screen and (max-width: 48rem) {
    .rtab-layer, .rz-scrim { display: none !important; }
    .proof-wrap { display: none !important; }
  }
  @media (prefers-reduced-motion: reduce) {
    .proof-wrap, .rz-scrim { transition: none; }
  }

  /* ──── Print ────
     The PDF is no longer this component squeezed down. The Download-PDF path
     prints the curated one-pager in resume/PrintResume.astro (content in
     src/lib/resume-print.ts); PrintResume's global print rules hide the whole
     interactive sheet (.rs-root) and all site chrome in print. This component
     is screen-only. */
</style>

<script>
  // Post-it flags live in one layer and hang off either edge. The script: (1)
  // aligns each flag vertically to its target row; (2) accordions open/close on
  // click (one at a time); (3) runs focus mode — opening a flag dims the page
  // and spotlights just that claim, its panel, and the flag.
  document.querySelectorAll<HTMLElement>(".resume").forEach((resume) => {
    const scrim = resume.querySelector<HTMLElement>("[data-scrim]");
    const tabs = Array.from(resume.querySelectorAll<HTMLElement>("[data-proof-tab]"));
    if (!tabs.length) return;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let openTab: HTMLElement | null = null;

    const wrapOf = (tab: HTMLElement) =>
      document.getElementById(tab.getAttribute("aria-controls") || "");

    const place = () => {
      const base = resume.getBoundingClientRect();
      for (const tab of tabs) {
        const target = tab.dataset.target ? document.getElementById(tab.dataset.target) : null;
        if (!target) continue;
        const r = target.getBoundingClientRect();
        tab.style.setProperty("--rtab-top", `${Math.round(r.top - base.top + r.height / 2)}px`);
      }
    };

    const clearLit = () => resume.querySelectorAll(".rz-lit").forEach((e) => e.classList.remove("rz-lit"));

    const collapse = (tab: HTMLElement) => {
      const wrap = wrapOf(tab);
      if (wrap) wrap.dataset.open = "false";
      tab.setAttribute("aria-expanded", "false");
    };

    const closeAll = () => {
      tabs.forEach(collapse);
      clearLit();
      resume.removeAttribute("data-focus");
      openTab = null;
    };

    const open = (tab: HTMLElement) => {
      tabs.forEach((t) => { if (t !== tab) collapse(t); });
      clearLit();
      const wrap = wrapOf(tab);
      if (!wrap) return;
      wrap.dataset.open = "true";
      tab.setAttribute("aria-expanded", "true");
      tab.classList.add("rz-lit");
      wrap.classList.add("rz-lit");
      if (tab.dataset.target) document.getElementById(tab.dataset.target)?.classList.add("rz-lit");
      resume.setAttribute("data-focus", "");
      openTab = tab;

      const playable = wrap.querySelector<HTMLElement>("[data-proof], [data-timeline]");
      if (playable) playable.dispatchEvent(new CustomEvent("play"));
    };

    tabs.forEach((tab) =>
      tab.addEventListener("click", () => (openTab === tab ? closeAll() : open(tab)))
    );
    scrim?.addEventListener("click", closeAll);
    document.addEventListener("keydown", (e) => { if (e.key === "Escape" && openTab) closeAll(); });

    place();
    window.addEventListener("resize", place);
    window.setTimeout(place, 120);
    window.setTimeout(place, 650);
  });
</script>
