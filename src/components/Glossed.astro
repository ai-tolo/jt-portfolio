---
/**
 * A COPY STRING WITH ITS NICHE WORDS MARKED (2026-10-23, THE GLOSS): `<Glossed text={STUDIO_COPY.dek} mark={["Ableton"]} />`
 * prints the string as it is, the first occurrence of each listed word as a <Gloss>. The copy files stay plain text.
 */
import Gloss from "./Gloss.astro";
import { glossParts, type GlossWord } from "../lib/gloss";
interface Props { text: string; mark: readonly GlossWord[] }
const { text, mark } = Astro.props;
const parts = glossParts(text, mark);
---
{parts.map((p) => (p.w ? <Gloss w={p.w}>{p.t}</Gloss> : p.t))}
