$('#arpBtn').addEventListener('click',()=>{if(!live||!eng)return;const on=$('#arpBtn').dataset.on!=='1';$('#arpBtn').dataset.on=on?'1':'0';$('#arpBtn').classList.toggle('on',on);$('#arpBtn').setAttribute('aria-pressed',on?'true':'false');$('#arpmod').classList.toggle('armed',on);eng.setArp(on);refreshLatch();refreshTransport();});
