/* auto-filter curve — horizontal-only drag, node rides the curve */
const afilter=$('#afilter'),afpath=$('#afpath'),affill=$('#affill'),afnode=$('#afnode'),afg=$('#afg');
const DBMIN=-30,DBMAX=6,VW=600,VH=200;
(function buildGrid(){const g=$('#afgrid');g.setAttribute('viewBox',`0 0 ${VW} ${VH}`);let h='';
  [100,1000,10000].forEach(f=>{const x=fToX(f)*VW;h+=`<line x1="${x}" y1="0" x2="${x}" y2="${VH}" stroke="rgba(120,170,210,.13)"/>`;h+=`<text x="${x+3}" y="${VH-5}">${f>=1000?(f/1000)+'k':f}</text>`;});
  [30,50,70,200,300,500,700,2000,3000,5000,7000].forEach(f=>{const x=fToX(f)*VW;h+=`<line x1="${x}" y1="0" x2="${x}" y2="${VH}" stroke="rgba(120,170,210,.05)"/>`;});
  const zy=VH-(0-DBMIN)/(DBMAX-DBMIN)*VH;h+=`<line x1="0" y1="${zy}" x2="${VW}" y2="${zy}" stroke="rgba(120,170,210,.16)" stroke-dasharray="3 4"/>`;g.innerHTML=h;})();
const CPTS=140;
function curveYs(f0,Q){const ys=new Float32Array(CPTS+1);for(let i=0;i<=CPTS;i++){const f=FMIN*Math.exp(i/CPTS*FLR),db=clamp(biquadMagDb('lowpass',f0,Q,f),DBMIN,DBMAX);ys[i]=VH-(db-DBMIN)/(DBMAX-DBMIN)*VH;}return ys;}
function ysPath(ys,i0,i1){let d='';for(let i=i0;i<=i1;i++){const x=fToX(FMIN*Math.exp(i/CPTS*FLR))*VW;d+=(i>i0?'L':'M')+x.toFixed(1)+' '+ys[i].toFixed(1)+' ';}return d;}
function setCurve(d){afpath.setAttribute('d',d);affill.setAttribute('d',d+`L${VW} ${VH} L0 ${VH} Z`);}
let baseYs=null;
function drawFilter(){const cut=eng?eng.fx.cutoff:.62,res=eng?eng.fx.res:0;
  const f0=xToF(cut),Q=QFor(res);
  baseYs=curveYs(f0,Q);
  setCurve(ysPath(baseYs,0,CPTS));
  const nbd=clamp(biquadMagDb('lowpass',f0,Q,f0),DBMIN,DBMAX),ny=1-(nbd-DBMIN)/(DBMAX-DBMIN);
  afnode.style.left=(fToX(f0)*100)+'%';afnode.style.top=(clamp(ny,0,1)*100)+'%';}
function afAt(e){const r=afilter.getBoundingClientRect();const x=clamp((e.clientX-r.left)/r.width,0,1);
  if(eng){eng.fx.cutoff=x;eng.apply();}drawFilter();}
afilter.addEventListener('pointerdown',e=>{if(!live)return;afilter.dataset.d='1';afAt(e);try{afilter.setPointerCapture(e.pointerId)}catch(_){}});
afilter.addEventListener('pointermove',e=>{if(afilter.dataset.d)afAt(e);});
afilter.addEventListener('pointerup',()=>afilter.dataset.d='');
