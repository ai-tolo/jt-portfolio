function traceScreen(el,reverse){const w=el.clientWidth,h=el.clientHeight;if(!w||!h)return;
  const r=Math.min(parseFloat(getComputedStyle(el).borderTopLeftRadius)||2,Math.min(w,h)/2-1);
  const svg=document.createElementNS(SCRNNS,'svg');svg.setAttribute('class','scrn-trace'+(el.classList.contains('tempo')?' amber':''));svg.setAttribute('viewBox','0 0 '+w+' '+h);svg.setAttribute('preserveAspectRatio','none');
  const dR='M'+(w/2)+' 1 H'+(w-r)+' A'+r+' '+r+' 0 0 1 '+(w-1)+' '+r+' V'+(h-r)+' A'+r+' '+r+' 0 0 1 '+(w-r)+' '+(h-1)+' H'+(w/2);
  const dL='M'+(w/2)+' 1 H'+r+' A'+r+' '+r+' 0 0 0 1 '+r+' V'+(h-r)+' A'+r+' '+r+' 0 0 0 '+r+' '+(h-1)+' H'+(w/2);
  const paths=[dR,dL].map(function(d){const p=document.createElementNS(SCRNNS,'path');p.setAttribute('d',d);svg.appendChild(p);return p;});
  el.appendChild(svg);
  paths.forEach(function(p){const L=p.getTotalLength();p._L=L;p.style.transition='none';p.style.strokeDasharray=String(L);p.style.strokeDashoffset=reverse?'0':String(L);});
  if(reduceMq.matches){paths.forEach(function(p){p.style.strokeDashoffset=reverse?String(p._L):'0';});return;}
  void svg.getBoundingClientRect();
  paths.forEach(function(p){p.style.transition='';p.style.strokeDashoffset=reverse?String(p._L):'0';});}
function clearScreenTraces(){sgm.querySelectorAll('.scrn-trace').forEach(function(s){s.remove();});}
function igniteScreenTraces(onDone){clearScreenTraces();tracePerimeter(false);sgm.querySelectorAll('.tempo,.pad,.afz,.readout').forEach(function(el){traceScreen(el,false);});
  setTimeout(function(){if(onDone)onDone();sgm.querySelectorAll('.scrn-trace').forEach(function(s){s.classList.add('settled');});traceSvg.classList.remove('drawing');traceSvg.classList.add('settled');rebakeTrace();},TRACEMS);}   /* rebakeTrace: re-fit the now-settled outline to the device's final (font-loaded) height */
function reverseScreenTraces(onDone){
  /* power-down: RETRACT — un-draw the EXISTING settled (dim) borders by animating their dashoffset back to full length, so the lit line withdraws at its dim live appearance. The exact reverse of the power-on draw — no clear+re-trace, no re-brighten, no opacity fade. */
  if(reduceMq.matches){
    [trL,trR].forEach(function(p){p.style.transition='none';p.style.strokeDashoffset=String(p.getTotalLength());});
    sgm.querySelectorAll('.scrn-trace path').forEach(function(p){p.style.transition='none';p.style.strokeDashoffset=String(p._L||p.getTotalLength());});
  }else{
    [trL,trR].forEach(function(p){p.style.transition='stroke-dashoffset 1.2s cubic-bezier(0.62,0,0.2,1)';p.style.strokeDashoffset=String(p.getTotalLength());});
    sgm.querySelectorAll('.scrn-trace path').forEach(function(p){p.style.transition='stroke-dashoffset 1.3s cubic-bezier(0.4,0.04,0.12,1)';p.style.strokeDashoffset=String(p._L||p.getTotalLength());});
  }
  setTimeout(function(){if(onDone)onDone();clearScreenTraces();traceSvg.classList.remove('drawing','settled');},TRACEMS);}

function powerToggle(){
  if(booting)return;
  if(touchStance){typeStatus('Built for a keyboard · best on a desktop');return;}
  if(live){
    // POWER OFF: sound + interactivity off now; screens stay lit; reverse the border; THEN screens off
    live=false;doPowerOff();sgm.dataset.state='powerdown';fadeGlass(false);pwr.setAttribute('aria-pressed','false');booting=true;   // glass body+glow cross-fade to dark in lockstep with the border retract
    reverseScreenTraces(function(){device.classList.remove('live');piano.classList.remove('lit');sgm.dataset.state='standby';clearGlassFade();clearScreenTraces();sgm.querySelectorAll('.wk').forEach(function(el){el.classList.remove('wk');});booting=false;});   // keys fade off only after the border reverse completes (with --kdoff); clearGlassFade hands the screens back to the steady .device:not(.live) cascade
    return;}
  // POWER ON: unlock audio in the gesture, fire the boot sound on the PRESS (not after the ~1.4s trace), trace the dark screens, THEN finishPower lights them
  try{const c=getCtx();if(c.resume)c.resume();}catch(e){}
  bootPluck();   // moved out of finishPower so it initiates the instant the button is hit (Jon 2026-06-15)
  sgm.dataset.state='boot';booting=true;piano.classList.add('lit');fadeGlass(true);   // #3: start the keyboard rainbow + glass cross-fade to lit at boot-START (in lockstep with the border traces)
  igniteScreenTraces(function(){finishPower();booting=false;});}

