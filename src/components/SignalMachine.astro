function makeReverb(ctx){const i=ctx.createGain(),o=ctx.createGain();const taps=[];[0.029,0.041,0.057,0.073].forEach(tt=>{const d=ctx.createDelay(1);d.delayTime.value=tt;const f=ctx.createGain();f.gain.value=.72;i.connect(d);d.connect(f);f.connect(d);d.connect(o);taps.push({d,f,base:tt});});return{input:i,output:o,taps};}
const REVSIZES={small:{m:.55,fb:.6},med:{m:1,fb:.72},hall:{m:1.8,fb:.8},vast:{m:2.9,fb:.86}};
const FMIN=20,FMAX=20000,FLR=Math.log(FMAX/FMIN);
const fToX=f=>Math.log(clamp(f,FMIN,FMAX)/FMIN)/FLR;
const xToF=x=>FMIN*Math.exp(clamp(x,0,1)*FLR);
const QFor=res=>0.707*Math.pow(0.21,clamp(res,0,1));   // res 0 → flat Butterworth shoulder, 1 → droopy "shave"; NEVER boosts above 0 dB
function biquadMagDb(type,f0,Q,f){const fs=44100,w0=2*Math.PI*f0/fs,cw=Math.cos(w0),sw=Math.sin(w0),al=sw/(2*Q);
  let b0,b1,b2,a0,a1,a2;
  if(type==='lowpass'){b0=(1-cw)/2;b1=1-cw;b2=(1-cw)/2;a0=1+al;a1=-2*cw;a2=1-al;}
  else if(type==='highpass'){b0=(1+cw)/2;b1=-(1+cw);b2=(1+cw)/2;a0=1+al;a1=-2*cw;a2=1-al;}
  else{b0=al;b1=0;b2=-al;a0=1+al;a1=-2*cw;a2=1-al;}
  b0/=a0;b1/=a0;b2/=a0;a1/=a0;a2/=a0;
  const w=2*Math.PI*f/fs,c1=Math.cos(w),s1=Math.sin(w),c2=Math.cos(2*w),s2=Math.sin(2*w);
  const nr=b0+b1*c1+b2*c2,ni=-(b1*s1+b2*s2),dr=1+a1*c1+a2*c2,di=-(a1*s1+a2*s2);
  const mag=Math.sqrt((nr*nr+ni*ni)/(dr*dr+di*di));return 20*Math.log10(Math.max(mag,1e-5));}

function makeEngine(ctx){
  const fx={vx:.5,vy:.45,cutoff:.62,res:0,amount:0,shape:'sine',rateMode:'sync',syncDiv:'8',rateHz:3,
            drive:0,delay:0,reverb:.12,revSize:'med',delayDiv:'8',beat:false,pattern:'floor',bass:false,drumCover:12000,bassHeat:0,tempo:112,arpDiv:2,gate:.5};
  const inG=ctx.createGain();inG.gain.value=.9;
  const moveFilt=ctx.createBiquadFilter();moveFilt.type='lowpass';moveFilt.frequency.value=xToF(fx.cutoff);moveFilt.Q.value=QFor(fx.res);
  const ampTrem=ctx.createGain();ampTrem.gain.value=1;
