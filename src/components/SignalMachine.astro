const FXFIELDS=['cutoff','res','amount','tempo'];
const REC={on:false,replaying:false,t0:0,events:[],lastFx:{},lastCapT:0,timers:[],
  instrument(e){['noteOn','noteOff','gesture','setBeat','setBass','setArp','setLatch'].forEach(m=>{const orig=e[m];e['_'+m]=orig;
      e[m]=function(){if(REC.on&&!REC.replaying)REC.cap(m,Array.prototype.slice.call(arguments));return orig.apply(e,arguments);};});
    const ap=e.apply;e._apply=ap;e.apply=function(){if(REC.on&&!REC.replaying)REC.capFx();return ap.call(e);};},
  cap(type,arr){this.events.push([Math.round(performance.now()-this.t0),type].concat(arr||[]));},
  capFx(){const now=performance.now();if(now-this.lastCapT<45)return;this.lastCapT=now;
    FXFIELDS.forEach(f=>{const v=+(+eng.fx[f]).toFixed(3);if(v!==this.lastFx[f]){this.lastFx[f]=v;this.cap('f',[f,v]);}});},
  start(){if(!live||!eng)return;this.stopPlay();this.on=true;this.replaying=false;this.t0=performance.now();this.events=[];this.lastCapT=0;
    this.lastFx={};FXFIELDS.forEach(f=>this.lastFx[f]=+(+eng.fx[f]).toFixed(3));this.snap=captureSnapshot();
    recBtn.classList.add('armed');playBtn.setAttribute('disabled','');shareBtn.setAttribute('disabled','');tkSet('REC ● — playing is recording');},
  stop(){if(!this.on)return;this.on=false;const dur=Math.round(performance.now()-this.t0);
    currentTake={snap:this.snap,events:this.events,dur};recBtn.classList.remove('armed');
    playBtn.removeAttribute('disabled');shareBtn.removeAttribute('disabled');tkSet('<b>take</b> · '+(dur/1000).toFixed(1)+'s · '+this.events.length+' moves');},
  play(take){if(!take)return;if(!live||!eng){tkSet('press power first');return;}this.stopPlay();this.replaying=true;
    applySnapshot(take.snap);take.events.forEach(ev=>this.timers.push(setTimeout(()=>reflect(ev),ev[0])));
    this.timers.push(setTimeout(()=>this.stopPlay(true),take.dur+250));
    playBtn.classList.add('playing');playBtn.textContent='■ STOP';tkSet('▶ playing the take');},
  stopPlay(natural){this.timers.forEach(clearTimeout);this.timers=[];if(!this.replaying)return;this.replaying=false;
    piano.querySelectorAll('.press').forEach(k=>{const q=k.dataset.q;if(eng)eng.noteOff('k'+q);k.classList.remove('press');});
    Object.values(GMAP).forEach(g=>{if(eng&&eng.gestures[g]){eng.gesture(g,false);gpadFor(g).classList.remove('on');}});
    playBtn.classList.remove('playing');playBtn.textContent='▶ PLAY';if(natural)tkSet('<b>take</b> · played');}
};
let currentTake=null;
const recBtn=$('#recBtn'),playBtn=$('#playBtn'),shareBtn=$('#shareBtn'),takeflag=$('#takeflag');
function tkSet(html){$('#tkstat').innerHTML=html;}
function spillKey(q){const sp=$('#spill'),kel=keyEl(q);if(sp&&kel){sp.style.transform='translateX('+(kel.offsetLeft+kel.offsetWidth/2)+'px)';sp.classList.add('on');clearTimeout(sp._t);sp._t=setTimeout(()=>sp.classList.remove('on'),140);}}
function captureSnapshot(){return {
  vx:+eng.fx.vx.toFixed(3),vy:+eng.fx.vy.toFixed(3),cutoff:+eng.fx.cutoff.toFixed(3),res:+eng.fx.res.toFixed(3),amount:+eng.fx.amount.toFixed(3),
  shape:eng.fx.shape,rateMode:eng.fx.rateMode,syncDiv:eng.fx.syncDiv,rateHz:eng.fx.rateHz,tempo:eng.fx.tempo,
  drive:+eng.fx.drive.toFixed(3),delay:+eng.fx.delay.toFixed(3),reverb:+eng.fx.reverb.toFixed(3),revSize:eng.fx.revSize,delayDiv:eng.fx.delayDiv,
  pattern:eng.fx.pattern,bassHeat:+eng.fx.bassHeat.toFixed(3),drumCover:eng.fx.drumCover,arpDiv:eng.fx.arpDiv,gate:eng.fx.gate,
  oct:octOff,lock:scaleLock,beat:$('#beat').classList.contains('on'),bass:$('#bassrow').classList.contains('on'),arp:$('#arpBtn').dataset.on==='1',latch:$('#latchBtn').dataset.on==='1'};}
function segOn(id,val){const seg=document.getElementById(id);if(seg)seg.querySelectorAll('b').forEach(b=>b.classList.toggle('on',b.dataset.v===val));}
function fillSet(key,v){const c=document.querySelector('.fillcard[data-key="'+key+'"]'),f=c.querySelector('.fill');f.style.height=(v*100).toFixed(0)+'%';f.classList.toggle('mt',v<=0.004);c.querySelector('.pc').textContent=Math.round(v*100);eng.fx[key]=v;}
function setToggleBeat(on){if($('#beat').classList.contains('on')===on)return;$('#beat').classList.toggle('on',on);eng.setBeat(on);}
function setToggleBass(on){if($('#bassrow').classList.contains('on')===on)return;$('#bassrow').classList.toggle('on',on);eng.setBass(on);}
function setToggleArp(on){if(($('#arpBtn').dataset.on==='1')===on)return;$('#arpBtn').dataset.on=on?'1':'0';$('#arpBtn').classList.toggle('on',on);$('#arpBtn').textContent=on?'ON':'OFF';$('#arpbar').classList.toggle('armed',on);eng.setArp(on);refreshLatch();}
function setToggleLatch(on){if(($('#latchBtn').dataset.on==='1')===on)return;$('#latchBtn').dataset.on=on?'1':'0';$('#latchBtn').classList.toggle('on',on);eng.setLatch(on);refreshLatch();}
function applySnapshot(s){
  eng.fx.cutoff=s.cutoff;eng.fx.res=s.res;eng.fx.shape=s.shape;eng.fx.rateMode=s.rateMode;eng.fx.syncDiv=s.syncDiv;eng.fx.rateHz=s.rateHz;
  eng.fx.delayDiv=s.delayDiv;eng.fx.pattern=s.pattern;eng.fx.arpDiv=s.arpDiv;eng.fx.gate=s.gate;eng.fx.vx=s.vx;eng.fx.vy=s.vy;eng.fx.tempo=s.tempo;
  $('#bpm').textContent=s.tempo;
  amtKnob.set(s.amount);eng.fx.amount=s.amount;$('#amtNum').textContent=Math.round(s.amount*100);$('#amtKnob').style.setProperty('--glowA',s.amount.toFixed(2));
  if(s.rateMode==='sync'){const i=Math.max(0,SYNCS.findIndex(x=>x.v===s.syncDiv));rateKnobObj.set(i/(SYNCS.length-1));$('#rateNum').textContent=(SYNCS[i]||{l:'1/8'}).l;$('#syncBtn').classList.add('on');$('#hzBtn').classList.remove('on');}
  else{rateKnobObj.set(clamp(Math.log(s.rateHz/0.1)/Math.log(120),0,1));$('#rateNum').textContent=s.rateHz.toFixed(1)+'Hz';$('#hzBtn').classList.add('on');$('#syncBtn').classList.remove('on');}
  $('#shapeRow').querySelectorAll('.hw').forEach(x=>x.classList.toggle('on',x.dataset.v===s.shape));
  segOn('patSeg',s.pattern);segOn('rateSeg',String(s.arpDiv));segOn('gateSeg',String(s.gate));segOn('drate',s.delayDiv);segOn('rsize',s.revSize);
  document.querySelector('.fillcard[data-key="delay"]').style.setProperty('--seg',SEGW[s.delayDiv]||'10px');
  document.querySelector('.fillcard[data-key="reverb"]').style.setProperty('--cloud',CLOUDS[s.revSize]||'10px');
  fillSet('drive',s.drive);fillSet('delay',s.delay);fillSet('reverb',s.reverb);eng.setRevSize(s.revSize);
  eng.setCover(s.drumCover);const cv=clamp(Math.log(s.drumCover/60)/Math.log(200),0,1);$('#coverfill').style.width=(cv*100)+'%';$('#coverhandle').style.left=(cv*100)+'%';$('#coverval').textContent=cv>=.97?'OPEN':cv<=.04?'MUFFLED':(s.drumCover>=1000?(s.drumCover/1000).toFixed(1)+'k':s.drumCover+'Hz');
  eng.setBassHeat(s.bassHeat);$('#bcoverfill').style.width=(s.bassHeat*100)+'%';$('#bcoverhandle').style.left=(s.bassHeat*100)+'%';$('#bcoverval').textContent=s.bassHeat<=.04?'SUB':s.bassHeat>=.97?'FULL':Math.round(s.bassHeat*100)+'%';
  setOct(s.oct);scaleLock=s.lock;$('#lockseg').querySelectorAll('b').forEach(b=>b.classList.toggle('on',(b.dataset.v==='lock')===s.lock));piano.classList.toggle('locked',s.lock);
  setToggleBeat(s.beat);setToggleBass(s.bass);setToggleArp(s.arp);setToggleLatch(s.latch);
  eng.apply();drawFilter();setVoiceDisplay();$('#vpuck').style.left=(s.vx*100)+'%';$('#vpuck').style.top=(s.vy*100)+'%';startPulse();if(s.amount>0)startLfoAnim();}
function reflect(ev){const type=ev[1];
  if(type==='noteOn'){eng.noteOn(ev[2],ev[3]);const q=ev[2].slice(1);lightKey(q,true);const o=QO[q];if(o!=null)showNote(snapOffset(o));spillKey(q);refreshLatch();}
  else if(type==='noteOff'){eng.noteOff(ev[2]);lightKey(ev[2].slice(1),false);refreshLatch();}
  else if(type==='gesture'){eng.gesture(ev[2],ev[3]);gpadFor(ev[2]).classList.toggle('on',!!(ev[3]&&eng.gestures[ev[2]]));if(ev[2]==='fill')refreshPat();}
  else if(type==='setBeat')setToggleBeat(ev[2]);
  else if(type==='setBass')setToggleBass(ev[2]);
  else if(type==='setArp')setToggleArp(ev[2]);
  else if(type==='setLatch')setToggleLatch(ev[2]);
  else if(type==='morph'){eng.fx.vx=ev[2];eng.fx.vy=ev[3];$('#vpuck').style.left=(ev[2]*100)+'%';$('#vpuck').style.top=(ev[3]*100)+'%';setVoiceDisplay();}
  else if(type==='f'){const fld=ev[2],val=ev[3];eng.fx[fld]=val;eng.apply();
    if(fld==='cutoff'||fld==='res')drawFilter();
    else if(fld==='amount'){amtKnob.set(val);$('#amtNum').textContent=Math.round(val*100);$('#amtKnob').style.setProperty('--glowA',val.toFixed(2));startLfoAnim();}
    else if(fld==='tempo'){$('#bpm').textContent=val;startPulse();}}}
function b64u(s){return btoa(unescape(encodeURIComponent(s))).replace(/\+/g,'-').replace(/\//g,'_').replace(/=+$/,'');}
function ub64(s){s=s.replace(/-/g,'+').replace(/_/g,'/');while(s.length%4)s+='=';return decodeURIComponent(escape(atob(s)));}
function encodeTake(take){return b64u(JSON.stringify({v:1,d:take.dur,s:take.snap,e:take.events}));}
function decodeTake(b64){try{const o=JSON.parse(ub64(b64));if(o&&o.s&&o.e)return{snap:o.s,events:o.e,dur:o.d||0};}catch(e){}return null;}
recBtn.addEventListener('click',()=>{if(!live){tkSet('press power first');return;}REC.on?REC.stop():REC.start();});
playBtn.addEventListener('click',()=>{if(playBtn.hasAttribute('disabled'))return;REC.replaying?REC.stopPlay():REC.play(currentTake);});
shareBtn.addEventListener('click',()=>{if(!currentTake)return;const url=location.origin+location.pathname+'?take='+encodeTake(currentTake)+'#signal';
  (navigator.clipboard?navigator.clipboard.writeText(url):Promise.reject()).then(()=>tkSet('<b>link copied</b> — paste anywhere'),()=>{takeflag.innerHTML='Share link: <b>'+url.slice(0,80)+'…</b>';takeflag.classList.add('show');});});
function demoGroove(){const f=o=>261.63*Math.pow(2,o/12);
  return {dur:3900,snap:{vx:.42,vy:.4,cutoff:.6,res:0,amount:0,shape:'sine',rateMode:'sync',syncDiv:'8',rateHz:3,tempo:112,drive:0,delay:.25,reverb:.32,revSize:'med',delayDiv:'8',pattern:'floor',bassHeat:0,drumCover:12000,arpDiv:2,gate:.5,oct:0,lock:true,beat:true,bass:true,arp:false,latch:false},
    events:[[450,'noteOn','ka',f(0)],[700,'noteOff','ka'],[750,'noteOn','kg',f(7)],[1000,'noteOff','kg'],[1050,'noteOn','kk',f(12)],[1300,'noteOff','kk'],[1350,'noteOn','kh',f(9)],[1750,'noteOff','kh'],[1850,'f','cutoff',.42],[2050,'f','cutoff',.56],[2250,'f','cutoff',.72],[2450,'gesture','lift',true],[2500,'noteOn','kf',f(5)],[2950,'noteOff','kf'],[3050,'noteOn','ka',f(0)],[3300,'gesture','lift',false],[3650,'noteOff','ka']]};}
const FEATURED=[{name:'demo · groove',take:demoGroove()}];
FEATURED.forEach(ft=>{const el=document.createElement('span');el.className='feat';el.textContent=ft.name;
  el.addEventListener('click',()=>{currentTake=ft.take;playBtn.removeAttribute('disabled');shareBtn.removeAttribute('disabled');tkSet('loaded <b>'+ft.name+'</b> — press ▶ PLAY');});
  $('#featshelf').appendChild(el);});
let urlTakeShown=false;
function takeFromUrl(){const sp=new URLSearchParams(location.search).get('take');if(sp)return sp;const m=(location.hash||'').match(/take=([^&]+)/);return m?m[1]:null;}
function loadIncomingTake(){if(urlTakeShown)return;const raw=takeFromUrl();if(!raw)return;const t=decodeTake(raw);if(!t)return;urlTakeShown=true;currentTake=t;
  takeflag.innerHTML='A shared take is loaded (<b>'+(t.dur/1000).toFixed(1)+'s</b>). Press <b>power</b>, then <b>▶ PLAY</b>.';takeflag.classList.add('show');
  playBtn.removeAttribute('disabled');shareBtn.removeAttribute('disabled');}
loadIncomingTake();window.addEventListener('load',loadIncomingTake);window.addEventListener('hashchange',()=>{urlTakeShown=false;loadIncomingTake();});

setVoiceDisplay();

/* ════ SIGNAL on the homepage: boot ceremony + viewport + touch stance + sitewide sound flag ════
   Per the instrument-boot handoff: the power press is the AudioContext consent recast as narrative.
   Trace technique mirrors SecretDoor.astro (recolored amber); NOT imported — one home per trick. */
const sgm=document.getElementById('sgm');
let inView=false,booting=false;
const reduceMq=window.matchMedia('(prefers-reduced-motion: reduce)');
const touchStance=!window.matchMedia('(pointer: fine)').matches;
if(touchStance)sgm.dataset.touch='1';

/* status line typewriter (one-shot per call; instant under reduced motion) */
let typeT=null;
function typeStatus(text){clearInterval(typeT);if(reduceMq.matches){statusline.textContent=text;return;}
  statusline.textContent='';let i=0;typeT=setInterval(()=>{statusline.textContent=text.slice(0,++i);if(i>=text.length)clearInterval(typeT);},26);}

/* amber border-trace (SecretDoor's dashoffset move, recolored) */
const traceSvg=sgm.querySelector('.sgm-trace'),trL=sgm.querySelector('.tr-l'),trR=sgm.querySelector('.tr-r');
function buildTrace(){const w=device.clientWidth,h=device.clientHeight;if(!w||!h)return false;
  const r=Math.max(2,Math.min(22,Math.min(w,h)/2-1));
  traceSvg.setAttribute('viewBox','0 0 '+w+' '+h);
  trR.setAttribute('d','M'+(w/2)+' 1 H'+(w-r)+' A'+r+' '+r+' 0 0 1 '+(w-1)+' '+r+' V'+(h-r)+' A'+r+' '+r+' 0 0 1 '+(w-r)+' '+(h-1)+' H'+(w/2));
  trL.setAttribute('d','M'+(w/2)+' 1 H'+r+' A'+r+' '+r+' 0 0 0 1 '+r+' V'+(h-r)+' A'+r+' '+r+' 0 0 0 '+r+' '+(h-1)+' H'+(w/2));
  [trL,trR].forEach(p=>{const L=p.getTotalLength();p.style.transition='none';p.style.strokeDasharray=String(L);p.style.strokeDashoffset=String(L);});
  return true;}

/* one soft pluck — the boot ends on sound (sine+triangle, ~400ms, pentatonic C5) */
function bootPluck(){try{const ac=getCtx(),t=ac.currentTime+0.02;
  const o=ac.createOscillator(),o2=ac.createOscillator(),g=ac.createGain(),lp=ac.createBiquadFilter();
  o.type='sine';o2.type='triangle';o.frequency.value=523.25;o2.frequency.value=1046.5;
  lp.type='lowpass';lp.frequency.value=2600;
  g.gain.setValueAtTime(0,t);g.gain.linearRampToValueAtTime(0.09,t+0.012);g.gain.exponentialRampToValueAtTime(0.0008,t+0.4);
  o.connect(g);o2.connect(g);g.connect(lp);lp.connect(ac.destination);
  o.start(t);o2.start(t);o.stop(t+0.45);o2.stop(t+0.45);}catch(e){}}

function markSoundOn(){try{localStorage.setItem('jt-sound','on');}catch(e){}
  try{window.dispatchEvent(new CustomEvent('jt-sound',{detail:'on'}));}catch(e){}}

/* the wake cascade groups, in spec order: keys, drums, bass, FX, filter LAST */
function wakeGroups(){return [
  ['.pianowrap,.arpbar,.gestbar',                          1150],
  ['.tempo,.kick,.patseg,.command>.coverslide:first-of-type',1400],
  ['#bassrow,.command>.coverslide:nth-of-type(2)',          1600],
  ['.zone:nth-child(2) .pad,.efx,.micin,.vocalbar',         1800],
  ['.afz .afilter,.afz .lfostrip',                          2100],
];}

function finishPower(){const fresh=!eng;eng=eng||makeEngine(getCtx());if(fresh)REC.instrument(eng);const c=getCtx();c.resume&&c.resume();eng.apply();
  live=true;device.classList.add('live');sgm.dataset.state='live';pwr.setAttribute('aria-pressed','true');
  typeStatus('LIVE · typing is playing');setVoiceDisplay();drawFilter();startPulse();startLfoAnim();
  eng.onKick(()=>{const kk=document.getElementById('beat');kk.classList.remove('hit');void kk.offsetWidth;kk.classList.add('hit');setTimeout(()=>kk.classList.remove('hit'),90);});
  eng.onArp(()=>{const l=document.getElementById('arpLed');l.classList.add('blip');clearTimeout(l._t);l._t=setTimeout(()=>l.classList.remove('blip'),80);});
  bootPluck();markSoundOn();}

function powerToggle(){
  if(booting)return;
  if(touchStance){typeStatus('Built for a keyboard · best on a desktop');return;}
  if(live){live=false;device.classList.remove('live');sgm.dataset.state='standby';pwr.setAttribute('aria-pressed','false');
    doPowerOff();sgm.querySelectorAll('.wk').forEach(el=>el.classList.remove('wk'));
    traceSvg.style.opacity=0;return;}
  const seen=(()=>{try{return sessionStorage.getItem('sgm-ceremony');}catch(e){return '1';}})();
  if(reduceMq.matches||seen){finishPower();return;}                       // the instant flip, demoted to fallback
  try{sessionStorage.setItem('sgm-ceremony','1');}catch(e){}
  booting=true;sgm.dataset.state='boot';
  /* 1 · amber trace draws the perimeter (~1.2s) */
  if(buildTrace()){traceSvg.style.opacity=1;void sgm.offsetWidth;
    [trL,trR].forEach(p=>{p.style.transition='';});void sgm.offsetWidth;
    [trL,trR].forEach(p=>{p.style.strokeDashoffset='0';});}
  /* 2 · glass screens bulb up like CRT filaments */
  setTimeout(()=>{sgm.querySelectorAll('.screen').forEach((s,i)=>{setTimeout(()=>s.classList.add('bulb'),i*80);});},850);
  /* 3 · saturation cascades per module */
  wakeGroups().forEach(([sel,at])=>setTimeout(()=>{sgm.querySelectorAll(sel).forEach(el=>{
    (el.classList.contains('sleeps')?el:el.closest('.sleeps')||el).classList.add('wk');el.classList.add('wk');}),0;},at));
  /* 4 · LED crossfades red → green */
  setTimeout(()=>pwr.classList.add('lit'),2150);
  /* 5 · the boot ends on sound */
  setTimeout(()=>{booting=false;pwr.classList.remove('lit');
    sgm.querySelectorAll('.screen.bulb').forEach(s=>s.classList.remove('bulb'));
    traceSvg.style.opacity=0;
    finishPower();},2480);}

/* viewport: gate the standby breathe; first entry = one LED flare + the typed status line */
let flared=false;
const io=new IntersectionObserver((es)=>{es.forEach(e=>{inView=e.isIntersecting;sgm.classList.toggle('inview',inView);
  if(inView&&!flared){flared=true;pwr.classList.add('flare');setTimeout(()=>pwr.classList.remove('flare'),950);
    typeStatus(touchStance?'Built for a keyboard · best on a desktop':'STANDBY · press power');}});},{threshold:0.25});
io.observe(sgm);

</script>
