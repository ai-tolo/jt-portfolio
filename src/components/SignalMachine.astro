/* arp RATE knob — 8 stepped divisions baked across the dial's 0..1 travel (was a 4-button seg). arpDiv = subdivisions per quarter beat: tickDur=60/tempo/arpDiv. The knob position picks an index into ARP_DIVS; the chosen division shows in the in-label .kn (knob position carries it too). */
const ARP_DIVS=[{l:'1/2',v:.5},{l:'1/4',v:1},{l:'1/4T',v:1.5},{l:'1/8',v:2},{l:'1/8T',v:3},{l:'1/16',v:4},{l:'1/16T',v:6},{l:'1/32',v:8}];
const arpDivIdxFromV=v=>clamp(Math.round(v*(ARP_DIVS.length-1)),0,ARP_DIVS.length-1);
const arpDivIdxFromVal=val=>{let bi=0,bd=Infinity;ARP_DIVS.forEach((d,i)=>{const dd=Math.abs(d.v-val);if(dd<bd){bd=dd;bi=i;}});return bi;};
const arpRateKnobObj=makeKnob($('#arpRateKnob'),3/(ARP_DIVS.length-1),v=>{if(!live||!eng)return;const d=ARP_DIVS[arpDivIdxFromV(v)];eng.fx.arpDiv=d.v;$('#arpRateNum').textContent=d.l;armArp();});
const lenKnob=makeKnob($('#lenKnob'),.355,v=>{if(eng)eng.fx.gate=0.06+v*1.24;armArp();});   // arp note LENGTH — converted slider→knob to free arp-bar width for the readout (Jon 2026-06-15)

/* performance gestures (hold) — Z/X/C=GATE at 1/8·1/16·1/32, M=DIVE. The three gate keys drive ONE shared gate gesture at different chop rates (last-press wins). B toggles BASS (see keydown below). LIFT/THROW/FILL retired. */
const GMAP={KeyZ:{g:'gate',rate:8},KeyX:{g:'gate',rate:4},KeyC:{g:'gate',rate:2},KeyM:{g:'dive'}};   // batch4 #5: keyboard rates match the swapped UI (Z=1/32, X=1/16, C=1/8)
const gpadFor=g=>document.querySelector('.gpad[data-g="'+g+'"]');
const gpadRate=rate=>document.querySelector('.gpad.gate[data-rate="'+rate+'"]');
function refreshPat(){if(!eng)return;const p=eng.fx.pattern;$('#patSeg').querySelectorAll('b').forEach(b=>b.classList.toggle('on',b.dataset.v===p));}
/* g = gesture name; rate (optional) = gate chop divisor. Lights the active gate-rate keycap (or the single lift/dive pad). */
function setGesture(g,on,rate){if(!live||!eng)return;eng.gesture(g,on,rate);const lit=on&&eng.gestures[g];
  if(g==='gate'){document.querySelectorAll('.gpad.gate').forEach(p=>p.classList.remove('on'));if(lit){const _p=gpadRate(rate);if(_p)_p.classList.add('on');}}
  else{const _p=gpadFor(g);if(_p)_p.classList.toggle('on',!!lit);}
  if(g==='fill')refreshPat();}
window.addEventListener('keydown',e=>{const m=GMAP[e.code];if(!m||e.repeat||!inView)return;setGesture(m.g,true,m.rate);});
window.addEventListener('keyup',e=>{const m=GMAP[e.code];if(!m)return;setGesture(m.g,false,m.rate);});
window.addEventListener('blur',()=>{if(!eng)return;Object.values(GMAP).forEach(m=>{if(eng.gestures[m.g])setGesture(m.g,false,m.rate);});});
/* drop controls — bring in the groove from the keyboard while holding a chord (Jon 2026-06-15): SPACE toggles DRUMS, B toggles BASS (mirrors the #bassrow on-screen click exactly). */
window.addEventListener('keydown',e=>{if(!live||!eng||!inView||e.repeat)return;
  if(e.code==='Space'){e.preventDefault();const on=!$('#beat').classList.contains('on');$('#beat').classList.toggle('on',on);eng.setBeat(on);refreshTransport();}
  else if(e.code==='KeyB'){e.preventDefault();const on=!$('#bassrow').classList.contains('on');$('#bassrow').classList.toggle('on',on);eng.setBass(on);refreshTransport();}});
