    .octreadout small{font-size:.4rem;letter-spacing:.2em;color:#637b97;margin-top:2px}
    /* octave & key readouts as little glass screens (like the BPM module): dark glass, amber-lit digit */
    .ohscreen{position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;line-height:1;min-width:48px;padding:6px 9px;border-radius:2px;background:radial-gradient(130% 130% at 50% 0%,#080e16,#04060b 80%);box-shadow:inset 0 0 0 1px rgba(0,0,0,.82),inset 0 2px 8px rgba(0,0,0,.7),inset 0 -1px 0 rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.05)}
    .ohscreen b{font-family:ui-monospace,Menlo,monospace;font-size:1rem;letter-spacing:.04em;color:#34404e;transition:color .5s,text-shadow .5s}
