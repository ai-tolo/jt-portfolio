let _rdKey='';
function coachRender(o){
  if(!readoutEl)return;
  o=o||{};const a=o.a||'',b=o.b||'',c=o.c||'';
  const key=a+''+b+''+c+''+(o.rest?'1':'0');
  if(key===_rdKey)return; _rdKey=key;                  // no-op guard — never rebuild identical text
  readoutEl.classList.toggle('rest',!!o.rest);
  let h='<span class="rdwrap">';
  if(a)h+='<span class="rl a">'+a+'</span>';
  if(b)h+='<span class="rl b">'+b+'</span>';
  if(c)h+='<span class="rl c">'+c+'</span>';
  readoutEl.innerHTML=h+'</span>';
