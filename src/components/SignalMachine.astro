    /* #4 ARP+CHORD: NOTE/CHORD is the inline split toggle right of the 'Arpeggiator' label. It is NOT arp-dependent (manual chord play works with the arp OFF), so it opts out of the .arpsec:has(.seg) dim and stays full-opacity even when the arp isn't armed. */
    .device.live .arpmod:not(.armed) .arpsec:has(.chordsplit){opacity:1}
    /* split toggle: a .seg housing that collapses to a single '+ CHORD' pill and blooms into the [NOTE|CHORD] split when .split (chordMode on). */
    .arpmod .seg.chordsplit{width:auto;gap:0;overflow:hidden;transition:opacity .35s ease}
    .chordsplit b{flex:none;white-space:nowrap;padding:6px 12px;letter-spacing:.04em;font-size:.54rem;transition:max-width .26s ease,padding .26s ease,opacity .2s ease,transform .07s,box-shadow .12s,color .12s;max-width:120px;overflow:hidden}
    /* collapsed (default): show only the '+ CHORD' affordance pill; hide both radios with a width collapse so the bloom animates */
    .chordsplit .csp{display:flex}
    .chordsplit:not(.split) [role=radio]{max-width:0;padding-left:0;padding-right:0;opacity:0;pointer-events:none}
    .chordsplit .csp .led{display:none}
    /* expanded (.split, chordMode on): hide the affordance pill, reveal the [NOTE|CHORD] split with a gap */
    .chordsplit.split{gap:4px}
    .chordsplit.split .csp{max-width:0;padding-left:0;padding-right:0;opacity:0;pointer-events:none}
  
    .pianohead{position:relative;z-index:5;display:flex;align-items:center;gap:18px;font-family:ui-monospace,Menlo,monospace;font-size:.5rem;letter-spacing:.16em;text-transform:uppercase;color:#7d8a99;margin-bottom:3px;padding:8px 12px;border-radius:11px;background:radial-gradient(130% 130% at 50% 0%,#121a26,#080c12 86%);border:1px solid rgba(255,255,255,.05);box-shadow:inset 0 1px 0 rgba(255,255,255,.05),inset 0 0 0 1px rgba(0,0,0,.6),inset 0 3px 11px rgba(0,0,0,.56)}   /* batch8 #1: tighter gap to the keys (was 9px) + own stacking layer (z-5, opaque bg) so the keys' play-glow can't bleed up into this panel */
    .transport{display:flex;align-items:center}
    .transport .tbtn{height:30px;padding:0 12px;font-size:.55rem;border-radius:8px;box-shadow:inset 0 1.2px 0.4px rgba(255,255,255,.2),inset 0 -4px 6px rgba(0,0,0,.5),0 3px 0 #0a0d12,0 4px 7px rgba(0,0,0,.55)}
    /* transport relocated into the top bar — centered between spacers, dimmed until power */
    .io .iotransport{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);gap:7px}   /* absolutely centered → never shifts when neighbours change width on power on/off */
    .device:not(.live) .io .iotransport{opacity:.45;pointer-events:none}
    .lockseg b{flex:none;padding:6px 12px;letter-spacing:.04em;white-space:nowrap}
    .chordseg b{flex:none;padding:6px 12px;letter-spacing:.04em;white-space:nowrap}
    .octctl,.keyctl{display:flex;align-items:center;gap:8px}
    .octbtn{width:30px;height:30px;border:none;border-radius:8px;display:flex;align-items:center;justify-content:center;cursor:pointer;color:#bcc7d3;font-size:.8rem;user-select:none;
      background:linear-gradient(180deg,#464e5c 0%,#2c333f 47%,#1f2630 100%);
      border-top:1px solid rgba(255,255,255,.12);
      box-shadow:inset 0 1.2px 0.5px rgba(255,255,255,.22),inset 0 -4px 6px rgba(0,0,0,.5),0 4px 0 #0a0d12,0 5px 7px rgba(0,0,0,.55);transition:transform .07s,box-shadow .12s}
    .octbtn:active{transform:translateY(3px);color:#eafaff;
      background:linear-gradient(180deg,#2d343f,#1a212b);
      box-shadow:inset 0 2px 5px rgba(0,0,0,.6),inset 0 0 11px -4px var(--sapphire),0 1px 0 #0a0d12,0 2px 3px rgba(0,0,0,.5)}
    .octreadout{display:flex;flex-direction:column;align-items:center;line-height:1;min-width:46px}
