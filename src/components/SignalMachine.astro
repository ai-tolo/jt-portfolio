---
// SIGNAL — the instrument. A faithful port of the blessed mock
// (/tmp/signal-explore/machine-v11.html, v1..v11 iterated with Jon by ear) plus the
// power-on ceremony from the instrument-boot handoff. The engine is untouched mock
// code: audio exists only after the power press; everything dies on power-off/pagehide.
// Coordination: SecretDoor.astro and the-console.astro belong to the NEEDLE DROP
// session — the trace below copies the technique, never the component.
---

<section class="section signal-sec" id="signal" aria-label="The instrument">
  <div class="inner">
    <p class="sgm-intro">The instrument. Built for this page. Press power, type to play.</p>
    {/* intro variants for Jon: "One machine, built in the open. Power it on." /
        "This one is not a case study. Press power." */}
    <div class="sgm" id="sgm" data-state="standby">
      <svg class="sgm-trace" aria-hidden="true"><path class="tr-l"></path><path class="tr-r"></path></svg>
      <div class="device" id="device">
          <span class="screw tl"></span><span class="screw tr"></span><span class="screw bl"></span><span class="screw br"></span>
      
          <div class="io">
            <button class="pwr" id="pwr" aria-label="Power" aria-pressed="false"><svg viewBox="0 0 24 24"><path d="M12 3.5 V11"/><path d="M6.6 6.8 a7.5 7.5 0 1 0 10.8 0"/></svg></button>
            <span class="nameplate"><b>SIGNAL</b> · MK-XI<span class="st" id="statusline">STANDBY · press power</span></span>
            <div class="spacer"></div>
            <div class="notereadout">· <b id="notebig"></b></div>
            <div class="micin sleeps" id="micin" role="button" tabindex="0" aria-pressed="false"><svg viewBox="0 0 24 24"><rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3"/></svg>VOICE IN</div>
          </div>
      
          <!-- VOICE treatment strip (appears when VOICE IN is live) -->
          <div class="vocalbar" id="vocalbar">
            <span class="al">Voice <i class="vu" id="micvu"></i></span>
            <span class="hw vchip on" data-v="dry">DRY</span>
            <span class="hw vchip" data-v="telephone">TELEPHONE</span>
            <span class="hw vchip" data-v="hall">HALL</span>
            <span class="hw vchip" data-v="double">DOUBLE</span>
            <span class="hw vchip" data-v="robot">ROBOT</span>
            <span class="hw vchip" data-v="air">AIR</span>
            <span class="hw vchip" data-v="tunnel">TUNNEL</span>
            <span class="al" style="margin-left:auto">Depth</span>
            <div class="strack vdepth" id="vdepth"><span class="sfill" id="vdfill"></span><span class="shandle" id="vdhandle"></span></div>
          </div>
      
          <div class="console">
            <!-- COMMAND -->
            <div class="zone"><div class="glab"><span class="dot"></span>Command</div>
              <div class="zbody"><div class="command sleeps">
                <div class="tempo screen" id="tempo"><span class="pls" id="pls"></span><b id="bpm">112</b><small>BPM · DRAG</small></div>
                <div class="kick" id="beat"><span class="drum"></span><span class="kl">BEAT</span><span class="toggle"><i></i></span></div>
                <div class="seg patseg" id="patSeg"><b class="on" data-v="floor">FLOOR</b><b data-v="back">BACK</b><b data-v="half">HALF</b><b data-v="break">BREAK</b></div>
                <div class="coverslide"><div class="ct"><span>DRUM COVER · LP</span><span class="cvv" id="coverval">OPEN</span></div>
                  <div class="strack" id="coverslide"><span class="sfill" id="coverfill"></span><span class="shandle" id="coverhandle"></span></div></div>
                <div class="crow" id="bassrow"><span class="cl">BASS · FOLLOWS YOU</span><span class="toggle"><i></i></span></div>
                <div class="coverslide"><div class="ct"><span>BASS · INTENSITY</span><span class="cvv" id="bcoverval">SUB</span></div>
                  <div class="strack" id="bcoverslide"><span class="sfill" id="bcoverfill"></span><span class="shandle" id="bcoverhandle"></span></div></div>
              </div></div>
            </div>
      
            <!-- VOICE -->
            <div class="zone"><div class="glab"><span class="dot"></span>Voice · morph<span class="vn" id="vnreadout">DRIFT</span></div>
              <div class="zbody"><div class="pad screen sleeps" id="vpad" style="--pc:#0ec4fc" role="application" aria-label="Voice morph field">
                <span class="grid"></span><span class="cross"></span>
                <span class="ax t">WIDE</span><span class="ax b">PURE</span><span class="ax l">DARK</span><span class="ax r">BRIGHT</span>
                <span class="puck" id="vpuck"></span>
              </div></div>
            </div>
      
            <!-- AUTO-FILTER -->
            <div class="zone"><div class="glab"><span class="dot" style="background:var(--pink);box-shadow:0 0 5px var(--pink)"></span>Auto-filter · low-pass · LFO</div>
              <div class="zbody afz">
                <div class="afilter screen sleeps" id="afilter" role="application" aria-label="Low-pass filter. Drag the node: sideways for cutoff, down to shave">
                  <svg class="afgrid" id="afgrid" preserveAspectRatio="none"></svg>
                  <svg class="afcurve" id="afcurveSvg" viewBox="0 0 600 200" preserveAspectRatio="none"><g id="afg"><path class="fillpath" id="affill"></path><path id="afpath"></path><path class="ghost" id="afghost"></path></g></svg>
                  <div class="afnode" id="afnode" role="slider" aria-label="Cutoff and shave"></div>
                  <span class="afhint">drag the node · ⇄ cutoff · ⇣ shave</span>
                </div>
                <div class="lfostrip sleeps">
                  <div class="shapegrid" id="shapeRow">
                    <span class="hw on" data-v="sine" title="sine"><svg viewBox="0 0 22 13"><path d="M1 6.5 Q5 1 9 6.5 T21 6.5"/></svg></span>
                    <span class="hw" data-v="tri" title="triangle"><svg viewBox="0 0 22 13"><path d="M1 11 L6 2 L11 11 L16 2 L21 11"/></svg></span>
                    <span class="hw" data-v="saw" title="saw"><svg viewBox="0 0 22 13"><path d="M1 11 L10 2 L10 11 L21 2"/></svg></span>
                    <span class="hw" data-v="sqr" title="square"><svg viewBox="0 0 22 13"><path d="M1 11 L1 2 L11 2 L11 11 L21 11 L21 2"/></svg></span>
                  </div>
                  <div class="scope" id="scope"><canvas id="scopeCv" width="252" height="92"></canvas><span class="sl">LFO</span><i class="cyc" id="cycdot"></i></div>
                  <div class="knob" id="amtKnob"><div class="dial"><div class="ptr"></div></div><span class="kl">MOTION</span><span class="kn" id="amtNum">0</span></div>
                  <div class="knob" id="rateKnob"><div class="dial"><div class="ptr"></div></div><span class="kl">RATE</span><span class="kn" id="rateNum">1/8</span></div>
                  <div class="ratemode"><b id="hzBtn">Hz</b><b id="syncBtn" class="on">♪</b></div>
                </div>
              </div>
            </div>
      
            <!-- EFFECTS -->
            <div class="zone"><div class="glab"><span class="dot"></span>Drive · Delay · Reverb</div>
              <div class="zbody"><div class="efx sleeps">
                <div class="fills" id="fills">
                  <div class="fillcard" data-key="drive" style="--fc:#ff9a4a"><span class="fill"></span><span class="fl">DRIVE</span><span class="pc">0</span></div>
                  <div class="fillcard" data-key="delay" style="--fc:#0ec4fc"><span class="fill"></span><span class="fl">DELAY</span><span class="pc">0</span></div>
                  <div class="fillcard" data-key="reverb" style="--fc:#7db5ff"><span class="fill"></span><span class="fl">REVERB</span><span class="pc">0</span></div>
                </div>
                <div class="drate"><span class="dl">Delay</span><div class="seg" id="drate" style="--acc:#0ec4fc"><b data-v="4">1/4</b><b class="on" data-v="8">1/8</b><b data-v="8d">1/8·</b><b data-v="16">1/16</b></div></div>
                <div class="drate"><span class="dl">Reverb</span><div class="seg" id="rsize" style="--acc:#7db5ff"><b data-v="small">SM</b><b class="on" data-v="med">MED</b><b data-v="hall">HALL</b><b data-v="vast">VAST</b></div></div>
              </div></div>
            </div>
          </div>
      
          <!-- ARP strip -->
          <div class="arpbar sleeps" id="arpbar">
            <span class="al">Arpeggiator <i class="led" id="arpLed"></i></span>
            <span class="hw" id="arpBtn" data-on="0">OFF</span>
            <span class="hw" id="latchBtn" data-on="0">LATCH</span>
            <span class="al">Rate</span><div class="seg" id="rateSeg"><b data-v="1">1/4</b><b class="on" data-v="2">1/8</b><b data-v="3">1/8T</b><b data-v="4">1/16</b></div>
            <span class="al">Length</span><div class="seg" id="gateSeg"><b data-v="0.25">SHORT</b><b class="on" data-v="0.5">HALF</b><b data-v="0.75">LONG</b><b data-v="1">FULL</b></div>
          </div>
      
          <!-- PIANO -->
          <div class="pianowrap sleeps">
            <div class="pianohead">
              <span>⌨ Keyboard</span>
              <div class="octctl"><span class="octbtn" id="octdn">◀</span><div class="octreadout"><b id="octval">0</b><small>OCTAVE</small></div><span class="octbtn" id="octup">▶</span><span class="octhint">← →</span></div>
              <div class="seg lockseg" id="lockseg" style="--acc:#0ec4fc"><b class="on" data-v="lock">SCALE · C MAJOR</b><b data-v="chrom">CHROMATIC</b></div>
            </div>
            <div class="piano locked" id="piano"><i class="spill" id="spill"></i></div>
          </div>
      
          <!-- PERFORMANCE row (hold while playing) -->
          <div class="gestbar sleeps" id="gestbar">
            <span class="gl">Performance · hold</span>
            <span class="gpad" data-g="lift"><b>Z</b>LIFT</span>
            <span class="gpad" data-g="gate"><b>X</b>GATE</span>
            <span class="gpad" data-g="throw"><b>C</b>THROW</span>
            <span class="gpad" data-g="fill"><b>V</b>FILL</span>
            <span class="gpad" data-g="dive"><b>B</b>DIVE</span>
          </div>
        </div>
    </div>

    {/* TAKE transport: record your performance, play it back, share a link */}
    <div class="takebar" id="takebar">
      <span class="tkl">Take</span>
      <span class="tbtn rec" id="recBtn" role="button" tabindex="0"><span class="dotr"></span>REC</span>
      <span class="tbtn" id="playBtn" role="button" tabindex="0" disabled>▶ PLAY</span>
      <span class="tbtn" id="shareBtn" role="button" tabindex="0" disabled>⤴ SHARE</span>
      <span class="tkstat" id="tkstat">press REC, then play</span>
      <span class="tkl" style="margin-left:auto">Featured</span>
      <div class="featshelf" id="featshelf"></div>
    </div>
    <p class="takeflag" id="takeflag"></p>

    <p class="sgm-foot" id="micnudge">VOICE IN routes your mic through the machine · use headphones to avoid feedback · your mic is never recorded or sent.</p>
  </div>
</section>

<style is:global>
  /* the section uses the SITE's .inner container (tokens.css) so it aligns with #work
     exactly; it owns its own vertical rhythm (index.astro's scoped .section padding
     does not reach component-rendered markup). */
  /* palette vars also live here because the take transport sits OUTSIDE .sgm */
  .signal-sec{padding:clamp(2.25rem,5vh,3.75rem) 0 var(--space-16,4rem);--amber:#ff9a4a;--red:#ff5a5a;--sapphire:#0ec4fc;--green:#3ddc84}
  .sgm-intro{font-size:1rem;color:var(--muted,#9aa6b4);margin:0 0 1.2rem;letter-spacing:.01em}
  .sgm-foot{display:none;font-family:ui-monospace,Menlo,monospace;font-size:.62rem;letter-spacing:.06em;color:#caa56a;margin:.7rem 0 0}
  .sgm-foot.show{display:block}
  .sgm{position:relative;--green:#3ddc84;--red:#ff5a5a;--sapphire:#0ec4fc;--pink:#ff8fb0;--amber:#ff9a4a;--curve:#5ec8f0;
    --metal-hi:#3a4150;--metal:#222834;--metal-lo:#11151d;--ink:#070a0e}
  .sgm .sgm-trace{position:absolute;inset:0;width:100%;height:100%;z-index:9;pointer-events:none;opacity:0;transition:opacity .5s ease .15s}
  .sgm .sgm-trace path{fill:none;stroke:var(--amber);stroke-width:2;stroke-linecap:round;
    filter:drop-shadow(0 0 6px color-mix(in srgb,var(--amber) 70%,transparent));
    transition:stroke-dashoffset 1.2s cubic-bezier(0.62,0,0.2,1)}
  .sgm .screen.bulb{animation:sgmbulb .7s ease-out both}
  /* Candid small-screen stance: show the WHOLE dormant faceplate, scaled — never a
     cropped half-machine. zoom keeps the layout box honest (no dead whitespace). */
  @media (max-width: 1140px){ .sgm .device{zoom:.82} }
  @media (max-width: 920px){ .sgm .device{zoom:.6} }
  @media (max-width: 700px){ .sgm .device{zoom:.44} }
  @media (max-width: 480px){ .sgm .device{zoom:.33} }
  .sgm[data-state="boot"] .pwr{pointer-events:none}
  .sgm .pwr.lit{background:radial-gradient(circle at 50% 32%,#1c3128,#0a0f0c 72%);box-shadow:0 0 24px -2px var(--green),inset 0 2px 2px rgba(255,255,255,.18),inset 0 -3px 5px rgba(0,0,0,.7),0 2px 4px rgba(0,0,0,.6)}
  .sgm .pwr.lit path{stroke:var(--green);filter:drop-shadow(0 0 5px var(--green))}
  .sgm[data-touch] .pwr{cursor:default}
  .sgm{
  
    
    *{box-sizing:border-box}
  
    .device{position:relative;border-radius:22px;padding:18px;display:flex;flex-direction:column;gap:15px;
      background:repeating-linear-gradient(90deg,rgba(255,255,255,.015) 0 1px,transparent 1px 3px),linear-gradient(158deg,var(--metal-hi) 0%,var(--metal) 30%,var(--metal-lo) 100%);
      border:1px solid rgba(0,0,0,.6);box-shadow:0 60px 110px -48px rgba(0,0,0,.92),inset 0 2px 0 rgba(255,255,255,.14),inset 0 -3px 1px rgba(0,0,0,.5),inset 0 0 0 1px rgba(120,150,190,.05),0 0 90px -46px color-mix(in srgb,var(--glow,var(--sapphire)) 45%,transparent);transition:box-shadow .4s}
    .device::after{content:"";position:absolute;inset:6px;border-radius:17px;pointer-events:none;border:1px solid rgba(0,0,0,.35);box-shadow:inset 0 1px 0 rgba(255,255,255,.04)}
    .screw{position:absolute;width:9px;height:9px;border-radius:50%;background:radial-gradient(circle at 38% 32%,#5a6373,#1a1f28 70%);box-shadow:inset 0 -1px 1px rgba(0,0,0,.7),0 1px 1px rgba(255,255,255,.06);z-index:3}
    .screw::after{content:"";position:absolute;inset:2.5px;border-top:1px solid rgba(0,0,0,.55);transform:rotate(35deg)}
    .screw.tl{top:9px;left:9px}.screw.tr{top:9px;right:9px}.screw.bl{bottom:9px;left:9px}.screw.br{bottom:9px;right:9px}
    .glab{font-family:ui-monospace,Menlo,monospace;font-size:.48rem;letter-spacing:.22em;text-transform:uppercase;color:#8a98aa;margin-bottom:8px;text-shadow:0 1px 0 rgba(0,0,0,.5);display:flex;align-items:center;gap:6px}
    .glab .dot{width:4px;height:4px;border-radius:50%;background:var(--sapphire);box-shadow:0 0 5px var(--sapphire)}
    .glab .vn{margin-left:auto;color:#cfe6f5;letter-spacing:.14em}
  
    .screen{position:relative;border-radius:12px;overflow:hidden;background:radial-gradient(130% 130% at 50% 0%,#0c1622,#05080e 78%);box-shadow:inset 0 0 0 1px rgba(0,0,0,.8),inset 0 3px 12px rgba(0,0,0,.7),inset 0 -1px 0 rgba(255,255,255,.04);border:1px solid rgba(150,190,240,.07)}
    .screen::before{content:"";position:absolute;inset:0;pointer-events:none;background:linear-gradient(152deg,rgba(255,255,255,.06) 0%,transparent 30%);z-index:6}
    .hw{position:relative;border-radius:8px;cursor:pointer;font-family:ui-monospace,Menlo,monospace;font-size:.56rem;letter-spacing:.06em;color:#aab4c2;background:linear-gradient(180deg,#333b48,#1a2028);border:1px solid rgba(0,0,0,.6);box-shadow:inset 0 1px 0 rgba(255,255,255,.12),inset 0 -2px 3px rgba(0,0,0,.5),0 1px 2px rgba(0,0,0,.4);display:flex;align-items:center;justify-content:center;user-select:none}
    .hw.on{color:#eaf6ff;border-color:color-mix(in srgb,var(--acc,var(--sapphire)) 55%,#000);background:linear-gradient(180deg,color-mix(in srgb,var(--acc,var(--sapphire)) 26%,#2a323d),#141a22);box-shadow:inset 0 1px 0 rgba(255,255,255,.18),0 0 12px -2px var(--acc,var(--sapphire)),inset 0 0 10px -3px var(--acc,var(--sapphire))}
    .hw svg{width:18px;height:12px}.hw svg path{stroke:#9aa6b4;stroke-width:1.5;fill:none;stroke-linecap:round;stroke-linejoin:round}
    .hw.on svg path{stroke:#eaf6ff;filter:drop-shadow(0 0 3px var(--acc,var(--sapphire)))}
    .seg{display:flex;border-radius:8px;overflow:hidden;border:1px solid rgba(0,0,0,.6);box-shadow:inset 0 1px 0 rgba(255,255,255,.08),inset 0 -2px 4px rgba(0,0,0,.5)}
    .seg b{flex:1;text-align:center;font-family:ui-monospace,Menlo,monospace;font-size:.56rem;color:#8a96a4;padding:6px 0;cursor:pointer;background:linear-gradient(180deg,#2a313c,#171c24);border-right:1px solid rgba(0,0,0,.5);user-select:none}
    .seg b:last-child{border-right:none}
    .seg b.on{color:#eaf6ff;background:linear-gradient(180deg,color-mix(in srgb,var(--acc,var(--sapphire)) 30%,#222a34),#10151c);box-shadow:inset 0 0 10px -3px var(--acc,var(--sapphire))}
  
    .device:not(.live){--glow:#2a3340}
    .device:not(.live) .sleeps{filter:saturate(.7) brightness(.92);pointer-events:none;transition:filter .45s ease}
    .device:not(.live) .sleeps.wk{filter:none}
    .device:not(.live) .pad .puck,.device:not(.live) .afnode{opacity:.35}
  
    .io{display:flex;gap:12px;align-items:center;height:48px;padding:0 4px}
    .pwr{width:48px;height:48px;flex:none;border-radius:50%;position:relative;cursor:pointer;background:radial-gradient(circle at 50% 32%,#311a1a,#0f0a0a 72%);box-shadow:0 0 22px -4px var(--red),inset 0 2px 2px rgba(255,255,255,.16),inset 0 -3px 5px rgba(0,0,0,.7),0 2px 4px rgba(0,0,0,.6);border:1px solid #0a0f0c;transition:box-shadow .3s,background .3s}
    .pwr svg{position:absolute;inset:0;margin:auto;width:40%;height:40%}.pwr path{stroke:var(--red);stroke-width:2.4;fill:none;stroke-linecap:round;filter:drop-shadow(0 0 4px var(--red));transition:stroke .3s}
    .device.live .pwr{background:radial-gradient(circle at 50% 32%,#1c3128,#0a0f0c 72%);box-shadow:0 0 24px -2px var(--green),inset 0 2px 2px rgba(255,255,255,.18),inset 0 -3px 5px rgba(0,0,0,.7),0 2px 4px rgba(0,0,0,.6)}
    .device.live .pwr path{stroke:var(--green);filter:drop-shadow(0 0 5px var(--green))}
    .nameplate{font-family:ui-monospace,Menlo,monospace;font-size:.6rem;letter-spacing:.3em;color:#7e8c9e;text-shadow:0 1px 0 rgba(0,0,0,.6)}
    .nameplate b{color:#c3cedb}.nameplate .st{display:block;font-size:.5rem;letter-spacing:.2em;color:#5b6b7c;margin-top:3px}
    .device.live .nameplate .st{color:var(--green)}
    .spacer{flex:1}
    .notereadout{font-family:ui-monospace,Menlo,monospace;font-size:.62rem;letter-spacing:.14em;color:#7d8a99;text-align:right;min-width:110px}.notereadout b{color:#dffaff;font-size:.85rem}
    .micin{flex:none;display:flex;align-items:center;gap:9px;padding:10px 15px;border-radius:24px;color:#9fb6c4;cursor:pointer;font-family:ui-monospace,Menlo,monospace;font-size:.55rem;letter-spacing:.14em;background:linear-gradient(180deg,#2a313c,#161b22);border:1px solid rgba(0,0,0,.55);box-shadow:inset 0 1px 0 rgba(255,255,255,.1),0 1px 2px rgba(0,0,0,.4);user-select:none}
    .micin svg{width:14px;height:14px;stroke:#9fb6c4;fill:none;stroke-width:1.6}
    .micin.on{color:#dff;border-color:color-mix(in srgb,var(--sapphire) 50%,#000);box-shadow:inset 0 1px 0 rgba(255,255,255,.12),0 0 14px -3px var(--sapphire)}.micin.on svg{stroke:#bff}
  
    /* VOICE treatment strip — hidden until the mic is live */
    .vocalbar{display:none;align-items:center;gap:9px;padding:10px 14px;border-radius:11px;
      background:linear-gradient(180deg,#121a24,#0a0f15);border:1px solid color-mix(in srgb,var(--sapphire) 22%,#000);
      box-shadow:inset 0 1px 0 rgba(255,255,255,.06),inset 0 2px 6px rgba(0,0,0,.5),0 0 16px -8px var(--sapphire)}
    .vocalbar.show{display:flex}
    .vocalbar .al{font-family:ui-monospace,Menlo,monospace;font-size:.54rem;letter-spacing:.16em;text-transform:uppercase;color:#9fb0c1}
    .vocalbar .vchip{height:30px;padding:0 13px;font-size:.58rem}
    .vocalbar .vu{display:inline-block;width:7px;height:7px;border-radius:50%;vertical-align:middle;margin-left:4px;
      background:color-mix(in srgb,var(--sapphire) calc(var(--lv,0)*100%),#28323d);box-shadow:0 0 calc(var(--lv,0)*9px) var(--sapphire)}
    .vocalbar .vdepth{width:150px}
    .vocalbar .vdepth.inert{opacity:.35;pointer-events:none}   /* DRY has no wet to mix — the slider says so */
  
    .console{display:grid;grid-template-columns:218px minmax(196px,1fr) minmax(370px,1.55fr) 202px;gap:16px;padding-top:4px}
    .zone{display:flex;flex-direction:column}
    .zbody{flex:1;display:flex;gap:12px}
  
    .command{flex:1;display:flex;flex-direction:column;gap:8px;border-radius:13px;padding:12px;background:linear-gradient(180deg,#0b0f15,#06090d);border:1px solid rgba(0,0,0,.65);box-shadow:inset 0 3px 10px rgba(0,0,0,.7),inset 0 -1px 0 rgba(255,255,255,.05),inset 0 0 0 1px rgba(90,120,160,.06)}
    .tempo{flex:none;padding:10px 0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1px;position:relative;cursor:ns-resize;touch-action:none}
    .tempo b{font-family:ui-monospace,Menlo,monospace;font-weight:700;font-size:1.9rem;color:#dffaff;text-shadow:0 0 14px var(--sapphire),0 0 3px #fff;line-height:1;letter-spacing:.04em}
    .tempo small{font-family:ui-monospace,Menlo,monospace;font-size:.44rem;letter-spacing:.18em;color:#6d8092}
    .tempo .pls{position:absolute;left:10px;top:10px;width:6px;height:6px;border-radius:50%;background:#26424f;transition:transform .07s,background .07s,box-shadow .07s}
    .tempo .pls.beat{background:var(--sapphire);box-shadow:0 0 9px var(--sapphire);transform:scale(1.5)}
    .kick{display:flex;align-items:center;gap:10px;border-radius:11px;cursor:pointer;padding:8px 12px;user-select:none;background:linear-gradient(180deg,#1a222a,#0c1116);border:1px solid rgba(0,0,0,.55);box-shadow:inset 0 1px 0 rgba(255,255,255,.07);transition:.16s}
    .kick.on{background:linear-gradient(180deg,#243a30,#0e1813);border-color:color-mix(in srgb,var(--green) 40%,#000);box-shadow:inset 0 1px 0 rgba(255,255,255,.12),0 0 12px -4px var(--green)}
    .kick .drum{width:24px;height:24px;border-radius:50%;flex:none;background:radial-gradient(circle at 50% 35%,#1a2630,#070d12 72%);border:2px solid #3a4654;box-shadow:inset 0 1px 2px rgba(255,255,255,.12);transition:transform .07s,box-shadow .07s,border-color .16s}
    .kick.on .drum{border-color:var(--sapphire);box-shadow:0 0 14px 1px var(--sapphire),inset 0 1px 2px rgba(255,255,255,.18)}
    .kick.hit .drum{transform:scale(1.16);box-shadow:0 0 22px 3px var(--sapphire)}
    .kick .kl{font-family:ui-monospace,Menlo,monospace;font-size:.58rem;letter-spacing:.16em;color:#9aa6b4}.kick.on .kl{color:#dff5e8}
    .kick .toggle{margin-left:auto}
    .toggle{position:relative;width:34px;height:18px;border-radius:9px;border:1px solid rgba(0,0,0,.6);background:#0b0f14;box-shadow:inset 0 1px 3px rgba(0,0,0,.7);flex:none}
    .toggle i{position:absolute;top:2px;left:2px;width:13px;height:12px;border-radius:7px;background:linear-gradient(180deg,#cfd6df,#8b94a1);box-shadow:0 1px 2px rgba(0,0,0,.5);transition:left .14s,background .2s}
    .crow{display:flex;align-items:center;justify-content:space-between;border-radius:9px;padding:8px 12px;cursor:pointer;user-select:none;background:linear-gradient(180deg,#222934,#12161d);border:1px solid rgba(0,0,0,.55);box-shadow:inset 0 1px 0 rgba(255,255,255,.07)}
    .crow .cl{font-family:ui-monospace,Menlo,monospace;font-size:.5rem;letter-spacing:.12em;color:#9aa6b4}
    .crow.on .toggle{border-color:color-mix(in srgb,var(--green) 55%,#000);box-shadow:inset 0 1px 2px rgba(0,0,0,.5),0 0 8px -2px var(--green)}
    .crow.on .toggle i{left:17px;background:linear-gradient(180deg,#bff0d2,#3ddc84)}.crow.on .cl{color:#dff5e8}
    .kick.on .toggle{border-color:color-mix(in srgb,var(--green) 55%,#000)}
    .kick.on .toggle i{left:17px;background:linear-gradient(180deg,#bff0d2,#3ddc84)}
    .patseg{--acc:var(--sapphire)}
    .patseg b{font-size:.5rem;letter-spacing:.04em;padding:7px 0}
  
    .coverslide{display:flex;flex-direction:column;gap:6px;border-radius:9px;padding:9px 12px;background:linear-gradient(180deg,#222934,#12161d);border:1px solid rgba(0,0,0,.55);box-shadow:inset 0 1px 0 rgba(255,255,255,.07)}
    .coverslide .ct{display:flex;justify-content:space-between;font-family:ui-monospace,Menlo,monospace;font-size:.5rem;letter-spacing:.1em;color:#9aa6b4}.coverslide .ct .cvv{color:#dbe6f0}
    .strack{position:relative;height:16px;border-radius:8px;cursor:ew-resize;touch-action:none;background:linear-gradient(180deg,#0a0f14,#070b10);box-shadow:inset 0 1px 3px rgba(0,0,0,.7),inset 0 0 0 1px rgba(0,0,0,.5)}
    .strack .sfill{position:absolute;left:0;top:0;bottom:0;border-radius:8px 0 0 8px;background:linear-gradient(90deg,color-mix(in srgb,var(--sapphire) 20%,transparent),color-mix(in srgb,var(--sapphire) 48%,transparent));box-shadow:0 0 10px -2px var(--sapphire)}
    .strack .shandle{position:absolute;top:50%;width:11px;height:22px;border-radius:4px;transform:translate(-50%,-50%);background:linear-gradient(180deg,#cfd9e3,#8b95a2);box-shadow:0 1px 3px rgba(0,0,0,.6),inset 0 1px 0 rgba(255,255,255,.5);z-index:2}
  
    .pad{flex:1;min-height:246px;position:relative;cursor:crosshair;touch-action:none}
    .pad .grid{position:absolute;inset:0;background-image:linear-gradient(rgba(120,170,210,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(120,170,210,.05) 1px,transparent 1px);background-size:30px 30px;z-index:1;pointer-events:none}
    .pad .cross{position:absolute;inset:0;z-index:1;pointer-events:none}
    .pad .cross::before,.pad .cross::after{content:"";position:absolute;background:rgba(120,170,210,.09)}
    .pad .cross::before{left:50%;top:0;bottom:0;width:1px}.pad .cross::after{top:50%;left:0;right:0;height:1px}
    .pad .puck{position:absolute;width:24px;height:24px;border-radius:50%;transform:translate(-50%,-50%);z-index:4;pointer-events:none;background:radial-gradient(circle at 38% 30%,#fff,var(--pc,#0ec4fc) 66%,color-mix(in srgb,var(--pc,#0ec4fc) 50%,#000));box-shadow:0 0 22px 4px var(--pc,#0ec4fc),inset 0 1px 1px rgba(255,255,255,.6),0 2px 4px rgba(0,0,0,.5);transition:box-shadow .1s}
    .pad .puck::after{content:"";position:absolute;left:50%;top:50%;width:46px;height:46px;border-radius:50%;transform:translate(-50%,-50%);border:1px solid color-mix(in srgb,var(--pc,#0ec4fc) 30%,transparent)}
    .pad.flash .puck{box-shadow:0 0 30px 7px var(--pc,#0ec4fc),inset 0 1px 1px rgba(255,255,255,.6),0 2px 4px rgba(0,0,0,.5)}
    .pad .lm{position:absolute;transform:translate(-50%,-50%);font-family:ui-monospace,Menlo,monospace;font-size:.42rem;letter-spacing:.05em;color:#5d7693;text-align:center;white-space:nowrap;z-index:2;pointer-events:none;transition:color .14s}
    .pad .lm.near{color:#cfe6f5}
    .pad .lm b{display:block;width:5px;height:5px;border-radius:50%;background:#3c5573;margin:0 auto 2px;transition:.14s}.pad .lm.near b{background:var(--pc);box-shadow:0 0 6px var(--pc)}
    .ax{position:absolute;font-family:ui-monospace,Menlo,monospace;font-size:.44rem;letter-spacing:.16em;color:#54748f;z-index:2;pointer-events:none}
    .ax.l{left:7px;top:50%;writing-mode:vertical-rl;transform:translateY(-50%) rotate(180deg)}
    .ax.r{right:7px;top:50%;writing-mode:vertical-rl;transform:translateY(-50%)}
    .ax.b{bottom:6px;left:50%;transform:translateX(-50%)}.ax.t{top:6px;left:50%;transform:translateX(-50%)}
  
    /* AUTO-FILTER — wide short screen, the node IS the cursor */
    .afz{flex-direction:column;gap:10px}
    .afilter{flex:1;min-height:142px;position:relative;cursor:ew-resize;touch-action:none;overflow:hidden}
    .afilter svg{position:absolute;inset:0;width:100%;height:100%}
    .afgrid text{fill:#4f6f8c;font-family:ui-monospace,Menlo,monospace;font-size:9px}
    .afcurve path{fill:none;stroke:var(--curve);stroke-width:2;filter:drop-shadow(0 0 5px color-mix(in srgb,var(--curve) 70%,transparent));stroke-linejoin:round}
    .afcurve .fillpath{fill:color-mix(in srgb,var(--curve) 10%,transparent);stroke:none;filter:none}
    /* the LFO's ghost: stroke-only, amber, opacity rides the MOTION dial — the base curve stays still.
       Drawn ONLY where it diverges from the base, never past the base curve's right footprint. */
    .afcurve .ghost{stroke:var(--amber);stroke-width:1.3;opacity:0;filter:drop-shadow(0 0 3px color-mix(in srgb,var(--amber) 30%,transparent))}
    .afnode{position:absolute;width:20px;height:20px;border-radius:50%;transform:translate(-50%,-50%);z-index:5;border:2.5px solid var(--amber);background:radial-gradient(circle at 40% 35%,rgba(255,200,120,.55),rgba(20,12,4,.4) 70%);box-shadow:0 0 14px -1px var(--amber);cursor:grab;touch-action:none}
    .afnode::before{content:"";position:absolute;inset:-12px;border-radius:50%}
    .afnode:active{cursor:grabbing;box-shadow:0 0 20px 1px var(--amber)}
    .afhint{position:absolute;left:9px;top:7px;z-index:4;font-family:ui-monospace,Menlo,monospace;font-size:.46rem;letter-spacing:.12em;color:#637b97;pointer-events:none}
  
    /* LFO module (under the screen): shape grid · scope glass · knobs */
    .lfostrip{flex:none;display:flex;align-items:center;gap:13px;padding:8px 13px;border-radius:11px;background:linear-gradient(180deg,#1c222c,#0d1118);border:1px solid rgba(0,0,0,.6);box-shadow:inset 0 1px 0 rgba(255,255,255,.07),inset 0 -2px 5px rgba(0,0,0,.55)}
    .shapegrid{flex:none;display:grid;grid-template-columns:1fr 1fr;gap:4px;width:78px}
    .shapegrid .hw{height:21px}
    .shapegrid .hw.on{--acc:var(--amber)}
    .scope{position:relative;flex:none;width:126px;height:46px;border-radius:7px;overflow:hidden;
      background:
        linear-gradient(rgba(120,170,210,.05) 1px,transparent 1px) 0 0/31.5px 100%,
        radial-gradient(130% 130% at 50% 0%,#0c1622,#05080e 78%);
      box-shadow:inset 0 0 0 1px rgba(0,0,0,.8),inset 0 3px 8px rgba(0,0,0,.7);border:1px solid rgba(150,190,240,.07)}
    .scope::before{content:"";position:absolute;left:0;right:0;top:50%;height:1px;background:repeating-linear-gradient(90deg,rgba(120,170,210,.12) 0 2px,transparent 2px 5px);z-index:1}
    .scope::after{content:"";position:absolute;inset:0;pointer-events:none;background:linear-gradient(152deg,rgba(255,255,255,.06) 0%,transparent 30%);z-index:4}
    .scope canvas{position:absolute;inset:0;width:100%;height:100%;z-index:2}
    .scope .sl{position:absolute;left:5px;top:3px;z-index:3;font-family:ui-monospace,Menlo,monospace;font-size:.4rem;letter-spacing:.16em;color:#54748f}
    .scope .sv{position:absolute;right:5px;bottom:3px;z-index:3;font-family:ui-monospace,Menlo,monospace;font-size:.5rem;color:#ffd9ad;opacity:.75}
    .scope .cyc{position:absolute;right:5px;top:4px;z-index:3;width:4px;height:4px;border-radius:50%;background:#3a2c1c;transition:background .06s,box-shadow .06s}
    .scope .cyc.blip{background:var(--amber);box-shadow:0 0 6px var(--amber)}
  
    /* performance pads */
    .gestbar{display:flex;align-items:center;gap:10px;padding:9px 14px;border-radius:11px;background:linear-gradient(180deg,#10151c,#0a0d12);border:1px solid rgba(0,0,0,.6);box-shadow:inset 0 1px 0 rgba(255,255,255,.05),inset 0 2px 6px rgba(0,0,0,.5)}
    .gestbar .gl{font-family:ui-monospace,Menlo,monospace;font-size:.5rem;letter-spacing:.18em;text-transform:uppercase;color:#7d8a99;margin-right:4px}
    .gpad{flex:1;display:flex;align-items:center;justify-content:center;gap:9px;height:36px;border-radius:9px;cursor:pointer;user-select:none;touch-action:none;
      font-family:ui-monospace,Menlo,monospace;font-size:.62rem;letter-spacing:.1em;color:#aab4c2;
      background:linear-gradient(180deg,#2d3540,#181d25);border:1px solid rgba(0,0,0,.6);box-shadow:inset 0 1px 0 rgba(255,255,255,.1),inset 0 -2px 4px rgba(0,0,0,.5),0 1px 2px rgba(0,0,0,.4);transition:.1s}
    .gpad b{width:20px;height:20px;border-radius:5px;display:flex;align-items:center;justify-content:center;font-size:.62rem;color:#8fa0b2;background:radial-gradient(circle at 50% 32%,#222b35,#0e131a);border:1px solid rgba(0,0,0,.6)}
    .gpad.on{color:#fff;border-color:color-mix(in srgb,var(--amber) 55%,#000);background:linear-gradient(180deg,color-mix(in srgb,var(--amber) 26%,#2a323d),#141a22);box-shadow:inset 0 1px 0 rgba(255,255,255,.18),0 0 16px -3px var(--amber),inset 0 0 10px -3px var(--amber);transform:translateY(1px)}
    .gpad.on b{color:#ffd9ad;box-shadow:0 0 8px -2px var(--amber)}
  
    /* LED grammar + key light spill + standby breathing */
    .led{display:inline-block;width:5px;height:5px;border-radius:50%;background:#28323d;vertical-align:middle;transition:background .07s,box-shadow .07s,transform .07s}
    .led.blip{background:var(--green);box-shadow:0 0 7px var(--green);transform:scale(1.5)}
    .spill{position:absolute;bottom:0;width:240px;height:110px;left:-120px;border-radius:50%;pointer-events:none;z-index:0;opacity:0;
      background:radial-gradient(closest-side,color-mix(in srgb,var(--sapphire) 14%,transparent),transparent 72%);
      transition:opacity .4s ease-out;will-change:transform}
    .spill.on{opacity:.65;transition:opacity .07s ease-in}
    /* the standby breathe + first-view flare live on an OPACITY-ONLY halo (::after) —
       animating box-shadow repaints a large region every frame and janks the scroll. */
    .pwr::after{content:"";position:absolute;inset:-12px;border-radius:50%;pointer-events:none;opacity:0;
      background:radial-gradient(circle,color-mix(in srgb,var(--red) 30%,transparent),transparent 70%);will-change:opacity}
    &.inview .device:not(.live) .pwr::after{animation:sgmbreathe 4.2s ease-in-out infinite}
    .pwr.flare::after{animation:sgmflareo .9s ease-out 1}
    .knob{display:flex;flex-direction:column;align-items:center;gap:3px;cursor:ns-resize;touch-action:none;user-select:none}
    .dial{width:38px;height:38px;border-radius:50%;position:relative;background:conic-gradient(from 225deg, var(--amber) 0 calc(var(--v,0)*270deg), #262c35 calc(var(--v,0)*270deg) 270deg, #0a0d12 270deg 360deg);box-shadow:inset 0 0 0 1px rgba(0,0,0,.6),0 1px 2px rgba(0,0,0,.5)}
    .dial::before{content:"";position:absolute;inset:5px;border-radius:50%;background:radial-gradient(circle at 50% 32%,#2c333e,#11151d);box-shadow:inset 0 1px 0 rgba(255,255,255,.12),0 1px 2px rgba(0,0,0,.6)}
    .dial .ptr{position:absolute;inset:0;transform:rotate(calc(-135deg + var(--v,0)*270deg))}
    .dial .ptr::after{content:"";position:absolute;left:50%;top:5px;width:2px;height:8px;margin-left:-1px;border-radius:1px;background:#e7edf3;box-shadow:0 0 3px var(--amber)}
    .knob.sm .dial{width:30px;height:30px}
    .knob.sm .dial::before{inset:4px}
    .knob.sm .dial .ptr::after{top:4px;height:6px}
    .knob .kl{font-family:ui-monospace,Menlo,monospace;font-size:.42rem;letter-spacing:.1em;color:#8593a2}
    .knob .kn{font-family:ui-monospace,Menlo,monospace;font-size:.52rem;color:#dbe6f0}
    /* the MOTION dial brightens with its own value — same amber law as the ghost + scope */
    #amtKnob .dial{box-shadow:0 0 calc(var(--glowA,0)*16px) calc(var(--glowA,0)*2px) color-mix(in srgb,var(--amber) 50%,transparent),inset 0 0 0 1px rgba(0,0,0,.6),0 1px 2px rgba(0,0,0,.5)}
    #amtKnob .kn{color:color-mix(in srgb,#ffd9ad calc(var(--glowA,0)*100%),#8593a2)}
    .shaperow{display:flex;gap:5px}
    .shaperow .hw{flex:1;height:26px}
    .ratemode{display:flex;flex-direction:column;gap:4px;width:48px}
    .ratemode b{text-align:center;font-family:ui-monospace,Menlo,monospace;font-size:.52rem;color:#8a96a4;padding:5px 0;border-radius:6px;cursor:pointer;background:linear-gradient(180deg,#2a313c,#171c24);border:1px solid rgba(0,0,0,.6);user-select:none}
    .ratemode b.on{color:#08303c;background:linear-gradient(180deg,#ffd27d,var(--amber));box-shadow:0 0 8px -2px var(--amber)}
  
    .efx{flex:1;display:flex;flex-direction:column;gap:9px}
    .fills{display:flex;gap:9px;flex:1}
    .fillcard{position:relative;flex:1;border-radius:11px;overflow:hidden;cursor:ns-resize;touch-action:none;box-shadow:inset 0 0 0 1px rgba(0,0,0,.8),inset 0 3px 10px rgba(0,0,0,.7);border:1px solid rgba(150,190,240,.06);background:linear-gradient(180deg,#0e1620,#05090e)}
    .fillcard .fill{position:absolute;left:0;right:0;bottom:0;height:0%;background:linear-gradient(0deg,color-mix(in srgb,var(--fc) 60%,transparent),color-mix(in srgb,var(--fc) 18%,transparent));box-shadow:0 0 16px -1px var(--fc);transition:height .04s linear}
    .fillcard.dragging .fill{transition:none}   /* the transition fights live pointermove updates — the bar rubber-bands behind the pointer */
    .fillcard .fill::before{content:"";position:absolute;left:0;right:0;top:0;height:2px;background:var(--fc);box-shadow:0 0 8px var(--fc)}
    .fillcard .fill.mt{box-shadow:none}
    .fillcard .fill.mt::before{opacity:0}
    /* the DELAY fill is striped — stripe spacing = the division (1/4 coarse → 1/16 fine) */
    .fillcard[data-key="delay"] .fill{background-image:repeating-linear-gradient(0deg,rgba(0,0,0,.34) 0 2px,transparent 2px var(--seg,10px)),linear-gradient(0deg,color-mix(in srgb,var(--fc) 60%,transparent),color-mix(in srgb,var(--fc) 18%,transparent))}
    /* the REVERB fill grows a soft cloud above it — cloud height = the size (SM..VAST) */
    .fillcard[data-key="reverb"] .fill::after{content:"";position:absolute;left:0;right:0;top:calc(-1*var(--cloud,10px));height:var(--cloud,10px);pointer-events:none;
      background:linear-gradient(0deg,color-mix(in srgb,var(--fc) 30%,transparent),transparent)}
    .fillcard[data-key="reverb"] .fill.mt::after{opacity:0}
    .fillcard .fl{position:absolute;left:0;right:0;top:9px;text-align:center;z-index:2;font-family:ui-monospace,Menlo,monospace;font-size:.48rem;letter-spacing:.06em;color:#cbd6e2;text-shadow:0 1px 3px rgba(0,0,0,.8);pointer-events:none}
    .fillcard .pc{position:absolute;left:0;right:0;bottom:8px;text-align:center;z-index:2;font-family:ui-monospace,Menlo,monospace;font-size:.46rem;color:#aab6c4;pointer-events:none}
    .drate{display:flex;align-items:center;gap:8px}.drate .dl{font-family:ui-monospace,Menlo,monospace;font-size:.44rem;letter-spacing:.12em;text-transform:uppercase;color:#7d8a99;white-space:nowrap}.drate .seg{flex:1}
    .drate .seg b{font-size:.6rem;padding:8px 0;letter-spacing:0}
  
    /* ARP strip — prominent */
    .arpbar{display:flex;align-items:center;gap:14px;padding:12px 15px;border-radius:11px;background:linear-gradient(180deg,#141a22,#0b0f15);border:1px solid rgba(0,0,0,.6);box-shadow:inset 0 1px 0 rgba(255,255,255,.06),inset 0 2px 6px rgba(0,0,0,.5);transition:border-color .2s,box-shadow .2s}
    .arpbar.armed{border-color:color-mix(in srgb,var(--green) 35%,#000);box-shadow:inset 0 1px 0 rgba(255,255,255,.06),0 0 18px -7px var(--green)}
    .arpbar .al{font-family:ui-monospace,Menlo,monospace;font-size:.56rem;letter-spacing:.16em;text-transform:uppercase;color:#9fb0c1}
    .arpbar .hw{height:32px;padding:0 20px;font-size:.62rem;--acc:var(--green)}
    .arpbar .seg{width:210px}
    .arpbar .seg b{font-size:.6rem;padding:8px 0;letter-spacing:0}
  
    .pianohead{display:flex;align-items:center;gap:14px;font-family:ui-monospace,Menlo,monospace;font-size:.5rem;letter-spacing:.16em;text-transform:uppercase;color:#7d8a99;margin-top:4px}
    .octctl{display:flex;align-items:center;gap:8px}
    .octbtn{width:30px;height:30px;border-radius:8px;display:flex;align-items:center;justify-content:center;cursor:pointer;background:linear-gradient(180deg,#2f3742,#161b22);border:1px solid rgba(0,0,0,.6);box-shadow:inset 0 1px 0 rgba(255,255,255,.1),0 1px 2px rgba(0,0,0,.4);color:#bcc7d3;font-size:.8rem;user-select:none}
    .octbtn:active{background:linear-gradient(180deg,#1a2028,#0e1218)}
    .octreadout{display:flex;flex-direction:column;align-items:center;line-height:1;min-width:46px}
    .octreadout b{font-family:ui-monospace,Menlo,monospace;font-size:1.05rem;color:#dffaff;text-shadow:0 0 8px var(--sapphire)}
    .octreadout small{font-size:.4rem;letter-spacing:.2em;color:#637b97;margin-top:2px}
    .octhint{font-size:.42rem;letter-spacing:.1em;color:#566b80}
    .lockseg{margin-left:auto;width:184px}
    .piano{position:relative;height:140px;border-radius:12px;padding:8px 8px 0;background:linear-gradient(180deg,#0a0d12,#05070a);border:1px solid rgba(0,0,0,.65);box-shadow:inset 0 3px 12px rgba(0,0,0,.7),inset 0 0 0 1px rgba(90,120,160,.05);display:flex;gap:5px;user-select:none;touch-action:none;margin-top:7px}
    .wkey{position:relative;flex:1;border-radius:0 0 7px 7px;cursor:pointer;background:linear-gradient(180deg,#e8edf2,#bcc6d0 78%,#a7b2bd);border:1px solid #3a4350;border-top:none;box-shadow:inset 0 -6px 9px rgba(0,0,0,.18),inset 0 1px 0 rgba(255,255,255,.7),0 2px 3px rgba(0,0,0,.4);display:flex;flex-direction:column;justify-content:flex-end;align-items:center;padding-bottom:9px;transition:background .05s,box-shadow .08s}
    .wkey .ql{font-family:ui-monospace,Menlo,monospace;font-size:.74rem;font-weight:700;color:#5a6573}
    .wkey .nl{font-family:ui-monospace,Menlo,monospace;font-size:.46rem;color:#8b96a3;margin-top:2px}
    .wkey.latched{background:linear-gradient(180deg,#d8f2fc,#a8dcf0 80%);border-color:color-mix(in srgb,var(--sapphire) 55%,#3a4350);box-shadow:inset 0 -4px 10px rgba(14,140,190,.22),0 0 10px -4px var(--sapphire)}
    .wkey.latched .ql{color:#1a5468}
    .wkey.press{background:linear-gradient(180deg,#bfeefe,#7fd6f4 80%);box-shadow:inset 0 -4px 10px rgba(14,140,190,.4),0 0 18px -3px var(--sapphire);border-color:var(--sapphire)}.wkey.press .ql{color:#06343f}
