afnode.addEventListener('pointerdown',e=>{if(!live)return;e.stopPropagation();afnode.dataset.d='1';try{afnode.setPointerCapture(e.pointerId)}catch(_){}});
afnode.addEventListener('pointermove',e=>{if(!afnode.dataset.d)return;const r=afilter.getBoundingClientRect();
  const x=clamp((e.clientX-r.left)/r.width,0,1),y=clamp((e.clientY-r.top)/r.height,0,1);
  if(eng){eng.fx.cutoff=x;eng.fx.res=clamp((y-0.2)/0.65,0,1);eng.apply();}drawFilter();});
