<script>

const clamp=(v,a,b)=>Math.min(b,Math.max(a,v));
const $=s=>document.querySelector(s);
const NOTE_NAMES=['C','C#','D','D#','E','F','F#','G','G#','A','A#','B'];

const VOICES=[
 {n:'GLASS',   d:'bright · glassy · air',   o:[{t:'sine'},{t:'sine',d:7}],                 f:{t:'highpass',hz:300,q:0.7}, a:.006,r:.5,  lm:{x:.75,y:.20}},
 {n:'EMBER',   d:'warm · round · low',      o:[{t:'triangle'},{t:'triangle',oct:-1}],      f:{t:'lowpass',hz:2600,q:0.6}, a:.014,r:.8,  lm:{x:.25,y:.68}},
 {n:'HOLLOW',  d:'reedy · vocal · narrow',  o:[{t:'sawtooth'}],                            f:{t:'lowpass',hz:900,q:6},    a:.008,r:.5,  lm:{x:.71,y:.39}},
 {n:'DRIFT',   d:'wide · detuned · lush',   o:[{t:'sawtooth',d:-9},{t:'sawtooth',d:9}],    f:{t:'lowpass',hz:2200,q:1},   a:.012,r:.9,  lm:{x:.45,y:.42}},
 {n:'STATIC',  d:'buzzy · square · electric',o:[{t:'square'}],                             f:{t:'lowpass',hz:3000,q:0.7}, a:.006,r:.4,  lm:{x:.82,y:.55}},
 {n:'SONAR',   d:'deep · sub · sustained',  o:[{t:'sine'},{t:'sine',oct:-1}],              f:{t:'lowpass',hz:1800,q:0.5}, a:.012,r:1.2, lm:{x:.19,y:.45}},
 {n:'FILAMENT',d:'fine · metallic · keen',  o:[{t:'triangle'},{t:'sawtooth'}],             f:{t:'lowpass',hz:1500,q:2},   a:.01, r:.7,  lm:{x:.58,y:.80}},
 {n:'AURORA',  d:'soft · wide · shimmer',   o:[{t:'sine',d:-5},{t:'sine'},{t:'sine',d:5}], f:{t:'highpass',hz:500,q:0.7}, a:.016,r:1.0, lm:{x:.24,y:.22}},
 {n:'VAPOR',   d:'veiled · soft · misted',  o:[{t:'sine',d:-10},{t:'sine',d:10}],          f:{t:'lowpass',hz:900,q:0.5},  a:.02, r:1.3, lm:{x:.08,y:.16}},
 {n:'HALO',    d:'airy · open · floating',  o:[{t:'sine'},{t:'sine',d:5,oct:1}],           f:{t:'highpass',hz:600,q:0.7}, a:.02, r:1.2, lm:{x:.50,y:.07}},
 {n:'PULSE',   d:'hollow · square · soft',  o:[{t:'square'},{t:'square',d:6}],             f:{t:'lowpass',hz:1400,q:1.1}, a:.006,r:.5,  lm:{x:.60,y:.13}},
 {n:'TIDE',    d:'deep · slow · swelling',  o:[{t:'triangle'},{t:'sine',oct:-1}],          f:{t:'lowpass',hz:1000,q:0.6}, a:.03, r:1.6, lm:{x:.07,y:.62}},
 {n:'GRIT',    d:'dusty · biting · raw',    o:[{t:'sawtooth',d:-6},{t:'square',d:6}],      f:{t:'bandpass',hz:900,q:1.8}, a:.006,r:.45, lm:{x:.90,y:.32}},
 {n:'VELVET',  d:'dark · round · plain',    o:[{t:'triangle'}],                            f:{t:'lowpass',hz:800,q:0.7},  a:.012,r:.7,  lm:{x:.12,y:.86}},
 {n:'CHIME',   d:'bell · glassy · pure',    o:[{t:'sine'},{t:'sine',d:14,oct:1}],          f:{t:'highpass',hz:400,q:0.7}, a:.003,r:1.0, lm:{x:.40,y:.93}},
 {n:'NEON',    d:'thin · electric · keen',  o:[{t:'sawtooth'}],                            f:{t:'highpass',hz:1200,q:1.4},a:.004,r:.35, lm:{x:.92,y:.80}},
];
const SYNCS=[{v:'1',l:'1/1',b:4},{v:'2',l:'1/2',b:2},{v:'4',l:'1/4',b:1},{v:'8',l:'1/8',b:.5},{v:'16',l:'1/16',b:.25}];
/* 16-step drum patterns (4/4, 16ths): k=kick s=snare h=hat */
const PATTERNS={
 floor:{k:[0,4,8,12], s:[],       h:[2,6,10,14]},
 back: {k:[0,8,10],   s:[4,12],   h:[0,2,4,6,8,10,12,14]},
 half: {k:[0],        s:[8],      h:[0,4,8,12,14]},
