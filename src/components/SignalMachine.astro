// HZ range is kept inside the engine-safe window lfoHz() clamps to (.05..12 Hz) — 0.2..10 Hz here.
const RATE_HZ_MIN=0.2, RATE_HZ_MAX=10;
function hzFromV(v){return RATE_HZ_MIN*Math.pow(RATE_HZ_MAX/RATE_HZ_MIN,clamp(v,0,1));}   // exponential: musical low end, fine control up top
function vFromHz(hz){return clamp(Math.log(clamp(hz,RATE_HZ_MIN,RATE_HZ_MAX)/RATE_HZ_MIN)/Math.log(RATE_HZ_MAX/RATE_HZ_MIN),0,1);}
function fmtHz(hz){return (hz>=10?hz.toFixed(0):hz.toFixed(1))+'Hz';}
function rateRender(v){if(!eng)return;
  if(eng.fx.rateMode==='hz'){const hz=hzFromV(v);eng.fx.rateHz=hz;$('#rateNum').textContent=fmtHz(hz);}
  else{const i=clamp(Math.round(v*(SYNCS.length-1)),0,SYNCS.length-1);eng.fx.syncDiv=SYNCS[i].v;$('#rateNum').textContent=SYNCS[i].l;}
  eng.apply();}
const rateKnobObj=makeKnob($('#rateKnob'),0.75,rateRender);
// tap the RATE readout chip to toggle SYNC <-> FREQ without moving the knob; stop propagation so the tap never arms the knob drag
const rateNumEl=$('#rateNum');
if(rateNumEl){rateNumEl.addEventListener('pointerdown',e=>e.stopPropagation());
  rateNumEl.addEventListener('click',e=>{e.stopPropagation();if(!live||!eng)return;
    if(eng.fx.rateMode==='hz'){eng.fx.rateMode='sync';rateNumEl.classList.remove('hz');const i=Math.max(0,SYNCS.findIndex(x=>x.v===eng.fx.syncDiv));rateKnobObj.set(i/(SYNCS.length-1));}
    else{eng.fx.rateMode='hz';rateNumEl.classList.add('hz');rateKnobObj.set(vFromHz(eng.fx.rateHz));}
    rateRender(eng.fx.rateMode==='hz'?vFromHz(eng.fx.rateHz):Math.max(0,SYNCS.findIndex(x=>x.v===eng.fx.syncDiv))/(SYNCS.length-1));});}
