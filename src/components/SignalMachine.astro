/* BASS module — INTENSITY (tame↔aggressive, default 0) + SUB (sub-octave level) + GLIDE (drone portamento amount) knobs, a PLUCK toggle (opens the step sequencer), and the BASS keycap. */
const bcharKnob=makeKnob($('#bcharKnob'),.5,v=>{if(eng)eng.setBassHeat(v);});   // default INTENSITY 50% (neutral sub)
