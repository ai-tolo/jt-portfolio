/* power */
const pwr=$('#pwr'),statusline=$('#statusline');let pulseClock=null;
function startPulse(){stopPulse();const pls=$('#pls');const tick=()=>{pls.classList.remove('beat');void pls.offsetWidth;pls.classList.add('beat');setTimeout(()=>pls.classList.remove('beat'),90);pulseClock=setTimeout(tick,60000/(eng?eng.fx.tempo:112));};tick();}
function stopPulse(){if(pulseClock){clearTimeout(pulseClock);pulseClock=null;}$('#pls').classList.remove('beat');}
function doPowerOff(){if(typeof REC!=='undefined'){if(REC.on)REC.stop();REC.stopPlay();}
  if(eng)eng.kill();typeStatus('STANDBY · press power');stopPulse();stopLfoAnim();
  $('#beat').classList.remove('on','hit');$('#bassrow').classList.remove('on');
  $('#arpBtn').classList.remove('on');$('#arpBtn').dataset.on='0';$('#arpBtn').setAttribute('aria-pressed','false');
  $('#latchBtn').classList.remove('on');$('#latchBtn').dataset.on='0';$('#arpmod').classList.remove('armed');
  piano.querySelectorAll('.press,.latched').forEach(k=>k.classList.remove('press','latched'));
  $('#micin').classList.remove('on','rec','arming','loop');
  document.querySelectorAll('.gpad.on').forEach(p=>p.classList.remove('on'));
  const sp=$('#spill');if(sp)sp.classList.remove('on');
  vocalReset();readoutStop();if(jamOn){jamOn=false;jamReplaying=false;jamTimers.forEach(clearTimeout);jamTimers=[];}}   /* stop the readout + any jam loop when the device goes dark */
