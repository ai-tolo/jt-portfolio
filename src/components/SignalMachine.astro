  if(inView&&!flared){flared=true;pwr.classList.add('flare');setTimeout(()=>pwr.classList.remove('flare'),950);
    typeStatus(touchStance?'Built for a keyboard · best on a desktop':'STANDBY · press power');}});},{threshold:0.25});
io.observe(sgm);

