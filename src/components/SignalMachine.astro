  // LFO → double slew → filter depth (proportional to cutoff, never crosses 0)
  const lfo=ctx.createOscillator();lfo.type='sine';lfo.frequency.value=lfoHz();
  const slew1=ctx.createBiquadFilter();slew1.type='lowpass';slew1.Q.value=0.55;
  const slew2=ctx.createBiquadFilter();slew2.type='lowpass';slew2.Q.value=0.55;
  lfo.connect(slew1);slew1.connect(slew2);
  const filtAmt=ctx.createGain();filtAmt.gain.value=0;
  slew2.connect(filtAmt);filtAmt.connect(moveFilt.frequency);
  const lfoTap=ctx.createAnalyser();lfoTap.fftSize=256;slew2.connect(lfoTap);   // TRUTH tap: visuals read the real modulation signal
  lfo.start();
  let curShape='sine';   // change-guard: re-assigning osc.type resets LFO phase = click
  function lfoHz(){if(fx.rateMode==='hz')return clamp(fx.rateHz,.05,12);const b=(SYNCS.find(s=>s.v===fx.syncDiv)||{b:.5}).b;return (fx.tempo/60)/b;}
  function applyMotion(){const t=ctx.currentTime;
    const shape=fx.shape==='tri'?'triangle':fx.shape==='saw'?'sawtooth':fx.shape==='sqr'?'square':'sine';
    if(shape!==curShape){lfo.type=shape;curShape=shape;}
    const hz=lfoHz();lfo.frequency.setTargetAtTime(hz,t,.04);
    // per-shape slew: square gets a MUCH heavier edge-rounding (its flip was the residual pop, worst on low/warm tones)
    const sl=fx.shape==='sqr'?clamp(hz*2.5,4,18):fx.shape==='saw'?clamp(hz*5,8,45):clamp(hz*8,10,60);
