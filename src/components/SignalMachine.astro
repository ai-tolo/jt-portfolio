---
// SIGNAL — the instrument. A faithful port of the blessed mock
// (/tmp/signal-explore/machine-v11.html, v1..v11 iterated with Jon by ear) plus the
// power-on ceremony from the instrument-boot handoff. The engine is untouched mock
// code: audio exists only after the power press; everything dies on power-off/pagehide.
// Coordination: SecretDoor.astro and the-console.astro belong to the NEEDLE DROP
// session — the trace below copies the technique, never the component.
import "@fontsource/orbitron/latin-500.css";   // amber outline-on-glass readout (tempo)
---

<section class="section signal-sec" id="signal" aria-label="The instrument">
  <div class="inner">
    <p class="sgm-intro">The instrument. Built for this page. Press power, type to play.</p>
    {/* intro variants for Jon: "One machine, built in the open. Power it on." /
        "This one is not a case study. Press power." */}
    <div class="sgm" id="sgm" data-state="standby">
      <svg class="sgm-trace" aria-hidden="true"><path class="tr-l"></path><path class="tr-r"></path></svg>
      <div class="device" id="device">
      
          <div class="io">
            <button class="pwr" id="pwr" aria-label="Power" aria-pressed="false"><svg viewBox="0 0 24 24"><path d="M12 3.5 V11"/><path d="M6.6 6.8 a7.5 7.5 0 1 0 10.8 0"/></svg></button>
            <span class="nameplate" hidden><b>SIGNAL</b> · MK-XI<span class="st" id="statusline">STANDBY · press power</span></span>
            <div class="spacer"></div>
            <div class="transport iotransport">
              <span class="tbtn rec" id="recBtn" role="button" tabindex="0"><span class="dotr"></span>REC</span>
              <span class="tbtn" id="playBtn" role="button" tabindex="0" disabled>▶ PLAY</span>
              <span class="tbtn jam" id="jamBtn" role="button" tabindex="0" disabled>∞ JAM</span>
              <span class="tbtn" id="shareBtn" role="button" tabindex="0" disabled>⤴ SHARE</span>
              <span class="iodiv" aria-hidden="true"></span>
              <span class="dicebtn" id="dice" role="button" tabindex="0" aria-label="Randomize sound" title="Randomize"><svg viewBox="0 0 24 24"><rect x="3.5" y="3.5" width="17" height="17" rx="4.5" fill="none" stroke="currentColor" stroke-width="1.7"/><circle cx="8" cy="8" r="1.5"/><circle cx="16" cy="8" r="1.5"/><circle cx="12" cy="12" r="1.5"/><circle cx="8" cy="16" r="1.5"/><circle cx="16" cy="16" r="1.5"/></svg></span>
            </div>
            <!-- voice-loop pill: appears beside the mic once a loop is captured; toggles the crop popover. In the bar flow — only re-flows horizontally, never changes the device height -->
            <span class="hw looppill" id="loopPill" role="button" tabindex="0" aria-haspopup="true" aria-expanded="false" aria-label="Voice loop — crop and tone"><span class="loopplay" id="loopPlay" role="button" tabindex="0" aria-label="Play / pause the loop" title="Play / pause"><svg viewBox="0 0 14 14" aria-hidden="true"><path class="ic-play" d="M3.5 2.3 L11.7 7 L3.5 11.7 Z"/><g class="ic-pause"><rect x="3.4" y="2.3" width="3" height="9.4" rx=".6"/><rect x="7.6" y="2.3" width="3" height="9.4" rx=".6"/></g></svg></span><svg class="loopspark" viewBox="0 0 24 12" preserveAspectRatio="none" aria-hidden="true"><path id="loopsparkP" d="M0,6"></path></svg><span>loop</span><i class="cv" aria-hidden="true">⌄</i><span class="loopx" id="loopX" role="button" tabindex="0" aria-label="Clear the voice loop" title="Clear the loop">✕</span></span>
            <span class="micgrille" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span><div class="micin sleeps" id="micin" role="button" tabindex="0" aria-pressed="false" aria-label="Voice in"><svg viewBox="0 0 24 24" aria-hidden="true"><rect class="mcap" x="8.5" y="3" width="7" height="11" rx="3.5"/><path class="myoke" d="M6 11 a6 6 0 0 0 12 0 M12 17 V20 M9 20 H15"/></svg><svg class="capring" id="capring" viewBox="0 0 44 44" aria-hidden="true"><path class="capringP" id="capringP" d="M22 2 H31 A11 11 0 0 1 42 13 V31 A11 11 0 0 1 31 42 H13 A11 11 0 0 1 2 31 V13 A11 11 0 0 1 13 2 Z"></path></svg><b class="capnum" id="capnum" aria-hidden="true"></b></div><i class="miclight" id="miclight" aria-hidden="true"></i>
            <span class="vstatus" id="vstatus" aria-live="polite"></span>
            <!-- voice loop: crop + tone — a popover anchored to the bar; paints OVER the console, never grows the device (replaces the old .vocalbar strip that reflowed the device + glitched the perimeter trace) -->
            <div class="loopover" id="loopover" role="dialog" aria-label="Crop the voice loop">
              <div class="lo-head"><span class="al">drag to crop · snaps to the beat</span><b class="vlen" id="vlen">2 bars</b></div>
              <div class="vwave" id="vwave" title="Drag the ends to crop, drag the middle to slide — the loop length stays on the beat">
                <svg viewBox="0 0 100 40" preserveAspectRatio="none" aria-hidden="true"><path class="vwpath" id="vwpath" d="M0,20"></path></svg>
                <span class="vticks" id="vticks" aria-hidden="true"></span>
                <span class="vmask vmaskl" id="vmaskl"></span><span class="vmask vmaskr" id="vmaskr"></span>
                <span class="vbody" id="loopBody" role="button" tabindex="0" aria-label="Move the selection"></span>
                <span class="vtrim vin" id="vtrimIn" role="slider" tabindex="0" aria-label="Loop start" aria-valuemin="0" aria-valuemax="8" aria-valuenow="0"></span>
                <span class="vtrim vout" id="vtrimOut" role="slider" tabindex="0" aria-label="Loop end" aria-valuemin="0" aria-valuemax="8" aria-valuenow="8"></span>
                <span class="vhead" id="vhead" aria-hidden="true"></span>
              </div>
              <div class="lo-tone">
                <div class="knob lo-int" id="vintKnob"><div class="dial"><div class="ptr"></div></div><span class="kl">INTENSITY</span></div>
                <span class="hw vchip on" data-v="double">double</span>
                <span class="hw vchip" data-v="robot">robot</span>
                <span class="hw vchip" data-v="tunnel">tunnel</span>
                <span class="hw vchip" data-v="hall">hall</span>
                <span class="hw vchip" data-v="chorus">chorus</span>
                <div class="knob lo-int lo-gain" id="vgainKnob"><div class="dial"><div class="ptr"></div></div><span class="kl">GAIN</span></div>
              </div>
              <div class="coverslide vcover"><div class="ct"><span>COVER · LP</span><span class="cvv" id="vcovval">OPEN</span></div>
                <div class="strack" id="vcovslide"><span class="sfill" id="vcovfill"></span><span class="shandle" id="vcovhandle"></span></div></div>
            </div>
          </div>


          <div class="console">
            <!-- COMMAND / RHYTHM (rightmost, full-height column) -->
            <div class="zone z-rhythm">
              <div class="zbody"><div class="command sleeps">
                <div class="tempo screen" id="tempo"><span class="pls" id="pls"></span><b id="bpm">96</b><small>BPM</small></div>
                <div class="cmdgroup">
                  <div class="kick" id="beat"><span class="pbtn"></span><span class="kl">DRUMS</span><span class="kh"><svg class="khico" viewBox="0 0 14 14" aria-hidden="true"><path class="ic-play" d="M3.5 2.3 L11.7 7 L3.5 11.7 Z"/><g class="ic-pause"><rect x="3.4" y="2.3" width="3" height="9.4" rx=".6"/><rect x="7.6" y="2.3" width="3" height="9.4" rx=".6"/></g></svg>SPACE</span></div>
                  <div class="seg patseg" id="patSeg"><b class="on" data-v="floor">FLOOR</b><b data-v="back">BACK</b><b data-v="half">HALF</b><b data-v="break">BREAK</b></div>
                  <div class="coverslide"><div class="ct"><span>DRUM COVER · LP</span><span class="cvv" id="coverval">OPEN</span></div>
                    <div class="strack" id="coverslide"><span class="sfill" id="coverfill"></span><span class="shandle" id="coverhandle"></span></div></div>
                  <div class="drumfx">
                    <div class="knob sm" id="swingKnob"><div class="dial"><div class="ptr"></div></div><span class="kl">SWING</span></div>
                    <div class="knob sm" id="densKnob"><div class="dial"><div class="ptr"></div></div><span class="kl">DENSITY</span></div>
                    <div class="knob sm" id="gritKnob"><div class="dial"><div class="ptr"></div></div><span class="kl">GRIT</span></div>
                  </div>
                  <div class="coverslide"><div class="ct"><span>SIDECHAIN · KICK DUCK</span><span class="cvv" id="scval">30%</span></div>
                    <div class="strack" id="scslide"><span class="sfill" id="scfill"></span><span class="shandle" id="schandle"></span></div></div>
                </div>
              </div></div>
            </div>
      
            <!-- VOICE -->
            <div class="zone z-voice">
              <div class="zbody"><div class="pad screen sleeps" id="vpad" style="--pc:#0ec4fc">
                <div class="padfield" id="vfield" role="application" aria-label="Voice morph field">
                  <span class="grid"></span><span class="cross"></span>
                  <span class="ax t">BRIGHT</span><span class="ax b">DARK</span><span class="ax l">LUSH</span><span class="ax r">CLEAN</span>
                  <div class="padband"><b id="vnreadout">SONAR</b></div>
                  <span class="puck" id="vpuck"></span>
                </div>
              </div></div>
            </div>
      
            <!-- AUTO-FILTER -->
            <div class="zone z-shape">
              <div class="zbody afz">
                <div class="afilter screen sleeps still" id="afilter" role="application" aria-label="Low-pass filter. Drag the node: sideways for cutoff, down to shave">
                  <svg class="afgrid" id="afgrid" preserveAspectRatio="none"></svg>
                  <div class="afglabels" id="afglabels" aria-hidden="true"></div>
                  <svg class="afcurve" id="afcurveSvg" viewBox="0 0 600 200" preserveAspectRatio="none"><g id="afg"><path class="fillpath" id="affill"></path><path id="afpath"></path><path class="ghost" id="afghost"></path></g></svg>
                  <div class="afnode" id="afnode" role="slider" aria-label="Cutoff and shave"></div>
                  <span class="afhint">drag the node · ⇄ cutoff · ⇣ shave</span>
                  <span class="mohint" id="mohint">turn up MOTION to sweep the filter ↓</span>
                </div>
                <div class="lfostrip sleeps">
                  <div class="knob" id="amtKnob"><div class="dial"><div class="ptr"></div></div><span class="kl">MOTION</span><span class="kn" id="amtNum">OFF</span></div>
                  <div class="shapegrid" id="shapeRow">
                    <span class="hw on" data-v="sine" title="sine"><span class="led"></span><svg viewBox="0 0 22 13"><path d="M1 6.5 Q5 1 9 6.5 T21 6.5"/></svg></span>
                    <span class="hw" data-v="sawi" title="ramp down"><span class="led"></span><svg viewBox="0 0 22 13"><path d="M1 2 L10 11 L10 2 L21 11"/></svg></span>
                    <span class="hw" data-v="saw" title="saw"><span class="led"></span><svg viewBox="0 0 22 13"><path d="M1 11 L10 2 L10 11 L21 2"/></svg></span>
                    <span class="hw" data-v="sqr" title="square"><span class="led"></span><svg viewBox="0 0 22 13"><path d="M1 11 L1 2 L11 2 L11 11 L21 11 L21 2"/></svg></span>
                  </div>
                  <div class="knob" id="rateKnob"><div class="dial"><div class="ptr"></div></div><span class="kl">RATE</span><span class="kn" id="rateNum">1/8</span></div>
                </div>
              </div>
            </div>
      
            <!-- EFFECTS -->
            <div class="zone z-effects">
              <div class="zbody"><div class="efx sleeps">
                <div class="fills" id="fills">
                  <div class="fxstrip">
                    <div class="fillcard" data-key="drive" style="--fc:#3ddc84"><span class="fill"></span><span class="fl">DRIVE</span><span class="pc">0</span></div>
                    <div class="seg vseg fxsub" id="dtype" style="--acc:#3ddc84"><b class="on" data-v="warm">WARM</b><b data-v="crunch">CRUNCH</b><b data-v="fuzz">FUZZ</b><b data-v="crush">CRUSH</b></div>
                  </div>
                  <div class="fxstrip">
                    <div class="fillcard" data-key="mod" style="--fc:#54e6a6"><span class="fill"></span><span class="fl">MOD</span><span class="pc">0</span></div>
                    <div class="seg vseg fxsub" id="mmode" style="--acc:#54e6a6"><b data-v="phaser">PHASE</b><b data-v="flanger">FLANGE</b><b data-v="doubler">DOUBLE</b><b class="on" data-v="chorus">CHORUS</b></div>
                  </div>
                  <div class="fxstrip">
                    <div class="fillcard" data-key="delay" style="--fc:#2fc7a0"><span class="fill"></span><span class="fl">DELAY</span><span class="pc">0</span></div>
                    <div class="seg vseg fxsub" id="drate" style="--acc:#2fc7a0"><b data-v="4">1/4</b><b class="on" data-v="8">1/8</b><b data-v="8d">1/8·</b><b data-v="16">1/16</b></div>
                  </div>
                  <div class="fxstrip">
                    <div class="fillcard" data-key="reverb" style="--fc:#8af0bf"><span class="fill"></span><span class="fl">REVERB</span><span class="pc">0</span></div>
                    <div class="seg vseg fxsub" id="rsize" style="--acc:#8af0bf"><b data-v="small">SM</b><b class="on" data-v="med">MED</b><b data-v="hall">HALL</b><b data-v="vast">VAST</b></div>
                  </div>
                </div>
              </div></div>
            </div>

            <!-- READOUT — now a grid item INSIDE .console (row 2, spans the 3 left columns); kept wrapped in .arpbar so every `.arpbar .readout` style/boot/powerdown selector still matches -->
          </div>

          <div class="coachband sleeps">
            <div class="arpbar sleeps" id="arpbar">
              <div class="readout sleeps" id="readout" data-mode="coach" aria-live="polite" aria-label="Guidance"><span class="rdtip"></span><div class="rdseq" aria-hidden="true"></div></div>
            </div>
            <div class="cmdgroup bassgroup">
              <div class="drumfx">
                <div class="kick basskick" id="bassrow" role="button" tabindex="0" aria-label="Bass on/off"><span class="bl">BASS</span><span class="kh kh-b">B</span></div>
                <div class="knob sm" id="bcharKnob"><div class="dial"><div class="ptr"></div></div><span class="kl">INTENSITY</span></div>
                <div class="knob sm" id="bweightKnob"><div class="dial"><div class="ptr"></div></div><span class="kl">SUB</span></div>
                <div class="knobdiv"></div>
                <div class="knob sm" id="bglideKnob"><div class="dial"><div class="ptr"></div></div><span class="kl">GLIDE</span></div>
                <div class="knob sm" id="bpluckKnob"><div class="dial"><div class="ptr"></div></div><span class="kl">MOVE</span></div>
              </div>
            </div>
          </div>
      
          <!-- PIANO -->
          <div class="pianowrap sleeps">
            <div class="pianohead">
              <div class="phsec"><div class="octctl"><span class="octbtn" id="octdn">◀</span><div class="ohscreen"><b id="octval">0</b><small id="octlbl">OCTAVE</small></div><span class="octbtn" id="octup">▶</span></div></div>
              <div class="phsec">
                <div class="keywrap"><div class="ohscreen keyscreen" id="keyBtn" role="button" tabindex="0" aria-label="Key root"><b id="keyval">C</b><small>KEY</small></div><div class="keypop" id="keyPop"></div></div>
                <div class="seg lockseg" id="lockseg" style="--acc:#0ec4fc"><b class="on" data-v="major">MAJ</b><b data-v="minor">MIN</b><b data-v="chrom">CHROM</b></div>
                <!-- batch7b: CHORD moved here, right of CHROM (divider between) — a play-mode toggle (held keys → triads), independent of the arp -->
                <div class="arpdiv"></div>
                <span class="hw chordtog" id="chordBtn" data-on="0" role="button" tabindex="0" aria-pressed="false" style="--acc:#7d8fa3"><i class="led"></i>CHORD</span>
              </div>
              <div class="arpmod" id="arpmod">
                <!-- batch7b: HOLD │ ARPEGGIATOR · RATE · LENGTH (CHORD moved up next to CHROM) -->
                <div class="arpsec">
                  <!-- HOLD (was LATCH): stand-alone sustain — holds whatever you're playing, hands-free. Not tied to the arp. -->
                  <span class="hw" id="latchBtn" data-on="0" role="button" tabindex="0" aria-pressed="false" aria-label="Hold / sustain on/off"><i class="led"></i>HOLD</span>
                </div>
                <div class="arpdiv"></div>
                <div class="arpsec">
                  <span class="hw arptog" id="arpBtn" data-on="0" role="button" tabindex="0" aria-pressed="false" aria-label="Arpeggiator on/off"><i class="led"></i>ARPEGGIATOR</span>
                </div>
                <div class="arpsec ratesec">
                  <div class="knob sm" id="arpRateKnob"><div class="dial"><div class="ptr"></div></div><span class="kl">RATE</span><span class="kn" id="arpRateNum">1/8</span></div>
                </div>
                <div class="arpsec">
                  <div class="knob sm" id="lenKnob"><div class="dial"><div class="ptr"></div></div><span class="kl">LENGTH</span></div>
                </div>
              </div>
            </div>
            <div class="piano locked" id="piano"><i class="spill" id="spill"></i></div>
          </div>
      
          <!-- PERFORMANCE row (hold while playing) -->
          <div class="gestbar sleeps" id="gestbar">
            <span class="gl">Performance · hold</span>
            <span class="gategroup">
              <span class="ggl">GATE</span>
              <span class="gpad gate" data-g="gate" data-rate="8"><b>Z</b>1/32</span>
              <span class="gpad gate" data-g="gate" data-rate="4"><b>X</b>1/16</span>
              <span class="gpad gate" data-g="gate" data-rate="2"><b>C</b>1/8</span>
            </span>
            <span class="gpad dive" data-g="dive"><b>M</b>DIVE</span>
          </div>
        </div>
    </div>

    <p class="takeflag" id="takeflag"></p>
  </div>
</section>

<style is:global>
  /* the section uses the SITE's .inner container (tokens.css) for vertical rhythm, but
     widens it (72->78rem) because the console grid's min width (218+196+370+202+3*16 =
     1034px + 36px body padding = 1070px) is wider than the page's 1024px content box —
     at 72rem the body crushed the grid and the effect towers spilled off the right edge.
     The instrument is a framed object, so sitting a touch wider than the text/#work
     column reads as intentional. */
  /* palette vars also live here because the take transport sits OUTSIDE .sgm */
  .signal-sec{padding:clamp(2.25rem,5vh,3.75rem) 0 var(--space-16,4rem);--amber:#ff9a4a;--red:#ff5a5a;--sapphire:#0ec4fc;--green:#3ddc84}
  .signal-sec .inner{max-width:78rem}
  .sgm-intro{font-size:1rem;color:var(--muted,#9aa6b4);margin:0 0 1.2rem;letter-spacing:.01em}
  .sgm{position:relative;--green:#3ddc84;--red:#ff5a5a;--sapphire:#0ec4fc;--pink:#ff8fb0;--amber:#ff9a4a;--curve:#5ec8f0;
    --metal-hi:#3a4150;--metal:#222834;--metal-lo:#11151d;--ink:#070a0e}
  .sgm .sgm-trace{position:absolute;inset:0;width:100%;height:100%;z-index:9;pointer-events:none;opacity:0;transition:opacity .5s ease .15s}
  .sgm .sgm-trace.drawing{opacity:1}
  .sgm .sgm-trace.settled{opacity:.4}   /* #2: holds as a subtle steady casing outline while live, instead of vanishing */
  .sgm .sgm-trace path{fill:none;stroke:var(--green);stroke-width:2;stroke-linecap:round;   /* #1: green (the effects/meter color), was amber */
    filter:drop-shadow(0 0 6px color-mix(in srgb,var(--green) 70%,transparent));
    transition:stroke-dashoffset 1.2s cubic-bezier(0.62,0,0.2,1)}
  .sgm .sgm-trace.settled path{stroke-width:1;filter:drop-shadow(0 0 2px color-mix(in srgb,var(--green) 55%,transparent))}
  /* tron screen-border traces: a sapphire neon line draws around each screen on power-on,
     then settles to a thin steady outline. injected per screen; clipped by the screen's
     overflow so the glow stays INSET (the casing never glows). */
  .sgm .scrn-trace{position:absolute;inset:0;width:100%;height:100%;z-index:8;pointer-events:none}
  .sgm .scrn-trace path{fill:none;stroke:#b9f3ff;stroke-width:2.1;stroke-linecap:round;vector-effect:non-scaling-stroke;
    filter:drop-shadow(0 0 4px #19e0ff) drop-shadow(0 0 12px rgba(25,224,255,.9)) drop-shadow(0 0 22px rgba(25,224,255,.5));
    transition:stroke-dashoffset 1.3s cubic-bezier(0.4,0.04,0.12,1)}
  .sgm .scrn-trace.amber path{stroke:#ffce8a;filter:drop-shadow(0 0 4px var(--amber)) drop-shadow(0 0 12px color-mix(in srgb,var(--amber) 70%,transparent)) drop-shadow(0 0 22px color-mix(in srgb,var(--amber) 40%,transparent))}
  .sgm .scrn-trace.settled{opacity:.42;transition:opacity .9s ease}   /* #2: settle to a faint steady outline, not gone */
  .sgm .scrn-trace.settled path{stroke-width:1;filter:drop-shadow(0 0 2px rgba(25,224,255,.6))}
  .sgm .scrn-trace.amber.settled path{stroke-width:1;filter:drop-shadow(0 0 2px color-mix(in srgb,var(--amber) 65%,transparent))}
  .sgm .screen.bulb{animation:sgmbulb .7s ease-out both}
  /* Candid small-screen stance: show the WHOLE dormant faceplate, scaled — never a
     cropped half-machine. zoom keeps the layout box honest (no dead whitespace) AND,
     critically, gives the console grid extra LOGICAL width before scaling down — so it
     never crushes below its 1070px min (which would spill the effect towers off the
     body). First step starts at 1200px: below that the container is viewport-limited and
     can't hold the grid unzoomed, so we scale instead of crush. */
  @media (max-width: 1200px){ .sgm .device{zoom:.82} }
  @media (max-width: 920px){ .sgm .device{zoom:.6} }
  @media (max-width: 700px){ .sgm .device{zoom:.44} }
  @media (max-width: 480px){ .sgm .device{zoom:.33} }
  .sgm[data-state="boot"] .pwr{pointer-events:none}
  .sgm .pwr.lit::before{box-shadow:inset 0 0 0 1.5px rgba(110,200,150,.45),inset 0 0 13px -4px rgba(74,160,112,.6)}
  .sgm .pwr.lit path{stroke:#7fc6a0;filter:drop-shadow(0 0 4px rgba(74,160,112,.5))}
  .sgm[data-touch] .pwr{cursor:default}
  .sgm{
  
    
    *{box-sizing:border-box}
    /* keyboard focus ring — sapphire (signal color); only on keyboard nav, never on mouse (no :focus-visible existed before) */
    :focus-visible{outline:2px solid color-mix(in srgb,var(--sapphire) 80%,transparent);outline-offset:2px;}

    /* carbon-fiber body; the casing NEVER glows on activation (the screens do) */
    .device{position:relative;border-radius:22px;padding:16px;display:flex;flex-direction:column;gap:11px;
      background-color:#090a0d;
      background-image:repeating-linear-gradient(45deg,rgba(190,210,240,.011) 0 1px,transparent 1px 4px),repeating-linear-gradient(-45deg,rgba(0,0,0,.2) 0 1px,transparent 1px 4px),radial-gradient(150% 95% at 50% -8%,rgba(120,150,195,.045),transparent 55%);
      border:1px solid rgba(0,0,0,.72);box-shadow:0 60px 110px -48px rgba(0,0,0,.95),inset 0 1px 0 rgba(255,255,255,.07),inset 0 -3px 2px rgba(0,0,0,.6),inset 0 0 0 1px rgba(90,110,140,.05)}
    .device::after{content:"";position:absolute;inset:6px;border-radius:17px;pointer-events:none;border:1px solid rgba(0,0,0,.35);box-shadow:inset 0 1px 0 rgba(255,255,255,.04)}
    .screw.tl{top:9px;left:9px}.screw.tr{top:9px;right:9px}.screw.bl{bottom:9px;left:9px}.screw.br{bottom:9px;right:9px}
    .glab{font-family:ui-monospace,Menlo,monospace;font-size:.5rem;letter-spacing:.22em;text-transform:uppercase;color:#8a98aa;margin-bottom:8px;text-shadow:0 1px 0 rgba(0,0,0,.5);display:flex;align-items:center;gap:6px}
    .glab .dot{width:4px;height:4px;border-radius:50%;background:var(--sapphire);box-shadow:0 0 5px var(--sapphire)}
    .glab .vn{margin-left:auto;color:#cfe6f5;letter-spacing:.14em}
    /* the morph voice name now lives ON the pad screen as a lit readout — a real synth shows
       its patch name on the display — replacing the removed zone header; dark until power. */
    .pad .vn{position:absolute;left:10px;top:9px;z-index:3;font-family:ui-monospace,Menlo,monospace;font-size:.5rem;letter-spacing:.18em;color:#bfe6f8;text-shadow:0 0 7px color-mix(in srgb,var(--sapphire) 70%,transparent);pointer-events:none;transition:opacity .5s ease}
  
    /* glass screens — dark recessed glass that lights from WITHIN on power.
       ::before = fixed sheen; ::after = scanlines that only turn on when live
       (or per-screen during the .bulb boot). The casing never glows; the glow is
       always an INSET on the screen, never an outer bloom. */
    .screen{position:relative;border-radius:2px;overflow:hidden;background:radial-gradient(130% 130% at 50% 0%,#080e16,#04060b 80%);box-shadow:inset 0 0 0 1px rgba(0,0,0,.8),inset 0 2px 10px rgba(0,0,0,.62),inset 0 -1px 0 rgba(255,255,255,.03),0 1px 0 rgba(255,255,255,.045),0 2px 5px rgba(0,0,0,.4);border:1px solid rgba(155,167,187,.16);transition:box-shadow .55s ease,background .55s ease,border-color .55s ease}
    .screen::before{content:"";position:absolute;inset:0;pointer-events:none;background:linear-gradient(152deg,rgba(255,255,255,.05) 0%,transparent 28%);z-index:6}
    .screen::after{content:"";position:absolute;inset:0;z-index:5;pointer-events:none;opacity:0;mix-blend-mode:screen;transition:opacity .6s ease;background:repeating-linear-gradient(0deg,rgba(150,195,240,.085) 0 1px,transparent 1px 2px)}
    .device.live .screen::after,.screen.bulb::after,.screen.wk::after{opacity:1}
    /* sapphire signal screens (voice-morph pad + auto-filter) glow blue from within when lit */
    .device.live .screen.pad,.device.live .screen.afilter,.screen.pad.wk,.screen.afilter.wk{box-shadow:inset 0 0 0 1px rgba(255,255,255,.05),inset 0 3px 12px rgba(0,0,0,.72),inset 0 0 44px 10px rgba(0,0,0,.5)}
    /* #B: the LFO inner screen's border lights ONLY once .device.live lands (= the startup outer-border trace has finished) — sapphire inner outline */
    .device.live .screen.pad,.device.live .screen.afilter,.screen.pad.wk,.screen.afilter.wk{border-color:color-mix(in srgb,var(--sapphire) 26%,rgba(155,167,187,.16));box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--sapphire) 24%,transparent),inset 0 3px 12px rgba(0,0,0,.72),inset 0 0 44px 10px rgba(0,0,0,.5)}   /* batch4 #3: voice matrix gets the SAME sapphire glass border as the filter so the LFO/voice pair reads unified */
    /* proud tactile keycap (the locked .pk recipe): top highlight + inner bottom shadow + side wall + drop shadow */
    .hw{position:relative;border:none;border-radius:9px;cursor:pointer;font-family:ui-monospace,Menlo,monospace;font-size:.56rem;letter-spacing:.06em;color:#b3bdc9;
      background:linear-gradient(180deg,#464e5c 0%,#2c333f 47%,#1f2630 100%);
      border-top:1px solid rgba(255,255,255,.13);
      box-shadow:inset 0 1.5px 0.5px rgba(255,255,255,.26),inset 0 -5px 7px rgba(0,0,0,.5),inset 0 0 0 1px rgba(255,255,255,.03),0 4px 0 #0a0d12,0 7px 9px rgba(0,0,0,.6);
      display:flex;align-items:center;justify-content:center;user-select:none;transition:transform .07s,box-shadow .12s,color .12s,opacity .5s ease}
    .hw:active{transform:translateY(2px);box-shadow:inset 0 1.5px 0.5px rgba(255,255,255,.2),inset 0 -3px 5px rgba(0,0,0,.5),0 2px 0 #0a0d12,0 3px 5px rgba(0,0,0,.6)}
    /* engaged = pressed-in cap + inset sapphire (or --acc) glow + lit LED */
    .hw.on{color:#eafaff;border-top-color:rgba(255,255,255,.06);   /* engaged = lit + recessed IN PLACE (no translateY drop — keeps button rows even) */
      background:linear-gradient(180deg,#2d343f,#1a212b);
      box-shadow:inset 0 2px 5px rgba(0,0,0,.6),inset 0 0 13px -4px var(--acc,var(--sapphire)),0 1px 0 #0a0d12,0 2px 3px rgba(0,0,0,.55)}
    .hw .led{position:absolute;top:4px;right:5px;width:4px;height:4px;border-radius:50%;background:#1a2630;box-shadow:inset 0 0 0 1px rgba(0,0,0,.6)}   /* item 2: led + inset trimmed for the smaller caps (was 5px@top5/right7) */
    .hw.on .led{background:var(--acc,var(--sapphire));box-shadow:0 0 8px var(--acc,var(--sapphire)),0 0 2px #cdeeff}
    .hw svg{width:14px;height:9px}.hw svg path{stroke:#9aa6b4;stroke-width:1.5;fill:none;stroke-linecap:round;stroke-linejoin:round}   /* item 2: waveform glyph scaled down with the smaller caps (was 18x12) */
    .hw.on svg path{stroke:#eaf6ff;filter:drop-shadow(0 0 3px var(--acc,var(--sapphire)))}
    /* a row of keycaps recessed in a dark housing; the selected b is the pressed, lit cap */
    .seg{display:flex;gap:4px;border-radius:9px;padding:3px;background:linear-gradient(180deg,#0a0d12,#060809);border:1px solid rgba(0,0,0,.7);box-shadow:inset 0 1px 3px rgba(0,0,0,.75),inset 0 0 0 1px rgba(0,0,0,.5);transition:opacity .5s ease}
    .seg b{position:relative;flex:1;text-align:center;font-family:ui-monospace,Menlo,monospace;font-size:.56rem;color:#b3bdc9;padding:6px 0;cursor:pointer;border-radius:6px;
      background:linear-gradient(180deg,#464e5c 0%,#2c333f 47%,#1f2630 100%);
      border-top:1px solid rgba(255,255,255,.12);
      box-shadow:inset 0 1.2px 0.5px rgba(255,255,255,.22),inset 0 -4px 6px rgba(0,0,0,.5),0 3px 0 #0a0d12,0 5px 7px rgba(0,0,0,.55);
      user-select:none;transition:transform .07s,box-shadow .12s,color .12s}
    .seg b:active{transform:translateY(2px);box-shadow:inset 0 1px 0.5px rgba(255,255,255,.18),inset 0 -3px 5px rgba(0,0,0,.5),0 1px 0 #0a0d12,0 2px 4px rgba(0,0,0,.55)}
    .seg b.on{color:#eafaff;border-top-color:rgba(255,255,255,.06);   /* no drop — selected seg stays flush with its row */
      background:linear-gradient(180deg,#2d343f,#1a212b);
      box-shadow:inset 0 2px 5px rgba(0,0,0,.6),inset 0 0 12px -4px var(--acc,var(--sapphire)),0 1px 0 #0a0d12,0 2px 3px rgba(0,0,0,.5)}
    .seg b.on::after{content:"";position:absolute;top:4px;right:5px;width:4px;height:4px;border-radius:50%;background:var(--acc,var(--sapphire));box-shadow:0 0 7px var(--acc,var(--sapphire)),0 0 2px #cdeeff}
  
    /* DARK-UNTIL-POWER: a sleeping module is genuinely dark -- the carbon chassis
       stays, but its controls and screens go near-black (screen content hidden). It
       illuminates under .device.live (steady) or per element via the boot-reveal .wk
       the JS staggers on during power-on. .sleeps / .wk stay pure JS hooks. */
    .device:not(.live){--glow:#2a3340}
    .device:not(.live) .sleeps{pointer-events:none}
    /* physical controls stay fully visible when off -- a button doesn't go dark just
       because the power is off. ONLY their lit states (engaged glow / LED / backlit dot)
       are power-gated, so a powered-off cap reads as a real unlit button. */
    .device:not(.live) .hw.on,.device:not(.live) .seg b.on,.device:not(.live) .gpad.on,.device:not(.live) .kick.on,.device:not(.live) .crow.on{box-shadow:inset 0 2px 5px rgba(0,0,0,.6),0 1px 0 #0a0d12,0 2px 3px rgba(0,0,0,.5)}
    .device:not(.live) .hw.on .led{background:#1a2630;box-shadow:inset 0 0 0 1px rgba(0,0,0,.6)}
    .device:not(.live) .seg b.on::after{background:#1a2630;box-shadow:none}
    /* an engaged toggle keeps its FLIPPED position when off (a real switch stays thrown),
       but the green slot backlight + throw glow are power-gated to neutral metal */
    /* (rocker toggle retired - BEAT/BASS use the round .pbtn pushbutton now) */
    /* LCD displays + value-driven glows are lit elements -> dark/neutral until power
       (knob pointer + slider position stay visible as physical settings, just unlit) */
    .device:not(.live) .fillcard .fill{opacity:0}
    .device:not(.live) .seg,.device:not(.live) .hw{opacity:.42}   /* #3: in standby, the segmented + hardware buttons dim to the same quiet level as the rest (they were full + lit), so a powered-off instrument reads uniformly dark — matching the on-state dimmed look */
    .device:not(.live) .dial{background:conic-gradient(from 225deg,#48515f 0 calc(var(--v,0)*270deg),#262c35 calc(var(--v,0)*270deg) 270deg,#0a0d12 270deg 360deg)}
    .device:not(.live) #amtKnob .dial{box-shadow:inset 0 0 0 1px rgba(0,0,0,.6),0 1px 2px rgba(0,0,0,.5)}
    /* off: the LCD segments + leading-edge glow go dark; the fill width (physical
       position) stays visible as a flat neutral bar, just unlit */
    .device:not(.live) .sfill{box-shadow:none;background:linear-gradient(90deg,rgba(130,150,180,.16),rgba(130,150,180,.26))}
    .device:not(.live) .sfill::after{background:rgba(150,170,200,.32);box-shadow:none}
    /* screens go to near-black glass; their lit inner content is invisible until power */
    .device:not(.live) .sleeps .screen,.device:not(.live) .screen.sleeps{background:radial-gradient(130% 130% at 50% 0%,#0a1019,#06090f 82%);box-shadow:inset 0 0 0 1px rgba(0,0,0,.82),inset 0 2px 10px rgba(0,0,0,.66),inset 0 -1px 0 rgba(255,255,255,.03),0 1px 0 rgba(255,255,255,.04),0 2px 5px rgba(0,0,0,.4)}
    .device:not(.live) .pad.sleeps .vn,.device:not(.live) .pad.sleeps .grid,.device:not(.live) .pad.sleeps .cross,.device:not(.live) .pad.sleeps .puck,.device:not(.live) .pad.sleeps .lm,.device:not(.live) .sleeps .ax,
    .device:not(.live) .sleeps .afcurve,.device:not(.live) .sleeps .affill,.device:not(.live) .sleeps .afghost,.device:not(.live) .sleeps .afnode,.device:not(.live) .sleeps .afgrid,.device:not(.live) .sleeps .afhint,.device:not(.live) .sleeps .afglabels,
    .device:not(.live) .sleeps .tempo b,.device:not(.live) .sleeps .tempo small,.device:not(.live) .sleeps .tempo .pls{opacity:0;transition:opacity 1.2s ease}
    .device .sleeps.wk .screen,.device .screen.sleeps.wk{background:radial-gradient(130% 130% at 50% 0%,#080e16,#04060b 80%)}
    .device .pad.sleeps.wk .vn,.device .pad.sleeps.wk .grid,.device .pad.sleeps.wk .cross,.device .pad.sleeps.wk .puck,.device .pad.sleeps.wk .lm,.device .sleeps.wk .ax,
    .device .sleeps.wk .afcurve,.device .sleeps.wk .affill,.device .sleeps.wk .afghost,.device .sleeps.wk .afnode,.device .sleeps.wk .afgrid,.device .sleeps.wk .afhint,.device .sleeps.wk .afglabels,
    .device .sleeps.wk .tempo b,.device .sleeps.wk .tempo small,.device .sleeps.wk .tempo .pls{opacity:1}
    .device:not(.live) .pad.sleeps.wk .puck,.device:not(.live) .sleeps.wk .afnode{opacity:.55}

    /* ════ POWER-FADE (#2/#3): glass screens fade CONCURRENTLY with the border trace.
       data-state flips at the PRESS (boot/powerdown) while .device.live toggles only at TRACEMS(1380ms);
       these drive the screens during that window so they resolve exactly as the border completes.
       Every selector is .sgm[data-state] .device <x> so it out-specifies the .device.live (powerdown)
       and .device:not(.live) (boot) rule otherwise active. ~1.2s ≈ the 1.38s trace. ════ */
    .sgm[data-state="boot"] .device:not(.live) .screen,.sgm[data-state="powerdown"] .device.live .screen,
    .sgm[data-state="boot"] .device:not(.live) .screen::after,.sgm[data-state="powerdown"] .device.live .screen::after,
    .sgm[data-state="boot"] .device:not(.live) .tempo,.sgm[data-state="powerdown"] .device.live .tempo,
    .sgm[data-state="boot"] .device:not(.live) .tempo::after,.sgm[data-state="powerdown"] .device.live .tempo::after,
    .sgm[data-state="boot"] .device:not(.live) .padband::after,.sgm[data-state="powerdown"] .device.live .padband::after,
    .sgm[data-state="boot"] .device:not(.live) .padband b,.sgm[data-state="powerdown"] .device.live .padband b,
    .sgm[data-state="boot"] .device:not(.live) .arpbar .readout,.sgm[data-state="powerdown"] .device.live .arpbar .readout,
    .sgm[data-state="boot"] .device:not(.live) .arpbar .readout::after,.sgm[data-state="powerdown"] .device.live .arpbar .readout::after,
    .sgm[data-state="boot"] .device:not(.live) .readout .rdtip,.sgm[data-state="powerdown"] .device.live .readout .rdtip,
    .sgm[data-state="boot"] .device:not(.live) .ohscreen b,.sgm[data-state="powerdown"] .device.live .ohscreen b,
    .sgm[data-state="boot"] .device:not(.live) .vscreen b,.sgm[data-state="powerdown"] .device.live .vscreen b,
    .sgm[data-state="boot"] .device:not(.live) .pad .grid,.sgm[data-state="powerdown"] .device.live .pad .grid,
    .sgm[data-state="boot"] .device:not(.live) .pad .cross,.sgm[data-state="powerdown"] .device.live .pad .cross,
    .sgm[data-state="boot"] .device:not(.live) .pad .puck,.sgm[data-state="powerdown"] .device.live .pad .puck,
    .sgm[data-state="boot"] .device:not(.live) .ax,.sgm[data-state="powerdown"] .device.live .ax,
    .sgm[data-state="boot"] .device:not(.live) .afcurve,.sgm[data-state="powerdown"] .device.live .afcurve,
    .sgm[data-state="boot"] .device:not(.live) .affill,.sgm[data-state="powerdown"] .device.live .affill,
    .sgm[data-state="boot"] .device:not(.live) .afghost,.sgm[data-state="powerdown"] .device.live .afghost,
    .sgm[data-state="boot"] .device:not(.live) .afnode,.sgm[data-state="powerdown"] .device.live .afnode,
    .sgm[data-state="boot"] .device:not(.live) .afgrid,.sgm[data-state="powerdown"] .device.live .afgrid,
    .sgm[data-state="boot"] .device:not(.live) .afhint,.sgm[data-state="powerdown"] .device.live .afhint,
    .sgm[data-state="boot"] .device:not(.live) .afglabels,.sgm[data-state="powerdown"] .device.live .afglabels{
      transition:opacity 1.2s ease,box-shadow 1.2s ease,border-color 1.2s ease,background-color 1.2s ease,background 1.2s ease,color 1.2s ease,text-shadow 1.2s ease !important}
    /* BOOT — light the screens (concurrent with the draw). !important so they reliably beat the later .device.live / base rules. */
    .sgm[data-state="boot"] .device:not(.live) .screen::after{opacity:1 !important}
    .sgm[data-state="boot"] .device:not(.live) .screen.pad,.sgm[data-state="boot"] .device:not(.live) .screen.afilter{box-shadow:inset 0 0 0 1px rgba(255,255,255,.05),inset 0 3px 12px rgba(0,0,0,.72),inset 0 0 44px 10px rgba(0,0,0,.5) !important}
    .sgm[data-state="boot"] .device:not(.live) .screen.afilter{border-color:color-mix(in srgb,var(--sapphire) 26%,rgba(155,167,187,.16)) !important;box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--sapphire) 24%,transparent),inset 0 3px 12px rgba(0,0,0,.72),inset 0 0 44px 10px rgba(0,0,0,.5) !important}
    .sgm[data-state="boot"] .device:not(.live) .tempo{box-shadow:inset 0 0 0 1px rgba(255,176,74,.13),inset 0 3px 12px rgba(0,0,0,.72),inset 0 0 24px -9px color-mix(in srgb,var(--amber) 55%,transparent),inset 0 0 15px 5px rgba(0,0,0,.4) !important}
    .sgm[data-state="boot"] .device:not(.live) .tempo::after{background:repeating-linear-gradient(0deg,rgba(255,176,74,.06) 0 1px,transparent 1px 3px) !important}
    .sgm[data-state="boot"] .device:not(.live) .padband::after{opacity:1 !important}
    .sgm[data-state="boot"] .device:not(.live) .padband b{opacity:1 !important}
    .sgm[data-state="boot"] .device:not(.live) .arpbar .readout{box-shadow:inset 0 0 0 1px rgba(0,0,0,.92),inset 0 2px 9px rgba(0,0,0,.85),inset 0 0 20px -8px var(--sapphire) !important}
    .sgm[data-state="boot"] .device:not(.live) .arpbar .readout::after{opacity:1 !important}
    .sgm[data-state="boot"] .device:not(.live) .readout .rdtip{color:#d2f1ff !important;font-weight:500;text-shadow:0 0 7px color-mix(in srgb,var(--sapphire) 48%,transparent) !important}
    .sgm[data-state="boot"] .device:not(.live) .ohscreen b{color:#ffcf8f !important;text-shadow:0 0 7px color-mix(in srgb,var(--amber) 70%,transparent) !important}
    .sgm[data-state="boot"] .device:not(.live) .vscreen b{color:#bfe6f8 !important;text-shadow:0 0 7px color-mix(in srgb,var(--sapphire) 65%,transparent) !important}
    .sgm[data-state="boot"] .device:not(.live) .pad .grid,.sgm[data-state="boot"] .device:not(.live) .pad .cross,.sgm[data-state="boot"] .device:not(.live) .ax,
    .sgm[data-state="boot"] .device:not(.live) .afcurve,.sgm[data-state="boot"] .device:not(.live) .affill,.sgm[data-state="boot"] .device:not(.live) .afghost,
    .sgm[data-state="boot"] .device:not(.live) .afgrid,.sgm[data-state="boot"] .device:not(.live) .afhint,.sgm[data-state="boot"] .device:not(.live) .afglabels{opacity:1 !important}
    .sgm[data-state="boot"] .device:not(.live) .pad .puck,.sgm[data-state="boot"] .device:not(.live) .afnode{opacity:.55 !important}
    /* POWER-DOWN — force the screens dark (concurrent with the retract) */
    .sgm[data-state="powerdown"] .device.live .screen::after{opacity:0 !important}
    .sgm[data-state="powerdown"] .device.live .screen.pad,.sgm[data-state="powerdown"] .device.live .screen.afilter{box-shadow:inset 0 0 0 1px rgba(0,0,0,.8),inset 0 2px 10px rgba(0,0,0,.62),inset 0 -1px 0 rgba(255,255,255,.03),0 1px 0 rgba(255,255,255,.045),0 2px 5px rgba(0,0,0,.4) !important}
    .sgm[data-state="powerdown"] .device.live .screen.afilter{border-color:rgba(155,167,187,.16) !important}
    .sgm[data-state="powerdown"] .device.live .tempo{box-shadow:inset 0 0 0 1px rgba(0,0,0,.8),inset 0 2px 10px rgba(0,0,0,.62),inset 0 -1px 0 rgba(255,255,255,.03),0 1px 0 rgba(255,255,255,.045),0 2px 5px rgba(0,0,0,.4) !important}
    .sgm[data-state="powerdown"] .device.live .tempo::after{background:none !important}
    .sgm[data-state="powerdown"] .device.live .padband::after{opacity:0 !important}
    .sgm[data-state="powerdown"] .device.live .padband b{opacity:0 !important}
    .sgm[data-state="powerdown"] .device.live .arpbar .readout{box-shadow:inset 0 0 0 1px rgba(0,0,0,.92),inset 0 2px 9px rgba(0,0,0,.85) !important}
    .sgm[data-state="powerdown"] .device.live .arpbar .readout::after{opacity:0 !important}
    .sgm[data-state="powerdown"] .device.live .readout .rdtip{color:#3c4a59 !important;text-shadow:none !important}
    .sgm[data-state="powerdown"] .device.live .ohscreen b{color:#34404e !important;text-shadow:none !important}
    .sgm[data-state="powerdown"] .device.live .vscreen b{color:#33404e !important;text-shadow:none !important}
    .sgm[data-state="powerdown"] .device.live .pad .grid,.sgm[data-state="powerdown"] .device.live .pad .cross,.sgm[data-state="powerdown"] .device.live .pad .puck,
    .sgm[data-state="powerdown"] .device.live .ax,.sgm[data-state="powerdown"] .device.live .afcurve,.sgm[data-state="powerdown"] .device.live .affill,
    .sgm[data-state="powerdown"] .device.live .afghost,.sgm[data-state="powerdown"] .device.live .afnode,.sgm[data-state="powerdown"] .device.live .afgrid,
    .sgm[data-state="powerdown"] .device.live .afhint,.sgm[data-state="powerdown"] .device.live .afglabels{opacity:0 !important}
    @media (prefers-reduced-motion: reduce){.sgm[data-state="boot"] .device:not(.live) .screen,.sgm[data-state="powerdown"] .device.live .screen,.sgm[data-state="boot"] .device:not(.live) .tempo,.sgm[data-state="powerdown"] .device.live .tempo,.sgm[data-state="boot"] .device:not(.live) .readout,.sgm[data-state="powerdown"] .device.live .readout{transition:none !important}}
  
    .io{position:relative;display:flex;gap:12px;align-items:center;height:48px;padding:0 4px}
    /* VOICE name screen in the header — populates from the morph dot's position in the field */
    .vscreen{display:flex;flex-direction:column;align-items:center;justify-content:center;line-height:1;padding:5px 13px;border-radius:2px;background:radial-gradient(130% 130% at 50% 0%,#080e16,#04060b 80%);box-shadow:inset 0 0 0 1px rgba(0,0,0,.82),inset 0 2px 8px rgba(0,0,0,.7);border:1px solid rgba(255,255,255,.05)}
    .vscreen b{font-family:ui-monospace,Menlo,monospace;font-size:.74rem;letter-spacing:.12em;color:#33404e;transition:color .5s,text-shadow .5s}
    .device.live .vscreen b{color:#bfe6f8;text-shadow:0 0 7px color-mix(in srgb,var(--sapphire) 65%,transparent)}
    .vscreen small{font-size:.38rem;letter-spacing:.24em;color:#52606f;margin-top:3px}
    /* power: a flush dark-glass disc that lights from within. OFF a faint red ember
       ring + glyph; ON a soft green ring + glyph. ::after stays the breathe/flare halo. */
    .pwr{width:46px;height:46px;flex:none;border-radius:50%;position:relative;cursor:pointer;border:none;
      background:radial-gradient(circle at 50% 36%,#0e141c,#05080c 76%);
      box-shadow:inset 0 1px 1px rgba(255,255,255,.06),inset 0 0 0 1px rgba(0,0,0,.8),inset 0 3px 7px rgba(0,0,0,.72),0 1px 2px rgba(0,0,0,.6);transition:box-shadow .4s}
    .pwr::before{content:"";position:absolute;inset:0;border-radius:50%;z-index:1;pointer-events:none;box-shadow:inset 0 0 0 1.5px rgba(255,90,90,.16);transition:box-shadow .4s}
    .pwr svg{position:absolute;inset:0;margin:auto;width:36%;height:36%;z-index:2}.pwr path{stroke:rgba(255,90,90,.5);stroke-width:2.2;fill:none;stroke-linecap:round;transition:stroke .4s,filter .4s}
    .device.live .pwr::before{box-shadow:inset 0 0 0 1.5px rgba(110,200,150,.45),inset 0 0 13px -4px rgba(74,160,112,.6)}
    .device.live .pwr path{stroke:#7fc6a0;filter:drop-shadow(0 0 4px rgba(74,160,112,.5))}
    .nameplate{display:none}   /* #4: no text beside the power button (kept in DOM for #statusline JS writes, just never shown) */
    .nameplate b{color:#c3cedb}
    /* #A1: status = second nameplate line; dark-until-power (dim grey standby → green live). Was display:none, so "LIVE · press A S D F to play" never showed. */
    .nameplate .st{display:block;font-size:.5rem;letter-spacing:.16em;color:#46525f;white-space:nowrap;transition:color .5s}
    .device.live .nameplate .st{color:var(--green)}
    .spacer{flex:1}
    /* VOICE IN — a robust protruding hardware keycap (rounded-square carbon cap, 44px = a hair smaller than the 46px power disc) carrying a condenser-mic glyph. Recessed inner face + 4px standoff + drop shadow so it presses mechanically. Dark-until-power; cap face goes sapphire-lit + the red record LED fires when armed (.on). */
    .micin{position:relative;width:44px;height:44px;flex:none;border-radius:13px;cursor:pointer;user-select:none;
      background:linear-gradient(180deg,#3a4250 0%,#252b35 46%,#161c25 100%);border-top:1px solid rgba(255,255,255,.13);
      box-shadow:inset 0 1.4px .5px rgba(255,255,255,.2),inset 0 -5px 7px rgba(0,0,0,.55),0 4px 0 #07090d,0 6px 10px rgba(0,0,0,.6);
      transition:transform .07s,box-shadow .14s,background .4s}
    .micin::before{content:"";position:absolute;inset:4px;border-radius:9px;box-shadow:inset 0 1px 1px rgba(255,255,255,.05),inset 0 0 0 1px rgba(0,0,0,.55),inset 0 2px 5px rgba(0,0,0,.5);transition:box-shadow .4s}
    .micin svg{position:absolute;inset:0;margin:auto;width:18px;height:22px}
    .micin .mcap{fill:none;stroke:#5a6675;stroke-width:1.6;transition:stroke .4s,filter .4s}
    .micin .myoke{fill:none;stroke:#4a5563;stroke-width:1.5;stroke-linecap:round;transition:stroke .4s}
    .micin:active{transform:translateY(2px);box-shadow:inset 0 1px .4px rgba(255,255,255,.16),inset 0 -3px 5px rgba(0,0,0,.5),0 2px 0 #07090d,0 3px 5px rgba(0,0,0,.55)}
    .device:not(.live) .micin{opacity:.5}
    /* powered (not yet armed): the steel glyph wakes */
    .device.live .micin .mcap,.micin.wk .mcap{stroke:#aebdce}
    .device.live .micin .myoke,.micin.wk .myoke{stroke:#8a98a8}
    /* armed (.on): cap face goes sapphire-lit, glyph glows */
    .micin.on{background:linear-gradient(180deg,#16323f,#0b1a23);border-top-color:rgba(14,196,252,.3)}
    .micin.on::before{box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--sapphire) 30%,#000),inset 0 0 12px -4px var(--sapphire),inset 0 2px 5px rgba(0,0,0,.5)}
    .micin.on .mcap{stroke:#bfeeff;filter:drop-shadow(0 0 4px color-mix(in srgb,var(--sapphire) 60%,transparent))}
    .micin.on .myoke{stroke:color-mix(in srgb,var(--sapphire) 70%,#7fd6f4)}
    /* the red record LED beside the mic */
    .miclight{width:6px;height:6px;border-radius:50%;flex:none;background:#3a1212;box-shadow:inset 0 0 0 1px rgba(0,0,0,.6);transition:background .25s,box-shadow .25s}
    .io:has(.micin.loop) .miclight{background:var(--sapphire);box-shadow:0 0 8px color-mix(in srgb,var(--sapphire) 75%,transparent),0 0 2px #bfeeff}   /* a live voice loop = steady sapphire tally (red is recording-only, below) */
    /* mic-grille slits — milled directly into the carbon body (NO panel/background), like a premium metal-chassis synth's built-in mic port. Capsule-shaped (slits taper top/bottom). */
    .micgrille{position:relative;width:24px;height:30px;flex:none;display:flex;flex-direction:column;justify-content:center;gap:3px;opacity:.5}
    .micgrille i{display:block;height:1px;margin:0 auto;border-radius:1px;background:rgba(0,0,0,.6);box-shadow:0 1px 0 rgba(150,180,210,.06)}
    .micgrille i:nth-child(1),.micgrille i:nth-child(5){width:52%}
    .micgrille i:nth-child(2),.micgrille i:nth-child(4){width:80%}
    .micgrille i:nth-child(3){width:96%}
  
    /* ── VOICE IN: the capture state lives ON the mic capsule (a count-in digit + a recording ring),
       the crop+tone UI in a bar-anchored popover. Neither is in .io's flow, so the device never
       grows a pixel when recording or cropping — which is what kept the perimeter trace from glitching. ── */
    /* count-in digit + progress ring: both out of flow over the 44px cap, never widen it (they paint in the 12px .io gap) */
    .micin .capring{position:absolute;inset:0;width:100%;height:100%;margin:0;pointer-events:none;opacity:0;transition:opacity .25s ease;overflow:visible}   /* fill the WHOLE button — .micin svg{width:18px;height:22px;margin:auto} was shrinking the trace down to the mic-icon; this overrides it so the border traces the button perimeter */
    .micin .capring .capringP{fill:none;stroke:#3a4654;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;vector-effect:non-scaling-stroke}   /* dasharray + dashoffset are set in JS from the path's REAL getTotalLength — the boot-trace technique — so the FULL border draws (pathLength wasn't reliable) */
    .micin.arming .capring,.micin.rec .capring,.micin.loop .capring{opacity:1}
    .micin.rec .capring .capringP{stroke:#ff3b30;stroke-width:2.6;filter:drop-shadow(0 0 5px #ff3b30)}   /* recording: a glowing RED trace fills around the mic's border; one full lap == the 2 bars are done (it stops on its own) */
    .micin.loop .capring .capringP{stroke:#ff5a4a;stroke-width:2.4;filter:drop-shadow(0 0 6px #ff5a4a)}   /* a loop EXISTS: the border stays lit red — the capsule itself is the loop-present indicator */
    .micin .capnum{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;pointer-events:none;
      font-family:'Orbitron',ui-monospace,sans-serif;font-size:1.05rem;line-height:1;color:var(--amber);text-shadow:0 0 10px var(--amber),0 0 3px #ffd9ad;opacity:0;transition:opacity .15s ease}
    .micin.arming .capnum{opacity:1}
    .micin.arming svg:not(.capring){opacity:.22}   /* count-in: the mic glyph dims so the count digit owns the cap */
    .micin.rec .capnum{opacity:0}   /* batch: recording shows progress via the filling RED RING only — the number was unreadable behind it */
    .micin.arming{background:linear-gradient(180deg,#2a2410,#15110a);border-top-color:rgba(255,154,74,.3)}
    .capnum.pop{animation:capnumpop .13s ease}
    @keyframes capnumpop{0%{transform:scale(.65);opacity:.4}45%{transform:scale(1.16)}100%{transform:scale(1)}}
    /* the record tally dot (#miclight) reads the capsule state: amber pulse while counting in, solid red while recording, steady red while a loop plays */
    .io:has(.micin.arming) .miclight{background:var(--amber);box-shadow:0 0 9px var(--amber),0 0 3px #ffd9ad;animation:micpulse .5s ease-in-out infinite}
    .io:has(.micin.rec) .miclight{background:#ff3b30;box-shadow:0 0 11px #ff3b30,0 0 4px #ff8b85;animation:none}
    @keyframes micpulse{0%,100%{opacity:.4}50%{opacity:1}}
    /* loop pill — appears in the (abs-centered) transport once a take exists; toggles the crop popover */
    .looppill{display:none;height:34px;gap:8px;align-items:center;padding:0 7px 0 13px;font-size:.58rem;letter-spacing:.1em;text-transform:uppercase}
    .looppill .loopx{display:inline-flex;align-items:center;justify-content:center;width:21px;height:21px;border-radius:6px;font-size:.74rem;color:#9fb0c1;background:rgba(255,90,74,.08);box-shadow:inset 0 0 0 1px rgba(0,0,0,.45);cursor:pointer;transition:background .15s,color .15s}
    .looppill .loopx:hover{background:rgba(255,90,74,.9);color:#fff}   /* X clears the loop (the mic then records a fresh one) */
    .looppill .loopplay{display:inline-flex;align-items:center;justify-content:center;width:18px;height:18px;flex:none;cursor:pointer;color:var(--sapphire)}
    .looppill .loopplay svg{width:13px;height:13px}
    .looppill .loopplay .ic-play,.looppill .loopplay .ic-pause rect{fill:currentColor}
    .looppill .loopplay .ic-play{display:none}.looppill.loop-paused .loopplay .ic-play{display:block}   /* paused → show ▶ (tap to play) */
    .looppill .loopplay .ic-pause{display:block}.looppill.loop-paused .loopplay .ic-pause{display:none}   /* playing → show ❚❚ (tap to pause) */
    .looppill.loop-paused{opacity:.82}
    .vwave .vhead{position:absolute;top:0;bottom:0;left:0;width:2px;margin-left:-1px;background:#eafaff;box-shadow:0 0 7px var(--sapphire),0 0 2px #fff;pointer-events:none;z-index:4;display:none;transition:opacity .15s}   /* #1 playback head — sweeps the waveform while the loop plays, freezes (dim) when paused */
    .io .looppill.show{display:inline-flex}
    .looppill .loopspark{width:22px;height:11px;flex:none}
    .looppill .loopspark path{fill:none;stroke:var(--sapphire);stroke-width:1.4;vector-effect:non-scaling-stroke;filter:drop-shadow(0 0 3px color-mix(in srgb,var(--sapphire) 55%,transparent))}
    .looppill .cv{font-style:normal;font-size:.72rem;line-height:1;color:#9fb0c1;transition:transform .2s}
    .looppill[aria-expanded="true"] .cv{transform:rotate(180deg);color:var(--sapphire)}
    .looppill[aria-expanded="true"]{box-shadow:inset 0 1.5px 0.5px rgba(255,255,255,.2),inset 0 -3px 5px rgba(0,0,0,.5),0 2px 0 #0a0d12,0 3px 5px rgba(0,0,0,.6),0 0 14px -4px var(--sapphire)}
    /* visually-hidden live region — announces the capture state to screen readers */
    .vstatus{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0}
    /* ── crop + tone popover: anchored to the bar (.io is position:relative), paints OVER the console
       (position:absolute → contributes 0 to height), mirrors the keypop pattern ── */
    .loopover{position:absolute;top:calc(100% + 10px);right:2px;z-index:50;display:none;width:min(560px,calc(100vw - 28px));
      padding:13px 15px 14px;border-radius:12px;background:linear-gradient(180deg,#121a24,#0a0f15);
      border:1px solid color-mix(in srgb,var(--sapphire) 24%,#000);
      box-shadow:0 18px 38px -10px rgba(0,0,0,.7),inset 0 1px 0 rgba(255,255,255,.06),0 0 18px -8px var(--sapphire)}
    .loopover.open{display:block;animation:loopoverIn .18s ease}
    @keyframes loopoverIn{from{opacity:0;transform:translateY(-5px)}to{opacity:1;transform:none}}
    .loopover::before{content:"";position:absolute;top:-7px;left:var(--caretX,78%);margin-left:-6px;width:12px;height:12px;rotate:45deg;
      background:#121a24;border-left:1px solid color-mix(in srgb,var(--sapphire) 24%,#000);border-top:1px solid color-mix(in srgb,var(--sapphire) 24%,#000)}   /* caret pointing up at the bar */
    .loopover .al{font-family:ui-monospace,Menlo,monospace;font-size:.54rem;letter-spacing:.16em;text-transform:uppercase;color:#9fb0c1;flex:none}
    .lo-head,.lo-tone,.lo-foot{display:flex;align-items:center;gap:9px}
    .lo-head{margin-bottom:9px}
    .lo-head .vlen{margin-left:auto;font-family:ui-monospace,Menlo,monospace;font-size:.62rem;letter-spacing:.13em;color:#bfe6f8;text-shadow:0 0 7px color-mix(in srgb,var(--sapphire) 55%,transparent)}
    .lo-tone,.lo-foot{margin-top:10px;flex-wrap:wrap}
    .loopover .vchip{height:28px;padding:0 11px;font-size:.55rem}
    .lo-tone .lo-depth{display:inline-flex;align-items:center;gap:7px;margin-left:auto}   /* #3: keep the "depth" label glued to its fader */
    .loopover .lo-int{flex:none;gap:4px;margin-right:6px;cursor:ns-resize}   /* INTENSITY knob — left of the effect toggles */
    .loopover .lo-int .dial{width:44px;height:44px}
    .loopover .lo-int .dial::before{inset:6px}
    .loopover .lo-int .dial .ptr::after{top:6px;height:9px}
    .loopover .lo-int .kl{font-size:.5rem;letter-spacing:.14em}
    .loopover .lo-gain{margin-left:auto;margin-right:0}   /* GAIN knob pushed to the right end, balancing INTENSITY on the left */
    .loopover .coverslide{margin-top:11px}   /* #3: COVER is a drag-bar beneath the knob+fx row, drum-cover style */
    .device.live #vintKnob .dial,.device.live #vgainKnob .dial{background:conic-gradient(from 225deg,var(--sapphire) 0 calc(var(--v,0)*270deg),#262c35 calc(var(--v,0)*270deg) 270deg,#0a0d12 270deg 360deg);box-shadow:0 0 9px -2px var(--sapphire),inset 0 0 0 1px rgba(0,0,0,.6),0 1px 2px rgba(0,0,0,.5)}
    .loopover .vctl{height:28px;padding:0 12px;font-size:.56rem;letter-spacing:.05em;gap:5px;text-transform:uppercase}
    /* the crop surface — 64px tall (the popover buys the vertical room a 48px bar can't give) */
    .loopover .vwave{position:relative;height:64px;border-radius:8px;overflow:hidden;touch-action:none;
      background:linear-gradient(180deg,#0a0f14,#070b10);box-shadow:inset 0 1px 3px rgba(0,0,0,.7),inset 0 0 0 1px rgba(0,0,0,.5)}
    .loopover .vwave>svg{position:absolute;inset:0;width:100%;height:100%;display:block}
    .loopover .vwpath{fill:color-mix(in srgb,var(--sapphire) 46%,transparent);stroke:none}
    .vticks{position:absolute;inset:0;pointer-events:none;z-index:1}
    .vticks i{position:absolute;top:0;bottom:0;width:1px;background:color-mix(in srgb,var(--sapphire) 18%,transparent)}
    .vticks i.bar{background:color-mix(in srgb,var(--sapphire) 36%,transparent)}
    .vticks i.flash{background:color-mix(in srgb,var(--sapphire) 85%,transparent);box-shadow:0 0 6px var(--sapphire);transition:background .05s,box-shadow .05s}
    .loopover .vmask{position:absolute;top:0;bottom:0;background:rgba(6,9,13,.72);pointer-events:none;z-index:2}
    .loopover .vmaskl{left:0}.loopover .vmaskr{right:0}
    .vbody{position:absolute;top:0;bottom:0;z-index:3;cursor:grab;touch-action:none}
    .vbody:active{cursor:grabbing}
    .loopover .vtrim{position:absolute;top:0;bottom:0;width:18px;margin-left:-9px;z-index:4;cursor:ew-resize;touch-action:none}
    .loopover .vtrim::before{content:"";position:absolute;top:0;bottom:0;left:8px;width:2px;background:var(--sapphire);box-shadow:0 0 6px var(--sapphire)}
    .loopover .vtrim::after{content:"";position:absolute;top:50%;left:3px;width:12px;height:22px;transform:translateY(-50%);border-radius:3px;background:linear-gradient(180deg,#cfd9e3,#8b95a2);box-shadow:0 1px 3px rgba(0,0,0,.6),inset 0 1px 0 rgba(255,255,255,.5)}
    @media (prefers-reduced-motion:reduce){.capnum.pop,.loopover.open,.io:has(.micin.arming) .miclight{animation:none}.vticks i.flash{transition:none}}
  
    /* HEIGHT REMODEL: 4-col x 2-row grid. RHYTHM moved to the rightmost column, spanning BOTH rows (full height). VOICE/SHAPE/EFFECTS sit in row 1 at their natural short height; the readout fills row 2 across the 3 left columns instead of adding its own full-height row below the console. Zones keep their DOM order — grid-area reorders them visually (grid-area overrides source order). */
    .console{display:grid;grid-template-columns:minmax(188px,1fr) minmax(360px,1.5fr) 202px 268px;grid-template-areas:"voice shape effects rhythm";gap:16px;padding-top:4px;align-items:stretch}
    .zone{display:flex;flex-direction:column}
    .zone.z-rhythm{grid-area:rhythm}
    .zone.z-voice{grid-area:voice}
    .zone.z-shape{grid-area:shape}
    .zone.z-effects{grid-area:effects}
    /* batch6 #1: fuse the VOICE matrix + LFO housing into ONE unit — pull the afz left to butt against the voice's right edge (eat the 16px grid gap, keep the gap to effects), square the afz, drop its left border so the voice's right border is the single shared seam line, and match the afz outline to the voice's sapphire border. */
    .console .z-shape .afz{box-sizing:border-box;margin-left:-16px;width:calc(100% + 16px);border-radius:0;border-left:none}
    .screen.pad{border-top-right-radius:0;border-bottom-right-radius:0}
    .device.live .z-shape .afz{border-color:color-mix(in srgb,var(--sapphire) 26%,rgba(155,167,187,.16))}
    /* the readout wrapper is now a grid item in row 2 (was a sibling below .console). Kept as .arpbar so every `.arpbar .readout` selector still matches. */
    .zbody{flex:1;display:flex;gap:12px}
  
    .command{flex:1;display:flex;flex-direction:column;gap:7px}
    /* drum + bass controls each grouped into a connected sub-module so it reads as one unit */
    /* the drum panel — now the only cmdgroup; fills the command zone + distributes its controls (dedicated drums module) */
    .cmdgroup{flex:1;display:flex;flex-direction:column;justify-content:flex-start;gap:8px;padding:9px 12px;border-radius:11px;background:radial-gradient(130% 120% at 50% 0%,#0c141e,#05080e 84%);border:1px solid rgba(255,255,255,.04);box-shadow:inset 0 0 0 1px rgba(0,0,0,.8),inset 0 2px 9px rgba(0,0,0,.58);transition:box-shadow .25s,border-color .25s}
    /* #2: when DRUMS are on, the WHOLE drum panel takes a subtle amber glow (BPM color), like the bass panel's green glow */
    .device.live .cmdgroup:has(#beat.on){border-color:color-mix(in srgb,var(--amber) 42%,#000);box-shadow:inset 0 1px 0 rgba(255,255,255,.05),inset 0 0 0 1px color-mix(in srgb,var(--amber) 30%,#000),inset 0 2px 9px rgba(0,0,0,.5),inset 0 0 18px -7px var(--amber)}
    .cmdgroup .coverslide{background:linear-gradient(180deg,#1b212b,#10141b);box-shadow:inset 0 1px 0 rgba(255,255,255,.05)}
    .tempo{flex:none;border-radius:13px;padding:7px 0;display:flex;flex-direction:column;align-items:center;justify-content:center;position:relative;cursor:ns-resize;touch-action:none;user-select:none;-webkit-user-select:none}
    /* the tempo is a glass screen too — dark until power, then a warm amber heartbeat glow within */
    .tempo::before{content:"";position:absolute;inset:0;z-index:6;pointer-events:none;border-radius:13px;background:radial-gradient(120% 78% at 50% -12%,rgba(255,255,255,.18),rgba(255,255,255,.05) 26%,transparent 52%)}
    .device.live .tempo,.tempo.wk{box-shadow:inset 0 0 0 1px rgba(255,176,74,.13),inset 0 3px 12px rgba(0,0,0,.72),inset 0 0 24px -9px color-mix(in srgb,var(--amber) 55%,transparent),inset 0 0 15px 5px rgba(0,0,0,.4)}
    .device.live .tempo::after,.tempo.bulb::after,.tempo.wk::after{background:repeating-linear-gradient(0deg,rgba(255,176,74,.06) 0 1px,transparent 1px 3px)}
    .tempo b{font-family:'Orbitron',ui-monospace,monospace;font-weight:500;font-size:2.05rem;line-height:1;letter-spacing:.04em;color:rgba(202,160,99,.1);-webkit-text-stroke:1.3px #caa063;text-shadow:0 0 8px rgba(202,160,99,.12)}
    .tempo small{position:absolute;right:9px;bottom:7px;font-family:'Orbitron',ui-monospace,monospace;font-weight:500;font-size:.42rem;letter-spacing:.22em;color:color-mix(in srgb,var(--amber) 62%,#6a5d40);text-shadow:0 0 5px color-mix(in srgb,var(--amber) 30%,transparent)}
    .tempo .pls{position:absolute;left:9px;top:9px;width:7px;height:4px;border-radius:1px;background:#2b2113;box-shadow:inset 0 0 0 1px rgba(0,0,0,.5);transition:background .14s,box-shadow .14s}
    .tempo .pls.beat{background:#ffc06a;box-shadow:0 0 5px rgba(255,178,74,.55),inset 0 0 0 1px rgba(255,210,150,.4)}
    /* BEAT & BASS are flat labeled strips, NOT giant buttons. The on/off lives in the round
       illuminated pushbutton (.pbtn) on the left; the strip is just a recessed holder. */
    .kick,.crow{display:flex;align-items:center;gap:13px;border:none;border-radius:9px;cursor:pointer;padding:6px 13px;user-select:none;
      background:linear-gradient(180deg,#1e2530,#161c25);
      box-shadow:inset 0 1px 0 rgba(255,255,255,.05),inset 0 0 0 1px rgba(0,0,0,.5),inset 0 -4px 7px rgba(0,0,0,.34);transition:box-shadow .22s}
    .kick.on,.crow.on{box-shadow:inset 0 1px 0 rgba(255,255,255,.05),inset 0 0 0 1px rgba(0,0,0,.5)}   /* #5: no toggle glow — the SPACE button gets a crisp orange border instead */
    .kick .kl{font-family:ui-monospace,Menlo,monospace;font-size:.64rem;letter-spacing:.16em;color:#9aa6b4}.kick.on .kl{color:#dff5e8}
    .crow .cl{font-family:ui-monospace,Menlo,monospace;font-size:.5rem;letter-spacing:.12em;color:#9aa6b4}.crow.on .cl{color:#dff5e8}
    /* #3 drop-control key hints — teach the SPACE/B shortcuts on the DRUMS + BASS toggles */
    .kick .kh,.crow .kh{margin-left:auto;display:inline-flex;align-items:center;justify-content:center;gap:11px;min-width:128px;font-family:ui-monospace,Menlo,monospace;font-weight:600;font-size:.68rem;letter-spacing:.2em;color:#9aa6b4;padding:7px 16px;border-radius:4px;background:radial-gradient(circle at 50% 32%,#222b35,#0e131a);border:1px solid rgba(0,0,0,.6);box-shadow:inset 0 1px 1px rgba(255,255,255,.05);transition:color .2s,background .2s,border-color .2s}
    .kick.on .kh,.crow.on .kh{color:var(--amber);border-color:color-mix(in srgb,var(--amber) 80%,#000)}   /* #5: drums ON → orange text + orange pause icon (currentColor) + non-glowing orange border */
    .kh .khico{width:19px;height:19px;flex:none;display:block}
    .kh .khico path,.kh .khico rect{fill:currentColor}
    .kh .ic-pause{display:none}
    .kick.on .kh .ic-play{display:none}
    .kick.on .kh .ic-pause{display:block}
    /* the on/off pushbutton: a real round cap. dark + recessed at rest, lit green core when engaged. */
    .pbtn{position:relative;width:22px;height:22px;border-radius:50%;flex:none;
      background:radial-gradient(circle at 50% 32%,#26313d,#0a0f15 76%);
      box-shadow:0 0 0 1.5px #0a0e14,inset 0 1.5px 1.5px rgba(255,255,255,.16),inset 0 -3px 5px rgba(0,0,0,.62),0 2px 3px rgba(0,0,0,.5);transition:box-shadow .16s,transform .08s}
    .pbtn::after{content:"";position:absolute;inset:5px;border-radius:50%;background:radial-gradient(circle at 50% 36%,#2b3a48,#10171f);box-shadow:inset 0 1px 1px rgba(255,255,255,.12),inset 0 -1px 2px rgba(0,0,0,.5);transition:background .18s,box-shadow .18s}
    .kick:active .pbtn,.crow:active .pbtn{transform:translateY(1.5px)}
    .kick.on .pbtn,.crow.on .pbtn{box-shadow:0 0 0 1.5px color-mix(in srgb,var(--amber) 48%,#000),inset 0 1px 1px rgba(255,255,255,.1),inset 0 -2px 4px rgba(0,0,0,.5),0 2px 3px rgba(0,0,0,.5),0 0 13px -2px var(--amber)}
    .kick.on .pbtn::after,.crow.on .pbtn::after{background:radial-gradient(circle at 50% 36%,#ffe2b0,#d98c2a 72%);box-shadow:inset 0 0 5px rgba(40,24,0,.45),0 0 7px rgba(217,140,42,.7)}
    .kick.hit .pbtn::after{background:radial-gradient(circle at 50% 36%,#fff2d8,#ffb84d 72%);box-shadow:inset 0 0 5px rgba(40,24,0,.4),0 0 16px 2px var(--amber)}
    /* DRUMS button redesign (2026-06-18): the whole #beat strip is one bold orange bar — DRUMS label sits dark/inset on the left, the ▶/❚❚ + SPACE shortcut bright on the right; reads as a single "press space to play" control. ON adds the lit pbtn + pause icon + the panel amber glow (.cmdgroup:has(#beat.on)). Scoped to #beat so the bass .basskick strip is untouched. */
    .device.live #beat{background:linear-gradient(180deg,#f3934d,#dd6420 58%,#bd4f15);box-shadow:inset 0 1px 1px rgba(255,224,198,.42),inset 0 -3px 7px rgba(120,42,0,.42),0 1px 3px rgba(0,0,0,.5)}
    .device.live #beat .kl{color:#3c1805!important;text-shadow:0 1px 0 rgba(255,206,160,.4)}
    .device.live #beat .kh{margin-left:auto;min-width:auto;padding:0;background:none!important;border:none!important;box-shadow:none!important;color:#fff7f0!important}
    .device.live #beat.on{background:linear-gradient(180deg,#ffab63,#ec7024 56%,#cb550f)}
    .device.live #beat.on .kl{color:#2a1003!important}
    .patseg{--acc:var(--sapphire)}
    .patseg b{font-size:.5rem;letter-spacing:.04em;padding:5px 0}
  
    .coverslide{display:flex;flex-direction:column;gap:4px;border-radius:9px;padding:6px 12px;background:linear-gradient(180deg,#222934,#12161d);border:1px solid rgba(0,0,0,.55);box-shadow:inset 0 1px 0 rgba(255,255,255,.07)}
    .coverslide .ct{display:flex;justify-content:space-between;font-family:ui-monospace,Menlo,monospace;font-size:.5rem;letter-spacing:.1em;color:#9aa6b4}.coverslide .ct .cvv{color:#dbe6f0}
    .strack{position:relative;height:16px;border-radius:8px;cursor:ew-resize;touch-action:none;background:linear-gradient(180deg,#0a0f14,#070b10);box-shadow:inset 0 1px 3px rgba(0,0,0,.7),inset 0 0 0 1px rgba(0,0,0,.5)}
    /* slider fill = horizontal segmented LCD light-up (same law as the .fillcard meter),
       NOT a smooth web gradient. lit vertical segments in the track accent (--sf,
       sapphire default), inset off the slot edge, with a bright leading edge. */
    .strack{--sf:var(--sapphire)}
    .strack .sfill{position:absolute;left:2px;top:2px;bottom:2px;border-radius:6px 2px 2px 6px;z-index:1;
      background:repeating-linear-gradient(90deg,var(--sf) 0 3px,color-mix(in srgb,var(--sf) 12%,transparent) 3px 5px);
      box-shadow:0 0 8px -1px var(--sf),inset 0 0 0 1px color-mix(in srgb,var(--sf) 28%,transparent)}
    .strack .sfill::after{content:"";position:absolute;right:0;top:0;bottom:0;width:2px;border-radius:1px;background:color-mix(in srgb,var(--sf) 80%,#fff);box-shadow:0 0 6px var(--sf)}
    /* #2: BASS is its own green-accented module, to the RIGHT of the readout (out of the drums panel) */
    /* BASS — a GROOVE-engine sibling of the DRUMS: its own .cmdgroup in the rhythm column, reusing .kick (header) + .drumfx (knob row) so it inherits the 40px knob sizing + dark-until-power. Violet (--bass) accent overrides below. */
    .bassgroup{--bass:#3914c0;flex:none}
    .device.live .cmdgroup.bassgroup:has(#bassrow.on){border-color:color-mix(in srgb,#7a4fe0 58%,#000);box-shadow:inset 0 1px 0 rgba(255,255,255,.06),inset 0 0 0 1px color-mix(in srgb,#7a4fe0 44%,#000),inset 0 2px 9px rgba(0,0,0,.5),inset 0 0 22px -6px #7a4fe0}
    /* the B keycap mirrors the drums SPACE keycap but compact ("B", no transport icon); violet on-state */
    .kh-b{min-width:46px!important;letter-spacing:.04em}
    .basskick .bl{font-family:ui-monospace,Menlo,monospace;font-size:.56rem;letter-spacing:.18em;color:#9aa6b4;transition:color .2s}   /* batch6 #4: BASS label replaces the on/off dot left of B */
    .basskick.on .bl{color:#d9ccff;text-shadow:0 0 8px color-mix(in srgb,#7a4fe0 55%,transparent)}
    .basskick.on .kl{color:#ece6ff;text-shadow:0 0 8px color-mix(in srgb,#7a4fe0 60%,transparent)}
    .basskick.on .kh{color:#fff;background:linear-gradient(180deg,#9a7bff,#5a2bf0 55%,#3a14b0);border-color:#b7a0ff;box-shadow:inset 0 1px 1px rgba(255,255,255,.4),inset 0 -2px 5px rgba(20,8,60,.5),0 0 16px -2px #7a4fe0,0 0 5px rgba(154,123,255,.85)}
    .basskick.on .pbtn{box-shadow:0 0 0 1.5px #8b6bff,inset 0 1px 1px rgba(255,255,255,.25),inset 0 -2px 4px rgba(0,0,0,.5),0 2px 3px rgba(0,0,0,.5),0 0 16px -1px #6a3fe0}
    .basskick.on .pbtn::after{background:radial-gradient(circle at 50% 36%,#e3d8ff,#8b5fff 72%);box-shadow:inset 0 0 5px rgba(20,8,50,.45),0 0 10px rgba(138,107,255,.9)}
    /* bass knobs: 40px dial + .5rem labels inherited from .drumfx (matching DRUMS); only the violet value-arc fill is bass-specific */
    .device.live #bcharKnob .dial,.device.live #bweightKnob .dial,.device.live #bglideKnob .dial,.device.live #bpluckKnob .dial{background:conic-gradient(from 225deg,var(--bass) 0 calc(var(--v,0)*270deg),#262c35 calc(var(--v,0)*270deg) 270deg,#0a0d12 270deg 360deg);box-shadow:0 0 8px -2px var(--bass),inset 0 0 0 1px rgba(0,0,0,.6),0 1px 2px rgba(0,0,0,.5)}
    /* (the old PLUCK pill + Power-tab .basskey CSS removed — bass now reuses .kick/.drumfx; pluck parked via PLUCK_ENABLED in the UI script) */
    #scslide{--sf:var(--pink)}
    .drumfx{display:flex;justify-content:space-between;align-items:flex-start;gap:8px;padding:6px 14px 2px}
    /* item 6: SWING / DENSITY / GRIT enlarged for legibility — scoped to the drum panel so the shared .knob.sm (bass + arp) is untouched. dial back up to full size, sub-titles bigger. */
    .drumfx .knob{gap:5px}
    .drumfx .knob.sm .dial{width:40px;height:40px}
    .drumfx .knob.sm .dial::before{inset:5px}
    .drumfx .knob.sm .dial .ptr::after{top:5px;height:8px}
    .drumfx .knob .kl{font-size:.5rem;letter-spacing:.12em;margin-top:1px}
    .drumfx .kn{min-width:26px;text-align:center}
    .device:not(.live) .drumfx .kn{color:#3f4751}
    .strack .shandle{position:absolute;top:50%;width:11px;height:22px;border-radius:4px;transform:translate(-50%,-50%);background:linear-gradient(180deg,#cfd9e3,#8b95a2);box-shadow:0 1px 3px rgba(0,0,0,.6),inset 0 1px 0 rgba(255,255,255,.5);z-index:2}
  
    /* the VOICE matrix is ONE glass screen: a readout band across the top + the morph field below */
    .pad{flex:1;min-height:300px;display:flex;flex-direction:column;border:1px solid rgba(160,172,190,.17);box-shadow:inset 0 0 0 1px rgba(0,0,0,.7),inset 0 2px 10px rgba(0,0,0,.6),inset 0 -1px 0 rgba(255,255,255,.03),0 1px 0 rgba(255,255,255,.05),0 2px 6px rgba(0,0,0,.42)}
    /* #2: the voice readout is a small dark chip CENTERED in the field (was a top band) — the matrix grid now fills full height */
    .padband{position:absolute;left:50%;top:50%;z-index:3;transform:translate(-50%,-50%);display:flex;align-items:center;justify-content:center;padding:5px 15px;border-radius:4px;background:radial-gradient(130% 130% at 50% 0%,rgba(8,14,22,.92),rgba(4,6,11,.8));box-shadow:inset 0 0 0 1px rgba(0,0,0,.6),0 2px 9px rgba(0,0,0,.55);pointer-events:none}
    .padband::after{content:"";position:absolute;inset:0;border-radius:4px;pointer-events:none;opacity:0;background:repeating-linear-gradient(0deg,rgba(120,200,240,.06) 0 1px,transparent 1px 2px);transition:opacity .5s}
    .device.live .padband::after{opacity:1}
    .padband .pnl{font-family:ui-monospace,Menlo,monospace;font-size:.4rem;letter-spacing:.26em;color:#52606f}
    .padband b{position:relative;z-index:1;font-family:ui-monospace,Menlo,monospace;font-size:.8rem;letter-spacing:.2em;color:#bfe6f8;text-shadow:0 0 8px color-mix(in srgb,var(--sapphire) 70%,transparent);opacity:0;transition:opacity .55s ease}
    .device.live .padband b{opacity:1}
    .padfield{flex:1;position:relative;cursor:crosshair;touch-action:none}
    .pad .grid{position:absolute;inset:0;background-image:linear-gradient(color-mix(in srgb,var(--sapphire) 5%,transparent) 1px,transparent 1px),linear-gradient(90deg,color-mix(in srgb,var(--sapphire) 5%,transparent) 1px,transparent 1px);background-size:30px 30px;z-index:1;pointer-events:none;transition:opacity .5s ease}
    .pad .cross{position:absolute;inset:0;z-index:1;pointer-events:none}
    .pad .cross::before,.pad .cross::after{content:"";position:absolute;background:rgba(120,170,210,.09)}
    .pad .cross::before{left:50%;top:0;bottom:0;width:1px}.pad .cross::after{top:50%;left:0;right:0;height:1px}
    .pad .puck{position:absolute;width:15px;height:15px;border-radius:50%;transform:translate(-50%,-50%);z-index:4;pointer-events:none;background:radial-gradient(circle at 38% 30%,#fff,var(--pc,#0ec4fc) 66%,color-mix(in srgb,var(--pc,#0ec4fc) 50%,#000));box-shadow:0 0 14px 3px var(--pc,#0ec4fc),inset 0 1px 1px rgba(255,255,255,.6),0 2px 4px rgba(0,0,0,.5);transition:box-shadow .1s}
    .pad .puck::after{content:"";position:absolute;left:50%;top:50%;width:27px;height:27px;border-radius:50%;transform:translate(-50%,-50%);border:1px solid color-mix(in srgb,var(--pc,#0ec4fc) 30%,transparent)}
    .padfield.flash .puck{box-shadow:0 0 30px 7px var(--pc,#0ec4fc),inset 0 1px 1px rgba(255,255,255,.6),0 2px 4px rgba(0,0,0,.5)}
    .pad .lm{position:absolute;transform:translate(-50%,-50%);font-family:ui-monospace,Menlo,monospace;font-size:.42rem;letter-spacing:.05em;color:#5d7693;text-align:center;white-space:nowrap;z-index:2;pointer-events:none;transition:color .14s}
    .pad .lm.near{color:#cfe6f5}
    .pad .lm b{display:block;width:5px;height:5px;border-radius:50%;background:#3c5573;margin:0 auto;transition:.14s}.pad .lm.near b{background:var(--pc);box-shadow:0 0 6px var(--pc)}
    .ax{position:absolute;font-family:ui-monospace,Menlo,monospace;font-size:.5rem;letter-spacing:.16em;color:#54748f;z-index:2;pointer-events:none}
    .ax.l{left:7px;top:50%;writing-mode:vertical-rl;transform:translateY(-50%) rotate(180deg)}
    .ax.r{right:7px;top:50%;writing-mode:vertical-rl;transform:translateY(-50%)}
    .ax.b{bottom:6px;left:50%;transform:translateX(-50%)}.ax.t{top:6px;left:50%;transform:translateX(-50%)}
  
    /* AUTO-FILTER — wide short screen, the node IS the cursor */
    /* #2: one encased module — the filter screen + LFO deck share a single recessed housing (mirrors the COMMAND module's frame) */
    .afz{position:relative;overflow:hidden;flex-direction:column;gap:7px;padding:9px;border-radius:12px;background:radial-gradient(130% 120% at 50% 0%,#0c141e,#05080e 84%);border:1px solid rgba(255,255,255,.04);box-shadow:inset 0 0 0 1px rgba(0,0,0,.8),inset 0 2px 9px rgba(0,0,0,.58)}   /* #B: position:relative so the startup border-trace overlay anchors to the LFO module's OUTER edge */
    .afilter{flex:1;min-height:80px;border-radius:7px;position:relative;cursor:ew-resize;touch-action:none;overflow:hidden}
    .afilter svg{position:absolute;inset:0;width:100%;height:100%}
    .afglabels{position:absolute;left:0;right:0;bottom:3px;height:0;z-index:2;pointer-events:none}
    .afglabels span{position:absolute;bottom:0;transform:translateX(3px);font-family:ui-monospace,Menlo,monospace;font-size:9px;letter-spacing:.02em;color:#4f6f8c}
    .afcurve path{fill:none;stroke:var(--curve);stroke-width:2;filter:drop-shadow(0 0 5px color-mix(in srgb,var(--curve) 70%,transparent));stroke-linejoin:round}
    .afcurve .fillpath{fill:color-mix(in srgb,var(--curve) 10%,transparent);stroke:none;filter:none}
    /* the LFO's ghost: stroke-only, amber, opacity rides the MOTION dial — the base curve stays still.
       Drawn ONLY where it diverges from the base, never past the base curve's right footprint. */
    .afcurve .ghost{stroke:var(--sapphire);stroke-width:1.6;opacity:0;filter:drop-shadow(0 0 4px color-mix(in srgb,var(--sapphire) 50%,transparent)) drop-shadow(0 0 10px color-mix(in srgb,var(--sapphire) 30%,transparent))}
    .afnode{position:absolute;width:20px;height:20px;border-radius:50%;transform:translate(-50%,-50%);z-index:5;border:2.5px solid var(--amber);background:radial-gradient(circle at 40% 35%,rgba(255,200,120,.55),rgba(20,12,4,.4) 70%);box-shadow:0 0 14px -1px var(--amber);cursor:grab;touch-action:none}
    .afnode::before{content:"";position:absolute;inset:-12px;border-radius:50%}
    .afnode:active{cursor:grabbing;box-shadow:0 0 20px 1px var(--amber)}
    .afhint{position:absolute;left:9px;top:7px;z-index:4;font-family:ui-monospace,Menlo,monospace;font-size:.5rem;letter-spacing:.12em;color:#637b97;pointer-events:none}
    /* dormant cue: only while LIVE and MOTION is at 0 — teaches that MOTION drives the sweep, then vanishes on first turn */
    .mohint{position:absolute;left:0;right:0;bottom:15px;z-index:4;text-align:center;font-family:ui-monospace,Menlo,monospace;font-size:.5rem;letter-spacing:.12em;color:#ffce8a;text-shadow:0 0 8px color-mix(in srgb,var(--amber) 55%,transparent);opacity:0;transition:opacity .45s ease;pointer-events:none}
    .device.live .afilter.still .mohint{opacity:.9}
  
    /* LFO deck (under the screen): a clean full-width 3-column spread — MOTION knob · 4 waveform keycaps · RATE knob (scope removed) */
    .lfostrip{flex:none;display:flex;align-items:center;justify-content:space-between;gap:18px;padding:8px 22px;border-radius:8px;background:linear-gradient(180deg,rgba(0,0,0,.26),rgba(0,0,0,.1));border:1px solid rgba(255,255,255,.03);box-shadow:inset 0 1px 4px rgba(0,0,0,.5)}   /* the control deck — lighter sub-panel seated INSIDE the .afz housing, not its own competing frame */
    .shapegrid{flex:none;display:grid;grid-template-columns:1fr;gap:5px;width:44px}   /* item 2: waveform keycaps shrunk noticeably (was width:64px / gap:7px) */
    .shapegrid .hw{height:22px}   /* item 2: was 30px */
    .shapegrid .hw.on{--acc:var(--amber)}
  
    /* performance pads */
    .gestbar{display:flex;align-items:center;gap:10px;padding:9px 14px;border-radius:11px;background:linear-gradient(180deg,#10151c,#0a0d12);border:1px solid rgba(0,0,0,.6);box-shadow:inset 0 1px 0 rgba(255,255,255,.05),inset 0 2px 6px rgba(0,0,0,.5)}
    .gestbar .gl{font-family:ui-monospace,Menlo,monospace;font-size:.5rem;letter-spacing:.18em;text-transform:uppercase;color:#7d8a99;margin-right:4px}
    /* GATE group: three rate keycaps (Z/X/C) share DIVE's flex weight, with a single label under them */
    .gestbar .gategroup{flex:4;display:flex;align-items:center;gap:6px;position:relative}
    .gestbar .gategroup .gpad{flex:1}
    .gestbar .gategroup .ggl{font-family:ui-monospace,Menlo,monospace;font-size:.5rem;letter-spacing:.18em;text-transform:uppercase;color:#7d8a99;margin-right:6px;flex:none}   /* #5: GATE labels the Z/X/C group it now precedes (no longer reads as DIVE's label) */
    .gestbar>.gpad.dive{flex:none;min-width:104px;margin-left:6px}   /* #5: DIVE clearly separate from the GATE group */
    .gestbar .gategroup .gpad b{font-size:.58rem}
    .gpad{flex:1;display:flex;align-items:center;justify-content:center;gap:9px;height:36px;border:none;border-radius:9px;cursor:pointer;user-select:none;touch-action:none;
      font-family:ui-monospace,Menlo,monospace;font-size:.62rem;letter-spacing:.1em;color:#b3bdc9;
      background:linear-gradient(180deg,#464e5c 0%,#2c333f 47%,#1f2630 100%);
      border-top:1px solid rgba(255,255,255,.13);
      box-shadow:inset 0 1.5px 0.5px rgba(255,255,255,.24),inset 0 -5px 7px rgba(0,0,0,.5),0 4px 0 #0a0d12,0 6px 9px rgba(0,0,0,.55);transition:transform .07s,box-shadow .12s,color .12s}
    .gpad b{width:20px;height:20px;border-radius:5px;display:flex;align-items:center;justify-content:center;font-size:.62rem;color:#8fa0b2;background:radial-gradient(circle at 50% 32%,#222b35,#0e131a);border:1px solid rgba(0,0,0,.6)}
    .gpad:active{transform:translateY(2px)}
    .gpad.on{transform:translateY(3px);color:#fff;border-top-color:rgba(255,176,74,.2);
      background:linear-gradient(180deg,#2d343f,#1a212b);
      box-shadow:inset 0 2px 5px rgba(0,0,0,.6),inset 0 0 13px -4px var(--amber),0 1px 0 #0a0d12,0 2px 3px rgba(0,0,0,.55)}
    .gpad.on b{color:#ffd9ad;box-shadow:0 0 8px -2px var(--amber)}
  
    /* LED grammar + key light spill + standby breathing */
    .led{display:inline-block;width:5px;height:5px;border-radius:50%;background:#28323d;vertical-align:middle;transition:background .07s,box-shadow .07s,transform .07s}
    .led.blip{background:var(--green);box-shadow:0 0 7px var(--green);transform:scale(1.5)}
    .spill{position:absolute;bottom:0;width:240px;height:110px;left:-120px;border-radius:50%;pointer-events:none;z-index:0;opacity:0;
      background:radial-gradient(closest-side,color-mix(in srgb,var(--sapphire) 14%,transparent),transparent 72%);
      transition:opacity .4s ease-out;will-change:transform}
    .spill.on{opacity:.65;transition:opacity .07s ease-in}
    /* the standby breathe + first-view flare live on an OPACITY-ONLY halo (::after) —
       animating box-shadow repaints a large region every frame and janks the scroll. */
    .pwr::after{content:"";position:absolute;inset:-12px;border-radius:50%;pointer-events:none;opacity:0;
      background:radial-gradient(circle,color-mix(in srgb,var(--red) 30%,transparent),transparent 70%);will-change:opacity}
    &.inview .device:not(.live) .pwr::after{animation:sgmbreathe 4.2s ease-in-out infinite}
    .pwr.flare::after{animation:sgmflareo .9s ease-out 1}
    .knob{display:flex;flex-direction:column;align-items:center;gap:3px;cursor:ns-resize;touch-action:none;user-select:none}
    .dial{width:38px;height:38px;border-radius:50%;position:relative;background:conic-gradient(from 225deg, var(--amber) 0 calc(var(--v,0)*270deg), #262c35 calc(var(--v,0)*270deg) 270deg, #0a0d12 270deg 360deg);box-shadow:inset 0 0 0 1px rgba(0,0,0,.6),0 1px 2px rgba(0,0,0,.5)}
    .dial::before{content:"";position:absolute;inset:5px;border-radius:50%;background:radial-gradient(circle at 50% 32%,#2c333e,#11151d);box-shadow:inset 0 1px 0 rgba(255,255,255,.12),0 1px 2px rgba(0,0,0,.6)}
    .dial .ptr{position:absolute;inset:0;transform:rotate(calc(-135deg + var(--v,0)*270deg))}
    .dial .ptr::after{content:"";position:absolute;left:50%;top:5px;width:2px;height:8px;margin-left:-1px;border-radius:1px;background:#e7edf3;box-shadow:0 0 3px var(--amber)}
    .knob.sm .dial{width:30px;height:30px}
    .knob.sm .dial::before{inset:4px}
    .knob.sm .dial .ptr::after{top:4px;height:6px}
    .knob .kl{font-family:ui-monospace,Menlo,monospace;font-size:.5rem;letter-spacing:.1em;color:#8593a2}
    .knob .kn{font-family:ui-monospace,Menlo,monospace;font-size:.52rem;color:#dbe6f0}
    /* #5: LFO knobs (MOTION + RATE) fill with the default steel UI color + no amber glow — de-emphasized to read as standard controls (the scope beside them still shows the live sweep) */
    .device.live #rateKnob .dial{background:conic-gradient(from 225deg,#48515f 0 calc(var(--v,0)*270deg),#262c35 calc(var(--v,0)*270deg) 270deg,#0a0d12 270deg 360deg)}
    /* #8 MOTION: the meter FILL is amber, and its brightness PULSES inside the arc (glowA = depth, pulseA = live sweep) — not a glow bleeding outside the dial */
    .device.live #amtKnob .dial{background:conic-gradient(from 225deg,color-mix(in srgb,var(--amber) calc(11% + var(--glowA,0)*13% + var(--pulseA,0)*56%),#140d04) 0 calc(var(--v,0)*270deg),#262c35 calc(var(--v,0)*270deg) 270deg,#0a0d12 270deg 360deg)}   /* batch3 #3: DARK low (≈11% at rest/silence) → throbs up to a TAMED peak (~80%) only when notes play (pulseA is note-gated in lfoFrame) */
    #amtKnob .dial{box-shadow:inset 0 0 0 1px rgba(0,0,0,.6),0 1px 2px rgba(0,0,0,.5)}
    /* MOTION restore: the dial is the LFO heartbeat — it stays LIT while MOTION>0 (glow scales with --glowA, the depth, written by motionReadout) and BREATHES with the live sweep (--pulseA, written every frame by lfoFrame; reset to 0 by stopLfoAnim). Both vars are 0 at OFF, so every glow length collapses to 0px and the knob falls back to the plain inset shadow above — steel-at-zero + the conic steel fill (line above) are untouched. amber = the established LFO/motion accent. The per-frame --pulseA is intentionally un-eased so the breath tracks the sweep; only depth/standby changes ease. */
    .device.live #amtKnob .dial{box-shadow:inset 0 0 calc(var(--glowA,0)*2px + var(--pulseA,0)*15px) color-mix(in srgb,var(--amber) 58%,transparent),inset 0 0 0 1px rgba(0,0,0,.6),0 1px 2px rgba(0,0,0,.5)}   /* batch3 #3: inner glow throbs with the note-gated sweep, peak tamed (15px) */
    #amtKnob .kn{color:#8593a2}
    /* readout chip lights amber as MOTION rises (grey at OFF where --glowA=0; the base rule above stays the unlit/standby floor) */
    .device.live #amtKnob .kn{color:#ffc27a;text-shadow:0 0 7px color-mix(in srgb,var(--amber) 45%,transparent)}
    /* LFO redesign: the MOTION + RATE knobs grow now that the scope's space is freed — bigger dial fills the spread deck */
    #amtKnob .dial,#rateKnob .dial{width:52px;height:52px}
    #amtKnob .dial::before,#rateKnob .dial::before{inset:7px}
    #amtKnob .dial .ptr::after,#rateKnob .dial .ptr::after{top:6px;height:11px}
    /* RATE readout = a tiny lit amber LCD digit chip: recessed dark glass, faint pixel
       grid, glowing amber 7-seg-style numerals. dark/unlit until power. */
    .lfostrip .knob .kn{position:relative;margin-top:3px;padding:5px 12px;border-radius:6px;letter-spacing:.06em;width:104px;box-sizing:border-box;white-space:nowrap;text-align:center;font-size:1.08rem;line-height:1;color:#5a5040;
      cursor:pointer;}   /* #rateNum doubles as the SYNC/FREQ toggle — tap to flip; the sapphire underline marks it tappable */
    /* batch4 #2: the SYNC/FREQ toggle hint is now an always-on amber dot on the right edge (was an ugly sapphire underline); brighter in Hz mode */
    .device.live #rateNum::after{content:"";position:absolute;left:7px;top:50%;transform:translateY(-50%);width:5px;height:5px;border-radius:50%;background:var(--amber);box-shadow:0 0 6px color-mix(in srgb,var(--amber) 80%,transparent);opacity:.85;transition:opacity .25s,box-shadow .25s,left .3s ease}   /* batch7 #1: dot sits LEFT in sync/rate mode … */
    .device.live #rateNum.hz::after{left:calc(100% - 12px);opacity:1;box-shadow:0 0 9px var(--amber),0 0 3px #ffd9ad}   /* … and slides to the RIGHT in freq/Hz mode, so the toggle visibly alternates */
    .lfostrip .knob .kn._x{
      background:radial-gradient(120% 120% at 50% 0%,#140d05,#0a0703 85%);
      box-shadow:inset 0 0 0 1px rgba(0,0,0,.8),inset 0 1px 3px rgba(0,0,0,.7);transition:color .4s,text-shadow .4s,background .4s}
    .lfostrip .knob .kn::before{content:"";position:absolute;inset:0;border-radius:6px;pointer-events:none;opacity:0;transition:opacity .5s;background:repeating-linear-gradient(0deg,rgba(0,0,0,.22) 0 1px,transparent 1px 3px)}
    .device.live .lfostrip .knob .kn{color:#ffcf8f;text-shadow:0 0 6px color-mix(in srgb,var(--amber) 75%,transparent);background:radial-gradient(120% 120% at 50% 0%,#241606,#150c03 85%)}
    .device.live .lfostrip .knob .kn::before{opacity:1}
    .shaperow{display:flex;gap:5px}
    .shaperow .hw{flex:1;height:26px}
  
    .efx{flex:1;display:flex;flex-direction:column;gap:9px}
    .fills{display:flex;gap:9px;flex:1}
    /* low-grade LCD meter: dark off, murky-green backlight when live, segmented dark ink fill.
       casing NEVER glows — no outer bloom; the only "light" is the inset murky backlight. */
    .fillcard{position:relative;flex:1;border-radius:6px;overflow:hidden;cursor:ns-resize;touch-action:none;background:#0b0e0a;box-shadow:inset 0 0 0 1px rgba(0,0,0,.8),inset 0 2px 6px rgba(0,0,0,.6);transition:background .45s ease}
    .device.live .fillcard,.efx.wk .fillcard{background:linear-gradient(180deg,#1a221a,#0f140e)}
    /* faint pixel-grid — off until power */
    .fillcard::before{content:"";position:absolute;inset:0;z-index:3;pointer-events:none;opacity:0;transition:opacity .6s;background:repeating-linear-gradient(0deg,rgba(0,0,0,.16) 0 1px,transparent 1px 3px),repeating-linear-gradient(90deg,rgba(0,0,0,.1) 0 1px,transparent 1px 3px)}
    .device.live .fillcard::before,.efx.wk .fillcard::before{opacity:1}
    /* the level — dark segmented LCD ink, inset off the panel edge, no outer glow */
    .fillcard .fill{position:absolute;left:4px;right:4px;bottom:4px;height:0%;max-height:calc(100% - 30px);z-index:1;border-radius:1px;background:repeating-linear-gradient(0deg,#54df93 0 3px,rgba(84,223,147,.12) 3px 5px);box-shadow:0 0 8px rgba(84,223,147,.45);transition:height .04s linear}   /* #9: cap the fill just below the effect NAME label (top:7px) so a full meter never reaches the text */
    .fillcard.dragging .fill{transition:none}   /* the transition fights live pointermove updates — the bar rubber-bands behind the pointer */
    .fillcard .fill::before{content:"";position:absolute;left:0;right:0;top:0;height:2px;background:#9affc4;box-shadow:0 0 6px rgba(84,223,147,.7)}
    .fillcard .fill.mt{background:none;box-shadow:none}   /* a blank LCD — no ink */
    .fillcard .fill.mt::before{opacity:0}
    /* the DELAY ink reads its segment pitch from the division (1/4 coarse → 1/16 fine) — still monochrome LCD */
    .fillcard[data-key="delay"] .fill{background-image:repeating-linear-gradient(0deg,#54df93 0 calc(var(--seg,10px) - 2px),rgba(84,223,147,.12) calc(var(--seg,10px) - 2px) var(--seg,10px))}
    /* labels are dark LCD ink — invisible until the backlight is on */
    .fillcard .fl{position:absolute;left:0;right:0;top:7px;text-align:center;z-index:2;font-family:ui-monospace,Menlo,monospace;font-size:.52rem;font-weight:600;letter-spacing:.14em;color:#bafdd0;text-shadow:0 0 6px rgba(84,223,147,.75);pointer-events:none;opacity:0;transition:opacity .6s}   /* the glowing LCD readout is now the effect NAME, not the value */
    .device.live .fillcard .fl,.efx.wk .fillcard .fl{opacity:1}
    .fillcard .pc{display:none}   /* numeric value dropped — JS still sets its text, harmlessly hidden */
    .drate{display:flex;align-items:center;gap:8px}.drate .dl{font-family:ui-monospace,Menlo,monospace;font-size:.44rem;letter-spacing:.12em;text-transform:uppercase;color:#7d8a99;white-space:nowrap}.drate .seg{flex:1}
    .drate .seg b{font-size:.6rem;padding:8px 0;letter-spacing:0}
    /* effects = four vertical channel strips: a tall meter fader + that effect's controls beneath it */
    .efx .fills{display:flex;gap:8px;align-items:stretch;flex:1}
    .fxstrip{flex:1;min-width:0;display:flex;flex-direction:column;gap:7px}
    .fxstrip .fillcard{min-height:210px}
    .coachband{display:flex;align-items:stretch;gap:14px;margin-top:15px}   /* #2: more separation from the console (effects) above */
    .coachband .bassgroup{flex:none;width:432px;flex-direction:row;align-items:center;justify-content:space-between;gap:12px;padding:8px 16px}   /* #1: wider so the BASS label + B + 4 knobs fit with margin (readout shrinks to fit) */
    .coachband .bassgroup .basskick{flex:none;padding:2px 4px;gap:11px;background:none;box-shadow:none;border:none}   /* #2: drop the inner bezel — dot + BASS + B read as loose elements on the module */
    .coachband .bassgroup .kh-b{min-width:56px!important;padding:13px 24px;font-size:.78rem;border-radius:9px}   /* batch6 #5: wider B keycap */
    .coachband .bassgroup .knobdiv{flex:none;width:1px;align-self:stretch;margin:7px 1px;background:linear-gradient(180deg,transparent,rgba(255,255,255,.13),transparent)}   /* #3: hairline divider between SUB and GLIDE */
    .coachband .bassgroup .drumfx{flex:1;padding:0;gap:8px}   /* #1: fill the wider module so B…PLUCK spread (space-between), not left-packed */
    .coachband .arpbar{flex:1;min-width:0}
    .fxsub{flex:none;height:104px;display:flex;flex-direction:column;justify-content:flex-start}   /* batch6 #2: tall enough to hold all 4 sub-buttons so their bottom sits on the voice/LFO bottom line (was 92 → buttons overflowed 13px below); the meter above shortens to compensate */
    .modknobs{display:flex;flex-direction:column;align-items:center;gap:10px;padding-top:3px}
    .modknobs .knob .dial{width:26px;height:26px}
    .modknobs .knob .kl{font-size:.4rem;letter-spacing:.07em}
    .seg.vseg{flex-direction:column;gap:3px}
    .seg.vseg b{flex:none;width:100%;padding:5px 0;font-size:.5rem;letter-spacing:.03em}
  
    /* ARP strip — prominent */
    /* #4: arpeggiator = its own module, magenta/purple accent (--arp); the readout beside it stays its own sapphire screen */
    /* #A: bare row — the arp module + the readout are each their OWN panel */
    .arpbar{display:flex;justify-content:flex-start;align-items:stretch;gap:14px}   /* readout (left) + bass module (right) */
    /* #5: arp module in the pianohead — DE-FRAMED so OFF/LATCH/Rate/LENGTH read as loose buttons that belong to the keyboard bar (no panel bg/border/glow); default (sapphire) accent so it matches the MAJOR/MINOR seg */
    .arpmod{display:flex;align-items:center;gap:15px;padding:6px 0;transition:opacity .2s}
    .pianohead .arpmod{margin-left:auto}   /* push it to the right end of the keyboard control bar */
    #lenKnob .dial,#arpRateKnob .dial{width:40px;height:40px}
    #arpRateNum{display:none}   /* #4.1: drop the RATE readout so RATE + LENGTH knobs are symmetrical (JS still sets it, harmlessly hidden) */
    #arpBtn{min-width:46px}   /* #4.2: fix width so OFF/ON never resize the button */
    #lenKnob .kl,#arpRateKnob .kl{font-size:.5rem;letter-spacing:.12em}
    /* arp RATE: in-label division readout — small steel LCD chip under the dial (matches the LENGTH/RATE knob family, no separate seg) */
    #arpRateKnob .kn{font-size:.52rem;letter-spacing:.06em}
    .device.live #lenKnob .dial,.device.live #arpRateKnob .dial{background:conic-gradient(from 225deg,#48515f 0 calc(var(--v,0)*270deg),#262c35 calc(var(--v,0)*270deg) 270deg,#0a0d12 270deg 360deg);box-shadow:inset 0 0 0 1px rgba(0,0,0,.6),0 1px 2px rgba(0,0,0,.5)}   /* #5: LENGTH + arp RATE knobs fill with the default steel UI color, not magenta */
    /* batch3 #2: when the arp is ARMED, its knobs fill with sapphire — matching the LED on the ARP/LATCH buttons */
    .device.live .arpmod.armed #lenKnob .dial,.device.live .arpmod.armed #arpRateKnob .dial{background:conic-gradient(from 225deg,var(--sapphire) 0 calc(var(--v,0)*270deg),#262c35 calc(var(--v,0)*270deg) 270deg,#0a0d12 270deg 360deg);box-shadow:0 0 8px -2px var(--sapphire),inset 0 0 0 1px rgba(0,0,0,.6),0 1px 2px rgba(0,0,0,.5)}
    /* dependent arp controls sit recessed until the arp is armed (auto-arms on touch — see armArp) */
    .device.live .arpmod:not(.armed) .arpsec:has(.seg),
    .device.live .arpmod:not(.armed) .arpsec:has(#lenKnob),
    .device.live .arpmod:not(.armed) .arpsec.ratesec{opacity:.42;transition:opacity .35s ease}   /* batch3 #2: LENGTH arpsec now dims with RATE when the arp is off */

    /* ════ #2 CONTEXTUAL DIMMING — when an effect's parent toggle is OFF, its dependent controls recede + knob fills desaturate to gray (same idea as the arp dim above), so irrelevant effects stop competing for attention. ════ */
    /* DRUMS off: pattern buttons dim like the arp rate; cover/sidechain meters + drum knobs slightly dimmer; drum knob fills go gray */
    .device.live .cmdgroup:has(#beat:not(.on)) #patSeg{opacity:.42;transition:opacity .35s ease}
    .device.live .cmdgroup:has(#beat:not(.on)) .coverslide,
    .device.live .cmdgroup:has(#beat:not(.on)) .drumfx{opacity:.6;transition:opacity .35s ease}
    .device.live .cmdgroup:has(#beat:not(.on)) .drumfx .dial{background:conic-gradient(from 225deg,#48515f 0 calc(var(--v,0)*270deg),#262c35 calc(var(--v,0)*270deg) 270deg,#0a0d12 270deg 360deg)}
    /* BASS off: the knob row dims + INTENSITY/SUB/GLIDE fills go gray — mirrors the DRUMS-off behavior */
    .device.live .cmdgroup.bassgroup:has(#bassrow:not(.on)) .drumfx .knob{opacity:.6;transition:opacity .35s ease}   /* batch6 #3: dim only the knobs when bass is off — the BASS label + B keycap stay full */
    .device.live .bassgroup:has(#bassrow:not(.on)) #bcharKnob .dial,
    .device.live .bassgroup:has(#bassrow:not(.on)) #bweightKnob .dial,
    .device.live .bassgroup:has(#bassrow:not(.on)) #bglideKnob .dial,
    .device.live .bassgroup:has(#bassrow:not(.on)) #bpluckKnob .dial{background:conic-gradient(from 225deg,#48515f 0 calc(var(--v,0)*270deg),#262c35 calc(var(--v,0)*270deg) 270deg,#0a0d12 270deg 360deg);box-shadow:inset 0 0 0 1px rgba(0,0,0,.6),0 1px 2px rgba(0,0,0,.5)}
    /* ARP off: LENGTH + RATE knob fills go gray (the .arpsec wrappers also dim via the opacity rule above) */
    .device.live .arpmod:not(.armed) #lenKnob .dial,
    .device.live .arpmod:not(.armed) #arpRateKnob .dial{background:conic-gradient(from 225deg,#48515f 0 calc(var(--v,0)*270deg),#262c35 calc(var(--v,0)*270deg) 270deg,#0a0d12 270deg 360deg);box-shadow:inset 0 0 0 1px rgba(0,0,0,.6),0 1px 2px rgba(0,0,0,.5)}

    /* ════ #3 TEMPTATION — in the OFF state the toggle keycap fills with a vibrant color (deep orange for DRUMS/SPACE, deep green for BASS/B) to entice a press; turning the effect ON reverts the keycap to normal and lights the panel border instead. ════ */
    .device.live .cmdgroup:has(#beat:not(.on)) .kick .kh{color:#ffe7d4;background:radial-gradient(circle at 50% 30%,#db7a40,#9c481c);border-color:rgba(0,0,0,.5);box-shadow:inset 0 1px 1px rgba(255,255,255,.2),inset 0 -2px 4px rgba(0,0,0,.32),0 0 10px -5px #db7a40}
    .device.live .cmdgroup.bassgroup:has(#bassrow:not(.on)) .basskick .kh{color:#ece9ff;background:linear-gradient(180deg,#6a4ae0,#3914c0 58%,#210a72);border-color:rgba(0,0,0,.5);box-shadow:inset 0 1px 1px rgba(255,255,255,.2),inset 0 -2px 4px rgba(16,6,58,.32),0 0 10px -5px #3914c0}
    /* #4: an effect's mode sub-buttons dim when its fader is at zero (the .fill goes .mt/muted) — irrelevant until the effect is turned up */
    .device.live .fxstrip:has(.fill.mt) .fxsub{opacity:.4;transition:opacity .35s ease}
    /* #6: when DRUMS are off, drop the glow on the cover/sidechain meters (irrelevant) */
    .device.live .cmdgroup:has(#beat:not(.on)) .sfill{box-shadow:none;background:repeating-linear-gradient(90deg,rgba(140,160,185,.14) 0 3px,transparent 3px 5px)}   /* #5: drums off → meters de-illuminate to super-dim gray bars, no glow */
    .device.live .cmdgroup:has(#beat:not(.on)) .sfill::after{background:rgba(140,160,185,.26);box-shadow:none}
    .arpmod .al{font-family:ui-monospace,Menlo,monospace;font-size:.54rem;letter-spacing:.07em;text-transform:uppercase;color:#9fb0c1}
    .arpsec,.phsec{display:flex;align-items:center;gap:11px}
