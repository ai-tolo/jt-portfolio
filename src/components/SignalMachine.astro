/* mic + vocal strip */
const micin=$('#micin'),loopover=$('#loopover'),loopPill=$('#loopPill'),capnum=$('#capnum'),capringP=$('#capringP'),vstatus=$('#vstatus');
let vTreat='double',vDepth=0,micRaf=null;   // INTENSITY knob drives vDepth (0 = dry); the effects are toggles, one always active
function vApply(){if(eng)eng.setVocal(vTreat,vDepth);}
