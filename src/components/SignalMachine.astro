  else{delL.connect(dmix);delR.connect(dmix);}
  delR.connect(damp);damp.connect(dfb);dfb.connect(delL);
  dmix.connect(glue);
  post.connect(rev.input);rev.output.connect(rmix);rmix.connect(glue);
  const masterHP=ctx.createBiquadFilter();masterHP.type='highpass';masterHP.frequency.value=20;masterHP.Q.value=0.707;   // LIFT rides this; transparent at rest
  glue.connect(duck);duck.connect(preLimit);drumBus.connect(preLimit);
