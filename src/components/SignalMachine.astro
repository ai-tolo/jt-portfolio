/* ── VOICE IN lifecycle: one rAF paints the capture state ON the capsule (count-in digit, then a red ring
   that fills across the 2 bars) from the engine clock; when the take lands, a "loop" pill appears and opens
   the crop popover. The capsule + popover are out of .io's flow, so the device never reflows. ── */
let trimIn=0,trimOut=1,loopBeatsUI=8,capRaf=null,capPhase='',lastCount=-1;
function capRingSet(p){if(!capringP)return;const L=capringP._L||(capringP._L=capringP.getTotalLength()||141);capringP.style.strokeDasharray=L;capringP.style.strokeDashoffset=(L*(1-clamp(p,0,1))).toFixed(1);}   // dasharray=full length → drawn fraction == p (no more half-draw)
function lenLabel(){const b=Math.max(1,Math.round((trimOut-trimIn)*loopBeatsUI));return (b%4===0)?(b/4)+(b/4===1?' bar':' bars'):b+(b===1?' beat':' beats');}
function capFrame(){
  if(!live||!eng){stopCap();return;}
  const ci=eng.capInfo;
  if(ci){const now=eng.getCtx().currentTime;
    if(now<ci.startT){   // COUNT-IN — the capsule becomes a clock
      if(capPhase!=='count'){capPhase='count';micin.classList.add('arming','on');micin.classList.remove('rec');micin.setAttribute('aria-pressed','true');capRingSet(0);}
      const left=Math.max(1,Math.min(ci.countBeats,Math.ceil((ci.startT-now)/ci.beat)));
      if(left!==lastCount){lastCount=left;capnum.textContent=left;capnum.classList.remove('pop');void capnum.offsetWidth;capnum.classList.add('pop');vstatus.textContent='counting in, '+left;}
    }else{   // RECORDING — the ring fills AND a beats-remaining countdown ticks down, so "it stops on its own" is SEEN, not just implied
      if(capPhase!=='rec'){capPhase='rec';lastCount=-1;micin.classList.remove('arming');micin.classList.add('rec','on');vstatus.textContent='recording — sing now, it stops itself';}
      const left=Math.max(1,Math.ceil((ci.startT+ci.recDur-now)/ci.beat));
      if(left!==lastCount){lastCount=left;capnum.textContent=left;capnum.classList.remove('pop');void capnum.offsetWidth;capnum.classList.add('pop');}
      capRingSet((now-ci.startT)/ci.recDur);
    }
    capRaf=requestAnimationFrame(capFrame);return;}
  if(eng.loopActive){onLoopReady();return;}        // capture finished → the loop is live
  if(eng.recActive){capRaf=requestAnimationFrame(capFrame);return;}   // armed, awaiting the scheduled start (mic permission / count not set yet)
  stopCap();}
function startCap(){if(!capRaf)capRaf=requestAnimationFrame(capFrame);}
