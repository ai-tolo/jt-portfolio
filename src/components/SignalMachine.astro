/* back-compat single-line seam — anything calling readoutSet(text) still works */
function readoutSet(text){coachRender(text?{a:text}:{rest:true});}

const COACH=(function(){
  const U={
    orient:{a:'press  A S D F  to play',b:'every key is a note — try a few'},
    chord:{a:'nice — now hold a few at once',b:'two or three keys makes a chord'},
    groove:{a:'holding a chord? tap  SPACE',b:'it drops a beat under you'},
    bass:{a:"beat's in — now tap  B",b:'the bass follows the notes you play'},
    filter:{a:'drag the node in the big screen',b:'sideways opens it, down shaves the top'},
    drift:{a:'drag inside the  DRIFT  pad',b:'it morphs the voice — bright to dark'},
    towers:{a:'drag any tower up',b:'DRIVE  MOD  DELAY  REVERB'},
    perform:{a:'hold  V  N  M  while you play',b:'lift · gate · dive — each bends the note'},
    arp:{a:'flip  ARP  on, hold a chord',b:'it plays the chord for you, in time'},
    rec:{a:'happy with it? hit  REC',b:'then play it back with  PLAY'},
    jam:{a:"that's a take — hit  JAM",b:'it loops so you can play over it'},
    share:{a:'like it?  SHARE',b:'copies a link to this exact take'},
    mastery:{a:"you've got it",b:''},
    key:{a:'set the  KEY',b:'every note stays in tune'},
    octmove:{a:'hold a chord, then the arrows',b:'they  MOVE  the chord, not the octave'},
    latch:{a:'arp on? tap  LATCH',b:'it holds the chord — hands free'},
    pattern:{a:'tap a pattern',b:'FLOOR  BACK  HALF  BREAK'},
    drumfeel:{a:'SWING  DENSITY  GRIT',b:'reshape the drum feel'},
    cover:{a:'the  DRUM COVER  slider',b:'muffles the beat, like a closed lid'},
    sidechain:{a:'raise  SIDECHAIN',b:'the synth breathes with the kick'},
    bassint:{a:'push  BASS  up',b:'deep and clean, out to a buzz'},
    tempo:{a:'drag the  BPM  screen',b:'to change the speed'},
    voicein:{a:'tap  VOICE IN  and sing',b:'it grabs 2 bars on its own, then loops'},
    treat:{a:'singing a loop?',b:'add  TELEPHONE  or  ROBOT  to it'},
    dice:{a:'out of ideas? the  DICE',b:'rolls a whole new sound'},
  };
  const LADDER=[
    {unit:'orient', need:'played',  pre:[]},
    {unit:'chord',  need:'chord',   pre:['played']},
    {unit:'groove', need:'beat',    pre:['chord']},
    {unit:'bass',   need:'bass',    pre:['beat']},
    {unit:'filter', need:'filter',  pre:['beat']},
    {unit:'drift',  need:'drift',   pre:['beat']},
    {unit:'towers', need:'fx',      pre:['beat']},
    {unit:'perform',need:'gesture', pre:['beat','shaped']},
    {unit:'arp',    need:'arp',     pre:['chord']},
    {unit:'rec',    need:'rec',     pre:['beat','chord']},
    {unit:'jam',    need:'jam',     pre:['rec']},
    {unit:'share',  need:'share',   pre:['rec']},
  ];
  const WHISPERS=[
    {unit:'octmove',  need:'octmove',  pre:['chord']},
    {unit:'latch',    need:'latch',    pre:['arp']},
    {unit:'pattern',  need:'pattern',  pre:['beat']},
    {unit:'drumfeel', need:'drumfeel', pre:['beat']},
    {unit:'cover',    need:'cover',    pre:['beat']},
    {unit:'sidechain',need:'sidechain',pre:['beat','bass']},
    {unit:'bassint',  need:'bassint',  pre:['bass']},
    {unit:'tempo',    need:'tempo',    pre:['beat']},
    {unit:'key',      need:'key',      pre:['played']},
    {unit:'treat',    need:'treat',    pre:['voicein']},
    {unit:'dice',     need:'dice',     pre:[]},
    {unit:'voicein',  need:'voicein',  pre:[]},
  ];
  const CLICKS=[];
  const NOTE_THR=0.015;
  let L,seen,snap,now0,lastInput,lastPressN,curUnit,curAt,idleGate,whispers,terminal,started=false,pollId=null,presetSettleUntil=0;

  const tnow=()=>performance.now();
  function freshLedger(){const o={};['played','chord','beat','bass','filter','drift','motion','fx',
    'gesture','arp','latch','rec','jam','share','key','octmove','pattern','drumfeel','cover',
    'sidechain','bassint','tempo','voicein','treat','dice','demo','shaped'].forEach(k=>o[k]=0);return o;}
  function mark(f){if(L[f])return false;L[f]=1;idleGate=2200;        // new discovery → faster help
    if(f==='filter'||f==='drift'||f==='motion'||f==='fx')L.shaped=1;return true;}
  const pre=a=>a.every(f=>L[f]);
  function snapFx(){const f=eng.fx;return{cutoff:f.cutoff,res:f.res,vx:f.vx,vy:f.vy,reverb:f.reverb,tempo:f.tempo,pattern:f.pattern,bassHeat:f.bassHeat};}
  const isRest=()=>readoutEl&&readoutEl.classList.contains('rest');

  /* performing? — recent ATTACK / held gesture / mic / replay. Never activeVoices/arpOn/.latched. */
  function playing(){
    if(!eng)return false;
    if((tnow()-lastInput)<1200)return true;
    const g=eng.gestures||{};if(g.lift||g.gate||g.dive)return true;
    if(REC.replaying)return true;
    if(eng.micLevel&&eng.micLevel()>NOTE_THR)return true;
    return false;
  }
  function frozen(){
    if(!inView)return true;
    const ov=$('#lpoverlay');if(ov&&ov.classList.contains('show'))return true;
    const ed=$('#engdisc');if(ed&&ed.getAttribute('aria-expanded')==='true')return true;
    return false;
  }
  function pollControls(){
    if(REC.replaying||jamReplaying)return;                 // never credit replayed moves
    if(tnow()<presetSettleUntil)return;                    // ignore dice/demo residual fx
    const f=eng.fx,d=0.05;
    if(Math.abs(f.cutoff-snap.cutoff)>d||Math.abs(f.res-snap.res)>d)mark('filter');
    if(Math.abs(f.vx-snap.vx)>d||Math.abs(f.vy-snap.vy)>d)mark('drift');
    if(f.amount>0.001)mark('motion');
    if(f.drive>0.02||f.mod>0.02||f.delay>0.02||(f.reverb-snap.reverb)>0.05)mark('fx');
    if(f.beat)mark('beat'); if(f.bass)mark('bass'); if(eng.arpOn)mark('arp');
    if(f.sidechain>0.01)mark('sidechain');
    if(Math.abs(f.tempo-snap.tempo)>0.5)mark('tempo');
    if(f.pattern!==snap.pattern)mark('pattern');
    if(Math.abs(f.bassHeat-snap.bassHeat)>d)mark('bassint');
    if(keyRoot!==0||scaleMode!=='major')mark('key');
    if(eng.vocal||eng.loopActive)mark('voicein');
    if(eng.vocal&&eng.vocal.treat&&eng.vocal.treat!=='dry')mark('treat');
    const g=eng.gestures||{};if(g.lift||g.gate||g.dive)mark('gesture');
  }
  function ladderList(){const o=[];for(const r of LADDER)if(!L[r.need]&&pre(r.pre)&&!seen.has(r.unit))o.push(r.unit);return o;}
  function nextWhisper(){for(const w of WHISPERS)if(!L[w.need]&&pre(w.pre)&&!seen.has(w.unit))return w.unit;return null;}
  function masteryHit(){if(!(L.played&&L.chord&&L.beat))return false;
    return [L.bass,L.shaped,L.gesture,L.arp,(L.rec||L.jam||L.share)].filter(Boolean).length>=3;}
  function show(unitId,horizonId){const u=U[unitId];if(!u)return;
    seen.add(unitId);curUnit=unitId;curAt=tnow();
    coachRender({a:u.a,b:u.b,c:horizonId&&U[horizonId]?U[horizonId].a:''});}
  function settle(){if(curUnit&&U[curUnit])coachRender({a:U[curUnit].a,b:U[curUnit].b,c:'',rest:true});}

  function resolve(){
    if(!live||!eng||!started)return;
    const pn=piano.querySelectorAll('.press').length;       // any note on/off (key OR mouse) = activity
    if(pn!==lastPressN){lastPressN=pn;lastInput=tnow();if(pn>=2)mark('chord');}
    if(frozen()){pollControls();return;}                    // record silently, say nothing
    pollControls();
    if(playing()){settle();return;}                         // teach only in the gaps
    if(terminal)return;
    const dwell=reduceMq.matches?5000:3200;
    const inDwell=curUnit&&!isRest()&&(tnow()-curAt)<dwell;

    if(masteryHit()&&!seen.has('mastery')){if(!inDwell){show('mastery');terminal=true;}return;}

    const lad=ladderList();
    if(lad.length){
      if(lad[0]==='orient'&&(tnow()-now0)<2200)return;      // a fast starter never sees orient
      if(!inDwell)show(lad[0],lad[1]||null);                // bright = now, faint c = next step
      return;
    }
    if(!inDwell&&(tnow()-curAt)>=idleGate){                 // idle discovery whisper, backed-off
      const w=nextWhisper();
      if(w&&whispers<8){whispers++;show(w);idleGate=Math.min(idleGate*2,20000);}
    }
  }

  /* ── passive listeners (additive; edit no existing handler) ── */
  function onKeydown(e){
    const k=(e.key||'').toLowerCase();
    if(QO[k]!=null){lastInput=tnow();if(!REC.replaying)mark('played');return;}
    if(e.code==='Space'||e.code==='KeyB'){lastInput=tnow();return;}   // beat/bass flags come from the poll
    if(e.code==='KeyZ'||e.code==='KeyX'||e.code==='KeyC'||e.code==='KeyM'){lastInput=tnow();}
  }
  function clickFlag(sel,flag,preset){const el=$(sel);if(!el)return;
    const h=()=>{if(REC.replaying)return;mark(flag);
      if(preset){presetSettleUntil=tnow()+700;snap=snapFx();
        ['filter','drift','motion','fx','pattern'].forEach(f=>{L[f]=1;});L.shaped=1;
        ['filter','drift','towers'].forEach(id=>seen.add(id));}};
    el.addEventListener('click',h);CLICKS.push([el,h]);}

  function start(){
    if(started||!eng)return;started=true;
    L=freshLedger();seen=new Set();terminal=false;whispers=0;idleGate=2200;
    now0=lastInput=tnow();presetSettleUntil=0;curUnit=null;curAt=0;
    lastPressN=piano.querySelectorAll('.press').length;snap=snapFx();
    coachRender({rest:true});                               // resting only — teach nothing on power-on
    window.addEventListener('keydown',onKeydown,true);
    clickFlag('#recBtn','rec');clickFlag('#jamBtn','jam');clickFlag('#shareBtn','share');
    clickFlag('#latchBtn','latch');clickFlag('#dice','dice',true);
    pollId=setInterval(resolve,600);
  }
  function stop(){
    if(pollId){clearInterval(pollId);pollId=null;}
    window.removeEventListener('keydown',onKeydown,true);
    CLICKS.forEach(([el,h])=>el.removeEventListener('click',h));CLICKS.length=0;
    started=false;curUnit=null;_rdKey='';
    if(readoutEl){readoutEl.classList.remove('rest');readoutEl.innerHTML='';}
  }
  return{start,stop};
})();

/* the three seam names finishPower()/doPowerOff() already call */
function readoutStart(){if(touchStance)return;COACH.start();}   // touch: coach owns nothing (amber bar + Halo do)
function readoutStop(){COACH.stop();if(typeof readoutSeqClose==='function')readoutSeqClose(true);}   // preserve power-off PLUCK reset (parked); guard if that code is ever removed

/* ── BASS STEP SEQUENCER — takes over the readout when PLUCK is armed ── */
const SEQ_MULTS=[{l:'×½',v:.5},{l:'×1',v:1},{l:'×2',v:2}];
let seqMultIdx=1,seqBuilt=false,seqCells=[],seqLastPlay=-1;
const RDV_LABELS={0:'—',1:'ghost',2:'hit',3:'accent'};
function rdAccentLabel(){const accents=(eng?eng.bassSeq:[]).filter(c=>c&&c.v===3).length;return accents?accents+' acc':'—';}
function rdUpdateMeta(){if(!seqBuilt)return;const a=readoutEl.querySelector('.rdaccent');if(a)a.textContent=rdAccentLabel();}
function rdRenderCell(i){const cell=seqCells[i];if(!cell)return;const s=eng?eng.bassSeq[i]:0;
  cell.dataset.v=s?String(s.v):'0';cell.dataset.oct=s&&s.oct==='sub'?'sub':'base';}
function buildReadoutSeq(){if(seqBuilt||!readoutEl)return;const seq=readoutEl.querySelector('.rdseq');if(!seq)return;
  let rail='<div class="rdrail"><div class="rdrate" role="group" aria-label="Pattern rate">'+SEQ_MULTS.map((m,i)=>'<b data-i="'+i+'"'+(i===seqMultIdx?' class="on"':'')+'>'+m.l+'</b>').join('')+'</div>'+
    '<div class="rdmeta"><span>ACCENT</span><span class="rdaccent">—</span></div>'+
    '<div class="rdstep">STEP <b>1</b>/16</div></div>';
  let grid='<div class="rdgrid">';
  for(let i=0;i<16;i++){grid+='<div class="rdcell" data-i="'+i+'" data-v="0" data-oct="base"'+(i%4===0?' data-beat':'')+'><span class="rddot" data-dot="'+i+'"></span><span class="rdbar"></span></div>';}
  grid+='</div>';
  seq.innerHTML=rail+grid;seqBuilt=true;
  seqCells=[...seq.querySelectorAll('.rdcell')];
  // RATE detents
  seq.querySelectorAll('.rdrate b').forEach(b=>b.addEventListener('click',e=>{if(!live||!eng)return;e.stopPropagation();seqMultIdx=+b.dataset.i;seq.querySelectorAll('.rdrate b').forEach(x=>x.classList.toggle('on',x===b));eng.setBassSeqMult(SEQ_MULTS[seqMultIdx].v);}));
  // cells: bar taps cycle off→ghost→hit→accent; dot taps toggle sub octave
  seqCells.forEach((cell,i)=>{
    cell.addEventListener('click',e=>{if(!live||!eng)return;
      if(e.target&&e.target.classList.contains('rddot')){const cur=eng.bassSeq[i];const oct=cur&&cur.oct==='sub'?'base':'sub';if(cur&&cur.v)eng.setBassStep(i,{v:cur.v,oct});else eng.setBassStep(i,{v:2,oct});rdRenderCell(i);rdUpdateMeta();return;}
      const cur=eng.bassSeq[i];const v=((cur&&cur.v)||0)+1;const oct=cur&&cur.oct==='sub'?'sub':'base';
      eng.setBassStep(i,v>3?0:{v,oct});rdRenderCell(i);rdUpdateMeta();});
  });
}
function readoutSeqOpen(){if(!readoutEl)return;buildReadoutSeq();
  if(readoutTimer){clearInterval(readoutTimer);readoutTimer=null;}   // pause the coaching cycler; readoutCoachOn remembers it should resume
  if(eng){eng.setBassSeqMult(SEQ_MULTS[seqMultIdx].v);eng.onBassStep((idx,hit)=>{
    if(seqLastPlay>=0&&seqCells[seqLastPlay])seqCells[seqLastPlay].classList.remove('play');
    if(seqCells[idx]){seqCells[idx].classList.add('play');seqLastPlay=idx;}
    const sb=readoutEl.querySelector('.rdstep b');if(sb)sb.textContent=String((idx%16)+1);});}
  for(let i=0;i<16;i++)rdRenderCell(i);rdUpdateMeta();
  readoutEl.dataset.mode='seq';}
function readoutSeqClose(force){if(!readoutEl)return;
  if(readoutEl.dataset.mode!=='seq'&&!force){return;}
  if(eng&&eng.onBassStep)eng.onBassStep(null);   // detach playhead
  if(seqLastPlay>=0&&seqCells[seqLastPlay])seqCells[seqLastPlay].classList.remove('play');seqLastPlay=-1;
  readoutEl.dataset.mode='coach';
  if(force&&pluckBtn){pluckBtn.classList.remove('on');pluckBtn.setAttribute('aria-pressed','false');
    if(eng&&eng.bassMode==='pluck')eng.setBassMode(bassGlideV>GLIDE_DEAD?'glide':'off');}   // power-off: keep the engine mode in sync with the cleared PLUCK button (engine persists across power cycles)
  if(readoutCoachOn&&!readoutTimer){readoutSet(MOCK_TIPS[readoutI]);readoutTimer=setInterval(()=>{readoutI=(readoutI+1)%MOCK_TIPS.length;readoutSet(MOCK_TIPS[readoutI]);},4200);}}   // resume coaching if it was running

/* 4 · Alt-hover "why it is hard" gloss — delegated to #device, Alt-gated, desktop only; reads no engine state */
const HARD={
  '#tempo':'tempo changes ramp click-free — setTargetAtTime / cancelAndHoldAtTime, never a bare .value jump',
  '#beat':'one 25 ms lookahead scheduler on absolute ctx time; drums, arp and gate share one transport origin (gridNext) so they never drift',
  '#patSeg':'pattern swaps land on the grid, not the keypress — the next 16th is already scheduled',
  '#amtKnob':'MOTION scales LFO depth in octaves of the base cutoff, so the sweep tracks where you set the node',
  '#rateKnob':'RATE is note-synced to the transport, so the sweep stays locked to the beat at any tempo',
  '#scslide':'kick-triggered duck — depth, ratio and hold all scale from one slider, retriggered on every kick',
  '#bassrow':'bass tracks the lowest note you are holding, octave-folded into the sub range',
  '#micin':'feedback-safe: the mic physically closes before the recorded loop replays through the same rack',
  '#vfield':'one XY pad morphs brightness and width together — no preset, just two crossfaded paths',
  '#dice':'randomize stays musical — it biases toward ranges that sound good, not the full parameter space'
};
let glossEl=null,altDown=false;
function matchFor(t){let el=t;while(el&&el!==device){for(const sel in HARD){if(el.matches&&el.matches(sel))return{el:el,text:HARD[sel]};}el=el.parentElement;}return null;}
function ensureGloss(){if(!glossEl){glossEl=document.createElement('div');glossEl.className='sgm-hard';glossEl.setAttribute('aria-hidden','true');device.appendChild(glossEl);}return glossEl;}
function showGloss(m){const g=ensureGloss();if(g.textContent!==m.text)g.textContent=m.text;
  const dr=device.getBoundingClientRect(),tr=m.el.getBoundingClientRect(),above=tr.top-dr.top-10;
  g.style.left=(tr.left-dr.left+tr.width/2)+'px';g.dataset.flip=above<34?'down':'up';
  g.style.top=(above<34?tr.bottom-dr.top+10:above)+'px';g.classList.add('on');}
function hideGloss(){if(glossEl)glossEl.classList.remove('on');}
function onMove(e){if(!altDown||!live)return;const m=matchFor(e.target);if(m)showGloss(m);else hideGloss();}
function onKey(e){if(e.key!=='Alt')return;const now=e.type==='keydown';if(now===altDown)return;altDown=now;
  if(altDown&&!reduceMq.matches)sgm.classList.add('althint');else{sgm.classList.remove('althint');hideGloss();}}
if(!touchStance){
  device.addEventListener('pointermove',onMove);
  device.addEventListener('pointerleave',hideGloss);
  window.addEventListener('keydown',onKey);
  window.addEventListener('keyup',onKey);
  window.addEventListener('blur',()=>{altDown=false;hideGloss();sgm.classList.remove('althint');});
}

</script>
