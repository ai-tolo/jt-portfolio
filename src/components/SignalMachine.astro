    .keypop{position:absolute;top:calc(100% + 8px);right:0;z-index:30;display:none;grid-template-columns:repeat(4,1fr);gap:4px;padding:8px;border-radius:6px;background:linear-gradient(180deg,#161c25,#0d121a);box-shadow:0 10px 26px rgba(0,0,0,.62),inset 0 0 0 1px rgba(255,255,255,.06)}
    .keypop.open{display:grid}
    .keypop .kp{font-family:ui-monospace,Menlo,monospace;font-size:.62rem;color:#b3bdc9;width:34px;height:28px;border:none;border-radius:4px;cursor:pointer;background:linear-gradient(180deg,#2a3340,#1a212b);box-shadow:inset 0 1px 0 rgba(255,255,255,.06),0 1px 2px rgba(0,0,0,.5);transition:background .12s,color .12s}
    .keypop .kp:hover{color:#fff;background:linear-gradient(180deg,#33414f,#222a35)}
    .keypop .kp.on{color:#06222b;background:linear-gradient(180deg,#bdeffd,#5fcdee);box-shadow:0 0 8px -2px var(--sapphire)}
    .octhint{font-size:.42rem;letter-spacing:.1em;color:#566b80}
    .lockseg{width:auto}
    .piano{position:relative;height:112px;border-radius:12px;padding:8px 8px 0;background:linear-gradient(180deg,#0a0d12,#05070a);border:1px solid rgba(0,0,0,.65);box-shadow:inset 0 3px 12px rgba(0,0,0,.7),inset 0 0 0 1px rgba(90,120,160,.05);display:flex;gap:5px;user-select:none;touch-action:none;margin-top:0}
    /* tron keys: near-black, white outline + letters, a soft per-key colorful glow (below) */
    .wkey{position:relative;flex:1;border-radius:0 0 7px 7px;cursor:pointer;background:linear-gradient(180deg,#222c39 0%,#141b25 55%,#0c121b 100%);border:1px solid rgba(255,255,255,.34);border-top:none;box-shadow:inset 0 7px 11px -7px rgba(255,255,255,.16),inset 0 -7px 11px -6px rgba(0,0,0,.55),0 2px 4px rgba(0,0,0,.5);display:flex;flex-direction:column;justify-content:flex-end;align-items:center;padding-bottom:9px;transition:background .08s,box-shadow .12s}
    .wkey .ql{font-family:ui-monospace,Menlo,monospace;font-size:.95rem;font-weight:700;letter-spacing:.02em;color:#f3f8fc;text-shadow:0 0 4px rgba(0,0,0,.6)}
    .wkey .nl{font-family:ui-monospace,Menlo,monospace;font-size:.42rem;letter-spacing:.1em;text-transform:uppercase;color:rgba(238,244,250,.3);margin-top:3px}
    .wkey.latched{background:linear-gradient(180deg,#1f6f8f,#0c2f40);border-color:var(--sapphire);box-shadow:0 0 0 1.5px var(--sapphire),inset 0 -16px 22px -8px color-mix(in srgb,var(--sapphire) 85%,transparent),0 0 26px -2px var(--sapphire),0 2px 4px rgba(0,0,0,.5)}
    .wkey.latched .ql{color:#f1ffff;text-shadow:0 0 8px color-mix(in srgb,var(--sapphire) 80%,transparent)}
    .wkey.latched .nl{color:rgba(202,242,255,.7)}
    .wkey.press{background:linear-gradient(180deg,#3a5466,#162430);box-shadow:0 0 0 1.5px rgba(235,250,255,.9),inset 0 -18px 24px -8px rgba(220,245,255,.55),0 0 30px -2px rgba(210,242,255,.9);border-color:#fff}.wkey.press .ql{color:#fff;text-shadow:0 0 9px rgba(210,242,255,.9)}.wkey.press .nl{color:rgba(255,255,255,.65)}
    .bkey{position:absolute;top:8px;width:5.6%;height:82px;border-radius:0 0 5px 5px;cursor:pointer;z-index:3;background:linear-gradient(180deg,#0b0f16,#020305 82%);border:1px solid rgba(255,255,255,.22);box-shadow:inset 0 1px 0 rgba(255,255,255,.1),inset 0 -8px 9px rgba(0,0,0,.7),0 4px 6px rgba(0,0,0,.7);display:flex;flex-direction:column;justify-content:flex-end;align-items:center;padding-bottom:7px;transition:background .05s,box-shadow .08s}
    .bkey .ql{font-family:ui-monospace,Menlo,monospace;font-size:.78rem;font-weight:700;color:#f3f8fc;text-shadow:0 0 4px rgba(0,0,0,.7)}
    .bkey .nl{font-family:ui-monospace,Menlo,monospace;font-size:.4rem;letter-spacing:.08em;color:rgba(238,244,250,.34);margin-top:2px}
    .bkey.latched{background:linear-gradient(180deg,#16a6da,#074a68 80%);box-shadow:0 0 0 1.5px var(--sapphire),0 0 24px -1px var(--sapphire),inset 0 1px 0 rgba(255,255,255,.25);border-color:var(--sapphire)}
    .bkey.latched .ql{color:#eafbff;text-shadow:0 0 7px color-mix(in srgb,var(--sapphire) 80%,transparent)}.bkey.latched .nl{color:rgba(202,242,255,.7)}
    .bkey.press{background:linear-gradient(180deg,#14a0d2,#06465f 80%);box-shadow:0 0 0 1.5px rgba(180,238,255,.95),0 0 28px -1px var(--sapphire),inset 0 1px 0 rgba(255,255,255,.3);border-color:#cdeffb}.bkey.press .ql{color:#f2fdff;text-shadow:0 0 8px rgba(180,238,255,.9)}.bkey.press .nl{color:rgba(255,255,255,.6)}
    /* per-key colorful glow on an overlay that EASES in (opacity), staggered L->R, on power —
       reads as activation not a toggle. Press feedback stays on .wkey box-shadow (snappy, separate). */
    .wkey::after{content:"";position:absolute;inset:0;border-radius:inherit;pointer-events:none;opacity:0;transition:opacity .5s ease;transition-delay:var(--kdoff,0ms);box-shadow:inset 0 -12px 20px -10px var(--kc,transparent),0 0 11px -5px var(--kc,transparent)}
    .piano.lit .wkey::after{opacity:1;transition-delay:var(--kdon,0ms)}   /* on: faster stagger from boot-START, last key lands ~1.46s. off: the base --kdoff applies (original gentle stagger) so power-down reads exactly as before */
    .piano .wkey:nth-child(2){--kc:#ff6b6b;--kdon:0ms;--kdoff:60ms}
    .piano .wkey:nth-child(3){--kc:#ffa94d;--kdon:120ms;--kdoff:110ms}
    .piano .wkey:nth-child(4){--kc:#ffd93d;--kdon:240ms;--kdoff:160ms}
    .piano .wkey:nth-child(5){--kc:#5fe39a;--kdon:360ms;--kdoff:210ms}
    .piano .wkey:nth-child(6){--kc:#4dd2e6;--kdon:480ms;--kdoff:260ms}
    .piano .wkey:nth-child(7){--kc:#5b9dff;--kdon:600ms;--kdoff:310ms}
    .piano .wkey:nth-child(8){--kc:#9b7dff;--kdon:720ms;--kdoff:360ms}
    .piano .wkey:nth-child(9){--kc:#ff7de0;--kdon:840ms;--kdoff:410ms}
    .piano .wkey:nth-child(10){--kc:#ff6b6b;--kdon:960ms;--kdoff:460ms}
    .piano.locked .bkey{opacity:.8}.piano.locked .bkey .ql{color:rgba(238,244,250,.72)}.piano.locked .bkey .nl{color:rgba(238,244,250,.26)}
  
  
  }
  /* ── TAKE transport (record / play / share) ── */
  .takebar{display:flex;align-items:center;gap:11px;margin-top:13px;padding:11px 15px;border-radius:13px;
    background:repeating-linear-gradient(90deg,rgba(255,255,255,.012) 0 1px,transparent 1px 3px),linear-gradient(158deg,#2a313c,#161b22);
    border:1px solid rgba(0,0,0,.6);box-shadow:inset 0 1px 0 rgba(255,255,255,.08),0 10px 30px -20px rgba(0,0,0,.9)}
  .takebar .tkl{font-family:ui-monospace,Menlo,monospace;font-size:.5rem;letter-spacing:.22em;text-transform:uppercase;color:#8593a2}
  /* take transport = proud keycaps; press = sapphire-lit pressed cap, armed/playing = red/green lit caps */
  .tbtn{position:relative;display:inline-flex;align-items:center;gap:7px;height:34px;padding:0 16px;border:none;border-radius:9px;cursor:pointer;user-select:none;
    font-family:ui-monospace,Menlo,monospace;font-size:.6rem;letter-spacing:.1em;color:#b3bdc9;
    background:linear-gradient(180deg,#464e5c 0%,#2c333f 47%,#1f2630 100%);
    border-top:1px solid rgba(255,255,255,.13);
    box-shadow:inset 0 1.5px 0.5px rgba(255,255,255,.24),inset 0 -5px 7px rgba(0,0,0,.5),0 4px 0 #0a0d12,0 6px 9px rgba(0,0,0,.55);transition:transform .07s,box-shadow .12s,color .12s}
  .tbtn:active{transform:translateY(2px);box-shadow:inset 0 1px 0.5px rgba(255,255,255,.18),inset 0 -3px 5px rgba(0,0,0,.5),0 2px 0 #0a0d12,0 3px 5px rgba(0,0,0,.55)}
  .tbtn[disabled]{opacity:.4;pointer-events:none}
  .tbtn .dotr{width:9px;height:9px;border-radius:50%;background:#5a3a3a;box-shadow:inset 0 0 0 1px rgba(0,0,0,.5)}
  .tbtn.rec.armed{color:#ffd7d7;border-top-color:rgba(255,90,90,.22);   /* no translateY — buttons never move (Jon); the red dot pulse signals recording */
    background:linear-gradient(180deg,#3a2630,#221319);
    box-shadow:inset 0 2px 5px rgba(0,0,0,.6),inset 0 0 14px -4px var(--red),0 1px 0 #0a0d12,0 2px 3px rgba(0,0,0,.55)}
  .tbtn.rec.armed .dotr{background:var(--red);box-shadow:0 0 8px var(--red);animation:tkpulse 1s ease-in-out infinite}
  /* #5 JAM — looping/overdub armed state (sapphire, mirrors the REC armed look) */
  .tbtn.jam.armed{color:#cfeefb;border-top-color:rgba(14,196,252,.22);
    background:linear-gradient(180deg,#163040,#0c1a24);
    box-shadow:inset 0 2px 5px rgba(0,0,0,.6),inset 0 0 14px -4px var(--sapphire),0 1px 0 #0a0d12,0 2px 3px rgba(0,0,0,.55)}
  /* STOP = a distinct bright red (stops ALL auto-sound: demo, beat, bass, arp) */
  .transport .tbtn.stopmode{color:#ff463a;text-shadow:0 0 2px rgba(255,70,58,.4);
    box-shadow:inset 0 0 0 1px rgba(255,70,58,.32),inset 0 0 7px -2px rgba(255,70,58,.42),inset 0 1.5px .4px rgba(255,255,255,.12),inset 0 -4px 6px rgba(0,0,0,.5),0 3px 0 #0a0d12,0 4px 7px rgba(0,0,0,.55)}
  /* explore cluster: dice (clearly a die) + demo with a cycle carousel */
  .xbtn{display:inline-flex;align-items:center;gap:7px;height:30px;padding:0 11px;border:none;border-radius:8px;cursor:pointer;user-select:none;
    font-family:ui-monospace,Menlo,monospace;font-size:.55rem;letter-spacing:.08em;color:#c3d4e4;
    background:linear-gradient(180deg,#3a4250 0%,#252b35 47%,#1a2029 100%);border-top:1px solid rgba(255,255,255,.13);
    box-shadow:inset 0 1.2px .4px rgba(255,255,255,.2),inset 0 -4px 6px rgba(0,0,0,.5),0 3px 0 #0a0d12,0 4px 7px rgba(0,0,0,.55);transition:transform .07s,box-shadow .12s,color .12s}
  .xbtn:active{transform:translateY(2px);box-shadow:inset 0 1px .4px rgba(255,255,255,.16),inset 0 -3px 5px rgba(0,0,0,.5),0 1px 0 #0a0d12,0 2px 4px rgba(0,0,0,.55)}
  /* dice = a unique round violet button on the right of the arp row */
  .arpbar .dicebtn{margin-left:auto;width:34px;height:34px;border-radius:50%;flex:none;display:flex;align-items:center;justify-content:center;cursor:pointer;user-select:none;color:#cdb8ff;
    background:radial-gradient(circle at 50% 32%,#2e2742,#15111f 76%);border-top:1px solid rgba(255,255,255,.13);
    box-shadow:inset 0 1.5px 1px rgba(255,255,255,.16),inset 0 -3px 5px rgba(0,0,0,.62),0 3px 0 #0a0d12,0 4px 7px rgba(0,0,0,.55);transition:transform .07s,box-shadow .12s,color .12s}
  .arpbar .dicebtn:active{transform:translateY(2px)}
  .arpbar .dicebtn:hover{color:#fff;box-shadow:inset 0 1.5px 1px rgba(255,255,255,.16),inset 0 -3px 5px rgba(0,0,0,.62),inset 0 0 11px -3px var(--pink),0 3px 0 #0a0d12,0 4px 7px rgba(0,0,0,.55)}
  .dicebtn svg{width:18px;height:18px;fill:currentColor;transition:transform .5s cubic-bezier(.4,1.7,.4,1)}
  .io .dicebtn{width:40px;height:40px;border-radius:50%;flex:none;display:flex;align-items:center;justify-content:center;cursor:pointer;user-select:none;color:#cdb8ff;margin-right:5px;background:radial-gradient(circle at 50% 32%,#2e2742,#15111f 76%);box-shadow:inset 0 1.5px 1px rgba(255,255,255,.08),inset 0 -3px 5px rgba(0,0,0,.6),0 1px 0 rgba(255,255,255,.04)}   /* batch9 #6: bigger dice */
  .io .dicebtn svg{width:23px;height:23px}
  #jamBtn[disabled],#shareBtn[disabled]{display:none}   /* batch9 #4: JAM/SHARE only appear once a take exists (after REC) — hidden until then */
  .io .dicebtn:active{transform:translateY(2px)}
  .io .dicebtn:hover{color:#fff;box-shadow:inset 0 1.5px 1px rgba(255,255,255,.16),inset 0 -3px 5px rgba(0,0,0,.62),inset 0 0 11px -3px var(--pink),0 1px 0 rgba(255,255,255,.04)}
  .sgm .device:not(.live) .io .dicebtn{opacity:.4}
  /* demo relocated beside the transport (playback) buttons — shrunk: LED dots stacked ABOVE the word, smaller cap */
  .sgm .io .iodemo{height:28px;padding:0 11px;border-radius:8px;font-size:.55rem;letter-spacing:.08em}
  .demogrp{display:inline-flex;align-items:center;gap:7px}
  .sgm .device:not(.live) .io .iodemo{opacity:.5}
  .dicebtn.roll svg{transform:rotate(360deg)}
  @media (prefers-reduced-motion: reduce){.dicebtn svg{transition:none}}
  .iodemocar{display:inline-flex;align-items:center;gap:4px}
  .iodemocar i{width:4px;height:4px;border-radius:50%;background:#3a4654;transition:background .2s,box-shadow .2s}
  .iodemocar i.on{background:var(--sapphire);box-shadow:0 0 5px var(--sapphire)}
  /* thin divider between the recording transport and the demo/dice explore actions */
  .io .iodiv{width:1px;height:18px;flex:none;align-self:center;margin:0 2px;background:linear-gradient(180deg,transparent,rgba(255,255,255,.1),transparent)}
  @keyframes tkpulse{0%,100%{opacity:1}50%{opacity:.3}}
  .tkstat{font-family:ui-monospace,Menlo,monospace;font-size:.5rem;letter-spacing:.03em;color:#9fb1c4;min-width:104px;text-align:right;margin-right:4px}
  .arpbar .featshelf{margin-left:auto}
  .tkstat b{color:#dffaff}
  .featshelf{display:flex;gap:7px;flex-wrap:wrap}
  .feat{height:30px;padding:0 13px;border:none;border-radius:8px;cursor:pointer;user-select:none;display:inline-flex;align-items:center;gap:7px;
    font-family:ui-monospace,Menlo,monospace;font-size:.56rem;letter-spacing:.04em;color:#bcd0e2;
    background:linear-gradient(180deg,#464e5c 0%,#2c333f 47%,#1f2630 100%);
    border-top:1px solid rgba(255,255,255,.12);
    box-shadow:inset 0 1.2px 0.5px rgba(255,255,255,.2),inset 0 -4px 6px rgba(0,0,0,.5),0 3px 0 #0a0d12,0 4px 6px rgba(0,0,0,.55);transition:transform .07s,box-shadow .12s}
  .feat::before{content:"▶";font-size:.5rem;color:var(--sapphire)}
  .feat:active{transform:translateY(2px)}
  .feat:hover{box-shadow:inset 0 1.2px 0.5px rgba(255,255,255,.2),inset 0 -4px 6px rgba(0,0,0,.5),inset 0 0 11px -4px var(--sapphire),0 3px 0 #0a0d12,0 4px 6px rgba(0,0,0,.55)}
  .signal-sec:not(:has(.device.live)) .takebar{filter:saturate(.7) brightness(.86)}
  .takeflag{margin-top:9px;padding:9px 14px;border-radius:10px;font-family:ui-monospace,Menlo,monospace;font-size:.58rem;letter-spacing:.04em;color:#dffaff;
    background:linear-gradient(180deg,#10212b,#0a141b);border:1px solid color-mix(in srgb,var(--sapphire) 35%,#000);box-shadow:0 0 18px -8px var(--sapphire);display:none}
  .takeflag.show{display:block}.takeflag b{color:var(--sapphire)}
  @keyframes sgmbulbup{0%{opacity:0}12%{opacity:.13}16%{opacity:.03}31%{opacity:.34}36%{opacity:.08}54%{opacity:.66}60%{opacity:.44}100%{opacity:1}}
  @keyframes sgmbreathe{0%,100%{opacity:.22}50%{opacity:.85}}
  @keyframes sgmbulb{0%{filter:brightness(0)}55%{filter:brightness(1.6)}100%{filter:brightness(1)}}
  @keyframes sgmflareo{0%,100%{opacity:.25}35%{opacity:1}}

  /* ════ "See the code" suite ════ */
  /* READOUT — the guidance display on the arpeggiator bar (wide, recessed glass, dark until power). MOCK-fed for now; the parallel feedback-script becomes the driver. */
  /* a real inset LCD readout — square corners, sunk into a near-black bezel, 3 lines tall */
  .sgm .arpbar .readout{position:relative;flex:1.6 1 0;min-width:0;min-height:80px;display:flex;align-items:center;padding:8px 16px;border-radius:0;overflow:hidden;
    background:linear-gradient(180deg,#05090f,#02050a);
    box-shadow:inset 0 0 0 1px rgba(0,0,0,.92),inset 0 2px 9px rgba(0,0,0,.88),inset 0 -1px 0 rgba(120,160,200,.04);border:1px solid #04070c;transition:box-shadow .55s ease,background .55s ease}
  .sgm .device.live .arpbar .readout{box-shadow:inset 0 0 0 1px rgba(0,0,0,.92),inset 0 2px 9px rgba(0,0,0,.85)}   /* #7: no rim glow / visible border in the steady on-state — the startup perimeter trace still animates on boot */
  .sgm .arpbar .readout::after{content:"";position:absolute;inset:0;pointer-events:none;opacity:0;background:repeating-linear-gradient(0deg,rgba(150,195,240,.07) 0 1px,transparent 1px 2px)}
  .sgm .device.live .arpbar .readout::after{opacity:1}
  .sgm .readout .rdtip{font-family:ui-monospace,Menlo,monospace;font-size:.62rem;letter-spacing:.03em;line-height:1.4;color:#3c4a59;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
  .sgm .device.live .readout .rdtip{color:#e6f5ff;font-weight:500;text-shadow:0 0 3px color-mix(in srgb,var(--sapphire) 26%,transparent)}
  .sgm .readout .rdtip::before{content:"▸ "}

  /* ── BASS STEP SEQUENCER — takes over the readout LCD when PLUCK is armed. Gold (the bass accent) on the sapphire glass. Dark-until-power. ── */
  .sgm .readout[data-mode="seq"]{padding:7px 12px}
  .sgm .readout[data-mode="seq"] .rdtip{display:none}
  .sgm .readout[data-mode="coach"] .rdseq{display:none}
  .sgm .readout .rdseq{--bass:#3914c0;flex:1;min-width:0;display:flex;align-items:stretch;gap:11px;height:50px}
  /* left rail: RATE detents + ACCENT + STEP n/16 */
  .sgm .rdseq .rdrail{flex:none;width:108px;display:flex;flex-direction:column;justify-content:center;gap:4px;padding-right:11px;border-right:1px solid rgba(120,160,200,.12)}
  .sgm .rdseq .rdrate{display:flex;gap:3px}
  .sgm .rdseq .rdrate b{flex:1;text-align:center;font-family:ui-monospace,Menlo,monospace;font-size:.46rem;letter-spacing:.02em;color:#3c4a59;padding:2px 0;border-radius:3px;cursor:pointer;background:rgba(8,16,26,.6);box-shadow:inset 0 0 0 1px rgba(0,0,0,.6);transition:color .15s,background .15s,box-shadow .15s}
  .sgm .device.live .rdseq .rdrate b{color:#7d93a8}
  .sgm .device.live .rdseq .rdrate b.on{color:#1e1605;background:radial-gradient(120% 120% at 50% 0%,#ffe07a,#e0a31a 86%);box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--bass) 60%,#000),0 0 7px -2px var(--bass)}
  .sgm .rdseq .rdmeta{display:flex;justify-content:space-between;align-items:baseline;font-family:ui-monospace,Menlo,monospace;font-size:.46rem;letter-spacing:.06em;color:#3c4a59}
  .sgm .device.live .rdseq .rdmeta{color:#6f8499}
  .sgm .rdseq .rdmeta .rdaccent{color:#3c4a59}
  .sgm .device.live .rdseq .rdmeta .rdaccent{color:var(--bass);text-shadow:0 0 5px color-mix(in srgb,var(--bass) 45%,transparent)}
  .sgm .rdseq .rdstep{font-family:ui-monospace,Menlo,monospace;font-size:.5rem;letter-spacing:.04em;color:#3c4a59;text-align:center;padding-top:1px}
  .sgm .device.live .rdseq .rdstep{color:#9fb6cb}
  .sgm .device.live .rdseq .rdstep b{color:var(--bass)}
  /* the 16-cell grid */
  .sgm .rdseq .rdgrid{flex:1;min-width:0;display:grid;grid-template-columns:repeat(16,1fr);gap:0;align-items:end}
  .sgm .rdseq .rdcell{position:relative;height:50px;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;cursor:pointer;-webkit-tap-highlight-color:transparent;border-left:1px solid transparent}
  .sgm .rdseq .rdcell[data-beat]{border-left:1px solid rgba(120,160,200,.16)}
  /* the bar (off→ghost→hit→accent: heights/opacity differ) */
  .sgm .rdseq .rdbar{width:62%;border-radius:2px 2px 0 0;background:#1b2733;box-shadow:inset 0 0 0 1px rgba(0,0,0,.5);transition:height .1s,background .15s,box-shadow .15s,opacity .15s}
  .sgm .rdseq .rdcell[data-v="0"] .rdbar{height:4px;opacity:.5}
  .sgm .rdseq .rdcell[data-v="1"] .rdbar{height:14px}
  .sgm .rdseq .rdcell[data-v="2"] .rdbar{height:26px}
  .sgm .rdseq .rdcell[data-v="3"] .rdbar{height:38px}
  .sgm .device.live .rdseq .rdcell[data-v="1"] .rdbar{background:linear-gradient(180deg,color-mix(in srgb,var(--bass) 42%,#10161d),#10161d);box-shadow:inset 0 0 0 1px rgba(0,0,0,.5)}
  .sgm .device.live .rdseq .rdcell[data-v="2"] .rdbar{background:linear-gradient(180deg,var(--bass),#9a6f12);box-shadow:inset 0 0 0 1px rgba(0,0,0,.4)}
  .sgm .device.live .rdseq .rdcell[data-v="3"] .rdbar{background:linear-gradient(180deg,#fff0bf,var(--bass) 70%);box-shadow:inset 0 0 0 1px rgba(0,0,0,.3),0 0 9px -1px var(--bass)}
  /* sub-octave dot — top of each cell */
  .sgm .rdseq .rddot{position:absolute;top:2px;width:5px;height:5px;border-radius:50%;background:#1b2733;box-shadow:inset 0 0 0 1px rgba(0,0,0,.6);cursor:pointer;transition:background .15s,box-shadow .15s}
  .sgm .device.live .rdseq .rdcell[data-oct="sub"] .rddot{background:var(--bass);box-shadow:0 0 6px var(--bass)}
  /* live playhead */
  .sgm .rdseq .rdcell.play::before{content:"";position:absolute;inset:0;border-radius:1px;background:rgba(150,195,240,.06)}
  .sgm .device.live .rdseq .rdcell.play::before{background:color-mix(in srgb,var(--bass) 16%,transparent);box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--bass) 30%,transparent)}


  /* Alt-hover "why it's hard" gloss — recessed glass chip; carbon never glows */
  .sgm .sgm-hard{position:absolute;z-index:40;transform:translate(-50%,-100%);pointer-events:none;
    max-width:300px;width:max-content;padding:6px 10px;border-radius:5px;
    font-family:ui-monospace,Menlo,monospace;font-size:.58rem;line-height:1.32;letter-spacing:.01em;
    color:#cfe6f6;text-align:left;
    background:radial-gradient(120% 140% at 50% 0%,#0a131c,#05080d 85%);
    border:1px solid rgba(14,196,252,.34);
    box-shadow:inset 0 0 0 1px rgba(0,0,0,.7),inset 0 6px 16px rgba(14,196,252,.12),0 4px 14px rgba(0,0,0,.55);
    opacity:0;transition:opacity .12s ease}
  .sgm .sgm-hard[data-flip="down"]{transform:translate(-50%,0)}
  .sgm .sgm-hard.on{opacity:1}
  .sgm .sgm-hard::after{content:"";position:absolute;left:50%;width:8px;height:8px;margin-left:-4px;
