/* TRUTH VISUALS — one rAF reads the REAL modulation signal (analyser tap):
   scope = a phosphor dot tracing the actual LFO (y is always the true sample);
   the filter CURVE itself is redrawn at the measured modulated cutoff — Ableton-style:
   the node anchors where the filter LIVES, the knee breathes around it. No slices, no bands. */
const scopeCv=$('#scopeCv'),sctx2=scopeCv.getContext('2d'),cycdot=$('#cycdot'),afghost=$('#afghost');
const lfoBuf=new Float32Array(256);
let lfoRaf=null,vizPh=0,vizLast=0,prevSamp=0,cycT=null;
function stopLfoAnim(){if(lfoRaf){cancelAnimationFrame(lfoRaf);lfoRaf=null;}
  sctx2.fillStyle='#05080e';sctx2.fillRect(0,0,scopeCv.width,scopeCv.height);
  afghost.style.opacity=0;}
function lfoFrame(ts){if(!live||!eng||eng.fx.amount<=0){stopLfoAnim();return;}
  const dt=vizLast?Math.min((ts-vizLast)/1000,.05):0;vizLast=ts;vizPh=(vizPh+eng.lfoRate*dt)%1;
  eng.lfoData(lfoBuf);const s=clamp(lfoBuf[lfoBuf.length-1]||0,-1,1);
  if(prevSamp<0&&s>=0){cycdot.classList.add('blip');clearTimeout(cycT);cycT=setTimeout(()=>cycdot.classList.remove('blip'),80);}
  prevSamp=s;
  const a=eng.fx.amount,W=scopeCv.width,H=scopeCv.height;
  sctx2.fillStyle='rgba(5,8,14,.3)';sctx2.fillRect(0,0,W,H);            // phosphor afterglow
  const x=vizPh*W,y=H/2-s*(H/2-9);
  sctx2.fillStyle='rgba(255,154,74,'+(.1+.25*a).toFixed(2)+')';sctx2.beginPath();sctx2.arc(x,y,7,0,7);sctx2.fill();
  sctx2.fillStyle='rgba(255,217,173,'+(.35+.65*a).toFixed(2)+')';sctx2.beginPath();sctx2.arc(x,y,2.6,0,7);sctx2.fill();
  const base=xToF(eng.fx.cutoff),depth=a*Math.min(base*0.85,4200);
  const cut=clamp(base+depth*s,FMIN,FMAX);
  const gys=curveYs(cut,QFor(eng.fx.res));                              // the GHOST breathes; the base curve stays still
  if(baseYs){
    let i0=0;while(i0<CPTS&&Math.abs(gys[i0]-baseYs[i0])<2)i0++;        // skip where ghost and base agree (the flat top)
    let iEnd=CPTS;while(iEnd>0&&baseYs[iEnd]>=VH-0.6)iEnd--;            // the base curve's right footprint — never draw past it
    let i1=Math.min(CPTS,iEnd+2);
    while(i1>i0&&gys[i1]>=VH-0.6&&baseYs[i1]>=VH-0.6)i1--;
    if(i1-i0>=2){afghost.setAttribute('d',ysPath(gys,i0,i1));afghost.style.opacity=(.06+.3*a).toFixed(2);}
    else afghost.style.opacity=0;}                                      // brightness law: same dial that drives the sound drives the light
  lfoRaf=requestAnimationFrame(lfoFrame);}
function startLfoAnim(){if(!lfoRaf&&live&&eng&&eng.fx.amount>0){vizLast=0;lfoRaf=requestAnimationFrame(lfoFrame);}}
drawFilter();

