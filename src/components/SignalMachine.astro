const vgainKnob=makeKnob($('#vgainKnob'),0.7,v=>{if(eng)eng.setLoopGain(v);});   // #4 GAIN: loop volume (repurposed from the cover knob)
let vcovVal=1;
function vcovRender(){const f=$('#vcovfill'),h=$('#vcovhandle'),vv=$('#vcovval');if(f)f.style.width=(vcovVal*100)+'%';if(h)h.style.left=(vcovVal*100)+'%';if(vv){const hz=Math.round(60*Math.pow(200,vcovVal));vv.textContent=vcovVal>=.97?'OPEN':vcovVal<=.04?'MUFFLED':(hz>=1000?(hz/1000).toFixed(1)+'k':hz+'Hz');}if(eng)eng.setLoopCover(vcovVal);}
(function(){const sl=$('#vcovslide');if(!sl)return;function at(e){const r=sl.getBoundingClientRect();vcovVal=clamp((e.clientX-r.left)/r.width,0,1);vcovRender();}   // #3 COVER drag-bar (mirrors DRUM COVER)
