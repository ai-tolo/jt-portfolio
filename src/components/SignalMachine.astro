  let curDrive=-1;
  function applyFx(){const t=ctx.currentTime;
    if(fx.drive!==curDrive){shaper.curve=driveCurve(fx.drive*fx.drive);curDrive=fx.drive;}   // rebuild only on change — swapping the curve per-note/per-drag zippers
    const fbBoost=fx.delay>0?({'16':.14,'8':.05,'8d':.05}[fx.delayDiv]||0):0;   // short divisions need more feedback to read as repeats
    dfb.gain.setTargetAtTime(gst.throw?.85:Math.min(.75,fx.delay*.6+fbBoost),t,.02);
    dmix.gain.setTargetAtTime(gst.throw?.55:Math.min(.6,fx.delay*.7),t,.05);
    const dt=delayTime();delL.delayTime.setTargetAtTime(dt,t,.03);delR.delayTime.setTargetAtTime(dt,t,.03);
    rmix.gain.setTargetAtTime(fx.reverb*.7,t,.02);
    if(voc)voc.tun.delayTime.setTargetAtTime((60/fx.tempo)*.75,t,.1);}   // TUNNEL stays tempo-synced
  function delayTime(){const beat=60/fx.tempo,m={'4':1,'8':.5,'8d':.75,'16':.25}[fx.delayDiv]||.5;return clamp(beat*m,.02,.98);}
  function apply(){applyMotion();applyFx();}
  function setRevSize(key){fx.revSize=key;const s=REVSIZES[key]||REVSIZES.med;const t=ctx.currentTime;
    rev.taps.forEach(tp=>{tp.d.delayTime.setTargetAtTime(tp.base*s.m,t,.08);tp.f.gain.setTargetAtTime(s.fb,t,.08);});}

  function nearest2(){const ds=VOICES.map((v,i)=>({i,d:Math.hypot(v.lm.x-fx.vx,v.lm.y-fx.vy)})).sort((a,b)=>a.d-b.d);const a=ds[0],b=ds[1],wa=1/(a.d+.05),wb=1/(b.d+.05),s=wa+wb;return{list:[{i:a.i,w:wa/s},{i:b.i,w:wb/s}],near:a.i};}
  let active=[];const MAXV=16;
  function buildNote(freq,vel,when){const t=when||ctx.currentTime+0.02,bl=nearest2().list,bright=Math.pow(2,(fx.vx-.5)*1.6),wide=1-fx.vy;
    const grp=ctx.createGain();grp.gain.value=0;grp.connect(inG);const oscs=[];
    bl.forEach(b=>{const V=VOICES[b.i];const vg=ctx.createGain();
      if(V.f){const bf=ctx.createBiquadFilter();bf.type=V.f.t;bf.frequency.value=clamp(V.f.hz*bright,80,16000);bf.Q.value=V.f.q;vg.connect(bf);bf.connect(grp);}else vg.connect(grp);
      const list=V.o.slice();if(wide>.6)list.push({t:V.o[0].t,d:(wide-.6)*30});vg.gain.value=b.w/Math.sqrt(list.length);
      list.forEach(o=>{const osc=ctx.createOscillator();osc.type=o.t;osc.frequency.value=o.oct?freq*Math.pow(2,o.oct):freq;osc.detune.value=(o.d||0)*(1+wide)+(Math.random()*8-4);osc._bd=osc.detune.value;if(gst.dive)osc.detune.value=osc._bd-2400;osc.connect(vg);osc.start(t);oscs.push(osc);});});
    const A=VOICES[bl[0].i].a,R=clamp(VOICES[bl[0].i].r,.14,.9),PEAK=0.2*(vel||1),SUS=PEAK*0.7;
    grp.gain.setValueAtTime(0,t);grp.gain.linearRampToValueAtTime(PEAK,t+A+.006);grp.gain.linearRampToValueAtTime(SUS,t+A+.16);
    const v={grp,oscs,R,heldNote:false,released:false,release(){if(v.released)return;v.released=true;const rt=ctx.currentTime+0.015;
      if(grp.gain.cancelAndHoldAtTime)grp.gain.cancelAndHoldAtTime(rt);else{grp.gain.cancelScheduledValues(rt);grp.gain.setValueAtTime(Math.max(grp.gain.value,0.0001),rt);}
      grp.gain.linearRampToValueAtTime(0,rt+v.R);oscs.forEach(o=>{try{o.stop(rt+v.R+.05)}catch(e){}});if(oscs[0])oscs[0].onended=()=>{try{grp.disconnect()}catch(e){}const k=active.indexOf(v);if(k>=0)active.splice(k,1);};}};
    active.push(v);
    if(active.length>MAXV){let i=active.findIndex(x=>!x.released&&!x.heldNote);if(i<0)i=active.findIndex(x=>!x.released);if(i<0)i=0;
      const old=active.splice(i,1)[0];old&&old.release&&old.release();}
    return v;}
  function pluck(freq,vel,life,when){const v=buildNote(freq,vel,when);const lead=when?Math.max(0,(when-ctx.currentTime)*1000):0;setTimeout(()=>v.release(),Math.max(60,lead+(life||150)));return v;}

  /* held-note model — held: id → {vs:[voices]|null, freq} */
  const held=new Map();let arpOn=false,latch=false,arpSet=new Map(),arpIdx=0,arpBeat=null;
  function releaseHeldVoices(h){if(h&&h.vs){h.vs.forEach(v=>v.release());h.vs=null;}}
  function noteOn(id,freq){
    lastNoteF=freq;
    if(arpOn){
      if(latch&&arpSet.has(id)){arpSet.delete(id);held.set(id,{vs:null,freq});recomputeBass();return;}   // tap-again removes
      arpSet.set(id,freq);held.set(id,{vs:null,freq});recomputeBass();return;}
    if(held.has(id))return;apply();
    const vs=[buildNote(freq,0.9)];vs.forEach(v=>v.heldNote=true);held.set(id,{vs,freq});recomputeBass();}
  function noteOff(id){const h=held.get(id);
    if(arpOn){held.delete(id);if(!latch)arpSet.delete(id);releaseHeldVoices(h);recomputeBass();return;}
    releaseHeldVoices(h);held.delete(id);recomputeBass();}
  function setArp(on){
    if(on&&!arpOn){held.forEach((h,id)=>{releaseHeldVoices(h);if(h&&h.freq!=null)arpSet.set(id,h.freq);});arpOn=true;arpIdx=0;nextArpT=ctx.currentTime+0.05;apply();clockEnsure();recomputeBass();}
    else if(!on&&arpOn){arpOn=false;arpSet.clear();held.forEach(h=>releaseHeldVoices(h));held.clear();clockStopIfIdle();recomputeBass();}}
  function setLatch(on){latch=on;if(!on){[...arpSet.keys()].forEach(k=>{if(!held.has(k))arpSet.delete(k);});}}

  /* ── performance gestures (momentary; all release paths click-free) ── */
  const gst={lift:false,gate:false,throw:false,fill:false,dive:false};
  let gPrevPat='floor',gateNextT=0;
  function gesture(name,on){on=!!on;if(gst[name]===on)return;gst[name]=on;const t=ctx.currentTime;
    if(name==='lift'){
      if(masterHP.frequency.cancelAndHoldAtTime)masterHP.frequency.cancelAndHoldAtTime(t);else masterHP.frequency.cancelScheduledValues(t);
      if(on){masterHP.frequency.setTargetAtTime(900,t,1.1);masterHP.Q.setTargetAtTime(1.25,t,.4);}        // slow asymptotic build while held
      else{masterHP.frequency.setTargetAtTime(20,t,.12);masterHP.Q.setTargetAtTime(.707,t,.3);}}          // fast drop = the payoff
    else if(name==='gate'){
      if(on){const sd=60/fx.tempo/4;let g=fx.beat?nextDrumT:t+0.02;while(g-sd>=t+0.02)g-=sd;gateNextT=Math.max(g,t+0.02);clockEnsure();}
      else{if(ampTrem.gain.cancelAndHoldAtTime)ampTrem.gain.cancelAndHoldAtTime(t);else ampTrem.gain.cancelScheduledValues(t);ampTrem.gain.setTargetAtTime(1,t,.03);clockStopIfIdle();}}
    else if(name==='throw'){applyFx();}
    else if(name==='fill'){
      if(on){if(fx.beat){gPrevPat=fx.pattern;fx.pattern='break';}else gst.fill=false;}
      else fx.pattern=gPrevPat;}
    else if(name==='dive'){const tau=on?.45:.07;
      active.forEach(v=>v.oscs.forEach(o=>{if(o._bd!=null)o.detune.setTargetAtTime(on?o._bd-2400:o._bd,t,tau);}));
      if(droneParts)droneParts.forEach(p=>p.o.detune.setTargetAtTime(on?(p.o._bd||0)-2400:(p.o._bd||0),t,tau));}}
  function gestureReset(){if(gst.fill)gesture('fill',false);if(gst.dive)gesture('dive',false);
    gst.lift=gst.gate=gst.throw=false;const t=ctx.currentTime;
    if(ampTrem.gain.cancelAndHoldAtTime)ampTrem.gain.cancelAndHoldAtTime(t);else ampTrem.gain.cancelScheduledValues(t);
    ampTrem.gain.setTargetAtTime(1,t,.03);
    masterHP.frequency.setTargetAtTime(20,t,.05);masterHP.Q.setTargetAtTime(.707,t,.05);}

  /* drums: kick + snare + hat → 2-stage LP cover → drumBus */
  const nbuf=(()=>{const len=Math.floor(ctx.sampleRate*0.15),b=ctx.createBuffer(1,len,ctx.sampleRate),d=b.getChannelData(0);for(let i=0;i<len;i++)d[i]=Math.random()*2-1;return b;})();
  const drumLP1=ctx.createBiquadFilter();drumLP1.type='lowpass';drumLP1.frequency.value=fx.drumCover;drumLP1.Q.value=0.6;
  const drumLP2=ctx.createBiquadFilter();drumLP2.type='lowpass';drumLP2.frequency.value=fx.drumCover;drumLP2.Q.value=0.6;
  drumLP1.connect(drumLP2);drumLP2.connect(drumBus);
  const counts={k:0,s:0,h:0,b:0};
  function noiseBurst(t,filterType,filterHz,q,peak,dur){const nb=ctx.createBufferSource();nb.buffer=nbuf;
    const nf=ctx.createBiquadFilter();nf.type=filterType;nf.frequency.value=filterHz;nf.Q.value=q;
    const ng=ctx.createGain();ng.gain.setValueAtTime(peak,t);ng.gain.exponentialRampToValueAtTime(.002,t+dur);ng.gain.linearRampToValueAtTime(0,t+dur+.008);
    nb.connect(nf);nf.connect(ng);ng.connect(drumLP1);nb.start(t);nb.stop(t+dur+.02);}
  function kick(t){counts.k++;
    const o=ctx.createOscillator();o.type='sine';o.frequency.setValueAtTime(160,t);o.frequency.exponentialRampToValueAtTime(44,t+.1);
    const g=ctx.createGain();g.gain.setValueAtTime(.0001,t);g.gain.exponentialRampToValueAtTime(.9,t+.005);g.gain.exponentialRampToValueAtTime(.02,t+.18);g.gain.linearRampToValueAtTime(0,t+.205);
    o.connect(g);g.connect(drumLP1);o.start(t);o.stop(t+.22);
    noiseBurst(t,'bandpass',3400,0.8,.3,.025);}
  function snare(t){counts.s++;
    noiseBurst(t,'bandpass',1800,0.9,.5,.11);
    const o=ctx.createOscillator();o.type='triangle';o.frequency.setValueAtTime(190,t);o.frequency.exponentialRampToValueAtTime(130,t+.08);
    const g=ctx.createGain();g.gain.setValueAtTime(.28,t);g.gain.exponentialRampToValueAtTime(.005,t+.1);g.gain.linearRampToValueAtTime(0,t+.11);
    o.connect(g);g.connect(drumLP1);o.start(t);o.stop(t+.12);}
  function hat(t){counts.h++;noiseBurst(t,'highpass',7200,0.7,.16,.035);}
  function duckHit(t){const beat=60/fx.tempo;
    if(duck.gain.cancelAndHoldAtTime)duck.gain.cancelAndHoldAtTime(t);   // no step when the previous recovery is mid-flight
    else{duck.gain.cancelScheduledValues(t);duck.gain.setValueAtTime(duck.gain.value,t);}
    duck.gain.linearRampToValueAtTime(.34,t+.008);duck.gain.setTargetAtTime(1,t+.012,Math.min(beat*0.3,.18));}

  /* ── master clock: ONE 25ms lookahead scheduler drives beat AND arp on absolute ctx time (no drift, no divergence) ── */
  let clockT=null,nextDrumT=0,drumStep=0,nextArpT=0,kickCb=null;
  const LOOK=0.1;
  function visAt(t,cb){if(!cb)return;setTimeout(cb,Math.max(0,(t-ctx.currentTime)*1000));}
  function clockTick(){const now=ctx.currentTime;
    if(fx.beat){const stepDur=60/fx.tempo/4;
      while(nextDrumT<now+LOOK){const t=nextDrumT,P=PATTERNS[fx.pattern]||PATTERNS.floor,st=drumStep%16;
        if(P.k.includes(st)){kick(t);duckHit(t);visAt(t,kickCb);if(fx.bass)bassHit(t);}
        if(P.s.includes(st))snare(t);
        if(P.h.includes(st))hat(t);
        drumStep++;nextDrumT+=stepDur;}}
    if(arpOn){const tickDur=60/fx.tempo/fx.arpDiv;
      while(nextArpT<now+LOOK){const t=nextArpT,fs=[...arpSet.values()].sort((a,b)=>a-b);
        if(fs.length){const f=fs[arpIdx%fs.length];const life=tickDur*1000*clamp(fx.gate,.2,1);
          pluck(f,0.9,life,t);visAt(t,arpBeat);arpIdx++;}
        else arpIdx=0;
        nextArpT+=tickDur;}}
    if(gst.gate){const sd=60/fx.tempo/4;   // GATE: 16th chops on the held chord, scheduled ahead, grid-locked
      while(gateNextT<now+LOOK){const t=gateNextT;
        ampTrem.gain.setValueAtTime(1,t);ampTrem.gain.linearRampToValueAtTime(.06,t+.012);
        ampTrem.gain.setValueAtTime(.06,t+sd*.55);ampTrem.gain.linearRampToValueAtTime(1,t+sd*.9);
        gateNextT+=sd;}}
    clockT=setTimeout(clockTick,25);}
  function clockEnsure(){if(!clockT&&(fx.beat||arpOn||gst.gate))clockTick();}
  function clockStopIfIdle(){if(clockT&&!fx.beat&&!arpOn&&!gst.gate){clearTimeout(clockT);clockT=null;}}
  function setBeat(on){fx.beat=on;
    if(on){drumStep=0;nextDrumT=ctx.currentTime+0.05;clockEnsure();if(fx.bass)droneOff();}
    else{clockStopIfIdle();const t=ctx.currentTime;duck.gain.cancelScheduledValues(t);duck.gain.setTargetAtTime(1,t,.05);if(fx.bass)droneOn();}}
  function setCover(hz){fx.drumCover=hz;const t=ctx.currentTime;drumLP1.frequency.setTargetAtTime(hz,t,.03);drumLP2.frequency.setTargetAtTime(hz,t,.03);}

  /* bass — follows the last played note */
  /* bass voice: sub sine always; detuned saws BLEND IN with INTENSITY (heat), which also opens the LP.
     heat 0 = the round sub. heat 1 = full saturated buzz. Default low — the buzz is the reward, not the start. */
  const bassDrive=ctx.createWaveShaper();bassDrive.curve=driveCurve(.55);bassDrive.oversample='2x';
  const heatLP=v=>200*Math.pow(30,clamp(v,0,1));                       // 200 Hz → 6 kHz
  const sawGain=v=>.5*Math.pow(clamp(v,0,1),1.4);                      // gentle taper — low intensity stays a clean sub
  const bassLP=ctx.createBiquadFilter();bassLP.type='lowpass';bassLP.frequency.value=heatLP(fx.bassHeat);bassLP.Q.value=0.7;
  const bassOut=ctx.createGain();bassOut.gain.value=.85;
  bassDrive.connect(bassLP);bassLP.connect(bassOut);bassOut.connect(glue);
  const BASS_OSCS=[['sawtooth',1,0],['sawtooth',1,8],['sine',.5,0]];   // [type, freq multiple, detune¢]
  let bassTarget=65.4,lastNoteF=261.63; // C2 default
  const foldBass=f=>{f=f/2;while(f>115)f/=2;while(f<45)f*=2;return f;};
  let droneParts=null,droneGain=null;
  /* bass tracks the LOWEST held/latched note (the chord root) — last-played only as fallback */
  function recomputeBass(){const c=(arpOn&&arpSet.size)?[...arpSet.values()]:[...held.values()].map(h=>h&&h.freq).filter(Boolean);
    bassTarget=foldBass(c.length?Math.min(...c):lastNoteF);
    if(droneParts)droneParts.forEach(p=>p.o.frequency.setTargetAtTime(bassTarget*(p.o._mul||1),ctx.currentTime,.08));}
  function bassFollow(freq){lastNoteF=freq;recomputeBass();}
  function bassHit(t){counts.b++;const len=clamp(60/fx.tempo*0.45,.12,.4);
    const env=ctx.createGain();env.gain.setValueAtTime(.0001,t);env.gain.exponentialRampToValueAtTime(.55,t+.008);env.gain.exponentialRampToValueAtTime(.012,t+len);env.gain.linearRampToValueAtTime(0,t+len+.02);
    env.connect(bassDrive);
    const base=gst.dive?bassTarget/4:bassTarget;
    BASS_OSCS.forEach(s=>{const o=ctx.createOscillator();o.type=s[0];o.frequency.value=base*s[1];o.detune.value=s[2];o._bd=s[2];
      const g=ctx.createGain();g.gain.value=s[0]==='sine'?.7:sawGain(fx.bassHeat);o.connect(g);g.connect(env);o.start(t);o.stop(t+len+.04);});}
  function droneOn(){if(droneParts)return;droneGain=ctx.createGain();droneGain.gain.value=0;droneGain.connect(bassDrive);
    droneParts=BASS_OSCS.map(s=>{const o=ctx.createOscillator();o.type=s[0];o.frequency.value=bassTarget*s[1];o._mul=s[1];o.detune.value=s[2]+(gst.dive?-2400:0);o._bd=s[2];
      const g=ctx.createGain();g.gain.value=s[0]==='sine'?.7:sawGain(fx.bassHeat);o.connect(g);g.connect(droneGain);o.start();return {o,g,saw:s[0]==='sawtooth'};});
    droneGain.gain.setTargetAtTime(.2,ctx.currentTime,.25);}
  function droneOff(){if(!droneParts)return;const ps=droneParts,g=droneGain;droneParts=null;droneGain=null;
    const t=ctx.currentTime;g.gain.setTargetAtTime(0,t,.12);setTimeout(()=>{ps.forEach(p=>{try{p.o.stop()}catch(e){}});},500);}
  function setBass(on){fx.bass=on;if(on){if(!fx.beat)droneOn();}else droneOff();}
  function setBassHeat(v){fx.bassHeat=clamp(v,0,1);const t=ctx.currentTime;
    bassLP.frequency.setTargetAtTime(heatLP(fx.bassHeat),t,.04);
    if(droneParts)droneParts.forEach(p=>{if(p.saw)p.g.gain.setTargetAtTime(sawGain(fx.bassHeat),t,.05);});}

  /* VOICE IN: its own treatment rack — parallel pre-built branches, crossfade gains only (never reconnect live).
     Routed into glue (so the voice gets the kick sidechain + LIFT) but NOT through the synth filter/drive. */
  let micStream=null,micGain=null,micPromise=null,voc=null,micTap=null;
  function buildVocalRack(){
    const bus=ctx.createGain();bus.gain.value=1;bus.connect(glue);
    const dryG=ctx.createGain();dryG.gain.value=1;micGain.connect(dryG);dryG.connect(bus);
    const mkOut=()=>{const g=ctx.createGain();g.gain.value=0;g.connect(bus);return g;};
    // TELEPHONE: tight band + a little grit
    const telHP=ctx.createBiquadFilter();telHP.type='highpass';telHP.frequency.value=420;
    const telLP=ctx.createBiquadFilter();telLP.type='lowpass';telLP.frequency.value=2700;
    const telWS=ctx.createWaveShaper();telWS.curve=driveCurve(.25);
    const telG=mkOut();micGain.connect(telHP);telHP.connect(telLP);telLP.connect(telWS);telWS.connect(telG);
    // Loop branches (HALL/DOUBLE/TUNNEL) crossfade on the SEND side, not the output:
    // muted loops must not keep charging with mic audio (ghost replays) and a
    // deselected tail gets to ring out instead of being chopped.
    const mkSend=()=>{const g=ctx.createGain();g.gain.value=0;return g;};
    // HALL: the engine reverb, scaled big
    const hall=makeReverb(ctx);hall.taps.forEach(tp=>{tp.d.delayTime.value=tp.base*2.4;tp.f.gain.value=.84;});
    const hallG=mkSend();micGain.connect(hallG);hallG.connect(hall.input);hall.output.connect(bus);
    // DOUBLE: 110 ms slap
    const slap=ctx.createDelay(.5);slap.delayTime.value=.11;const slapFb=ctx.createGain();slapFb.gain.value=.22;
    slap.connect(slapFb);slapFb.connect(slap);
    const dblG=mkSend();micGain.connect(dblG);dblG.connect(slap);slap.connect(bus);
    // ROBOT: ring-mod at 85 Hz
    const ring=ctx.createGain();ring.gain.value=0;
    const rosc=ctx.createOscillator();rosc.frequency.value=85;rosc.connect(ring.gain);rosc.start();
    const robG=mkOut();micGain.connect(ring);ring.connect(robG);
    // AIR: thin + shelf sparkle
    const airHP=ctx.createBiquadFilter();airHP.type='highpass';airHP.frequency.value=900;
    const airSh=ctx.createBiquadFilter();airSh.type='highshelf';airSh.frequency.value=4500;airSh.gain.value=9;
    const airG=mkOut();micGain.connect(airHP);airHP.connect(airSh);airSh.connect(airG);
    // TUNNEL: tempo-synced dotted-8th feedback delay, damped (send-side crossfade, see above)
    const tun=ctx.createDelay(1.5);tun.delayTime.value=(60/fx.tempo)*.75;
    const tunDamp=ctx.createBiquadFilter();tunDamp.type='lowpass';tunDamp.frequency.value=2000;
    const tunFb=ctx.createGain();tunFb.gain.value=.55;
    tun.connect(tunDamp);tunDamp.connect(tunFb);tunFb.connect(tun);
    const tunG=mkSend();micGain.connect(tunG);tunG.connect(tun);tun.connect(bus);
    voc={bus,dryG,wets:{telephone:telG,hall:hallG,double:dblG,robot:robG,air:airG,tunnel:tunG},tun,rosc,treat:'dry',depth:0};}
  /* dry law by effect CLASS: TELEPHONE/ROBOT/AIR TRANSFORM the voice (true crossfade —
     leaked dry turns robot into mud); HALL/DOUBLE/TUNNEL ADD to it (dry stays nearly
     full and the space rides on top — cutting dry made them hollow, "off"). */
  const VOC_ADDITIVE={hall:1,double:1,tunnel:1};
  function setVocal(treat,depth){if(!voc)return;voc.treat=treat;voc.depth=clamp(depth,0,1);const t=ctx.currentTime;
    const wet=treat==='dry'?0:voc.depth;
    const dry=treat==='dry'?1:(VOC_ADDITIVE[treat]?1-wet*.25:1-wet);
    voc.dryG.gain.setTargetAtTime(Math.max(0,dry),t,.05);
    Object.entries(voc.wets).forEach(([k,g])=>g.gain.setTargetAtTime(k===treat?wet:0,t,.05));}
  function micOn(){if(micStream)return Promise.resolve(true);if(micPromise)return micPromise;
    // music-app mic: ALL browser processing off — echoCancellation treats your own
    // monitored voice as echo and eats it; noiseSuppression chews sustained tones.
    micPromise=navigator.mediaDevices.getUserMedia({audio:{echoCancellation:false,noiseSuppression:false,autoGainControl:false}})
      .then(s=>{micStream=s;const src=ctx.createMediaStreamSource(s);const hp=ctx.createBiquadFilter();hp.type='highpass';hp.frequency.value=90;
        const comp=ctx.createDynamicsCompressor();comp.threshold.value=-18;comp.ratio.value=6;comp.attack.value=.003;comp.release.value=.15;
        micGain=ctx.createGain();micGain.gain.value=0;src.connect(hp);hp.connect(comp);comp.connect(micGain);
        micTap=ctx.createAnalyser();micTap.fftSize=256;micGain.connect(micTap);
        buildVocalRack();setVocal('dry',0);
        micGain.gain.setTargetAtTime(0.6,ctx.currentTime,0.3);return true;})   // a notch lower now that AEC is off (feedback headroom)
      .catch(()=>false).finally(()=>{micPromise=null;});
    return micPromise;}
  function micOff(){if(micStream){micStream.getTracks().forEach(t=>t.stop());micStream=null;}
    // fade THEN disconnect (the droneOff pattern) — an instant cut clicks and chops reverb/echo tails
    const g=micGain,v=voc;micGain=null;voc=null;micTap=null;
    if(g||v){const t=ctx.currentTime;
      if(g)g.gain.setTargetAtTime(0,t,.02);
      if(v)v.bus.gain.setTargetAtTime(0,t,.025);
      setTimeout(()=>{if(g){try{g.disconnect()}catch(e){}}
        if(v){try{v.bus.disconnect()}catch(e){}try{v.rosc.stop()}catch(e){}}},180);}}
  const micBuf=new Float32Array(256);
  function micLevel(){if(!micTap)return 0;micTap.getFloatTimeDomainData(micBuf);let m=0;for(let i=0;i<micBuf.length;i++){const a=Math.abs(micBuf[i]);if(a>m)m=a;}return m;}

  return {fx,apply,getCtx:()=>ctx,nearestVoice:()=>nearest2().near,noteOn,noteOff,
    setArp,setLatch,get arpOn(){return arpOn;},get arpNotes(){return arpSet.size;},get activeVoices(){return active.length;},
    get latchedIds(){return (arpOn&&latch)?[...arpSet.keys()]:[];},onArp:cb=>{arpBeat=cb;},
    setBeat,onKick:cb=>{kickCb=cb;},setCover,setBass,setBassHeat,setRevSize,get drumCounts(){return {...counts};},get bassFreq(){return bassTarget;},get droneActive(){return !!droneParts;},
    get lfoRate(){return lfoHz();},lfoData:buf=>lfoTap.getFloatTimeDomainData(buf),
    gesture,get gestures(){return {...gst};},get liftHz(){return masterHP.frequency.value;},
    micOn,micOff,setVocal,get vocal(){return voc?{treat:voc.treat,depth:voc.depth}:null;},micLevel,
    kill:()=>{held.forEach(h=>{if(h&&h.vs)h.vs.forEach(v=>v.release());});held.clear();arpSet.clear();arpOn=false;latch=false;fx.beat=false;
      gestureReset();
      if(clockT){clearTimeout(clockT);clockT=null;}
      const t=ctx.currentTime;duck.gain.cancelScheduledValues(t);duck.gain.setTargetAtTime(1,t,.05);
      droneOff();fx.bass=false;micOff();}};   // NOTE: the LFO stays connected — disconnecting it here killed modulation for good on re-power
}

/* ════════ WIRING ════════ */
const device=$('#device');let eng=null,live=false;

/* piano */
const WK=[{q:'a',o:0},{q:'s',o:2},{q:'d',o:4},{q:'f',o:5},{q:'g',o:7},{q:'h',o:9},{q:'j',o:11},{q:'k',o:12},{q:'l',o:14}];
const BK=[{q:'w',o:1,after:0},{q:'e',o:3,after:1},{q:'t',o:6,after:3},{q:'y',o:8,after:4},{q:'u',o:10,after:5},{q:'o',o:13,after:7},{q:'p',o:15,after:8}];
const WHITE_OFFS=WK.map(k=>k.o);let octOff=0,scaleLock=true;
const piano=$('#piano');
function baseC(){return 261.63*Math.pow(2,octOff);}
function snapOffset(o){if(!scaleLock)return o;if(WHITE_OFFS.includes(o))return o;let best=WHITE_OFFS[0];WHITE_OFFS.forEach(w=>{if(Math.abs(w-o)<Math.abs(best-o))best=w;});return best;}
function freqForOffset(o){return baseC()*Math.pow(2,snapOffset(o)/12);}
function noteName(o){return NOTE_NAMES[((o%12)+12)%12]+(4+octOff+Math.floor(o/12));}
WK.forEach(k=>{const el=document.createElement('div');el.className='wkey';el.dataset.q=k.q;el.dataset.o=k.o;el.innerHTML=`<span class="ql">${k.q.toUpperCase()}</span><span class="nl">${NOTE_NAMES[k.o%12]}</span>`;piano.appendChild(el);});
const wW=100/WK.length;BK.forEach(k=>{const el=document.createElement('div');el.className='bkey';el.dataset.q=k.q;el.dataset.o=k.o;el.style.left=`calc(${(k.after+1)*wW}% - 2.6%)`;el.innerHTML=`<span class="ql">${k.q.toUpperCase()}</span>`;piano.appendChild(el);});
function keyEl(q){return piano.querySelector(`[data-q="${q}"]`);}
function lightKey(q,on){const el=keyEl(q);if(el)el.classList.toggle('press',on);}
function refreshLatch(){const ids=eng?eng.latchedIds:[];piano.querySelectorAll('.latched').forEach(el=>el.classList.remove('latched'));
  ids.forEach(id=>{const el=keyEl(id.slice(1));if(el)el.classList.add('latched');});}
function showNote(o){$('#notebig').textContent=noteName(o);}
function pressOffset(q,o){if(!live||!eng)return;eng.noteOn('k'+q,freqForOffset(o));lightKey(q,true);showNote(snapOffset(o));refreshLatch();
  const sp=$('#spill'),kel=keyEl(q);
  if(sp&&kel){sp.style.transform='translateX('+(kel.offsetLeft+kel.offsetWidth/2)+'px)';sp.classList.add('on');clearTimeout(sp._t);sp._t=setTimeout(()=>sp.classList.remove('on'),140);}}
function releaseOffset(q){if(!eng)return;eng.noteOff('k'+q);lightKey(q,false);refreshLatch();}
piano.querySelectorAll('.wkey,.bkey').forEach(el=>{const q=el.dataset.q,o=+el.dataset.o;
  el.addEventListener('pointerdown',e=>{e.preventDefault();pressOffset(q,o);try{el.setPointerCapture(e.pointerId)}catch(_){}});
  el.addEventListener('pointerup',()=>releaseOffset(q));el.addEventListener('pointercancel',()=>releaseOffset(q));
  el.addEventListener('pointerleave',e=>{if(e.buttons)releaseOffset(q);});});
const QO={};WK.concat(BK).forEach(k=>QO[k.q]=k.o);const downq={};
window.addEventListener('keydown',e=>{const k=e.key.toLowerCase();
  if(e.key==='ArrowLeft'){if(!live||!inView)return;e.preventDefault();setOct(octOff-1);return;}
  if(e.key==='ArrowRight'){if(!live||!inView)return;e.preventDefault();setOct(octOff+1);return;}
  if(QO[k]==null||e.repeat||downq[k]||!live||!inView)return;downq[k]=1;pressOffset(k,QO[k]);});
window.addEventListener('keyup',e=>{const k=e.key.toLowerCase();if(QO[k]==null)return;downq[k]=0;releaseOffset(k);});
