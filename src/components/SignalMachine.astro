/* GLIDE knob — continuous drone portamento: 0 = snap (mode 'off'), >0 = slur (mode 'glide'). Maps 0..1 → 0.008..0.30s. Default 0 (snap). */
let bassRateIdx=2;        // default 1/8  (engine PULSE_MULT[2]=2 sixteenth-steps) — the pluck's base subdivision; the seq RATE rail multiplies it via bassSeqMult
let bassGlideV=0;         // 0..1 GLIDE knob position; default 0 = snap
const glideTauFromV=v=>0.008+v*0.292;   // 0..1 → 0.008..0.30s
const GLIDE_DEAD=0.03;    // dead-zone near 0 → treat as snap (mode 'off')
const bglideKnob=makeKnob($('#bglideKnob'),0,v=>{if(!eng)return;bassGlideV=v;const tau=glideTauFromV(v);eng.setBassGlide(tau);
  if(eng.bassMode!=='pluck'){const want=v>GLIDE_DEAD?'glide':'off';if(eng.bassMode!==want){eng.setBassMode(want);}}   // guard mode-churn: only switch on an actual change, dead-zone near 0 snaps
});
/* MOVE knob — tempo-synced bass filter wobble (was PLUCK): 0 = clean sustained sub · up = rhythmic filter movement, deepening to a wub. Drives fx.bassPluck → applyBassMove (field name kept to preserve save/share snapshots). */
const bpluckKnob=makeKnob($('#bpluckKnob'),0,v=>{if(eng)eng.setBassPluck(v);});
/* PLUCK step-sequencer PARKED (Jon 2026-06-15): all wiring below + the readout-seq driver + the engine bassSeq are intact but NOT reachable in the live UI. Revive = flip PLUCK_ENABLED to true and drop `hidden` on #pluckBtn. */
const PLUCK_ENABLED=false;
/* PLUCK toggle — armed → mode 'pluck' + open the readout sequencer; off → restore drone from the GLIDE knob + close the sequencer. */
const pluckBtn=$('#pluckBtn');
function setPluckUI(on){if(!pluckBtn)return;pluckBtn.classList.toggle('on',on);pluckBtn.setAttribute('aria-pressed',on?'true':'false');
  if(on){if(eng)eng.setBassMode('pluck');readoutSeqOpen();}
  else{if(eng)eng.setBassMode(bassGlideV>GLIDE_DEAD?'glide':'off');readoutSeqClose();}}
