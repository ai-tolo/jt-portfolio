let CTX=null;const getCtx=()=>CTX||(CTX=new (window.AudioContext||window.webkitAudioContext)());
function driveCurve(a){const k=a*55,n=256,c=new Float32Array(n);for(let i=0;i<n;i++){const x=i/(n-1)*2-1;c[i]=(1+k)*x/(1+k*Math.abs(x));}return c;}
