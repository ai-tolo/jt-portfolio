---
// A work in the gallery, hung like a piece in a museum. Each piece has its OWN
// shape and frame (arch / oval / circle / hexagon / pointed-arch — by catalog
// number) so the wall never reads as a grid. The art hangs from a wire; a small
// placard sits on the wall beneath it, and leaning in (hover / focus) opens the
// placard with the pitch + credits. Self-contained dark object → reads on any
// background. Reveal-on-scroll is wired in index.astro and keys off `.we`.

interface Props {
  index: number;
  name: string;
  subtitle: string;
  outcome: string;
  role?: string;
  timeline?: string;
  tools?: string[];
  tags: string[];
  slug: string;
  cover?: string | null;
  featured?: boolean;
}

const { index, name, subtitle, role, timeline, tags, slug, cover, featured = false } = Astro.props;
const num = String(index).padStart(2, "0");
const credit = [role, timeline].filter(Boolean).join("  ·  ");
---

<a
  class:list={["we", { "we-featured": featured }]}
  href={`/case-studies/${slug}`}
  data-frame={((index - 1) % 5) + 1}
  aria-label={`View case study: ${name} — ${subtitle}`}
>
  <span class="we-hang" aria-hidden="true">
    <span class="we-nail"></span>
    <svg class="we-wire-svg" viewBox="0 0 100 46" preserveAspectRatio="none">
      <path class="we-wire" d="M50 4 L40 44 M50 4 L60 44" vector-effect="non-scaling-stroke"></path>
    </svg>
  </span>

  <div class="we-art">
    {cover ? (
      <img class="we-cover" src={cover} alt="" loading="lazy" />
    ) : (
      <div class="we-cover we-cover-empty"></div>
    )}
  </div>

  <div class="we-placard">
    <h2 class="we-name">{name}</h2>
    <div class="we-reveal">
      <div class="we-reveal-inner">
        <p class="we-pitch">{subtitle}</p>
        {(credit || tags.length > 0) && (
          <div class="we-credits">
            {credit && <span class="we-credit">{credit}</span>}
            {tags.length > 0 && (
              <ul class="we-tags">{tags.slice(0, 3).map((t) => <li>{t}</li>)}</ul>
            )}
          </div>
        )}
        <span class="we-view">
          <span>View case study</span>
          <span class="we-view-arrow" aria-hidden="true">→</span>
        </span>
      </div>
    </div>
  </div>
</a>

<style>
  .we {
    display: block;
    position: relative;
    padding-top: 2.6rem;
    text-decoration: none;
    color: #f5f1e8;
    opacity: 0;
    transform: translateY(22px);
  }
  .we.we-in {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 820ms cubic-bezier(0.2, 0, 0, 1), transform 820ms cubic-bezier(0.2, 0, 0, 1);
  }

  /* hanging hardware */
  .we-hang { position: absolute; top: 0; left: 0; right: 0; height: 2.6rem; pointer-events: none; z-index: 2; }
  .we-nail { position: absolute; top: 2px; left: 50%; width: 6px; height: 6px; margin-left: -3px; border-radius: 50%; background: rgba(245, 241, 232, 0.55); box-shadow: 0 1px 2px rgba(0, 0, 0, 0.6); }
  .we-wire-svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .we-wire { fill: none; stroke: rgba(245, 241, 232, 0.32); stroke-width: 1.25; transition: stroke 420ms ease; }
  .we:has(.we-art:hover) .we-wire, .we:focus-visible .we-wire { stroke: color-mix(in srgb, var(--accent) 70%, rgba(245, 241, 232, 0.3)); }
  .we:has(.we-art:hover) .we-nail, .we:focus-visible .we-nail { background: var(--accent); }

  /* THE ART — each piece its own shape + an ornate, built-up frame. The image
     sits inside like a canvas; on hover a flashlight falls across it — it lights
     up IN PLACE (no zoom, no lift), so it stays a real object on the wall. */
  .we-art {
    --fw: 16px; /* frame width — set per piece; drives the image inset + size */
    position: relative;
    width: 100%;
    max-width: 19rem;
    margin: 0 auto;
    aspect-ratio: 1 / 1;
    background: #b0934f;
    filter: drop-shadow(0 24px 30px rgba(0, 0, 0, 0.55));
  }
  .we-featured .we-art { max-width: 46rem; }
  /* the flashlight: a warm beam that fades in over the canvas on hover */
  .we-art::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background: radial-gradient(120% 95% at 50% 32%, rgba(255, 246, 224, 0), rgba(255, 246, 224, 0) 70%);
    opacity: 0;
    transition: opacity 520ms ease, background 520ms ease;
  }
  .we:has(.we-art:hover) .we-art::after,
  .we:focus-visible .we-art::after {
    opacity: 1;
    background: radial-gradient(120% 95% at 50% 30%, rgba(255, 246, 224, 0.28), rgba(255, 246, 224, 0) 58%);
  }
  .we:focus-visible { outline: none; }
  .we:focus-visible .we-art { filter: drop-shadow(0 24px 30px rgba(0, 0, 0, 0.55)) drop-shadow(0 0 0 3px var(--accent)); }

  .we-cover {
    position: absolute;
    inset: var(--fw);
    width: calc(100% - 2 * var(--fw));
    height: calc(100% - 2 * var(--fw));
    object-fit: cover;
    object-position: center;
    filter: brightness(0.78) saturate(0.9); /* dim, like an unlit canvas */
    transition: filter 620ms ease;
  }
  .we:has(.we-art:hover) .we-cover,
  .we:focus-visible .we-cover { filter: brightness(1.16) saturate(1.1) contrast(1.04); }
  .we-cover-empty { background: radial-gradient(120% 100% at 70% 0%, rgba(255, 90, 60, 0.18), transparent 60%), linear-gradient(160deg, #15121b, #0a0810); }

  /* ---- five pieces: shape, frame width, finish, built-up moulding ---- */
  /* 1 · the lead — a large rectangle in a heavy ornate gilt frame */
  .we[data-frame="1"] .we-art {
    --fw: 30px;
    aspect-ratio: 16 / 9;
    border-radius: 1px;
    background:
      repeating-linear-gradient(135deg, rgba(255, 240, 200, 0.1) 0 2px, transparent 2px 6px),
      linear-gradient(150deg, #e6c87c, #ad8a3b 48%, #6c5020);
    box-shadow:
      inset 0 0 0 2px #6c5020, inset 0 0 0 5px #ecd28a, inset 0 0 0 7px #574014,
      inset 0 0 0 10px #c9a85a, inset 0 0 0 12px #4f3a13;
  }
  .we[data-frame="1"] .we-cover { border-radius: 1px; box-shadow: inset 0 0 0 1.5px #3a2c10, inset 0 0 26px rgba(0, 0, 0, 0.42); }
  /* 2 · oval — ivory mat with concentric gold beads */
  .we[data-frame="2"] .we-art {
    --fw: 20px; aspect-ratio: 4 / 5; clip-path: ellipse(50% 50% at 50% 50%);
    background:
      repeating-radial-gradient(circle at 50% 50%, transparent 0 5px, rgba(170, 140, 75, 0.05) 5px 6px),
      linear-gradient(160deg, #f4efe0, #d2c9b2);
    box-shadow: inset 0 0 0 3px #c6ae72, inset 0 0 0 5px #efe7d2, inset 0 0 0 7px #b6975a;
  }
  .we[data-frame="2"] .we-cover { clip-path: ellipse(50% 50% at 50% 50%); box-shadow: inset 0 0 0 2px #b6975a; }
  /* 3 · circle — a deep carved-wood tondo, brass ring */
  .we[data-frame="3"] .we-art {
    --fw: 28px; aspect-ratio: 1 / 1; clip-path: circle(50% at 50% 50%);
    background:
      repeating-conic-gradient(from 0deg at 50% 50%, rgba(0, 0, 0, 0.18) 0deg 5deg, rgba(255, 210, 150, 0.05) 5deg 10deg),
      linear-gradient(160deg, #58391e, #29190d);
    box-shadow: inset 0 0 0 3px #150d07, inset 0 0 0 7px #9a7842, inset 0 0 0 9px #3a2616;
  }
  .we[data-frame="3"] .we-cover { clip-path: circle(50% at 50% 50%); box-shadow: inset 0 0 0 2px #9a7842; }
  /* 4 · octagon — faceted brass */
  .we[data-frame="4"] .we-art {
    --fw: 18px; aspect-ratio: 1 / 1;
    clip-path: polygon(29% 0, 71% 0, 100% 29%, 100% 71%, 71% 100%, 29% 100%, 0 71%, 0 29%);
    background: linear-gradient(135deg, #d8b46c, #9a7c3e 52%, #6c5421);
    box-shadow: inset 0 0 0 2px #5d4b27, inset 0 0 0 5px #d8b46c, inset 0 0 0 7px #6c5421;
  }
  .we[data-frame="4"] .we-cover { clip-path: polygon(29% 0, 71% 0, 100% 29%, 100% 71%, 71% 100%, 29% 100%, 0 71%, 0 29%); box-shadow: inset 0 0 0 1.5px #4a3c1f; }
  /* 5 · arched mirror — matte charcoal with a fine gold line */
  .we[data-frame="5"] .we-art {
    --fw: 16px; aspect-ratio: 5 / 6; border-radius: 50% 50% 7% 7% / 38% 38% 5% 5%;
    background:
      repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.018) 0 1px, transparent 1px 4px),
      linear-gradient(160deg, #423b4c, #201c27);
    box-shadow: inset 0 0 0 2px #141019, inset 0 0 0 4px #8a6d3a, inset 0 0 0 5.5px #141019;
  }
  .we[data-frame="5"] .we-cover { border-radius: 47% 47% 5% 5% / 34% 34% 4% 4%; box-shadow: inset 0 0 0 1.5px #8a6d3a; }

  /* The placard — on the wall beneath the art. */
  .we-placard {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 14px clamp(8px, 2vw, 20px) 0;
  }
  .we-name {
    margin: 0;
    font-family: "Space Grotesk Variable", "Space Grotesk", ui-sans-serif, system-ui, sans-serif;
    font-weight: 600;
    font-size: clamp(1rem, 1.7vw, 1.35rem);
    line-height: 1.12;
    letter-spacing: 0.01em;
    color: var(--text);
    background-image: linear-gradient(var(--accent), var(--accent));
    background-repeat: no-repeat;
    background-position: 50% 100%;
    background-size: 0% 1.5px;
    padding-bottom: 4px;
    transition: background-size 460ms cubic-bezier(0.2, 0, 0, 1);
  }
  .we:has(.we-art:hover) .we-name, .we:focus-visible .we-name { background-size: 100% 1.5px; }

  .we-reveal {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    width: 100%;
    max-width: 42ch;
    transition: grid-template-rows 460ms cubic-bezier(0.2, 0, 0, 1), opacity 360ms ease;
  }
  .we:has(.we-art:hover) .we-reveal, .we:focus-visible .we-reveal { grid-template-rows: 1fr; opacity: 1; }
  .we-reveal-inner { overflow: hidden; min-height: 0; display: flex; flex-direction: column; align-items: flex-start; text-align: left; gap: 10px; }

  .we-pitch {
    margin: 12px 0 0;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-style: italic;
    font-size: clamp(0.85rem, 1.2vw, 1.05rem);
    line-height: 1.45;
    color: color-mix(in srgb, var(--text) 88%, transparent);
  }
  .we-credits { display: flex; align-items: center; flex-wrap: wrap; gap: 8px 14px; }
  .we-credit { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 11px; letter-spacing: 0.04em; color: color-mix(in srgb, var(--text) 60%, transparent); }
  .we-tags { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .we-tags li { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 10px; letter-spacing: 0.06em; text-transform: uppercase; color: color-mix(in srgb, var(--text) 72%, transparent); padding: 3px 9px; border: 1px solid color-mix(in srgb, var(--text) 22%, transparent); border-radius: 999px; }
  .we-view { display: inline-flex; align-items: center; gap: 8px; margin-top: 2px; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 11px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--text); }
  .we-view-arrow { display: inline-block; color: var(--accent); transition: transform 280ms cubic-bezier(0.2, 0, 0, 1); }
  .we:has(.we-art:hover) .we-view-arrow, .we:focus-visible .we-view-arrow { transform: translateX(5px); }

  @media (prefers-reduced-motion: reduce) {
    .we { opacity: 1; transform: none; }
    .we.we-in, .we-art, .we-cover, .we-name, .we-reveal, .we-view-arrow { transition: none; }
    .we:has(.we-art:hover) .we-art, .we:focus-visible .we-art,
    .we:has(.we-art:hover) .we-cover, .we:focus-visible .we-cover { transform: none; }
  }
</style>
