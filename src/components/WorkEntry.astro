---
// A work in the gallery. At rest it hangs like a piece of art: the cover, a
// large faded index numeral, and the title on a museum-label. Lean in (hover /
// focus) and the plaque reveals itself — the one-line pitch, the credits, and a
// "view" cue — while the art recedes a touch. On touch devices (no hover) the
// plaque is shown by default so nothing is hidden.
//
// The card is its own dark object (cover + scrim + light type), so it reads
// identically across all four public-site themes. Reveal-on-scroll is wired in
// index.astro and keys off `.we`.

interface Props {
  index: number;
  name: string;
  subtitle: string;
  outcome: string;
  role?: string;
  timeline?: string;
  tools?: string[];
  tags: string[];
  slug: string;
  cover?: string | null;
  featured?: boolean;
}

const {
  index,
  name,
  subtitle,
  role,
  timeline,
  tags,
  slug,
  cover,
  featured = false,
} = Astro.props;
const num = String(index).padStart(2, "0");
const credit = [role, timeline].filter(Boolean).join("  ·  ");
---

<a
  class:list={["we", { "we-featured": featured }]}
  href={`/case-studies/${slug}`}
  data-we-entry={num}
  aria-label={`View case study: ${name} — ${subtitle}`}
>
  <article class="we-card">
    {cover ? (
      <img class="we-cover" src={cover} alt="" loading="lazy" />
    ) : (
      <div class="we-cover we-cover-empty"></div>
    )}
    <div class="we-scrim" aria-hidden="true"></div>
    <span class="we-frame" aria-hidden="true"></span>
    <span class="we-ghost" aria-hidden="true">{num}</span>

    <div class="we-body">
      <h2 class="we-name">{name}</h2>

      <div class="we-reveal">
        <div class="we-reveal-inner">
          <p class="we-pitch">{subtitle}</p>
          {(credit || tags.length > 0) && (
            <div class="we-credits">
              {credit && <span class="we-credit">{credit}</span>}
              {tags.length > 0 && (
                <ul class="we-tags">{tags.slice(0, 3).map((t) => <li>{t}</li>)}</ul>
              )}
            </div>
          )}
          <span class="we-view">
            <span class="we-view-label">View case study</span>
            <span class="we-view-arrow" aria-hidden="true">→</span>
          </span>
        </div>
      </div>
    </div>
  </article>
</a>

<style>
  .we {
    display: block;
    text-decoration: none;
    color: #f5f1e8;
    /* reveal-on-scroll initial state (index.astro toggles .we-in) */
    opacity: 0;
    transform: translateY(22px);
  }
  .we.we-in {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 820ms cubic-bezier(0.2, 0, 0, 1), transform 820ms cubic-bezier(0.2, 0, 0, 1);
  }

  .we-card {
    position: relative;
    overflow: hidden;
    border-radius: 4px;
    aspect-ratio: 4 / 3;
    background: #0b0a0f;
    box-shadow: 0 24px 60px -40px rgba(0, 0, 0, 0.8);
    isolation: isolate;
    transition: transform 520ms cubic-bezier(0.2, 0, 0, 1),
                box-shadow 520ms cubic-bezier(0.2, 0, 0, 1);
  }
  .we-featured .we-card { aspect-ratio: 2 / 1; }

  .we:hover .we-card,
  .we:focus-visible .we-card {
    transform: translateY(-6px);
    box-shadow: 0 44px 90px -42px rgba(0, 0, 0, 0.85);
  }
  .we:focus-visible { outline: none; }
  .we:focus-visible .we-card { outline: 2px solid var(--accent); outline-offset: 4px; }

  /* Cover — fills the card. Recedes a touch on hover so the plaque reads. */
  .we-cover {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: 0;
    transition: transform 900ms cubic-bezier(0.2, 0, 0, 1), filter 520ms ease;
    filter: saturate(1.02);
  }
  .we:hover .we-cover,
  .we:focus-visible .we-cover { transform: scale(1.045); filter: saturate(0.9) brightness(0.46); }
  .we-cover-empty {
    background:
      radial-gradient(120% 100% at 80% 0%, rgba(255, 90, 60, 0.16), transparent 60%),
      linear-gradient(160deg, #15121b, #0a0810);
  }

  /* Base scrim — light at rest (enough for the title), deepens on hover. */
  .we-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to top,
      rgba(6, 5, 10, 0.86) 0%,
      rgba(6, 5, 10, 0.5) 26%,
      rgba(6, 5, 10, 0.12) 52%,
      transparent 78%
    );
    opacity: 0.82;
    transition: opacity 520ms ease;
  }
  .we:hover .we-scrim,
  .we:focus-visible .we-scrim { opacity: 1; }

  /* A thin matte/frame line inset from the edge — like a framed piece. It
     warms to the accent when the work is active. */
  .we-frame {
    position: absolute;
    inset: 10px;
    z-index: 2;
    border: 1px solid rgba(245, 241, 232, 0.16);
    border-radius: 2px;
    pointer-events: none;
    transition: border-color 420ms ease, inset 520ms cubic-bezier(0.2, 0, 0, 1);
  }
  .we:hover .we-frame,
  .we:focus-visible .we-frame {
    inset: 12px;
    border-color: color-mix(in srgb, var(--accent) 60%, rgba(245, 241, 232, 0.2));
  }

  /* Large faded index numeral, top-right. */
  .we-ghost {
    position: absolute;
    top: -0.16em;
    right: 0.1em;
    z-index: 2;
    font-family: "Space Grotesk Variable", "Space Grotesk", ui-sans-serif, system-ui, sans-serif;
    font-weight: 700;
    font-size: clamp(5rem, 14vw, 11rem);
    line-height: 1;
    letter-spacing: -0.04em;
    color: rgba(255, 255, 255, 0.08);
    pointer-events: none;
    transition: color 520ms ease;
  }
  .we-featured .we-ghost { font-size: clamp(6rem, 13vw, 13rem); }
  .we:hover .we-ghost,
  .we:focus-visible .we-ghost { color: rgba(255, 255, 255, 0.13); }

  /* Body — pinned bottom-left. The title is always shown; the reveal grows in
     below it on hover, lifting the title as it opens. */
  .we-body {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    z-index: 3;
    padding: clamp(20px, 3vw, 42px);
    display: flex;
    flex-direction: column;
  }

  .we-name {
    margin: 0;
    font-family: "Space Grotesk Variable", "Space Grotesk", ui-sans-serif, system-ui, sans-serif;
    font-weight: 700;
    font-size: clamp(1.9rem, 4.4vw, 3.25rem);
    line-height: 0.98;
    letter-spacing: -0.03em;
    color: #fbf8f1;
    text-shadow: 0 2px 28px rgba(0, 0, 0, 0.6);
    width: fit-content;
    max-width: 100%;
    /* accent underline grows on hover */
    background-image: linear-gradient(var(--accent), var(--accent));
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0% 2px;
    padding-bottom: 5px;
    transition: background-size 460ms cubic-bezier(0.2, 0, 0, 1);
  }
  .we-featured .we-name { font-size: clamp(2.3rem, 5.2vw, 4.25rem); }
  .we:hover .we-name,
  .we:focus-visible .we-name { background-size: 100% 2px; }

  /* The plaque — collapsed at rest (grid-rows 0fr), opens on hover. */
  .we-reveal {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition: grid-template-rows 460ms cubic-bezier(0.2, 0, 0, 1),
                opacity 360ms ease;
  }
  .we-reveal-inner {
    overflow: hidden;
    min-height: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .we:hover .we-reveal,
  .we:focus-visible .we-reveal { grid-template-rows: 1fr; opacity: 1; }

  .we-pitch {
    margin: 16px 0 0;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-style: italic;
    font-size: clamp(0.9rem, 1.4vw, 1.15rem);
    line-height: 1.4;
    color: rgba(245, 241, 232, 0.9);
    max-width: 46ch;
  }

  .we-credits {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px 16px;
  }
  .we-credit {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11px;
    letter-spacing: 0.04em;
    color: rgba(245, 241, 232, 0.6);
  }
  .we-tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .we-tags li {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(245, 241, 232, 0.74);
    padding: 3px 9px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 999px;
  }

  .we-view {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 2px;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #fbf8f1;
  }
  .we-view-arrow {
    display: inline-block;
    color: var(--accent);
    transition: transform 280ms cubic-bezier(0.2, 0, 0, 1);
  }
  .we:hover .we-view-arrow,
  .we:focus-visible .we-view-arrow { transform: translateX(5px); }

  @media (max-width: 55.99rem) {
    .we-card,
    .we-featured .we-card { aspect-ratio: 4 / 5; }
    .we-pitch { max-width: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .we { opacity: 1; transform: none; }
    .we.we-in { transition: none; }
    .we-card, .we-cover, .we-name, .we-reveal, .we-frame, .we-view-arrow { transition: none; }
    .we:hover .we-cover, .we:focus-visible .we-cover { transform: none; filter: saturate(0.9) brightness(0.46); }
    .we:hover .we-card, .we:focus-visible .we-card { transform: none; }
  }
</style>
