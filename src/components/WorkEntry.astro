---
// Cinematic work card for the homepage /#work gallery. The cover is the hero:
// a large image behind a bottom-up scrim, with the title, a one-line pitch, a
// giant ghost index number, and (on the featured card) a thin meta line + tags
// overlaid. The whole card is one link with a strong hover (cover zooms, card
// lifts, the accent underline draws, the arrow slides).
//
// Because the card is its own dark cinematic object (cover + scrim + light
// type), it reads identically across all four public-site themes. Keyboard
// arrow-nav + reveal-on-scroll are wired in index.astro and key off `.we`.

interface Props {
  index: number;
  name: string;
  subtitle: string;
  outcome: string;
  role?: string;
  timeline?: string;
  tools?: string[];
  tags: string[];
  slug: string;
  cover?: string | null;
  featured?: boolean;
}

const {
  index,
  name,
  subtitle,
  role,
  timeline,
  tools = [],
  tags,
  slug,
  cover,
  featured = false,
} = Astro.props;
const num = String(index).padStart(2, "0");
const stack = tools.slice(0, 3).join(" · ");
const meta = [role, timeline, stack].filter(Boolean);
---

<a
  class:list={["we", { "we-featured": featured }]}
  href={`/case-studies/${slug}`}
  data-we-entry={num}
  aria-label={`Read case study: ${name} — ${subtitle}`}
>
  <article class="we-card">
    {cover ? (
      <img class="we-cover" src={cover} alt="" loading="lazy" />
    ) : (
      <div class="we-cover we-cover-empty"></div>
    )}
    <div class="we-scrim" aria-hidden="true"></div>
    <span class="we-ghost" aria-hidden="true">{num}</span>

    <header class="we-top">
      <span class="we-badge"><span class="we-badge-dot" aria-hidden="true"></span>Case Study {num}</span>
    </header>

    <div class="we-body">
      <h2 class="we-name">{name}</h2>
      <p class="we-subtitle">{subtitle}</p>

      {featured && meta.length > 0 && (
        <dl class="we-meta">
          {role && <div><dt>Role</dt><dd>{role}</dd></div>}
          {timeline && <div><dt>Timeline</dt><dd>{timeline}</dd></div>}
          {stack && <div><dt>Stack</dt><dd>{stack}</dd></div>}
        </dl>
      )}

      <div class="we-foot">
        {featured && tags.length > 0 ? (
          <ul class="we-tags">{tags.slice(0, 4).map((t) => <li>{t}</li>)}</ul>
        ) : (
          <span class="we-foot-meta">{meta.join("  ·  ")}</span>
        )}
        <span class="we-read">
          <span class="we-read-label">Read case study</span>
          <span class="we-read-arrow" aria-hidden="true">→</span>
        </span>
      </div>
    </div>
  </article>
</a>

<style>
  .we {
    display: block;
    text-decoration: none;
    color: #f5f1e8;
    /* reveal-on-scroll initial state (index.astro toggles .we-in) */
    opacity: 0;
    transform: translateY(22px);
  }
  .we.we-in {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 760ms cubic-bezier(0.2, 0, 0, 1), transform 760ms cubic-bezier(0.2, 0, 0, 1);
  }

  .we-card {
    position: relative;
    overflow: hidden;
    border-radius: 6px;
    aspect-ratio: 4 / 3;
    background: #0b0a0f;
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 20px 50px -34px rgba(0, 0, 0, 0.7);
    isolation: isolate;
    transition: transform 420ms cubic-bezier(0.2, 0, 0, 1),
                box-shadow 420ms cubic-bezier(0.2, 0, 0, 1),
                border-color 320ms ease;
  }
  .we-featured .we-card { aspect-ratio: 2 / 1; }

  .we:hover .we-card,
  .we:focus-visible .we-card {
    transform: translateY(-5px);
    box-shadow: 0 36px 70px -34px rgba(0, 0, 0, 0.78);
    border-color: color-mix(in srgb, var(--accent) 55%, transparent);
  }
  .we:focus-visible { outline: none; }
  .we:focus-visible .we-card { outline: 2px solid var(--accent); outline-offset: 3px; }

  /* Cover image — fills the card, zooms on hover. */
  .we-cover {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: 0;
    transition: transform 760ms cubic-bezier(0.2, 0, 0, 1), filter 420ms ease;
    filter: saturate(1.02);
  }
  .we:hover .we-cover,
  .we:focus-visible .we-cover { transform: scale(1.06); }
  .we-cover-empty {
    background:
      radial-gradient(120% 100% at 80% 0%, rgba(255, 90, 60, 0.16), transparent 60%),
      linear-gradient(160deg, #15121b, #0a0810);
  }

  /* Scrim — strong at the bottom so the type reads over any cover, in any theme. */
  .we-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to top,
      rgba(6, 5, 10, 0.92) 0%,
      rgba(6, 5, 10, 0.72) 24%,
      rgba(6, 5, 10, 0.28) 48%,
      rgba(6, 5, 10, 0.04) 70%,
      transparent 100%
    );
  }

  /* Giant ghost index number, top-right. */
  .we-ghost {
    position: absolute;
    top: -0.18em;
    right: 0.12em;
    z-index: 2;
    font-family: "Space Grotesk Variable", "Space Grotesk", ui-sans-serif, system-ui, sans-serif;
    font-weight: 700;
    font-size: clamp(5rem, 14vw, 11rem);
    line-height: 1;
    letter-spacing: -0.04em;
    color: rgba(255, 255, 255, 0.07);
    pointer-events: none;
  }
  .we-featured .we-ghost { font-size: clamp(6rem, 13vw, 13rem); }

  /* Top badge. */
  .we-top {
    position: absolute;
    top: 0; left: 0; right: 0;
    z-index: 3;
    padding: 18px 20px;
    display: flex;
    justify-content: space-between;
  }
  .we-badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(245, 241, 232, 0.82);
    background: rgba(8, 6, 12, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    padding: 5px 11px;
    border-radius: 3px;
  }
  .we-badge-dot {
    width: 5px; height: 5px; border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
  }

  /* Body — bottom-left, over the scrim. */
  .we-body {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    z-index: 3;
    padding: clamp(20px, 3.2vw, 44px);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .we-name {
    margin: 0;
    font-family: "Space Grotesk Variable", "Space Grotesk", ui-sans-serif, system-ui, sans-serif;
    font-weight: 700;
    font-size: clamp(2rem, 4.6vw, 3.5rem);
    line-height: 0.98;
    letter-spacing: -0.03em;
    color: #fbf8f1;
    text-shadow: 0 2px 28px rgba(0, 0, 0, 0.55);
    /* accent underline grows on hover */
    width: fit-content;
    max-width: 100%;
    background-image: linear-gradient(var(--accent), var(--accent));
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0% 3px;
    padding-bottom: 4px;
    transition: background-size 420ms cubic-bezier(0.2, 0, 0, 1);
  }
  .we-featured .we-name { font-size: clamp(2.4rem, 5.4vw, 4.5rem); }
  .we:hover .we-name,
  .we:focus-visible .we-name { background-size: 100% 3px; }

  .we-subtitle {
    margin: 0;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-style: italic;
    font-size: clamp(0.95rem, 1.5vw, 1.3rem);
    line-height: 1.35;
    color: rgba(245, 241, 232, 0.86);
    max-width: 40ch;
    text-shadow: 0 1px 16px rgba(0, 0, 0, 0.5);
  }

  /* Featured meta strip. */
  .we-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 28px;
    margin: 6px 0 0;
  }
  .we-meta > div { display: flex; flex-direction: column; gap: 2px; }
  .we-meta dt {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 9px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(245, 241, 232, 0.5);
  }
  .we-meta dd {
    margin: 0;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 12px;
    color: rgba(245, 241, 232, 0.88);
  }

  .we-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 4px;
  }
  .we-tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }
  .we-tags li {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 10.5px;
    letter-spacing: 0.04em;
    color: rgba(245, 241, 232, 0.78);
    padding: 4px 10px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 2px;
  }
  .we-foot-meta {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11.5px;
    color: rgba(245, 241, 232, 0.58);
  }

  .we-read {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    flex: 0 0 auto;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #fbf8f1;
    padding: 9px 15px;
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 3px;
    background: rgba(8, 6, 12, 0.35);
    transition: background 240ms ease, border-color 240ms ease, color 240ms ease;
  }
  .we:hover .we-read,
  .we:focus-visible .we-read {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--ink-fg, #0a0a0a);
  }
  .we-read-arrow {
    display: inline-block;
    transition: transform 280ms cubic-bezier(0.2, 0, 0, 1);
  }
  .we:hover .we-read-arrow,
  .we:focus-visible .we-read-arrow { transform: translateX(4px); }

  @media (max-width: 55.99rem) {
    .we-card,
    .we-featured .we-card { aspect-ratio: 4 / 5; }
    .we-subtitle { max-width: none; }
    .we-read-label { display: none; }
    .we-read { padding: 9px 12px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .we { opacity: 1; transform: none; }
    .we.we-in { transition: none; }
    .we-card, .we-cover, .we-name, .we-read, .we-read-arrow { transition: none; }
    .we:hover .we-cover, .we:focus-visible .we-cover { transform: none; }
    .we:hover .we-card, .we:focus-visible .we-card { transform: none; }
  }
</style>
