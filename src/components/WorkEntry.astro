---
// One row in the work index. The work is browsed like a tracklist: a track
// number, the title on the left, and a hairline waveform that runs along the
// row's foot — quiet at rest, energised in the accent on hover / keyboard
// focus (it rhymes with the hero name, which is cut from a waveform). On
// desktop the title is all you see; the cover + outcome surface in the fixed
// preview pane (index.astro) when the row is engaged. On touch / narrow
// screens there is no pane, so the row expands into an inline card (the cover
// + pitch + outcome become the resting state). Every colour is a theme token,
// so the index re-themes with the rest of the site (dark-first).
//
// Reveal-on-scroll is wired in index.astro and keys off `.we`.

interface Props {
  i: number;
  name: string;
  subtitle: string;
  outcome?: string;
  role?: string;
  timeline?: string;
  tags?: string[];
  slug: string;
  cover?: string | null;
}

const { i, name, subtitle, outcome = "", role = "", timeline = "", slug, cover } = Astro.props;
const num = String(i + 1).padStart(2, "0");
const credit = [role, timeline].filter(Boolean).join("  ·  ");
// The link carries the full story for assistive tech; the preview pane is
// aria-hidden, so nothing is announced twice.
const aria = [`${name} — ${subtitle}`, outcome].filter(Boolean).join(". ");

// One organic waveform, drawn full-width as the row's "score" line. Geometry
// computed once at build time. Three detuned harmonics → reads as sound, not a
// sine. Faint + flattened at rest; CSS lifts it to full amplitude on engage.
const W = 1200, MID = 20, AMP = 14, N = 200;
let wave = "";
for (let k = 0; k <= N; k++) {
  const t = k / N, x = t * W;
  const v =
    Math.sin(t * 26 + 0.5) * 0.5 +
    Math.sin(t * 61 + 1.7) * 0.32 +
    Math.sin(t * 113 + 0.4) * 0.18;
  wave += (k ? " L" : "M") + x.toFixed(1) + "," + (MID - v * AMP).toFixed(1);
}
---

<li class="we" data-i={i}>
  <a class="we-a" href={`/case-studies/${slug}`} data-i={i} aria-label={`View case study: ${aria}`}>
    {cover ? (
      <span class="we-thumb" aria-hidden="true"><img src={cover} alt="" loading="lazy" /></span>
    ) : (
      <span class="we-thumb we-thumb-empty" aria-hidden="true"></span>
    )}

    <span class="we-line">
      <span class="we-num">{num}</span>
      <span class="we-main">
        <span class="we-title">{name}</span>
        <span class="we-pitch">{subtitle}</span>
        {outcome && <span class="we-out">{outcome}</span>}
        {credit && <span class="we-meta">{credit}</span>}
      </span>
      <span class="we-cue"><span>View</span><i aria-hidden="true">→</i></span>
    </span>

    <svg class="we-wave" viewBox="0 0 1200 40" preserveAspectRatio="none" aria-hidden="true">
      <path d={wave}></path>
    </svg>
  </a>
</li>

<style>
  .we {
    list-style: none;
    position: relative;
    border-bottom: 1px solid var(--line);
    opacity: 0;
    transform: translateY(20px);
  }
  .we.we-in {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 760ms cubic-bezier(0.2, 0, 0, 1), transform 760ms cubic-bezier(0.2, 0, 0, 1);
  }

  .we-a {
    position: relative;
    display: block;
    text-decoration: none;
    color: var(--text);
    padding: clamp(1.15rem, 2.5vw, 2rem) 0 clamp(1.3rem, 2.7vw, 2.1rem);
    transition: opacity 0.34s ease;
  }
  .we-a:focus-visible { outline: 2px solid var(--accent); outline-offset: 6px; border-radius: 3px; }

  /* desktop row: number · title/meta · cue */
  .we-line {
    display: grid;
    grid-template-columns: 3.4rem minmax(0, 1fr) auto;
    align-items: baseline;
    gap: clamp(0.9rem, 2.2vw, 2rem);
  }
  .we-num {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    color: var(--muted);
    padding-top: 0.5rem;
  }
  .we-main { min-width: 0; }
  .we-title {
    display: block;
    font-family: "Space Grotesk Variable", "Space Grotesk", ui-sans-serif, system-ui, sans-serif;
    font-weight: 600;
    font-size: clamp(1.95rem, 4.4vw, 3.15rem);
    line-height: 1.0;
    letter-spacing: -0.025em;
    color: var(--text);
    transition: color 0.3s ease;
  }
  .we-a:hover .we-title, .we-a:focus-visible .we-title, .we-a.is-active .we-title { color: var(--accent); }
  .we-meta {
    display: block;
    margin-top: 0.75rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.76rem;
    letter-spacing: 0.02em;
    color: var(--muted);
  }
  /* pitch + outcome live in the preview pane on desktop */
  .we-pitch, .we-out { display: none; }

  .we-cue {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    align-self: center;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
  .we-cue i { font-style: normal; color: var(--accent); }
  .we-a:hover .we-cue, .we-a:focus-visible .we-cue, .we-a.is-active .we-cue { opacity: 1; transform: none; }

  /* the waveform "score" line, hugging the row's foot */
  .we-wave {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -9px;
    width: 100%;
    height: 18px;
    overflow: visible;
    pointer-events: none;
  }
  .we-wave path {
    fill: none;
    stroke: var(--muted);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
    opacity: 0.3;
    transform: scaleY(0.28);
    transform-box: fill-box;
    transform-origin: center;
    transition: opacity 0.4s ease, stroke 0.4s ease, transform 0.55s cubic-bezier(0.2, 0, 0, 1);
  }
  .we-a:hover .we-wave path, .we-a:focus-visible .we-wave path, .we-a.is-active .we-wave path {
    stroke: var(--accent);
    opacity: 0.95;
    transform: scaleY(1);
  }

  /* thumb is desktop-hidden; the pane carries the image */
  .we-thumb { display: none; }

  /* ───── mobile / touch: the row becomes an inline card (reveal = resting) ───── */
  @media (max-width: 55.99rem) {
    .we-a { padding: 1.5rem 0 1.7rem; }
    .we-thumb {
      display: block;
      aspect-ratio: 16 / 9;
      overflow: hidden;
      border: 1px solid var(--line);
      background: var(--surface-1);
      margin-bottom: 1.1rem;
    }
    .we-thumb img { width: 100%; height: 100%; object-fit: cover; filter: brightness(0.92); }
    .we-thumb-empty { background: radial-gradient(120% 100% at 70% 0%, color-mix(in srgb, var(--accent) 16%, transparent), transparent 60%), var(--surface-1); }
    .we-line { grid-template-columns: auto minmax(0, 1fr); align-items: baseline; gap: 0.8rem; }
    .we-num { padding-top: 0.35rem; }
    .we-title { font-size: clamp(1.7rem, 8vw, 2.4rem); }
    .we-pitch {
      display: block;
      margin-top: 0.55rem;
      font-family: "Space Grotesk Variable", "Space Grotesk", sans-serif;
      font-size: 1.02rem;
      line-height: 1.4;
      color: color-mix(in srgb, var(--text) 86%, transparent);
    }
    .we-out {
      display: block;
      margin-top: 0.5rem;
      font-size: 0.86rem;
      line-height: 1.45;
      color: var(--muted);
    }
    .we-cue { display: none; }
    .we-wave { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .we { opacity: 1; transform: none; }
    .we.we-in, .we-a, .we-title, .we-cue, .we-wave path { transition: none; }
    .we-a:hover .we-wave path, .we-a:focus-visible .we-wave path { transform: scaleY(0.6); }
  }
</style>
