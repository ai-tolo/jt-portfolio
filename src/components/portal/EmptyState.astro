---
import type { StatsResponse } from "../../lib/console-types";

interface Props {
  title: string;
  body?: string;
  stats?: StatsResponse | null;
}

const { title, body, stats } = Astro.props;
---

<section class="empty">
  <h2 class="title">{title}</h2>
  {body && <p class="body">{body}</p>}

  {stats && (
    <dl class="stats" aria-label="Catalog status">
      <div>
        <dt>Total</dt>
        <dd>{stats.by_category.reduce((n, c) => n + c.files, 0)} files</dd>
      </div>
      <div>
        <dt>Transcribed</dt>
        <dd>{stats.analysis.transcribed}</dd>
      </div>
      <div>
        <dt>Audio analyzed</dt>
        <dd>{stats.analysis.audio}</dd>
      </div>
      <div>
        <dt>Visual analyzed</dt>
        <dd>{stats.analysis.visual}</dd>
      </div>
      <div>
        <dt>.als projects</dt>
        <dd>{stats.als_projects}</dd>
      </div>
      <div>
        <dt>Public on /sounds</dt>
        <dd>{stats.public}</dd>
      </div>
      <div>
        <dt>Duplicate rows</dt>
        <dd title="Rows sharing a content_sha1 with another row. Surprise picker collapses them.">{stats.content_dedup.duplicate_rows}</dd>
      </div>
    </dl>
  )}
</section>

<style>
  .empty {
    border: 1px dashed var(--line);
    padding: var(--space-8);
    display: grid;
    gap: var(--space-5);
    max-width: 56rem;
  }
  .title {
    font-size: var(--fs-title);
    font-weight: var(--fw-bold);
    letter-spacing: var(--ls-title);
    line-height: var(--lh-title);
  }
  .body {
    color: var(--muted);
    max-width: 60ch;
    line-height: 1.55;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: var(--space-4) var(--space-6);
    margin: 0;
  }
  .stats div {
    display: grid;
    gap: 2px;
  }
  .stats dt {
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--muted);
  }
  .stats dd {
    font-size: 1.25rem;
    font-weight: var(--fw-semibold);
    margin: 0;
    color: var(--text);
  }
</style>
