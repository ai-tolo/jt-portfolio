---
import EmptyState from "./EmptyState.astro";
import type { DeskPlan, DeskWeek, DeskPiece } from "../../lib/desk-notion";

interface Props {
  plan: DeskPlan;
}
const { plan } = Astro.props;

// Append a local time so a date-only string ("2026-06-01") isn't parsed as
// UTC midnight and shifted back a day (which would render June as "May").
const monthLabel = plan.spine?.spineMonth
  ? new Date(plan.spine.spineMonth + "T12:00:00").toLocaleDateString("en-US", { month: "long", year: "numeric" })
  : null;

const stripQuotes = (s: string): string =>
  s.replace(/^[\s"'“”]+/, "").replace(/[\s"'“”]+$/, "").trim();

const splitNotes = (s: string): string[] =>
  s.split(/\s+plus\s+/i).map(stripQuotes).filter(Boolean);

const beatHeadline = (s: string): string =>
  s.replace(/^\s*\d+\.\s*/, "").replace(/^Beat\s*\d+:\s*/i, "").trim();

const pieceFor = (week: DeskWeek, lane: DeskPiece["lane"]): DeskPiece | undefined =>
  week.pieces.find((p) => p.lane === lane);

const weekWhen = (w: DeskWeek, i: number): string => (w.current ? "this week" : i === 0 ? "now" : "next week");

// Serialized for the client so the loop can post the current plan and the
// board can re-render in place when Claude returns a revised plan.
const weeksForClient = plan.onTheDesk.map((w, i) => ({
  when: weekWhen(w, i),
  range: w.range,
  beat: w.beat,
  pieces: w.pieces.map((p) => ({ surface: p.surface, lane: p.lane, text: p.text })),
}));
const weeksJson = JSON.stringify(weeksForClient).replace(/</g, "\\u003c");
---

<section class="desk" data-desk>
  <script type="application/json" data-desk-weeks set:html={weeksJson}></script>

  {/* ── Masthead ─────────────────────────────────────────────────────── */}
  <header class="masthead">
    <div class="masthead-l">
      <p class="kicker">The Desk</p>
      {plan.spine && (
        <p class="issue">Issue: <span class="issue-name">{plan.spine.name}</span>{monthLabel && <span class="issue-month"> · {monthLabel}</span>}</p>
      )}
    </div>
    <button type="button" class="tune-btn" data-action="desk-tune">
      <span class="tune-spark" aria-hidden="true"></span>Tune this week
    </button>
  </header>

  <div class="capture-bar">
    <input
      class="capture-input"
      data-capture-input
      type="text"
      maxlength="2000"
      placeholder="Drop a thought, a fragment, a half-idea. It lands in your compost."
      autocomplete="off"
      spellcheck="false"
    />
    <button type="button" class="capture-btn" data-action="capture">Catch it</button>
    <span class="capture-status" data-capture-status aria-live="polite"></span>
  </div>

  {plan.error && <p class="error" role="alert">Couldn't load the plan from Notion: {plan.error}</p>}

  {plan.onTheDesk.length === 0 && !plan.error ? (
    <EmptyState
      title="Nothing on the desk yet"
      body="No spine arc with a weekly calendar was found. Set an arc's status to spine and give it a 30-day calendar."
    />
  ) : (
    <div class="issues" data-issues>
      {plan.onTheDesk.map((week, i) => {
        const article = pieceFor(week, "Article");
        const notes = pieceFor(week, "Notes");
        const linkedin = pieceFor(week, "Post");
        const ig = pieceFor(week, "Visual");
        const noteAtoms = notes ? splitNotes(notes.text) : [];
        return (
          <section class:list={["issue-spread", { current: week.current }]}>
            <header class="dateline">
              <span class="when">{weekWhen(week, i)}</span>
              <span class="dates">{week.range}</span>
            </header>
            {week.beat && <h2 class="headline">{beatHeadline(week.beat)}</h2>}

            {week.pieces.length === 0 ? (
              <p class="empty-week">No pieces planned for this week yet. Tune it to fill it.</p>
            ) : (
              <div class="spread">
                {article ? (
                  <article class="post sub hero" data-action="expand-post" tabindex="0" aria-label="Substack post preview">
                    <header class="sub-top">
                      <span class="sub-mark" aria-hidden="true">S</span>
                      <span class="sub-pub">Diary of a Soundbender</span>
                      <span class="post-day">Wed</span>
                    </header>
                    <div class="sub-audio" data-action="play" role="button" tabindex="0" aria-label="Play audio preview">
                      <span class="play-glyph" aria-hidden="true"></span>
                      <span class="scrub"><span class="scrub-fill"></span></span>
                      <span class="sub-dur">0:00</span>
                    </div>
                    <h3 class="sub-title">{stripQuotes(article.text)}</h3>
                    <p class="sub-byline"><span class="avatar">T</span>Tolo<span class="byline-sep">·</span>Substack</p>
                    <button type="button" class="draft-btn" data-action="draft" data-wi={i} data-lane="Article">✍ Draft this post</button>
                  </article>
                ) : (
                  <article class="post sub hero placeholder">
                    <p class="ph-label">No Substack article yet</p>
                    <p class="ph-hint">This is the week's headline slot. Tune the week to fill it.</p>
                  </article>
                )}

                <aside class="aside">
                  {noteAtoms.length > 0 && (
                    <div class="notes-col">
                      <p class="col-label">Notes</p>
                      {noteAtoms.map((n) => (
                        <article class="post note">
                          <p class="note-head"><span class="avatar sm">T</span>Tolo <span class="handle">@jontolo</span></p>
                          <p class="note-text">{n}</p>
                        </article>
                      ))}
                    </div>
                  )}

                  {linkedin && (
                    <article class="post li" data-action="expand-post" tabindex="0" aria-label="LinkedIn post preview">
                      <header class="li-head">
                        <span class="avatar li-av">JT</span>
                        <span class="li-id"><strong>Jon Tollefson</strong><small>BA &amp; UX Designer · Soundbender</small></span>
                        <span class="li-mark" aria-hidden="true">in</span>
                      </header>
                      <p class="li-text">{stripQuotes(linkedin.text)}</p>
                      <div class="li-bar"><span>Like</span><span>Comment</span><span>Repost</span></div>
                    </article>
                  )}

                  {ig && (
                    <article class="post ig" data-action="ig-cycle" tabindex="0" aria-label="Instagram carousel preview">
                      <div class="ig-frame">
                        <div class="ig-tile" data-ig-tile>
                          <span class="ig-tile-label">{stripQuotes(ig.text)}</span>
                        </div>
                        <div class="ig-dots" aria-hidden="true"><i class="on"></i><i></i><i></i></div>
                      </div>
                      <p class="ig-cap"><span class="avatar sm ig-av">T</span>carousel</p>
                    </article>
                  )}
                </aside>
              </div>
            )}
          </section>
        );
      })}
    </div>
  )}

  {/* ── The Spine ────────────────────────────────────────────────────── */}
  {plan.spine && (
    <section class="spine-layer" aria-labelledby="spine-h">
      <header class="spine-head">
        <p class="kicker" id="spine-h">The Spine</p>
        <p class="spine-sub">The arc behind the weeks. The long shape you steer.</p>
      </header>

      <article class="arc">
        <header class="arc-head">
          <h3 class="arc-name">{plan.spine.name}</h3>
          <span class="arc-month">{monthLabel}</span>
        </header>
        {plan.spine.premise && <p class="arc-premise">{plan.spine.premise}</p>}
        {plan.beats.length > 0 && (
          <ol class="beats" role="list">
            {plan.beats.map((beat, i) => {
              const n = (beat.title.match(/(\d+)/) || [])[1];
              return (
                <li class:list={["beat", { gap: beat.gap }]} title={beat.premise}>
                  <span class="beat-rail" aria-hidden="true"></span>
                  <span class="beat-n">{n ? `0${n}` : i + 1}</span>
                  <span class="beat-title">{beatHeadline(beat.title)}</span>
                  <span class:list={["beat-meta", { gapmeta: beat.gap }]}>
                    {beat.gap ? "needs a hook" : `${beat.hooks.length} ${beat.hooks.length === 1 ? "hook" : "hooks"}`}
                  </span>
                </li>
              );
            })}
          </ol>
        )}
      </article>

      {plan.otherArcs.length > 0 && (
        <ul class="arc-list" role="list">
          {plan.otherArcs.map((arc) => (
            <li class="arc-mini">
              <span class:list={["mini-dot", `st-${arc.status}`]} aria-hidden="true"></span>
              <span class="mini-name">{arc.name}</span>
              <span class="mini-status">{arc.status}</span>
            </li>
          ))}
        </ul>
      )}
    </section>
  )}

  {/* ── Tune panel (the loop) ────────────────────────────────────────── */}
  <div class="tune-scrim" data-tune-scrim hidden>
    <aside class="tune-panel" role="dialog" aria-modal="true" aria-label="Tune this week" data-tune-panel>
      <header class="tune-head">
        <p class="kicker">Tune this week</p>
        <button type="button" class="tune-close" data-action="tune-close" aria-label="Close">✕</button>
      </header>
      <div class="tune-body" data-tune-body>
        <!-- dynamic: react form / questions / summary -->
      </div>
    </aside>
  </div>
</section>

<style is:global>
  .desk { display: grid; gap: var(--space-12); }
  .desk [data-desk-weeks] { display: none; }

  .desk .kicker {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11px; font-weight: 600; letter-spacing: 0.32em; text-transform: uppercase; color: var(--muted);
  }

  .masthead {
    display: flex; justify-content: space-between; align-items: flex-start;
    gap: var(--space-6); flex-wrap: wrap;
    padding-bottom: var(--space-5); border-bottom: 1.5px solid var(--text);
  }
  .issue { margin-top: 6px; font-size: var(--fs-small); color: var(--muted); }
  .issue-name { color: var(--text); font-weight: 600; }
  .tune-btn {
    display: inline-flex; align-items: center; gap: 8px;
    font: inherit; font-size: 13px; font-weight: 700; letter-spacing: 0.02em;
    color: #0e0c14; background: linear-gradient(100deg, #ff3b6e 0%, #ff6e21 60%, #ffc24b 100%);
    border: 0; padding: 11px 18px; cursor: pointer;
    transition: transform 140ms ease, filter 140ms ease;
    box-shadow: 0 6px 22px -10px rgba(255, 59, 110, 0.75);
  }
  .tune-btn:hover, .tune-btn:focus-visible { transform: translateY(-1px); filter: brightness(1.07); outline: none; }
  .tune-spark { width: 7px; height: 7px; border-radius: 50%; background: #0e0c14; box-shadow: 0 0 0 3px rgba(14,12,20,0.25); }

  .desk .error {
    padding: var(--space-3) var(--space-4); border-left: 2px solid var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, transparent); font-size: var(--fs-small);
  }

  .capture-bar { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-top: calc(-1 * var(--space-6)); }
  .capture-input {
    flex: 1 1 22rem; min-width: 0; font: inherit; font-size: var(--fs-small); color: var(--text);
    background: rgba(245,241,232,0.02); border: 1px solid var(--line); border-radius: 6px;
    padding: 10px 13px; outline: none; transition: border-color 140ms ease;
  }
  .capture-input:focus-visible { border-color: #ff8c42; }
  .capture-input::placeholder { color: var(--muted); }
  .capture-btn {
    font: inherit; font-size: 12px; font-weight: 700; letter-spacing: 0.04em; color: var(--text);
    background: transparent; border: 1px solid var(--line); border-radius: 6px; padding: 10px 16px;
    cursor: pointer; transition: border-color 140ms ease, color 140ms ease;
  }
  .capture-btn:hover, .capture-btn:focus-visible { border-color: #ff8c42; color: #ff8c42; outline: none; }
  .capture-status { font-size: 12px; color: var(--muted); }
  .capture-status[data-ok="1"] { color: #00ff4d; }

  .issues { display: grid; gap: var(--space-12); }
  .issue-spread { display: grid; gap: var(--space-4); }
  .dateline { display: flex; align-items: baseline; gap: var(--space-3); }
  .when {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11px; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: var(--muted);
  }
  .issue-spread.current .when { color: #0ec4fc; }
  .dates { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 11px; color: var(--muted); }
  .headline {
    font-size: clamp(2rem, 5vw, 3.25rem); font-weight: 700; letter-spacing: -0.03em;
    line-height: 1.02; color: var(--text); max-width: 18ch;
  }
  .empty-week { color: var(--muted); font-style: italic; font-size: var(--fs-small); }

  .spread { display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr); gap: var(--space-6); align-items: start; }
  @media (max-width: 820px) { .spread { grid-template-columns: 1fr; } }

  .post { border: 1px solid var(--line); border-radius: 8px; overflow: hidden; transition: transform 140ms ease, border-color 140ms ease, box-shadow 140ms ease; }
  .post[data-action]:hover, .post[data-action]:focus-visible { transform: translateY(-2px); outline: none; }
  .desk .avatar {
    display: inline-grid; place-items: center; width: 22px; height: 22px; border-radius: 50%;
    font-size: 10px; font-weight: 800; color: #0e0c14;
    background: linear-gradient(135deg, #ff6e21, #ffc24b); flex: 0 0 auto;
  }
  .desk .avatar.sm { width: 18px; height: 18px; font-size: 9px; }

  .sub.hero { background: #211d1b; border-color: #3a322e; box-shadow: 0 24px 60px -36px rgba(0,0,0,0.9); cursor: pointer; }
  .sub.hero:hover { border-color: #ff8c42; box-shadow: 0 26px 64px -34px rgba(255,110,33,0.4); }
  .sub-top { display: flex; align-items: center; gap: 9px; padding: 14px 18px; border-bottom: 1px solid #342d28; }
  .sub-mark { display: inline-grid; place-items: center; width: 20px; height: 20px; border-radius: 3px; background: #ff6719; color: #fff; font-weight: 800; font-size: 13px; font-family: Georgia, "Times New Roman", serif; }
  .sub-pub { font-size: 13px; font-weight: 600; color: #efe7df; }
  .post-day { margin-left: auto; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 10px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: #ff8c42; border: 1px solid rgba(255,140,66,0.4); padding: 2px 7px; border-radius: 3px; }
  .sub-audio { display: flex; align-items: center; gap: 12px; margin: 16px 18px 4px; padding: 9px 12px; background: #181513; border: 1px solid #342d28; border-radius: 6px; cursor: pointer; }
  .play-glyph { width: 0; height: 0; border-left: 11px solid #ff8c42; border-top: 7px solid transparent; border-bottom: 7px solid transparent; margin-left: 2px; flex: 0 0 auto; }
  .sub-audio[data-playing="true"] .play-glyph { width: 10px; height: 12px; border: 0; border-left: 3px solid #ff8c42; border-right: 3px solid #ff8c42; margin-left: 0; }
  .scrub { flex: 1 1 auto; height: 3px; background: #3a322e; border-radius: 2px; overflow: hidden; }
  .scrub-fill { display: block; height: 100%; width: 0%; background: #ff8c42; transition: width 120ms linear; }
  .sub-dur { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 11px; color: #a99c90; flex: 0 0 auto; }
  .sub-title { margin: 14px 18px 0; font-size: clamp(1.35rem, 2.6vw, 1.9rem); font-weight: 700; letter-spacing: -0.02em; line-height: 1.12; color: #f7f1ea; }
  .sub-byline { display: flex; align-items: center; gap: 8px; margin: 12px 18px 18px; font-size: 12px; color: #a99c90; }
  .byline-sep { opacity: 0.5; }
  .sub.placeholder { display: grid; gap: 6px; place-content: center; text-align: center; background: rgba(245,241,232,0.015); border-style: dashed; padding: var(--space-8); min-height: 180px; }
  .ph-label { font-weight: 600; color: var(--text); }
  .ph-hint { font-size: var(--fs-small); color: var(--muted); }

  .aside { display: grid; gap: var(--space-4); }
  .col-label { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 10px; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase; color: var(--muted); margin-bottom: 2px; }
  .notes-col { display: grid; gap: var(--space-2); }
  .note { background: var(--surface-1); padding: 11px 13px; }
  .note-head { display: flex; align-items: center; gap: 6px; font-size: 11px; color: var(--muted); margin-bottom: 5px; }
  .handle { color: #6fb2c9; }
  .note-text { font-size: 13.5px; line-height: 1.4; color: var(--text); }

  .li { background: var(--surface-1); cursor: pointer; }
  .li:hover { border-color: #2f7fd1; }
  .li-head { display: flex; align-items: center; gap: 9px; padding: 12px 14px 8px; }
  .li-av { background: linear-gradient(135deg, #2f7fd1, #5aa9e8); border-radius: 50%; color: #fff; }
  .li-id { display: grid; line-height: 1.25; }
  .li-id strong { font-size: 13px; color: var(--text); }
  .li-id small { font-size: 10.5px; color: var(--muted); }
  .li-mark { margin-left: auto; display: inline-grid; place-items: center; width: 20px; height: 20px; border-radius: 3px; background: #2f7fd1; color: #fff; font-weight: 800; font-size: 11px; font-style: italic; }
  .li-text { padding: 0 14px 10px; font-size: 13.5px; line-height: 1.45; color: var(--text); }
  .li-bar { display: flex; gap: 18px; padding: 8px 14px; border-top: 1px solid var(--line); font-size: 11px; color: var(--muted); }

  .ig { background: var(--surface-1); cursor: pointer; }
  .ig-frame { position: relative; }
  .ig-tile { aspect-ratio: 1 / 1; display: grid; place-items: center; text-align: center; padding: var(--space-5); background: radial-gradient(120% 120% at 20% 10%, rgba(255,59,110,0.22), transparent 55%), radial-gradient(120% 120% at 90% 90%, rgba(255,110,33,0.22), transparent 55%), #16110f; }
  .ig-tile-label { font-size: 14px; font-weight: 600; color: #f7f1ea; max-width: 22ch; line-height: 1.3; }
  .ig-dots { position: absolute; left: 0; right: 0; bottom: 10px; display: flex; gap: 5px; justify-content: center; }
  .ig-dots i { width: 5px; height: 5px; border-radius: 50%; background: rgba(255,255,255,0.4); }
  .ig-dots i.on { background: #fff; }
  .ig-cap { display: flex; align-items: center; gap: 7px; padding: 9px 12px; font-size: 12px; color: var(--muted); }
  .ig-av { background: linear-gradient(135deg, #ff3b6e, #ff6e21, #ffc24b); }

  .spine-layer { display: grid; gap: var(--space-5); padding-top: var(--space-6); border-top: 1px solid var(--line); }
  .spine-head { display: grid; gap: 4px; }
  .spine-sub { font-size: var(--fs-small); color: var(--muted); }
  .arc { display: grid; gap: var(--space-4); }
  .arc-head { display: flex; align-items: baseline; gap: var(--space-3); }
  .arc-name { font-size: 1.4rem; font-weight: 700; letter-spacing: -0.02em; }
  .arc-month { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 11px; color: var(--muted); letter-spacing: 0.08em; }
  .arc-premise { font-size: var(--fs-small); line-height: 1.55; color: rgba(245,241,232,0.78); max-width: 72ch; }
  .beats { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 13rem), 1fr)); gap: var(--space-3); }
  .beat { position: relative; display: grid; gap: 4px; padding: 12px 12px 12px 16px; border: 1px solid var(--line); border-radius: 5px; background: rgba(245,241,232,0.012); }
  .beat-rail { position: absolute; left: 0; top: 0; bottom: 0; width: 3px; background: #ff6e21; border-radius: 5px 0 0 5px; }
  .beat.gap { border-style: dashed; }
  .beat.gap .beat-rail { background: #ffb250; opacity: 0.6; }
  .beat-n { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 11px; font-weight: 700; color: #ff8c42; }
  .beat-title { font-size: 13px; line-height: 1.3; color: var(--text); }
  .beat-meta { font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
  .gapmeta { color: #ffb250; }
  .arc-list { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .arc-mini { display: inline-flex; align-items: center; gap: 8px; padding: 6px 12px; border: 1px solid var(--line); border-radius: 999px; }
  .mini-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--muted); }
  .st-active { background: #00ff4d; } .st-planning { background: var(--muted); } .st-dormant { background: #ffb250; }
  .mini-name { font-size: 12.5px; color: var(--text); }
  .mini-status { font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }

  /* Tune panel */
  .tune-scrim { position: fixed; inset: 0; z-index: 50; background: rgba(5, 3, 6, 0.6); backdrop-filter: blur(3px); display: flex; justify-content: flex-end; }
  .tune-scrim[hidden] { display: none; }
  .tune-panel { width: min(440px, 92vw); height: 100%; background: #0d0b0a; border-left: 1px solid #342d28; box-shadow: -30px 0 80px -40px rgba(0,0,0,0.9); display: grid; grid-template-rows: auto 1fr; animation: tslidein 220ms cubic-bezier(0.2,0,0,1); }
  @keyframes tslidein { from { transform: translateX(24px); opacity: 0; } to { transform: none; opacity: 1; } }
  .tune-head { display: flex; align-items: center; justify-content: space-between; padding: var(--space-5); border-bottom: 1px solid var(--line); }
  .tune-close { font: inherit; font-size: 15px; color: var(--muted); background: transparent; border: 0; cursor: pointer; padding: 4px 8px; }
  .tune-close:hover { color: var(--text); }
  .tune-body { padding: var(--space-5); display: grid; gap: var(--space-4); align-content: start; overflow-y: auto; }
  .tune-lead { font-size: var(--fs-body); line-height: 1.5; color: var(--text); }
  .tune-input { font: inherit; color: var(--text); background: #16110f; border: 1px solid #342d28; border-radius: 6px; padding: 12px; outline: none; resize: vertical; width: 100%; box-sizing: border-box; }
  .tune-input:focus-visible { border-color: #ff8c42; }
  .tune-actions { display: flex; justify-content: flex-end; gap: 10px; }
  .tune-go { font: inherit; font-size: 13px; font-weight: 700; color: #0e0c14; background: linear-gradient(100deg, #ff3b6e, #ff6e21 70%, #ffc24b); border: 0; padding: 10px 20px; cursor: pointer; }
  .tune-go:hover { filter: brightness(1.07); }
  .tune-go[disabled] { opacity: 0.5; cursor: wait; filter: none; }
  .tune-ghost { font: inherit; font-size: 12px; font-weight: 600; color: var(--muted); background: transparent; border: 1px solid var(--line); border-radius: 5px; padding: 9px 14px; cursor: pointer; }
  .tune-ghost:hover { color: var(--text); border-color: var(--muted); }
  .tune-note { font-size: 12px; color: var(--muted); line-height: 1.5; }
  .tune-q { display: grid; gap: 7px; }
  .tune-q-label { font-size: var(--fs-small); color: var(--text); line-height: 1.45; }
  .tune-status { font-size: var(--fs-small); color: #ff8c42; display: flex; align-items: center; gap: 8px; }
  .tune-status .dot { width: 7px; height: 7px; border-radius: 50%; background: #ff8c42; animation: tpulse 900ms ease-in-out infinite; }
  @keyframes tpulse { 0%,100% { opacity: 0.3; } 50% { opacity: 1; } }
  .tune-summary { font-size: var(--fs-small); line-height: 1.55; color: var(--text); border-left: 2px solid #ff8c42; padding-left: 12px; }
  .tune-err { font-size: var(--fs-small); color: #ff6b6b; line-height: 1.5; }
  .draft-btn {
    display: inline-block; margin: 2px 16px 16px; font: inherit; font-size: 11px; font-weight: 700;
    letter-spacing: 0.04em; color: var(--muted); background: transparent; border: 1px solid var(--line);
    border-radius: 5px; padding: 6px 11px; cursor: pointer; transition: color 140ms ease, border-color 140ms ease;
  }
  .draft-btn:hover, .draft-btn:focus-visible { color: #ff8c42; border-color: #ff8c42; outline: none; }
  .draft-text { width: 100%; box-sizing: border-box; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12.5px; line-height: 1.5; min-height: 16rem; }
  .draft-stream {
    max-height: 22rem; overflow-y: auto; white-space: pre-wrap; word-break: break-word; margin: 0;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12.5px; line-height: 1.55; color: var(--text);
    background: #16110f; border: 1px solid #342d28; border-radius: 6px; padding: 12px;
  }
  .draft-stream::after { content: "▍"; color: #ff8c42; animation: tpulse 900ms ease-in-out infinite; }

  @media (max-width: 640px) { .desk { gap: var(--space-8); } .issues { gap: var(--space-8); } }
</style>

<script>
  (() => {
    const desk = document.querySelector<HTMLElement>("[data-desk]");
    if (!desk) return;

    type Piece = { surface: string; lane: string; text: string };
    type Week = { when: string; range: string; beat: string; pieces: Piece[] };

    const readWeeks = (): Week[] => {
      try { return JSON.parse(desk.querySelector("[data-desk-weeks]")?.textContent || "[]"); }
      catch { return []; }
    };
    let currentWeeks: Week[] = readWeeks();
    let lastReaction = "";
    let lastQuestions: string[] = [];
    // The last Tune/Draft action, so the error "Try again" button repeats the
    // right one (re-tune vs re-draft) instead of always reopening the tuner.
    let lastAction: (() => void) | null = null;

    // ── helpers mirroring the server render ──
    const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]!));
    const stripQ = (s: string) => s.replace(/^[\s"'“”]+/, "").replace(/[\s"'“”]+$/, "").trim();
    const splitNotes = (s: string) => s.split(/\s+plus\s+/i).map(stripQ).filter(Boolean);
    const headline = (s: string) => s.replace(/^\s*\d+\.\s*/, "").replace(/^Beat\s*\d+:\s*/i, "").trim();
    const find = (w: Week, lane: string) => w.pieces.find((p) => p.lane === lane);

    const renderWeek = (w: Week, wi: number): string => {
      const article = find(w, "Article");
      const notes = find(w, "Notes");
      const li = find(w, "Post");
      const ig = find(w, "Visual");
      const current = /this week/i.test(w.when);
      const hero = article
        ? `<article class="post sub hero" data-action="expand-post" tabindex="0">
             <header class="sub-top"><span class="sub-mark">S</span><span class="sub-pub">Diary of a Soundbender</span><span class="post-day">Wed</span></header>
             <div class="sub-audio" data-action="play" role="button" tabindex="0"><span class="play-glyph"></span><span class="scrub"><span class="scrub-fill"></span></span><span class="sub-dur">0:00</span></div>
             <h3 class="sub-title">${esc(stripQ(article.text))}</h3>
             <p class="sub-byline"><span class="avatar">T</span>Tolo<span class="byline-sep">·</span>Substack</p>
             <button type="button" class="draft-btn" data-action="draft" data-wi="${wi}" data-lane="Article">✍ Draft this post</button>
           </article>`
        : `<article class="post sub hero placeholder"><p class="ph-label">No Substack article yet</p><p class="ph-hint">This is the week's headline slot.</p></article>`;
      const notesHtml = notes
        ? `<div class="notes-col"><p class="col-label">Notes</p>${splitNotes(notes.text).map((n) => `<article class="post note"><p class="note-head"><span class="avatar sm">T</span>Tolo <span class="handle">@jontolo</span></p><p class="note-text">${esc(n)}</p></article>`).join("")}</div>`
        : "";
      const liHtml = li
        ? `<article class="post li" data-action="expand-post" tabindex="0"><header class="li-head"><span class="avatar li-av">JT</span><span class="li-id"><strong>Jon Tollefson</strong><small>BA &amp; UX Designer · Soundbender</small></span><span class="li-mark">in</span></header><p class="li-text">${esc(stripQ(li.text))}</p><div class="li-bar"><span>Like</span><span>Comment</span><span>Repost</span></div></article>`
        : "";
      const igHtml = ig
        ? `<article class="post ig" data-action="ig-cycle" tabindex="0"><div class="ig-frame"><div class="ig-tile"><span class="ig-tile-label">${esc(stripQ(ig.text))}</span></div><div class="ig-dots"><i class="on"></i><i></i><i></i></div></div><p class="ig-cap"><span class="avatar sm ig-av">T</span>carousel</p></article>`
        : "";
      const body = w.pieces.length === 0
        ? `<p class="empty-week">No pieces planned for this week yet. Tune it to fill it.</p>`
        : `<div class="spread">${hero}<aside class="aside">${notesHtml}${liHtml}${igHtml}</aside></div>`;
      return `<section class="issue-spread${current ? " current" : ""}">
        <header class="dateline"><span class="when">${esc(w.when)}</span><span class="dates">${esc(w.range)}</span></header>
        ${w.beat ? `<h2 class="headline">${esc(headline(w.beat))}</h2>` : ""}
        ${body}
      </section>`;
    };

    const renderBoard = (weeks: Week[]) => {
      const box = desk.querySelector<HTMLElement>("[data-issues]");
      if (!box) return;
      box.style.transition = "opacity 160ms ease";
      box.style.opacity = "0";
      window.setTimeout(() => {
        box.innerHTML = weeks.map((w, i) => renderWeek(w, i)).join("");
        box.style.opacity = "1";
      }, 170);
    };

    // ── panel ──
    const scrim = desk.querySelector<HTMLElement>("[data-tune-scrim]");
    const body = desk.querySelector<HTMLElement>("[data-tune-body]");

    const reactForm = (prefill = ""): string =>
      `<p class="tune-lead">What is off about the next two weeks? Say it however it comes out.</p>
       <textarea class="tune-input" data-reaction rows="3" placeholder="too much console build, i want more music, wednesday feels like a chore...">${esc(prefill)}</textarea>
       <div class="tune-actions"><button type="button" class="tune-go" data-action="tune-react">React</button></div>
       <p class="tune-note">It reads your reaction, asks a couple of quick questions, then rewrites the weeks.</p>`;

    const thinking = (msg: string): string => `<p class="tune-status"><span class="dot"></span>${esc(msg)}</p>`;

    const questionsForm = (qs: string[]): string =>
      `<p class="tune-lead">A couple of quick questions.</p>
       ${qs.map((q, i) => `<label class="tune-q"><span class="tune-q-label">${esc(q)}</span><textarea class="tune-input" data-answer="${i}" rows="2"></textarea></label>`).join("")}
       <div class="tune-actions"><button type="button" class="tune-ghost" data-action="tune-skip">Just rewrite it</button><button type="button" class="tune-go" data-action="tune-answer">Update the weeks</button></div>`;

    const doneView = (summary: string | null): string =>
      `<p class="tune-lead">Done. The weeks are updated and saved.</p>
       ${summary ? `<p class="tune-summary">${esc(summary)}</p>` : ""}
       <div class="tune-actions"><button type="button" class="tune-ghost" data-action="tune-reset">Reset to original</button><button type="button" class="tune-ghost" data-action="tune-again">Tune again</button><button type="button" class="tune-go" data-action="tune-close">Looks good</button></div>`;

    const errView = (kind: string): string => {
      let msg: string;
      if (kind === "m1-unreachable")
        msg = "Your M1 is asleep or offline, so Tune and Draft cannot run this moment. Everything else on the Desk still works. It usually wakes within a minute, give it another try.";
      else if (kind === "claude-unavailable-here")
        msg = "The engine cannot find Claude right now. Everything else on the Desk still works.";
      else if (kind === "claude-not-logged-in")
        msg = "Claude on the M1 needs a fresh login. Run <code>claude</code> then <code>/login</code> on the M1 once, then try again.";
      else if (kind === "claude-timeout")
        msg = "That one took too long and timed out. Try again, it is usually quick.";
      else if (kind === "job-expired")
        msg = "That run expired before it finished. Try it again.";
      else if (kind === "parse" || kind === "empty-rewrite")
        msg = "The rewrite came back in a shape I could not use. Try again, maybe with a clearer steer.";
      else msg = "Something went wrong reaching the model. " + esc(kind);
      return `<p class="tune-err">${msg}</p><div class="tune-actions"><button type="button" class="tune-go" data-action="tune-retry">Try again</button></div>`;
    };

    const setBody = (html: string) => { if (body) body.innerHTML = html; };
    const openTune = () => { if (scrim && body) { lastAction = () => openTune(); warm(); setBody(reactForm()); scrim.hidden = false; (body.querySelector("[data-reaction]") as HTMLElement)?.focus(); } };
    const closeTune = () => { if (scrim) scrim.hidden = true; };

    // ── Job runner ──
    // Tune/Draft run the model as `claude` on the M1 engine. The route starts
    // a streamed job and returns a job_id; we poll it so the draft/rewrite can
    // appear as it is written and every request stays short. onText fires on
    // each running poll. Errors throw a stable code the error view maps.
    const POLL_MS = 450;
    const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));

    async function startJob(url: string, payload: unknown): Promise<{ job_id: string; kind: string }> {
      const res = await fetch(url, { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(payload) });
      const data = await res.json().catch(() => ({} as any));
      if (!res.ok || !data?.job_id) throw new Error(data?.error || "failed-to-start");
      return data;
    }

    async function runJob(url: string, payload: unknown, onText?: (text: string, elapsed: number) => void): Promise<any> {
      const { job_id } = await startJob(url, payload);
      let fails = 0;
      const t0 = Date.now();
      for (;;) {
        if (Date.now() - t0 > 200_000) throw new Error("claude-timeout");
        await wait(POLL_MS);
        let data: any;
        try {
          const res = await fetch(`/api/console/desk-job?id=${encodeURIComponent(job_id)}`);
          data = await res.json();
          fails = 0;
        } catch {
          if (++fails > 12) throw new Error("m1-unreachable");
          continue;
        }
        if (data.status === "running") { onText?.(data.text || "", data.elapsed || 0); continue; }
        if (data.status === "error") throw new Error(data.error || "error");
        return data; // done
      }
    }

    // Best-effort pre-warm so the first Tune/Draft is the fast warm path.
    const warm = () => { void fetch("/api/console/desk-warm", { method: "POST" }).catch(() => {}); };

    async function saveCurrent() {
      try {
        await fetch("/api/console/desk-save", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ weeks: currentWeeks }) });
      } catch { /* in-session plan still works even if the save misses */ }
    }
    async function resetPlan() {
      try { await fetch("/api/console/desk-save", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ reset: true }) }); } catch {}
      location.reload();
    }

    const draftView = (text: string): string =>
      `<p class="tune-lead">Draft, in your voice. Edit freely, nothing is posted.</p>
       <textarea class="tune-input draft-text" data-draft-text rows="14">${esc(text)}</textarea>
       <div class="tune-actions"><button type="button" class="tune-ghost" data-action="draft-copy">Copy</button><button type="button" class="tune-go" data-action="tune-close">Done</button></div>
       <p class="tune-note">Drafted on request. Yours to take, not posted anywhere.</p>`;
    const draftStreamingView = (text: string): string =>
      `<p class="tune-status"><span class="dot"></span>Writing in your voice...</p>
       <pre class="draft-stream" data-draft-stream>${esc(text.replace(/—/g, ", "))}</pre>
       <p class="tune-note">Watching it appear. Nothing is posted.</p>`;
    async function draftPiece(wi: number, lane: string) {
      const week = currentWeeks[wi];
      const piece = week?.pieces.find((p) => p.lane === lane);
      if (!week || !piece) return;
      lastAction = () => void draftPiece(wi, lane);
      if (scrim) scrim.hidden = false;
      warm();
      setBody(draftStreamingView(""));
      try {
        const data = await runJob(
          "/api/console/desk-draft",
          { piece, ctx: { beat: week.beat, when: week.when } },
          (text) => {
            const pre = body?.querySelector<HTMLElement>("[data-draft-stream]");
            if (pre) { pre.textContent = text.replace(/—/g, ", "); pre.scrollTop = pre.scrollHeight; }
          },
        );
        setBody(draftView(String(data.draft || "")));
      } catch (e) { setBody(errView(e instanceof Error ? e.message : "error")); }
    }

    const rewritingView = (): string =>
      `<p class="tune-status"><span class="dot"></span>Rewriting the weeks<span data-relapsed></span></p>
       <p class="tune-note">Reshaping your two weeks in your voice. A few seconds.</p>`;

    async function react() {
      const ta = body?.querySelector<HTMLTextAreaElement>("[data-reaction]");
      const reaction = (ta?.value || "").trim();
      if (!reaction) { ta?.focus(); return; }
      lastReaction = reaction;
      setBody(thinking("Reading your reaction..."));
      try {
        const data = await runJob("/api/console/desk-tune", { weeks: currentWeeks, reaction, answers: [] });
        lastQuestions = data.questions || [];
        if (lastQuestions.length) setBody(questionsForm(lastQuestions));
        else await answer(true);
      } catch (e) { setBody(errView(e instanceof Error ? e.message : "error")); }
    }

    async function answer(skip: boolean) {
      const collected = skip ? [] : lastQuestions.map((_, i) => (body?.querySelector<HTMLTextAreaElement>(`[data-answer="${i}"]`)?.value || "").trim());
      const answers = skip
        ? ["(just rewrite it based on my reaction)"]
        : collected.some((a) => a) ? collected : ["(no extra detail)"];
      setBody(rewritingView());
      try {
        const data = await runJob(
          "/api/console/desk-tune",
          { weeks: currentWeeks, reaction: lastReaction, answers },
          (_t, elapsed) => {
            const el = body?.querySelector<HTMLElement>("[data-relapsed]");
            if (el && elapsed) el.textContent = ` ${Math.round(elapsed)}s`;
          },
        );
        if (data.weeks && data.weeks.length) { currentWeeks = data.weeks; renderBoard(currentWeeks); void saveCurrent(); setBody(doneView(data.summary)); }
        else setBody(errView("empty-rewrite"));
      } catch (e) { setBody(errView(e instanceof Error ? e.message : "error")); }
    }

    // ── audio / carousel micro-interactions ──
    let scrubTimer: number | null = null;
    const togglePlay = (bar: HTMLElement) => {
      const playing = bar.dataset.playing === "true";
      document.querySelectorAll<HTMLElement>('.sub-audio[data-playing="true"]').forEach((b) => { b.dataset.playing = "false"; const f = b.querySelector<HTMLElement>(".scrub-fill"); if (f) f.style.width = "0%"; });
      if (scrubTimer) { clearInterval(scrubTimer); scrubTimer = null; }
      if (!playing) {
        bar.dataset.playing = "true";
        const fill = bar.querySelector<HTMLElement>(".scrub-fill"); const dur = bar.querySelector<HTMLElement>(".sub-dur"); let p = 0;
        scrubTimer = window.setInterval(() => { p = (p + 0.7) % 100; if (fill) fill.style.width = p + "%"; if (dur) dur.textContent = `0:${String(Math.floor((p / 100) * 42)).padStart(2, "0")}`; }, 120);
      }
    };
    const cycleIg = (card: HTMLElement) => {
      const dots = card.querySelectorAll<HTMLElement>(".ig-dots i"); if (!dots.length) return;
      let a = Array.from(dots).findIndex((d) => d.classList.contains("on")); dots[a]?.classList.remove("on"); a = (a + 1) % dots.length; dots[a]?.classList.add("on");
    };
    const flashExpand = (card: HTMLElement) => card.animate([{ boxShadow: "0 0 0 0 rgba(14,196,252,0)" }, { boxShadow: "0 0 0 2px rgba(14,196,252,0.6)" }, { boxShadow: "0 0 0 0 rgba(14,196,252,0)" }], { duration: 520, easing: "ease-out" });

    // ── capture ──
    async function captureThought() {
      const input = desk.querySelector<HTMLInputElement>("[data-capture-input]");
      const status = desk.querySelector<HTMLElement>("[data-capture-status]");
      const text = (input?.value || "").trim();
      if (!text) { input?.focus(); return; }
      if (status) { status.textContent = "catching..."; status.removeAttribute("data-ok"); }
      try {
        const res = await fetch("/api/console/desk-capture", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ text }) });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data?.error || "failed");
        if (input) input.value = "";
        if (status) { status.textContent = "caught it, in your compost"; status.setAttribute("data-ok", "1"); }
        window.setTimeout(() => { if (status) status.textContent = ""; }, 3000);
      } catch { if (status) { status.textContent = "couldn't catch that, try again"; status.removeAttribute("data-ok"); } }
    }
    desk.querySelector<HTMLInputElement>("[data-capture-input]")?.addEventListener("keydown", (e) => {
      if (e.key === "Enter") { e.preventDefault(); void captureThought(); }
    });

    desk.addEventListener("click", (e) => {
      const t = e.target as HTMLElement;
      if (t.closest('[data-action="capture"]')) return void captureThought();
      const draftBtn = t.closest<HTMLElement>('[data-action="draft"]');
      if (draftBtn) return void draftPiece(parseInt(draftBtn.dataset.wi || "0", 10), draftBtn.dataset.lane || "Article");
      if (t.closest('[data-action="draft-copy"]')) {
        const ta = body?.querySelector<HTMLTextAreaElement>("[data-draft-text]");
        const b = t.closest<HTMLElement>('[data-action="draft-copy"]');
        if (ta && navigator.clipboard) { navigator.clipboard.writeText(ta.value).catch(() => {}); if (b) { b.textContent = "Copied"; window.setTimeout(() => { b.textContent = "Copy"; }, 1500); } }
        return;
      }
      if (t.closest('[data-action="tune-react"]')) return void react();
      if (t.closest('[data-action="tune-answer"]')) return void answer(false);
      if (t.closest('[data-action="tune-skip"]')) return void answer(true);
      if (t.closest('[data-action="tune-reset"]')) return void resetPlan();
      if (t.closest('[data-action="tune-again"]')) return void openTune();
      if (t.closest('[data-action="tune-retry"]')) return void (lastAction ? lastAction() : openTune());
      if (t.closest('[data-action="desk-tune"]')) return void openTune();
      if (t.closest('[data-action="tune-close"]') || t === scrim) return void closeTune();
      const audio = t.closest<HTMLElement>(".sub-audio"); if (audio) return void togglePlay(audio);
      const igc = t.closest<HTMLElement>('[data-action="ig-cycle"]'); if (igc) return void cycleIg(igc);
      const post = t.closest<HTMLElement>('.post[data-action="expand-post"]'); if (post) return void flashExpand(post);
    });
    document.addEventListener("keydown", (e) => { if (e.key === "Escape") closeTune(); });

    // Pre-warm the engine's claude runtime on load so the first Tune/Draft is
    // the fast warm path. Best effort, never blocks anything.
    warm();
  })();
</script>
