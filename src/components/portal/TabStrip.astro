---
interface Props {
  current: "surprise" | "library" | "projects" | "workbench" | "diary" | "buckets" | "promote";
}

const { current } = Astro.props;

// Projects tab removed 2026-05-16: cross-reference info now lives on Cards
// (in N projects badge) and the M4L device will own in-Ableton project
// context.
// Surprise + Library tabs removed 2026-05-17 evening: Buckets is the new
// browse surface (search + sort + random + filter + triage) so Library is
// redundant; Diary's Song Pitch generator replaces Surprise's role. Both
// /portal and /portal/library now 307-redirect to /portal/buckets/inbox.
const tabs: { id: Props["current"]; label: string; href: string }[] = [
  { id: "buckets", label: "Buckets", href: "/portal/buckets/all" },
  { id: "projects", label: "Projects", href: "/portal/projects" },
  { id: "promote", label: "Promote", href: "/portal/promote" },
  { id: "workbench", label: "Workbench", href: "/portal/workbench" },
  { id: "diary", label: "Diary", href: "/portal/diary" },
];
---

<nav class="tabs" aria-label="Portal sections">
  <ul role="list">
    {tabs.map((t) => (
      <li>
        <a
          href={t.href}
          class:list={["tab", { active: t.id === current }]}
          aria-current={t.id === current ? "page" : undefined}
        >{t.label}</a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .tabs ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  /* Each tab borrows the public WorkCard "num" chunk vocabulary:
     anchor-color background, inverted text, fit-content width. Tabs are
     wider and the type is heavier than the rest of the header so the
     primary-section choice reads as the next-most-important thing after
     the brand. Inactive tabs sit at low opacity until hover. */
  .tab {
    display: inline-block;
    background: var(--ink);
    color: var(--ink-fg);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1;
    padding: 11px 22px 10px;
    opacity: 0.45;
    transition: opacity 200ms ease, transform 200ms ease;
  }

  .tab:hover,
  .tab:focus-visible {
    opacity: 0.85;
    transform: translateY(-1px);
  }

  .tab.active {
    opacity: 1;
    outline: 1px solid var(--accent);
    outline-offset: 3px;
  }
</style>
