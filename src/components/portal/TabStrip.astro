---
interface Props {
  // Union stays wide so orphaned/secondary pages (listen, rotation, stale,
  // trash, library, promote, workbench, surprise, projects, sounds, diary)
  // still typecheck when they pass their own `current` — only three render.
  current: "surprise" | "library" | "projects" | "workbench" | "diary" | "buckets" | "promote" | "engineer" | "sounds";
}

const { current } = Astro.props;

// Two primary tabs (Desk removed 2026-06-13; superseded by the local
// apply/draft benches). Sounds folded into Engineer, Projects into a Buckets
// browse filter, Diary removed — see the Changelog.
const tabs: { id: Props["current"]; label: string; href: string }[] = [
  { id: "buckets", label: "Buckets", href: "/portal/buckets/all" },
  { id: "engineer", label: "Engineer", href: "/portal/engineer" },
];
---

<nav class="tabs" aria-label="Portal sections">
  {tabs.map((t) => (
    <a
      href={t.href}
      class:list={["tab", { active: t.id === current }]}
      aria-current={t.id === current ? "page" : undefined}
    >{t.label}</a>
  ))}
</nav>

<style>
  .tabs {
    display: flex;
    gap: 2px;
  }
  /* Clean text tabs — weight + an accent underline carry the active state,
     no heavy inverted blocks. */
  .tab {
    position: relative;
    display: inline-flex;
    align-items: center;
    font-family: "Geist Variable", ui-sans-serif, system-ui, sans-serif;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: rgba(245, 241, 232, 0.5);
    text-decoration: none;
    padding: 9px 14px 8px;
    border-radius: 8px;
    transition: color 160ms ease, background 160ms ease;
  }
  .tab:hover,
  .tab:focus-visible {
    color: var(--ink);
    background: rgba(245, 241, 232, 0.06);
  }
  .tab.active {
    color: var(--ink);
    font-weight: 700;
  }
  .tab.active::after {
    content: "";
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: 0;
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(90deg, #ff3b6e, #ff6e21);
  }
</style>
