---
/**
 * EngineerTurtle — the Engineer's avatar: "Terrapin", a cute futuristic-hippie
 * robot turtle mastering engineer. Grateful Dead's Terrapin Station banjo turtle ×
 * a Daft-Punk cyan glow × hippie tie-dye/flower, rendered as an adorable chibi friend.
 *
 * Front-facing bust drawn like an illustrated turtle (not a robot): matte freckled
 * skin + a beak, bold outlines, a big SEGMENTED PLASTRON (belly plates) framed by a
 * tie-dye carapace rim with marginal scutes. The futuristic/engineer signal rides on
 * top of that turtle anatomy:
 *   - an Iron-Man-style OSCILLOSCOPE REACTOR embedded as the central plastron plate —
 *     the standout accessory, and what the speaking state amps (calm trace at idle,
 *     brighter/taller/faster when `speaking`).
 *   - small cyber ear-patches + earbud studs ("future ears he bought" / audio cue).
 *   - a flower-tipped antenna + a peace flower on the shell — the hippie vibe.
 *
 * Self-contained SVG (no deps) so the art can be refined in isolation without touching
 * the Engineer page. Keep the outer .eng-turtle wrapper + props + ~square dimensions so
 * the page layout stays stable. Tuned to read at 66px (its production size).
 */
interface Props {
  size?: number;
  speaking?: boolean;
  class?: string;
}
const { size = 72, speaking = false, class: className = "" } = Astro.props;
---

<span
  class:list={["eng-turtle", className]}
  data-speaking={speaking ? "true" : "false"}
  style={`--turtle-size:${size}px`}
  aria-hidden="true"
>
  <svg viewBox="0 0 100 100" width={size} height={size} role="img" aria-label="Terrapin, the engineer">
    <defs>
      <linearGradient id="tHead" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#84e6aa" />
        <stop offset="100%" stop-color="#3ba876" />
      </linearGradient>
      <!-- tie-dye carapace: brand gradient as a sunburst (yellow → orange → pink) -->
      <radialGradient id="tCara" cx="42%" cy="26%" r="86%">
        <stop offset="0%" stop-color="#ffe07a" />
        <stop offset="34%" stop-color="#ff8a3d" />
        <stop offset="72%" stop-color="#ff2d8b" />
        <stop offset="100%" stop-color="#cc1c6e" />
      </radialGradient>
      <!-- cream plastron (belly plates) -->
      <radialGradient id="tPlas" cx="50%" cy="40%" r="68%">
        <stop offset="0%" stop-color="#fff1c9" />
        <stop offset="100%" stop-color="#eecb80" />
      </radialGradient>
      <!-- brand gradient (reactor ring, antenna petals) -->
      <linearGradient id="tDye" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#ff2d8b" />
        <stop offset="50%" stop-color="#ff8a3d" />
        <stop offset="100%" stop-color="#ffd23d" />
      </linearGradient>
      <radialGradient id="tGlow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#9af4ff" />
        <stop offset="100%" stop-color="#0ec4fc" stop-opacity="0" />
      </radialGradient>
      <clipPath id="tScopeClip"><circle cx="50" cy="81" r="7.5" /></clipPath>
    </defs>

    <!-- antenna stem (behind head) -->
    <line x1="50" y1="16" x2="50" y2="8" stroke="#0ec4fc" stroke-width="2.2" stroke-linecap="round" />

    <!-- little feet peeking under the shell -->
    <ellipse cx="40" cy="96" rx="6" ry="4" fill="url(#tHead)" stroke="#237a55" stroke-width="1.5" />
    <ellipse cx="60" cy="96" rx="6" ry="4" fill="url(#tHead)" stroke="#237a55" stroke-width="1.5" />

    <!-- flipper-hands tucked at the sides -->
    <g>
      <ellipse cx="14" cy="78" rx="7.5" ry="5" fill="url(#tHead)" stroke="#237a55" stroke-width="1.5" transform="rotate(-20 14 78)" />
      <circle cx="12" cy="77" r="0.8" fill="#2f9e6e" opacity="0.6" />
      <circle cx="16" cy="79.5" r="0.8" fill="#2f9e6e" opacity="0.6" />
    </g>
    <g>
      <ellipse cx="86" cy="78" rx="7.5" ry="5" fill="url(#tHead)" stroke="#237a55" stroke-width="1.5" transform="rotate(20 86 78)" />
      <circle cx="88" cy="77" r="0.8" fill="#2f9e6e" opacity="0.6" />
      <circle cx="84" cy="79.5" r="0.8" fill="#2f9e6e" opacity="0.6" />
    </g>

    <!-- shell: tie-dye carapace rim + segmented cream plastron -->
    <g class="t-shell">
      <!-- carapace -->
      <ellipse cx="50" cy="76" rx="31" ry="22" fill="url(#tCara)" stroke="#5e1640" stroke-width="2" />
      <!-- marginal scutes (segmented rim) -->
      <g stroke="#5e1640" stroke-width="1.3" opacity="0.8" stroke-linecap="round">
        <line x1="75.4" y1="76" x2="81" y2="76" />
        <line x1="72" y1="85" x2="76.8" y2="87" />
        <line x1="62.7" y1="91.6" x2="65.5" y2="95.1" />
        <line x1="50" y1="94" x2="50" y2="98" />
        <line x1="37.3" y1="91.6" x2="34.5" y2="95.1" />
        <line x1="28" y1="85" x2="23.2" y2="87" />
        <line x1="24.6" y1="76" x2="19" y2="76" />
      </g>
      <!-- hippie peace flower on the carapace rim -->
      <g transform="translate(24 70)">
        <g fill="#ff8ec2">
          <circle cx="0" cy="-2.1" r="1.6" />
          <circle cx="2" cy="-0.65" r="1.6" />
          <circle cx="1.23" cy="1.7" r="1.6" />
          <circle cx="-1.23" cy="1.7" r="1.6" />
          <circle cx="-2" cy="-0.65" r="1.6" />
        </g>
        <circle r="1.3" fill="#ffd23d" />
      </g>
      <!-- plastron (belly plates) -->
      <ellipse cx="50" cy="80" rx="19" ry="15.5" fill="url(#tPlas)" stroke="#c79a55" stroke-width="1.6" />
      <!-- plastron seams framing the central reactor plate -->
      <g stroke="#b07636" stroke-width="1.2" opacity="0.7" stroke-linecap="round" fill="none">
        <line x1="50" y1="65.5" x2="50" y2="70.5" />
        <line x1="50" y1="91.5" x2="50" y2="94.5" />
        <line x1="39" y1="81" x2="32" y2="81" />
        <line x1="61" y1="81" x2="68" y2="81" />
        <line x1="43" y1="72.5" x2="36.5" y2="68.5" />
        <line x1="57" y1="72.5" x2="63.5" y2="68.5" />
        <line x1="43" y1="89.5" x2="37" y2="92.5" />
        <line x1="57" y1="89.5" x2="63" y2="92.5" />
      </g>
    </g>

    <!-- head -->
    <ellipse cx="50" cy="38" rx="24" ry="22" fill="url(#tHead)" stroke="#237a55" stroke-width="2" />
    <!-- soft (non-glossy) highlight -->
    <ellipse cx="43" cy="27" rx="7" ry="3.4" fill="#ffffff" opacity="0.14" transform="rotate(-20 43 27)" />
    <!-- skin freckles -->
    <g fill="#2f9e6e" opacity="0.55">
      <circle cx="30" cy="43" r="0.85" />
      <circle cx="33.5" cy="45" r="0.85" />
      <circle cx="70" cy="43" r="0.85" />
      <circle cx="66.5" cy="45" r="0.85" />
      <circle cx="45" cy="23.5" r="0.7" />
      <circle cx="55" cy="23.5" r="0.7" />
    </g>

    <!-- cyber ear-patches + earbud studs (turtle tympanum, lightly upgraded) -->
    <g>
      <ellipse cx="25" cy="42" rx="3.6" ry="4.6" fill="#22c6e6" opacity="0.45" />
      <ellipse cx="25" cy="42" rx="3.6" ry="4.6" fill="none" stroke="#0e9bc0" stroke-width="0.9" opacity="0.8" />
      <circle class="t-ear-led" cx="24.4" cy="41" r="1.5" fill="#d6fbff" />
    </g>
    <g>
      <ellipse cx="75" cy="42" rx="3.6" ry="4.6" fill="#22c6e6" opacity="0.45" />
      <ellipse cx="75" cy="42" rx="3.6" ry="4.6" fill="none" stroke="#0e9bc0" stroke-width="0.9" opacity="0.8" />
      <circle class="t-ear-led" cx="75.6" cy="41" r="1.5" fill="#d6fbff" />
    </g>

    <!-- face -->
    <!-- blush -->
    <ellipse cx="33" cy="47.5" rx="3.6" ry="2.3" fill="#ff7ab8" opacity="0.4" />
    <ellipse cx="67" cy="47.5" rx="3.6" ry="2.3" fill="#ff7ab8" opacity="0.4" />
    <!-- big personable eyes (kawaii navy + sparkle) -->
    <g class="t-eyes">
      <ellipse cx="40" cy="39" rx="5.2" ry="6.7" fill="#141a36" />
      <circle cx="38.2" cy="36.4" r="1.9" fill="#ffffff" />
      <circle cx="41.7" cy="41" r="0.95" fill="#ffffff" opacity="0.85" />
      <ellipse cx="60" cy="39" rx="5.2" ry="6.7" fill="#141a36" />
      <circle cx="58.2" cy="36.4" r="1.9" fill="#ffffff" />
      <circle cx="61.7" cy="41" r="0.95" fill="#ffffff" opacity="0.85" />
    </g>
    <!-- beak + friendly smile -->
    <path d="M46 47.4 Q50 48.3 54 47.4" fill="none" stroke="#2c6b4f" stroke-width="1.2" stroke-linecap="round" opacity="0.55" />
    <circle cx="48" cy="46" r="0.55" fill="#2c6b4f" opacity="0.7" />
    <circle cx="52" cy="46" r="0.55" fill="#2c6b4f" opacity="0.7" />
    <path d="M45.5 49.4 Q50 53 54.5 49.4" fill="none" stroke="#2c6b4f" stroke-width="1.7" stroke-linecap="round" />

    <!-- oscilloscope reactor = the central plastron plate (carries the speaking state) -->
    <g class="t-reactor">
      <circle class="t-scope-glow" cx="50" cy="81" r="13" fill="url(#tGlow)" opacity="0.5" />
      <circle cx="50" cy="81" r="9.3" fill="#0a0e1f" stroke="#1a2142" stroke-width="1" />
      <g clip-path="url(#tScopeClip)">
        <line x1="42.8" y1="81" x2="57.2" y2="81" stroke="#0ec4fc" stroke-width="0.6" opacity="0.3" />
        <g class="t-wave">
          <path class="t-wave-line"
            d="M26,81 Q28,74 30,81 Q32,88 34,81 Q36,74 38,81 Q40,88 42,81 Q44,74 46,81 Q48,88 50,81 Q52,74 54,81 Q56,88 58,81 Q60,74 62,81 Q64,88 66,81 Q68,74 70,81 Q72,88 74,81"
            fill="none" stroke="#34ecff" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" />
        </g>
      </g>
      <circle cx="50" cy="81" r="10.3" fill="none" stroke="url(#tDye)" stroke-width="2.3" />
      <circle cx="50" cy="81" r="7.7" fill="none" stroke="#0ec4fc" stroke-width="0.7" opacity="0.5" />
    </g>

    <!-- antenna tip: hippie flower + glow -->
    <circle cx="50" cy="7" r="5.6" fill="url(#tGlow)" />
    <g class="t-antenna" transform="translate(50 7)">
      <g fill="#ff79b0">
        <circle cx="0" cy="-2.7" r="2" />
        <circle cx="2.57" cy="-0.83" r="2" />
        <circle cx="1.59" cy="2.18" r="2" />
        <circle cx="-1.59" cy="2.18" r="2" />
        <circle cx="-2.57" cy="-0.83" r="2" />
      </g>
      <circle r="1.8" fill="#ffd23d" />
      <circle r="0.7" fill="#fff3b0" />
    </g>
  </svg>
</span>

<style>
  .eng-turtle {
    display: inline-flex;
    width: var(--turtle-size, 72px);
    height: var(--turtle-size, 72px);
    line-height: 0;
    filter: drop-shadow(0 6px 12px rgba(14, 196, 252, 0.22));
    animation: t-bob 3.6s ease-in-out infinite;
  }
  .eng-turtle svg { overflow: visible; }

  .t-antenna { animation: t-antenna 1.9s ease-in-out infinite; transform-origin: 50px 7px; }
  .t-eyes { transform-box: fill-box; transform-origin: center; animation: t-blink 5.4s ease-in-out infinite; }
  .t-ear-led { animation: t-led 2.2s ease-in-out infinite; }
  .t-wave { animation: t-scroll 2.6s linear infinite; }
  .t-wave-line { transform-box: fill-box; transform-origin: center; }
  .t-scope-glow { transform-box: fill-box; transform-origin: center; animation: t-scope 3s ease-in-out infinite; }

  /* speaking amps the oscilloscope */
  .eng-turtle[data-speaking="true"] .t-wave { animation-duration: 0.85s; }
  .eng-turtle[data-speaking="true"] .t-wave-line {
    stroke: #c8f6ff;
    transform: scaleY(1.5);
    filter: drop-shadow(0 0 2px rgba(25, 224, 255, 0.9));
  }
  .eng-turtle[data-speaking="true"] .t-scope-glow { animation-duration: 0.85s; opacity: 0.9; }
  .eng-turtle[data-speaking="true"] .t-antenna { animation-duration: 1.1s; }

  @keyframes t-bob {
    0%, 100% { transform: translateY(0) rotate(-1deg); }
    50% { transform: translateY(-2.5px) rotate(1deg); }
  }
  @keyframes t-antenna {
    0%, 100% { opacity: 0.75; transform: scale(0.92); }
    50% { opacity: 1; transform: scale(1.12); }
  }
  @keyframes t-blink {
    0%, 93%, 100% { transform: scaleY(1); }
    96% { transform: scaleY(0.1); }
  }
  @keyframes t-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-8px); }
  }
  @keyframes t-scope {
    0%, 100% { opacity: 0.45; }
    50% { opacity: 0.75; }
  }
  @keyframes t-led {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .eng-turtle, .t-antenna, .t-eyes, .t-ear-led, .t-wave, .t-wave-line, .t-scope-glow {
      animation: none;
    }
  }
</style>
