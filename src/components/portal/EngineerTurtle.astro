---
/**
 * EngineerTurtle — the Engineer's avatar: "Richard", a cute hippie turtle who plays
 * a banjo (a Grateful Dead "Terrapin Station" nod). A clean, STATIC illustration in the
 * style of the reference art — an adorable classic turtle, not a sci-fi robot.
 *
 *   - chubby green turtle sitting and strumming a banjo (music = the engineer's craft)
 *   - studio headphones (the audio-engineer cue) + a rainbow gemstone necklace (hippie)
 *   - warm patterned shell, big friendly eyes; faint tie-dye wash on the banjo head;
 *     cyan glow halo so it reads on the dark UI
 *
 * No animation by design (keeps it light / no movement). The `speaking` prop is kept for
 * drop-in compatibility and only nudges the static glow. Self-contained <svg>, same
 * outer .eng-turtle wrapper + props + ~square dimensions. Tuned to read at 66px.
 */
interface Props {
  size?: number;
  speaking?: boolean;
  class?: string;
}
const { size = 72, speaking = false, class: className = "" } = Astro.props;
---

<span
  class:list={["eng-turtle", className]}
  data-speaking={speaking ? "true" : "false"}
  style={`--turtle-size:${size}px`}
  aria-hidden="true"
>
  <svg viewBox="0 0 100 100" width={size} height={size} role="img" aria-label="Richard, the engineer">
    <defs>
      <linearGradient id="tSkin" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#7ad492" />
        <stop offset="100%" stop-color="#45a863" />
      </linearGradient>
      <linearGradient id="tShell" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#e8b265" />
        <stop offset="100%" stop-color="#c2823a" />
      </linearGradient>
      <radialGradient id="tBelly" cx="50%" cy="38%" r="70%">
        <stop offset="0%" stop-color="#fbeebc" />
        <stop offset="100%" stop-color="#eccf86" />
      </radialGradient>
      <radialGradient id="tHeadGlow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#fff7e6" />
        <stop offset="100%" stop-color="#fff7e6" stop-opacity="0" />
      </radialGradient>
      <radialGradient id="tTie" cx="45%" cy="40%" r="65%">
        <stop offset="0%" stop-color="#ffd23d" stop-opacity="0.55" />
        <stop offset="55%" stop-color="#ff8a3d" stop-opacity="0.4" />
        <stop offset="100%" stop-color="#ff2d8b" stop-opacity="0.35" />
      </radialGradient>
    </defs>

    <!-- back shell (carapace) peeking behind -->
    <g>
      <ellipse cx="58" cy="52" rx="26" ry="24" fill="url(#tShell)" stroke="#7a4a1e" stroke-width="2" />
      <path d="M40 44 q18 -8 34 2" fill="none" stroke="#9c6a30" stroke-width="2" opacity="0.6" />
      <path d="M37 56 q22 -6 42 2" fill="none" stroke="#9c6a30" stroke-width="2" opacity="0.5" />
      <polygon points="58,40 67,45 66,55 56,57 49,49" fill="none" stroke="#8a5a26" stroke-width="1.6" opacity="0.55" />
    </g>

    <!-- feet -->
    <ellipse cx="36" cy="90" rx="8" ry="5.5" fill="url(#tSkin)" stroke="#1f7040" stroke-width="2" />
    <ellipse cx="64" cy="91" rx="8" ry="5.5" fill="url(#tSkin)" stroke="#1f7040" stroke-width="2" />
    <g stroke="#1f7040" stroke-width="1.2" opacity="0.5" stroke-linecap="round">
      <line x1="34" y1="89" x2="33" y2="93" /><line x1="38" y1="89" x2="38" y2="93" />
      <line x1="62" y1="90" x2="61" y2="94" /><line x1="66" y1="90" x2="66" y2="94" />
    </g>

    <!-- body -->
    <ellipse cx="49" cy="64" rx="25" ry="23" fill="url(#tSkin)" stroke="#1f7040" stroke-width="2.2" />
    <!-- plastron belly -->
    <ellipse cx="49" cy="67" rx="16" ry="16" fill="url(#tBelly)" stroke="#cB9a52" stroke-width="1.6" />
    <g stroke="#cda85d" stroke-width="1.1" opacity="0.65" stroke-linecap="round">
      <line x1="49" y1="53" x2="49" y2="82" />
      <line x1="49" y1="61" x2="37" y2="63" /><line x1="49" y1="61" x2="61" y2="63" />
      <line x1="49" y1="73" x2="36" y2="73" /><line x1="49" y1="73" x2="62" y2="73" />
    </g>

    <!-- far arm on the neck -->
    <path d="M64 62 q10 -6 13 -16" fill="none" stroke="#45a863" stroke-width="7" stroke-linecap="round" />

    <!-- banjo: neck + drum -->
    <g>
      <line x1="46" y1="68" x2="76" y2="40" stroke="#7a4e22" stroke-width="5.4" stroke-linecap="round" />
      <line x1="46" y1="68" x2="76" y2="40" stroke="#9c6a30" stroke-width="2.2" stroke-linecap="round" opacity="0.7" />
      <!-- headstock + pegs -->
      <rect x="73" y="33" width="8" height="9" rx="2.5" transform="rotate(-42 77 37)" fill="#5a3818" stroke="#3a2410" stroke-width="1" />
      <circle cx="79.5" cy="34.5" r="1.3" fill="#caa46a" /><circle cx="76" cy="31.5" r="1.3" fill="#caa46a" />
      <!-- drum -->
      <circle cx="40" cy="71" r="13" fill="#8a5a2b" stroke="#5a3818" stroke-width="2" />
      <circle cx="40" cy="71" r="9.5" fill="#f7efd6" stroke="#caa46a" stroke-width="1.4" />
      <circle cx="40" cy="71" r="9.5" fill="url(#tTie)" />
      <!-- bridge + a few strings -->
      <rect x="38.5" y="73" width="3" height="3.4" rx="0.6" fill="#7a4e22" />
      <g stroke="#d9c79a" stroke-width="0.8" opacity="0.9">
        <line x1="40" y1="75" x2="74" y2="41" /><line x1="41.4" y1="75.4" x2="75.4" y2="41.4" />
      </g>
      <!-- tuning ring detail -->
      <circle cx="40" cy="71" r="12" fill="none" stroke="#caa46a" stroke-width="0.8" opacity="0.5" stroke-dasharray="1.5 3" />
    </g>

    <!-- near hand strumming -->
    <ellipse cx="46" cy="74" rx="6" ry="5" fill="url(#tSkin)" stroke="#1f7040" stroke-width="2" transform="rotate(20 46 74)" />

    <!-- head -->
    <ellipse cx="47" cy="29" rx="17" ry="15.5" fill="url(#tSkin)" stroke="#1f7040" stroke-width="2.2" />
    <ellipse cx="40" cy="20" rx="6" ry="3" fill="#ffffff" opacity="0.18" transform="rotate(-22 40 20)" />
    <!-- freckles -->
    <g fill="#2f9e6e" opacity="0.55">
      <circle cx="35" cy="31" r="0.85" /><circle cx="38" cy="33" r="0.85" />
      <circle cx="59" cy="31" r="0.85" /><circle cx="56" cy="33" r="0.85" />
    </g>
    <!-- eyes -->
    <ellipse cx="41" cy="29" rx="3.8" ry="5" fill="#15203a" />
    <circle cx="39.7" cy="26.8" r="1.5" fill="#fff" /><circle cx="42.2" cy="31" r="0.8" fill="#fff" opacity="0.85" />
    <ellipse cx="54" cy="29" rx="3.8" ry="5" fill="#15203a" />
    <circle cx="52.7" cy="26.8" r="1.5" fill="#fff" /><circle cx="55.2" cy="31" r="0.8" fill="#fff" opacity="0.85" />
    <!-- blush -->
    <ellipse cx="35" cy="34" rx="3" ry="1.9" fill="#ff7ab8" opacity="0.45" />
    <ellipse cx="59" cy="34" rx="3" ry="1.9" fill="#ff7ab8" opacity="0.45" />
    <!-- nose + smile -->
    <circle cx="45.5" cy="35" r="0.6" fill="#1f5a40" /><circle cx="49.5" cy="35" r="0.6" fill="#1f5a40" />
    <path d="M43 37.5 Q47.5 41.5 52 37.5" fill="none" stroke="#1f5a40" stroke-width="1.7" stroke-linecap="round" />

    <!-- studio headphones (audio-engineer cue) -->
    <g>
      <path d="M30 25 Q47 -5 64 25" fill="none" stroke="#2b2f3c" stroke-width="4" stroke-linecap="round" />
      <path d="M31 25 Q47 -1 63 25" fill="none" stroke="#0ec4fc" stroke-width="1" stroke-linecap="round" opacity="0.5" />
      <g stroke="#171a24" stroke-width="1.2">
        <ellipse cx="29" cy="31" rx="5.2" ry="7.2" fill="#2b2f3c" />
        <ellipse cx="65" cy="31" rx="5.2" ry="7.2" fill="#2b2f3c" />
      </g>
      <ellipse cx="29.5" cy="31" rx="2.6" ry="4.4" fill="#3a4150" />
      <ellipse cx="64.5" cy="31" rx="2.6" ry="4.4" fill="#3a4150" />
      <circle cx="29.5" cy="31" r="1.3" fill="#0ec4fc" opacity="0.85" />
      <circle cx="64.5" cy="31" r="1.3" fill="#0ec4fc" opacity="0.85" />
    </g>

    <!-- rainbow gemstone necklace (hippie) -->
    <g>
      <path d="M34 45 Q47 51.5 60 45" fill="none" stroke="#caa24a" stroke-width="1.1" opacity="0.85" />
      <g stroke="#ffffff" stroke-width="0.3" stroke-opacity="0.6">
        <rect x="-1.5" y="-1.5" width="3" height="3" transform="translate(35 45.6) rotate(45)" fill="#a06cf0" />
        <rect x="-1.5" y="-1.5" width="3" height="3" transform="translate(39 47.7) rotate(45)" fill="#4f8cff" />
        <rect x="-1.5" y="-1.5" width="3" height="3" transform="translate(43 49.1) rotate(45)" fill="#3ddc84" />
        <rect x="-2.1" y="-2.1" width="4.2" height="4.2" transform="translate(47 49.8) rotate(45)" fill="#ffd23d" />
        <rect x="-1.5" y="-1.5" width="3" height="3" transform="translate(51 49.1) rotate(45)" fill="#ff8a3d" />
        <rect x="-1.5" y="-1.5" width="3" height="3" transform="translate(55 47.7) rotate(45)" fill="#ff2d8b" />
        <rect x="-1.5" y="-1.5" width="3" height="3" transform="translate(59 45.6) rotate(45)" fill="#ff5fa0" />
      </g>
      <circle cx="47" cy="49.8" r="0.7" fill="#fff8d8" />
    </g>
  </svg>
</span>

<style>
  .eng-turtle {
    display: inline-flex;
    width: var(--turtle-size, 72px);
    height: var(--turtle-size, 72px);
    line-height: 0;
    filter: drop-shadow(0 4px 10px rgba(14, 196, 252, 0.22));
  }
  .eng-turtle svg { overflow: visible; }
  /* static: a touch more glow while "speaking", no motion */
  .eng-turtle[data-speaking="true"] { filter: drop-shadow(0 4px 12px rgba(14, 196, 252, 0.34)); }
</style>
