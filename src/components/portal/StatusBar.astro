---
// Live M1+M3 status widget. Tolo.Cloud aesthetic: soft glass pill with
// gradient-tinted text. M1 jobs render in lavender, remote workers in
// pink — the same hierarchy the wordmark gradient uses. Thin progress
// line under the text tracks overall catalog transcription progress.
// Polls /status every 15s while the tab is visible; auto-hides on
// sustained failure.
---

<aside class="status-bar" data-status-bar data-state="loading" aria-live="polite" aria-label="Engine status">
  <span class="text" data-status-text>
    <span class="tok-dim">checking</span> <span class="tok-job">m1</span><span class="tok-sep">…</span>
  </span>
  <div class="bar" data-bar aria-hidden="true">
    <div class="bar-fill" data-bar-fill style="width: 0%"></div>
  </div>
</aside>

<style>
  /* Tolo.Cloud-tinted glass widget. No code-editor palette, no glow halos,
     no pulsing dot — those read as "terminal" and the rest of the surface
     is no longer trying to be a console. Container takes its state cue
     from [data-state] which the script sets per tick. */
  .status-bar {
    display: inline-flex;
    flex-direction: column;
    align-items: stretch;
    gap: 6px;
    padding: 8px 14px 7px;
    font-family: "Geist Variable", ui-sans-serif, system-ui, -apple-system, sans-serif;
    font-size: 12px;
    font-weight: 500;
    line-height: 1.2;
    color: rgba(245, 241, 232, 0.86);
    background: color-mix(in srgb, #1a1422 70%, transparent);
    border: 1px solid color-mix(in srgb, #c7a8ff 14%, transparent);
    border-radius: 12px;
    backdrop-filter: saturate(140%) blur(10px);
    -webkit-backdrop-filter: saturate(140%) blur(10px);
    letter-spacing: 0;
    max-width: 100%;
    transition: border-color 280ms ease, box-shadow 280ms ease, background 280ms ease;
  }
  .status-bar[data-state="busy"] {
    border-color: color-mix(in srgb, #ff6fcf 26%, transparent);
    box-shadow: 0 0 24px color-mix(in srgb, #ff6fcf 10%, transparent);
  }
  .status-bar[data-state="warn"] {
    border-color: color-mix(in srgb, #ffd76a 38%, transparent);
    box-shadow: 0 0 24px color-mix(in srgb, #ffd76a 12%, transparent);
  }
  .status-bar[data-state="err"] {
    border-color: color-mix(in srgb, #ff8a8a 44%, transparent);
    box-shadow: 0 0 24px color-mix(in srgb, #ff8a8a 14%, transparent);
  }
  .status-bar[hidden] { display: none; }

  /* Text row — sans-serif, no glow halos per span. */
  .text {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  /* M1 job — lavender. Echoes the brand wordmark's lavender stop. */
  .status-bar :global(.tok-job) {
    color: #c7a8ff;
    font-weight: 600;
  }
  /* Remote worker (e.g. m3-whisper) — pink. Echoes the wordmark's pink
     stop so the eye reads "different machine" at a glance. */
  .status-bar :global(.tok-worker) {
    color: #ff6fcf;
    font-weight: 600;
  }
  .status-bar :global(.tok-num) {
    color: #f5f1e8;
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }
  .status-bar :global(.tok-key) {
    color: rgba(245, 241, 232, 0.55);
    font-weight: 500;
  }
  .status-bar :global(.tok-keyword) {
    color: rgba(245, 241, 232, 0.55);
    font-weight: 500;
  }
  .status-bar :global(.tok-eta) {
    color: rgba(245, 241, 232, 0.42);
    font-weight: 500;
  }
  .status-bar :global(.tok-warn) {
    color: #ff8a8a;
    font-weight: 600;
  }
  .status-bar :global(.tok-dim) {
    color: rgba(245, 241, 232, 0.32);
  }
  .status-bar :global(.tok-sep) {
    color: rgba(245, 241, 232, 0.22);
    margin: 0 4px;
  }

  /* Progress line — overall catalog transcription %. Pink → cyan gradient
     reading left-to-right, matching the Tolo.Cloud palette. */
  .bar {
    height: 2px;
    width: 100%;
    background: color-mix(in srgb, #c7a8ff 8%, transparent);
    border-radius: 999px;
    overflow: hidden;
    position: relative;
  }
  .bar-fill {
    height: 100%;
    background: linear-gradient(90deg, #ff6fcf 0%, #c7a8ff 60%, #74c4ff 100%);
    box-shadow: 0 0 8px rgba(255, 109, 196, 0.35);
    transition: width 480ms cubic-bezier(.22,.61,.36,1);
    border-radius: 999px;
  }
  .status-bar[data-state="warn"] .bar-fill {
    background: linear-gradient(90deg, #ffd76a 0%, #ff8a8a 100%);
    box-shadow: 0 0 8px rgba(255, 215, 106, 0.4);
  }
  .status-bar[data-state="err"] .bar { display: none; }

  @media (max-width: 700px) {
    .status-bar { font-size: 11.5px; padding: 7px 12px 6px; border-radius: 10px; }
  }
</style>

<script>
  const POLL_MS = 15000;
  const bar = document.querySelector("[data-status-bar]");
  const text = document.querySelector("[data-status-text]");
  const barFill = document.querySelector("[data-bar-fill]");

  if (bar && text && barFill) {
    let timer = null;
    let consecutiveErrors = 0;

    const esc = (s) => String(s).replace(/[&<>"]/g, (c) => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
    const n = (v) => Number(v).toLocaleString();
    const tok = (cls, val) => `<span class="${cls}">${esc(val)}</span>`;
    const sep = `<span class="tok-sep">·</span>`;
    const slash = `<span class="tok-sep">/</span>`;

    // Format seconds → "—" / "47m" / "2.3h" / "1.4d". Returns null markup
    // when eta is null/undefined so the caller can omit the segment.
    const fmtEta = (secs) => {
      if (secs === null || secs === undefined) return null;
      if (secs < 60) return "—";
      if (secs < 3600) return Math.round(secs / 60) + "m";
      if (secs < 86400) return (secs / 3600).toFixed(1) + "h";
      return (secs / 86400).toFixed(1) + "d";
    };

    const setState = (kind, html) => {
      bar.setAttribute("data-state", kind);
      text.innerHTML = html;
    };

    // Engine-internal helpers don't belong in the curator-facing headline.
    const HIDDEN_JOBS = new Set(["console-api", "task-inbox", "inbox-watcher"]);

    const renderStatus = (data) => {
      const busyJobs = (data.jobs || []).filter((j) => j.running && !HIDDEN_JOBS.has(j.name));
      const workers = data.workers || [];
      const diskPct = data.disk && data.disk.internal_pct_used;
      const diskWarn = diskPct !== null && diskPct !== undefined && diskPct >= 90;

      const parts = [];
      let kind = "ok";

      const m1Headline = busyJobs.find((j) => j.progress) || busyJobs[0] || null;
      const headlineFragments = [];

      if (m1Headline) {
        kind = "busy";
        let frag = tok("tok-job", "m1-" + m1Headline.name.replace(/-backfill$/, ""));
        if (m1Headline.progress) {
          frag += " " + tok("tok-num", m1Headline.progress[0]) + slash + tok("tok-num", m1Headline.progress[1]);
        } else {
          frag += " " + tok("tok-keyword", "running");
        }
        const eta = fmtEta(m1Headline.eta_seconds);
        if (eta) frag += " " + tok("tok-eta", "ETA") + " " + tok("tok-num", eta);
        headlineFragments.push(frag);
      }

      for (const w of workers) {
        kind = "busy";
        let frag = tok("tok-worker", w.worker_id) + " " +
          tok("tok-num", w.rows_done) + slash + tok("tok-num", w.rows_total);
        const eta = fmtEta(w.eta_seconds);
        if (eta) frag += " " + tok("tok-eta", "ETA") + " " + tok("tok-num", eta);
        headlineFragments.push(frag);
      }

      if (headlineFragments.length === 0) {
        headlineFragments.push(tok("tok-keyword", "idle"));
      }
      parts.push(headlineFragments.join(" " + sep + " "));

      const cat = data.catalog || { transcribed: 0, total_user: 0 };
      parts.push(
        tok("tok-key", "cat") + " " +
        tok("tok-num", n(cat.transcribed)) + slash + tok("tok-dim", n(cat.total_user))
      );

      if (diskPct !== null && diskPct !== undefined) {
        parts.push(
          tok("tok-key", "disk") + " " +
          tok(diskWarn ? "tok-warn" : "tok-num", diskPct + "%")
        );
      }

      if (diskWarn) kind = "warn";

      setState(kind, parts.join(" " + sep + " "));

      const pct = cat.total_user > 0
        ? Math.max(0, Math.min(100, (cat.transcribed / cat.total_user) * 100))
        : 0;
      barFill.style.width = pct.toFixed(2) + "%";
    };

    const tick = async () => {
      try {
        const res = await fetch("/api/console/status", { cache: "no-store" });
        if (!res.ok) {
          consecutiveErrors++;
          if (consecutiveErrors > 2) bar.hidden = true;
          else setState("err", tok("tok-warn", "engine unreachable") + " " + tok("tok-dim", "(" + res.status + ")"));
          return;
        }
        consecutiveErrors = 0;
        bar.hidden = false;
        renderStatus(await res.json());
      } catch (e) {
        consecutiveErrors++;
        if (consecutiveErrors > 2) bar.hidden = true;
        else setState("err", tok("tok-warn", "engine offline"));
      }
    };

    const schedule = () => {
      if (timer !== null) { clearTimeout(timer); timer = null; }
      if (document.hidden) return;
      tick();
      timer = setTimeout(schedule, POLL_MS);
    };

    document.addEventListener("visibilitychange", schedule);
    schedule();
  }
</script>
