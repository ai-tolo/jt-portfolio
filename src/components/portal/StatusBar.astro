---
// Live M1+M3 status widget. Three compartments side-by-side:
//   M1 ─── M3 ─── SYSTEM
// Each cell carries its own label, body, and progress sliver. M1 reads
// in bright blue, M3 in pink, system in plain white. Vertical dividers
// between cells make the hierarchy obvious. Polls /status every 15s
// while the tab is visible; auto-hides on sustained failure.
---

<aside class="status-bar" data-status-bar data-state="loading" aria-live="polite" aria-label="Engine status">
  <div class="cells">
    <section class="cell cell-m1">
      <div class="cell-label">M1</div>
      <div class="cell-body" data-cell="m1">
        <span class="tok-dim">checking…</span>
      </div>
      <div class="cell-bar"><div class="cell-bar-fill" data-cell-bar="m1" style="width: 0%"></div></div>
    </section>
    <section class="cell cell-m3">
      <div class="cell-label">M3</div>
      <div class="cell-body" data-cell="m3">
        <span class="tok-dim">idle</span>
      </div>
      <div class="cell-bar"><div class="cell-bar-fill" data-cell-bar="m3" style="width: 0%"></div></div>
    </section>
    <section class="cell cell-sys">
      <div class="cell-label">SYS</div>
      <div class="cell-body" data-cell="sys">
        <span class="tok-dim">—</span>
      </div>
      <div class="cell-bar"><div class="cell-bar-fill" data-cell-bar="sys" style="width: 0%"></div></div>
    </section>
  </div>
</aside>

<style>
  /* Three-compartment widget. Cells flex horizontally with a thin vertical
     rule between them; each cell has its own micro-label and progress
     sliver. The container is a soft glass shell on the interstellar
     backdrop. */
  .status-bar {
    display: inline-block;
    padding: 7px 14px 6px;
    font-family: "Geist Variable", ui-sans-serif, system-ui, -apple-system, sans-serif;
    font-size: 12px;
    font-weight: 500;
    line-height: 1.2;
    color: rgba(245, 241, 232, 0.88);
    background: color-mix(in srgb, #0d060f 78%, transparent);
    border: 1px solid color-mix(in srgb, #0ec4fc 22%, transparent);
    border-radius: 10px;
    backdrop-filter: saturate(140%) blur(10px);
    -webkit-backdrop-filter: saturate(140%) blur(10px);
    max-width: 100%;
    transition: border-color 280ms ease, box-shadow 280ms ease, background 280ms ease;
  }
  .status-bar[data-state="busy"] {
    border-color: color-mix(in srgb, #0ec4fc 40%, transparent);
    box-shadow: 0 0 22px color-mix(in srgb, #0ec4fc 12%, transparent);
  }
  .status-bar[data-state="warn"] {
    border-color: color-mix(in srgb, #ff6e21 46%, transparent);
    box-shadow: 0 0 22px color-mix(in srgb, #ff6e21 14%, transparent);
  }
  .status-bar[data-state="err"] {
    border-color: color-mix(in srgb, #ff5a6a 48%, transparent);
    box-shadow: 0 0 22px color-mix(in srgb, #ff5a6a 14%, transparent);
  }
  .status-bar[hidden] { display: none; }

  .cells {
    display: flex;
    align-items: stretch;
    gap: 12px;
  }
  .cell {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 4px;
    padding-right: 12px;
    border-right: 1px solid rgba(245, 241, 232, 0.08);
    min-width: 0;
  }
  .cell:last-child { border-right: 0; padding-right: 0; }

  .cell-label {
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(245, 241, 232, 0.45);
  }
  .cell-m1 .cell-label { color: rgba(14, 196, 252, 0.85); }
  .cell-m3 .cell-label { color: rgba(255, 59, 110, 0.90); }
  .cell-sys .cell-label { color: rgba(245, 241, 232, 0.55); }

  .cell-body {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Per-cell sliver. M1 + M3 reflect their own job progress; SYS shows
     overall catalog transcribed%. Thin, single-color per cell. */
  .cell-bar {
    height: 2px;
    width: 100%;
    background: rgba(245, 241, 232, 0.06);
    border-radius: 999px;
    overflow: hidden;
  }
  .cell-bar-fill {
    height: 100%;
    border-radius: 999px;
    transition: width 480ms cubic-bezier(.22,.61,.36,1), background 280ms ease;
  }
  .cell-m1 .cell-bar-fill {
    background: #0ec4fc;
    box-shadow: 0 0 6px rgba(14, 196, 252, 0.45);
  }
  .cell-m3 .cell-bar-fill {
    background: #ff3b6e;
    box-shadow: 0 0 6px rgba(255, 59, 110, 0.45);
  }
  .cell-sys .cell-bar-fill {
    background: linear-gradient(90deg, #ff3b6e 0%, #ff6e21 100%);
    box-shadow: 0 0 6px rgba(255, 59, 110, 0.42);
  }

  /* Token spans — JS-injected, so wrapped in :global() to escape Astro
     CSS scoping. */
  .status-bar :global(.tok-num) {
    color: #f5f1e8;
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }
  .status-bar :global(.tok-key) {
    color: rgba(245, 241, 232, 0.55);
    font-weight: 500;
  }
  .status-bar :global(.tok-keyword) {
    color: rgba(245, 241, 232, 0.5);
    font-weight: 500;
  }
  .status-bar :global(.tok-eta) {
    color: rgba(245, 241, 232, 0.42);
    font-weight: 500;
  }
  .status-bar :global(.tok-warn) {
    color: #ff6e21;
    font-weight: 600;
  }
  .status-bar :global(.tok-dim) {
    color: rgba(245, 241, 232, 0.30);
  }
  .status-bar :global(.tok-sep) {
    color: rgba(245, 241, 232, 0.22);
    margin: 0 4px;
  }

  @media (max-width: 700px) {
    .status-bar { font-size: 11.5px; padding: 6px 12px 5px; border-radius: 9px; }
    .cells { gap: 8px; }
    .cell { padding-right: 8px; }
    .cell-label { font-size: 8.5px; }
  }
</style>

<script>
  const POLL_MS = 15000;
  const bar = document.querySelector("[data-status-bar]");
  const cellM1 = document.querySelector('[data-cell="m1"]');
  const cellM3 = document.querySelector('[data-cell="m3"]');
  const cellSys = document.querySelector('[data-cell="sys"]');
  const barM1 = document.querySelector('[data-cell-bar="m1"]');
  const barM3 = document.querySelector('[data-cell-bar="m3"]');
  const barSys = document.querySelector('[data-cell-bar="sys"]');

  if (bar && cellM1 && cellM3 && cellSys && barM1 && barM3 && barSys) {
    let timer = null;
    let consecutiveErrors = 0;

    const esc = (s) => String(s).replace(/[&<>"]/g, (c) => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
    const n = (v) => Number(v).toLocaleString();
    const tok = (cls, val) => `<span class="${cls}">${esc(val)}</span>`;
    const sep = `<span class="tok-sep">·</span>`;
    const slash = `<span class="tok-sep">/</span>`;

    const fmtEta = (secs) => {
      if (secs === null || secs === undefined) return null;
      if (secs < 60) return "—";
      if (secs < 3600) return Math.round(secs / 60) + "m";
      if (secs < 86400) return (secs / 3600).toFixed(1) + "h";
      return (secs / 86400).toFixed(1) + "d";
    };

    const pct = (done, total) => total > 0
      ? Math.max(0, Math.min(100, (done / total) * 100))
      : 0;

    const HIDDEN_JOBS = new Set(["console-api", "task-inbox", "inbox-watcher"]);

    const renderM1 = (jobs) => {
      const busy = jobs.filter((j) => j.running && !HIDDEN_JOBS.has(j.name));
      const j = busy.find((x) => x.progress) || busy[0] || null;
      if (!j) {
        cellM1.innerHTML = tok("tok-dim", "idle");
        barM1.style.width = "0%";
        return false;
      }
      const parts = [];
      const label = j.name.replace(/-backfill$/, "");
      parts.push(tok("tok-key", label));
      if (j.progress) {
        parts.push(tok("tok-num", j.progress[0]) + slash + tok("tok-num", j.progress[1]));
        barM1.style.width = pct(j.progress[0], j.progress[1]).toFixed(2) + "%";
      } else {
        parts.push(tok("tok-keyword", "running"));
        barM1.style.width = "0%";
      }
      const eta = fmtEta(j.eta_seconds);
      if (eta) parts.push(tok("tok-eta", "ETA") + " " + tok("tok-num", eta));
      cellM1.innerHTML = parts.join(" ");
      return true;
    };

    const renderM3 = (workers) => {
      const w = workers.find((x) => x.worker_id.startsWith("m3")) || workers[0] || null;
      if (!w) {
        cellM3.innerHTML = tok("tok-dim", "idle");
        barM3.style.width = "0%";
        return false;
      }
      const parts = [];
      parts.push(tok("tok-key", w.worker_id.replace(/^m3-/, "")));
      parts.push(tok("tok-num", w.rows_done) + slash + tok("tok-num", w.rows_total));
      const eta = fmtEta(w.eta_seconds);
      if (eta) parts.push(tok("tok-eta", "ETA") + " " + tok("tok-num", eta));
      cellM3.innerHTML = parts.join(" ");
      barM3.style.width = pct(w.rows_done, w.rows_total).toFixed(2) + "%";
      return true;
    };

    const renderSys = (cat, disk) => {
      const parts = [];
      parts.push(
        tok("tok-key", "cat") + " " +
        tok("tok-num", n(cat.transcribed)) + slash + tok("tok-dim", n(cat.total_user))
      );
      const diskPct = disk && disk.internal_pct_used;
      const diskWarn = diskPct !== null && diskPct !== undefined && diskPct >= 90;
      if (diskPct !== null && diskPct !== undefined) {
        parts.push(
          tok("tok-key", "disk") + " " +
          tok(diskWarn ? "tok-warn" : "tok-num", diskPct + "%")
        );
      }
      cellSys.innerHTML = parts.join(" " + sep + " ");
      barSys.style.width = pct(cat.transcribed, cat.total_user).toFixed(2) + "%";
      return diskWarn;
    };

    const renderStatus = (data) => {
      const m1Busy = renderM1(data.jobs || []);
      const m3Busy = renderM3(data.workers || []);
      const diskWarn = renderSys(
        data.catalog || { transcribed: 0, total_user: 0 },
        data.disk || {},
      );
      let kind = "ok";
      if (m1Busy || m3Busy) kind = "busy";
      if (diskWarn) kind = "warn";
      bar.setAttribute("data-state", kind);
    };

    const renderError = (label) => {
      cellM1.innerHTML = tok("tok-warn", label);
      cellM3.innerHTML = tok("tok-dim", "—");
      cellSys.innerHTML = tok("tok-dim", "—");
      bar.setAttribute("data-state", "err");
    };

    const tick = async () => {
      try {
        const res = await fetch("/api/console/status", { cache: "no-store" });
        if (!res.ok) {
          consecutiveErrors++;
          if (consecutiveErrors > 2) bar.hidden = true;
          else renderError("engine " + res.status);
          return;
        }
        consecutiveErrors = 0;
        bar.hidden = false;
        renderStatus(await res.json());
      } catch (e) {
        consecutiveErrors++;
        if (consecutiveErrors > 2) bar.hidden = true;
        else renderError("engine offline");
      }
    };

    const schedule = () => {
      if (timer !== null) { clearTimeout(timer); timer = null; }
      if (document.hidden) return;
      tick();
      timer = setTimeout(schedule, POLL_MS);
    };

    document.addEventListener("visibilitychange", schedule);
    schedule();
  }
</script>
