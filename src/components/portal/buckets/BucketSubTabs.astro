---
import type { BucketName } from "../../../lib/console-types";

interface Props {
  current: BucketName;
  counts?: Partial<Record<BucketName, number>>;
}

const { current, counts } = Astro.props;

const tabs: { id: BucketName; label: string; href: string }[] = [
  { id: "inbox", label: "Inbox", href: "/portal/buckets/inbox" },
  { id: "voice_memo", label: "Voice Memos", href: "/portal/buckets/voice_memo" },
  { id: "loop", label: "Loops", href: "/portal/buckets/loop" },
  { id: "song", label: "Songs", href: "/portal/buckets/song" },
  { id: "trash", label: "Trash", href: "/portal/buckets/trash" },
];
---

<nav class="sub-tabs" aria-label="Bucket sub-views">
  <ul role="list">
    {tabs.map((t) => (
      <li>
        <a
          href={t.href}
          class:list={["sub-tab", { active: t.id === current }]}
          aria-current={t.id === current ? "page" : undefined}
        >
          <span>{t.label}</span>
          {counts && counts[t.id] !== undefined && (
            <span class="count">{counts[t.id]}</span>
          )}
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .sub-tabs ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    border-bottom: 1px solid var(--line);
  }
  .sub-tab {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--muted);
    padding: 8px 10px;
    text-decoration: none;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    transition: color 160ms ease, border-color 160ms ease;
  }
  .sub-tab:hover { color: var(--text); }
  .sub-tab.active {
    color: var(--accent);
    border-color: var(--accent);
  }
  .count {
    font-size: 10px;
    font-weight: var(--fw-medium);
    color: var(--muted);
    background: color-mix(in srgb, var(--ink) 12%, transparent);
    padding: 1px 6px;
    letter-spacing: 0;
    font-feature-settings: "tnum";
  }
  .sub-tab.active .count { color: var(--accent); }
</style>
