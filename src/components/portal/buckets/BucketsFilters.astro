---
import type {
  BucketView,
  BucketCategory,
  BucketSort,
  TopTag,
} from "../../../lib/console-types";

interface Props {
  bucket: BucketView;
  category: BucketCategory;
  sort: BucketSort;
  /** True when the URL carries an explicit ?sort=. Lets the 3-state
   *  toggles distinguish "no toggle active" from "Date desc explicit". */
  sortExplicit: boolean;
  q: string;
  activeTags: string[];
  topTags: TopTag[];
  /** Active duration range (seconds), if any. Drives the preset chip
   *  active-state and prefills the manual inputs. */
  durationMin?: number;
  durationMax?: number;
}

const { bucket, category, sort, sortExplicit, q, activeTags, topTags, durationMin, durationMax } = Astro.props;
const activeSet = new Set(activeTags);

const CATEGORIES: { id: BucketCategory; label: string; hint: string }[] = [
  { id: "all", label: "All", hint: "Everything in this bucket" },
  { id: "jam", label: "Jam", hint: "Long-form (>5min) musical captures (auto-classified)" },
  { id: "loops", label: "Loops", hint: "Loop-ready rows (curator-picked)" },
  { id: "oneshot", label: "One-shot", hint: "Single hits — kicks, snares, stabs, vox chops (<10s). Includes your Splice library so you can grab a sample mid-build." },
  { id: "field", label: "Field", hint: "Voice memos + audio extracted from videos (auto-classified)" },
  { id: "tracks", label: "Tracks", hint: "Curator-picked tracks" },
  { id: "other", label: "Inbox", hint: "Unbucketed residual, awaiting auto-classification or curator pick" },
];

// Duration preset chips for the most common range needs. Each maps to a
// [min, max] pair (null = unbounded). The "Songs" preset is the headline
// use-case: find song candidates in the 45s–5min band.
type DurationPreset = { id: string; label: string; min: number | null; max: number | null; hint: string };
const DURATION_PRESETS: DurationPreset[] = [
  { id: "songs", label: "Songs 45s–5m", min: 45, max: 300, hint: "Song candidates: 45 seconds to 5 minutes" },
  { id: "short", label: "Loops <45s", min: null, max: 45, hint: "Loop-length and shorter" },
  { id: "long", label: "Long >5m", min: 300, max: null, hint: "Long-form: over 5 minutes" },
];
const durationActive = durationMin !== undefined || durationMax !== undefined;
const presetIsActive = (p: DurationPreset): boolean =>
  (p.min ?? undefined) === durationMin && (p.max ?? undefined) === durationMax;

// Sort toggles consolidate paired sort directions into a single 3-state
// button per dimension: off → asc → desc → off. The "off" position falls
// back to the engine default (`recent`), so toggling Date "off" produces
// the same query as Date desc — that's fine: the toggle communicates the
// curator's intent, not just the ORDER BY.
//
// `null` in the asc/desc slot means that direction is not exposed (e.g.
// Kudos only sorts descending — ascending would just surface every 0-kudos
// row, which is most of the catalog).
type SortDim = {
  key: string;
  label: string;
  asc: BucketSort | null;
  desc: BucketSort | null;
};
const SORT_DIMS: SortDim[] = [
  { key: "date",     label: "Date",     asc: "oldest",       desc: "recent" },
  { key: "duration", label: "Duration", asc: "shortest",     desc: "longest" },
  { key: "bpm",      label: "BPM",      asc: "bpm-asc",      desc: "bpm-desc" },
  { key: "used",     label: "Used",     asc: "least-used",   desc: "most-used" },
  { key: "silent",   label: "Silent",   asc: null,           desc: "silence-desc" },
];

// State of a sort dimension given the active sort param. `"off"` means
// no direction is asserted for this dimension; `"asc"` / `"desc"` means
// the dim is currently driving the ORDER BY. When `sortExplicit` is
// false (no ?sort= in URL), every dim is "off" — even the one whose
// desc maps to the engine default ("recent"), since the user hasn't
// explicitly asserted that direction.
const sortStateFor = (dim, currentSort, explicit) => {
  if (!explicit) return "off";
  if (currentSort === dim.asc) return "asc";
  if (currentSort === dim.desc) return "desc";
  return "off";
};

// Next-state sort key for a click. Cycle is off → asc → desc → off.
// When asc is null, skip directly to desc (and back). When desc is null,
// the toggle just flips on/off via asc. Returns null to mean "remove sort
// param" (engine falls back to `recent`).
const nextSort = (dim, currentState) => {
  if (currentState === "off") return dim.asc ?? dim.desc;
  if (currentState === "asc") return dim.desc ?? null;
  return null; // desc → off
};

const base = `/portal/buckets/${bucket}`;
const tagsCsv = activeTags.join(",");
const buildHref = (overrides: Record<string, string | null>): string => {
  const p = new URLSearchParams();
  // Inherit current sort only when it was set explicitly (i.e. user
  // toggled something). If the page is in default-sort state, we want
  // child links to stay clean (no sort param) until the user clicks a
  // sort toggle themselves.
  if (sortExplicit) p.set("sort", sort);
  if (category && category !== "all") p.set("category", category);
  if (q) p.set("q", q);
  if (tagsCsv) p.set("tags", tagsCsv);
  if (durationMin !== undefined) p.set("duration_min", String(durationMin));
  if (durationMax !== undefined) p.set("duration_max", String(durationMax));
  for (const [k, v] of Object.entries(overrides)) {
    if (v === null || v === "") p.delete(k);
    else p.set(k, v);
  }
  if (p.get("category") === "all") p.delete("category");
  // Changing any filter resets pagination to page 1.
  p.delete("offset");
  const qs = p.toString();
  return qs ? `${base}?${qs}` : base;
};

// Duration preset href: toggles the preset (click active → clear). Resets
// to page 1 via buildHref's offset delete.
const durationHref = (p: DurationPreset): string =>
  presetIsActive(p)
    ? buildHref({ duration_min: null, duration_max: null })
    : buildHref({
        duration_min: p.min === null ? null : String(p.min),
        duration_max: p.max === null ? null : String(p.max),
      });
const clearDurationHref = buildHref({ duration_min: null, duration_max: null });

// Each chip's href toggles its tag in/out of the active set. Active tags
// AND together server-side, so clicking adds an extra constraint; clicking
// an already-active chip removes it.
const buildTagsHref = (tag: string): string => {
  const next = activeSet.has(tag)
    ? activeTags.filter((t) => t !== tag)
    : [...activeTags, tag];
  return buildHref({ tags: next.join(",") });
};

const clearTagsHref = buildHref({ tags: "" });

const activeCategory = CATEGORIES.find((c) => c.id === category) ?? CATEGORIES[0];
---

<section class="filters" aria-label="Bucket filters">
  {/*
    Tags chip strip — top 10 tags by frequency in the current
    bucket+category view. Clicking a chip toggles its tag in the active
    set (AND semantics across multiple chips). The strip itself is
    computed BEFORE the active filter is applied so it stays stable as
    the curator narrows. Hidden when there's nothing taggable to show.
  */}
  {(topTags.length > 0 || activeTags.length > 0) && (
    <nav class="tags-strip" aria-label="Filter by tag">
      <span class="tags-label">Tags</span>
      <ul class="tags-list" role="list">
        {topTags.map((t) => (
          <li>
            <a
              href={buildTagsHref(t.tag)}
              class:list={["tag-chip", { active: activeSet.has(t.tag) }]}
              aria-pressed={activeSet.has(t.tag) ? "true" : "false"}
              title={activeSet.has(t.tag) ? `Remove ${t.tag} filter` : `Filter by ${t.tag}`}
            >
              <span class="tag-name">{t.tag}</span>
              <span class="tag-count">{t.count.toLocaleString()}</span>
            </a>
          </li>
        ))}
        {/* If the user has tags active that aren't in the top 10 (e.g.
            they navigated in via URL or the counts shifted), still render
            them as active chips so they can be toggled off. */}
        {activeTags
          .filter((t) => !topTags.some((tt) => tt.tag === t))
          .map((t) => (
            <li>
              <a
                href={buildTagsHref(t)}
                class:list={["tag-chip", "active"]}
                aria-pressed="true"
                title={`Remove ${t} filter`}
              >
                <span class="tag-name">{t}</span>
              </a>
            </li>
          ))}
      </ul>
      {activeTags.length > 0 && (
        <a href={clearTagsHref} class="tags-clear" title="Clear all tag filters">Clear</a>
      )}
    </nav>
  )}

  {/*
    Primary navigation: Category. Each chip is a top-level slice of the
    catalog. The strip lives at the top of every Buckets page; Search +
    Sort below act on the selected category.
  */}
  <nav class="cats" aria-label="Category">
    <span class="cats-label">Browse</span>
    <ul class="cats-list" role="list">
      {CATEGORIES.map((c) => (
        <li>
          <a
            href={buildHref({ category: c.id })}
            class:list={["cat", { active: category === c.id || (!category && c.id === "all") }]}
            title={c.hint}
          >{c.label}</a>
        </li>
      ))}
    </ul>
    {/* Projects browse lives in Buckets now (no longer a top tab). The
        per-project Reveal/Open actions stay on the projects view. */}
    <a class="cat cat-projects" href="/portal/projects" title="Browse Ableton projects (reveal in Finder · open in Ableton)">⧉ Projects</a>
  </nav>

  {/*
    Duration filter. Preset chips for the common ranges + a manual min/max
    form for precise needs. The manual form is a native GET submit with
    hidden inputs preserving the other active filters, so it works without
    JS and produces a shareable URL. Empty inputs submit as "" → engine
    treats as unbounded.
  */}
  <details class="filters-adv">
    <summary class="filters-adv-summary"><span class="adv-caret" aria-hidden="true">▸</span> Length &amp; precise filters</summary>
  <nav class="dur-row" aria-label="Filter by duration">
    <span class="dur-label">Length</span>
    <ul class="dur-presets" role="list">
      {DURATION_PRESETS.map((p) => (
        <li>
          <a
            href={durationHref(p)}
            class:list={["dur-chip", { active: presetIsActive(p) }]}
            aria-pressed={presetIsActive(p) ? "true" : "false"}
            title={p.hint}
          >{p.label}</a>
        </li>
      ))}
    </ul>
    <form class="dur-form" method="get" action={base}>
      {sortExplicit && <input type="hidden" name="sort" value={sort} />}
      {category !== "all" && <input type="hidden" name="category" value={category} />}
      {q && <input type="hidden" name="q" value={q} />}
      {tagsCsv && <input type="hidden" name="tags" value={tagsCsv} />}
      <input
        type="number" class="dur-input" name="duration_min"
        min="0" step="1" placeholder="min s"
        value={durationMin ?? ""} aria-label="Minimum duration in seconds"
      />
      <span class="dur-sep" aria-hidden="true">–</span>
      <input
        type="number" class="dur-input" name="duration_max"
        min="0" step="1" placeholder="max s"
        value={durationMax ?? ""} aria-label="Maximum duration in seconds"
      />
      <button type="submit" class="dur-apply">Apply</button>
    </form>
    {durationActive && (
      <a href={clearDurationHref} class="dur-clear" title="Clear duration filter">Clear</a>
    )}
  </nav>
  </details>

  {/*
    Search + Random sit visually nested inside the Category context:
    a thin shared border + inset padding makes it clear you're searching
    *within* the active category.
  */}
  <div class="searchbar" data-active-cat={category}>
    <span class="searchbar-context">
      <span class="ctx-arrow" aria-hidden="true">↳</span>
      <span class="ctx-label">in</span>
      <span class="ctx-name">{activeCategory.label}</span>
    </span>
    <input
      type="search"
      class="search-input"
      placeholder={`Search ${activeCategory.label.toLowerCase()}…`}
      value={q}
      data-search-input
      aria-label={`Search ${activeCategory.label}`}
      autocomplete="off"
    />
    <button
      type="button"
      class="random-btn"
      data-action="random"
      title="Pick a random card in the current view"
    >↻ Random</button>
  </div>

  <div class="sort-row">
    <span class="sort-label">Sort</span>
    <ul class="sort-list" role="list">
      {SORT_DIMS.map((dim) => {
        const state = sortStateFor(dim, sort, sortExplicit);
        const next = nextSort(dim, state);
        const href = buildHref({ sort: next });
        const arrow = state === "asc" ? "↑" : state === "desc" ? "↓" : "";
        const titleNext = state === "off"
          ? `Sort by ${dim.label}, ${dim.asc ? "ascending" : "descending"}`
          : state === "asc"
            ? (dim.desc ? `Sort by ${dim.label}, descending` : `Clear ${dim.label} sort`)
            : `Clear ${dim.label} sort`;
        return (
          <li>
            <a
              href={href}
              class:list={["sort-toggle", { active: state !== "off" }]}
              data-state={state}
              aria-pressed={state !== "off" ? "true" : "false"}
              title={titleNext}
            >
              <span class="sort-toggle-label">{dim.label}</span>
              {arrow && <span class="sort-toggle-arrow" aria-hidden="true">{arrow}</span>}
            </a>
          </li>
        );
      })}
    </ul>
    {/* Archive link sits at the trailing edge of the sort row. Clicking
        opens the Trash bucket where archived items can be restored by
        re-assigning them to any J/L/F/T category. */}
    <a
      class:list={["archive-link", { active: bucket === "trash" }]}
      href={bucket === "trash" ? "/portal/buckets/all" : "/portal/buckets/trash"}
      title={bucket === "trash" ? "Back to All" : "Browse archived items"}
    >{bucket === "trash" ? "← Back to All" : "Archive →"}</a>
  </div>
</section>

<style>
  .filters {
    display: grid;
    gap: 0;
  }

  /* Archive link — quiet trailing chip in the sort row that opens the
     Trash bucket. When already in Trash, it flips to "Back to All" so
     you can navigate out without using the URL bar. */
  .archive-link {
    margin-left: auto;
    font-family: "Geist Variable", ui-sans-serif, system-ui, sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: rgba(245, 241, 232, 0.55);
    border: 1px dashed rgba(245, 241, 232, 0.20);
    border-radius: 3px;
    padding: 5px 10px;
    transition: color 160ms ease, border-color 160ms ease, background 160ms ease;
  }
  .archive-link:hover,
  .archive-link:focus-visible {
    color: #ff2761;
    border-color: rgba(255, 39, 97, 0.55);
    outline: none;
  }
  .archive-link.active {
    color: #ff2761;
    border-color: rgba(255, 39, 97, 0.55);
    border-style: solid;
    background: rgba(255, 39, 97, 0.06);
  }

  /* ── Tags chip strip (sits above Category) ────────────────────────── */
  .tags-strip {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: 8px 14px;
    background: color-mix(in srgb, var(--ink) 4%, transparent);
    border: 1px solid var(--line);
    border-bottom: none;
    flex-wrap: wrap;
  }
  .tags-label {
    font-size: 10px;
    font-weight: var(--fw-semibold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    flex: 0 0 auto;
  }
  .tags-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    flex: 1;
  }
  .tag-chip {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    font-size: 12px;
    font-weight: var(--fw-semibold);
    letter-spacing: 0.04em;
    color: var(--text);
    border: 1px solid var(--line);
    padding: 5px 10px;
    text-decoration: none;
    transition: color 160ms ease, border-color 160ms ease,
                background-color 160ms ease;
  }
  .tag-chip:hover,
  .tag-chip:focus-visible {
    color: var(--accent);
    border-color: var(--accent);
    outline: none;
  }
  .tag-chip.active {
    color: var(--bg);
    background: var(--accent);
    border-color: var(--accent);
  }
  .tag-chip .tag-name {
    text-transform: lowercase;
  }
  .tag-chip .tag-count {
    font-size: 10px;
    font-weight: var(--fw-regular);
    color: var(--muted);
    letter-spacing: 0;
  }
  .tag-chip.active .tag-count {
    color: color-mix(in srgb, var(--bg) 70%, transparent);
  }
  .tags-clear {
    margin-left: auto;
    font-family: "Geist Variable", ui-sans-serif, system-ui, sans-serif;
    font-size: 11px;
    font-weight: var(--fw-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: rgba(245, 241, 232, 0.55);
    border: 1px dashed rgba(245, 241, 232, 0.20);
    padding: 5px 10px;
    transition: color 160ms ease, border-color 160ms ease;
  }
  .tags-clear:hover,
  .tags-clear:focus-visible {
    color: #ff2761;
    border-color: rgba(255, 39, 97, 0.55);
    outline: none;
  }

  /* ── Category strip (primary nav) ─────────────────────────────────── */
  .cats {
    display: flex;
    align-items: stretch;
    gap: 0;
    flex-wrap: wrap;
    background: color-mix(in srgb, var(--ink) 4%, transparent);
    border: 1px solid var(--line);
    border-bottom: none;
    padding: 4px;
  }
  .cat-projects {
    margin-left: auto;
    align-self: center;
    border: 1px dashed var(--line);
    opacity: 0.82;
  }
  .cat-projects:hover { opacity: 1; }
  .cats-label {
    padding: 12px 14px;
    font-size: 10px;
    font-weight: var(--fw-semibold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    align-self: center;
    border-right: 1px solid var(--line);
    margin-right: 4px;
  }
  .cats-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex: 1;
    flex-wrap: wrap;
    gap: 4px;
  }
  .cats-list li { flex: 1; min-width: 0; }
  .cat {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    height: 100%;
    min-height: 42px;
    padding: 12px 18px;
    font-size: 14px;
    font-weight: var(--fw-semibold);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text);
    background: transparent;
    border: 1.5px solid var(--line);
    text-decoration: none;
    transition: color 160ms ease, border-color 160ms ease,
                background-color 160ms ease, transform 80ms ease;
  }
  .cat:hover,
  .cat:focus-visible {
    color: var(--accent);
    border-color: var(--accent);
  }
  .cat:active { transform: translateY(1px); }
  .cat.active {
    color: var(--bg);
    background: var(--accent);
    border-color: var(--accent);
  }

  /* ── Duration filter row ──────────────────────────────────────────── */
  /* Length + precise filters are tucked into a collapsed disclosure so the
     default filter view stays clean (search · categories · sort). */
  .filters-adv { padding-top: 2px; }
  .filters-adv-summary {
    list-style: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 4px;
    font: 600 11px ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(245, 241, 232, 0.5);
    user-select: none;
  }
  .filters-adv-summary::-webkit-details-marker { display: none; }
  .filters-adv-summary:hover { color: var(--ink); }
  .adv-caret { display: inline-block; font-size: 10px; transition: transform 140ms ease; }
  .filters-adv[open] .adv-caret { transform: rotate(90deg); }
  .dur-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    padding: 8px 0;
  }
  .dur-label {
    padding: 0 14px 0 0;
    font-size: 10px;
    font-weight: var(--fw-semibold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    border-right: 1px solid var(--line);
    margin-right: 4px;
  }
  .dur-presets {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    gap: 4px;
    flex-wrap: wrap;
  }
  .dur-chip {
    display: inline-flex;
    align-items: center;
    padding: 6px 12px;
    font-size: 12px;
    font-family: var(--font-mono, monospace);
    color: var(--text);
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 7px;
    text-decoration: none;
    transition: color 140ms ease, border-color 140ms ease, background-color 140ms ease;
  }
  .dur-chip:hover,
  .dur-chip:focus-visible {
    color: var(--accent);
    border-color: var(--accent);
  }
  .dur-chip.active {
    color: var(--bg);
    background: var(--accent);
    border-color: var(--accent);
  }
  .dur-form {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-left: 4px;
  }
  .dur-input {
    width: 72px;
    padding: 6px 8px;
    font-size: 12px;
    font-family: var(--font-mono, monospace);
    color: var(--text);
    background: color-mix(in srgb, var(--ink) 4%, transparent);
    border: 1px solid var(--line);
    border-radius: 7px;
  }
  .dur-input:focus-visible {
    outline: none;
    border-color: var(--accent);
  }
  .dur-sep { color: var(--muted); }
  .dur-apply {
    padding: 6px 12px;
    font-size: 12px;
    font-weight: var(--fw-semibold);
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 6%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 32%, transparent);
    border-radius: 7px;
    cursor: pointer;
    transition: background-color 140ms ease, border-color 140ms ease;
  }
  .dur-apply:hover {
    background: color-mix(in srgb, var(--accent) 14%, transparent);
    border-color: var(--accent);
  }
  .dur-clear {
    font-size: 11px;
    color: var(--muted);
    text-decoration: underline;
    text-underline-offset: 2px;
    margin-left: 2px;
  }
  .dur-clear:hover { color: var(--accent); }

  /* ── Search bar (scoped to selected category) ─────────────────────── */
  .searchbar {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: 10px 14px;
    background: color-mix(in srgb, var(--ink) 4%, transparent);
    border: 1px solid var(--line);
    border-top: 1px dashed var(--line);
    flex-wrap: wrap;
  }
  .searchbar-context {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    color: var(--muted);
    font-size: 12px;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: 0;
    flex: 0 0 auto;
  }
  .ctx-arrow { color: var(--accent); font-weight: var(--fw-semibold); }
  .ctx-name {
    color: var(--text);
    font-weight: var(--fw-semibold);
