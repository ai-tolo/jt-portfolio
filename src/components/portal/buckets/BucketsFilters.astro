---
import type {
  BucketName,
  BucketCategory,
  BucketSort,
} from "../../../lib/console-types";

interface Props {
  bucket: BucketName;
  category: BucketCategory;
  sort: BucketSort;
  q: string;
}

const { bucket, category, sort, q } = Astro.props;

const CATEGORIES: { id: BucketCategory; label: string; hint: string }[] = [
  { id: "all", label: "All", hint: "Everything in this bucket" },
  { id: "jam", label: "Jam", hint: "Long-form (>5min) musical captures" },
  { id: "loops", label: "Loops", hint: "Short (<60s) clips and one-shots" },
  { id: "field", label: "Field", hint: "Voice memos + audio extracted from videos" },
  { id: "tracks", label: "Tracks", hint: "Medium-length musical ideas + .als projects" },
  { id: "other", label: "Other", hint: "Doesn't fit the other categories" },
];

const SORTS: { id: BucketSort; label: string }[] = [
  { id: "recent", label: "Recent" },
  { id: "oldest", label: "Oldest" },
  { id: "longest", label: "Longest" },
  { id: "shortest", label: "Shortest" },
  { id: "most-used", label: "Most-used" },
  { id: "stars", label: "Most-starred" },
];

const base = `/portal/buckets/${bucket}`;
const buildHref = (overrides: Record<string, string | null>): string => {
  const p = new URLSearchParams();
  if (sort !== "recent") p.set("sort", sort);
  if (category && category !== "all") p.set("category", category);
  if (q) p.set("q", q);
  for (const [k, v] of Object.entries(overrides)) {
    if (v === null) p.delete(k);
    else p.set(k, v);
  }
  if (p.get("sort") === "recent") p.delete("sort");
  if (p.get("category") === "all") p.delete("category");
  const qs = p.toString();
  return qs ? `${base}?${qs}` : base;
};
---

<div class="filters" aria-label="Bucket filters">
  <div class="group group-search">
    <input
      type="search"
      class="search-input"
      placeholder="Search title, tags, path…"
      value={q}
      data-search-input
      aria-label="Search this bucket"
      autocomplete="off"
    />
    <button
      type="button"
      class="random-btn"
      data-action="random"
      title="Pick a random card in the current view"
    >↻ Random</button>
  </div>

  <div class="group">
    <span class="label">Category</span>
    <ul class="chips" role="list">
      {CATEGORIES.map((c) => (
        <li>
          <a
            href={buildHref({ category: c.id })}
            class:list={["chip", { active: category === c.id || (!category && c.id === "all") }]}
            title={c.hint}
          >{c.label}</a>
        </li>
      ))}
    </ul>
  </div>

  <div class="group">
    <span class="label">Sort</span>
    <ul class="chips" role="list">
      {SORTS.map((s) => (
        <li>
          <a
            href={buildHref({ sort: s.id })}
            class:list={["chip", { active: sort === s.id }]}
          >{s.label}</a>
        </li>
      ))}
    </ul>
  </div>
</div>

<style>
  .filters {
    display: grid;
    gap: var(--space-3);
  }
  .group {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  .group-search {
    gap: var(--space-2);
  }
  .label {
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--muted);
    min-width: 4rem;
  }
  .search-input {
    flex: 1;
    min-width: 16rem;
    max-width: 40rem;
    font: inherit;
    font-size: 14px;
    color: var(--text);
    background: var(--surface-1);
    border: 1px solid var(--line);
    padding: 8px 12px;
    transition: border-color 160ms ease;
  }
  .search-input:focus {
    outline: none;
    border-color: var(--accent);
  }
  .search-input::-webkit-search-cancel-button {
    cursor: pointer;
  }
  .random-btn {
    font: inherit;
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--bg);
    background: var(--accent);
    border: 1px solid var(--accent);
    padding: 8px 14px;
    cursor: pointer;
    transition: background-color 160ms ease, color 160ms ease;
  }
  .random-btn:hover,
  .random-btn:focus-visible {
    background: var(--ink);
    color: var(--ink-fg);
    border-color: var(--ink);
    outline: none;
  }
  .chips {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .chip {
    display: inline-block;
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--muted);
    border: 1px solid var(--line);
    padding: 5px 9px;
    text-decoration: none;
    transition: color 160ms ease, border-color 160ms ease;
  }
  .chip:hover { color: var(--text); border-color: var(--text); }
  .chip.active {
    color: var(--bg);
    background: var(--accent);
    border-color: var(--accent);
  }
</style>
