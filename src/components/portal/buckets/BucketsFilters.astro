---
import type {
  BucketView,
  BucketCategory,
  BucketSort,
  TopTag,
} from "../../../lib/console-types";

interface Props {
  bucket: BucketView;
  category: BucketCategory;
  sort: BucketSort;
  sortExplicit: boolean;
  q: string;
  activeTags: string[];
  topTags: TopTag[];
  durationMin?: number;
  durationMax?: number;
  bpmMin?: number;
  bpmMax?: number;
  keyFilter?: string;
  qualityMin?: number;
  hasProject?: boolean;
  /** Untriaged-queue depth, for the Inbox badge. */
  inboxCount?: number;
}

const {
  bucket, category, sort, sortExplicit, q, activeTags, topTags,
  durationMin, durationMax, bpmMin, bpmMax, keyFilter = "", qualityMin, hasProject = false,
  inboxCount = 0,
} = Astro.props;

const activeSet = new Set(activeTags);

// Content categories carry an icon so they pop + scan fast. The old "Inbox"
// (residual) pill is gone — Inbox is now the untriaged QUEUE (its own icon +
// count, below), not a content slice.
const CATEGORIES: { id: BucketCategory; label: string; icon: string }[] = [
  { id: "all", label: "All", icon: "✦" },
  { id: "jam", label: "Jam", icon: "🎹" },
  { id: "loops", label: "Loops", icon: "🔁" },
  { id: "oneshot", label: "One-shot", icon: "⚡" },
  { id: "field", label: "Field", icon: "🎤" },
  { id: "tracks", label: "Tracks", icon: "🎵" },
];
const activeCategory = CATEGORIES.find((c) => c.id === category) ?? CATEGORIES[0];

// One labeled control replaces the five 3-state sort toggles.
const SORT_OPTIONS: { key: BucketSort; label: string }[] = [
  { key: "recent", label: "Newest" },
  { key: "oldest", label: "Oldest" },
  { key: "longest", label: "Longest" },
  { key: "shortest", label: "Shortest" },
  { key: "bpm-desc", label: "BPM high → low" },
  { key: "bpm-asc", label: "BPM low → high" },
  { key: "most-used", label: "Most used in projects" },
  { key: "least-used", label: "Least used" },
  { key: "silence-desc", label: "Most silent" },
];
const currentSort = sortExplicit ? sort : "recent";

const NOTES = ["C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B"];
const KEYS: string[] = NOTES.flatMap((n) => [`${n} major`, `${n} minor`]);

type DurationPreset = { label: string; min: number | null; max: number | null };
const DURATION_PRESETS: DurationPreset[] = [
  { label: "Songs 45s–5m", min: 45, max: 300 },
  { label: "Loops <45s", min: null, max: 45 },
  { label: "Long >5m", min: 300, max: null },
];
const presetIsActive = (p: DurationPreset): boolean =>
  (p.min ?? undefined) === durationMin && (p.max ?? undefined) === durationMax;

const base = `/portal/buckets/${bucket}`;
const tagsCsv = activeTags.join(",");

// Every active filter as [name, value]. The single source of truth for
// link-building and for the hidden inputs that keep GET forms from dropping
// the other facets.
const activeParams = (): [string, string][] => {
  const out: [string, string][] = [];
  if (sortExplicit) out.push(["sort", sort]);
  if (category && category !== "all") out.push(["category", category]);
  if (q) out.push(["q", q]);
  if (tagsCsv) out.push(["tags", tagsCsv]);
  if (durationMin !== undefined) out.push(["duration_min", String(durationMin)]);
  if (durationMax !== undefined) out.push(["duration_max", String(durationMax)]);
  if (bpmMin !== undefined) out.push(["bpm_min", String(bpmMin)]);
  if (bpmMax !== undefined) out.push(["bpm_max", String(bpmMax)]);
  if (keyFilter) out.push(["key", keyFilter]);
  if (qualityMin !== undefined) out.push(["quality_min", String(qualityMin)]);
  if (hasProject) out.push(["has_project", "1"]);
  return out;
};
const preserveExcept = (...keys: string[]): [string, string][] =>
  activeParams().filter(([k]) => !keys.includes(k));

const buildHref = (overrides: Record<string, string | null>): string => {
  const p = new URLSearchParams(activeParams());
  for (const [k, v] of Object.entries(overrides)) {
    if (v === null || v === "") p.delete(k);
    else p.set(k, v);
  }
  if (p.get("category") === "all") p.delete("category");
  p.delete("offset"); // any filter change resets to page 1
  const qs = p.toString();
  return qs ? `${base}?${qs}` : base;
};

const durationHref = (p: DurationPreset): string =>
  presetIsActive(p)
    ? buildHref({ duration_min: null, duration_max: null })
    : buildHref({
        duration_min: p.min === null ? null : String(p.min),
        duration_max: p.max === null ? null : String(p.max),
      });

const buildTagsHref = (tag: string): string => {
  const next = activeSet.has(tag)
    ? activeTags.filter((t) => t !== tag)
    : [...activeTags, tag];
  return buildHref({ tags: next.join(",") });
};

// Active-filter summary chips — each removes its own facet; clear-all wipes them.
const chips: { label: string; href: string }[] = [];
if (category && category !== "all")
  chips.push({ label: activeCategory.label, href: buildHref({ category: null }) });
if (q) chips.push({ label: `“${q}”`, href: buildHref({ q: null }) });
for (const t of activeTags) chips.push({ label: `#${t}`, href: buildTagsHref(t) });
if (durationMin !== undefined || durationMax !== undefined)
  chips.push({
    label: `${durationMin ?? 0}–${durationMax ?? "∞"}s`,
    href: buildHref({ duration_min: null, duration_max: null }),
  });
if (bpmMin !== undefined || bpmMax !== undefined)
  chips.push({
    label: `${bpmMin ?? 0}–${bpmMax ?? "∞"} BPM`,
    href: buildHref({ bpm_min: null, bpm_max: null }),
  });
if (keyFilter) chips.push({ label: keyFilter, href: buildHref({ key: null }) });
if (qualityMin !== undefined)
  chips.push({ label: `★ ${qualityMin}+`, href: buildHref({ quality_min: null }) });
if (hasProject) chips.push({ label: "has project", href: buildHref({ has_project: null }) });

const facetCount =
  (durationMin !== undefined || durationMax !== undefined ? 1 : 0) +
  (bpmMin !== undefined || bpmMax !== undefined ? 1 : 0) +
  (keyFilter ? 1 : 0) +
  (qualityMin !== undefined ? 1 : 0) +
  (hasProject ? 1 : 0) +
  activeTags.length;
const facetsOpen = facetCount > 0;
---

<section class="filters" aria-label="Bucket filters">
  {/* ── Primary bar: search · sort · random ───────────────────────── */}
  <div class="bar">
    <form class="search" method="get" action={base} role="search">
      {preserveExcept("q").map(([k, v]) => <input type="hidden" name={k} value={v} />)}
      <span class="search-icon" aria-hidden="true">⌕</span>
      <input
        type="search"
        name="q"
        class="search-input"
        value={q}
        placeholder={`Search ${activeCategory.label.toLowerCase()}…`}
        aria-label="Search"
        autocomplete="off"
        data-search-input
      />
    </form>
    <label class="sort">
      <span class="sort-label">Sort</span>
      <select class="sort-select" data-nav-param="sort" data-default="recent" aria-label="Sort">
        {SORT_OPTIONS.map((o) => (
          <option value={o.key} selected={o.key === currentSort}>{o.label}</option>
        ))}
      </select>
    </label>
    <button type="button" class="random-btn" data-action="random" title="Jump to a random card in this view">↻ Random</button>
  </div>

  {/* ── Category pills + Projects browse ──────────────────────────── */}
  <nav class="cats" aria-label="Category">
    {CATEGORIES.map((c) => (
      <a
        href={buildHref({ category: c.id })}
        class:list={["cat", `cat-${c.id}`, { active: category === c.id || (!category && c.id === "all") }]}
      ><span class="cat-icon" aria-hidden="true">{c.icon}</span><span class="cat-text">{c.label}</span></a>
    ))}
    {/* Inbox = the untriaged QUEUE (new/unsorted rows live here, not in All).
        Loud only when there's something to sort. Its own route + icon + count. */}
    <a
      class:list={["inbox-tab", { active: bucket === "inbox", empty: !inboxCount }]}
      href="/portal/buckets/inbox"
      title={inboxCount ? `Inbox — ${inboxCount.toLocaleString()} to sort` : "Inbox — nothing to sort"}
      aria-label={inboxCount ? `Inbox, ${inboxCount} to sort` : "Inbox, empty"}
    >
      <span class="inbox-icon" aria-hidden="true">📥</span>
      {inboxCount > 0 && <span class="inbox-badge">{inboxCount > 999 ? "999+" : inboxCount.toLocaleString()}</span>}
    </a>
    <a class="cat cat-projects" href="/portal/projects" title="Browse Ableton projects (reveal in Finder · open in Ableton)">⧉ Projects</a>
    <a
      class:list={["cat cat-archive", { active: bucket === "trash" }]}
      href={bucket === "trash" ? "/portal/buckets/all" : "/portal/buckets/trash"}
      title={bucket === "trash" ? "Back to All" : "Browse archived / trashed items"}
    >{bucket === "trash" ? "← Back" : "Archive"}</a>
  </nav>

  {/* ── Active-filter summary ─────────────────────────────────────── */}
  {chips.length > 0 && (
    <div class="active" aria-label="Active filters">
      <span class="active-label">Filtering</span>
      <ul class="active-list" role="list">
        {chips.map((c) => (
          <li><a class="active-chip" href={c.href} title={`Remove ${c.label}`}>{c.label} <span class="x" aria-hidden="true">×</span></a></li>
        ))}
      </ul>
      <a class="active-clear" href={base} title="Clear all filters">Clear all</a>
    </div>
  )}

  {/* ── Facet panel (auto-opens when a facet is active) ───────────── */}
  <details class="facets" open={facetsOpen}>
    <summary class="facets-summary">
      <span class="facets-caret" aria-hidden="true">▸</span>
      Filters{facetCount > 0 ? ` · ${facetCount}` : ""}
    </summary>
    <div class="facets-grid">
      {/* BPM range */}
      <form class="facet" method="get" action={base}>
        {preserveExcept("bpm_min", "bpm_max").map(([k, v]) => <input type="hidden" name={k} value={v} />)}
        <span class="facet-label">BPM</span>
        <span class="range">
          <input type="number" name="bpm_min" min="0" step="1" placeholder="min" value={bpmMin ?? ""} aria-label="Min BPM" />
          <span class="range-sep">–</span>
          <input type="number" name="bpm_max" min="0" step="1" placeholder="max" value={bpmMax ?? ""} aria-label="Max BPM" />
        </span>
        <button type="submit" class="facet-apply" aria-label="Apply range">→</button>
      </form>

      {/* Key */}
      <label class="facet">
        <span class="facet-label">Key</span>
        <select class="key-select" data-nav-param="key" data-default="" aria-label="Musical key">
          <option value="" selected={!keyFilter}>Any key</option>
          {KEYS.map((k) => (
            <option value={k} selected={k.toLowerCase() === keyFilter.toLowerCase()}>{k}</option>
          ))}
        </select>
      </label>

      {/* Length presets + range */}
      <form class="facet facet-wide" method="get" action={base}>
        {preserveExcept("duration_min", "duration_max").map(([k, v]) => <input type="hidden" name={k} value={v} />)}
        <span class="facet-label">Length</span>
        <span class="presets">
          {DURATION_PRESETS.map((p) => (
            <a href={durationHref(p)} class:list={["preset", { active: presetIsActive(p) }]} aria-pressed={presetIsActive(p) ? "true" : "false"}>{p.label}</a>
          ))}
        </span>
        <span class="range">
          <input type="number" name="duration_min" min="0" step="1" placeholder="min s" value={durationMin ?? ""} aria-label="Min seconds" />
          <span class="range-sep">–</span>
          <input type="number" name="duration_max" min="0" step="1" placeholder="max s" value={durationMax ?? ""} aria-label="Max seconds" />
        </span>
        <button type="submit" class="facet-apply" aria-label="Apply range">→</button>
      </form>

      {/* Quality */}
      <div class="facet">
        <span class="facet-label">Quality</span>
        <span class="quality">
          {[
            { v: null as number | null, label: "Any" },
            { v: 1, label: "★ 1+" },
            { v: 2, label: "★ 2+" },
            { v: 3, label: "★ 3" },
          ].map((opt) => (
            <a
              href={buildHref({ quality_min: opt.v === null ? null : String(opt.v) })}
              class:list={["q-chip", { active: (qualityMin ?? null) === opt.v }]}
            >{opt.label}</a>
          ))}
        </span>
      </div>

      {/* Has project */}
      <div class="facet">
        <span class="facet-label">Project</span>
        <a
          href={buildHref({ has_project: hasProject ? null : "1" })}
          class:list={["toggle-chip", { active: hasProject }]}
          aria-pressed={hasProject ? "true" : "false"}
          title="Only tracks linked to a source .als project"
        >⧉ Has linked project</a>
      </div>

      {/* Tags */}
      {(topTags.length > 0 || activeTags.length > 0) && (
        <div class="facet facet-wide">
          <span class="facet-label">Tags</span>
          <span class="tags">
            {topTags.map((t) => (
              <a href={buildTagsHref(t.tag)} class:list={["tag-chip", { active: activeSet.has(t.tag) }]} aria-pressed={activeSet.has(t.tag) ? "true" : "false"}>
                <span class="tag-name">{t.tag}</span><span class="tag-count">{t.count.toLocaleString()}</span>
              </a>
            ))}
            {activeTags.filter((t) => !topTags.some((tt) => tt.tag === t)).map((t) => (
              <a href={buildTagsHref(t)} class="tag-chip active" aria-pressed="true"><span class="tag-name">{t}</span></a>
            ))}
          </span>
        </div>
      )}
    </div>
  </details>
</section>

<script>
  // Selects (sort, key) navigate on change, preserving every other filter and
  // resetting pagination. `data-default` is the value that means "no param".
  document.querySelectorAll<HTMLSelectElement>("select[data-nav-param]").forEach((el) => {
    el.addEventListener("change", () => {
      const url = new URL(window.location.href);
      const param = el.dataset.navParam!;
      const def = el.dataset.default ?? "";
      if (el.value && el.value !== def) url.searchParams.set(param, el.value);
      else url.searchParams.delete(param);
      url.searchParams.delete("offset");
      window.location.href = url.toString();
    });
  });
</script>

<style>
  .filters {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 18px;
  }

  /* ── Primary bar ── */
  .bar {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  .search {
    flex: 1 1 280px;
    display: flex;
    align-items: center;
    gap: 8px;
    background: color-mix(in srgb, var(--ink) 5%, transparent);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 0 12px;
    transition: border-color 140ms ease, box-shadow 140ms ease;
  }
  .search:focus-within {
    border-color: color-mix(in srgb, var(--accent-2) 55%, transparent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent-2) 14%, transparent);
  }
  .search-icon { opacity: 0.5; font-size: 16px; }
  .search-input {
    flex: 1;
    min-width: 0;
    background: transparent;
    border: none;
    outline: none;
    color: var(--ink);
    font: 500 14px/1 "Geist Variable", ui-sans-serif, system-ui, sans-serif;
    padding: 12px 2px;
  }
  .search-input::placeholder { color: color-mix(in srgb, var(--ink) 40%, transparent); }

  .sort {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
  }
  .sort-label {
    font: 600 10.5px ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.6;
  }
  .sort-select {
    font: 500 13px "Geist Variable", ui-sans-serif, system-ui, sans-serif;
    color: var(--ink);
    background: color-mix(in srgb, var(--ink) 5%, transparent);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 9px 10px;
    cursor: pointer;
  }
  .random-btn {
    flex-shrink: 0;
    font: 600 12px "Geist Variable", ui-sans-serif, system-ui, sans-serif;
    color: var(--ink);
    background: color-mix(in srgb, var(--ink) 5%, transparent);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 10px 14px;
    cursor: pointer;
  }

  /* ── Category pills ── */
  .cats { display: flex; flex-wrap: wrap; gap: 4px; align-items: center; }
  .cat {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font: 650 13px "Geist Variable", ui-sans-serif, system-ui, sans-serif;
    color: color-mix(in srgb, var(--ink) 62%, transparent);
    background: color-mix(in srgb, var(--ink) 4%, transparent);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 7px 13px;
    text-decoration: none;
    transition: color 140ms ease, background 140ms ease, border-color 140ms ease, transform 80ms ease;
  }
  .cat-icon { font-size: 13px; line-height: 1; }
  .cat:hover { color: var(--ink); border-color: color-mix(in srgb, var(--ink) 28%, transparent); transform: translateY(-1px); }
  /* .cat.active picks up the brand gradient from PortalLayout's global rule. */

  /* Inbox = the untriaged QUEUE, set apart from content categories. Dim when
     empty; lights amber + shows a count badge when there's something to sort.
     Heads the right cluster (inbox · projects · archive). */
  .inbox-tab {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 11px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--ink) 4%, transparent);
    text-decoration: none;
    transition: border-color 140ms ease, background 140ms ease, transform 80ms ease;
  }
  .inbox-icon { font-size: 15px; line-height: 1; }
  .inbox-tab.empty { opacity: 0.4; }
  .inbox-tab:not(.empty) {
    border-color: color-mix(in srgb, #ff6e21 48%, transparent);
    background: color-mix(in srgb, #ff6e21 11%, transparent);
  }
  .inbox-tab:hover { transform: translateY(-1px); }
  .inbox-tab.active { box-shadow: 0 0 0 1px color-mix(in srgb, #ff6e21 60%, transparent); }
  .inbox-badge {
    font: 800 11px ui-monospace, SFMono-Regular, Menlo, monospace;
    color: #fff;
    background: linear-gradient(135deg, #ff3b6e, #ff6e21);
    border-radius: 999px;
    padding: 1px 7px;
    line-height: 1.5;
  }
  .cat-projects, .cat-archive { opacity: 0.85; }

  /* ── Active-filter summary ── */
  .active {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    padding: 8px 12px;
    background: color-mix(in srgb, var(--accent-2) 6%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent-2) 22%, transparent);
    border-radius: 10px;
  }
  .active-label {
    font: 600 10px ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.65;
  }
  .active-list { display: flex; flex-wrap: wrap; gap: 6px; list-style: none; margin: 0; padding: 0; }
  .active-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font: 600 12px "Geist Variable", ui-sans-serif, system-ui, sans-serif;
    color: var(--ink);
    background: color-mix(in srgb, var(--ink) 8%, transparent);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 4px 10px;
    text-decoration: none;
  }
  .active-chip .x { opacity: 0.55; font-size: 14px; }
  .active-chip:hover { border-color: color-mix(in srgb, var(--accent) 50%, transparent); }
  .active-chip:hover .x { opacity: 1; color: var(--accent); }
  .active-clear {
    margin-left: auto;
    font: 600 11px ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: 0.04em;
    color: color-mix(in srgb, var(--accent) 90%, white);
    text-decoration: none;
  }
  .active-clear:hover { text-decoration: underline; }

  /* ── Facet panel ── */
  .facets {
    border: 1px solid var(--line);
    border-radius: 10px;
    background: color-mix(in srgb, var(--ink) 3%, transparent);
  }
  .facets-summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 11px 14px;
    font: 600 11px ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--ink) 60%, transparent);
    user-select: none;
  }
  .facets-summary::-webkit-details-marker { display: none; }
  .facets-summary:hover { color: var(--ink); }
  .facets-caret { transition: transform 140ms ease; }
  .facets[open] .facets-caret { transform: rotate(90deg); }
  /* One facet per row, label column fixed-width so every control lines up on a
     single left edge — a clear top-to-bottom hierarchy instead of a scattered
     auto-fit grid. Rows separated by a hairline. */
  .facets-grid {
    display: flex;
    flex-direction: column;
    padding: 4px 16px 14px;
  }
  .facet {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 10px;
    padding: 11px 0;
    border-top: 1px solid color-mix(in srgb, var(--ink) 7%, transparent);
  }
  .facet:first-child { border-top: 0; }
  .facet-wide { display: flex; }
  .facet-label {
    flex: 0 0 76px;
    font: 600 10px ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.55;
  }
  .range { display: inline-flex; align-items: center; gap: 6px; }
  .range input, .key-select {
    background: color-mix(in srgb, var(--ink) 5%, transparent);
    border: 1px solid var(--line);
    border-radius: 7px;
    color: var(--ink);
    font: 500 13px "Geist Variable", ui-sans-serif, system-ui, sans-serif;
    padding: 7px 9px;
  }
  .range input { width: 68px; }
  .range-sep { opacity: 0.5; }
  /* Compact arrow submit, sized to the range inputs so it reads as part of the
     range control rather than a stray "Go" button. */
  .facet-apply {
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    color: color-mix(in srgb, var(--ink) 70%, transparent);
    background: color-mix(in srgb, var(--accent-2) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent-2) 30%, transparent);
    border-radius: 7px;
    cursor: pointer;
