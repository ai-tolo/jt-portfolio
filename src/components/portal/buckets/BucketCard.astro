</style>

<script>
  // Expand / collapse the details section. The chevron rotates and the
  // expanded block reveals — handled per-card so it has no global state.
  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement | null;
    const btn = target?.closest<HTMLButtonElement>('[data-action="expand"]');
    if (!btn) return;
    const card = btn.closest<HTMLElement>(".bucket-card");
    if (!card) return;
    const panel = card.querySelector<HTMLElement>("[data-expanded]");
    if (!panel) return;
    const open = btn.getAttribute("aria-expanded") === "true";
    if (open) {
      btn.setAttribute("aria-expanded", "false");
      panel.hidden = true;
    } else {
      btn.setAttribute("aria-expanded", "true");
      panel.hidden = false;
    }
  });
</script>
