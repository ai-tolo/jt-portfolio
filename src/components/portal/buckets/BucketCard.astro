---
import type { BucketAsset, BucketName } from "../../../lib/console-types";

interface Props {
  item: BucketAsset;
  /** Index within the rendered grid — stable tab order for arrow nav. */
  index: number;
}

const { item, index } = Astro.props;

const basename = (p: string): string => p.split("/").pop() ?? p;
const filename = item.filename || basename(item.path);
const title = item.display_name || filename;
const isPublic = item.public === 1;

const fmtDuration = (s: number | null): string | null => {
  if (s == null || !Number.isFinite(s) || s <= 0) return null;
  const m = Math.floor(s / 60);
  const r = Math.round(s % 60);
  return `${m}:${String(r).padStart(2, "0")}`;
};
const durationLabel = fmtDuration(item.duration_seconds);

const tagList = (item.tags ?? "")
  .split(",")
  .map((t) => t.trim())
  .filter(Boolean)
  .slice(0, 6);

const BUCKET_LABEL: Record<BucketName, string> = {
  inbox: "Inbox",
  jam: "Jam",
  loops: "Loops",
  field: "Field",
  tracks: "Tracks",
  trash: "Trash",
};
const currentBucket: BucketName = item.bucket ?? "inbox";

// The four curator-assignable categories (Inbox is the unset default,
// Trash is the hold-button on the bottom-right corner — neither lives in
// the main category bar).
const CATEGORIES: { id: BucketName; label: string; kbd: string }[] = [
  { id: "jam", label: "Jam", kbd: "J" },
  { id: "loops", label: "Loops", kbd: "L" },
  { id: "field", label: "Field", kbd: "F" },
  { id: "tracks", label: "Tracks", kbd: "T" },
];

const lineageWord = (() => {
  if (!item.parent_id) return null;
  switch (item.source_type) {
    case "voice_memo": return "voice-memo";
    case "video_extract": return "video";
    case "jam": return "jam";
    default: return "asset";
  }
})();

const waveformSrc = (() => {
  const wp = item.waveform_path;
  if (!wp) return null;
  const base = wp.split("/").pop() ?? wp;
  const sha1 = base.replace(/\.png$/i, "");
  if (!/^[a-f0-9]{40}$/i.test(sha1)) return null;
  return `/api/console/waveform?sha1=${sha1}`;
})();
---

<article
  class="bucket-card"
  tabindex="0"
  data-bucket-card
  data-card-index={String(index)}
  data-asset-id={String(item.asset_id)}
  data-bucket={currentBucket}
  data-quality={String(item.quality_star)}
  data-parent-id={item.parent_id ? String(item.parent_id) : ""}
  data-path={item.path}
  data-filename={filename}
  data-live-loop-path={item.live_loop_path ?? ""}
  data-public={isPublic ? "1" : "0"}
  aria-label={`${title} — ${BUCKET_LABEL[currentBucket]}`}
>
  <header class="head">
    <h3 class="title">
      <button
        type="button"
        class="title-edit"
        data-action="rename"
        data-path={item.path}
        title={`Click to rename. Real filename: ${filename}`}
      >{title}</button>
    </h3>
    {item.dup_of && (
      <span class="flag-chip flag-dup" title={`Duplicate of asset_id ${item.dup_of}`}>DUP</span>
    )}
    {item.orphan_candidate === 1 && (
      <span class="flag-chip flag-orphan" title="Flagged as orphan — never used in projects, never auditioned, very short/long">ORPHAN</span>
    )}
    {durationLabel && <span class="duration" aria-label="Duration">{durationLabel}</span>}
  </header>

  <div
    class="waveform"
    data-seekable={waveformSrc ? "true" : "false"}
    title={waveformSrc ? "Click to play (click again to seek)" : undefined}
  >
    {waveformSrc ? (
      <img
        src={waveformSrc}
        alt=""
        loading="lazy"
        width="640"
        height="80"
        onerror="this.replaceWith(Object.assign(document.createElement('div'),{className:'waveform-placeholder',textContent:'no waveform yet'}))"
      />
    ) : (
      <div class="waveform-placeholder">no waveform yet</div>
    )}
    <div class="waveform-playhead" data-playhead hidden></div>
    <div class="waveform-time" data-waveform-time hidden></div>
  </div>

  {item.summary && <p class="summary">{item.summary}</p>}

  {(item.bpm || item.key) && (
    <p class="audio-meta">
      {item.bpm && <span>{Math.round(item.bpm)} BPM</span>}
      {item.key && <span>{item.key}</span>}
      {typeof item.project_count === "number" && item.project_count > 0 && (
        <span class="proj">in {item.project_count} {item.project_count === 1 ? "project" : "projects"}</span>
      )}
    </p>
  )}

  {currentBucket === "loops" && (
    <div class="promote-row" data-promote-row>
      {item.live_loop_path ? (
        <span class="promoted-badge" title={`In Live's browser: ${item.live_loop_path}`}>
          ✓ In Live
        </span>
      ) : (
        <button
          type="button"
          class="promote-btn"
          data-action="promote-to-live"
          data-asset-id={String(item.asset_id)}
          title="Copy + loudness-normalize to _Soundbending/loops/ for Live's browser"
        >→ Promote to Live</button>
      )}
    </div>
  )}

  <div class="category-bar" role="group" aria-label="Assign to category">
    {CATEGORIES.map((c) => (
      <button
        type="button"
        class:list={["category-btn", { active: currentBucket === c.id }]}
        data-action="bucket"
        data-bucket={c.id}
        title={`Assign to ${c.label} (${c.kbd} key)`}
      >
        <kbd>{c.kbd}</kbd>
        <span>{c.label}</span>
      </button>
    ))}
  </div>

  {lineageWord && (
    <button
      type="button"
      class="lineage-chip"
      data-action="lineage"
      data-asset-id={String(item.asset_id)}
      title="Click to fetch lineage"
    >
      from {lineageWord}:{item.parent_id}
    </button>
  )}
  <div class="lineage-detail" data-lineage-target hidden></div>

  {tagList.length > 0 && (
    <ul class="tags" role="list">
      {tagList.map((t) => <li>{t}</li>)}
    </ul>
  )}

  <p class="status" data-status-line aria-live="polite"></p>

  <footer class="bottom-row">
    <div class="quality" role="group" aria-label="Quality stars">
      {[1, 2, 3].map((n) => (
        <button
          type="button"
          class:list={["star", { on: item.quality_star >= n }]}
          data-action="quality-star"
          data-asset-id={String(item.asset_id)}
          data-star-value={String(n)}
          aria-label={`Set quality to ${n} star${n === 1 ? "" : "s"}`}
          title={`Set quality to ${n} (press ${n} when focused)`}
        >★</button>
      ))}
    </div>
    <button
      type="button"
      class:list={["pub-toggle", { on: isPublic }]}
      data-action="toggle-public"
      data-path={item.path}
      aria-pressed={isPublic ? "true" : "false"}
      title="Mark this item public on /sounds"
    >{isPublic ? "● Public" : "○ Public"}</button>
    <button
      type="button"
      class="trash-hold"
      data-action="trash-hold"
      title="Hold 2 seconds to trash"
      aria-label="Hold to trash"
    ><span class="hold-fill" aria-hidden="true"></span><span class="hold-glyph">✕</span></button>
  </footer>
</article>

<style>
  .bucket-card {
    position: relative;
    display: grid;
    gap: var(--space-3);
    padding: var(--space-4);
    padding-bottom: calc(var(--space-4) + 18px); /* breathing room for the abs-positioned ✕ */
    background: color-mix(in srgb, var(--ink) 6%, transparent);
    border: 1px solid var(--line);
    outline: none;
    transition: border-color 200ms ease, background-color 200ms ease,
                box-shadow 200ms ease;
  }
  .bucket-card:hover { border-color: var(--accent); }
  .bucket-card:focus-visible,
  .bucket-card[data-focused="true"] {
    border-color: var(--accent);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent) 35%, transparent);
  }
  .bucket-card[data-pending="true"] { opacity: 0.5; pointer-events: none; }

  /* Title row: editable title (left) + duration (right). The duration
     now occupies the slot the play button used to. */
  .head {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
  }
  .title {
    flex: 1;
    margin: 0;
    font-size: 1rem;
    font-weight: var(--fw-semibold);
    line-height: 1.3;
    word-break: break-word;
  }
  .title-edit {
    font: inherit;
    text-align: left;
    color: inherit;
    background: transparent;
    border: 1px dashed transparent;
    padding: 1px 4px;
    margin-left: -4px;
    cursor: text;
    width: 100%;
    transition: border-color 160ms ease, color 160ms ease;
  }
  .title-edit:hover,
  .title-edit:focus-visible {
    border-color: var(--line);
    outline: none;
  }
  .duration {
    flex: 0 0 auto;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 14px;
    font-weight: var(--fw-semibold);
    color: var(--text);
    letter-spacing: 0;
    font-feature-settings: "tnum";
  }
  .flag-chip {
    flex: 0 0 auto;
    font-size: 9px;
    font-weight: var(--fw-semibold);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 2px 6px;
    border: 1px solid currentColor;
    line-height: 1.4;
  }
  .flag-dup { color: var(--muted); }
  .flag-orphan { color: var(--accent); }

  .summary {
    margin: 0;
    font-size: var(--fs-small, 13px);
    color: var(--muted);
    line-height: 1.45;
  }

  /* Waveform — first click on a paused/inactive card = play from start;
     subsequent clicks while active = seek to the click x-fraction. The
     dedicated play button is gone; the image *is* the play surface. */
  .waveform {
    position: relative;
    height: 80px;
    background: var(--surface-1);
    border: 1px solid var(--line);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .waveform[data-seekable="true"] { cursor: pointer; }
  .waveform[data-seekable="true"]:hover {
    border-color: color-mix(in srgb, var(--accent) 50%, var(--line));
  }
  .waveform img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .waveform-placeholder {
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--muted);
  }
  .waveform-playhead {
    position: absolute;
    top: 0; bottom: 0;
    width: 2px;
    left: 0;
    background: var(--accent);
    pointer-events: none;
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--accent) 30%, transparent);
    z-index: 2;
  }
  .waveform-time {
    position: absolute;
    bottom: 4px;
    right: 6px;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 10px;
    font-feature-settings: "tnum";
    line-height: 1;
    color: var(--bg);
    background: color-mix(in srgb, var(--ink) 70%, transparent);
    padding: 3px 6px;
    pointer-events: none;
    z-index: 2;
    letter-spacing: 0;
  }

  .audio-meta {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    font-size: 15px;
    font-weight: var(--fw-semibold);
    color: var(--text);
    letter-spacing: 0;
    font-feature-settings: "tnum";
  }
  .audio-meta span:not(:last-child)::after {
    content: " ·";
    color: var(--muted);
    margin-left: var(--space-2);
    font-weight: 400;
  }
  .audio-meta .proj {
    color: var(--muted);
    font-size: 13px;
    font-weight: var(--fw-medium);
  }

  /* Category bar: 4 equal-width buttons that fill the card width.
     The primary curator action surface — visually heavier than other
     card chrome to communicate that. */
  .category-bar {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 6px;
    width: 100%;
  }
  .category-btn {
    width: 100%;
    min-height: 38px;
    font: inherit;
    font-size: 12px;
    font-weight: var(--fw-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text);
    background: transparent;
    border: 1.5px solid var(--line);
    padding: 8px 6px;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    line-height: 1;
    transition: color 160ms ease, border-color 160ms ease,
                background-color 160ms ease, transform 80ms ease;
  }
  .category-btn:hover,
  .category-btn:focus-visible {
    border-color: var(--accent);
    color: var(--accent);
    outline: none;
  }
  .category-btn:active {
    transform: translateY(1px);
  }
  .category-btn.active {
    color: var(--bg);
    background: var(--accent);
    border-color: var(--accent);
  }
  .category-btn kbd {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 9px;
    font-weight: var(--fw-semibold);
    line-height: 1;
    padding: 2px 5px;
    border: 1px solid currentColor;
    opacity: 0.55;
  }
  .category-btn.active kbd { opacity: 0.85; }

  .promote-row { display: flex; align-items: center; gap: var(--space-2); }
  .promote-btn {
    font: inherit;
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--bg);
    background: var(--accent);
    border: 1px solid var(--accent);
    padding: 6px 10px;
    cursor: pointer;
    transition: background-color 160ms ease, color 160ms ease;
  }
  .promote-btn:hover,
  .promote-btn:focus-visible {
    background: var(--ink);
    color: var(--ink-fg);
    border-color: var(--ink);
    outline: none;
  }
  .promote-btn[disabled] { cursor: progress; opacity: 0.65; }
  .promoted-badge {
    display: inline-block;
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--accent);
    border: 1px solid var(--accent);
    padding: 5px 9px;
  }

  .lineage-chip {
    font: inherit;
    justify-self: flex-start;
    align-self: flex-start;
    font-size: 11px;
    color: var(--muted);
    background: transparent;
    border: 1px dashed var(--line);
    padding: 3px 8px;
    cursor: pointer;
    transition: color 160ms ease, border-color 160ms ease;
  }
  .lineage-chip:hover,
  .lineage-chip:focus-visible { color: var(--accent); border-color: var(--accent); }
  .lineage-chip[data-loaded="true"] { border-style: solid; }
  .lineage-detail {
    font-size: var(--fs-eyebrow);
    color: var(--muted);
    border-left: 2px solid var(--line);
    padding: 4px 0 4px 8px;
    line-height: 1.45;
  }
  .lineage-detail b { color: var(--text); font-weight: var(--fw-semibold); }

  .tags {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 6px;
  }
  .tags li {
    font-size: 11px;
    font-weight: var(--fw-medium);
    color: var(--muted);
    border: 1px solid var(--line);
    padding: 2px 6px;
  }

  .status {
    margin: 0;
    min-height: 1em;
    font-size: 11px;
    color: var(--muted);
    font-style: italic;
  }
  .status[data-tone="ok"] { color: var(--accent); font-style: normal; }
  .status[data-tone="err"] { color: var(--accent); font-style: normal; }

  /* Bottom row: stars (left) + small public chip (right). The ✕ is
     corner-anchored separately via absolute positioning on the card. */
  .bottom-row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding-top: var(--space-2);
    /* Leave room for the abs-positioned ✕ so it doesn't overlap the toggle. */
    padding-right: 36px;
    border-top: 1px solid color-mix(in srgb, var(--line) 50%, transparent);
  }
  .quality {
    display: flex;
    gap: 2px;
    align-items: center;
  }
  .star {
    font: inherit;
    font-size: 18px;
    color: color-mix(in srgb, var(--text) 25%, transparent);
    background: transparent;
    border: 0;
    padding: 2px 3px;
    cursor: pointer;
    line-height: 1;
    transition: color 160ms ease, transform 80ms ease;
  }
  .star:hover,
  .star:focus-visible {
    color: var(--accent);
    outline: none;
    transform: translateY(-1px);
  }
  .star.on { color: var(--accent); }

  .pub-toggle {
    margin-left: auto;
    font: inherit;
    font-size: 10px;
    font-weight: var(--fw-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    background: transparent;
    border: 1px dashed var(--line);
    padding: 3px 7px;
    cursor: pointer;
    transition: color 160ms ease, border-color 160ms ease,
                border-style 160ms ease;
  }
  .pub-toggle:hover,
  .pub-toggle:focus-visible {
    color: var(--text);
    border-color: var(--text);
    border-style: solid;
    outline: none;
  }
  .pub-toggle.on {
    color: var(--bg);
    background: var(--accent);
    border-color: var(--accent);
    border-style: solid;
  }

  /* Hold-to-trash: absolutely positioned in the card's bottom-right
     corner. Distinct from the category buttons and from the public
     toggle so it doesn't visually blend with everyday actions. */
  .trash-hold {
    position: absolute;
    bottom: 10px;
    right: 10px;
    overflow: hidden;
    width: 28px;
    height: 24px;
    font: inherit;
    font-size: 14px;
    line-height: 1;
    color: var(--muted);
    background: transparent;
    border: 1px solid color-mix(in srgb, var(--accent) 35%, var(--line));
    cursor: pointer;
    transition: color 160ms ease, border-color 160ms ease;
    z-index: 3;
  }
  .trash-hold:hover,
  .trash-hold:focus-visible {
    color: var(--accent);
    border-color: var(--accent);
    outline: none;
  }
  .trash-hold .hold-fill {
    position: absolute;
    top: 0; left: 0; bottom: 0;
    width: 100%;
    background: var(--accent);
    transform-origin: left center;
    transform: scaleX(0);
    transition: none;
    pointer-events: none;
    z-index: 0;
  }
  .trash-hold[data-holding="true"] .hold-fill {
    transform: scaleX(1);
    transition: transform 2s linear;
  }
  .trash-hold .hold-glyph {
    position: relative;
    z-index: 1;
    font-weight: var(--fw-semibold);
  }
  .trash-hold[data-holding="true"] .hold-glyph { color: var(--bg); }
</style>
