<script>
  // Expand / collapse the details section. Anywhere on the card body
  // toggles, EXCEPT clicks on interactive descendants. The date subtitle
  // remains an explicit toggle target so keyboard + aria flow still works
  // (chevron rotates to indicate state).
  const togglePanel = (card: HTMLElement) => {
    const panel = card.querySelector<HTMLElement>("[data-expanded]");
    const dateBtn = card.querySelector<HTMLButtonElement>('[data-action="expand"]');
    if (!panel) return;
    const open = dateBtn?.getAttribute("aria-expanded") === "true";
    if (open) {
      dateBtn?.setAttribute("aria-expanded", "false");
      panel.hidden = true;
    } else {
      dateBtn?.setAttribute("aria-expanded", "true");
      panel.hidden = false;
    }
  };

  // Selector for any interactive child that should NOT trigger expand.
  // Includes the expanded panel itself so clicks inside it (chip removal,
  // tag input, lineage links, etc.) don't accidentally collapse the card.
  const INTERACTIVE_SKIP = [
    "[data-action]",
    "button",
    "input",
    "select",
    "textarea",
    "a",
    ".waveform",
    ".title-edit",
    ".expanded",
  ].join(",");

  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement | null;
    if (!target) return;

    // Path 1: explicit click on date subtitle (kept for a11y).
    const dateBtn = target.closest<HTMLButtonElement>('[data-action="expand"]');
    if (dateBtn) {
      const card = dateBtn.closest<HTMLElement>(".bucket-card");
      if (card) togglePanel(card);
      return;
    }

    // Path 2: click anywhere else in the card body. Only fire if the
    // click landed on a card AND didn't cross any interactive element.
    const card = target.closest<HTMLElement>(".bucket-card");
    if (!card) return;
    if (target.closest(INTERACTIVE_SKIP)) return;
    togglePanel(card);
  });
</script>
