---
import type { BucketAsset, BucketName } from "../../../lib/console-types";

interface Props {
  item: BucketAsset;
  /** Index within the rendered grid — stable tab order for arrow nav. */
  index: number;
}

const { item, index } = Astro.props;

const basename = (p: string): string => p.split("/").pop() ?? p;
const filename = item.filename || basename(item.path);
const title = item.display_name || filename;
const isPublic = item.public === 1;

const fmtDuration = (s: number | null): string | null => {
  if (s == null || !Number.isFinite(s) || s <= 0) return null;
  const m = Math.floor(s / 60);
  const r = Math.round(s % 60);
  return `${m}:${String(r).padStart(2, "0")}`;
};
const durationLabel = fmtDuration(item.duration_seconds);

// Date column: primary = "MMM DD", secondary = "YYYY · Xmo". Falls back to
// filesystem-mtime if engine sent it, else parses a [YYYY-MM-DD] from the
// filename, else hides the column gracefully. Done server-side so the row
// has stable text without a JS Date roundtrip per card.
const MONTHS = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
const dateInfo = (() => {
  let iso: string | null = item.modified ?? null;
  if (!iso) {
    const m = filename.match(/\[(\d{4})-(\d{2})-(\d{2})/);
    if (m) iso = `${m[1]}-${m[2]}-${m[3]}T00:00:00`;
  }
  if (!iso) return null;
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return null;
  const primary = `${MONTHS[d.getMonth()]} ${d.getDate()}`;
  const year = String(d.getFullYear());
  const ageMs = Date.now() - d.getTime();
  const ageDays = ageMs / 86400000;
  let relative: string;
  if (ageDays < 1) relative = "today";
  else if (ageDays < 7) relative = `${Math.floor(ageDays)}d`;
  else if (ageDays < 30) relative = `${Math.floor(ageDays / 7)}w`;
  else if (ageDays < 365) relative = `${Math.floor(ageDays / 30)}mo`;
  else relative = `${Math.floor(ageDays / 365)}y`;
  return { primary, year, relative };
})();

const tagList = (item.tags ?? "")
  .split(",")
  .map((t) => t.trim())
  .filter(Boolean)
  .slice(0, 8);

const BUCKET_LABEL: Record<BucketName, string> = {
  inbox: "Inbox",
  jam: "Jam",
  loops: "Loops",
  field: "Field",
  tracks: "Tracks",
  trash: "Trash",
};
const currentBucket: BucketName = item.bucket ?? "inbox";

const CATEGORIES: { id: BucketName; label: string; kbd: string }[] = [
  { id: "jam", label: "Jam", kbd: "J" },
  { id: "loops", label: "Loops", kbd: "L" },
  { id: "field", label: "Field", kbd: "F" },
  { id: "tracks", label: "Tracks", kbd: "T" },
];

const lineageWord = (() => {
  if (!item.parent_id) return null;
  switch (item.source_type) {
    case "voice_memo": return "voice-memo";
    case "video_extract": return "video";
    case "jam": return "jam";
    default: return "asset";
  }
})();

const waveformSrc = (() => {
  const wp = item.waveform_path;
  if (!wp) return null;
  const base = wp.split("/").pop() ?? wp;
  const sha1 = base.replace(/\.png$/i, "");
  if (!/^[a-f0-9]{40}$/i.test(sha1)) return null;
  return `/api/console/waveform?sha1=${sha1}`;
})();

const tech: string[] = [];
if (item.bpm) tech.push(`${Math.round(item.bpm)} BPM`);
if (item.key) tech.push(String(item.key));
if (typeof item.project_count === "number" && item.project_count > 0) {
  tech.push(`${item.project_count} ${item.project_count === 1 ? "project" : "projects"}`);
}

const hasExpanded =
  Boolean(item.summary) ||
  tagList.length > 0 ||
  Boolean(item.content_type) ||
  Boolean(item.source_type) ||
  Boolean(lineageWord) ||
  currentBucket === "loops";
---

<article
  class="bucket-card"
  tabindex="0"
  data-bucket-card
  data-card-index={String(index)}
  data-asset-id={String(item.asset_id)}
  data-bucket={currentBucket}
  data-quality={String(item.quality_star)}
  data-parent-id={item.parent_id ? String(item.parent_id) : ""}
  data-path={item.path}
  data-filename={filename}
  data-live-loop-path={item.live_loop_path ?? ""}
  data-public={isPublic ? "1" : "0"}
  aria-label={`${title} — ${BUCKET_LABEL[currentBucket]}`}
>
  <div class="card-grid">
    <!-- ── Head row: duration + title (spans full width, top-left) ───── -->
    <div class="head-row">
      <span class="duration" aria-label="Duration">{durationLabel ?? "—:—"}</span>
      <h3 class="title">
        <button
          type="button"
          class="title-edit"
          data-action="rename"
          data-path={item.path}
          title={`Click to rename. Real filename: ${filename}`}
        >{title}</button>
      </h3>
      {tech.length > 0 && (
        <span class="tech-meta">{tech.join(" · ")}</span>
      )}
      {item.dup_of && (
        <span class="flag-chip flag-dup" title={`Duplicate of asset_id ${item.dup_of}`}>DUP</span>
      )}
      {item.orphan_candidate === 1 && (
        <span class="flag-chip flag-orphan" title="Flagged orphan">ORPHAN</span>
      )}
    </div>

    <!-- ── Date column (under head row, left edge) ───────────────────── -->
    <div class="date-col" aria-hidden={dateInfo ? undefined : "true"}>
      {dateInfo ? (
        <>
          <div class="date-month">{dateInfo.primary}</div>
          <div class="date-year">{dateInfo.year}</div>
          <div class="date-rel">{dateInfo.relative}</div>
        </>
      ) : (
        <div class="date-month">—</div>
      )}
    </div>

    <!-- ── Main column: just the waveform ────────────────────────────── -->
    <div class="main-col">
      <div
        class="waveform"
        data-seekable={waveformSrc ? "true" : "false"}
        title={waveformSrc ? "Click to play (click again to seek)" : undefined}
      >
        {waveformSrc ? (
          <img
            src={waveformSrc}
            alt=""
            loading="lazy"
            width="640"
            height="60"
            onerror="this.replaceWith(Object.assign(document.createElement('div'),{className:'waveform-placeholder',textContent:'no waveform yet'}))"
          />
        ) : (
          <div class="waveform-placeholder">no waveform yet</div>
        )}
        <div class="waveform-playhead" data-playhead hidden></div>
        <div class="waveform-time" data-waveform-time hidden></div>
      </div>
    </div>

    <!-- ── Actions column ────────────────────────────────────────────── -->
    <div class="actions-col">
      <div class="category-bar" role="group" aria-label="Assign to category">
        {CATEGORIES.map((c) => (
          <button
            type="button"
            class:list={["category-btn", { active: currentBucket === c.id }]}
            data-action="bucket"
            data-bucket={c.id}
            title={`Assign to ${c.label} (${c.kbd})`}
          >
            <kbd>{c.kbd}</kbd>
            <span>{c.label}</span>
          </button>
        ))}
      </div>
      <div class="trail">
        <div class="quality" role="group" aria-label="Quality stars">
          {[1, 2, 3].map((n) => (
            <button
              type="button"
              class:list={["star", { on: item.quality_star >= n }]}
              data-action="quality-star"
              data-asset-id={String(item.asset_id)}
              data-star-value={String(n)}
              aria-label={`Set quality to ${n} star${n === 1 ? "" : "s"}`}
              title={`Set quality to ${n} (${n} when focused)`}
            >★</button>
          ))}
        </div>
        <button
          type="button"
          class:list={["pub-toggle", { on: isPublic }]}
          data-action="toggle-public"
          data-path={item.path}
          aria-pressed={isPublic ? "true" : "false"}
          title="Mark public on /sounds"
        >{isPublic ? "● Public" : "○ Public"}</button>
        <button
          type="button"
          class="trash-hold"
          data-action="trash-hold"
          title="Hold 2s to trash"
          aria-label="Hold to trash"
        ><span class="hold-fill" aria-hidden="true"></span><span class="hold-glyph">✕</span></button>
        {hasExpanded && (
          <button
            type="button"
            class="expand-toggle"
            data-action="expand"
            aria-expanded="false"
            aria-label="Show details"
            title="Show details"
          ><span class="chev" aria-hidden="true">▾</span></button>
        )}
      </div>
    </div>
  </div>

  <!-- ── Expanded section (collapsed by default) ─────────────────────── -->
  {hasExpanded && (
    <div class="expanded" data-expanded hidden>
      <dl class="exp">
        {item.summary && (
          <>
            <dt>Summary</dt>
            <dd>{item.summary}</dd>
          </>
        )}
        {tagList.length > 0 && (
          <>
            <dt>Tags</dt>
            <dd>
              <ul class="tag-list">
                {tagList.map((t) => <li>{t}</li>)}
              </ul>
            </dd>
          </>
        )}
        {(item.source_type || item.content_type) && (
          <>
            <dt>Type</dt>
            <dd>
              {item.content_type && <span>{item.content_type}</span>}
              {item.content_type && item.source_type && <span class="exp-sep"> · </span>}
              {item.source_type && <span>{item.source_type}</span>}
            </dd>
          </>
        )}
        {lineageWord && (
          <>
            <dt>Lineage</dt>
            <dd>
              <button
                type="button"
                class="lineage-chip"
                data-action="lineage"
                data-asset-id={String(item.asset_id)}
                title="Click to fetch parent + children"
              >from {lineageWord}:{item.parent_id}</button>
              <div class="lineage-detail" data-lineage-target hidden></div>
            </dd>
          </>
        )}
        {currentBucket === "loops" && (
          <>
            <dt>Live</dt>
            <dd>
              {item.live_loop_path ? (
                <span class="promoted-badge" title={`In Live's browser: ${item.live_loop_path}`}>✓ In Live</span>
              ) : (
                <button
                  type="button"
                  class="promote-btn"
                  data-action="promote-to-live"
                  data-asset-id={String(item.asset_id)}
                  title="Copy + normalize to _Soundbending/loops/"
                >→ Promote to Live</button>
              )}
            </dd>
          </>
        )}
      </dl>
      <p class="status" data-status-line aria-live="polite"></p>
    </div>
  )}
</article>

<style>
  /* ── Card shell ─────────────────────────────────────────────────────
     The cassette treatment (lighter bg + bright-blue border + inset
     highlight + bottom shadow) lives in PortalLayout's global style.
     This sheet defines the row's *internal* layout and typography. */
  .bucket-card {
    position: relative;
    padding: 12px 14px;
    outline: none;
    transition: border-color 200ms ease, box-shadow 200ms ease;
  }
  .bucket-card[data-pending="true"] { opacity: 0.5; pointer-events: none; }

  /* ── Two-row grid ──────────────────────────────────────────────────
     Row 1: head-row spans all three columns — duration partitioned from
            title, both anchored top-left. Always the same horizontal
            position so the eye finds runtime + name first.
     Row 2: date column | waveform | actions trail. */
  .card-grid {
    display: grid;
    grid-template-columns: 78px minmax(0, 1fr) auto;
    grid-template-rows: auto auto;
    column-gap: 16px;
    row-gap: 8px;
    align-items: center;
  }
  .head-row {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }

  /* Duration: pill-tagged so it always reads as its own partition,
     regardless of title length. When duration is unknown the pill still
     renders ("—:—") so the layout doesn't shift between cards. */
  .duration {
    flex: 0 0 auto;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 13px;
    font-weight: 700;
    color: #f5f1e8;
    background: rgba(14, 196, 252, 0.06);
    border: 1px solid rgba(14, 196, 252, 0.22);
    border-radius: 3px;
    padding: 3px 8px;
    font-feature-settings: "tnum";
    line-height: 1;
  }
  .title {
    flex: 1 1 auto;
    margin: 0;
    min-width: 0;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.2;
    color: #f5f1e8;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* ── Date column ──────────────────────────────────────────────────── */
  .date-col {
    grid-column: 1;
    grid-row: 2;
    align-self: stretch;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2px;
    padding-right: 12px;
    border-right: 1px solid rgba(245, 241, 232, 0.06);
  }
  .date-month {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    color: #ff6e21;
    line-height: 1;
  }
  /* Year reads as the visual anchor — larger, in the brand cyan so it
     stands distinctly apart from the orange month and the dim relative. */
  .date-year {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: #0ec4fc;
    line-height: 1;
    text-shadow: 0 0 14px rgba(14, 196, 252, 0.18);
  }
  .date-rel {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: rgba(245, 241, 232, 0.42);
    line-height: 1;
  }

  /* ── Main column ──────────────────────────────────────────────────── */
  .main-col {
    grid-column: 2;
    grid-row: 2;
    min-width: 0;
    display: grid;
    gap: 6px;
  }
  .title-edit {
    font: inherit;
    color: inherit;
    text-align: left;
    background: transparent;
    border: 1px dashed transparent;
    padding: 1px 4px;
    margin-left: -4px;
    cursor: text;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: border-color 160ms ease, color 160ms ease;
  }
  .title-edit:hover,
  .title-edit:focus-visible {
    border-color: rgba(14, 196, 252, 0.5);
    outline: none;
  }
  .tech-meta {
    flex: 0 0 auto;
    font-size: 11px;
    font-weight: 600;
    color: rgba(245, 241, 232, 0.62);
    letter-spacing: 0.02em;
    font-feature-settings: "tnum";
  }
  .flag-chip {
    flex: 0 0 auto;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 2px 6px;
    border: 1px solid currentColor;
    line-height: 1.4;
  }
  .flag-dup { color: rgba(245, 241, 232, 0.42); }
  .flag-orphan { color: #ff6e21; }

  /* ── Waveform (the row's visual fingerprint) ──────────────────────── */
  .waveform {
    position: relative;
    height: 48px;
    background: var(--surface-1, #07060c);
    border-radius: 3px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .waveform[data-seekable="true"] { cursor: pointer; }
  .waveform[data-seekable="true"]:hover { box-shadow: inset 0 0 0 1px rgba(14, 196, 252, 0.45); }
  .waveform img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    opacity: 0.92;
  }
  .waveform-placeholder {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(245, 241, 232, 0.32);
  }
  .waveform-playhead {
    position: absolute;
    top: 0; bottom: 0;
    width: 2px;
    left: 0;
    background: #ff3b6e;
    pointer-events: none;
    box-shadow: 0 0 6px rgba(255, 59, 110, 0.6);
    z-index: 2;
  }
  .waveform-time {
    position: absolute;
    bottom: 3px;
    right: 5px;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 10px;
    font-feature-settings: "tnum";
    line-height: 1;
    color: #0e0c14;
    background: rgba(245, 241, 232, 0.78);
    padding: 2px 5px;
    border-radius: 2px;
    pointer-events: none;
    z-index: 2;
  }

  /* ── Actions column ───────────────────────────────────────────────── */
  .actions-col {
    grid-column: 3;
    grid-row: 2;
    align-self: stretch;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-end;
    gap: 8px;
    padding-left: 12px;
    border-left: 1px solid rgba(245, 241, 232, 0.06);
  }
  .category-bar {
    display: grid;
    grid-template-columns: repeat(4, 56px);
    gap: 6px;
  }
  .category-btn {
    min-height: 34px;
    font: inherit;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(245, 241, 232, 0.66);
    background: transparent;
    border: 1px solid rgba(245, 241, 232, 0.08);
    border-radius: 4px;
    padding: 6px 4px;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    line-height: 1;
    transition: color 160ms ease, border-color 160ms ease,
                background-color 160ms ease, transform 80ms ease;
  }
  .category-btn:hover,
  .category-btn:focus-visible {
    border-color: rgba(14, 196, 252, 0.55);
    color: #f5f1e8;
    outline: none;
  }
  .category-btn:active { transform: translateY(1px); }
  /* The keyboard-shortcut letter, no longer boxed. */
  .category-btn kbd {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 14px;
    font-weight: 700;
    line-height: 1;
    padding: 0;
    border: 0;
    background: transparent;
    letter-spacing: 0;
    color: inherit;
    opacity: 0.85;
  }
  .category-btn.active kbd { opacity: 1; }

  /* ── Trail (stars, public, trash, expand) ─────────────────────────── */
  .trail {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .quality {
    display: flex;
    gap: 0;
    align-items: center;
  }
  .star {
    font: inherit;
    font-size: 14px;
    color: rgba(245, 241, 232, 0.22);
    background: transparent;
    border: 0;
    padding: 2px 3px;
    cursor: pointer;
    line-height: 1;
    transition: color 160ms ease, transform 80ms ease;
  }
  .star:hover,
  .star:focus-visible {
    color: #ff3b6e;
    outline: none;
    transform: translateY(-1px);
  }
  .star.on { color: #ff3b6e; }

  .pub-toggle {
    font: inherit;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(245, 241, 232, 0.42);
    background: transparent;
    border: 1px dashed rgba(245, 241, 232, 0.18);
    border-radius: 3px;
    padding: 3px 7px;
    cursor: pointer;
    transition: color 160ms ease, border-color 160ms ease,
                border-style 160ms ease;
  }
  .pub-toggle:hover,
  .pub-toggle:focus-visible {
    color: #f5f1e8;
    border-color: rgba(245, 241, 232, 0.45);
    border-style: solid;
    outline: none;
  }
  /* .pub-toggle.on inherits the wave-textured surface from PortalLayout's
     global override. */

  .trash-hold {
    position: relative;
    overflow: hidden;
    width: 26px;
    height: 22px;
    font: inherit;
    font-size: 12px;
    line-height: 1;
    color: rgba(245, 241, 232, 0.45);
    background: transparent;
    border: 1px solid rgba(245, 241, 232, 0.18);
    border-radius: 3px;
    cursor: pointer;
    transition: color 160ms ease, border-color 160ms ease,
                background 160ms ease, box-shadow 160ms ease;
  }
  /* Hover wears the pink → orange gradient — the same key surface used
     on active buttons elsewhere. Makes the destructive action visually
     committed but reversible until you complete the 2s hold. */
  .trash-hold:hover,
  .trash-hold:focus-visible {
    color: #fff;
    background-image: linear-gradient(135deg, #ff3b6e 0%, #ff6e21 100%);
    border-color: transparent;
    outline: none;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.28),
      0 2px 10px rgba(255, 59, 110, 0.32),
      0 0 0 1px rgba(14, 196, 252, 0.50);
  }
  .trash-hold:hover .hold-glyph,
  .trash-hold:focus-visible .hold-glyph {
    text-shadow: 0 1px 1px rgba(120, 8, 52, 0.40);
  }
  .trash-hold .hold-fill {
    position: absolute;
    top: 0; left: 0; bottom: 0;
    width: 100%;
    background: #ff3b6e;
    transform-origin: left center;
    transform: scaleX(0);
    transition: none;
    pointer-events: none;
    z-index: 0;
  }
  .trash-hold[data-holding="true"] .hold-fill {
    transform: scaleX(1);
    transition: transform 2s linear;
  }
  .trash-hold .hold-glyph {
    position: relative;
    z-index: 1;
    font-weight: 700;
  }
  .trash-hold[data-holding="true"] .hold-glyph { color: #0e0c14; }

  .expand-toggle {
    font: inherit;
    font-size: 12px;
    width: 26px;
    height: 22px;
    line-height: 1;
    color: rgba(245, 241, 232, 0.55);
    background: transparent;
    border: 1px solid rgba(245, 241, 232, 0.18);
    border-radius: 3px;
    cursor: pointer;
    transition: color 160ms ease, border-color 160ms ease,
                background-color 160ms ease;
  }
  .expand-toggle:hover,
  .expand-toggle:focus-visible {
    color: #0ec4fc;
    border-color: rgba(14, 196, 252, 0.55);
    outline: none;
  }
  .expand-toggle .chev {
    display: inline-block;
    transition: transform 220ms ease;
  }
  .expand-toggle[aria-expanded="true"] .chev { transform: rotate(180deg); }
  .expand-toggle[aria-expanded="true"] {
    color: #0ec4fc;
    border-color: rgba(14, 196, 252, 0.55);
    background: rgba(14, 196, 252, 0.06);
  }

  /* ── Expanded section ─────────────────────────────────────────────── */
  .expanded {
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px solid rgba(14, 196, 252, 0.14);
    animation: exp-in 220ms ease;
  }
  @keyframes exp-in {
    from { opacity: 0; transform: translateY(-4px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .exp {
    display: grid;
    grid-template-columns: 92px 1fr;
    gap: 4px 14px;
    margin: 0;
    font-size: 12px;
    line-height: 1.45;
  }
  .exp dt {
