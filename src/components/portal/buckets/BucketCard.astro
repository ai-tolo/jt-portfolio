---
import type { BucketAsset, BucketName } from "../../../lib/console-types";

interface Props {
  item: BucketAsset;
  /** Index within the rendered grid — stable tab order for arrow nav. */
  index: number;
}

const { item, index } = Astro.props;

const basename = (p: string): string => p.split("/").pop() ?? p;
const filename = item.filename || basename(item.path);
const title = item.display_name || filename;
const isPublic = item.public === 1;

const fmtDuration = (s: number | null): string | null => {
  if (s == null || !Number.isFinite(s) || s <= 0) return null;
  const m = Math.floor(s / 60);
  const r = Math.round(s % 60);
  return `${m}:${String(r).padStart(2, "0")}`;
};
const durationLabel = fmtDuration(item.duration_seconds);

// Date column: primary = "MMM DD", secondary = "YYYY · Xmo".
//
// For extracted-from-video children, the row's own `modified` is the
// extraction timestamp (often weeks or months after the source was
// captured). Prefer the parent's modified when present so the card
// reflects when the *content* was captured, not when we extracted audio
// from it. Falls back to filename-embedded [YYYY-MM-DD] when neither
// engine-side timestamp is available.
const MONTHS = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
const dateInfo = (() => {
  let iso: string | null = item.parent_modified ?? item.modified ?? null;
  if (!iso) {
    const m = filename.match(/\[(\d{4})-(\d{2})-(\d{2})/);
    if (m) iso = `${m[1]}-${m[2]}-${m[3]}T00:00:00`;
  }
  if (!iso) return null;
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return null;
  const primary = `${MONTHS[d.getMonth()]} ${d.getDate()}`;
  const year = String(d.getFullYear());
  const mm = String(d.getMonth() + 1).padStart(2, "0");
  const dd = String(d.getDate()).padStart(2, "0");
  const stamped = `${mm}-${dd}-${year}`;
  const ageMs = Date.now() - d.getTime();
  const ageDays = ageMs / 86400000;
  let relative: string;
  if (ageDays < 1) relative = "today";
  else if (ageDays < 7) relative = `${Math.floor(ageDays)}d`;
  else if (ageDays < 30) relative = `${Math.floor(ageDays / 7)}w`;
  else if (ageDays < 365) relative = `${Math.floor(ageDays / 30)}mo`;
  else relative = `${Math.floor(ageDays / 365)}y`;
  // Absolute day count. Comma-grouped past 1000 for legibility. Cheap math,
  // no perf concern — one subtract + format per card.
  const daysInt = Math.max(0, Math.floor(ageDays));
  const daysAbs = daysInt.toLocaleString("en-US") + "d";
  return { primary, year, relative, stamped, daysAbs };
})();

const tagList = (item.tags ?? "")
  .split(",")
  .map((t) => t.trim())
  .filter(Boolean)
  .slice(0, 8);

const BUCKET_LABEL: Record<BucketName, string> = {
  inbox: "Inbox",
  jam: "Jam",
  loops: "Loops",
  field: "Field",
  tracks: "Tracks",
  trash: "Trash",
};
const currentBucket: BucketName = item.bucket ?? "inbox";

const CATEGORIES: { id: BucketName; label: string; kbd: string }[] = [
  { id: "jam", label: "JAM", kbd: "J" },
  { id: "loops", label: "LOOP", kbd: "L" },
  { id: "field", label: "FIELD", kbd: "F" },
  { id: "tracks", label: "TRACK", kbd: "T" },
];

// Split the title at the file extension so the .wav suffix can render
// at a quieter opacity than the main name. Tries common audio extensions
// first; falls back to whatever the last dot suffix is up to 5 chars.
const titleParts = (() => {
  const m = title.match(/^(.*?)(\.[A-Za-z0-9]{1,5})$/);
  return m ? { base: m[1], ext: m[2] } : { base: title, ext: "" };
})();

// Parse the engine's free-form key string into a clean letter + mode.
// The column may hold "C", "D#", "Dm", "F#m", "D major", "D maj",
// "D minor" — normalise so we don't render "D major major".
const keyInfo = (() => {
  if (!item.key) return { letter: null as string | null, mode: null as string | null };
  const str = String(item.key).trim();
  let m = str.match(/^([A-Ga-g][#b]?)\s*(major|minor|maj|min)\b/i);
  if (m) {
    const mode = m[2].toLowerCase().startsWith("min") ? "minor" : "major";
    return { letter: m[1].toUpperCase().replace("B", "b"), mode };
  }
  m = str.match(/^([A-Ga-g][#b]?)m$/);
  if (m) return { letter: m[1].toUpperCase().replace("B", "b"), mode: "minor" };
  m = str.match(/^([A-Ga-g][#b]?)$/);
  if (m) return { letter: m[1].toUpperCase().replace("B", "b"), mode: "major" };
  return { letter: str, mode: null };
})();

const lineageWord = (() => {
  if (!item.parent_id) return null;
  // Prefer parent_category (engine-supplied) over source_type — it's the
  // ground truth from the parent row, not a derivation.
  if (item.parent_category === "video") return "video";
  switch (item.source_type) {
    case "voice_memo": return "voice-memo";
    case "video_extract": return "video";
    case "jam": return "jam";
    default: return "asset";
  }
})();

// Pretty-printed parent display name for the lineage chip — strip extension
// and lean on display_name when set.
const parentLabel = (() => {
  if (!item.parent_id) return null;
  const name = item.parent_display_name || item.parent_filename || `asset:${item.parent_id}`;
  return name.replace(/\.[A-Za-z0-9]{1,5}$/, "");
})();

// Where clicking the lineage chip should navigate. Parent's bucket page,
// anchored at the parent's card via `?focus=<parent_id>`.
const parentHref = (() => {
  if (!item.parent_id) return null;
  const bucket = item.parent_bucket || "all";
  return `/portal/buckets/${bucket}?focus=${item.parent_id}`;
})();

const fmtMmSs = (s: number | null | undefined): string | null => {
  if (s == null || !Number.isFinite(s) || s <= 0) return null;
  const m = Math.floor(s / 60);
  const r = Math.round(s % 60);
  return `${m}:${String(r).padStart(2, "0")}`;
};

// Tech facts shown in the expanded panel when summary is null (and even
// when populated, as supplementary detail). Always-on so curators can see
// what was actually analyzed.
const techFacts: string[] = [];
if (item.bpm) techFacts.push(`${Math.round(item.bpm)} BPM`);
if (item.key) techFacts.push(String(item.key));
const techDur = fmtMmSs(item.duration_seconds);
if (techDur) techFacts.push(techDur);
if (typeof item.loop_density === "number") {
  techFacts.push(`loop-density ${item.loop_density.toFixed(2)}`);
}
if (typeof item.silence_ratio === "number" && item.silence_ratio > 0) {
  techFacts.push(`${Math.round(item.silence_ratio * 100)}% silent`);
}

// Long-form jam rows get an explanatory note in place of the missing
// summary — Jon's auto-bucket policy says >30min content is NOT
// auto-transcribed because Whisper hallucinates on long music sections.
const isLongJam =
  (item.duration_seconds ?? 0) > 1800 &&
  (item.bucket === "jam" || item.parent_bucket === "jam");
const hasNoSummary = !item.summary || /^(insufficient|music or non-speech)/i.test(item.summary);

const waveformSrc = (() => {
  const wp = item.waveform_path;
  if (!wp) return null;
  const base = wp.split("/").pop() ?? wp;
  const sha1 = base.replace(/\.png$/i, "");
  if (!/^[a-f0-9]{40}$/i.test(sha1)) return null;
  return `/api/console/waveform?sha1=${sha1}`;
})();

const tech: string[] = [];
if (item.bpm) tech.push(`${Math.round(item.bpm)} BPM`);
if (item.key) tech.push(String(item.key));
if (typeof item.project_count === "number" && item.project_count > 0) {
  tech.push(`${item.project_count} ${item.project_count === 1 ? "project" : "projects"}`);
}

// Always true now — rating + (optionally) summary/tags/lineage/promote
// all live in the expanded panel.
const hasExpanded = true;
---

<article
  class="bucket-card"
  tabindex="0"
  data-bucket-card
  data-card-index={String(index)}
  data-asset-id={String(item.asset_id)}
  data-bucket={currentBucket}
  data-quality={String(item.quality_star)}
  data-parent-id={item.parent_id ? String(item.parent_id) : ""}
  data-path={item.path}
  data-filename={filename}
  data-live-loop-path={item.live_loop_path ?? ""}
  data-public={isPublic ? "1" : "0"}
  aria-label={`${title} — ${BUCKET_LABEL[currentBucket]}`}
>
  <div class="card-grid">
    <!-- ── Main column: title row, sub-title (duration + BPM), wave row ── -->
    <div class="middle-col">
      {/* Title — far left, green, near-borderless. Lead element. */}
      <h3 class="title">
        <button
          type="button"
          class="title-edit"
          data-action="rename"
          data-path={item.path}
          title={`Click to rename. Real filename: ${filename}`}
        ><span class="title-base">{titleParts.base}</span>{titleParts.ext && <span class="title-ext">{titleParts.ext}</span>}</button>
        {item.dup_of && (
          <button
            type="button"
            class="flag-chip flag-dup"
            data-action="dup-group"
            data-asset-id={String(item.asset_id)}
            title={item.dup_count && item.dup_count > 1
              ? `${item.dup_count} copies share this content. Click to see siblings (canonical highlighted) before trashing.`
              : `Duplicate of asset_id ${item.dup_of}`}
          >
            DUP{item.dup_count && item.dup_count > 1 ? ` (${item.dup_count})` : ""}
          </button>
        )}
        {/* Inline sibling list — populated lazily on DUP click. Scoped to
            this card so multiple DUP chips don't fight for the same panel. */}
        <div class="dup-detail" data-dup-target hidden></div>
      </h3>

      <div class="wave-row">
        {/* Runtime sits to the LEFT of the waveform — borderless LCD
            digits with a soft pink glow. */}
        <span class="duration" aria-label="Duration">{durationLabel ?? "—:—"}</span>
        <div
          class="waveform"
          data-seekable={waveformSrc ? "true" : "false"}
          title={waveformSrc ? "Click to play (click again to seek)" : undefined}
        >
          {waveformSrc ? (
            <img
              src={waveformSrc}
              alt=""
              loading="lazy"
              width="640"
              height="60"
              onerror="this.replaceWith(Object.assign(document.createElement('div'),{className:'waveform-placeholder',textContent:'no waveform yet'}))"
            />
          ) : (
            <div class="waveform-placeholder">no waveform yet</div>
          )}
          <div class="waveform-playhead" data-playhead hidden></div>
          <div class="waveform-time" data-waveform-time hidden></div>
        </div>
      </div>

      {/* Date at the bottom-left of the card. Format "8y [12-12-2018]"
          with an expand carrot at the trailing edge. */}
      <button
        type="button"
        class="date-subtitle"
        data-action="expand"
        aria-expanded="false"
        title={dateInfo ? "Click to expand" : undefined}
      >
        {dateInfo ? (
          <>
            <span class="date-rel">{dateInfo.relative}</span>
            <span class="date-bracket"> [</span><span class="date-stamped">{dateInfo.stamped}</span><span class="date-bracket">]</span>
            <span class="date-sep"> · </span>
            <span class="date-days" title="Total days since this date">{dateInfo.daysAbs}</span>
            {typeof item.silence_ratio === "number" && item.silence_ratio > 0.2 && (
              <>
                <span class="date-sep"> · </span>
                <span class="silence-meta" title="Fraction of audio below the silence floor.">{Math.round(item.silence_ratio * 100)}% silent</span>
              </>
            )}
          </>
        ) : (
          <span class="date-rel">date unknown</span>
        )}
        <span class="date-chev" aria-hidden="true">▾</span>
      </button>

      <p class="status" data-status-line aria-live="polite"></p>
    </div>

    {/* J/L/F/T as a vertical 4x1 column adjacent to the archive X. */}
    <div class="category-bar" role="group" aria-label="Assign to category">
      {CATEGORIES.map((c) => (
        <button
          type="button"
          class:list={["category-btn", { active: currentBucket === c.id }]}
          data-action="bucket"
          data-bucket={c.id}
          aria-label={`Assign to ${c.label}`}
          title={`Assign to ${c.label} (${c.kbd})`}
        >
          <kbd>{c.kbd}</kbd>
          <span class="category-label">{c.label}</span>
        </button>
      ))}
    </div>

    <!-- ── Archive column. Orphan-candidate rows wear a red rim glow
         (no animation, lighter perceived weight). ────────────────────── -->
    <button
      type="button"
      class:list={["trash-hold detached", { "is-orphan": item.orphan_candidate === 1 }]}
      data-action="trash-hold"
      title={item.orphan_candidate === 1
        ? "Likely safe to archive (unused, never auditioned). Hold 0.45s."
        : "Hold 0.45s to archive"}
      aria-label="Hold to archive"
    >
      <span class="hold-fill" aria-hidden="true"></span>
      <span class="hold-glyph">✕</span>
    </button>
  </div>

  <!-- ── Expanded section (collapsed by default) ─────────────────────── -->
  {hasExpanded && (
    <div class="expanded" data-expanded hidden>
      <dl class="exp">
        {/* Single Tags row — combines what used to be Visibility + Type +
            Tags into one chip strip. Order: PUBLIC (curator-toggleable,
            always first), source_type + content_type (engine-derived,
            read-only), then comma-split tag values (curator-editable, each
            with × to remove), then "+" to add a new tag. */}
        <dt>Tags</dt>
        <dd class="exp-tags">
          <button
            type="button"
            class:list={["chip chip-public", { on: isPublic }]}
            data-action="toggle-public"
            data-path={item.path}
            aria-pressed={isPublic ? "true" : "false"}
            title="Mark public on /sounds"
          >{isPublic ? "● PUBLIC" : "○ PUBLIC"}</button>
          {item.content_type && (
            <span class="chip chip-derived" title="Engine-classified content type">{item.content_type}</span>
          )}
          {item.source_type && (
            <span class="chip chip-derived" title="Engine-classified source type">{item.source_type}</span>
          )}
          {tagList.map((t) => (
            <span class="chip chip-tag" data-tag-value={t}>
              {t}
              <button
                type="button"
                class="chip-x"
                data-action="tag-remove"
                data-path={item.path}
                data-tag={t}
                aria-label={`Remove tag ${t}`}
                title={`Remove tag "${t}"`}
              >×</button>
            </span>
          ))}
          <button
            type="button"
            class="chip chip-add"
            data-action="tag-add"
            data-path={item.path}
            title="Add a new tag"
          >+ add</button>
        </dd>
        {(item.bpm || item.key) && (
          <>
            <dt>Tech</dt>
            <dd class="exp-tech">
              {item.bpm && (
                <>
                  <span class="bpm-num">{Math.round(item.bpm)}</span>
                  <span class="bpm-unit">BPM</span>
                </>
              )}
              {item.bpm && item.key && <span class="tech-sep">·</span>}
              {item.key && (
                <>
                  <span class="key">{keyInfo.letter || "—"}</span>
                  {keyInfo.mode && <span class="key-mode">{keyInfo.mode}</span>}
                </>
              )}
            </dd>
          </>
        )}
        {lineageWord && parentLabel && (
          <>
            <dt>Lineage</dt>
            <dd>
              {/* Rich inline lineage: parent name as a link to its bucket
                  page (with ?focus= anchor), bucket + duration + date as
                  inline metadata. No click-to-fetch needed — the data is
                  already on the row from the engine LEFT JOIN. */}
              <span class="lineage-line">
                <span class="lineage-from">from {lineageWord}:</span>
                {parentHref ? (
                  <a class="lineage-link" href={parentHref}>{parentLabel}</a>
                ) : (
                  <span class="lineage-link">{parentLabel}</span>
                )}
                {item.parent_bucket && (
                  <span class="lineage-meta"> · {item.parent_bucket}</span>
                )}
                {fmtMmSs(item.parent_duration_seconds) && (
                  <span class="lineage-meta"> · {fmtMmSs(item.parent_duration_seconds)}</span>
                )}
              </span>
              {/* Optional deeper fetch for siblings/children — kept for the
                  curator who wants to see "other audio extracted from the
                  same source video". Click-to-load. */}
              <button
                type="button"
                class="lineage-more"
                data-action="lineage"
                data-asset-id={String(item.asset_id)}
                title="Load siblings + children of this row"
              >show siblings</button>
              <div class="lineage-detail" data-lineage-target hidden></div>
            </dd>
          </>
        )}
        {/* Visual separator between curator metadata (tags/tech/lineage)
            and engine-generated content (summary/note). Spans both grid
            columns so the eye knows the section below is a different
            kind of information. */}
        {(item.summary && !/^(insufficient|music or non-speech)/i.test(item.summary)) || (hasNoSummary && isLongJam) ? (
          <div class="exp-divider" role="presentation"></div>
        ) : null}
        {item.summary && !/^(insufficient|music or non-speech)/i.test(item.summary) && (
          <>
            <dt>Summary</dt>
            <dd>{item.summary}</dd>
          </>
        )}
        {/* Long-form jam content gets an explanatory note where the summary
            would be. Auto-bucket policy: rows >30min go to jam and are NOT
            auto-transcribed because Whisper hallucinates on long music. */}
        {hasNoSummary && isLongJam && (
          <>
            <dt>Note</dt>
            <dd class="exp-note">Not auto-transcribed — Whisper hallucinates on long music sections. Browse the waveform / audition to find what's in here.</dd>
          </>
        )}
        {currentBucket === "loops" && (
          <>
            <dt>Live</dt>
            <dd>
              {item.live_loop_path ? (
                <span class="promoted-badge" title={`In Live's browser: ${item.live_loop_path}`}>✓ In Live</span>
              ) : (
                <button
                  type="button"
                  class="promote-btn"
                  data-action="promote-to-live"
                  data-asset-id={String(item.asset_id)}
                  title="Copy + normalize to _Soundbending/loops/"
                >→ Promote to Live</button>
              )}
            </dd>
          </>
        )}
      </dl>
      <p class="status" data-status-line aria-live="polite"></p>
    </div>
  )}
</article>

<style>
  /* ── Card shell ─────────────────────────────────────────────────────
     The cassette treatment (border + glow) lives in PortalLayout's
     global style. This sheet defines the row's internal layout. Cards
     clip content so the date spine reaches the rounded corner. */
  .bucket-card {
    position: relative;
    padding: 0;
    outline: none;
    transition: border-color 200ms ease, box-shadow 200ms ease;
    overflow: hidden;
  }
  .bucket-card[data-pending="true"] { opacity: 0.5; pointer-events: none; }

  /* ── Two-row grid ──────────────────────────────────────────────────
     Row 1: head-row spans all three columns — duration partitioned from
            title, both anchored top-left. Always the same horizontal
            position so the eye finds runtime + name first.
     Row 2: date column | waveform | actions trail. */
  /* Three-column grid:
       col 1: main stack — title, BPM subtitle, waveform, date
       col 2: vertical J/L/F/T tile column adjacent to the archive X
       col 3: archive X on the far right edge */
  .card-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto 42px;
    column-gap: 0;
    align-items: stretch;
    padding: 16px 0 16px 20px;
  }
  .middle-col {
    grid-column: 1;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 0 18px 0 0;
    min-width: 0;
    justify-content: center;
  }
  /* Wave row — duration LCD on the left, waveform fills the rest. */
  .wave-row {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
  }

  /* Duration — borderless LCD readout to the LEFT of the waveform.
     Mono italic digits with a soft pink glow. */
  .duration {
    flex: 0 0 auto;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-style: italic;
    font-size: 16px;
    font-weight: 700;
    color: #ff3b6e;
    background: transparent;
    border: 0;
    padding: 0;
    font-feature-settings: "tnum";
    line-height: 1;
    letter-spacing: 0.04em;
    min-width: 3.6em;
    text-align: right;
    text-shadow:
      0 0 4px rgba(255, 59, 110, 0.65),
      0 0 10px rgba(255, 59, 110, 0.35);
  }
  .title {
    flex: 1 1 auto;
    margin: 0;
    min-width: 0;
    line-height: 1;
  }

  /* ── Date spine ──────────────────────────────────────────────────────
     Full-height burgundy stripe on the left edge of the card. PUBLIC
     toggle sits at the top, date stack centered below. */
  /* Date subtitle — bottom-left of the card, with breathing room above
     the waveform. Bigger + higher-contrast than before so it doesn't
     read as decoration. Format: "8y [12-12-2018] ▾". Whole line is
     the expand click target. */
  .date-subtitle {
    display: inline-flex;
    align-items: baseline;
    gap: 2px;
    align-self: flex-start;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: rgba(245, 241, 232, 0.72);
    background: transparent;
    border: 0;
    padding: 5px 10px 5px 8px;
    margin-left: -8px;
    margin-top: 16px;
    cursor: pointer;
    line-height: 1;
    text-align: left;
    transition: color 160ms ease, background 160ms ease;
    border-radius: 4px;
  }
  .date-subtitle:hover,
  .date-subtitle:focus-visible {
    color: #f5f1e8;
    background: rgba(14, 196, 252, 0.05);
    outline: none;
  }
  .date-subtitle .date-rel {
    color: #f5f1e8;
    font-weight: 700;
  }
  .date-subtitle .date-bracket {
    color: rgba(245, 241, 232, 0.32);
    font-weight: 500;
  }
  .date-subtitle .date-stamped {
    color: rgba(245, 241, 232, 0.65);
    font-weight: 500;
    letter-spacing: 0.02em;
  }
  .date-subtitle .date-sep {
    color: rgba(245, 241, 232, 0.32);
    font-weight: 500;
  }
  .date-subtitle .date-days {
    color: rgba(245, 241, 232, 0.5);
    font-weight: 500;
    letter-spacing: 0.02em;
    font-feature-settings: "tnum";
  }
  .date-subtitle .date-chev {
    margin-left: 8px;
    color: rgba(245, 241, 232, 0.55);
    font-size: 12px;
    transition: transform 220ms ease, color 160ms ease;
    display: inline-block;
    line-height: 1;
  }
  .date-subtitle[aria-expanded="true"] .date-chev {
    color: #0ec4fc;
    transform: rotate(180deg);
  }
  .date-subtitle[aria-expanded="true"] {
    color: #f5f1e8;
    background: rgba(14, 196, 252, 0.08);
  }

  /* Smaller, lower-profile PUBLIC at the top of the spine. */
  .pub-toggle {
    flex: 0 0 auto;
    align-self: flex-start;
    font: inherit;
    font-family: "Geist Variable", ui-sans-serif, system-ui, sans-serif;
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(245, 241, 232, 0.48);
    background: transparent;
    border: 1px dashed rgba(245, 241, 232, 0.18);
    border-radius: 2px;
    padding: 2px 5px;
    cursor: pointer;
    transition: color 160ms ease, border-color 160ms ease,
                background 160ms ease;
  }
  .pub-toggle:hover,
  .pub-toggle:focus-visible {
    color: #f5f1e8;
    border-color: rgba(245, 241, 232, 0.45);
    outline: none;
  }
  .pub-toggle.on {
    color: #ff3b6e;
    border-color: rgba(255, 59, 110, 0.55);
    border-style: solid;
  }

  /* ── Main column (col 2, row 2): just the waveform ─────────────────── */
  .main-col {
    grid-column: 2;
    grid-row: 2;
    min-width: 0;
    display: grid;
    gap: 6px;
  }
  /* Title — green, italic mono, emphasized by default. The lead element
     of the row, wearing a subtle green glow and a soft green outline so
     it reads as the row's identity at a glance. */
  .title {
    margin: 0;
    line-height: 1.1;
    min-width: 0;
  }
  .title-edit {
    display: inline-block;
    max-width: 100%;
    font: inherit;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-style: italic;
    font-size: 17px;
    font-weight: 700;
    color: #00ff4d;
    text-align: left;
    background: transparent;
    border: 1px solid rgba(245, 241, 232, 0.10);
    border-radius: 4px;
    padding: 5px 10px;
    margin-left: -10px;
    cursor: text;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: color 160ms ease, background 160ms ease, border-color 160ms ease;
  }
  .title-edit:hover,
  .title-edit:focus-visible {
    background: rgba(245, 241, 232, 0.04);
    border-color: rgba(245, 241, 232, 0.22);
    outline: none;
  }
  /* Selected card — title shifts to a brighter green, border picks up a
     faint green tint so it reads as the active row without competing with
     the card's rainbow gradient frame. */
  .bucket-card[data-focused="true"] .title-edit,
  .bucket-card:focus-visible .title-edit {
    color: #a1ff98;
    background: transparent;
    border-color: rgba(161, 255, 152, 0.22);
  }

  /* Rename form replaces the title button while editing. The form is
     created at runtime by PortalLayout's JS via document.createElement,
     so it doesn't carry Astro's scoped data-attribute — we have to use
     :global() for these rules to apply. Scoped to .bucket-card .title
     so other surfaces (Card.astro) keep their own treatment. */
  :global(.bucket-card .title .rename-form) {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
    margin-left: -10px;
    max-width: 100%;
  }
  :global(.bucket-card .title .rename-form input) {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-style: italic;
    font-size: 17px;
    font-weight: 700;
    color: #a1ff98;
    background: rgba(161, 255, 152, 0.06);
    border: 1px solid rgba(161, 255, 152, 0.45);
    border-radius: 4px;
    padding: 4px 10px;
    min-width: 14rem;
    flex: 1 1 auto;
    outline: none;
    caret-color: #a1ff98;
  }
  :global(.bucket-card .title .rename-form input:focus) {
    border-color: rgba(161, 255, 152, 0.75);
    background: rgba(161, 255, 152, 0.08);
  }
  :global(.bucket-card .title .rename-form button) {
    font-family: "Geist Variable", ui-sans-serif, system-ui, sans-serif;
    font-style: normal;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(245, 241, 232, 0.78);
    background: transparent;
    border: 1px solid rgba(245, 241, 232, 0.22);
    border-radius: 3px;
    padding: 4px 9px;
    cursor: pointer;
    transition: color 160ms ease, border-color 160ms ease,
                background 160ms ease;
  }
  :global(.bucket-card .title .rename-form button:hover),
  :global(.bucket-card .title .rename-form button:focus-visible) {
    color: #f5f1e8;
    border-color: rgba(245, 241, 232, 0.45);
    outline: none;
  }
  /* Override PortalLayout's global button.primary gradient — we want the
     Save button to read as the green-on-dark sibling of the title, not
     the system-wide pink/orange CTA. */
  :global(.bucket-card .title .rename-form button.primary) {
    color: #0e0c14 !important;
    background: #a1ff98 !important;
    background-image: none !important;
    border-color: #a1ff98 !important;
    text-shadow: none !important;
    box-shadow: none !important;
  }
  :global(.bucket-card .title .rename-form button.primary:hover),
  :global(.bucket-card .title .rename-form button.primary:focus-visible) {
    background: #b9ffb1 !important;
    background-image: none !important;
    border-color: #b9ffb1 !important;
    color: #0e0c14 !important;
    box-shadow: none !important;
  }
  .title .rename-form button:disabled {
    opacity: 0.45;
    cursor: wait;
  }
  .title-base { color: inherit; }
  /* File extension renders at 60% of the title size so ".wav" / ".als"
     sit as a quiet caret-mark next to the proper name. */
  .title-ext {
    color: #f5f1e8;
    opacity: 0.42;
    font-style: italic;
    font-weight: 500;
    font-size: 0.6em;
  }

  /* BPM / key — lives in the expanded dl now. Number + key letter wear the
     cyan accent; "BPM" + "major" are muted cream label-weight. */
  .exp-tech {
    display: inline-flex;
    align-items: baseline;
    gap: 4px;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-style: italic;
    font-feature-settings: "tnum";
    line-height: 1;
  }
  .exp-tech .bpm-num {
    font-size: 13px;
    font-weight: 700;
    color: #0ec4fc;
  }
  .exp-tech .bpm-unit {
    font-size: 13px;
    font-weight: 500;
    color: rgba(245, 241, 232, 0.55);
    margin-left: 2px;
  }
  .exp-tech .tech-sep {
    font-size: 13px;
    color: rgba(245, 241, 232, 0.32);
    margin: 0 4px;
  }
  .exp-tech .key {
    font-size: 13px;
    font-weight: 700;
    color: #0ec4fc;
  }
  .exp-tech .key-mode {
    font-size: 13px;
    font-weight: 500;
    color: rgba(245, 241, 232, 0.55);
    margin-left: 4px;
  }

  /* Silence% inline in the date subtitle — muted amber so it reads as a
     gentle "heads up" before the curator hits play. */
  .date-subtitle .silence-meta {
    color: rgba(255, 178, 80, 0.78);
    font-weight: 500;
    font-style: italic;
    letter-spacing: 0.01em;
  }

  /* Smaller, pink-toned ORPHAN. Less aggressive than the prior orange. */
  .flag-chip {
    flex: 0 0 auto;
    font-size: 8.5px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 2px 5px;
    border: 1px solid currentColor;
    border-radius: 2px;
    line-height: 1.4;
    background: transparent;
    cursor: pointer;
    transition: color 160ms ease, border-color 160ms ease;
  }
  .flag-chip:hover,
  .flag-chip:focus-visible {
    color: #f5f1e8;
    outline: none;
  }
  .flag-dup { color: rgba(245, 241, 232, 0.55); }
  .flag-orphan { color: #ff5a82; }

  /* Inline dup-group panel rendered next to / below the title row. Renders
     siblings as a tight list with the canonical marked. Never auto-shown —
     opens only when the curator clicks the DUP badge. */
  .dup-detail {
    grid-column: 1;
    margin-top: 6px;
    margin-bottom: -4px;
    font-size: 11px;
    color: rgba(245, 241, 232, 0.78);
    border-left: 2px solid rgba(255, 39, 97, 0.32);
    padding: 4px 0 4px 8px;
    line-height: 1.5;
  }
  .dup-detail ul.dup-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .dup-detail ul.dup-list li { margin: 0; padding: 0; }
  .dup-detail a {
    color: #0ec4fc;
    text-decoration: underline;
    text-decoration-color: rgba(14, 196, 252, 0.4);
    text-underline-offset: 3px;
  }
  .dup-detail a:hover { color: #6ed8ff; }
  .dup-detail b { color: #ff2761; font-weight: 700; }

  /* ── Waveform (the row's visual fingerprint) ──────────────────────── */
  .waveform {
    position: relative;
    height: 48px;
    background: var(--surface-1, #07060c);
    border-radius: 3px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .waveform[data-seekable="true"] { cursor: pointer; }
  .waveform[data-seekable="true"]:hover { box-shadow: inset 0 0 0 1px rgba(14, 196, 252, 0.45); }
  .waveform img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    opacity: 0.92;
  }
  .waveform-placeholder {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(245, 241, 232, 0.32);
  }
  .waveform-playhead {
    position: absolute;
    top: 0; bottom: 0;
    width: 2px;
    left: 0;
    background: #ff3b6e;
    pointer-events: none;
    box-shadow: 0 0 6px rgba(255, 59, 110, 0.6);
    z-index: 2;
  }
  .waveform-time {
    position: absolute;
    bottom: 3px;
    right: 5px;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 10px;
    font-feature-settings: "tnum";
    line-height: 1;
    color: #0e0c14;
    background: rgba(245, 241, 232, 0.78);
    padding: 2px 5px;
    border-radius: 2px;
    pointer-events: none;
    z-index: 2;
  }

  /* J/L/F/T — vertical pillbox that spans the full card-grid height and
     abuts the archive X column on its right. Tiles share horizontal
     dividers (no per-tile borders or gaps) so the column reads as a
     four-compartment medicine container. The right edge is flush + flat
     (no border, no radius) so it visually merges into the X strip;
     only the left edge wears the rounded outer border. */
  .category-bar {
    grid-column: 2;
    align-self: stretch;
    justify-self: stretch;
    margin: -16px 0 -16px 12px;
    display: flex;
    flex-direction: column;
    width: 68px;
    border: 1px solid rgba(245, 241, 232, 0.22);
    border-right: 0;
    border-radius: 5px 0 0 5px;
    overflow: hidden;
    background: rgba(245, 241, 232, 0.025);
  }
  .category-btn {
    flex: 1 1 0;
    width: 100%;
    min-height: 34px;
    font: inherit;
    color: rgba(245, 241, 232, 0.7);
    background: transparent;
    border: 0;
    border-top: 1px solid rgba(245, 241, 232, 0.22);
    border-radius: 0;
    padding: 0 6px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    transition: color 160ms ease, background-color 160ms ease,
                transform 80ms ease;
  }
  .category-btn:first-child { border-top: 0; }
  .category-btn:hover,
  .category-btn:focus-visible {
    color: #f5f1e8;
    background: rgba(245, 241, 232, 0.06);
    outline: none;
  }
  .category-btn:active { transform: translateY(1px); }
  /* The keyboard letter is hidden visually now that the full word fits.
     Screen readers still announce the category via aria-label, and
     keyboard shortcuts continue to work via the global key handler. */
  .category-btn kbd { display: none; }
  .category-btn .category-label {
    display: inline-block;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-style: italic;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1;
    color: inherit;
  }
  /* Active = hot pink-red. Inside the shared-border pillbox, we tint the
     active tile's background + brighten the divider above/below so it
     reads as a "selected pocket" without per-tile chrome. */
  .bucket-card .category-btn.active {
    color: #ff2761;
    background: rgba(255, 39, 97, 0.14);
  }
  .bucket-card .category-btn.active,
  .bucket-card .category-btn.active + .category-btn {
    border-top-color: rgba(255, 39, 97, 0.45);
  }
  .bucket-card .category-btn.active:first-child { border-top: 0; }
  .bucket-card .category-btn.active .category-label { opacity: 1; }

  /* Kudos removed in this revision — leaving the data layer intact
     (engine endpoint, keyboard shortcut, expand-panel star count) so
     the affordance can be re-added later in a more deliberate spot. */

  /* ── Detached trash ✕ ─────────────────────────────────────────────
     Full card-height stripe at the right edge (col 3 of card-grid).
     Inner edges square against the card body; outer right edge inherits
     the card's rounded corner. Quiet red wash so it reads as the
     destructive zone without pulling focus. */
  .trash-hold.detached {
    grid-column: 3;
    align-self: stretch;
    justify-self: stretch;
    width: auto;
    height: auto;
    margin: -16px 0 -16px 0;  /* cancel .card-grid vertical padding */
  }
  .trash-hold {
    position: relative;
    overflow: hidden;
    font: inherit;
    font-size: 16px;
    font-weight: 700;
    line-height: 1;
    color: rgba(245, 241, 232, 0.45);
    background: linear-gradient(180deg,
      rgba(47, 7, 18, 0.38) 0%,
      rgba(47, 7, 18, 0.62) 100%);
    border: 0;
    border-left: 1px solid rgba(255, 39, 97, 0.18);
    border-radius: 0 7px 7px 0;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 160ms ease, background 160ms ease,
                border-left-color 160ms ease, box-shadow 160ms ease;
  }
  /* Orphan-candidate rows: red rim glow on the X column. Static — no
     animation, no extra DOM node. Just a meaningful boundary cue. */
  .trash-hold.is-orphan {
    border-left-color: rgba(255, 39, 97, 0.65);
    box-shadow:
      inset 6px 0 14px -4px rgba(255, 39, 97, 0.30),
      inset 2px 0 0 0 rgba(255, 39, 97, 0.20);
  }
  /* Hover deepens the red. Hold fills the column bottom→top in 0.45s. */
  .trash-hold:hover,
  .trash-hold:focus-visible {
    color: #fff;
    background: linear-gradient(180deg,
      rgba(78, 12, 30, 0.62) 0%,
      rgba(255, 39, 97, 0.28) 100%);
    border-left-color: rgba(255, 39, 97, 0.48);
    outline: none;
  }
  /* Hold-fill rises from the bottom — vertical fill, not horizontal — so
     it reads as the archive column "filling up" toward commit. */
  .trash-hold .hold-fill {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    height: 100%;
    background: linear-gradient(180deg, #ff2761 0%, #ff6e21 100%);
    transform-origin: center bottom;
    transform: scaleY(0);
    transition: none;
    pointer-events: none;
    z-index: 0;
  }
  .trash-hold[data-holding="true"] .hold-fill {
    transform: scaleY(1);
    transition: transform 0.45s linear;
  }
  .trash-hold .hold-glyph {
    position: relative;
    z-index: 1;
    font-weight: 700;
  }
  .trash-hold[data-holding="true"] .hold-glyph { color: #0e0c14; }
  .trash-hold[data-holding="true"] .hold-label { color: #0e0c14; }

  /* Expand chevron CSS removed — the whole date column is now the
     click target for expand. See .date-col above. */

  /* Quality stars now live inside the expanded panel. Larger and more
     tappable than they were in the trail. */
  .quality {
    display: flex;
    gap: 0;
    align-items: center;
  }
  .star {
    font: inherit;
    font-size: 18px;
    color: rgba(245, 241, 232, 0.22);
    background: transparent;
    border: 0;
    padding: 2px 4px;
    cursor: pointer;
    line-height: 1;
    transition: color 160ms ease, transform 80ms ease;
  }
  .star:hover,
  .star:focus-visible {
    color: #ff3b6e;
    outline: none;
    transform: translateY(-1px);
  }
  .star.on { color: #ff3b6e; }

  /* ── Expanded section (full block at the cleanup of this stylesheet) ── */
  @keyframes exp-in {
    from { opacity: 0; transform: translateY(-4px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .exp {
    display: grid;
    grid-template-columns: 92px 1fr;
    gap: 4px 14px;
    margin: 0;
    font-size: 12px;
    line-height: 1.45;
  }
  .exp dt {
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(14, 196, 252, 0.78);
    align-self: center;
  }
  .exp dd {
    margin: 0;
    color: rgba(245, 241, 232, 0.82);
  }
  .exp-sep { color: rgba(245, 241, 232, 0.35); }
  /* Divider between curator metadata and engine-generated content.
     Spans both grid columns so it acts as a section break inside the dl. */
  .exp-divider {
    grid-column: 1 / -1;
    height: 1px;
    background: linear-gradient(90deg,
      rgba(14, 196, 252, 0) 0%,
      rgba(14, 196, 252, 0.24) 50%,
      rgba(14, 196, 252, 0) 100%);
    margin: 6px 0 2px 0;
  }

  .tag-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 6px;
  }
  .tag-list li {
    font-size: 10px;
    font-weight: 500;
    color: rgba(245, 241, 232, 0.66);
    border: 1px solid rgba(245, 241, 232, 0.12);
    border-radius: 2px;
    padding: 2px 6px;
  }

  .lineage-chip {
    font: inherit;
    font-size: 11px;
    color: rgba(245, 241, 232, 0.62);
    background: transparent;
    border: 1px dashed rgba(245, 241, 232, 0.22);
    border-radius: 3px;
    padding: 3px 8px;
    cursor: pointer;
    transition: color 160ms ease, border-color 160ms ease;
  }
  .lineage-chip:hover,
  .lineage-chip:focus-visible {
    color: #0ec4fc;
    border-color: rgba(14, 196, 252, 0.55);
    outline: none;
  }
  .lineage-chip[data-loaded="true"] { border-style: solid; }

  /* Rich inline lineage line — the data is on the row already (engine LEFT
     JOIN), so no fetch needed to render parent name + bucket + duration. */
  .lineage-line {
    display: inline;
    font-size: 12px;
    line-height: 1.5;
  }
  .lineage-from {
    color: rgba(245, 241, 232, 0.5);
    margin-right: 4px;
  }
  .lineage-link {
    color: #0ec4fc;
    text-decoration: underline;
    text-decoration-color: rgba(14, 196, 252, 0.45);
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    transition: color 160ms ease, text-decoration-color 160ms ease;
  }
  a.lineage-link:hover,
  a.lineage-link:focus-visible {
    color: #6ed8ff;
    text-decoration-color: #6ed8ff;
    outline: none;
  }
  .lineage-meta {
    color: rgba(245, 241, 232, 0.5);
  }
  .lineage-more {
    font: inherit;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(245, 241, 232, 0.45);
    background: transparent;
    border: 0;
    border-bottom: 1px dotted rgba(245, 241, 232, 0.28);
    padding: 0 1px;
    margin-left: 10px;
    cursor: pointer;
    transition: color 160ms ease, border-color 160ms ease;
  }
  .lineage-more:hover,
  .lineage-more:focus-visible {
    color: #f5f1e8;
    border-color: #0ec4fc;
    outline: none;
  }

  .lineage-detail {
    margin-top: 6px;
    font-size: 11px;
    color: rgba(245, 241, 232, 0.72);
    border-left: 2px solid rgba(14, 196, 252, 0.24);
    padding: 4px 0 4px 8px;
    line-height: 1.45;
  }
  .lineage-detail b { color: #f5f1e8; font-weight: 600; }

  /* Expanded-panel note for un-transcribed long-form jams. Italic, low-key
     so it reads as supplementary context rather than a header. */
  .exp-note {
    font-size: 11.5px;
    color: rgba(245, 241, 232, 0.62);
    font-style: italic;
    line-height: 1.45;
  }

  /* Combined Tags row — flat strip of chips. PUBLIC stays on the left;
     engine-derived classifications (content_type, source_type) sit in the
     middle as quiet read-only pills; curator tag values follow, each with
     an × to remove; the trailing "+ add" chip opens an inline input. */
  .exp-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 5px 6px;
    align-items: center;
    line-height: 1.2;
  }
  .exp-tags .chip {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font: inherit;
    font-family: "Geist Variable", ui-sans-serif, system-ui, sans-serif;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.04em;
    line-height: 1;
    padding: 4px 8px;
    border-radius: 3px;
    border: 1px solid rgba(245, 241, 232, 0.18);
    background: rgba(245, 241, 232, 0.03);
    color: rgba(245, 241, 232, 0.72);
    cursor: default;
    transition: color 160ms ease, border-color 160ms ease,
                background 160ms ease;
  }
  /* PUBLIC pill — curator-toggleable, leads the row. */
  .exp-tags .chip-public {
    text-transform: uppercase;
    letter-spacing: 0.12em;
    border-style: dashed;
    cursor: pointer;
  }
  .exp-tags .chip-public:hover,
  .exp-tags .chip-public:focus-visible {
    color: #f5f1e8;
    border-color: rgba(245, 241, 232, 0.45);
    outline: none;
  }
  .exp-tags .chip-public.on {
    color: #ff3b6e;
    border-color: rgba(255, 59, 110, 0.55);
    border-style: solid;
    background: rgba(255, 59, 110, 0.08);
  }
  /* Read-only derived chips (content_type, source_type) — quieter than
     tags so the eye knows these aren't editable. */
  .exp-tags .chip-derived {
    color: rgba(14, 196, 252, 0.78);
    border-color: rgba(14, 196, 252, 0.28);
    background: rgba(14, 196, 252, 0.04);
  }
  /* Editable tag values — each with an × button. */
  .exp-tags .chip-tag {
    color: rgba(245, 241, 232, 0.88);
    border-color: rgba(245, 241, 232, 0.28);
    padding-right: 2px;
  }
  .exp-tags .chip-tag:hover { border-color: rgba(245, 241, 232, 0.55); }
  .exp-tags .chip-x {
    font: inherit;
    font-size: 12px;
    line-height: 1;
    color: rgba(245, 241, 232, 0.48);
    background: transparent;
    border: 0;
    padding: 0 4px 0 2px;
    margin-left: 1px;
    cursor: pointer;
    transition: color 120ms ease;
  }
  .exp-tags .chip-x:hover,
  .exp-tags .chip-x:focus-visible {
