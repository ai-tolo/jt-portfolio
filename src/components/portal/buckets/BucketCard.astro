  }
  @keyframes exp-in {
    from { opacity: 0; transform: translateY(-4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* ── Responsive ─────────────────────────────────────────────────────
     On narrow screens, keep the 3-column layout but tighten paddings
     and shrink the medicine-container pill so the row stays single-line. */
  @media (max-width: 640px) {
