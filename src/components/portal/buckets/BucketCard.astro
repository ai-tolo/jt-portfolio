---
import type { BucketAsset, BucketName } from "../../../lib/console-types";

interface Props {
  item: BucketAsset;
  /** Index within the rendered grid — stable tab order for arrow nav. */
  index: number;
}

const { item, index } = Astro.props;

const basename = (p: string): string => p.split("/").pop() ?? p;
const filename = item.filename || basename(item.path);
const title = item.display_name || filename;
const isPublic = item.public === 1;

const fmtDuration = (s: number | null): string | null => {
  if (s == null || !Number.isFinite(s) || s <= 0) return null;
  const m = Math.floor(s / 60);
  const r = Math.round(s % 60);
  return `${m}:${String(r).padStart(2, "0")}`;
};
const durationLabel = fmtDuration(item.duration_seconds);

// Date column: primary = "MMM DD", secondary = "YYYY · Xmo". Falls back to
// filesystem-mtime if engine sent it, else parses a [YYYY-MM-DD] from the
// filename, else hides the column gracefully. Done server-side so the row
// has stable text without a JS Date roundtrip per card.
const MONTHS = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
const dateInfo = (() => {
  let iso: string | null = item.modified ?? null;
  if (!iso) {
    const m = filename.match(/\[(\d{4})-(\d{2})-(\d{2})/);
    if (m) iso = `${m[1]}-${m[2]}-${m[3]}T00:00:00`;
  }
  if (!iso) return null;
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return null;
  const primary = `${MONTHS[d.getMonth()]} ${d.getDate()}`;
  const year = String(d.getFullYear());
  const ageMs = Date.now() - d.getTime();
  const ageDays = ageMs / 86400000;
  let relative: string;
  if (ageDays < 1) relative = "today";
  else if (ageDays < 7) relative = `${Math.floor(ageDays)}d`;
  else if (ageDays < 30) relative = `${Math.floor(ageDays / 7)}w`;
  else if (ageDays < 365) relative = `${Math.floor(ageDays / 30)}mo`;
  else relative = `${Math.floor(ageDays / 365)}y`;
  return { primary, year, relative };
})();

const tagList = (item.tags ?? "")
  .split(",")
  .map((t) => t.trim())
  .filter(Boolean)
  .slice(0, 8);

const BUCKET_LABEL: Record<BucketName, string> = {
  inbox: "Inbox",
  jam: "Jam",
  loops: "Loops",
  field: "Field",
  tracks: "Tracks",
  trash: "Trash",
};
const currentBucket: BucketName = item.bucket ?? "inbox";

const CATEGORIES: { id: BucketName; label: string; kbd: string }[] = [
  { id: "jam", label: "JAM", kbd: "J" },
  { id: "loops", label: "LOOP", kbd: "L" },
  { id: "field", label: "FIELD", kbd: "F" },
  { id: "tracks", label: "TRACK", kbd: "T" },
];

// Split the title at the file extension so the .wav suffix can render
// at a quieter opacity than the main name. Tries common audio extensions
// first; falls back to whatever the last dot suffix is up to 5 chars.
const titleParts = (() => {
  const m = title.match(/^(.*?)(\.[A-Za-z0-9]{1,5})$/);
  return m ? { base: m[1], ext: m[2] } : { base: title, ext: "" };
})();

const lineageWord = (() => {
  if (!item.parent_id) return null;
  switch (item.source_type) {
    case "voice_memo": return "voice-memo";
    case "video_extract": return "video";
    case "jam": return "jam";
    default: return "asset";
  }
})();

const waveformSrc = (() => {
  const wp = item.waveform_path;
  if (!wp) return null;
  const base = wp.split("/").pop() ?? wp;
  const sha1 = base.replace(/\.png$/i, "");
  if (!/^[a-f0-9]{40}$/i.test(sha1)) return null;
  return `/api/console/waveform?sha1=${sha1}`;
})();

const tech: string[] = [];
if (item.bpm) tech.push(`${Math.round(item.bpm)} BPM`);
if (item.key) tech.push(String(item.key));
if (typeof item.project_count === "number" && item.project_count > 0) {
  tech.push(`${item.project_count} ${item.project_count === 1 ? "project" : "projects"}`);
}

// Always true now — rating + (optionally) summary/tags/lineage/promote
// all live in the expanded panel.
const hasExpanded = true;
---

<article
  class="bucket-card"
  tabindex="0"
  data-bucket-card
  data-card-index={String(index)}
  data-asset-id={String(item.asset_id)}
  data-bucket={currentBucket}
  data-quality={String(item.quality_star)}
  data-parent-id={item.parent_id ? String(item.parent_id) : ""}
  data-path={item.path}
  data-filename={filename}
  data-live-loop-path={item.live_loop_path ?? ""}
  data-public={isPublic ? "1" : "0"}
  aria-label={`${title} — ${BUCKET_LABEL[currentBucket]}`}
>
  <div class="card-grid">
    <!-- ── Date spine: expand chevron at left, date stack centered ───── -->
    <div class="date-col" aria-hidden={dateInfo ? undefined : "true"}>
      {hasExpanded && (
        <button
          type="button"
          class="expand-toggle"
          data-action="expand"
          aria-expanded="false"
          aria-label="Show details"
          title="Show details"
        ><span class="chev" aria-hidden="true">›</span></button>
      )}
      <div class="date-stack">
        {dateInfo ? (
          <>
            {/* Month + day: "MAY" upright orange, day italic. */}
            <div class="date-month">
              <span class="date-month-name">{dateInfo.primary.split(" ")[0]}</span>
              {" "}
              <span class="date-day">{dateInfo.primary.split(" ")[1]}</span>
            </div>
            {/* Year: "20" upright cream, "26" italic orange — mixed weights
                make the year read like a typewritten serial. */}
            <div class="date-year">
              <span class="year-prefix">{dateInfo.year.slice(0, 2)}</span><span class="year-suffix">{dateInfo.year.slice(2)}</span>
            </div>
            <div class="date-rel">{dateInfo.relative}</div>
          </>
        ) : (
          <div class="date-month">—</div>
        )}
      </div>
    </div>

    <!-- ── Middle column: head row + wave row ───────────────────────── -->
    <div class="middle-col">
      <div class="head-row">
        <span class="duration" aria-label="Duration">{durationLabel ?? "—:—"}</span>
        <h3 class="title">
          <button
            type="button"
            class="title-edit"
            data-action="rename"
            data-path={item.path}
            title={`Click to rename. Real filename: ${filename}`}
          ><span class="title-base">{titleParts.base}</span>{titleParts.ext && <span class="title-ext">{titleParts.ext}</span>}</button>
        </h3>
        {item.dup_of && (
          <span class="flag-chip flag-dup" title={`Duplicate of asset_id ${item.dup_of}`}>DUP</span>
        )}
        {item.orphan_candidate === 1 && (
          <span class="flag-chip flag-orphan" title="Flagged orphan">ORPHAN</span>
        )}
        <span class:list={["tech-meta", { ghost: !item.bpm && !item.key }]}>
          <span class="bpm-num">{item.bpm ? Math.round(item.bpm) : "—"}</span>
          <span class="bpm-unit">BPM</span>
          <span class="tech-sep">·</span>
          <span class="key">{item.key || "—"}</span>
          {item.key && <span class="key-mode">maj</span>}
        </span>
        <button
          type="button"
          class:list={["kudos", { has: (item.quality_star ?? 0) > 0 }]}
          data-action="kudos"
          data-asset-id={String(item.asset_id)}
          aria-label="Give kudos"
          title="Click to add kudos"
        >
          <span class="kudos-glyph" aria-hidden="true">★</span>
          <span class="kudos-count" data-kudos-count>{item.quality_star ?? 0}</span>
        </button>
      </div>
      <div class="wave-row">
        <div
          class="waveform"
          data-seekable={waveformSrc ? "true" : "false"}
          title={waveformSrc ? "Click to play (click again to seek)" : undefined}
        >
          {waveformSrc ? (
            <img
              src={waveformSrc}
              alt=""
              loading="lazy"
              width="640"
              height="60"
              onerror="this.replaceWith(Object.assign(document.createElement('div'),{className:'waveform-placeholder',textContent:'no waveform yet'}))"
            />
          ) : (
            <div class="waveform-placeholder">no waveform yet</div>
          )}
          <div class="waveform-playhead" data-playhead hidden></div>
          <div class="waveform-time" data-waveform-time hidden></div>
        </div>
        <div class="category-bar" role="group" aria-label="Assign to category">
          {CATEGORIES.map((c) => (
            <button
              type="button"
              class:list={["category-btn", { active: currentBucket === c.id }]}
              data-action="bucket"
              data-bucket={c.id}
              aria-label={`Assign to ${c.label}`}
              title={`Assign to ${c.label} (${c.kbd})`}
            >
              <kbd>{c.kbd}</kbd>
              <span class="category-label">{c.label}</span>
            </button>
          ))}
        </div>
      </div>
      <p class="status" data-status-line aria-live="polite"></p>
    </div>

    <!-- ── Trash column (full card height, slight red hue) ──────────── -->
    <button
      type="button"
      class="trash-hold detached"
      data-action="trash-hold"
      title="Hold 0.9s to archive"
      aria-label="Hold to archive"
    >
      <span class="hold-fill" aria-hidden="true"></span>
      <span class="hold-glyph">✕</span>
      <span class="hold-label" aria-hidden="true">HOLD</span>
    </button>
  </div>

  <!-- ── Expanded section (collapsed by default) ─────────────────────── -->
  {hasExpanded && (
    <div class="expanded" data-expanded hidden>
      <dl class="exp">
        <dt>Visibility</dt>
        <dd>
          <button
            type="button"
            class:list={["pub-toggle", { on: isPublic }]}
            data-action="toggle-public"
            data-path={item.path}
            aria-pressed={isPublic ? "true" : "false"}
            title="Mark public on /sounds"
          >{isPublic ? "● PUBLIC" : "○ PUBLIC"}</button>
        </dd>
        {item.summary && (
          <>
            <dt>Summary</dt>
            <dd>{item.summary}</dd>
          </>
        )}
        {tagList.length > 0 && (
          <>
            <dt>Tags</dt>
            <dd>
              <ul class="tag-list">
                {tagList.map((t) => <li>{t}</li>)}
              </ul>
            </dd>
          </>
        )}
        {(item.source_type || item.content_type) && (
          <>
            <dt>Type</dt>
            <dd>
              {item.content_type && <span>{item.content_type}</span>}
              {item.content_type && item.source_type && <span class="exp-sep"> · </span>}
              {item.source_type && <span>{item.source_type}</span>}
            </dd>
          </>
        )}
        {lineageWord && (
          <>
            <dt>Lineage</dt>
            <dd>
              <button
                type="button"
                class="lineage-chip"
                data-action="lineage"
                data-asset-id={String(item.asset_id)}
                title="Click to fetch parent + children"
              >from {lineageWord}:{item.parent_id}</button>
              <div class="lineage-detail" data-lineage-target hidden></div>
            </dd>
          </>
        )}
        {currentBucket === "loops" && (
          <>
            <dt>Live</dt>
            <dd>
              {item.live_loop_path ? (
                <span class="promoted-badge" title={`In Live's browser: ${item.live_loop_path}`}>✓ In Live</span>
              ) : (
                <button
                  type="button"
                  class="promote-btn"
                  data-action="promote-to-live"
                  data-asset-id={String(item.asset_id)}
                  title="Copy + normalize to _Soundbending/loops/"
                >→ Promote to Live</button>
              )}
            </dd>
          </>
        )}
      </dl>
      <p class="status" data-status-line aria-live="polite"></p>
    </div>
  )}
</article>

<style>
  /* ── Card shell ─────────────────────────────────────────────────────
     The cassette treatment (border + glow) lives in PortalLayout's
     global style. This sheet defines the row's internal layout. Cards
     clip content so the date spine reaches the rounded corner. */
  .bucket-card {
    position: relative;
    padding: 0;
    outline: none;
    transition: border-color 200ms ease, box-shadow 200ms ease;
    overflow: hidden;
  }
  .bucket-card[data-pending="true"] { opacity: 0.5; pointer-events: none; }

  /* ── Two-row grid ──────────────────────────────────────────────────
     Row 1: head-row spans all three columns — duration partitioned from
            title, both anchored top-left. Always the same horizontal
            position so the eye finds runtime + name first.
     Row 2: date column | waveform | actions trail. */
  /* Three-column grid:
       col 1: date spine (full height)
       col 2: middle stack — head row + wave row (with J/L/F/T inline)
       col 3: full-height trash column (slight red tint) */
  .card-grid {
    display: grid;
    grid-template-columns: 112px minmax(0, 1fr) 42px;
    column-gap: 0;
    align-items: stretch;
  }
  .middle-col {
    grid-column: 2;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 12px 0 12px 14px;
    min-width: 0;
  }
  .head-row {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }
  /* Wave row puts the waveform next to the J/L/F/T tiles on the same line. */
  .wave-row {
    display: flex;
    align-items: stretch;
    gap: 10px;
    min-width: 0;
  }

  /* Duration pill — neon-green text in a darker-blue-bordered tape tag.
     Always rendered (falls back to "—:—") so the head row's left edge
     is fixed. The blue border ties it to the title-tag + card perimeter. */
  .duration {
    flex: 0 0 auto;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-style: italic;
    font-size: 13px;
    font-weight: 700;
    color: #00ff4d;
    background: rgba(0, 255, 77, 0.04);
    border: 1px solid rgba(14, 196, 252, 0.55);
    border-radius: 3px;
    padding: 3px 8px;
    font-feature-settings: "tnum";
    line-height: 1;
    text-shadow: 0 0 8px rgba(0, 255, 77, 0.22);
  }
  .title {
    flex: 1 1 auto;
    margin: 0;
    min-width: 0;
    line-height: 1;
  }

  /* ── Date spine ──────────────────────────────────────────────────────
     Full-height burgundy stripe on the left edge of the card. PUBLIC
     toggle sits at the top, date stack centered below. */
  /* Date spine — neutral dark stripe with a cyan rim. Slightly wider
     than before so MAY + 18 sit comfortably on one line. Expand chevron
     anchors the left edge; date stack sits centered to its right. */
  .date-col {
    grid-column: 1;
    align-self: stretch;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 12px 10px 8px;
    background: #1a1a1a;
    border: 1px solid rgba(14, 196, 252, 0.38);
    border-right: 0;
    border-radius: 6px 0 0 6px;
  }
  .date-stack {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 3px;
    min-width: 0;
  }
  /* Month + day on one line. Month name white regular (no bold, no italic);
     day in italic orange. The contrast across one line reads as a stamp. */
  .date-month {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 13px;
    line-height: 1;
    letter-spacing: 0.04em;
  }
  .date-month-name {
    color: #f5f1e8;
    font-weight: 400;
    font-style: normal;
    text-transform: uppercase;
  }
  .date-day {
    color: #ff6e21;
    font-weight: 700;
    font-style: italic;
  }
  /* Year is the visual anchor — "20" upright cream + "26" italic orange. */
  .date-year {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1;
  }
  .date-year .year-prefix {
    color: #f5f1e8;
  }
  .date-year .year-suffix {
    color: #ff6e21;
    font-style: italic;
  }
  .date-rel {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: rgba(245, 241, 232, 0.42);
    line-height: 1;
  }

  /* Smaller, lower-profile PUBLIC at the top of the spine. */
  .pub-toggle {
    flex: 0 0 auto;
    align-self: flex-start;
    font: inherit;
    font-family: "Geist Variable", ui-sans-serif, system-ui, sans-serif;
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(245, 241, 232, 0.48);
    background: transparent;
    border: 1px dashed rgba(245, 241, 232, 0.18);
    border-radius: 2px;
    padding: 2px 5px;
    cursor: pointer;
    transition: color 160ms ease, border-color 160ms ease,
                background 160ms ease;
  }
  .pub-toggle:hover,
  .pub-toggle:focus-visible {
    color: #f5f1e8;
    border-color: rgba(245, 241, 232, 0.45);
    outline: none;
  }
  .pub-toggle.on {
    color: #ff3b6e;
    border-color: rgba(255, 59, 110, 0.55);
    border-style: solid;
  }

  /* ── Main column (col 2, row 2): just the waveform ─────────────────── */
  .main-col {
    grid-column: 2;
    grid-row: 2;
    min-width: 0;
    display: grid;
    gap: 6px;
  }
  /* Title sits in its own darker-blue-bordered tag. Text renders in pale
     orange italic mono — keeps the typewriter-label feel but pulls the
     color back from the loud neon-green so the head row reads as
     hierarchy: green=number, pale-orange=name. */
  .title-edit {
    display: inline-block;
    max-width: 100%;
    font: inherit;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-style: italic;
    font-size: 13px;
    font-weight: 600;
    color: #ffb4a3;
    text-align: left;
    background: transparent;
    border: 1px solid rgba(14, 196, 252, 0.55);
    border-radius: 3px;
    padding: 4px 10px;
    cursor: text;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: border-color 160ms ease, background 160ms ease;
  }
  .title-edit:hover,
  .title-edit:focus-visible {
    border-color: rgba(14, 196, 252, 0.85);
    background: rgba(14, 196, 252, 0.05);
    outline: none;
  }
  .title-base { color: inherit; }
  .title-ext { color: #f5f1e8; opacity: 0.42; font-style: italic; }

  /* BPM/Key module — green-bordered tape-label, italic mono. Numbers in
     vivid green, unit "BPM" dim cream, key + "maj" suffix in green/orange. */
  .tech-meta {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: baseline;
    gap: 4px;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-style: italic;
    font-feature-settings: "tnum";
    color: #00ff4d;
    line-height: 1;
    padding: 4px 10px;
    background: rgba(0, 255, 77, 0.03);
    border: 1px solid rgba(0, 255, 77, 0.42);
    border-radius: 3px;
  }
  .tech-meta .bpm-num {
    font-size: 16px;
    font-weight: 700;
    color: #00ff4d;
    text-shadow: 0 0 6px rgba(0, 255, 77, 0.22);
  }
  .tech-meta .bpm-unit {
    font-size: 11px;
    font-weight: 600;
    color: rgba(245, 241, 232, 0.55);
    margin-left: 1px;
  }
  .tech-meta .tech-sep {
    font-size: 14px;
    color: rgba(245, 241, 232, 0.32);
    margin: 0 4px;
  }
  .tech-meta .key {
    font-size: 15px;
    font-weight: 700;
    color: #00ff4d;
  }
  /* "maj" / "min" suffix in orange italic so the key reads as music. */
  .tech-meta .key-mode {
    font-size: 10px;
    font-weight: 600;
    color: #ff6e21;
    margin-left: 2px;
    letter-spacing: 0.04em;
  }
  .tech-meta.ghost {
    border-style: dashed;
    background: transparent;
    border-color: rgba(245, 241, 232, 0.14);
  }
  .tech-meta.ghost .bpm-num,
  .tech-meta.ghost .key {
    color: rgba(245, 241, 232, 0.22);
    text-shadow: none;
  }
  .tech-meta.ghost .bpm-unit { color: rgba(245, 241, 232, 0.18); }
  .tech-meta.ghost .tech-sep { color: rgba(245, 241, 232, 0.12); }

  /* Smaller, pink-toned ORPHAN. Less aggressive than the prior orange. */
  .flag-chip {
    flex: 0 0 auto;
    font-size: 8.5px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 2px 5px;
    border: 1px solid currentColor;
    border-radius: 2px;
    line-height: 1.4;
  }
  .flag-dup { color: rgba(245, 241, 232, 0.42); }
  .flag-orphan { color: #ff5a82; }

  /* ── Waveform (the row's visual fingerprint) ──────────────────────── */
  .waveform {
    position: relative;
    height: 48px;
    background: var(--surface-1, #07060c);
    border-radius: 3px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .waveform[data-seekable="true"] { cursor: pointer; }
  .waveform[data-seekable="true"]:hover { box-shadow: inset 0 0 0 1px rgba(14, 196, 252, 0.45); }
  .waveform img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    opacity: 0.92;
  }
  .waveform-placeholder {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(245, 241, 232, 0.32);
  }
  .waveform-playhead {
    position: absolute;
    top: 0; bottom: 0;
    width: 2px;
    left: 0;
    background: #ff3b6e;
    pointer-events: none;
    box-shadow: 0 0 6px rgba(255, 59, 110, 0.6);
    z-index: 2;
  }
  .waveform-time {
    position: absolute;
    bottom: 3px;
    right: 5px;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 10px;
    font-feature-settings: "tnum";
    line-height: 1;
    color: #0e0c14;
    background: rgba(245, 241, 232, 0.78);
    padding: 2px 5px;
    border-radius: 2px;
    pointer-events: none;
    z-index: 2;
  }

  /* ── Actions column (J/L/F/T + kudos) ──────────────────────────────
     Spans both grid rows. Tiles stack vertically: bucket bar on top,
     kudos ticker below. */
  .actions-col {
    grid-column: 3;
    grid-row: 1 / 3;
    align-self: stretch;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    justify-content: center;
    gap: 6px;
    padding: 0 14px;
    border-left: 1px solid rgba(245, 241, 232, 0.06);
  }
  /* J/L/F/T tiles now sit inline with the waveform — smaller, denser. */
