---
// Collapsible legend that documents the keyboard-first triage shortcuts.
// Visual only — the actual handlers live in the [bucket].astro page script.
---

<details class="keymap" open>
  <summary>
    <span class="summary-text">Keyboard shortcuts</span>
    <span class="hint">click to toggle</span>
  </summary>
  <ul role="list" class="keys">
    <li><kbd>↑</kbd><kbd>↓</kbd><kbd>←</kbd><kbd>→</kbd><span>Move focus between cards</span></li>
    <li><kbd>Space</kbd><span>Toggle audition on the focused card</span></li>
    <li><kbd>V</kbd><span>Assign focused card to Voice Memos</span></li>
    <li><kbd>L</kbd><span>Assign focused card to Loops</span></li>
    <li><kbd>S</kbd><span>Assign focused card to Songs</span></li>
    <li><kbd>X</kbd><span>Send focused card to Trash</span></li>
    <li><kbd>0</kbd><kbd>1</kbd><kbd>2</kbd><kbd>3</kbd><span>Set quality stars on the focused card</span></li>
    <li><kbd>Enter</kbd><span>Open detail drawer for the focused card</span></li>
    <li><kbd>Esc</kbd><span>Blur the focused card</span></li>
  </ul>
</details>

<style>
  .keymap {
    border: 1px solid var(--line);
    padding: var(--space-2) var(--space-3);
    background: color-mix(in srgb, var(--ink) 4%, transparent);
  }
  .keymap summary {
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    list-style: none;
  }
  .keymap summary::-webkit-details-marker { display: none; }
  .summary-text {
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--text);
  }
  .hint {
    font-size: 10px;
    color: var(--muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .keys {
    list-style: none;
    padding: var(--space-2) 0 0;
    margin: 0;
    display: grid;
    gap: 6px var(--space-4);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
  }
  .keys li {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: var(--fs-small);
    color: var(--text);
  }
  .keys span { color: var(--muted); }
  .keys kbd {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 10px;
    line-height: 1;
    color: var(--text);
    border: 1px solid var(--line);
    padding: 3px 6px;
    background: var(--bg);
  }
</style>
