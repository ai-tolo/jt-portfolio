---
interface Props {
  index: number;
  name: string;
  subtitle: string;
  outcome: string;
  tags: string[];
  slug: string;
  cover?: string | null;
}

const { index, name, subtitle, outcome, tags, slug, cover } = Astro.props;
const num = String(index).padStart(2, "0");
// Deterministic 0-3 variant for per-card padding/offset on the chunk label.
const variant = ((index - 1) % 4 + 4) % 4;
---

<a class="card" href={`/case-studies/${slug}`} aria-label={`Read case study: ${name}`}>
  <div class="cover">
    {cover ? (
      <img src={cover} alt="" loading="lazy" />
    ) : (
      <div class="cover-empty" aria-hidden="true">
        <span>{num}</span>
      </div>
    )}
  </div>

  <div class="meta">
    <span class={`num v${variant}`}>{num} / {name}</span>
    <h3 class="title">{subtitle}</h3>
    <p class="outcome">{outcome}</p>
    <ul class="tags">
      {tags.map((t) => <li>{t}</li>)}
    </ul>
  </div>
</a>

<style>
  .card {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    padding: var(--space-12) 0;
    border-top: 1px solid var(--line);
  }
  .card:hover .title,
  .card:focus-visible .title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 6px;
  }

  .cover {
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }
  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .cover-empty {
    height: 100%;
    display: grid;
    place-items: center;
  }
  .cover-empty span {
    color: var(--line);
    font-size: clamp(4rem, 12vw, 8rem);
    font-weight: var(--fw-bold);
    letter-spacing: var(--ls-display);
    line-height: 1;
  }

  .meta {
    display: grid;
    gap: var(--space-4);
    align-content: start;
  }

  /* Project marker — borrows the hero name chunks' vocabulary at a small
     scale: solid anchor color, inverted text, fit-content width, varied
     padding + tiny horizontal offset per card. Reads like a strip of
     electrical tape labeled in marker, sitting above the project title. */
  .num {
    display: inline-flex;
    align-items: baseline;
    width: fit-content;
    background: var(--ink);
    color: var(--ink-fg);
    font-size: clamp(0.8125rem, 1.05vw, 1rem);
    font-weight: var(--fw-bold);
    letter-spacing: 0.14em;
    line-height: 1;
    text-transform: uppercase;
    transition: background-color 280ms cubic-bezier(0.2, 0, 0, 1),
                color 280ms cubic-bezier(0.2, 0, 0, 1),
                transform 220ms cubic-bezier(0.2, 0, 0, 1);
  }
  .card:hover .num,
  .card:focus-visible .num {
    transform: translateX(2px);
  }
  /* Four uneven silhouettes, recycled per card index (mod 4). Asymmetric
     padding + small horizontal offset gives each marker its own hand-cut
     character without breaking the eyebrow hierarchy. */
  .v0 {
    padding: 0.46em 0.72em 0.26em 0.50em;
  }
  .v1 {
    padding: 0.24em 0.60em 0.42em 0.78em;
    margin-left: 3px;
  }
  .v2 {
    padding: 0.34em 0.50em 0.22em 0.84em;
    margin-left: -2px;
  }
  .v3 {
    padding: 0.18em 0.78em 0.48em 0.38em;
    margin-left: 2px;
  }

  .title {
    font-size: var(--fs-title);
    font-weight: var(--fw-bold);
    letter-spacing: var(--ls-title);
    line-height: var(--lh-title);
    max-width: 28ch;
  }
  .outcome {
    color: var(--muted);
    max-width: 56ch;
    font-size: 1.125rem;
    font-weight: var(--fw-medium);
    line-height: 1.55;
  }
  .tags {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    color: var(--muted);
    font-size: 0.9375rem;
    font-weight: var(--fw-medium);
  }
  .tags li::after {
    content: "·";
    margin-left: var(--space-3);
    color: var(--line);
  }
  .tags li:last-child::after {
    content: "";
    margin-left: 0;
  }

  @media (min-width: 56rem) {
    .card {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      gap: var(--space-16);
      align-items: start;
    }
  }
</style>
