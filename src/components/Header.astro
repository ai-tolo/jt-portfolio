---
const path = Astro.url.pathname;
const isHome = path === "/" || path === "";
const isResume = path === "/resume" || path === "/resume/" || path.startsWith("/resume/");
---

<header class="site-header">
  <div class="inner site-header-inner">
    <a class="mark" href="/" aria-label="Home" aria-current={isHome ? "page" : undefined}>
      <svg
        class="mark-svg"
        width="56"
        height="28"
        viewBox="0 0 84 43"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        <path
          d="M41.692 7.30743L41.692 20.058C41.692 29.3223 34.655 35.0036 23.1957 35.0036C14.2219 35.0036 7.02344 31.13 4.27965 24.7708L10.316 22.9632C12.2851 27.1273 17.1916 29.7097 23.1957 29.7097C30.8137 29.7097 35.4943 26.0298 35.4943 20.058L35.4943 7.30743L41.692 7.30743Z"
          fill="currentColor"
        />
        <path
          d="M79.0212 12.6336L60.3635 12.6336L60.3635 34.0352L54.1658 34.0352L54.1658 12.6336L35.508 12.6336L35.508 7.30743L79.0212 7.30743L79.0212 12.6336Z"
          fill="currentColor"
        />
      </svg>
    </a>
    <nav class="nav" aria-label="Primary">
      <span class="status" title="Available for senior product & UX roles">
        <span class="status-dot" aria-hidden="true"></span>
        <span class="status-label">Available for work</span>
      </span>
      <a class="resume-cta" href="/resume" aria-current={isResume ? "page" : undefined}>
        Resume<span class="arrow" aria-hidden="true"> →</span>
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: saturate(140%) blur(10px);
    -webkit-backdrop-filter: saturate(140%) blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .site-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-3);
    padding-bottom: var(--space-3);
  }

  .mark {
    position: relative;
    display: inline-flex;
    align-items: center;
    line-height: 0;
    color: var(--text);
    opacity: 0.88;
    transition: color 200ms ease, opacity 200ms ease, transform 200ms ease;
  }
  .mark::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -6px;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 280ms cubic-bezier(0.2, 0, 0, 1);
  }
  .mark:hover,
  .mark:focus-visible {
    color: var(--accent);
    opacity: 1;
    transform: translateY(-1px);
  }
  .mark:hover::after,
  .mark:focus-visible::after {
    transform: scaleX(1);
  }
  .mark-svg {
    height: 22px;
    width: auto;
    display: block;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: var(--space-5);
  }

  /* Quiet, persistent availability indicator. */
  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
  }
  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    flex: none;
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 60%, transparent);
    animation: status-pulse 2.6s ease-out infinite;
  }
  @keyframes status-pulse {
    0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 55%, transparent); }
    70% { box-shadow: 0 0 0 6px color-mix(in srgb, var(--accent) 0%, transparent); }
    100% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 0%, transparent); }
  }
  @media (prefers-reduced-motion: reduce) {
    .status-dot { animation: none; }
  }
  @media (max-width: 40rem) {
    .status-label { display: none; }
  }

  .resume-cta {
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--accent);
    border: 1px solid var(--accent);
    padding: 8px 14px;
    text-decoration: none;
    transition: background-color 200ms ease, color 200ms ease;
  }
  .resume-cta:hover,
  .resume-cta:focus-visible {
    background: var(--accent);
    color: var(--bg);
  }
  .resume-cta[aria-current="page"] {
    background: var(--accent);
    color: var(--bg);
  }
  .arrow {
    display: inline-block;
    margin-left: 2px;
    transition: transform 200ms ease;
  }
  .resume-cta:hover .arrow,
  .resume-cta:focus-visible .arrow {
    transform: translateX(2px);
  }

  @media (max-width: 28rem) {
    .resume-cta {
      padding: 7px 10px;
    }
    .nav {
      gap: var(--space-3);
    }
  }
</style>
