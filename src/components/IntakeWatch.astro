---
// src/components/IntakeWatch.astro
// Usage: <IntakeWatch /> or <IntakeWatch time="0:07" accent="#FF6B4A" glow="#FFB454" class="my-hero" />
// Needs: public/intake/watch-blank.png (transparent-screen watch photo) and the Outfit font
// loaded once in your layout: <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;500&display=swap" rel="stylesheet">
interface Props {
  time?: string;
  accent?: string;
  glow?: string;
  class?: string;
}
const { time = '0:07', accent = '#FF6B4A', glow = '#FFB454', class: cls = '' } = Astro.props;
const style = `--accent:${accent};--glow:${glow}`;
---
<figure class:list={["intake-watch", cls]} style={style} role="img" aria-label="Apple Watch showing the Intake recording screen: waveform, elapsed time and a stop button">
  <div class="screen" aria-hidden="true">
    <div class="label">INTAKE</div>
    <div class="wave">
      <i style="height:2.53cqw;--m:16%;animation-duration:1.1s;animation-delay:0.0s"></i>
      <i style="height:4.43cqw;--m:22%;animation-duration:1.28s;animation-delay:-0.22s"></i>
      <i style="height:6.96cqw;--m:28%;animation-duration:1.46s;animation-delay:-0.44s"></i>
      <i style="height:11.39cqw;--m:35%;animation-duration:1.19s;animation-delay:-0.66s"></i>
      <i style="height:16.46cqw;--m:42%;animation-duration:1.37s;animation-delay:-0.88s"></i>
      <i style="height:22.15cqw;--m:48%;animation-duration:1.1s;animation-delay:-1.1s"></i>
      <i style="height:27.85cqw;--m:54%;animation-duration:1.28s;animation-delay:-0.11s"></i>
      <i style="height:32.91cqw;--m:61%;animation-duration:1.46s;animation-delay:-0.33s"></i>
      <i style="height:30.38cqw;--m:68%;animation-duration:1.19s;animation-delay:-0.55s"></i>
      <i style="height:22.78cqw;--m:74%;animation-duration:1.37s;animation-delay:-0.77s"></i>
      <i style="height:18.35cqw;--m:80%;animation-duration:1.1s;animation-delay:-0.99s"></i>
      <i style="height:25.32cqw;--m:87%;animation-duration:1.28s;animation-delay:0.0s"></i>
      <i style="height:35.44cqw;--m:94%;animation-duration:1.46s;animation-delay:-0.22s"></i>
      <i style="height:29.11cqw;--m:100%;animation-duration:1.19s;animation-delay:-0.44s"></i>
      <i style="height:20.89cqw;--m:94%;animation-duration:1.37s;animation-delay:-0.66s"></i>
      <i style="height:13.92cqw;--m:87%;animation-duration:1.1s;animation-delay:-0.88s"></i>
      <i style="height:18.99cqw;--m:80%;animation-duration:1.28s;animation-delay:-1.1s"></i>
      <i style="height:26.58cqw;--m:74%;animation-duration:1.46s;animation-delay:-0.11s"></i>
      <i style="height:31.65cqw;--m:68%;animation-duration:1.19s;animation-delay:-0.33s"></i>
      <i style="height:24.05cqw;--m:61%;animation-duration:1.37s;animation-delay:-0.55s"></i>
      <i style="height:15.82cqw;--m:54%;animation-duration:1.1s;animation-delay:-0.77s"></i>
      <i style="height:10.76cqw;--m:48%;animation-duration:1.28s;animation-delay:-0.99s"></i>
      <i style="height:7.59cqw;--m:42%;animation-duration:1.46s;animation-delay:0.0s"></i>
      <i style="height:5.06cqw;--m:35%;animation-duration:1.19s;animation-delay:-0.22s"></i>
      <i style="height:3.16cqw;--m:28%;animation-duration:1.37s;animation-delay:-0.44s"></i>
      <i style="height:2.53cqw;--m:22%;animation-duration:1.1s;animation-delay:-0.66s"></i>
      <i style="height:1.90cqw;--m:16%;animation-duration:1.28s;animation-delay:-0.88s"></i>
    </div>
    <div class="time">{time}</div>
    <button type="button" class="stop" tabindex="-1"><span></span></button>
  </div>
  <img src="/intake/watch-blank.png" alt="" width="521" height="781" loading="lazy" decoding="async" />
</figure>

<style>
.intake-watch {
  --accent: #FF6B4A;
  --glow: #FFB454;
  position: relative;
  width: 100%;
  max-width: 521px;
  aspect-ratio: 521 / 781;
  margin: 0;
  container-type: inline-size;
  font-family: 'Outfit', 'Avenir Next', 'Segoe UI', sans-serif;
  color: #F2F0EA;
}
.intake-watch > img {
  position: absolute; inset: 0; width: 100%; height: 100%;
  z-index: 2; pointer-events: none; user-select: none;
}
.intake-watch .screen {
  position: absolute;
  left: 20.35cqw; top: 40.88cqw; width: 60.65cqw; height: 69.87cqw;
  border-radius: 11.13cqw;
  background:
    radial-gradient(ellipse 70% 42% at 50% 38%, color-mix(in oklab, var(--accent) 12%, transparent), transparent 70%),
    #000;
  overflow: hidden; z-index: 1;
  container-type: inline-size;
}
.intake-watch .label {
  position: absolute; left: 0; top: 6.96cqw; width: 100%;
  text-align: center; font-size: 3.48cqw; font-weight: 500; letter-spacing: 0.24em;
  color: var(--accent);
}
.intake-watch .wave {
  position: absolute; left: 7.91cqw; top: 24.68cqw; width: 84.18cqw; height: 39.24cqw;
  display: flex; align-items: center; justify-content: center; gap: 1.27cqw;
}
.intake-watch .wave i {
  display: block; width: 1.90cqw; border-radius: 0.95cqw;
  background: color-mix(in oklab, var(--accent) var(--m), var(--glow));
  transform-origin: 50% 50%;
  animation: intake-bar 1.1s ease-in-out infinite;
}
.intake-watch .time {
  position: absolute; left: 0; top: 67.72cqw; width: 100%;
  text-align: center; font-size: 8.86cqw; font-weight: 300; letter-spacing: 0.02em; line-height: 1;
  font-variant-numeric: tabular-nums;
}
.intake-watch .stop {
  position: absolute; left: 39.87cqw; top: 87.97cqw; width: 20.25cqw; height: 20.25cqw;
  box-sizing: border-box; padding: 0; margin: 0;
  border: 0.79cqw solid color-mix(in oklab, var(--accent) 45%, transparent);
  border-radius: 50%; background: transparent; cursor: pointer;
  display: flex; align-items: center; justify-content: center;
}
.intake-watch .stop span {
  display: block; width: 8.23cqw; height: 8.23cqw; border-radius: 2.22cqw;
  background: var(--accent);
}
@keyframes intake-bar {
  0%, 100% { transform: scaleY(.5); }
  50% { transform: scaleY(1); }
}
@media (prefers-reduced-motion: reduce) {
  .intake-watch .wave i { animation: none; }
}
</style>
