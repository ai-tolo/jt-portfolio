---
/**
 * ArchiveHero — the second "work" room object.
 * A photographed phone (public/archive/phone-blank.png, screen cut to alpha)
 * with a live screen drawn in CSS. At rest: the stock Voice Memos list.
 * A tap replays a real run: library → typed search → results → moment → kept.
 *
 * Everything on screen and on the rail is rendered at build time from
 * src/data/archive-run.json. No counts are invented: a recordings count
 * of 0 is simply not shown.
 *
 * Stage classes s1…s6 are added cumulatively to the <section> as the run
 * advances (s3 means s1, s2 and s3 are all present). data-stage holds the
 * current number. Removing them all returns the phone to rest.
 */
import run from '../data/archive-run.json';

interface Props {
  /** Render the headline and story paragraph inside the hero. Default true. */
  story?: boolean;
}
const { story = true } = Astro.props;

const { library, rest, query, results, moment } = run;

const toSeconds = (clock: string | number): number => {
  if (typeof clock === 'number') return clock;
  return String(clock)
    .split(':')
    .map(Number)
    .reduce((acc, v) => acc * 60 + v, 0);
};
const fmtClock = (sec: number): string => {
  const m = Math.floor(sec / 60);
  const s = Math.floor(sec % 60);
  return `${m}:${String(s).padStart(2, '0')}`;
};
const fmtLen = (sec: number): string =>
  sec >= 60 ? fmtClock(sec) : `${Number(sec.toFixed(1))}s`;

const recordingsCount = Number(library.recordings) || 0;
const countLabel = recordingsCount ? `${recordingsCount.toLocaleString('en-US')} recordings` : '';

const momentSeconds = toSeconds(moment.duration);
const [trimStart, trimEnd] = moment.trim;
const trimLen = Math.max(0, trimEnd - trimStart);

// The waveform shows `window` (seconds, optional). Without it, peaks span the whole recording.
const m: Record<string, any> = moment;
const win: [number, number] =
  Array.isArray(m.window) && m.window.length === 2 ? [Number(m.window[0]), Number(m.window[1])] : [0, momentSeconds];
const [winA, winB] = win;
const winLen = Math.max(0.001, winB - winA);
const clamp = (v: number) => Math.min(100, Math.max(0, v));
const pctIn = (sec: number) => clamp(((sec - winA) / winLen) * 100);
const trimA = pctIn(trimStart);
const trimB = pctIn(trimEnd);
const zoomed = winLen < momentSeconds - 0.5; // show the scope strip only when the window is a slice
const scopeA = momentSeconds ? clamp((winA / momentSeconds) * 100) : 0;
const scopeB = momentSeconds ? clamp((winB / momentSeconds) * 100) : 100;

const peaks: number[] = Array.isArray(moment.peaks) ? moment.peaks : [];
const bars = peaks.map((p, i) => {
  const t = winA + ((i + 0.5) / peaks.length) * winLen;
  const h = Math.max(2, Math.min(96, p * 96));
  return { y: 50 - h / 2, h, inTrim: t >= trimStart && t <= trimEnd };
});
const waveWidth = Math.max(1, peaks.length) * 3;

/** Split a transcript line around the first occurrence of the query. */
const splitLine = (line: string): [string, string, string] => {
  const i = line.toLowerCase().indexOf(query.toLowerCase());
  if (i < 0 || !query) return [line, '', ''];
  return [line.slice(0, i), line.slice(i, i + query.length), line.slice(i + query.length)];
};
const momentParts = splitLine((m.said as string) || moment.line);
const assigned: { by: string; what: string }[] = Array.isArray(m.assigned) ? (m.assigned as { by: string; what: string }[]) : [];
// THE HOME SCREEN (2026-09-30): the recorder is left, the library is an app
// among apps. Tiles are colour only; `dex` is the one that opens.
// 2026-09-30 (Jon): the other apps distract — two tiles only: the recorder
// we just left, and the one that opens.
const HOME_APPS: { k: string; n: string }[] = [
  { k: 'vm', n: 'Voice Memos' }, { k: 'dex', n: 'AudioDex' }, // one word, A and D capitalised: a riff on Pokédex (Jon, 2026-09-30)
];
const chars = Array.from(query);
// THE HAND (2026-09-30, Jon: touch points): the word is typed key by key on a
// keyboard that rises for it — a slip and two backspaces if the JSON says so
const keystrokes: string[] = Array.isArray(m.keystrokes) ? (m.keystrokes as string[]) : (Array.isArray((run as any).keystrokes) ? ((run as any).keystrokes as string[]) : chars);
const KB_ROWS = ['qwertyuiop', 'asdfghjkl', 'zxcvbnm'];
const hasClip = Boolean(moment.src);
// the room's words may sit in the module's own columns (2026-09-24): a `head`
// slot above the phone, a `cap` slot under the rail
const hasHead = Astro.slots.has('head');
const hasCap = Astro.slots.has('cap');
// the moment's second half (2026-09-24): where the word lands in the whole
// recording, what the library heard, what a kept moment can become
const hits: { clock: string; pct: number }[] = (Array.isArray(moment.hits) ? (moment.hits as number[]) : []).map((t) => ({
  clock: fmtClock(t),
  pct: momentSeconds ? clamp((t / momentSeconds) * 100) : 0,
}));
const detected: string[] = Array.isArray(moment.detected) ? (moment.detected as string[]) : [];
---

<section
  class:list={['archive-hero', { 'no-story': !story, 'has-head': hasHead }]}
  data-archive-hero
  data-stage="0"
  data-query={query}
  data-count={results.length}
  data-title={moment.title}
  data-trim={`${fmtClock(trimStart)} to ${fmtClock(trimEnd)}`}
  data-kept={fmtLen(trimLen)}
  data-clip={hasClip ? '1' : ''}
  data-keystrokes={JSON.stringify(keystrokes)}
>
  <div class="grid">
    {hasHead && <div class="hook"><slot name="head" /></div>}
    {story && (
      <div class="story">
        <p class="kicker">
          <span>Archive</span>
          <span class="mono">{library.years}{countLabel ? ` · ${countLabel}` : ''}</span>
        </p>
        <h2 class="headline">Years of my life, trapped in files named ‘New Recording.’</h2>
        <p class="lede">
          I document with sound. Audio is how I remember. Recordings pile up as “New Recording 47” with a
          timestamp and a duration and nothing else, technically saved, practically gone. So I built the
          library I wished existed: every recording read and named by what’s actually inside it, transcripts
          I can search the way people search photos, waveforms I can see, touch, trim, keep. The quote, the
          laugh, the idea from three summers ago: seconds away now.
        </p>
      </div>
    )}

    <div class="stage">
      <div class="phone">
        <i class="shadow" aria-hidden="true"></i>

        <div class="screen" aria-hidden="true">
          <!-- AT REST: the stock list, as boring as it is -->
          <div class="face face-rest">
            <div class="vm-top"><span>Edit</span></div>
            <p class="vm-title">Voice Memos</p>{/* the stock app says "All Recordings"; the name says where we are (Jon, 2026-09-30) */}
            <div class="vm-search">
              <svg viewBox="0 0 20 20" class="ico"><circle cx="8.5" cy="8.5" r="5.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M13 13l4.5 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
              <span>Search</span>
            </div>
            <ul class="vm-list">
              {rest.map((r) => (
                <li class="vm-row">
                  <span class="vm-name">{r.name}</span>
                  <span class="vm-meta"><span>{r.date}</span><span class="mono">{r.duration}</span></span>
                </li>
              ))}
            </ul>
            <p class="vm-count">{recordingsCount ? `${recordingsCount.toLocaleString('en-US')} Recordings` : ''}</p>
            <div class="vm-bar"><span class="vm-rec"></span></div>
          </div>

          <!-- THE HOME SCREEN: leave the recorder; the library is an app among apps -->
          <div class="face face-home">
            <div class="hs-grid">
              {HOME_APPS.map((a) => (
                <div class:list={['hs-app', `hs-${a.k}`]}>
                  <i class="hs-ico">
                    {a.k === 'vm' && <svg viewBox="0 0 40 40" class="hs-g"><g fill="#fff"><rect x="7" y="17" width="3" height="6" rx="1.5"/><rect x="12" y="12" width="3" height="16" rx="1.5"/><rect x="17" y="8" width="3" height="24" rx="1.5"/><rect x="22" y="14" width="3" height="12" rx="1.5"/><rect x="27" y="10" width="3" height="20" rx="1.5"/><rect x="32" y="16" width="3" height="8" rx="1.5"/></g></svg>}
                    {a.k === 'dex' && <svg viewBox="0 0 40 40" class="hs-g"><g fill="url(#dexg)"><rect x="6" y="19" width="2.6" height="4" rx="1.3"/><rect x="10.4" y="14" width="2.6" height="14" rx="1.3"/><rect x="14.8" y="9" width="2.6" height="24" rx="1.3"/><rect x="19.2" y="16" width="2.6" height="10" rx="1.3"/><rect x="23.6" y="6" width="2.6" height="30" rx="1.3"/><rect x="28" y="12" width="2.6" height="18" rx="1.3"/><rect x="32.4" y="17" width="2.6" height="8" rx="1.3"/></g><defs><linearGradient id="dexg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#ffd27a"/><stop offset="1" stop-color="#f0a13a"/></linearGradient></defs></svg>}
                  </i>
                  <span>{a.n}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- THE RUN: the library -->
          <div class="face face-lib">
            <div class="lib-top">
              <span class="lib-name">Library</span>
              <span class="lib-meta mono">{library.years}{countLabel ? ` · ${countLabel}` : ''}</span>
            </div>
            <div class="lib-search">
              <svg viewBox="0 0 20 20" class="ico"><circle cx="8.5" cy="8.5" r="5.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M13 13l4.5 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
              <span class="q" data-query>
                {chars.map((c, i) => <span class="ch" style={`--i:${i}`}>{c}</span>)}
              </span>
              <span class="caret"></span>
              <span class="q-ph">Search transcripts</span>
            </div>

            <div class="kb" aria-hidden="true">
              {KB_ROWS.map((row, r) => (
                <div class:list={['kb-row', `kb-r${r}`]}>
                  {r === 2 && <span class="kb-key kb-fn">⇧</span>}
                  {Array.from(row).map((k) => <span class="kb-key" data-k={k}>{k}</span>)}
                  {r === 2 && <span class="kb-key kb-fn kb-bs" data-k="⌫">⌫</span>}
                </div>
              ))}
              <div class="kb-row kb-r3">
                <span class="kb-key kb-fn kb-num">123</span>
                <span class="kb-key kb-space" data-k=" ">space</span>
                <span class="kb-key kb-go" data-k="search">search</span>
              </div>
            </div>
            <div class="lib-body">
              <p class="lib-count">{results.length} {results.length === 1 ? 'match' : 'matches'} in transcripts</p>
              <ul class="lib-results">
                {results.map((r, i) => {
                  const [pre, hit, post] = splitLine(r.line);
                  return (
                    <li class:list={['res', { 'res-first': i === 0 }]} style={`--i:${i}`}>
                      <span class="res-title">{r.title}</span>
                      <span class="res-meta"><span>{r.date}</span><span class="mono">{r.duration}</span></span>
                      <span class="res-line">{pre}{hit && <mark>{hit}</mark>}{post}</span>
                    </li>
                  );
                })}
              </ul>

              <div class="moment">
                <div class="m-head">
                  <span class="m-title">{moment.title}</span>
                  <span class="m-meta"><span>{moment.date}</span><span class="mono">{moment.duration}</span></span>
                </div>
                {zoomed && (
                  <div class="scope" style={`--sa:${scopeA}%; --sb:${scopeB}%`}>
                    <i class="track"><b></b></i>
                    <span class="mono">{moment.duration}</span>
                  </div>
                )}
                <div class="ticks mono"><span>{fmtClock(winA)}</span><span>{fmtClock(winB)}</span></div>
                <div class="wave" style={`--a:${trimA}%; --b:${trimB}%`}>
                  <svg viewBox={`0 0 ${waveWidth} 100`} preserveAspectRatio="none">
                    {bars.map((b, i) => (
                      <rect x={i * 3} y={b.y} width="2" height={b.h} class={b.inTrim ? 'in' : undefined} style={`--i:${i}`} />
                    ))}
                  </svg>
                  <span class="trim"><i class="h h-a"></i><i class="h h-b"></i></span>
                  <span class="trim-time mono">{fmtClock(trimStart)} – {fmtClock(trimEnd)}</span>
                </div>
                <p class="m-line">{momentParts[0]}{momentParts[1] && <mark>{momentParts[1]}</mark>}{momentParts[2]}</p>
                <div class="m-actions">
                  <span class="kept">
                    <svg viewBox="0 0 20 20" class="ico"><path d="M10 17s-6.5-4.1-6.5-8.6A3.6 3.6 0 0 1 10 6.3a3.6 3.6 0 0 1 6.5 2.1C16.5 12.9 10 17 10 17z" fill="currentColor"/></svg>
                    Kept
                  </span>
                  <button
                    class="play"
                    type="button"
                    data-play
                    data-start={trimStart}
                    data-end={trimEnd}
                    aria-label={hasClip ? 'Play the kept moment' : 'No clip attached'}
                    aria-disabled={hasClip ? undefined : 'true'}
                    tabindex={hasClip ? undefined : -1}
                  >
                    <span class="play-ico">
                      <svg viewBox="0 0 20 20" class="i-play"><path d="M6 3.5v13l10-6.5z" fill="currentColor"/></svg>
                      <svg viewBox="0 0 20 20" class="i-pause"><path d="M5 4h3.5v12H5zM11.5 4H15v12h-3.5z" fill="currentColor"/></svg>
                    </span>
                    <span class="mono">{fmtLen(trimLen)}</span>
                  </button>
                </div>
                {(hits.length > 0 || detected.length > 0) && (
                  <div class="m-more">
                    {hits.length > 0 && (
                      <div class="m-hits" style="--i:0">
                        <div class="m-hits-head mono"><span>“{query}”</span><span>{hits.length} in this recording</span></div>
                        <div class="m-hits-bar"><b style={`--sa:${scopeA}%; --sb:${scopeB}%`}></b>{hits.map((h) => <i style={`left:${h.pct}%`}></i>)}</div>
                        <div class="m-hits-times mono">{hits.map((h) => <span>{h.clock}</span>)}</div>
                      </div>
                    )}
                    {detected.length > 0 && <ul class="m-tags mono" style="--i:1">{detected.map((d) => <li>{d}</li>)}</ul>}
                    {assigned.length > 0 && (
                      <dl class="m-assigned" style="--i:2">
                        {assigned.map((a) => <div class="m-as"><dt class="mono">{a.by}</dt><dd>{a.what}</dd></div>)}
                      </dl>
                    )}
                    <div class="m-tools" style="--i:3" aria-hidden="true">
                      <span class="tool"><svg viewBox="0 0 20 20" class="ico"><circle cx="6" cy="6" r="2.5" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="6" cy="14" r="2.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M8.2 7.6L17 15M8.2 12.4L17 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>Trim</span>
                      <span class="tool"><svg viewBox="0 0 20 20" class="ico"><path d="M3 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>Send to Studio</span>
                      <span class="tool"><svg viewBox="0 0 20 20" class="ico"><path d="M10 12V3M6.5 6.5L10 3l3.5 3.5M4 11v5h12v-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>Share</span>
                    </div>
                  </div>
                )}
              </div>
            </div>
          </div>
        </div>

        <img class="body" src="/archive/phone-blank.png" alt="" width="864" height="1760" decoding="async" loading="lazy" draggable="false" />

        <button class="tap" type="button" data-tap aria-label={`Tap the list: search the library for “${query}”`}></button>
        {/* after the run: three views of it, before · the search · the moment (Jon, 2026-09-24) */}
        <div class="views" data-views role="group" aria-label="Views of the run">
          <button type="button" class="vdot" data-view="rest" aria-label="Before: the recorder" aria-pressed="false"></button>
          <button type="button" class="vdot" data-view="home" aria-label="The home screen" aria-pressed="false"></button>
          <button type="button" class="vdot" data-view="list" aria-label="The search and its results" aria-pressed="false"></button>
          <button type="button" class="vdot" data-view="moment" aria-label="The kept moment" aria-pressed="false"></button>
        </div>

        {hasClip && <audio preload="metadata" src={moment.src}></audio>}
      </div>
      <div class="foot">
        <p class="hint" aria-hidden="true">tap the list</p>
        <button type="button" class="replay" data-replay aria-label="Replay the run">
          <svg viewBox="0 0 20 20" class="ico" aria-hidden="true"><path d="M4 10a6 6 0 1 0 1.8-4.3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M4 3v3.5h3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Replay
        </button>
      </div>
    </div>

    <div class="col">
    <ol class="rail" aria-label="The run, step by step">
      <li class="step step-search">
        <span class="label">search</span>
        <span class="val">“{query}”</span>
      </li>
      <li class="step step-results">
        <span class="label">results</span>
        <span class="val">{results.length} {results.length === 1 ? 'recording' : 'recordings'}, named by what’s inside</span>
        {results[0] && <span class="sub">first: {results[0].title}</span>}
      </li>
      <li class="step step-moment">
        <span class="label">moment</span>
        <span class="val">{moment.title}</span>
        <span class="sub">{moment.date} · <span class="mono">{moment.duration}</span></span>
      </li>
      <li class="step step-kept">
        <span class="label">kept</span>
        <span class="val">{fmtLen(trimLen)}, <span class="mono">{fmtClock(trimStart)}–{fmtClock(trimEnd)}</span></span>
        {hasClip && <span class="sub">play it on the phone</span>}
      </li>
    </ol>
      {hasCap && <div class="cap"><slot name="cap" /></div>}
    </div>
  </div>

  <p class="sr" role="status" aria-live="polite" data-status></p>
</section>

<style>
  /* ---------- tokens (remap to the site's if it has them) ---------- */
  .archive-hero {
    --ink: #141210;
    --ground: #e9e8e5;
    --accent: var(--archive-accent, #b9701a);
    /* the screen's rim: intense bright blue to purple, the watch's ring's pair (Jon, 2026-09-22) */
    --ring-a: var(--archive-ring-a, #47B6FF); --ring-b: var(--archive-ring-b, #8A5CF6);
    --char: 300ms; /* per-character typing delay; mirrored in the script */

    --oled: #000;
    --sfg: #f5f5f7;
    --sdim: #98989e;
    --sline: rgba(255, 255, 255, 0.14);
    --sfield: #1c1c1e;
    --sacc: #f2b25b;
    --rec: #ff453a;

    --sans: 'Instrument Sans', system-ui, sans-serif;
    --mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
    --display: 'Outfit', var(--sans);

    container-type: inline-size;
    container-name: hero;
    color: var(--ink);
    font-family: var(--sans);
  }
  :global(html[data-night]) .archive-hero {
    --ink: #e8ecf4;
    --ground: #0b0e14;
    --accent: var(--archive-accent-night, #f0b35c);
  }

  .mono { font-family: var(--mono); font-variant-numeric: tabular-nums; }
  .sr {
    position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }
  .ico { width: 1em; height: 1em; flex: none; }

  /* ---------- layout ---------- */
  /* the same grid as the Intake (presentation pass, 2026-09-21): the object
     column (44cqw) on the left axis, the words on the right axis, one 6cqw
     gutter; 48px rows when stacked. With the story off (the room frames it)
     the rail sits at the top, level with the phone, as the Intake's run does */
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 44cqw) minmax(0, 1fr);
    grid-template-rows: auto 1fr;
    grid-template-areas: 'phone story' 'phone col';
    column-gap: 6cqw;
    row-gap: 48px;
    align-items: start;
  }
  /* without the story (the room frames it) the phone takes the LEFT column —
     the watch's 44cqw — and the rail the right, one gutter less half a dot so
     the dot's CENTRE lands on 50cqw, the module's centre line, where the
     watch's nodes land. One arrangement for both objects (Jon's mockup,
     2026-09-24): the hook top-left, the object under it, the run beside both
     from the top, the caption at the run's foot. */
  .no-story .grid {
    grid-template-columns: minmax(0, 44cqw) minmax(0, 1fr);
    column-gap: calc(6cqw - 5px);
    grid-template-rows: auto;
    grid-template-areas: 'phone col';
  }
  .no-story.has-head .grid {
    grid-template-rows: auto 1fr;
    grid-template-areas: 'hook .' 'phone col';
    row-gap: 44px; /* the title → the phone, as the watch's */
  }
  /* the rail (with its caption) centred on the PHONE'S BODY (Jon, 2026-09-24):
     the stage is the phone plus its hint beneath, so the column carries the
     hint's height as padding to centre on the phone alone */
  .no-story.has-head .col { align-self: center; padding-bottom: calc(16px + 0.6875rem * 1.5); }
  .hook { grid-area: hook; min-width: 0; }
  .col { grid-area: col; align-self: end; display: flex; flex-direction: column; gap: 24px; min-width: 0; }
  .no-story .col { align-self: start; }
  .cap { min-width: 0; margin-top: 32px; } /* the rail → the caption: 56px in all, as the watch's */
  .no-story .stage { justify-self: start; }
  .story { grid-area: story; }
  .stage {
    grid-area: phone;
    /* the phone at 38cqw of the module, its hint centred beneath it */
    display: flex; flex-direction: column; gap: 16px;
    width: 38cqw; max-width: 100%;
  }

  /* ---------- story ---------- */
  .kicker {
    display: flex; flex-wrap: wrap; gap: 0.4em 1.2em; margin: 0 0 1rem;
    font: 500 0.72rem/1 var(--mono); letter-spacing: 0.14em; text-transform: uppercase;
    color: color-mix(in oklab, var(--ink) 62%, transparent);
  }
  .headline {
    margin: 0 0 1rem;
    font: 500 clamp(1.65rem, 3.4cqw, 2.6rem) / 1.08 var(--display);
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  .lede {
    margin: 0; max-width: 36em;
    font-size: clamp(0.98rem, 1.3cqw, 1.08rem); line-height: 1.55;
    color: color-mix(in oklab, var(--ink) 84%, transparent);
    text-wrap: pretty;
  }

  /* ---------- phone ---------- */
  .phone {
    position: relative;
    width: 100%;
    aspect-ratio: 864 / 1760;
    container-type: inline-size;
    container-name: phone;
    -webkit-tap-highlight-color: transparent;
  }
  .shadow {
    position: absolute; inset: 0.6% 1.2%; z-index: 0;
    border-radius: 16.2% / 7.95%;
    box-shadow: 0 2.2cqw 5cqw rgba(20, 16, 10, 0.26), 0 0.6cqw 1.4cqw rgba(20, 16, 10, 0.16);
  }
  :global(html[data-night]) .archive-hero .shadow {
    box-shadow: 0 2.6cqw 6cqw rgba(0, 0, 0, 0.7), 0 0.6cqw 1.4cqw rgba(0, 0, 0, 0.5);
  }
  .screen {
    position: absolute; z-index: 1;
    left: 4.745%; top: 1.875%; width: 90.51%; height: 96.25%;
    border-radius: 13.8% / 6.38%;
    background: var(--oled);
    color: var(--sfg);
    overflow: hidden;
    -webkit-font-smoothing: antialiased;
  }
  .body {
    position: absolute; inset: 0; z-index: 2;
    width: 100%; height: 100%;
    pointer-events: none; user-select: none;
  }
  .tap {
    position: absolute; z-index: 3;
    left: 4.745%; top: 1.875%; width: 90.51%; height: 96.25%;
    margin: 0; padding: 0; border: 0; background: transparent;
    border-radius: 13.8% / 6.38%;
    color: var(--sfg);
    font: 500 3.5cqw/1 var(--sans);
    cursor: pointer;
  }
  .tap:focus-visible { outline: 0.7cqw solid var(--sacc); outline-offset: -0.7cqw; }
  /* THE TOUCH SIGNAL — one vocabulary with the Intake's watch (2026-09-22):
     the phone is the button. ::after is the rim itself — the blue→purple
     gradient under a rim-shaped mask — and ::before its light, blue from the
     top-left, purple from the bottom-right, thrown inward onto the screen (the
     watch's ring throws the same light outward onto its face). Both breathe
     together: 2s ease-in-out, 0.45↔1; full and still under the pointer; out
     once the run starts; still at 0.75 under reduced motion. The keyframe is
     an EXACT COPY of the watch's (touch-breathe in IntakeHero.astro): change
     both or neither. */
  .tap::before, .tap::after {
    content: ''; position: absolute; inset: 0; border-radius: inherit; pointer-events: none;
    animation: touch-breathe 2s ease-in-out infinite;
    transition: opacity 0.35s;
  }
  .tap::after {
    box-sizing: border-box; padding: 0.7cqw;
    background: linear-gradient(135deg, var(--ring-a), var(--ring-b));
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    mask-composite: exclude;
  }
  .tap::before {
    box-shadow: inset 2.5cqw 2.5cqw 6cqw color-mix(in oklab, var(--ring-a) 55%, transparent),
                inset -2.5cqw -2.5cqw 6cqw color-mix(in oklab, var(--ring-b) 55%, transparent);
  }
  .tap:hover::before, .tap:hover::after { animation: none; opacity: 1; }
  .s1 .tap::before, .s1 .tap::after { animation: none; opacity: 0; }
  /* the touch signal's breath (Jon, 2026-09-22: the ping read aggressive and
     slow): two seconds, never fully out, never blazing — an EXACT COPY of the
     watch's (IntakeHero.astro) */
  @keyframes touch-breathe { 0%, 100% { opacity: 0.45; } 50% { opacity: 1; } }
  /* once pressed the tap is gone — the replay lives under the phone */
  .s1 .tap { pointer-events: none; cursor: default; visibility: hidden; }
  /* THE VIEWS (Jon, 2026-09-24): after the run, three bubbles at the foot of
     the screen — before · the search · the moment — so the whole thing can
     be taken in again at the reader's own pace. They arrive last of all,
     after the caption has settled. */
  .views {
    position: absolute; z-index: 3; left: 50%; bottom: 5.2%;
    transform: translateX(-50%);
    display: flex; gap: 0.4cqw; padding: 0.8cqw 1.4cqw;
    border-radius: 999px; background: rgba(255, 255, 255, 0.1);
    opacity: 0; pointer-events: none;
    transition: opacity 0.4s;
  }
  .s6 .views { opacity: 1; pointer-events: auto; transition: opacity 0.6s 2.6s; }
  .vdot {
    width: 6cqw; height: 6cqw; padding: 0; border: 0; background: transparent;
    border-radius: 50%; display: grid; place-items: center; cursor: pointer;
  }
  .vdot::before {
    content: ''; width: 2cqw; height: 2cqw; border-radius: 50%;
    background: rgba(255, 255, 255, 0.34);
    transition: background 0.3s, transform 0.3s;
  }
  .vdot[aria-pressed='true']::before { background: #ECE9E2; transform: scale(1.3); }
  .vdot:hover::before { background: rgba(255, 255, 255, 0.6); }
  .vdot:focus-visible { outline: 0.6cqw solid #ECE9E2; outline-offset: 0.2cqw; }
  .archive-hero[data-view='rest'] .face-lib { opacity: 0; }
  .archive-hero[data-view='rest'] .face-rest { opacity: 1; }
  .archive-hero[data-view='list'] .lib-results { opacity: 1; }
  .archive-hero[data-view='list'] .lib-count { opacity: 1; }
  .archive-hero[data-view='list'] .moment { opacity: 0; pointer-events: none; }
  /* the foot under the phone: the hint at rest, the replay after the run,
     one slot so nothing below moves */
  .foot { display: grid; min-height: 30px; align-items: start; justify-items: center; }
  .foot > * { grid-area: 1 / 1; }
  .replay {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 8px 14px; border: 0; border-radius: 999px;
    background: var(--ink); color: var(--ground);
    font: 500 0.72rem/1 var(--mono); letter-spacing: 0.04em;
    cursor: pointer; opacity: 0; pointer-events: none;
    transition: opacity 0.4s, background 120ms, color 560ms ease;
  }
  .replay .ico { width: 1.1em; height: 1.1em; }
  .replay:hover { background: color-mix(in oklab, var(--ink) 82%, var(--ground)); }
  .replay:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
  .s6 .replay { opacity: 1; pointer-events: auto; transition: opacity 0.6s 2.6s, background 120ms, color 560ms ease; }

  .hint {
    margin: 0; text-align: center;
    font: 500 0.6875rem/1.5 var(--mono); letter-spacing: 0.12em;
    color: color-mix(in oklab, var(--ink) 55%, transparent);
    transition: opacity 0.3s;
  }
  .s1 .hint { opacity: 0; }

  /* ---------- faces ---------- */
  .face {
    position: absolute; inset: 0;
    display: flex; flex-direction: column;
    padding: 13cqw 5.4cqw 0;
    font-size: 3.9cqw; line-height: 1.25;
  }
  .face-lib { opacity: 0; transition: opacity 0.45s; }
  .s1 .face-lib { opacity: 1; }
  .face-rest { transition: opacity 0.45s; }
  .s1 .face-rest { opacity: 0; }
  .rewind .face-lib { opacity: 0 !important; }
  .rewind .face-rest { opacity: 1 !important; }

  /* THE HOME SCREEN (2026-09-30): the recorder is left first, then the
     library opens as an app — the same file, in the view that was built.
     The library face grows out of the AudioDex tile (--ax/--ay = its centre). */
  .face-home {
    opacity: 0; transition: opacity 0.45s;
    background: linear-gradient(165deg, #1c1f2e 0%, #0d0e14 55%, #090909 100%);
  }
  .home .face-home { opacity: 1; }
  .home .face-rest { opacity: 0; }
  .s1 .face-home { opacity: 0; transition: opacity 0.5s 0.3s; }
  .rewind .face-home { opacity: 0 !important; }
  .archive-hero[data-view='home'] .face-home { opacity: 1; }
  .archive-hero[data-view='home'] .face-lib, .archive-hero[data-view='home'] .face-rest { opacity: 0; }
  .archive-hero[data-view='rest'] .face-home { opacity: 0; }
  .home .tap::before, .home .tap::after { animation: none; opacity: 0; }
  .home .tap { pointer-events: none; cursor: default; visibility: hidden; }
  .home .hint { opacity: 0; }
  .face-lib { transform: scale(0.18); transform-origin: var(--ax, 39%) var(--ay, 10.5%); }
  .s1 .face-lib { transform: none; transition: opacity 0.4s, transform 0.85s cubic-bezier(0.2, 0.8, 0.2, 1); }
  .hs-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 4.6cqw 2cqw; padding: 0 1cqw; }
  .hs-app { display: flex; flex-direction: column; align-items: center; gap: 1.5cqw; font-size: 2.7cqw; line-height: 1.1; color: #fff; text-align: center; white-space: nowrap; }
  .hs-ico {
    display: block; width: 14.6cqw; height: 14.6cqw; border-radius: 3.6cqw; position: relative; overflow: hidden;
    background: var(--tile, #3a3a3c); box-shadow: inset 0 0 0 0.25cqw rgba(255, 255, 255, 0.06);
  }
  .hs-ico::before { content: ''; position: absolute; inset: 0; background: radial-gradient(120% 90% at 30% 12%, rgba(255, 255, 255, 0.26), transparent 62%); }
  .hs-g { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hs-vm .hs-ico { --tile: #1c1c1e; }
  .hs-dex .hs-ico { --tile: #000; box-shadow: inset 0 0 0 0.45cqw color-mix(in oklab, var(--sacc) 70%, transparent), 0 0 4cqw color-mix(in oklab, var(--sacc) 35%, transparent); }
  .hs-dex .hs-ico::before { background: radial-gradient(90% 70% at 70% 90%, color-mix(in oklab, var(--sacc) 32%, transparent), transparent 70%); }
  .hs-dex span { color: var(--sacc); font-weight: 600; }
  /* the touch, then the press: a fingertip lands on the tile, the tile dips, the app opens */
  .hs-dex .hs-ico::after {
    content: ''; position: absolute; inset: 22%; border-radius: 50%;
    background: rgba(255, 255, 255, 0.6); opacity: 0; transform: scale(0.5);
  }
  .home .hs-dex .hs-ico::after { animation: hs-touch 0.9s ease 1.1s both; }
  .home .hs-dex .hs-ico { animation: hs-press 0.55s ease 1.55s both; }
  @keyframes hs-touch { 0% { opacity: 0; transform: scale(0.5); } 35% { opacity: 0.75; transform: scale(1); } 100% { opacity: 0; transform: scale(1.25); } }
  @keyframes hs-press { 0% { transform: none; filter: none; } 45% { transform: scale(0.88); filter: brightness(1.35); } 100% { transform: none; filter: none; } }

  /* Voice Memos, deadpan */
  .vm-top { display: flex; justify-content: flex-end; color: var(--rec); font-size: 3.9cqw; margin-bottom: 1.2cqw; }
  .vm-title { margin: 0 0 3cqw; font-size: 7.6cqw; font-weight: 700; letter-spacing: -0.02em; line-height: 1.1; }
  .vm-search {
    display: flex; align-items: center; gap: 1.6cqw;
    padding: 1.9cqw 2.6cqw; border-radius: 2.4cqw;
    background: var(--sfield); color: var(--sdim);
    margin-bottom: 1.6cqw;
    transition: background 120ms;
  }
  /* the object presses itself (the host's first settle, 2026-09-22): the
     search field takes iOS's pressed grey, as a finger on it would */
  [data-ghost] .vm-search { background: #3a3a3c; }
  .vm-list { list-style: none; margin: 0; padding: 0; }
  .vm-row { display: grid; gap: 0.9cqw; padding: 2.7cqw 0; border-bottom: 1px solid var(--sline); }
  .vm-name { font-weight: 500; }
  .vm-meta { display: flex; justify-content: space-between; font-size: 3.3cqw; color: var(--sdim); }
  .vm-count { margin: auto 0 0; padding: 3cqw 0; text-align: center; font-size: 3.2cqw; color: var(--sdim); min-height: 3.2cqw; }
  .vm-bar {
    margin: 0 -5.4cqw; padding: 3.2cqw 0 6.5cqw;
    background: var(--sfield);
    display: flex; justify-content: center;
  }
  .vm-rec {
    width: 13cqw; height: 13cqw; border-radius: 50%;
    background: var(--rec);
    box-shadow: 0 0 0 1cqw var(--sfield), 0 0 0 1.6cqw #f5f5f7;
  }

  /* the library */
  .lib-top { display: flex; justify-content: space-between; align-items: baseline; gap: 2cqw; margin-bottom: 2.6cqw; }
  .lib-name { font-size: 5.4cqw; font-weight: 600; letter-spacing: -0.01em; }
  .lib-meta { font-size: 2.8cqw; font-weight: 500; letter-spacing: 0.04em; color: var(--sdim); }
  .lib-search {
    display: flex; align-items: center; gap: 1.6cqw;
    min-height: 8.4cqw; padding: 1.9cqw 2.6cqw; border-radius: 2.4cqw;
    background: var(--sfield); color: var(--sfg);
  }
  .lib-search .ico { color: var(--sdim); }
  .q { display: inline-flex; white-space: pre; }
  .ch { display: inline-block; max-width: 0; opacity: 0; }
  .ch.on { max-width: 1.6em; opacity: 1; } /* the script types (2026-09-30) */
  /* THE KEYBOARD: rises for the search, each key lit as it is pressed, down when the results land */
  .kb {
    position: absolute; left: 0; right: 0; bottom: 0; z-index: 2;
    padding: 2.2cqw 1cqw 9cqw; background: #1c1c1e;
    transform: translateY(100%); transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
    font-size: 4.6cqw; line-height: 1; color: var(--sfg);
  }
  .s2:not(.s3) .kb { transform: none; }
  .kb-row { display: flex; justify-content: center; gap: 1.4cqw; margin-bottom: 2.4cqw; }
  .kb-r3 { margin-bottom: 0; }
  .kb-key {
    display: grid; place-items: center; flex: 0 0 auto;
    width: 7.9cqw; height: 10cqw; border-radius: 1.4cqw;
    background: #4a4a4c; box-shadow: 0 0.3cqw 0 rgba(0, 0, 0, 0.45);
    transition: background 90ms, transform 90ms;
  }
  .kb-fn { width: 11.2cqw; background: #2c2c2e; font-size: 3.6cqw; }
  .kb-space { width: 44cqw; font-size: 3.6cqw; }
  .kb-go { width: 22cqw; background: #0a84ff; font-size: 3.6cqw; }
  .kb-key.hit { background: #8e8e93; transform: translateY(-0.5cqw); }
  .kb-go.hit { background: #4ea6ff; }
  /* THE FINGER on the result before it opens */
  .res-first { position: relative; }
  .res-first::after {
    content: ''; position: absolute; left: 50%; top: 50%; width: 9cqw; height: 9cqw; margin: -4.5cqw 0 0 -4.5cqw;
    border-radius: 50%; background: rgba(255, 255, 255, 0.6); opacity: 0; transform: scale(0.5); pointer-events: none;
  }
  .pick .res-first::after { animation: hs-touch 0.8s ease both; }
  .pick .res-first { background: rgba(255, 255, 255, 0.07); border-radius: 2cqw; transition: background 0.2s 0.3s; }
  .s4 .res-first::after { animation: none; opacity: 0; }
  .caret { display: none; width: 0.11em; height: 1.05em; margin-left: 0.08em; background: var(--sacc); }
  .s2 .caret { display: block; animation: blink 1s steps(1, end) infinite; }
  .s3 .caret { display: none; }
  .q-ph { color: var(--sdim); }
  .s2 .q-ph { display: none; }
  @keyframes blink { 50% { opacity: 0; } }

  .lib-body { position: relative; flex: 1; min-height: 0; }
  .lib-count { position: absolute; top: 0; left: 0; margin: 0; padding-top: 2.6cqw; font-size: 3cqw; color: var(--sdim); opacity: 0; }
  .s3 .lib-count { opacity: 1; transition: opacity 0.3s; }
  .s4 .lib-count { opacity: 0; }
  .lib-results { position: absolute; inset: 7.4cqw 0 0; list-style: none; margin: 0; padding: 0; }
  .s4 .lib-results { opacity: 0; transition: opacity 0.3s; }
  .res {
    display: grid; gap: 1cqw; padding: 2.9cqw 0;
    border-bottom: 1px solid var(--sline);
    opacity: 0; transform: translateY(2cqw);
  }
  .s3 .res {
    opacity: 1; transform: none;
    transition: opacity 0.4s calc(var(--i) * 110ms), transform 0.55s cubic-bezier(0.2, 0.8, 0.2, 1) calc(var(--i) * 110ms);
  }
  .res-title { font-weight: 600; }
  .res-meta, .m-meta { display: flex; gap: 1.6cqw; font-size: 3.1cqw; color: var(--sdim); }
  .res-line { font-size: 3.4cqw; line-height: 1.35; color: #c7c7cc; }
  .res-line::before, .m-line::before { content: '“'; }
  .res-line::after, .m-line::after { content: '”'; }
  mark { background: transparent; color: var(--sacc); font-weight: 600; }

  .moment {
    position: absolute; inset: 0;
    display: flex; flex-direction: column; gap: 2.2cqw;
    padding: 1.6cqw 0 14cqw;
    opacity: 0; transform: translateY(3cqw); pointer-events: none;
  }
  .s4 .moment {
    opacity: 1; transform: none; pointer-events: auto;
    transition: opacity 0.45s 0.25s, transform 0.55s 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .m-head { display: grid; gap: 1cqw; }
  .m-title { font-size: 4.3cqw; font-weight: 600; line-height: 1.2; }
  .scope { display: flex; align-items: center; gap: 2.4cqw; margin: 2.2cqw 0 0; opacity: 0; }
  .scope .track { position: relative; flex: 1; height: 0.7cqw; border-radius: 1cqw; background: rgba(255, 255, 255, 0.12); }
  .scope b { position: absolute; top: -0.5cqw; bottom: -0.5cqw; left: var(--sa); width: calc(var(--sb) - var(--sa)); border-radius: 1cqw; background: var(--sdim); }
  .scope span { font-size: 2.5cqw; color: var(--sdim); }
  .s4 .scope { opacity: 1; transition: opacity 0.3s 0.55s; }
  .ticks { display: flex; justify-content: space-between; margin-top: 3.4cqw; font-size: 2.5cqw; color: var(--sdim); opacity: 0; }
  .s4 .ticks { opacity: 1; transition: opacity 0.3s 0.45s; }
  .wave { position: relative; height: 22cqw; margin: 1.2cqw 0 5cqw; }
  .wave svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; color: #6e6e73; }
  .wave rect { fill: currentColor; transform-box: fill-box; transform-origin: center; transform: scaleY(0.08); }
  .wave rect.in { fill: var(--sacc); }
  .s4 .wave rect { transform: none; transition: transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1) calc(var(--i) * 7ms); }
  .trim {
    position: absolute; top: -1.2cqw; bottom: -1.2cqw;
    left: var(--a); width: calc(var(--b) - var(--a));
    background: color-mix(in oklab, var(--sacc) 14%, transparent);
    border-inline: 0.5cqw solid var(--sacc); border-radius: 0.8cqw;
    opacity: 0;
  }
  .trim .h { position: absolute; top: 50%; width: 1.6cqw; height: 5cqw; border-radius: 1cqw; background: var(--sacc); transform: translateY(-50%); }
  .trim .h-a { left: -1.05cqw; }
  .trim .h-b { right: -1.05cqw; }
  .s4 .trim { opacity: 1; transition: opacity 0.35s 0.65s; }
  .trim-time {
    position: absolute; top: 100%; left: clamp(0%, var(--a), 72%);
    margin-top: 1.8cqw; font-size: 2.7cqw; font-weight: 500; color: var(--sacc); white-space: nowrap;
    opacity: 0;
  }
  .s4 .trim-time { opacity: 1; transition: opacity 0.35s 0.8s; }
  .m-line {
    margin: 0; padding: 2.4cqw 2.8cqw; border-radius: 2cqw;
    background: #141416; font-size: 3.8cqw; line-height: 1.4;
  }
  .m-line mark { background: color-mix(in oklab, var(--sacc) 28%, transparent); border-radius: 0.6cqw; padding: 0 0.4cqw; }

  .m-actions { display: flex; align-items: center; gap: 2.4cqw; margin-top: 1.2cqw; }
  .kept {
    display: inline-flex; align-items: center; gap: 1.2cqw;
    padding: 1.7cqw 2.9cqw; border-radius: 999px;
    border: 0.4cqw solid var(--sacc); color: var(--sacc);
    font-size: 3.2cqw; font-weight: 600; line-height: 1;
    opacity: 0; transform: translateY(1.2cqw);
  }
  .s5 .kept { opacity: 1; transform: none; transition: opacity 0.5s, transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1); }
  .play {
    display: inline-flex; align-items: center; gap: 1.8cqw; margin-left: auto;
    padding: 0; border: 0; background: transparent; color: var(--sfg);
    font-size: 3.1cqw; font-weight: 500; line-height: 1; cursor: pointer;
    opacity: 0; border-radius: 999px;
  }
  .play:focus-visible { outline: 0.6cqw solid var(--sacc); outline-offset: 0.6cqw; }
  .play-ico { display: grid; place-items: center; width: 9cqw; height: 9cqw; border-radius: 50%; background: var(--sfg); color: #000; }
  .play-ico svg { width: 50%; height: 50%; }
  .play .i-pause { display: none; }
  .play.is-playing .i-play { display: none; }
  .play.is-playing .i-pause { display: block; }
  .play .i-play { margin-left: 8%; }
  .s5 .play { opacity: 1; transition: opacity 0.35s 0.55s; }
  .s5 .play[aria-disabled='true'] { opacity: 0.32; cursor: default; }
  /* the moment's second half (Jon, 2026-09-24: the end frame should feel like
     more product): where the word lands across the whole recording, what the
     library heard in it, and what a kept moment can become. Arrives with the
     kept step, one beat per block. */
  .m-more {
    display: flex; flex-direction: column; gap: 3cqw;
    margin-top: 3.2cqw; padding-top: 3.2cqw;
    border-top: 1px solid var(--sline);
  }
  .m-more > * { opacity: 0; transform: translateY(1.4cqw); }
  .s6 .m-more > * {
    opacity: 1; transform: none;
    transition: opacity 0.7s calc(0.4s + var(--i) * 360ms), transform 0.8s calc(0.4s + var(--i) * 360ms) cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .m-hits { display: grid; gap: 1.8cqw; }
  .m-hits-head { display: flex; justify-content: space-between; font-size: 2.7cqw; letter-spacing: 0.04em; color: var(--sdim); }
  .m-hits-head span:first-child { color: var(--sacc); font-weight: 600; }
  .m-hits-bar { position: relative; height: 1.2cqw; margin: 1cqw 0; border-radius: 1cqw; background: rgba(255, 255, 255, 0.12); }
  .m-hits-bar b { position: absolute; top: 0; bottom: 0; left: var(--sa); width: calc(var(--sb) - var(--sa)); border-radius: 1cqw; background: rgba(255, 255, 255, 0.18); }
  .m-hits-bar i {
    position: absolute; top: -1.3cqw; bottom: -1.3cqw; width: 1cqw; margin-left: -0.5cqw;
    border-radius: 1cqw; background: var(--sacc);
    box-shadow: 0 0 1.8cqw color-mix(in oklab, var(--sacc) 75%, transparent);
  }
  .m-hits-times { display: flex; gap: 2cqw; font-size: 2.6cqw; color: var(--sacc); }
  .m-hits-times span + span::before { content: '·'; margin-right: 2cqw; color: var(--sdim); }
  .m-tags { display: flex; flex-wrap: wrap; gap: 1.6cqw; list-style: none; margin: 0; padding: 0; }
  .m-tags li { padding: 1.3cqw 2.3cqw; border-radius: 999px; border: 1px solid var(--sline); font-size: 2.6cqw; letter-spacing: 0.03em; color: #c7c7cc; white-space: nowrap; }
  /* what the system wrote onto the file, and which tool wrote it (2026-09-30) */
  .m-assigned { margin: 0; display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 1.3cqw 3cqw; font-size: 3cqw; line-height: 1.3; }
  .m-as { display: contents; }
  .m-as dt { color: var(--sacc); font-size: 2.5cqw; letter-spacing: 0.08em; text-transform: uppercase; padding-top: 0.35cqw; }
  .m-as dd { margin: 0; color: #c7c7cc; }
  .m-tools { display: flex; flex-wrap: wrap; gap: 1.8cqw; }
  .tool {
    display: inline-flex; align-items: center; gap: 1.3cqw;
    padding: 2cqw 2.7cqw; border-radius: 2.2cqw;
    background: var(--sfield); color: var(--sfg);
    font-size: 2.9cqw; font-weight: 500; line-height: 1; white-space: nowrap;
  }
  .tool .ico { width: 1.05em; height: 1.05em; color: var(--sdim); }

  /* ---------- rail ---------- */
  .rail {
    position: relative; list-style: none; margin: 0; padding: 8px 0 0;
    display: grid; row-gap: 24px;
  }
  /* the line: one segment per step, from its dot to the next (the Intake's
     rows draw the same); the last fades out */
  .step::after {
    content: ''; position: absolute; left: 4.5px; top: 16px; bottom: -24px; width: 1px;
    background: color-mix(in oklab, var(--ink) 16%, transparent);
    transform-origin: top; transition: transform 0.55s ease-out;
  }
  .step:last-child::after { bottom: 0; background: linear-gradient(to bottom, color-mix(in oklab, var(--ink) 16%, transparent), transparent); }
  /* THE DOTS' SEQUENCE (Jon, 2026-09-24, one choreography with the watch's
     run): at rest the grey layout stands where the run will end; the tap
     clears it; then each dot pops in its turn and draws the line to the next */
  .s1 .step::before { opacity: 0; transform: scale(0.5); }
  .s1 .step::after { transform: scaleY(0); transition: none; }
  .s2 .step-search::before, .s3 .step-results::before, .s4 .step-moment::before, .s5 .step-kept::before { opacity: 1; transform: none; }
  .s2 .step-search::after, .s3 .step-results::after, .s4 .step-moment::after, .s5 .step-kept::after { transform: none; transition: transform 0.55s ease-out 0.6s; }
  /* a step = a 10px dot on the line at the left, its text 32px in (the Intake's run draws the same) */
  .step {
    position: relative; display: grid; row-gap: 4px; padding-left: 32px;
    opacity: 0.42; transition: opacity 0.4s;
  }
  .step::before {
    content: ''; position: absolute; left: 0; top: 3px;
    width: 10px; height: 10px; border-radius: 50%;
    box-sizing: border-box; border: 1.5px solid currentColor; background: var(--ground);
    transition: background 0.3s, border-color 0.3s, box-shadow 0.3s, opacity 0.3s, transform 0.35s cubic-bezier(0.2, 0.9, 0.3, 1.4);
  }
  .label {
    font: 500 0.6875rem/1.5 var(--mono); letter-spacing: 0.12em;
    color: color-mix(in oklab, var(--ink) 66%, transparent);
  }
  .val { font-size: 1rem; line-height: 1.5; }
  .sub { font-size: 0.875rem; line-height: 1.5; color: color-mix(in oklab, var(--ink) 66%, transparent); }
  /* at rest the rail shows only its dots (Jon, 2026-09-22): a step's words arrive with its dot */
  .step > * { opacity: 0; transition: opacity 0.4s; }
  .s2 .step-search, .s3 .step-results, .s4 .step-moment, .s5 .step-kept { opacity: 1; }
  .s2 .step-search > *, .s3 .step-results > *, .s4 .step-moment > *, .s5 .step-kept > * { opacity: 1; }
  .s2 .step-search::before, .s3 .step-results::before, .s4 .step-moment::before, .s5 .step-kept::before {
    background: var(--accent); border-color: var(--accent);
  }
  .s2:not(.s3) .step-search::before, .s3:not(.s4) .step-results::before,
  .s4:not(.s5) .step-moment::before, .s5 .step-kept::before {
    box-shadow: 0 0 0 4px color-mix(in oklab, var(--accent) 22%, transparent);
  }

  /* ---------- one column under 820px of container width ---------- */
  @container hero (width < 820px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto;
      grid-template-areas: 'story' 'phone' 'col';
      row-gap: 48px;
    }
    .no-story .grid { grid-template-columns: minmax(0, 1fr); grid-template-areas: 'phone' 'col'; }
    .no-story.has-head .grid { grid-template-rows: auto; grid-template-areas: 'hook' 'phone' 'col'; row-gap: 48px; }
    .no-story.has-head .col { align-self: start; padding-bottom: 0; }
    .no-story.has-head .hook { margin-bottom: -4px; }
    /* the phone fills ~80% of the module, centred */
    .stage { width: 80cqw; margin-inline: auto; }
    .col { align-self: start; }
  }

  /* ---------- reduced motion: no typing, no travel, short fades ---------- */
  @media (prefers-reduced-motion: reduce) {
    .face-lib, .face-rest, .s4 .lib-results { transition-duration: 0.2s; }
    .kb { transition: none; }
    .pick .res-first::after { animation: none; }
    .s2 .caret { animation: none; }
    .res, .moment, .kept, .m-more > * { transform: none; }
    .face-lib, .s1 .face-lib { transform: none; transition: opacity 0.2s; }
    .face-home { transition-duration: 0.2s; }
    .home .hs-dex .hs-ico { animation: none; }
    .s3 .res, .s4 .moment, .s5 .kept, .s6 .m-more > * { transition: opacity 0.2s; }
    .wave rect { transform: none; }
    .s4 .wave rect { transition: none; }
    .s4 .trim, .s4 .trim-time, .s4 .ticks, .s4 .scope, .s5 .play { transition: opacity 0.2s; }
    .s6 .views, .s6 .replay { transition: opacity 0.2s 0.6s; }
    .hint, .step, .step::before, .step > * { transition: none; }
    .tap::before, .tap::after { animation: none; opacity: 0.75; }
  }
</style>

<script>
  /* Drives every [data-archive-hero] on the page. Plain JS, no framework. */
  const STAGES = ['s1', 's2', 's3', 's4', 's5', 's6'];
  const CHAR_MS = 300; // keep equal to --char in the styles
  const HOME_MS = 2700; // the home screen's dwell: a fingertip at 1.1s (hs-touch), the press at 1.55s (hs-press), then the app opens

  // Offsets (ms) at which each stage class is added.
  function schedule(typing, reduced) {
    // THE PACE (Jon, 2026-09-24): each step gets room to be taken in
    // THE PACE (Jon, 2026-09-30: too quick to follow): one thing at a time,
    // each left on screen long enough to be read
    const t1 = reduced ? 700 : HOME_MS; // the home screen first, then the app opens
    const t2 = t1 + (reduced ? 450 : 1500); // the empty library, its search field
    const t3 = t2 + (reduced ? 0 : typing) + (reduced ? 500 : 1300); // typed (key by key), then the results
    const t4 = t3 + (reduced ? 900 : 3600); // the results read, then one opens
    const t5 = t4 + (reduced ? 900 : 3000); // the moment, then kept
    const t6 = t5 + (reduced ? 900 : 2400); // then what the system assigned
    return [t1, t2, t3, t4, t5, t6];
  }

  function init(root) {
    if (root.dataset.ready) return;
    root.dataset.ready = '1';

    const tap = root.querySelector('[data-tap]');
    const status = root.querySelector('[data-status]');
    const play = root.querySelector('[data-play]');
    const audio = root.querySelector('audio');
    if (!tap) return;
    const replay = root.querySelector('[data-replay]');
    const views = Array.from(root.querySelectorAll('[data-views] [data-view]'));
    const setView = (v) => {
      if (v) root.dataset.view = v; else delete root.dataset.view;
      views.forEach((b) => b.setAttribute('aria-pressed', b.dataset.view === v ? 'true' : 'false'));
    };
    views.forEach((b) => b.addEventListener('click', () => { if (root.classList.contains('s6')) setView(b.dataset.view); }));

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    // THE HAND (2026-09-30): the word is typed stroke by stroke on the keyboard,
    // letters CHAR_MS apart, backspaces quicker, no pause at the slip (Jon)
    const q = root.querySelector('[data-query]');
    const finalText = Array.from(q ? q.querySelectorAll('.ch') : []).map((el) => el.textContent).join('');
    let strokes = [];
    try { strokes = JSON.parse(root.dataset.keystrokes || '[]'); } catch (e) { strokes = []; }
    if (!Array.isArray(strokes) || !strokes.length) strokes = Array.from(finalText);
    const keys = new Map();
    root.querySelectorAll('.kb-key[data-k]').forEach((k) => keys.set(k.dataset.k, k));
    const strokeTimes = (() => {
      const out = []; let t = 0;
      for (let i = 0; i < strokes.length; i++) {
        const bs = strokes[i] === '⌫';
        out.push(t);
        t += bs ? 200 : CHAR_MS;
      }
      return out;
    })();
    const typingMs = strokeTimes.length ? strokeTimes[strokeTimes.length - 1] + CHAR_MS : 0;
    // spans the script makes must carry the component's scope attribute, or
    // the scoped styles (.ch, .ch.on) never reach them
    const cid = q ? Array.from(q.attributes).map((a) => a.name).find((n) => n.startsWith('data-astro-cid-')) : null;
    const setQuery = (text) => {
      if (!q) return;
      q.innerHTML = '';
      Array.from(text).forEach((c) => {
        const el = document.createElement('span');
        el.className = 'ch on';
        if (cid) el.setAttribute(cid, '');
        el.textContent = c;
        q.appendChild(el);
      });
    };
    const d = root.dataset;
    const messages = {
      home: 'Home screen. Opening AudioDex.',
      1: 'AudioDex open.',
      3: `${d.count} ${d.count === '1' ? 'recording' : 'recordings'} found for “${d.query}”, named by what’s inside.`,
      4: `Opened “${d.title}”. Trim marked, ${d.trim}.`,
      5: `Moment kept, ${d.kept}.${d.clip ? ' Play is available.' : ''}`,
      6: 'Run complete. Tap to replay.',
    };

    let timers = [];
    let running = false;
    let playing = false;

    const say = (msg) => {
      if (!status || !msg) return;
      status.textContent = '';
      window.setTimeout(() => { status.textContent = msg; }, 30);
    };
    const clear = () => { timers.forEach(clearTimeout); timers = []; };
    const press = (k, ms) => {
      const el = keys.get(k);
      if (!el) return;
      el.classList.add('hit');
      timers.push(window.setTimeout(() => el.classList.remove('hit'), ms || 150));
    };
    const restLabel = tap.getAttribute('aria-label') || '';

    const stopClip = () => {
      if (!audio || !play) return;
      audio.pause();
      playing = false;
      play.classList.remove('is-playing');
      play.setAttribute('aria-label', 'Play the kept moment');
    };

    const setStage = (n) => {
      root.classList.add(STAGES[n - 1]);
      root.dataset.stage = String(n);
      say(messages[n]);
      if (n === 6) {
        running = false;
        setView('moment');
      }
    };

    const run = () => {
      if (running) return;
      running = true;
      clear();
      stopClip();
      tap.setAttribute('aria-disabled', 'true');
      tap.setAttribute('aria-label', restLabel);

      // Replay: fade the library out to the stock list first, then start clean.
      const replaying = root.classList.contains('s6');
      const lead = replaying ? (reduce.matches ? 220 : 480) : 0;
      if (replaying) root.classList.add('rewind');

      timers.push(window.setTimeout(() => {
        root.classList.remove('rewind', 'home', 'pick', ...STAGES);
        root.dataset.stage = '0';
        setView(null);
        setQuery('');
        timers.push(window.setTimeout(() => { root.classList.add('home'); say(messages.home); }, 0));
        const times = schedule(typingMs, reduce.matches);
        times.forEach((t, i) => {
          timers.push(window.setTimeout(() => setStage(i + 1), t));
        });
        if (reduce.matches) {
          timers.push(window.setTimeout(() => setQuery(finalText), times[1]));
        } else {
          // the typing: each stroke lights its key and rewrites the field
          let text = '';
          strokeTimes.forEach((st, i) => timers.push(window.setTimeout(() => {
            const k = strokes[i];
            text = k === '⌫' ? text.slice(0, -1) : text + k;
            press(k);
            setQuery(text);
          }, times[1] + st)));
          timers.push(window.setTimeout(() => press('search', 280), times[2] - 460)); // the search key, then the results
          timers.push(window.setTimeout(() => root.classList.add('pick'), times[3] - 760)); // the finger on the first result, then it opens
        }
        timers.push(window.setTimeout(() => setQuery(finalText), times[2])); // whatever happened, the word is whole when the results land
      }, lead));
    };

    tap.addEventListener('click', run);
    if (replay) replay.addEventListener('click', run);

    // the host (StudioOne's first settle) may FINISH a run it started — the
    // visitor pressed during it, so it lands on its end frame at once — or
    // REWIND one the visitor scrolled away from before it said anything
    root.addEventListener('hero:finish', () => {
      if (!running) return;
      clear();
      root.classList.remove('rewind', 'pick');
      root.classList.add('home', ...STAGES);
      root.dataset.stage = '6';
      setQuery(finalText);
      running = false;
      setView('moment');
    });
    root.addEventListener('hero:reset', () => {
      clear();
      stopClip();
      root.classList.remove('rewind', 'home', 'pick', ...STAGES);
      root.dataset.stage = '0';
      running = false;
      setView(null);
      setQuery('');
      tap.removeAttribute('aria-disabled');
      tap.setAttribute('aria-label', restLabel);
    });

    /* Playback: only when the JSON gave the moment a src. Otherwise the button stays quiet. */
    if (audio && play && play.getAttribute('aria-disabled') !== 'true') {
      const a = Number(play.dataset.start) || 0;
      const b = Number(play.dataset.end) || Infinity;
      const seekAndPlay = () => {
        try { audio.currentTime = a; } catch (e) { /* metadata not ready; play from start */ }
        audio.play().then(() => {
          playing = true;
          play.classList.add('is-playing');
          play.setAttribute('aria-label', 'Pause');
        }).catch(() => { /* autoplay policy or missing file: stay quiet */ });
      };
      play.addEventListener('click', () => {
        if (playing) { stopClip(); return; }
        if (audio.readyState >= 1) seekAndPlay();
        else audio.addEventListener('loadedmetadata', seekAndPlay, { once: true });
      });
      audio.addEventListener('timeupdate', () => { if (playing && audio.currentTime >= b) stopClip(); });
      audio.addEventListener('ended', stopClip);
    }
  }

  const initAll = () => document.querySelectorAll('[data-archive-hero]').forEach(init);
  initAll();
  document.addEventListener('astro:page-load', initAll); // no-op unless the ClientRouter is in use
</script>
