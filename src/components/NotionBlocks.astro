---
// Renders a flat list of Notion blocks as editorial prose.
// Consecutive bulleted_list_item / numbered_list_item blocks are grouped
// into a single <ul>/<ol>. Supported block types: paragraph, heading_1/2/3,
// bulleted_list_item, numbered_list_item, image, divider, quote.
// Other block types are skipped silently.

import type { BlockObjectResponse } from "@notionhq/client/build/src/api-endpoints";
import RichText from "./RichText.astro";

interface Props {
  blocks: BlockObjectResponse[];
}

const { blocks } = Astro.props;

type RenderItem =
  | { kind: "block"; block: BlockObjectResponse }
  | {
      kind: "list";
      tag: "ul" | "ol";
      items: BlockObjectResponse[];
    };

// Group consecutive list items.
const items: RenderItem[] = [];
let openList: { tag: "ul" | "ol"; items: BlockObjectResponse[] } | null = null;
for (const b of blocks) {
  const isBul = b.type === "bulleted_list_item";
  const isNum = b.type === "numbered_list_item";
  if (isBul || isNum) {
    const tag = isBul ? "ul" : "ol";
    if (openList && openList.tag === tag) {
      openList.items.push(b);
    } else {
      openList = { tag, items: [b] };
      items.push({ kind: "list", tag, items: openList.items });
    }
  } else {
    items.push({ kind: "block", block: b });
    openList = null;
  }
}

// Block accessors keep the JSX terse. Each helper reads the typed shape
// off the discriminated block union via a narrow cast.
function richTextFor(b: BlockObjectResponse) {
  const x = b as any;
  return x[b.type]?.rich_text ?? [];
}
function imageFor(b: BlockObjectResponse) {
  if (b.type !== "image") return { src: "", caption: "" };
  const img = b.image;
  const src = img.type === "external" ? img.external.url : img.file.url;
  const caption = img.caption.map((c) => c.plain_text).join("");
  return { src, caption };
}
---

<div class="prose">
  {items.map((item) => {
    if (item.kind === "list") {
      if (item.tag === "ul") {
        return (
          <ul class="list">
            {item.items.map((li) => (
              <li><RichText rich={richTextFor(li)} /></li>
            ))}
          </ul>
        );
      }
      return (
        <ol class="list">
          {item.items.map((li) => (
            <li><RichText rich={richTextFor(li)} /></li>
          ))}
        </ol>
      );
    }

    const b = item.block;
    if (b.type === "paragraph") {
      const rt = b.paragraph.rich_text;
      if (rt.length === 0) return null;
      return <p class="para"><RichText rich={rt} /></p>;
    }
    if (b.type === "heading_1") {
      return <h2 class="h h1"><RichText rich={b.heading_1.rich_text} /></h2>;
    }
    if (b.type === "heading_2") {
      return <h3 class="h h2"><RichText rich={b.heading_2.rich_text} /></h3>;
    }
    if (b.type === "heading_3") {
      return <h4 class="h h3"><RichText rich={b.heading_3.rich_text} /></h4>;
    }
    if (b.type === "divider") {
      return <hr class="divider" />;
    }
    if (b.type === "image") {
      const { src, caption } = imageFor(b);
      return (
        <figure class="figure">
          <img src={src} alt={caption} loading="lazy" />
          {caption && <figcaption>{caption}</figcaption>}
        </figure>
      );
    }
    if (b.type === "quote") {
      return <blockquote class="quote"><RichText rich={b.quote.rich_text} /></blockquote>;
    }
    return null;
  })}
</div>

<style>
  .prose {
    max-width: 66ch;
  }
  .para {
    font-size: 1.0625rem;
    line-height: 1.7;
    margin-bottom: var(--space-4);
  }
  .h {
    font-weight: var(--fw-bold);
    letter-spacing: var(--ls-title);
    line-height: 1.2;
  }
  .h1 {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    margin-top: var(--space-16);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--line);
  }
  .h1:first-child { margin-top: 0; }
  .h2 {
    font-size: clamp(1.25rem, 2.2vw, 1.625rem);
    margin-top: var(--space-12);
    margin-bottom: var(--space-3);
  }
  .h3 {
    font-size: 1.125rem;
    margin-top: var(--space-8);
    margin-bottom: var(--space-2);
  }
  .list {
    padding-left: var(--space-6);
    margin-bottom: var(--space-4);
    line-height: 1.7;
  }
  .list li {
    margin-bottom: var(--space-2);
    font-size: 1.0625rem;
  }
  .list li::marker {
    color: var(--accent);
  }
  .divider {
    border: 0;
    border-top: 1px solid var(--line);
    margin: var(--space-12) 0;
  }
  /* Inline images sit on a cream paper backdrop regardless of the active
     theme. Ensures images with dark internal text (UI screenshots, mocks,
     diagrams) stay readable on any background. Looks like a clipping. */
  .figure {
    margin: var(--space-12) 0;
    background: #F5F1E8;
    padding: var(--space-4);
    border: 1px solid var(--line);
    transition: border-color 280ms ease;
  }
  .figure img {
    width: 100%;
    height: auto;
    display: block;
  }
  .figure figcaption {
    font-size: var(--fs-small);
    color: #5A5450;
    margin-top: var(--space-3);
    line-height: 1.5;
    font-style: italic;
  }
  .quote {
    border-left: 2px solid var(--accent);
    padding-left: var(--space-6);
    margin: var(--space-8) 0;
    font-size: 1.25rem;
    line-height: 1.5;
    font-style: italic;
    color: var(--text);
  }
</style>
