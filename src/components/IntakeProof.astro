---
// src/components/IntakeProof.astro
// THE PROOF, DESIGNED (round six of the catch-all, 2026-10-22; Jon: "'said to Siri' is an ugly screenshot, then
// 'said to the watch' and two calendars. We know what's going on, but the average user couldn't glance at this and
// understand the big picture. Let's just design it. We don't need the screenshot; we can make our own modules").
// TWO ANSWERS to the one sentence, side by side on a wide sheet (stacked under 820), each a module WE draw, one word
// over each in the label face: SIRI = the orb and the real reply on the paper, no phone, no frame (the joke: Siri
// heard a name); INTAKE = the week of March 5–7, 2027 in the catch-all's calendar vocabulary (the weekday letters,
// the bold numerals, bars in the Intake red). WHEN THE FOLD OPENS (the click is the press, the law's one press): the
// wedding bar across the three days leaves (fades and lifts, 400 ms), a 600 ms hold, then four bars arrive one at a
// time 220 ms apart. Closing the fold resets it; reduced motion shows the after state. Both modules share one height.
// Paper stays paper: the sheet's inks, the Intake red for the bars, no fill beyond them.
//
// Usage:   <IntakeProof />   inside the Intake fold's clip (StudioOne), after the sentence
// Data:    src/data/intake-run.json → proof (every line DRAFT, Jon's to rewrite)
// Plays:   a MutationObserver on the closest .wk-story's data-open: the fold's own mechanics are untouched
import run from '../data/intake-run.json';

const { siri, week } = run.proof;
---
<div class="pf" data-proof aria-label="Two answers to the sentence: Siri's, and Intake's calendar">
  <div class="pf-side">
    <p class="sheet-t">Siri</p>
    <div class="siri">
      <span class="orb" aria-hidden="true"></span>
      <p class="siri-t">{siri}</p>
    </div>
  </div>
  <div class="pf-side">
    <p class="sheet-t">Intake</p>
    <div class="wk7" data-week>
      <div class="wk7-head" aria-hidden="true">{week.days.map((d) => <span>{d.w}</span>)}</div>
      <div class="wk7-grid">
        {week.days.map((d, i) => (
          <div class="wk7-day">
            <span class="wk7-n" aria-hidden="true">{d.d}</span>
            <div class="wk7-bars">
              {week.after.filter((b) => b.day === i).map((b) => (
                <span class="bar" data-after style={`--k:${week.after.indexOf(b)}`}><b>{b.title}</b><i>{b.time}</i></span>
              ))}
            </div>
          </div>
        ))}
        {/* the wedding: one bar across the three days, the before state */}
        <span class="bar bar-wed" data-before><b>{week.before.title}</b></span>
      </div>
    </div>
  </div>
</div>

<style>
  .pf {
    /* the bars' colours = the catch-all's Intake calendar (IntakeCatchAll's --cal-intake-*), day and night */
    --bar-bg: #ffd1da; --bar-ink: #8a1631; --bar-time: #c22a4d;
    --line: color-mix(in oklab, var(--mx-ink, var(--sheet-ink)) 12%, transparent);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 36px 40px;
    max-width: 640px; /* the pair as wide as the sentence's measure allows (44ch of the display face) */
    margin: 0 auto;
    align-items: stretch;
  }
  :global(html[data-night]) .pf { --bar-bg: color-mix(in oklab, #ff375f 30%, #1c1c1f); --bar-ink: #ffc2cf; --bar-time: #ff8fa6; }
  .pf-side { min-width: 0; display: flex; flex-direction: column; }
  .pf-side > .sheet-t { margin: 0 0 14px; }

  /* ── SIRI: the orb, then the reply, iOS's grammar on the paper (the system face), nothing else */
  .siri { flex: 1; display: flex; flex-direction: column; align-items: flex-start; gap: 14px; padding-top: 2px; }
  .orb {
    width: 30px; height: 30px; border-radius: 50%; flex: none;
    background:
      radial-gradient(circle at 36% 34%, rgba(255, 255, 255, 0.95) 0, rgba(255, 255, 255, 0.55) 22%, rgba(255, 255, 255, 0) 52%),
      conic-gradient(from 210deg, #ff5fa2, #8a5cf6 30%, #47b6ff 55%, #5ee6c6 72%, #ff8a5b 88%, #ff5fa2);
    box-shadow: 0 0 0 1px color-mix(in oklab, #8a5cf6 22%, transparent), 0 4px 14px color-mix(in oklab, #47b6ff 28%, transparent);
  }
  .siri-t {
    margin: 0; max-width: 30ch;
    font: 500 1.0625rem/1.4 -apple-system, system-ui, 'Instrument Sans', 'Helvetica Neue', sans-serif;
    letter-spacing: -0.005em; text-wrap: pretty;
    color: var(--mx-ink, var(--sheet-ink));
    transition: color 560ms ease;
  }

  /* ── INTAKE: the week, three day columns in the month's grammar (IntakeCatchAll's .cm-*): the letters over a
     hairline, the numerals, the bars under them; one height, reserved to its fullest state (two bars on Saturday) */
  .wk7 { flex: 1; display: flex; flex-direction: column; min-height: 150px; font-family: -apple-system, 'Instrument Sans', 'Helvetica Neue', system-ui, sans-serif; }
  .wk7-head { display: grid; grid-template-columns: repeat(3, 1fr); padding: 0 0 5px; border-bottom: 1px solid var(--line); }
  .wk7-head span { text-align: center; font-size: 11px; font-weight: 600; color: var(--mx-dim, var(--sheet-dim)); }
  .wk7-grid { position: relative; flex: 1; display: grid; grid-template-columns: repeat(3, 1fr); }
  .wk7-day { position: relative; display: flex; flex-direction: column; align-items: center; padding-top: 4px; min-width: 0; }
  .wk7-day + .wk7-day { border-left: 1px solid var(--line); }
  .wk7-n { display: grid; place-items: center; width: 24px; height: 24px; font-size: 15px; font-weight: 600; font-variant-numeric: tabular-nums; letter-spacing: -0.02em; color: var(--mx-ink, var(--sheet-ink)); transition: color 560ms ease; }
  .wk7-bars { width: 100%; display: flex; flex-direction: column; gap: 3px; padding: 6px 2px 0; box-sizing: border-box; }
  .bar {
    box-sizing: border-box; padding: 3px 5px; border-radius: 4px; min-width: 0;
    display: flex; flex-direction: column; gap: 1px;
    background: var(--bar-bg); color: var(--bar-ink);
  }
  .bar b { display: block; font-size: 10.5px; font-weight: 700; line-height: 1.15; letter-spacing: -0.01em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .bar i { font-style: normal; font-size: 10.5px; line-height: 1.15; color: var(--bar-time); }
  /* the wedding: across the three days at the bars' row */
  .bar-wed { position: absolute; left: 2px; right: 2px; top: 34px; }
  .bar-wed b { white-space: normal; }

  /* ── THE PLAY (on the fold's open): the wedding leaves (fades and lifts, 400 ms); the four arrive one at a time,
     220 ms apart, with the month's pop; closed = the before state */
  [data-after] { opacity: 0; transform: scale(0.7); transform-origin: 0 0; }
  .pf.play [data-after] { opacity: 1; transform: none; transition: opacity 180ms ease, transform 260ms cubic-bezier(0.2, 0.9, 0.25, 1.15); transition-delay: calc(1000ms + var(--k) * 220ms); }
  .pf.play [data-before] { opacity: 0; transform: translateY(-6px); transition: opacity 400ms ease, transform 400ms ease; }
  .pf.still [data-after], .pf.still [data-before] { transition: none; }
  @media (prefers-reduced-motion: reduce) {
    .pf.play [data-after], .pf.play [data-before] { transition: none; }
  }
  @container (min-width: 820px) {
    .pf { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
  }
</style>

<script>
  /* the click that opens the fold is the press: play on data-open, reset on close */
  document.querySelectorAll('[data-proof]').forEach((pf) => {
    const story = pf.closest('.wk-story');
    if (!story) return;
    const sync = () => {
      if (story.hasAttribute('data-open')) { pf.classList.remove('still'); pf.classList.add('play'); }
      else { pf.classList.add('still'); pf.classList.remove('play'); }
    };
    new MutationObserver(sync).observe(story, { attributes: true, attributeFilter: ['data-open'] });
    sync();
  });
</script>
