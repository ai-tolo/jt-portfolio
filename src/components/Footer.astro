---
const path = Astro.url.pathname;
const isColophon = path === "/colophon" || path === "/colophon/";

const externals = [
  { label: "LinkedIn", href: "https://www.linkedin.com/in/jtollefson123/" },
  { label: "Substack", href: "https://substack.com/@diaryofasoundbender" },
];

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="inner footer-inner">
    {/* The `·` is the mobile/touch entrance to Tolo.Cloud. To public visitors
        it reads as ordinary punctuation. Long-press (800ms) triggers the same
        cloud-overlay flow as the desktop `cloud` keystroke. The hit zone is
        44×44pt via padding + negative margin — the layout stays unchanged. */}
    <p class="name">Jonathan Tollefson <span
      data-cloud-trigger
      class="cloud-dot"
      aria-hidden="true"
    >·</span> {year}</p>
    <ul class="links">
      <li>
        <a
          href="/colophon"
          class="colophon"
          aria-current={isColophon ? "page" : undefined}
        >Colophon</a>
      </li>
      {externals.map((l) => (
        <li>
          <a href={l.href} target="_blank" rel="noopener noreferrer">
            {l.label}<span class="ext" aria-hidden="true"> ↗</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    margin-top: var(--space-24);
    padding: var(--space-12) 0;
  }
  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  .name {
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--muted);
  }

  /* Hidden mobile entrance to Tolo.Cloud. Looks like a separator dot; long-
     press triggers the cloud-overlay handler defined in Layout.astro. The
     padding/negative-margin combo gives a 44pt touch target without changing
     visual layout. WebkitTouchCallout suppresses the iOS long-press menu. */
  .cloud-dot {
    display: inline-block;
    position: relative;
    /* Horizontal padding compensates for the narrow `·` glyph (~5px) so the
       hit box clears the 44pt minimum on both axes. Negative margin equals
       the padding so the visible layout doesn't shift. */
    padding: 14px 20px;
    margin: -14px -20px;
    cursor: pointer;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    transition: color 220ms ease, text-shadow 220ms ease;
  }
  .cloud-dot[data-holding="true"] {
    color: var(--text);
    text-shadow:
      0 0 6px rgba(199, 168, 255, 0.55),
      0 0 14px rgba(255, 109, 196, 0.35);
  }
  .links {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
  }
  .links a {
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-underline-offset: 6px;
    text-decoration-thickness: 1px;
    transition: color 160ms ease,
                text-decoration-color 160ms ease,
                text-decoration-thickness 160ms ease;
  }
  .links a:hover,
  .links a:focus-visible {
    color: var(--text);
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
  }
  .links a.colophon[aria-current="page"] {
    color: var(--text);
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
  }
  .ext {
    display: inline-block;
    font-size: 0.85em;
    margin-left: 1px;
    color: var(--accent);
    text-decoration: none;
  }

  @media (min-width: 56rem) {
    .footer-inner {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }
</style>
