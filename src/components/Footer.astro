---
const path = Astro.url.pathname;
const isColophon = path === "/colophon" || path === "/colophon/";

const externals = [
  { label: "LinkedIn", href: "https://www.linkedin.com/in/jtollefson123/" },
  { label: "Substack", href: "https://substack.com/@diaryofasoundbender" },
];

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="inner footer-inner">
    <p class="name">Jonathan Tollefson · {year}</p>
    <ul class="links">
      <li>
        <a
          href="/colophon"
          class="colophon"
          aria-current={isColophon ? "page" : undefined}
        >Colophon</a>
      </li>
      {externals.map((l) => (
        <li>
          <a href={l.href} target="_blank" rel="noopener noreferrer">
            {l.label}<span class="ext" aria-hidden="true"> ↗</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    margin-top: var(--space-24);
    padding: var(--space-12) 0;
  }
  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  .name {
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--muted);
  }
  .links {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
  }
  .links a {
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-underline-offset: 6px;
    text-decoration-thickness: 1px;
    transition: color 160ms ease,
                text-decoration-color 160ms ease,
                text-decoration-thickness 160ms ease;
  }
  .links a:hover,
  .links a:focus-visible {
    color: var(--text);
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
  }
  .links a.colophon[aria-current="page"] {
    color: var(--text);
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
  }
  .ext {
    display: inline-block;
    font-size: 0.85em;
    margin-left: 1px;
    color: var(--accent);
    text-decoration: none;
  }

  @media (min-width: 56rem) {
    .footer-inner {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }
</style>
