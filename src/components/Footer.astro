---
import SoundField from "./SoundField.astro";

const path = Astro.url.pathname;
const isColophon = path === "/colophon" || path === "/colophon/";
// The shared footer also renders on the dark case-study route (via CSLayout).
// Keep the ambient terrain off those pages so they stay exactly as designed.
const isCaseStudy = path.startsWith("/case-studies/");

const externals = [
  { label: "LinkedIn", href: "https://www.linkedin.com/in/jtollefson123/" },
  { label: "Substack", href: "https://substack.com/@diaryofasoundbender" },
];

const year = new Date().getFullYear();
---

<footer class="footer">
  {!isCaseStudy && <SoundField variant="footer" class="footer-field" />}
  <div class="inner footer-content">
    <p class="footer-credo">
      Building intentional worlds<br /> out of structured attention.
    </p>

    <div class="footer-inner">
      {/* The `·` is the mobile/touch entrance to Tolo.Cloud. To public visitors
          it reads as ordinary punctuation. Long-press (800ms) triggers the same
          cloud-overlay flow as the desktop `cloud` keystroke. The hit zone is
          44×44pt via padding + negative margin — the layout stays unchanged. */}
      <p class="name">Jonathan Tollefson <span
        data-cloud-trigger
        class="cloud-dot"
        aria-hidden="true"
      >·</span> {year}</p>
      <ul class="links">
        <li>
          <a
            href="/colophon"
            class="colophon"
            aria-current={isColophon ? "page" : undefined}
          >Colophon</a>
        </li>
        {externals.map((l) => (
          <li>
            <a href={l.href} target="_blank" rel="noopener noreferrer">
              {l.label}<span class="ext" aria-hidden="true"> ↗</span>
            </a>
          </li>
        ))}
        <li>
          <button type="button" class="to-top" data-to-top>
            Top<span class="ext" aria-hidden="true"> ↑</span>
          </button>
        </li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    isolation: isolate;
    overflow: clip;
    border-top: 1px solid var(--line);
    margin-top: var(--space-24);
    padding: var(--space-16) 0 var(--space-12);
  }
  .footer-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .footer-credo {
    max-width: 18ch;
    font-family: "Space Grotesk Variable", "Space Grotesk", ui-sans-serif, system-ui, sans-serif;
    font-size: clamp(1.5rem, 3.4vw, 2.5rem);
    font-weight: var(--fw-semibold);
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  .name {
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--muted);
  }

  /* Hidden mobile entrance to Tolo.Cloud. Looks like a separator dot; long-
     press triggers the cloud-overlay handler defined in Layout.astro. The
     padding/negative-margin combo gives a 44pt touch target without changing
     visual layout. WebkitTouchCallout suppresses the iOS long-press menu. */
  .cloud-dot {
    display: inline-block;
    position: relative;
    padding: 14px 20px;
    margin: -14px -20px;
    cursor: pointer;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    transition: color 220ms ease, text-shadow 220ms ease;
  }
  .cloud-dot[data-holding="true"] {
    color: var(--text);
    text-shadow:
      0 0 6px rgba(199, 168, 255, 0.55),
      0 0 14px rgba(255, 109, 196, 0.35);
  }

  .links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-6);
  }
  .links a,
  .to-top {
    font-family: inherit;
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-underline-offset: 6px;
    text-decoration-thickness: 1px;
    transition: color 160ms ease,
                text-decoration-color 160ms ease,
                text-decoration-thickness 160ms ease;
  }
  .to-top {
    -webkit-appearance: none;
    appearance: none;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
  }
  .links a:hover,
  .links a:focus-visible,
  .to-top:hover,
  .to-top:focus-visible {
    color: var(--text);
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    outline: none;
  }
  .links a.colophon[aria-current="page"] {
    color: var(--text);
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
  }
  .ext {
    display: inline-block;
    font-size: 0.85em;
    margin-left: 1px;
    color: var(--accent);
    text-decoration: none;
  }

  @media (min-width: 56rem) {
    .footer-inner {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }
</style>

<script>
  /* Back-to-top — smooth unless the user prefers reduced motion. */
  document.querySelectorAll<HTMLElement>("[data-to-top]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      window.scrollTo({ top: 0, behavior: reduce ? "auto" : "smooth" });
    });
  });
</script>
