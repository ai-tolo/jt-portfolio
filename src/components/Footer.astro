---
const links = [
  { label: "Substack", href: "https://substack.com/@diaryofasoundbender" },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/jtollefson123/" },
  { label: "Email", href: "mailto:jtollefson123@gmail.com" },
  { label: "Resume", href: "/resume" },
];

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="inner footer-inner">
    <p class="name">Jonathan Tollefson · {year}</p>
    <ul class="links">
      {links.map((l) => (
        <li>
          <a href={l.href} rel={l.href.startsWith("http") ? "noopener" : undefined}>{l.label}</a>
        </li>
      ))}
    </ul>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    margin-top: var(--space-24);
    padding: var(--space-12) 0;
  }
  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  .name {
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--muted);
  }
  .links {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
  }
  .links a {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-underline-offset: 6px;
    text-decoration-thickness: 1px;
    transition: text-decoration-color 160ms ease;
  }
  .links a:hover,
  .links a:focus-visible {
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
  }

  @media (min-width: 56rem) {
    .footer-inner {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }
</style>
