---
/**
 * HeroName — the landing masthead. A tight uppercase architectural stack (the
 * approved type treatment) with a mono eyebrow above and a role line below. The
 * instrument rule under the name was removed 2026-06-08 — the site carries ONE
 * waveform, the expansive about-signal directly below (AboutSignal.astro); a
 * second wave under the name competed with it. Real text (h1) for a11y + SEO,
 * fully tokenised so it re-themes.
 */
---

<div class="hn">
  <p class="hn-eyebrow">2026 · Minneapolis</p>
  <h1 class="hn-name"><span>Jonathan</span><span>Tollefson</span></h1>
  <p class="hn-role">
    <span class="hn-role-a">User experience architect</span>
    <span class="hn-role-sep" aria-hidden="true"></span>
    <span class="hn-role-b">Soundbender</span>
  </p>
</div>

<style>
  /* masthead lockup — uppercase stack on an instrument rule, with a role line */
  .hn { display: grid; justify-items: start; gap: clamp(0.85rem, 1.8vh, 1.3rem); max-width: 100%; }
  .hn-eyebrow {
    margin: 0; font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.7rem; letter-spacing: 0.22em; text-transform: uppercase; color: var(--muted);
  }
  .hn-name {
    margin: 0; text-transform: uppercase;
    font-family: "Space Grotesk Variable", "Space Grotesk", ui-sans-serif, system-ui, sans-serif;
    font-weight: 700; font-size: clamp(2.6rem, 9.2vw, 7.75rem); line-height: 0.9;
    letter-spacing: -0.03em; color: var(--text);
  }
  .hn-name span { display: block; }
  .hn-role {
    margin: 0; display: flex; align-items: center; gap: 0.8rem;
    font-family: "Space Grotesk Variable", "Space Grotesk", ui-sans-serif, system-ui, sans-serif;
    font-weight: 500; font-size: clamp(1rem, 1.5vw, 1.3rem); letter-spacing: -0.005em;
    color: var(--text);
  }
  .hn-role-sep { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); flex: none; }
  .hn-role-b { color: var(--accent); font-weight: 600; }
  @media (max-width: 40rem) {
    .hn-role { font-size: 1rem; gap: 0.6rem; }
  }
</style>
