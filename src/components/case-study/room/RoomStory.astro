---
/**
 * RoomStory — the story card of the work room, for a case study (Stream C, 2026-10-05): the name centred at 2.125rem,
 * the read in two columns (moment headings in the display face, second person), then UNDER THE HOOD folded inside the
 * same card as a spine of steps (a dot in the object's ink, the stage key, the tool, one sentence). Always open
 * (Jon, 2026-10-06: a reader on a case study is already interested; never make them work for the write-up).
 * The recipe is the homepage's (.wk-story), minus its fold.
 */
export type Block = { h?: string; p: string };
export type Row = { k: string; tool: string; html: string };
interface Props {
  name: string;
  blocks: Block[];
  hood?: Row[];
  hoodTitle?: string;
  /** the dot's ink (the object's) */
  accent?: string;
}
const { name, blocks, hood = [], hoodTitle = "under the hood", accent = "#2a62d9" } = Astro.props;
const cut = Math.ceil(blocks.length / 2);
const cols = [blocks.slice(0, cut), blocks.slice(cut)];
const hcut = Math.ceil(hood.length / 2);
const hcols = [hood.slice(0, hcut), hood.slice(hcut)];
---

<div class="rs" data-room-story style={`--rs-acc:${accent}`}>
  <div class="rs-clip">
    <div class="rs-body">
      <h2 class="rs-title">{name}</h2>
      <div class="rs-cols">
        {cols.map((col) => (
          <div class="rs-col">
            {col.map((b) => (
              <>
                {b.h && <h3 class="rs-m">{b.h}</h3>}
                <p class="rs-p" set:html={b.p} />
              </>
            ))}
          </div>
        ))}
      </div>
    </div>
    {hood.length > 0 && (
      <div class="rs-hood">
        <p class="rs-t">{hoodTitle}</p>
        <div class="rs-cols">
          {hcols.map((col) => (
            <ol class="rs-steps">
              {col.map((r) => (
                <li class="rs-step">
                  <div class="rs-step-head"><span class="rs-step-k">{r.k}</span><span class="rs-step-tool">{r.tool}</span></div>
                  <p class="rs-step-p" set:html={r.html} />
                </li>
              ))}
            </ol>
          ))}
        </div>
      </div>
    )}
  </div>
</div>

<style>
  .rs {
    position: relative; box-sizing: border-box; width: 100%; margin: var(--sp-12) 0 0;
    border: 1px solid color-mix(in oklab, var(--rm-ink) 16%, transparent); border-radius: 28px;
    background: var(--rm-card); color: var(--rm-ink); font-family: var(--rm-sans);
    container-type: inline-size;
    transition: border-color 560ms ease, background-color 560ms ease, color 560ms ease;
  }
  .rs-clip { padding-bottom: 32px; }
  .rs-body { padding: 32px 32px 32px; }
  .rs-title { margin: 0 0 40px; text-align: center; font: 500 2.125rem/1.15 var(--rm-display); letter-spacing: 0.06em; }
  .rs-cols { display: grid; grid-template-columns: minmax(0, 1fr); gap: 16px 48px; }
  .rs-cols:has(.rs-steps) { row-gap: 24px; }
  .rs-col { min-width: 0; }
  .rs-col > :last-child { margin-bottom: 0; }
  .rs-m { margin: 8px 0 8px; font: 500 1.25rem/1.25 var(--rm-display); letter-spacing: -0.01em; }
  .rs-p + .rs-m { margin-top: 24px; }
  .rs .rs-p { margin: 0 0 16px; font-size: 1rem; line-height: 1.6; text-wrap: pretty; max-width: none; }
  .rs-hood { margin: 0 32px; padding: 24px 0 16px; border-top: 1px solid color-mix(in oklab, var(--rm-ink) 12%, transparent); }
  .rs-t { margin: 0 0 24px; font: 500 0.6875rem/1 var(--rm-mono); letter-spacing: 0.14em; text-transform: uppercase; color: var(--rm-dim); }
  .rs-steps { list-style: none; margin: 0; padding: 0; }
  .rs-step { position: relative; padding: 0 0 24px 28px; }
  .rs-step::before { content: ''; position: absolute; left: 0; top: 5px; width: 10px; height: 10px; border-radius: 50%; background: var(--rs-acc); }
  .rs-step::after { content: ''; position: absolute; left: 4.5px; top: 20px; bottom: 6px; width: 1px; background: color-mix(in oklab, var(--rm-ink) 16%, transparent); }
  .rs-step:last-child::after { display: none; }
  .rs-step:last-child { padding-bottom: 0; }
  .rs-step-head { display: flex; align-items: center; gap: 10px; margin-bottom: 6px; }
  .rs-step-k { font: 500 0.6875rem/1.6 var(--rm-mono); letter-spacing: 0.12em; text-transform: uppercase; color: color-mix(in oklab, var(--rs-acc) 70%, var(--rm-ink)); }
  .rs-step-tool { font: 500 0.6875rem/1 var(--rm-mono); letter-spacing: 0.04em; color: var(--rm-dim); padding: 4px 8px; border: 1px solid color-mix(in oklab, var(--rm-ink) 16%, transparent); border-radius: 999px; }
  .rs .rs-step-p { margin: 0; font-size: 0.9375rem; line-height: 1.55; text-wrap: pretty; max-width: none; }
  @container (min-width: 820px) {
    .rs-body { padding: 48px 48px 40px; }
    .rs-hood { margin: 0 48px; padding-top: 32px; }
    .rs-clip { padding-bottom: 40px; }
    .rs-cols { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
  }
</style>

