---
// CHS · THE SYSTEM (Stream C, 2026-10-05): the design-system sheet behind the docs assistant.
// Two materials. The COMPONENTS (swatches, stages, replicas) paint only from the system tokens in
// chs-tokens.css, defined on the page's .chs root. The SHEET they sit on (labels, tiles, doc cards)
// paints from the room's tokens (Room.astro). The switch writes data-sys on the .chs ancestor, so every
// component on the page flips, and each readout prints its token's computed value, re-read on a flip.
// No p, no li code: the study's global prose rules would restyle them.
const SWATCHES = ["paper", "ink", "dim", "line", "field", "accent", "accent-ink", "ok", "warn"];
const FACES = [{ n: "font", cls: "is-sans" }, { n: "mono", cls: "is-mono" }];
const RADII = [{ n: "radius", cls: "" }, { n: "radius-sm", cls: "is-sm" }];
const SCALE = ["fs-sm", "fs", "fs-lg"];
const BTN_PRI = ["rest", "hover", "pressed", "disabled"];
const BTN_SEC = ["rest", "hover"];
const INPUTS = [
  { st: "rest", text: "Ask the docs…", help: "enter to ask" },
  { st: "focus", text: "freight cost trend", help: "searching your role's sources" },
  { st: "error", text: "Q9 board deck", help: "no doc matches · try a folder" },
];
const STARTERS = [
  { st: "rest", label: "Draft a sales follow-up", kind: "PROMPT" },
  { st: "hover", label: "Summarize the Q2 call", kind: "WORKFLOW" },
  { st: "running", label: "KB from the GTM Drive", kind: "TEMPLATE" },
  { st: "done", label: "Freight cost trend", kind: "DATASET" },
];
const KINDS = ["TEMPLATE", "PROMPT", "WORKFLOW", "DATASET"];
const ROLES = ["Sales", "GTM", "Finance", "Ops"];
const ADOPTED = ["Sales", "GTM", "Finance", "Ops", "other internal tools on Open WebUI"];
const COMPS = [
  { id: "button", name: "Button", what: "The one action on a surface; secondary steps back.", states: "primary rest · hover · pressed · disabled; secondary rest · hover", used: "composer · role landing" },
  { id: "input", name: "Input", what: "Where a question starts; an error says what to try next.", states: "rest · focus · error", used: "composer · doc search" },
  { id: "starter", name: "Starter row", what: "A role's first jobs, one press from running.", states: "rest · hover · running · done", used: "role landing · empty thread" },
  { id: "chip", name: "Chip", what: "Names what a starter or an answer is built from.", states: "template · prompt · workflow · dataset", used: "starter rows · answer tails" },
  { id: "message", name: "Message", what: "The thread: the ask on the right, the answer on the left.", states: "user · assistant", used: "thread" },
  { id: "tab", name: "Role tab", what: "Picks whose starters the assistant leads with.", states: "rest · selected", used: "role rail" },
];
const st = (s: string) => (s === "rest" ? "" : `is-${s}`);
---

<section class="chs-sys" data-chs-sys aria-label="The system: tokens and components">
  <div class="sys-head">
    <span class="sys-lbl">the system</span>
    <div class="sys-head-r">
      <span class="sys-lbl" aria-hidden="true">theme</span>
      <div class="sys-flip" role="group" aria-label="Component theme">
        <button type="button" data-sys-set="light" aria-pressed="true">light</button>
        <button type="button" data-sys-set="dark" aria-pressed="false">dark</button>
      </div>
    </div>
  </div>

  <div class="sys-tokens">
    <span class="sys-lbl">tokens</span>
    <div class="sys-swatches">
      {SWATCHES.map((n) => (
        <div class="sys-sw" data-swatch={n}>
          <span class="sys-sq" style={`background: var(--sys-${n})`}></span>
          <span class="sys-name">{n}</span>
          <code class="sys-val" data-token={`--sys-${n}`}></code>
        </div>
      ))}
    </div>
    <div class="sys-specs">
      <div class="sys-spec" data-spec="faces">
        <span class="sys-lbl">faces</span>
        <div class="sys-pair">
          {FACES.map((f) => (
            <div class="sys-sw"><span class:list={["sys-ag", f.cls]}>Ag</span><span class="sys-name">{f.n}</span><code class="sys-val" data-token={`--sys-${f.n}`} data-first></code></div>
          ))}
        </div>
      </div>
      <div class="sys-spec" data-spec="radii">
        <span class="sys-lbl">radii</span>
        <div class="sys-pair">
          {RADII.map((r) => (
            <div class="sys-sw"><span class:list={["sys-rad", r.cls]}></span><span class="sys-name">{r.n}</span><code class="sys-val" data-token={`--sys-${r.n}`}></code></div>
          ))}
        </div>
      </div>
      <div class="sys-spec" data-spec="row">
        <span class="sys-lbl">row height</span>
        <div class="sys-sw"><span class="sys-bar"></span><span class="sys-name">row</span><code class="sys-val" data-token="--sys-row"></code></div>
      </div>
      <div class="sys-spec" data-spec="type">
        <span class="sys-lbl">type scale</span>
        <div class="sys-pair">
          {SCALE.map((t) => (
            <div class="sys-sw"><span class="sys-aa" style={`font-size: var(--sys-${t})`}>Aa</span><span class="sys-name">{t}</span><code class="sys-val" data-token={`--sys-${t}`}></code></div>
          ))}
        </div>
      </div>
    </div>
  </div>

  <div class="sys-comps">
    <span class="sys-lbl">components</span>
    <div class="sys-grid">
      {COMPS.map((c) => (
        <article class="sys-tile" data-sys-comp={c.id}>
          <div class="sys-stage" aria-hidden="true">
            {c.id === "button" && (
              <Fragment>
                <span class="sp-grp">primary</span>
                <div class="sp-row">{BTN_PRI.map((s) => (<div class="sp"><span class="sp-st">{s}</span><span class:list={["c-btn", "is-pri", st(s)]}>Send</span></div>))}</div>
                <span class="sp-grp">secondary</span>
                <div class="sp-row">{BTN_SEC.map((s) => (<div class="sp"><span class="sp-st">{s}</span><span class:list={["c-btn", "is-sec", st(s)]}>Back</span></div>))}</div>
              </Fragment>
            )}
            {c.id === "input" && INPUTS.map((f) => (
              <div class="sp">
                <span class="sp-st">{f.st}</span>
                <span class:list={["c-input", st(f.st)]}>{f.text}{f.st === "focus" && <span class="c-caret"></span>}</span>
                <span class:list={["c-help", st(f.st)]}>{f.help}</span>
              </div>
            ))}
            {c.id === "starter" && STARTERS.map((s) => (
              <div class="sp">
                <span class="sp-st">{s.st}</span>
                <span class:list={["c-start", st(s.st)]}>
                  {s.st === "running"
                    ? <span class="c-dots"><i></i><i></i><i></i></span>
                    : <span class="c-ic">{s.st === "done" ? "✓" : "→"}</span>}
                  <span class="c-lab">{s.label}</span>
                  <span class="c-chip">{s.kind}</span>
                </span>
              </div>
            ))}
            {c.id === "chip" && (
              <Fragment>
                <div class="sp"><span class="sp-st">kinds</span><div class="sp-row">{KINDS.map((k) => <span class="c-chip">{k}</span>)}</div></div>
                <div class="sp is-start"><span class="sp-st">on an answer</span><span class="c-chip">PROMPT · sales-voice-v3</span></div>
              </Fragment>
            )}
            {c.id === "message" && (
              <Fragment>
                <div class="sp is-end"><span class="sp-st">user</span><span class="c-msg is-user">Summarize the Acme Q2 call</span></div>
                <div class="sp is-start"><span class="sp-st">assistant</span><span class="c-msg is-asst">Mike owns the budget, not Sarah. Renewal moved to Q4.<span class="c-chip">WORKFLOW · transcript → brief</span></span></div>
              </Fragment>
            )}
            {c.id === "tab" && (
              <div class="c-rail">
                {ROLES.map((r, i) => (
                  <div class="sp-side"><span class="sp-st">{i === 0 ? "selected" : i === 1 ? "rest" : ""}</span><span class:list={["c-tab", i === 0 && "is-selected"]}>{r}</span></div>
                ))}
              </div>
            )}
          </div>
          <div class="sys-doc">
            <h3 class="sys-doc-name">{c.name}</h3>
            <div class="sys-doc-what">{c.what}</div>
            <div class="sys-doc-meta"><span>states</span><span>{c.states}</span></div>
          </div>
        </article>
      ))}
    </div>
  </div>

  <div class="sys-adopt">
    <span class="sys-lbl">adopted by</span>
    <ul class="sys-adopt-list">
      {ADOPTED.map((n) => <li>{n}</li>)}
    </ul>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-chs-sys]").forEach((root) => {
    // the page's .chs root owns the tokens; with none, the sheet writes on itself
    const host = root.closest<HTMLElement>(".chs") ?? root;
    const caps = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-sys-set]"));
    const vals = Array.from(root.querySelectorAll<HTMLElement>(".sys-val[data-token]"));
    let fade = 0;

    // print every token's CURRENT computed value; on a flip, underline the ones that changed
    const read = (mark: boolean) => {
      const cs = getComputedStyle(root);
      vals.forEach((el) => {
        let v = cs.getPropertyValue(el.dataset.token ?? "").trim();
        if (el.hasAttribute("data-first")) v = (v.split(",")[0] ?? "").replace(/["']/g, "").trim();
        const out = v || "—";
        if (mark && out !== el.textContent) el.classList.add("is-new");
        el.textContent = out;
      });
      if (!mark) return;
      window.clearTimeout(fade);
      fade = window.setTimeout(() => vals.forEach((el) => el.classList.remove("is-new")), 1400);
    };

    // the mode: the switch's word if it said one, else the site's night (chs-tokens.css paints the same rule)
    const night = () => document.documentElement.hasAttribute("data-night");
    const modeNow = () => { const s = host.getAttribute("data-sys"); return s === "dark" || s === "light" ? s : night() ? "dark" : "light"; };
    const sync = (mark: boolean) => {
      const mode = modeNow();
      root.dataset.sysMode = mode;
      caps.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.sysSet === mode)));
      read(mark);
    };

    caps.forEach((b) =>
      b.addEventListener("click", () => {
        // the site's own mode needs no word on the root (it follows the night); the other one is written
        const want = b.dataset.sysSet === "dark" ? "dark" : "light";
        if (want === (night() ? "dark" : "light")) host.removeAttribute("data-sys");
        else host.setAttribute("data-sys", want);
        sync(true);
      })
    );
    // anything else that flips the root (a second sheet, the tool) keeps this sheet honest
    new MutationObserver(() => sync(true)).observe(host, { attributes: true, attributeFilter: ["data-sys"] });
    // the site's switch takes the sheet with it (any word the sheet's switch wrote is dropped)
    new MutationObserver(() => { if (host.hasAttribute("data-sys")) host.removeAttribute("data-sys"); else sync(true); })
      .observe(document.documentElement, { attributes: true, attributeFilter: ["data-night"] });
    sync(false);
  });
</script>

<style>
  /* ── the sheet: the room's paper, inks and faces ── */
  .chs-sys { container: chs-sys / inline-size; width: 100%; min-width: 0; display: grid; gap: 32px; color: var(--rm-ink); font-family: var(--rm-sans); }
  .chs-sys, .chs-sys * { box-sizing: border-box; }
  .chs-sys [hidden] { display: none !important; }
  .sys-lbl, .sys-name { font: 500 0.6875rem/1.3 var(--rm-mono); letter-spacing: 0.12em; text-transform: lowercase; color: var(--rm-dim); }
  .sys-head { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-bottom: 12px; border-bottom: 1px solid var(--rm-line); }
  .sys-head-r { display: flex; align-items: center; gap: 10px; }
  .sys-flip { display: inline-flex; gap: 2px; padding: 2px; border: 1px solid var(--rm-line); border-radius: 7px; }
  .sys-flip button { appearance: none; margin-block: 0; margin-inline: 0; padding: 5px 10px; border: 0; border-radius: 5px; background: none; font: 500 11px/1 var(--rm-mono); letter-spacing: 0.08em; color: var(--rm-dim); }
  .sys-flip button:hover { color: var(--rm-ink); }
  .sys-flip button[aria-pressed="true"] { background: var(--rm-ink); color: var(--rm-paper); }
  .sys-flip button:focus-visible { outline: 2px solid var(--rm-ink); outline-offset: 2px; }

  .sys-tokens, .sys-comps, .sys-adopt { display: grid; gap: 12px; min-width: 0; }

  /* tokens: one row of swatches, then the faces, radii, row and scale */
  .sys-swatches { display: grid; grid-template-columns: repeat(9, minmax(0, 1fr)); gap: 16px 12px; }
  .sys-sw { display: grid; gap: 4px; justify-items: start; align-content: start; min-width: 0; }
  .sys-sq { display: block; width: 56px; height: 56px; margin-bottom: 4px; border: 1px solid var(--rm-line); border-radius: 4px; }
  .sys-val { display: block; max-width: 100%; min-height: 1.3em; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; padding: 0; border: 0; border-radius: 0; background: none; font: 400 0.6875rem/1.3 var(--rm-mono); letter-spacing: 0.02em; color: var(--rm-ink); box-shadow: inset 0 -1px 0 transparent; transition: box-shadow 0.4s ease; }
  .sys-val.is-new { box-shadow: inset 0 -1px 0 var(--rm-ink); }
  .sys-specs { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px 24px; margin-top: 8px; }
  .sys-spec { display: grid; gap: 10px; align-content: start; min-width: 0; padding-top: 10px; border-top: 1px solid var(--rm-line); }
  .sys-pair { display: flex; flex-wrap: wrap; align-items: end; gap: 10px 20px; }
  .sys-ag { font-size: 28px; font-weight: 500; line-height: 1; color: var(--rm-ink); }
  .sys-ag.is-sans { font-family: var(--sys-font); }
  .sys-ag.is-mono { font-family: var(--sys-mono); }
  .sys-rad { display: block; width: 32px; height: 32px; border: 1px solid var(--rm-dim); border-radius: var(--sys-radius); }
  .sys-rad.is-sm { border-radius: var(--sys-radius-sm); }
  .sys-bar { display: block; width: 100%; height: var(--sys-row); border: 1px solid var(--rm-dim); border-radius: 2px; }
  .sys-aa { font-family: var(--sys-font); font-weight: 500; line-height: 1; color: var(--rm-ink); }

  /* components: tiles on the room's card; inside each, the system's own paper */
  .sys-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .sys-tile { display: flex; flex-direction: column; gap: 16px; min-width: 0; padding: 20px; background: var(--rm-card); border: 1px solid var(--rm-line); border-radius: 16px; }
  .sys-stage { flex: 1 1 auto; display: grid; align-content: center; gap: 10px; min-width: 0; padding: 12px; background: var(--sys-paper); border: 1px solid var(--sys-line); border-radius: var(--sys-radius); color: var(--sys-ink); font: 400 var(--sys-fs)/1.3 var(--sys-font); }
  .sp { display: grid; gap: 4px; justify-items: stretch; min-width: 0; }
  .sp.is-start { justify-items: start; }
  .sp.is-end { justify-items: end; }
  .sp-row { display: flex; flex-wrap: wrap; align-items: end; gap: 6px 8px; }
  .sp-side { display: grid; grid-template-columns: 60px minmax(0, 1fr); align-items: center; gap: 8px; }
  .sp-st, .sp-grp { font: 400 var(--sys-fs-sm)/1 var(--sys-mono); letter-spacing: 0.04em; text-transform: lowercase; color: var(--sys-dim); }
  .sp-grp { font-weight: 500; color: var(--sys-ink); }
  .sp-grp ~ .sp-grp { margin-top: 4px; }

  .c-btn { display: inline-flex; align-items: center; justify-content: center; height: 30px; padding-inline: 12px; border: 1px solid transparent; border-radius: var(--sys-radius-sm); font: 500 var(--sys-fs)/1 var(--sys-font); white-space: nowrap; }
  .c-btn.is-pri { background: var(--sys-accent); color: var(--sys-accent-ink); }
  .c-btn.is-pri.is-hover { background: color-mix(in srgb, var(--sys-accent) 86%, var(--sys-ink)); }
  .c-btn.is-pri.is-pressed { background: color-mix(in srgb, var(--sys-accent) 72%, var(--sys-ink)); translate: 0 1px; }
  .c-btn.is-disabled { background: var(--sys-field); border-color: var(--sys-line); color: var(--sys-dim); }
  .c-btn.is-sec { background: var(--sys-paper); border-color: var(--sys-line); color: var(--sys-ink); }
  .c-btn.is-sec.is-hover { background: var(--sys-field); border-color: var(--sys-dim); }

  .c-input { display: flex; align-items: center; height: 34px; padding-inline: 10px; overflow: hidden; white-space: nowrap; background: var(--sys-paper); border: 1px solid var(--sys-line); border-radius: var(--sys-radius-sm); color: var(--sys-dim); font: 400 var(--sys-fs)/1 var(--sys-font); }
  .c-input.is-focus { color: var(--sys-ink); border-color: var(--sys-accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--sys-accent) 22%, transparent); }
  .c-input.is-error { color: var(--sys-ink); border-color: var(--sys-warn); }
  .c-caret { display: block; width: 1px; height: 16px; margin-left: 1px; background: var(--sys-accent); }
  .c-help { font: 400 var(--sys-fs-sm)/1.2 var(--sys-mono); color: var(--sys-dim); }
  .c-help.is-error { color: var(--sys-warn); }

  .c-start { display: grid; grid-template-columns: 14px minmax(0, 1fr) auto; align-items: center; gap: 8px; height: var(--sys-row); padding-inline: 10px; background: var(--sys-paper); border: 1px solid var(--sys-line); border-radius: var(--sys-radius-sm); color: var(--sys-ink); font: 500 var(--sys-fs)/1 var(--sys-font); }
  .c-start.is-hover { background: var(--sys-field); border-color: color-mix(in srgb, var(--sys-accent) 45%, var(--sys-line)); }
  .c-start.is-running { border-color: color-mix(in srgb, var(--sys-accent) 45%, var(--sys-line)); }
  .c-ic { font-family: var(--sys-mono); color: var(--sys-accent); }
  .c-start.is-done .c-ic { color: var(--sys-ok); }
  .c-lab { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .c-dots { display: inline-flex; gap: 2px; }
  .c-dots i { display: block; width: 4px; height: 4px; border-radius: 50%; background: var(--sys-accent); }

  .c-chip { display: inline-flex; align-items: center; height: 20px; padding-inline: 6px; background: var(--sys-field); border: 1px solid var(--sys-line); border-radius: var(--sys-radius-sm); color: var(--sys-dim); font: 500 var(--sys-fs-sm)/1 var(--sys-mono); letter-spacing: 0.04em; white-space: nowrap; }

  .c-msg { display: grid; gap: 8px; justify-items: start; max-width: 88%; padding: 8px 12px; border-radius: var(--sys-radius); color: var(--sys-ink); font: 400 var(--sys-fs-lg)/1.4 var(--sys-font); }
  .c-msg.is-user { background: color-mix(in srgb, var(--sys-accent) 12%, transparent); border-bottom-right-radius: var(--sys-radius-sm); }
  .c-msg.is-asst { background: var(--sys-field); border-bottom-left-radius: var(--sys-radius-sm); }
  .c-msg .c-chip { background: var(--sys-paper); }

  .c-rail { display: grid; gap: 2px; }
  .c-tab { display: flex; align-items: center; height: var(--sys-row); padding-inline: 12px; border-radius: var(--sys-radius-sm); color: var(--sys-dim); font: 500 var(--sys-fs)/1 var(--sys-font); }
  .c-tab.is-selected { background: var(--sys-field); color: var(--sys-ink); border-radius: 0 var(--sys-radius-sm) var(--sys-radius-sm) 0; box-shadow: inset 2px 0 0 var(--sys-accent); }

  @media (prefers-reduced-motion: no-preference) {
    .sys-sq, .sys-stage, .c-btn, .c-input, .c-start, .c-chip, .c-msg, .c-tab, .c-help, .sp-st, .sp-grp { transition: background-color 0.24s ease, color 0.24s ease, border-color 0.24s ease, box-shadow 0.24s ease; }
    .c-dots i { animation: chs-sys-dot 1.1s ease-in-out infinite; }
    .c-dots i:nth-child(2) { animation-delay: 0.15s; }
    .c-dots i:nth-child(3) { animation-delay: 0.3s; }
  }
  @keyframes chs-sys-dot { 0%, 80%, 100% { opacity: 0.3; } 40% { opacity: 1; } }

  /* doc cards: the room's faces */
  .sys-doc { display: grid; gap: 6px; }
  .sys-doc-name { margin-block: 0; font: 500 1rem/1.25 var(--rm-display); letter-spacing: 0; color: var(--rm-ink); }
  .sys-doc-what { font: 400 0.875rem/1.45 var(--rm-sans); color: var(--rm-ink); }
  .sys-doc-meta { display: grid; grid-template-columns: 4.75rem minmax(0, 1fr); gap: 8px; font: 400 0.6875rem/1.45 var(--rm-mono); color: var(--rm-ink); }
  .sys-doc-meta > span:first-child { letter-spacing: 0.12em; color: var(--rm-dim); }

  /* adopted by: names only, hairline-ruled */
  .sys-adopt-list { list-style: none; margin-block: 0; padding-left: 0; border-top: 1px solid var(--rm-line); }
  .sys-adopt-list li { padding-block: 8px; border-bottom: 1px solid var(--rm-line); font: 400 0.8125rem/1.4 var(--rm-mono); color: var(--rm-ink); }

  @container chs-sys (max-width: 980px) {
    .sys-swatches { grid-template-columns: repeat(5, minmax(0, 1fr)); }
    .sys-specs, .sys-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @container chs-sys (max-width: 560px) {
    .sys-swatches { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .sys-grid { grid-template-columns: minmax(0, 1fr); }
  }
</style>
