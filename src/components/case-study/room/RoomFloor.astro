---
/**
 * RoomFloor — the floor of a case study in the room's material: one hairline on the ROOM's text column (the 1032 the
 * study's words stand in, so nothing slides under the rail), then the house floor centred beneath it (SiteFloor.astro:
 * email + LinkedIn, unchanged). The study-names row is GONE since 2026-10-15 (Jon: "remove the footer to the case
 * studies given we have a navbar … maybe just have email and linkedin icon") — the rail carries the studies now.
 * The older material (Momence) keeps the plain floor.
 */
import SiteFloor from "../../studio/SiteFloor.astro";
---

<div class="rf">
  <SiteFloor />
</div>

<style>
  .rf {
    box-sizing: border-box;
    width: calc(100% - 48px); /* the room's text column: its 1080 less its 24 px gutters */
    max-width: 1032px;
    margin: 96px auto 0;
    padding: 40px 0 48px;
    border-top: 1px solid var(--rm-line);
  }
  /* the house floor stands alone under the line: its own line and box give way */
  .rf :global(.floor) { max-width: none; margin: 0; padding: 0; border-top: 0; }
  @media (max-width: 899px) {
    .rf { width: auto; margin-left: 14px; margin-right: 14px; }
  }
</style>
