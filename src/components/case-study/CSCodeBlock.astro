---
// Lightweight code block. Mono, dark, with a filename caret at the top
// and an optional language tag. No full syntax highlighter — these pages
// are about narrative, and an unhighlighted block with thoughtful color
// hints reads as authentic engineering work.
interface Props {
  /** File path / breadcrumb shown above the code. */
  file?: string;
  /** Short language tag (e.g. "py", "ts", "bash"). Cosmetic only. */
  lang?: string;
  /** Caption rendered below. */
  caption?: string;
}

const { file, lang, caption } = Astro.props;
---

<figure class="cs-code">
  {(file || lang) && (
    <div class="cs-code-head">
      {file && <span class="cs-code-file">{file}</span>}
      {lang && <span class="cs-code-lang">{lang}</span>}
    </div>
  )}
  <pre class="cs-code-pre"><code><slot /></code></pre>
  {caption && <figcaption class="cs-code-caption">{caption}</figcaption>}
</figure>

<style>
  .cs-code {
    margin: 28px 0;
    background: var(--cs-surface);
    border: 1px solid var(--cs-line);
    border-radius: 4px;
    overflow: hidden;
  }
  .cs-code-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 14px;
    border-bottom: 1px solid var(--cs-line);
    background: rgba(245, 241, 232, 0.02);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11px;
    letter-spacing: 0.06em;
  }
  .cs-code-file { color: rgba(245, 241, 232, 0.72); }
  .cs-code-lang {
    color: var(--brand-cyan);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-weight: 700;
  }
  .cs-code-pre {
    margin: 0;
    padding: 16px 18px;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 13px;
    line-height: 1.55;
    color: #f5f1e8;
    overflow-x: auto;
    white-space: pre;
  }
  .cs-code-caption {
    border-top: 1px solid var(--cs-line);
    padding: 10px 14px;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-style: italic;
    font-size: 12px;
    color: rgba(245, 241, 232, 0.55);
  }
</style>
