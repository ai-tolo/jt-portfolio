---
// The short version — the mobile triage layer (Jon, 2026-08-24). A phone
// visit is a 60-second credibility check, not a deep read; this block
// answers it right under the hero and then gets out of the way. Desktop
// never renders it (the full piece IS the desktop experience). Row copy
// is assembled from each page's own facts — Jon rewrites at will.
interface Props {
  rows: { k: string; v: string }[];
}
const { rows } = Astro.props;
---

<aside class="cs-short">
  <p class="cs-short-eyebrow">the short version</p>
  <dl class="cs-short-rows">
    {rows.map((r) => (
      <>
        <dt>{r.k}</dt>
        <dd>{r.v}</dd>
      </>
    ))}
  </dl>
</aside>

<style>
  .cs-short {
    display: none;
  }
  @media screen and (max-width: 899px) {
    .cs-short {
      display: block;
      margin: 20px 20px 6px;
      padding: 16px 16px 8px;
      border: 1px solid var(--cs-line-strong);
      border-radius: 8px;
      background: var(--cs-surface);
    }
    .cs-short-eyebrow {
      margin: 0 0 12px;
      font-family: var(--cs-mono);
      font-size: 0.64rem;
      letter-spacing: 0.08em;
      color: var(--cs-text-dim);
    }
    .cs-short-rows {
      margin: 0;
    }
    .cs-short-rows dt {
      font-family: var(--cs-mono);
      font-size: 0.62rem;
      letter-spacing: 0.06em;
      color: var(--cs-text-muted);
      margin: 0 0 3px;
    }
    .cs-short-rows dd {
      margin: 0 0 12px;
      font-size: 0.92rem;
      line-height: 1.5;
      color: var(--cs-text);
    }
  }
</style>
