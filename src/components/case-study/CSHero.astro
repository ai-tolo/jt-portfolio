---
// Full-bleed hero for a custom case study. Pairs an editorial title with
// a wordmark / brand mark slot and a meta dl. Background image is full
// width, content is over-laid with a vertical gradient so the wordmark
// reads against any cover.
interface Props {
  /** "Case study 02" eyebrow. */
  eyebrow?: string;
  /** Title in the wordmark slot. Use the brand name directly. */
  title: string;
  /** Subtitle / deck. Short. */
  subtitle?: string;
  /** Background image URL. Optional — a quiet gradient is rendered if absent. */
  cover?: string;
  /** Meta items rendered as a dl strip below the deck. */
  meta?: { label: string; value: string }[];
  /** Use the brand gradient on the title text. Default true. */
  brandGradientTitle?: boolean;
}

const {
  eyebrow,
  title,
  subtitle,
  cover,
  meta = [],
  brandGradientTitle = true,
} = Astro.props;
---

<section class="cs-hero cs-bleed">
  {cover && (
    <div class="cs-hero-bg" style={`background-image: url("${cover}");`}></div>
  )}
  <div class="cs-hero-veil"></div>

  <div class="cs-hero-grid">
    {eyebrow && <p class="cs-hero-eyebrow">{eyebrow}</p>}

    <h1 class:list={["cs-hero-title", { brand: brandGradientTitle }]}>
      {title}
    </h1>

    {subtitle && <p class="cs-hero-subtitle">{subtitle}</p>}

    {meta.length > 0 && (
      <dl class="cs-hero-meta">
        {meta.map((m) => (
          <div>
            <dt>{m.label}</dt>
            <dd>{m.value}</dd>
          </div>
        ))}
      </dl>
    )}
  </div>
</section>

<style>
  .cs-hero {
    position: relative;
    min-height: 78vh;
    padding: 72px 48px 64px;
    overflow: hidden;
    isolation: isolate;
    border-bottom: 1px solid rgba(245, 241, 232, 0.06);
  }

  .cs-hero-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    z-index: -2;
    /* Heavy filter: desaturate the cover image to a near-monochrome
       marble texture so the existing wordmark / ENTER button blur into
       the background. The hero's own wordmark + meta read clean over it. */
    opacity: 0.42;
    filter: saturate(0.35) contrast(0.78) brightness(0.55) blur(1px);
  }

  .cs-hero-veil {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(140% 110% at 50% 50%, rgba(7, 6, 12, 0.74) 0%, rgba(7, 6, 12, 0.32) 55%, transparent 100%),
      linear-gradient(180deg, rgba(7, 6, 12, 0.78) 0%, rgba(7, 6, 12, 0.42) 32%, rgba(7, 6, 12, 0.62) 70%, rgba(7, 6, 12, 0.92) 100%);
    mix-blend-mode: normal;
  }
  /* A subtle brand tint over the top, picks up the wordmark gradient. */
  .cs-hero::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(50% 40% at 18% 86%, rgba(255, 39, 97, 0.14) 0%, transparent 100%),
      radial-gradient(60% 50% at 82% 14%, rgba(14, 196, 252, 0.10) 0%, transparent 100%);
  }

  .cs-hero-grid {
    max-width: 1160px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-end;
    min-height: calc(78vh - 136px);
    gap: 18px;
  }

  .cs-hero-eyebrow {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: rgba(245, 241, 232, 0.62);
    margin: 0;
  }

  .cs-hero-title {
    font-family: "Space Grotesk Variable", "Space Grotesk", ui-sans-serif, system-ui, sans-serif;
    font-weight: 700;
    font-size: clamp(56px, 11vw, 144px);
    letter-spacing: -0.04em;
    line-height: 0.92;
    margin: 0;
    color: #f5f1e8;
  }
  .cs-hero-title.brand {
    background: linear-gradient(90deg, #ff2761 0%, #ff5a3c 38%, #ffb347 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 6px 32px rgba(255, 89, 60, 0.25));
  }

  .cs-hero-subtitle {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-style: italic;
    font-size: clamp(18px, 2.2vw, 26px);
    line-height: 1.35;
    color: rgba(245, 241, 232, 0.82);
    max-width: 36ch;
    margin: 0;
    border-left: 2px solid var(--brand-orange);
    padding-left: 18px;
  }

  .cs-hero-meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 20px;
    border-top: 1px solid rgba(245, 241, 232, 0.16);
    padding-top: 24px;
    margin: 24px 0 0;
    width: 100%;
    max-width: 880px;
  }
  .cs-hero-meta div {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .cs-hero-meta dt {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(245, 241, 232, 0.48);
  }
  .cs-hero-meta dd {
    margin: 0;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-style: italic;
    font-size: 13px;
    color: rgba(245, 241, 232, 0.88);
  }
</style>
