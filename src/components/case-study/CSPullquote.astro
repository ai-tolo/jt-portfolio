---
// A principle / pull-quote treatment. Use sparingly — these stop the
// reader. The brand-gradient left border earns the attention.
interface Props {
  /** Cite below the quote — short, byline-style. */
  cite?: string;
  /** Treat the quote as the central principle (oversized). */
  hero?: boolean;
}

const { cite, hero = false } = Astro.props;
---

<blockquote class:list={["cs-pullquote", { hero }]}>
  <div class="cs-pullquote-bar" aria-hidden="true"></div>
  <div class="cs-pullquote-body">
    <slot />
    {cite && <cite>{cite}</cite>}
  </div>
</blockquote>

<style>
  .cs-pullquote {
    display: grid;
    grid-template-columns: 4px 1fr;
    gap: 22px;
    margin: 28px 0;
    padding: 8px 0;
    max-width: 64ch;
  }
  .cs-pullquote-bar {
    background: var(--brand-grad);
    border-radius: 2px;
  }
  .cs-pullquote-body {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-style: italic;
    font-size: 22px;
    line-height: 1.35;
    color: var(--cs-text);
  }
  .cs-pullquote.hero {
    margin: 40px 0;
  }
  .cs-pullquote.hero .cs-pullquote-body {
    font-size: 30px;
    line-height: 1.25;
  }
  .cs-pullquote cite {
    display: block;
    font-style: normal;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(245, 241, 232, 0.45);
    margin-top: 14px;
  }
</style>
