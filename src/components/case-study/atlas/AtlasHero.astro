---
// Cold-open hero for The Lathe. A full-bleed dark stage: the
// brand-gradient wordmark over a sparse, slow drift of filename "ghosts"
// (the chaos, foreshadowed at low opacity). One ghost — Audio 14.wav — glints
// brighter: the protagonist file we follow through the whole scroll.
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  meta?: { label: string; value: string }[];
  // Optional lexicon gloss: a subtle, hover/focus-revealed dictionary entry
  // (desktop flourish; the card is suppressed on touch where hover can't fire).
  glossary?: {
    term: string;
    ipa?: string;
    pos?: string;
    senses: { tag?: string; text: string }[];
    etymology?: string;
  };
}
const { eyebrow, title, subtitle, meta = [], glossary } = Astro.props;

// Deterministic ghost field — placement derived from index so SSR is stable
// (no runtime randomness). ~34 evocative scattered-audio names. The first
// entry is the protagonist; `hero: true` brightens it.
const GHOSTS = [
  "Audio 14.wav", "New Recording 7.m4a", "Untitled.als", "jam_sunday_2.wav",
  "voice memo 41.m4a", "bounce_v1.wav", "bounce_v1 (2).wav", "idea.wav",
  "FINAL_master.wav", "FINAL_master_real.wav", "Splice_kick_03.wav", "2023-02-18.wav",
  "demo_mix.mp3", "chorus?.wav", "weird synth thing.wav", "guitar loop.wav",
  "808_sub.wav", "vox_chop.wav", "car demo.m4a", "Audio 15.wav",
  "Audio 9.wav", "project_OLD.als", "Untitled (1).als", "shower idea.m4a",
  "3am.wav", "backup_final.wav", "track2_real_final.wav", "snippet.wav",
  "humming.m4a", "recording.wav", "mix_for_jake.wav", "loopz.wav",
  "rain_outside.m4a", "the good one.wav",
];
// pseudo-random but deterministic spread
const ghosts = GHOSTS.map((name, i) => {
  const a = Math.sin(i * 12.9898) * 43758.5453;
  const b = Math.sin(i * 78.233) * 12733.142;
  const c = Math.sin(i * 39.425) * 24634.633;
  const fr = (x: number) => x - Math.floor(x);
  const hero = i === 0;
  return {
    name,
    hero,
    // The protagonist glint gets a deliberate, unclipped spot in open space
    // (upper-right, clear of the wordmark). Others spread, pulled in from the
    // edges so chips never clip.
    left: hero ? 74 : 9 + fr(a) * 80,
    top: hero ? 24 : 8 + fr(b) * 82,
    dur: 14 + fr(c) * 16,
    delay: -fr(a) * 18,
    drift: 12 + fr(b) * 26,
    rot: (fr(c) - 0.5) * 10,
    scale: 0.82 + fr(a) * 0.5,
  };
});
---

<section class="ah-hero cs-bleed">
  <div class="ah-ghosts" aria-hidden="true">
    {ghosts.map((g) => (
      <span
        class:list={["ah-ghost", { "ah-ghost-hero": g.hero }]}
        style={`left:${g.left}%; top:${g.top}%; --dur:${g.dur}s; --delay:${g.delay}s; --drift:${g.drift}px; --rot:${g.rot}deg; --scale:${g.scale};`}
      >
        {g.hero && (
          <svg class="ah-ghost-wave" viewBox="0 0 60 16" preserveAspectRatio="none" aria-hidden="true">
            <path d="M0,8 Q4,2 8,8 T16,8 T24,8 Q28,14 32,8 T40,8 T48,8 Q52,3 56,8 T60,8" fill="none" stroke="currentColor" stroke-width="1.2" />
          </svg>
        )}
        <span class="ah-ghost-name">{g.name}</span>
      </span>
    ))}
  </div>

  <div class="ah-veil"></div>

  <div class="ah-grid">
    {eyebrow && <p class="ah-eyebrow">{eyebrow}</p>}
    <div
      class:list={["ah-titlewrap", { "ah-gloss": glossary }]}
      tabindex={glossary ? "0" : undefined}
      aria-label={glossary ? `Definition of ${glossary.term}` : undefined}
    >
      <h1 class="ah-title">{title}</h1>
      {glossary && (
        <span class="ah-gloss-mark" aria-hidden="true">
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 1.6a6.4 6.4 0 100 12.8A6.4 6.4 0 008 1.6zM8 7.2v3.6M8 4.7h.01" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
        </span>
      )}
      {glossary && (
        <span class="ah-gloss-card" role="tooltip">
          <span class="ah-gloss-cardhead">
            <span class="ah-gloss-term">{glossary.term}</span>
            {glossary.ipa && <span class="ah-gloss-ipa">{glossary.ipa}</span>}
            {glossary.pos && <span class="ah-gloss-pos">{glossary.pos}</span>}
          </span>
          {glossary.senses.map((s, i) => (
            <span class="ah-gloss-sense">
              <span class="ah-gloss-num">{i + 1}</span>
              <span>
                {s.tag && <span class="ah-gloss-tag">{s.tag}</span>}
                {s.text}
              </span>
            </span>
          ))}
          {glossary.etymology && <span class="ah-gloss-ety">{glossary.etymology}</span>}
        </span>
      )}
    </div>

    {subtitle && <p class="ah-subtitle">{subtitle}</p>}

    {meta.length > 0 && (
      <dl class="ah-meta">
        {meta.map((m) => (
          <div>
            <dt>{m.label}</dt>
            <dd set:html={m.value} />
          </div>
        ))}
      </dl>
    )}

    <div class="ah-scrollcue" aria-hidden="true">
      <span>scroll</span>
      <svg viewBox="0 0 12 22" width="12" height="22"><path d="M6 1 v16 M2 13 l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </div>
  </div>
</section>

<style>
  .ah-hero {
    position: relative;
    min-height: 94vh;
    display: flex;
    align-items: flex-end;
    padding: 80px 48px 56px;
    overflow: hidden;
    isolation: isolate;
    border-bottom: 1px solid var(--cs-line);
  }

  /* ── Drifting filename ghosts ── */
  .ah-ghosts { position: absolute; inset: 0; z-index: -2; pointer-events: none; }
  .ah-ghost {
    position: absolute;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 12px;
    white-space: nowrap;
    color: rgba(245, 241, 232, 0.07);
    transform: translate(-50%, -50%) rotate(var(--rot)) scale(var(--scale));
    animation: ah-drift var(--dur) ease-in-out var(--delay) infinite alternate;
    will-change: transform, opacity;
  }
  .ah-ghost-hero {
    color: rgba(14, 196, 252, 0.5);
    font-size: 13px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    text-shadow: 0 0 18px rgba(14, 196, 252, 0.45);
    animation: ah-drift var(--dur) ease-in-out var(--delay) infinite alternate, ah-glint 4.5s ease-in-out infinite;
    z-index: 1;
  }
  .ah-ghost-wave { width: 46px; height: 13px; color: var(--brand-cyan); opacity: 0.9; }

  @keyframes ah-drift {
    from { transform: translate(-50%, -50%) rotate(var(--rot)) scale(var(--scale)); }
    to { transform: translate(calc(-50% + var(--drift)), calc(-50% - var(--drift))) rotate(var(--rot)) scale(var(--scale)); }
  }
  @keyframes ah-glint {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 1; }
  }

  .ah-veil {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(60% 50% at 22% 88%, rgba(255, 39, 97, 0.12) 0%, transparent 100%),
      radial-gradient(60% 50% at 82% 12%, rgba(14, 196, 252, 0.10) 0%, transparent 100%),
      linear-gradient(180deg, rgba(7, 6, 12, 0.55) 0%, rgba(7, 6, 12, 0.2) 36%, rgba(7, 6, 12, 0.55) 74%, rgba(7, 6, 12, 0.94) 100%);
  }

  .ah-grid {
    position: relative;
    max-width: 1160px;
    margin: 0 auto;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
  }

  .ah-eyebrow {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--cs-text-muted);
    margin: 0;
  }

  .ah-title {
    font-family: "Space Grotesk Variable", "Space Grotesk", ui-sans-serif, system-ui, sans-serif;
    font-weight: 700;
    font-size: clamp(52px, 10.5vw, 150px);
    letter-spacing: -0.045em;
    line-height: 0.9;
    margin: 0;
    background: linear-gradient(92deg, #ff2761 0%, #ff5a3c 42%, #ffb347 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 8px 40px rgba(255, 89, 60, 0.28));
  }

  .ah-subtitle {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-style: italic;
    font-size: clamp(17px, 2.1vw, 25px);
    line-height: 1.4;
    color: rgba(245, 241, 232, 0.88);
    max-width: 40ch;
    margin: 4px 0 0;
    border-left: 2px solid var(--brand-orange);
    padding-left: 18px;
  }

  /* ── Lathe lexicon gloss: the ⓘ is attached to the wordmark itself; hovering
        or focusing the title reveals a dictionary card below it. Desktop
        flourish (suppressed on touch, where hover can't fire). ── */
  .ah-titlewrap {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: clamp(8px, 1vw, 16px);
    max-width: 100%;
  }
  .ah-gloss { cursor: help; outline: none; }

  .ah-gloss-mark {
    flex: 0 0 auto;
    margin-top: clamp(6px, 1.3vw, 20px);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: clamp(20px, 2vw, 28px);
    height: clamp(20px, 2vw, 28px);
    border-radius: 50%;
    color: var(--cs-text-muted);
    border: 1px solid var(--cs-line-strong);
    transition: color 160ms ease, border-color 160ms ease, background 160ms ease;
  }
  .ah-gloss-mark svg { width: 58%; height: 58%; display: block; }
  .ah-gloss:hover .ah-gloss-mark,
  .ah-gloss:focus-visible .ah-gloss-mark {
    color: var(--brand-orange);
    border-color: var(--brand-orange);
    background: rgba(255, 90, 60, 0.08);
  }

  .ah-gloss-card {
    position: absolute;
    top: calc(100% + 14px);
    left: 0;
    z-index: 5;
    width: min(440px, 86vw);
    padding: 16px 18px 14px;
    background: rgba(9, 8, 13, 0.97);
    border: 1px solid var(--cs-line-strong);
    border-left: 2px solid var(--brand-orange);
    border-radius: 7px;
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.55);
    opacity: 0;
    visibility: hidden;
    transform: translateY(5px);
    transition: opacity 180ms ease, transform 180ms ease, visibility 0s linear 180ms;
    pointer-events: none;
  }
  /* invisible bridge across the gap so the card stays reachable from the title */
  .ah-gloss-card::before {
    content: "";
    position: absolute;
    top: -16px;
    left: 0;
    right: 0;
    height: 16px;
  }
  .ah-gloss:hover .ah-gloss-card,
  .ah-gloss:focus .ah-gloss-card,
  .ah-gloss:focus-within .ah-gloss-card {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    transition: opacity 180ms ease, transform 180ms ease;
    pointer-events: auto;
  }
  .ah-gloss-cardhead {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0 0 10px;
    padding-bottom: 9px;
    border-bottom: 1px solid var(--cs-line);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  .ah-gloss-term { font-style: italic; font-size: 14px; color: var(--cs-text); }
  .ah-gloss-ipa { font-size: 12.5px; color: var(--cs-text-muted); }
  .ah-gloss-pos {
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--cs-text-dim);
  }
  .ah-gloss-sense {
    display: flex;
    gap: 9px;
    margin: 0 0 10px;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 12.5px;
    line-height: 1.5;
    color: rgba(245, 241, 232, 0.88);
  }
  .ah-gloss-num { flex: none; font-size: 10px; color: var(--brand-orange); padding-top: 2px; }
  .ah-gloss-tag {
    margin-right: 7px;
    font-style: italic;
    color: var(--brand-cyan);
  }
  .ah-gloss-ety {
    display: block;
    margin: 11px 0 0;
    padding-top: 10px;
    border-top: 1px solid var(--cs-line);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-style: italic;
    font-size: 11.5px;
    line-height: 1.45;
    color: var(--cs-text-muted);
  }

  .ah-meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 18px 22px;
    border-top: 1px solid var(--cs-line-strong);
    padding-top: 22px;
    margin: 26px 0 0;
    width: 100%;
    max-width: 900px;
  }
  .ah-meta div { display: flex; flex-direction: column; gap: 5px; }
  .ah-meta dt {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--cs-text-muted);
  }
  .ah-meta dd {
    margin: 0;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-style: italic;
    font-size: 13px;
    color: rgba(245, 241, 232, 0.88);
  }

  .ah-scrollcue {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 30px;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 10px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--cs-text-dim);
  }
  .ah-scrollcue svg { animation: ah-bobcue 1.8s ease-in-out infinite; }
  @keyframes ah-bobcue {
    0%, 100% { transform: translateY(0); opacity: 0.55; }
    50% { transform: translateY(4px); opacity: 1; }
  }

  @media (max-width: 720px) {
    .ah-hero { padding: 72px 24px 44px; min-height: 90vh; }
    .ah-ghost { font-size: 10px; }
    .ah-title { font-size: clamp(34px, 9.2vw, 60px); }
    /* hover-only flourish — drop both the mark and the card on touch */
    .ah-gloss-mark, .ah-gloss-card { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ah-ghost, .ah-ghost-hero, .ah-scrollcue svg { animation: none !important; }
    .ah-gloss-card { transition: opacity 1ms linear; }
  }
</style>
