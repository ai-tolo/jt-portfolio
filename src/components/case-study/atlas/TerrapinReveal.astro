---
// ACT 3 — The track + the companion.
//
// One catalog row (our file, now a finished Track) sits center stage. The
// wish lands — "if only I had an engineer" — and on scroll Terrapin rises in
// with a speech bubble. Hit "Send to Engineer" and Terrapin catches the file:
// the chest oscilloscope amps to its speaking state, a job spins up, six takes
// come back. A down-cue points to the renditions.
import Terrapin from "./Terrapin.astro";

// the track card's waveform (looks like a full song: builds + drops)
const BARS = Array.from({ length: 110 }, (_, i) => {
  const phase = i / 110;
  const build = 0.3 + 0.5 * phase;
  const groove = 0.3 * Math.abs(Math.sin(i * 0.7)) + 0.18 * Math.cos(i * 0.27);
  const drop = phase > 0.45 && phase < 0.92 ? 0.25 : 0;
  return Math.round(Math.max(0.14, Math.min(1, build * 0.6 + groove + drop)) * 100);
});
---

<section class="tr" data-tr aria-label="The track meets the engineer">
  <div class="tr-stage">
    <!-- the track card -->
    <div class="tr-card" data-tr-card>
      <div class="tr-card-pill">TRACK</div>
      <div class="tr-card-title"><span>Audio 14</span><i>.wav</i></div>
      <div class="tr-card-sub"><b>100</b> BPM · <b>C</b> major · 3:24</div>
      <div class="tr-card-waverow">
        <span class="tr-card-dur" data-tr-dur>0:00</span>
        <div class="tr-card-wave" data-tr-wave>
          {BARS.map((h) => <span class="tr-card-bar" style={`height:${h}%`}></span>)}
          <div class="tr-card-ph" data-tr-ph></div>
        </div>
      </div>
      <div class="tr-card-date">2y · [05-12-2024] · bounced from “the good one.als”</div>
      <button type="button" class="tr-send" data-tr-send>→ Send to Engineer</button>
    </div>

    <!-- the companion -->
    <div class="tr-engineer" data-tr-eng>
      <div class="tr-speech" data-tr-speech>
        <p data-tr-line>Hey — I'm <b>Terrapin</b>, your engineer. Send that track over and I'll bring back six options, mixed toward records you love.</p>
      </div>
      <div class="tr-turtle-wrap">
        <Terrapin size={150} class="tr-turtle" />
        <div class="tr-job" data-tr-job aria-live="polite"></div>
      </div>
    </div>
  </div>

  <p class="tr-wish" data-tr-wish>It's a finished track now. Mixed rough, on headphones, at 2&nbsp;a.m. — <em>if only I had an engineer.</em></p>

  <div class="tr-cue" data-tr-cue aria-hidden="true">
    <span>hear what came back</span>
    <svg viewBox="0 0 12 22" width="12" height="22"><path d="M6 1 v16 M2 13 l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-tr]").forEach((root) => {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const eng = root.querySelector<HTMLElement>("[data-tr-eng]");
    const card = root.querySelector<HTMLElement>("[data-tr-card]");
    const sendBtn = root.querySelector<HTMLButtonElement>("[data-tr-send]");
    const turtle = root.querySelector<HTMLElement>(".atlas-turtle");
    const job = root.querySelector<HTMLElement>("[data-tr-job]");
    const line = root.querySelector<HTMLElement>("[data-tr-line]");
    const cue = root.querySelector<HTMLElement>("[data-tr-cue]");
    const ph = root.querySelector<HTMLElement>("[data-tr-ph]");
    const durEl = root.querySelector<HTMLElement>("[data-tr-dur]");
    const wave = root.querySelector<HTMLElement>("[data-tr-wave]");

    // reveal the engineer when the scene enters
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) if (e.isIntersecting) { root.dataset.revealed = "true"; io.disconnect(); }
    }, { threshold: 0.4 });
    io.observe(root);

    // visual-only playhead sweep on the card (the real audio is the rendition
    // toggle two scenes down)
    let sweep = 0;
    wave?.addEventListener("click", () => {
      if (sweep) { cancelAnimationFrame(sweep); sweep = 0; if (ph) ph.style.left = "0%"; if (durEl) durEl.textContent = "0:00"; return; }
      const start = performance.now();
      const DUR = 8;
      const tick = (now: number) => {
        const t = ((now - start) / 1000) % DUR;
        if (ph) ph.style.left = `${(t / DUR) * 100}%`;
        const cs = Math.floor((t / DUR) * 204); // 3:24 = 204s
        if (durEl) durEl.textContent = `${Math.floor(cs / 60)}:${String(cs % 60).padStart(2, "0")}`;
        sweep = requestAnimationFrame(tick);
      };
      sweep = requestAnimationFrame(tick);
    });

    let sent = false;
    sendBtn?.addEventListener("click", () => {
      if (sent) return;
      sent = true;
      card?.setAttribute("data-sent", "true");
      sendBtn.textContent = "✓ queued · job #73";
      turtle?.setAttribute("data-speaking", "true");
      if (line) line.innerHTML = "Got it. Listening to <b>Audio&nbsp;14</b> now — pulling references, mastering six ways…";
      if (job) job.textContent = "rendering 6 variants across 3 taste axes";
      const done = () => {
        if (job) job.innerHTML = "✓ 6 takes ready";
        if (line) line.innerHTML = "Done. Three pairs to judge — but first, just <b>listen</b>. Same eight seconds, three ways.";
        cue?.setAttribute("data-on", "true");
      };
      if (reduce) done();
      else window.setTimeout(done, 2100);
    });
  });
</script>

<style>
  .tr { position: relative; padding: 20px 0 8px; }
  .tr-stage {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: 40px;
    max-width: 1000px;
    margin: 0 auto;
  }
  @media (max-width: 820px) {
    .tr-stage { grid-template-columns: 1fr; gap: 24px; }
  }

  /* ── track card ── */
  .tr-card {
    position: relative;
    background: linear-gradient(180deg, rgba(20, 14, 26, 0.96), rgba(13, 9, 17, 0.96));
    border: 1px solid rgba(245, 241, 232, 0.12);
    border-radius: 10px;
    padding: 18px 20px 20px;
    transition: transform 600ms cubic-bezier(0.22, 1, 0.36, 1), box-shadow 400ms ease, border-color 400ms ease;
  }
  .tr[data-revealed="true"] .tr-card { box-shadow: 0 24px 60px -34px rgba(0, 0, 0, 0.8); }
  .tr-card[data-sent="true"] {
    border-color: rgba(0, 255, 77, 0.4);
    box-shadow: 0 0 0 1px rgba(0, 255, 77, 0.25), 0 24px 60px -30px rgba(0, 255, 77, 0.3);
    transform: translateX(-6px) scale(0.99);
  }
  .tr-card-pill {
    position: absolute; top: 16px; right: 16px;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 9px;
    letter-spacing: 0.2em; color: var(--brand-green);
    border: 1px solid rgba(0, 255, 77, 0.35); border-radius: 3px; padding: 3px 7px;
  }
  .tr-card-title {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-style: italic; font-weight: 700;
    font-size: 18px; color: #00ff4d; background: rgba(0, 255, 77, 0.05);
    border: 1px solid rgba(0, 255, 77, 0.3); border-radius: 5px; padding: 6px 11px;
    display: inline-block; box-shadow: 0 0 14px rgba(0, 255, 77, 0.12); margin-bottom: 12px;
  }
  .tr-card-title i { font-size: 60%; color: rgba(245, 241, 232, 0.42); font-style: italic; }
  .tr-card-sub {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-style: italic; font-size: 13px;
    color: rgba(245, 241, 232, 0.55); margin-bottom: 14px;
  }
  .tr-card-sub b { color: var(--brand-cyan); font-weight: 700; }
  .tr-card-waverow { display: flex; align-items: center; gap: 10px; margin-bottom: 12px; }
  .tr-card-dur {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12px; font-feature-settings: "tnum";
    color: var(--brand-pink); text-shadow: 0 0 8px rgba(255, 39, 97, 0.4);
    min-width: 38px; flex: 0 0 auto;
  }
  .tr-card-wave {
    position: relative; flex: 1; height: 46px; background: #07060c; border-radius: 3px;
    display: flex; align-items: center; gap: 1px; padding: 0 5px; overflow: hidden; cursor: pointer;
  }
  .tr-card-bar { flex: 1 1 0; border-radius: 1px; background: linear-gradient(180deg, rgba(0, 255, 77, 0.5), rgba(0, 255, 77, 0.2)); }
  .tr-card-ph { position: absolute; top: 0; bottom: 0; width: 2px; left: 0%; background: #f5f1e8; box-shadow: 0 0 6px rgba(245, 241, 232, 0.6); pointer-events: none; }
  .tr-card-date {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 11px;
    color: rgba(245, 241, 232, 0.38); margin-bottom: 16px;
  }
  .tr-send {
    width: 100%;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-style: italic; font-weight: 700; font-size: 13px;
    color: #0e0c14; background: linear-gradient(90deg, #ff2761 0%, #ff5a3c 50%, #ffb347 100%);
    border: none; border-radius: 5px; padding: 11px; cursor: pointer;
    transition: filter 160ms ease, transform 80ms ease;
  }
  .tr-send:hover { filter: brightness(1.08); }
  .tr-send:active { transform: translateY(1px); }
  .tr-card[data-sent="true"] .tr-send {
    background: rgba(0, 255, 77, 0.1); color: #00ff4d; cursor: default;
    border: 1px solid rgba(0, 255, 77, 0.4);
  }

  /* ── engineer ── */
  .tr-engineer { display: flex; flex-direction: column; align-items: center; gap: 14px; }
  .tr[data-revealed="false"] .tr-engineer { opacity: 0; transform: translateY(40px); }
  .tr-engineer { opacity: 1; transform: none; transition: opacity 700ms ease, transform 700ms cubic-bezier(0.22, 1, 0.36, 1); }

  .tr-speech {
    position: relative;
    background: rgba(14, 196, 252, 0.06);
    border: 1px solid rgba(14, 196, 252, 0.32);
    border-radius: 14px; padding: 14px 18px; max-width: 340px;
    box-shadow: 0 0 24px -8px rgba(14, 196, 252, 0.4);
  }
  .tr-speech::after {
    content: ""; position: absolute; bottom: -9px; left: 50%; transform: translateX(-50%);
    border-left: 9px solid transparent; border-right: 9px solid transparent;
    border-top: 9px solid rgba(14, 196, 252, 0.32);
  }
  .tr-speech p {
    margin: 0; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 13px;
    line-height: 1.5; color: rgba(245, 241, 232, 0.9);
  }
  .tr-speech b { color: var(--brand-cyan); }
  .tr-turtle-wrap { display: flex; flex-direction: column; align-items: center; gap: 8px; }
  .tr-job {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 11.5px;
    color: var(--brand-cyan); min-height: 16px; text-align: center;
  }

  /* ── wish + cue ── */
  .tr-wish {
    max-width: 60ch; margin: 30px auto 0; text-align: center;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 15px; line-height: 1.6;
    color: rgba(245, 241, 232, 0.7);
  }
  .tr-wish em { color: #f5f1e8; font-style: italic; }
  .tr-cue {
    display: flex; flex-direction: column; align-items: center; gap: 4px;
    margin: 22px auto 0; opacity: 0; transition: opacity 500ms ease;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 10px;
    letter-spacing: 0.22em; text-transform: uppercase; color: var(--brand-cyan);
  }
  .tr-cue[data-on="true"] { opacity: 1; }
  .tr-cue svg { animation: tr-bob 1.6s ease-in-out infinite; }
  @keyframes tr-bob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(4px); } }

  @media (prefers-reduced-motion: reduce) {
    .tr-engineer, .tr-card { transition: none; }
    .tr[data-revealed="false"] .tr-engineer { opacity: 1; transform: none; }
    .tr-cue svg { animation: none; }
  }
</style>
