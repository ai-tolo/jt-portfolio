---
// "Louder always wins" — the loudness-bias teacher, now built in the SAME chassis
// as the rendition toggle (§06): the same card, waveform, transport, 3D keycaps,
// and feelable hold-to-vote. Here there are only two takes — and they're the
// EXACT same master, one ~3 dB louder. You audition 1 and 2 blind, hold to vote
// the one that sounds better, and the reveal lands the trick: nothing changed but
// the level. Then "hear them matched" proves it. Reuses one rendition clip.
const CLIP = "/case-studies/the-console/renditions/take3.mp3";
const BARS = Array.from({ length: 96 }, (_, i) => {
  const beat = (i % 16) / 16;
  const kick = beat < 0.06 || (beat > 0.5 && beat < 0.56) ? 1 : 0;
  const swell = 0.42 + 0.3 * Math.sin(i * 0.18) + 0.16 * Math.cos(i * 0.5);
  const arp = 0.16 * Math.abs(Math.sin(i * 1.31));
  return Math.round(Math.max(0.16, Math.min(1, swell + arp + kick * 0.45)) * 100);
});
---

<div class="lb" data-lb data-active="0" data-playing="false" data-revealed="false" data-matched="false" data-clip={CLIP}>
  <header class="lb-head">
    <div class="lb-head-left">
      <span class="lb-source">the same master</span>
      <span class="lb-tag">blind · trust your gut</span>
    </div>
    <span class="lb-loud" title="One of these two is a few dB louder. Match the loudness and they're identical.">⚖ loudness bias</span>
  </header>

  <div class="lb-transport">
    <button type="button" class="lb-play" data-lb-play aria-label="Play / pause">▶</button>
    <span class="lb-time" data-lb-time>0:00 / 0:00</span>
    <span class="lb-now" data-lb-now>Take 1</span>
  </div>

  <div class="lb-wave" data-lb-wave role="img" aria-label="Waveform">
    {BARS.map((h) => <span class="lb-bar" style={`height:${h}%`}></span>)}
    <div class="lb-playhead" data-lb-playhead></div>
  </div>

  <div class="lb-switch" role="group" aria-label="Two takes — tap a number or press 1·2 to switch; hold to vote the better one">
    {[0, 1].map((i) => (
      <button type="button" class="lb-key" data-lb-key={String(i)} data-active={i === 0 ? "true" : "false"} aria-label={`Take ${i + 1} — audition, hold to vote`}>
        <span class="lb-hold-fill" aria-hidden="true"></span>
        <span class="lb-key-num">{i + 1}</span>
        <span class="lb-key-id" data-lb-key-id={String(i)}>Take {i + 1}</span>
      </button>
    ))}
  </div>

  <div class="lb-foot">
    <button type="button" class="lb-reveal" data-lb-reveal>🔍 reveal the trick</button>
    <span class="lb-status" data-lb-status aria-live="polite"></span>
  </div>

  <div class="lb-lesson" data-lb-lesson hidden>
    <p class="lb-lesson-text" data-lb-lesson-text></p>
    <button type="button" class="lb-match" data-lb-match>↔ hear them matched</button>
    <p class="lb-match-note" data-lb-match-note hidden>
      Identical now — switching does nothing. That single honest step is all a fair comparison needs:
      <b>match the loudness first</b>. By hand, for six masters, it's the grind — print each, meter its
      LUFS, nudge the gain a hair, re-check. The toggle below does it for you, blind.
    </p>
  </div>

  <p class="lb-hint">
    <kbd>1</kbd><kbd>2</kbd> switch · hold to <span class="lb-hint-vote">vote</span> · <kbd>R</kbd> reveal the trick
  </p>
</div>

<script>
  const LOUDER_DB = 5.0; // net gap between the two takes (labeled +5, not -2/+3)
  document.querySelectorAll<HTMLElement>("[data-lb]").forEach((root) => {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const playBtn = root.querySelector<HTMLButtonElement>("[data-lb-play]");
    const timeEl = root.querySelector<HTMLElement>("[data-lb-time]");
    const nowEl = root.querySelector<HTMLElement>("[data-lb-now]");
    const wave = root.querySelector<HTMLElement>("[data-lb-wave]");
    const waveBars = [...root.querySelectorAll<HTMLElement>(".lb-bar")];
    const playhead = root.querySelector<HTMLElement>("[data-lb-playhead]");
    const keys = [...root.querySelectorAll<HTMLButtonElement>("[data-lb-key]")];
    const keyIds = [...root.querySelectorAll<HTMLElement>("[data-lb-key-id]")];
    const revealBtn = root.querySelector<HTMLButtonElement>("[data-lb-reveal]");
    const statusEl = root.querySelector<HTMLElement>("[data-lb-status]");
    const lesson = root.querySelector<HTMLElement>("[data-lb-lesson]");
    const lessonText = root.querySelector<HTMLElement>("[data-lb-lesson-text]");
    const matchBtn = root.querySelector<HTMLButtonElement>("[data-lb-match]");
    const matchNote = root.querySelector<HTMLElement>("[data-lb-match-note]");

    // randomize which take is the louder one
    const louder = Math.random() < 0.5 ? 0 : 1;
    const REL = Math.pow(10, -LOUDER_DB / 20);
    const gainForKey = (i: number) => (root.dataset.matched === "true" ? REL : i === louder ? 1 : REL);

    let ctx: AudioContext | null = null, gain: GainNode | null = null, buffer: AudioBuffer | null = null, source: AudioBufferSourceNode | null = null;
    let loaded = false, loadingP: Promise<void> | null = null, playing = false, active = 0, startT = 0, raf = 0, dur = 0;

    const fmt = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, "0")}`;
    const flash = (m: string) => { if (!statusEl) return; statusEl.textContent = m; window.setTimeout(() => { if (statusEl.textContent === m) statusEl.textContent = ""; }, 2600); };

    async function ensureLoaded() {
      if (loaded) return; if (loadingP) return loadingP;
      loadingP = (async () => {
        const AC = window.AudioContext || (window as any).webkitAudioContext;
        ctx = new AC(); gain = ctx.createGain(); gain.connect(ctx.destination);
        const ab = await fetch(root.dataset.clip!).then((r) => r.arrayBuffer());
        buffer = await ctx.decodeAudioData(ab); dur = buffer.duration; drawWave(buffer); loaded = true;
      })();
      return loadingP;
    }
    function drawWave(buf: AudioBuffer) {
      const data = buf.getChannelData(0), N = waveBars.length, step = Math.max(1, Math.floor(data.length / N)); let max = 1e-4; const peaks: number[] = [];
      for (let i = 0; i < N; i++) { let p = 0; const s = i * step; for (let j = 0; j < step; j += 16) { const a = Math.abs(data[s + j] || 0); if (a > p) p = a; } peaks.push(p); if (p > max) max = p; }
      waveBars.forEach((b, i) => (b.style.height = `${Math.max(6, Math.round(Math.pow(peaks[i] / max, 0.7) * 100))}%`));
    }
    function applyGain() { if (ctx && gain) gain.gain.setTargetAtTime(gainForKey(active) * 0.9, ctx.currentTime, 0.02); }

    function setActive(i: number, announce = true) {
      active = i; root.dataset.active = String(i);
      keys.forEach((k, idx) => (k.dataset.active = idx === i ? "true" : "false"));
      if (nowEl) nowEl.textContent = `Take ${i + 1}`;
      applyGain();
      if (announce) flash(`take ${i + 1}`);
    }
    async function play() {
      playBtn?.setAttribute("data-state", "loading");
      try { await ensureLoaded(); await ctx!.resume(); } catch { playBtn?.removeAttribute("data-state"); flash("couldn't load audio"); return; }
      if (!source) { source = ctx!.createBufferSource(); source.buffer = buffer!; source.loop = true; source.connect(gain!); applyGain(); source.start(); startT = ctx!.currentTime; }
      playBtn?.removeAttribute("data-state"); playing = true; root.dataset.playing = "true"; if (playBtn) playBtn.textContent = "❚❚"; tick();
    }
    async function pause() { playing = false; root.dataset.playing = "false"; if (playBtn) playBtn.textContent = "▶"; if (raf) cancelAnimationFrame(raf); await ctx?.suspend(); }
    const toggle = () => (playing ? pause() : play());
    function tick() {
      if (!playing || !ctx) return;
      const el = (ctx.currentTime - startT) % (dur || 1);
      if (playhead) playhead.style.left = `${(el / dur) * 100}%`;
      if (timeEl) timeEl.textContent = `${fmt(el)} / ${fmt(dur)}`;
      raf = requestAnimationFrame(tick);
    }

    function revealTrick(viaVote: number | null) {
      if (root.dataset.revealed === "true") return;
      root.dataset.revealed = "true";
      keyIds.forEach((el, i) => (el.textContent = i === louder ? "+5 dB" : "0 dB"));
      keys[louder].dataset.louder = "true";
      const msg = viaVote === louder
        ? `Gotcha — you picked the <b>louder</b> one. Both takes are the <b>exact same master</b>; Take ${louder + 1} was just <b>5 dB hotter</b>. A hair more level reads as fuller, crisper, “better.” That's loudness bias.`
        : viaVote != null
        ? `Sharp ear — you went <b>against</b> the loud one. They're the <b>same master</b>; Take ${louder + 1} was simply <b>5 dB louder</b>, and most people can't unhear that and call it “better.”`
        : `The trick: Take 1 and Take 2 are the <b>exact same master</b>. Take ${louder + 1} was just <b>5 dB louder</b> — and louder almost always reads as “better.” That's loudness bias.`;
      if (lessonText) lessonText.innerHTML = msg;
      lesson?.removeAttribute("hidden");
    }
    revealBtn?.addEventListener("click", () => revealTrick(null));

    matchBtn?.addEventListener("click", () => {
      root.dataset.matched = "true"; matchBtn.setAttribute("disabled", "true"); matchBtn.textContent = "✓ matched — now switch 1 / 2";
      applyGain(); matchNote?.removeAttribute("hidden");
    });

    // keycaps: tap = switch, hold = vote (reveals the trick)
    keys.forEach((k, i) => {
      let holdTimer = 0, held = false;
      const startHold = (e: Event) => { e.preventDefault(); held = false; k.dataset.holding = "true"; holdTimer = window.setTimeout(() => { held = true; k.dataset.holding = "false"; k.dataset.voted = "true"; if (!playing) play(); setActive(i, false); revealTrick(i); flash(`voted Take ${i + 1}`); }, reduce ? 1 : 650); };
      const endHold = () => { k.dataset.holding = "false"; if (holdTimer) clearTimeout(holdTimer); if (!held) { if (!playing) play(); setActive(i); } };
      k.addEventListener("pointerdown", startHold);
      k.addEventListener("pointerup", endHold);
      k.addEventListener("pointerleave", () => { k.dataset.holding = "false"; if (holdTimer) clearTimeout(holdTimer); });
    });

    wave?.addEventListener("click", () => { if (!playing) play(); });
    playBtn?.addEventListener("click", toggle);

    // keyboard, gated on the demo being in view (matches the rendition toggle)
    root.tabIndex = 0;
    let inView = false;
    new IntersectionObserver((es) => es.forEach((e) => (inView = e.isIntersecting)), { threshold: 0.45 }).observe(root);
    let hovered = false;
    root.addEventListener("pointerenter", () => (hovered = true));
    root.addEventListener("pointerleave", () => (hovered = false));
    document.addEventListener("keydown", (e) => {
      const t = e.target as HTMLElement | null;
      if (t && (t.tagName === "INPUT" || t.tagName === "TEXTAREA" || t.isContentEditable)) return;
      const k = e.key.toLowerCase();
      if (k === "1" || k === "2") { if (!inView) return; e.preventDefault(); if (!playing) play(); setActive(Number(k) - 1); }
      else if (k === "r") { if (!inView) return; e.preventDefault(); revealTrick(null); }
      else if (k === " ") { if (!hovered && !root.contains(document.activeElement)) return; e.preventDefault(); toggle(); }
    });
  });
</script>

<style>
  .lb {
    background: linear-gradient(180deg, rgba(17, 12, 22, 0.96), rgba(11, 8, 15, 0.96));
    border: 1px solid rgba(245, 241, 232, 0.12); border-radius: 10px;
    padding: 22px 24px 18px; color: #f5f1e8; font-family: "Geist Variable", ui-sans-serif, system-ui, sans-serif;
    outline: none; transition: border-color 200ms ease, box-shadow 200ms ease;
  }
  .lb:focus-within { border-color: rgba(255, 150, 80, 0.4); box-shadow: 0 0 0 1px rgba(255, 150, 80, 0.28); }

  .lb-head { display: flex; align-items: center; justify-content: space-between; gap: 14px; margin-bottom: 16px; flex-wrap: wrap; }
  .lb-head-left { display: flex; align-items: center; gap: 12px; min-width: 0; }
  .lb-source { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-style: italic; font-weight: 700; font-size: 16px; color: #f5f1e8; background: rgba(245, 241, 232, 0.05); border: 1px solid rgba(245, 241, 232, 0.2); border-radius: 4px; padding: 5px 11px; }
  .lb-tag { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 10px; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(245, 241, 232, 0.5); }
  .lb-loud { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 10px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--brand-yellow); border: 1px solid rgba(255, 179, 71, 0.4); border-radius: 20px; padding: 4px 11px; cursor: help; }

  .lb-transport { display: flex; align-items: center; gap: 14px; margin-bottom: 12px; }
  .lb-play { width: 38px; height: 38px; border-radius: 50%; flex: 0 0 auto; border: 1px solid rgba(245, 241, 232, 0.3); background: rgba(245, 241, 232, 0.04); color: #f5f1e8; font-size: 13px; cursor: pointer; position: relative; display: flex; align-items: center; justify-content: center; transition: background 160ms ease, border-color 160ms ease; }
  .lb[data-playing="true"] .lb-play { background: rgba(255, 150, 80, 0.08); border-color: rgba(255, 150, 80, 0.5); color: var(--brand-orange); }
  .lb-play[data-state="loading"] { color: transparent; }
  .lb-play[data-state="loading"]::after { content: ""; position: absolute; width: 15px; height: 15px; border: 2px solid rgba(245, 241, 232, 0.6); border-top-color: transparent; border-radius: 50%; animation: lb-spin 0.7s linear infinite; }
  @keyframes lb-spin { to { transform: rotate(360deg); } }
  .lb-time { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-style: italic; font-weight: 700; font-size: 15px; color: #ff3b6e; font-feature-settings: "tnum"; letter-spacing: 0.04em; line-height: 1; text-shadow: 0 0 4px rgba(255, 59, 110, 0.65), 0 0 10px rgba(255, 59, 110, 0.35); }
  .lb-now { margin-left: auto; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 11px; letter-spacing: 0.08em; color: rgba(245, 241, 232, 0.7); background: rgba(245, 241, 232, 0.04); border: 1px solid rgba(245, 241, 232, 0.14); border-radius: 4px; padding: 4px 10px; }

  .lb-wave { position: relative; height: 64px; background: #07060c; border-radius: 4px; overflow: hidden; margin-bottom: 16px; display: flex; align-items: center; gap: 1px; padding: 0 6px; cursor: pointer; }
  .lb-bar { flex: 1 1 0; border-radius: 1px; background: linear-gradient(180deg, rgba(255, 150, 80, 0.6) 0%, rgba(255, 150, 80, 0.24) 100%); transition: height 280ms ease; }
  .lb-playhead { position: absolute; top: 0; bottom: 0; width: 2px; left: 0%; background: #f5f1e8; box-shadow: 0 0 8px rgba(245, 241, 232, 0.6); pointer-events: none; }
  .lb[data-playing="false"] .lb-playhead { opacity: 0.35; }

  /* 3D keycaps — identical chassis to the rendition toggle */
  .lb-switch { display: flex; gap: 8px; margin-bottom: 14px; }
  .lb-key { position: relative; flex: 1; overflow: hidden; display: flex; flex-direction: column; align-items: center; gap: 3px; padding: 12px 10px 11px; cursor: pointer; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; color: #ece3f2; user-select: none; touch-action: none; border: 1px solid rgba(236, 227, 242, 0.22); border-bottom-color: rgba(0, 0, 0, 0.55); border-radius: 8px; background: linear-gradient(180deg, rgba(255, 255, 255, 0.12) 0%, rgba(236, 227, 242, 0.05) 46%, rgba(0, 0, 0, 0.12) 100%); box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.24), inset 0 -2px 4px rgba(0, 0, 0, 0.3), 0 2px 0 rgba(0, 0, 0, 0.5), 0 4px 7px rgba(0, 0, 0, 0.42); transition: transform 120ms ease, box-shadow 120ms ease, border-color 120ms ease, color 120ms ease; }
  .lb-key:hover { border-color: rgba(236, 227, 242, 0.5); color: #fff; transform: translateY(-1px); }
  .lb-key[data-active="true"] { background: linear-gradient(135deg, #ff2d8b, #ff7a3d, #ffd23d); color: #0d060f; border-color: rgba(255, 180, 90, 0.55); border-bottom-color: rgba(120, 45, 10, 0.7); transform: translateY(2px); box-shadow: 0 0 24px rgba(255, 140, 80, 0.5), 0 1px 0 rgba(0, 0, 0, 0.35), inset 0 2px 3px rgba(255, 255, 255, 0.45), inset 0 -3px 6px rgba(150, 55, 10, 0.5); }
  .lb-key-num { font-size: 17px; font-weight: 900; line-height: 1; position: relative; z-index: 2; }
  .lb-key-id { font-size: 10px; letter-spacing: 0.02em; position: relative; z-index: 2; color: inherit; opacity: 0.78; }
  .lb-key[data-louder="true"] .lb-key-id { color: var(--brand-yellow); opacity: 1; font-weight: 700; }
  .lb-key[data-active="true"][data-louder="true"] .lb-key-id { color: #0d060f; }
  .lb-key[data-voted="true"]::before { content: "✓"; position: absolute; top: 3px; right: 6px; font-size: 11px; z-index: 4; color: #ffd23d; }
  .lb-key[data-active="true"][data-voted="true"]::before { color: #0d060f; }
  .lb-hold-fill { position: absolute; inset: 0; border-radius: inherit; z-index: 1; transform-origin: bottom center; transform: scaleY(0); pointer-events: none; background: linear-gradient(180deg, #ffe27a 0%, rgba(255, 150, 80, 0.5) 100%); box-shadow: inset 0 0 20px rgba(255, 255, 255, 0.3); }
  .lb-key[data-holding="true"] .lb-hold-fill { transform: scaleY(1); transition: transform 0.65s linear; }
  .lb-key[data-holding="true"] { transform: translateY(-2px) scale(1.05); border-color: rgba(255, 210, 61, 0.7); box-shadow: 0 0 30px rgba(255, 210, 61, 0.6), 0 5px 12px rgba(0, 0, 0, 0.45); z-index: 3; }
  .lb-key[data-holding="true"] .lb-key-num { animation: lb-holdpulse 0.5s ease-in-out infinite alternate; }
  @keyframes lb-holdpulse { from { transform: scale(1); } to { transform: scale(1.12); } }

  .lb-foot { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; min-height: 22px; }
  .lb-reveal { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 11px; color: rgba(245, 241, 232, 0.66); background: transparent; border: 1px solid rgba(245, 241, 232, 0.2); border-radius: 4px; padding: 6px 12px; cursor: pointer; transition: color 160ms ease, border-color 160ms ease; }
  .lb-reveal:hover { color: #f5f1e8; border-color: rgba(245, 241, 232, 0.45); }
  .lb-status { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 11.5px; color: var(--brand-yellow); }

  .lb-lesson { margin-top: 15px; border-top: 1px solid rgba(245, 241, 232, 0.1); padding-top: 14px; }
  .lb-lesson[hidden] { display: none; }
  .lb-lesson-text { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 13px; line-height: 1.6; color: rgba(245, 241, 232, 0.9); margin: 0 0 14px; max-width: 64ch; }
  .lb-lesson-text b { color: var(--brand-yellow); }
  .lb-match { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12px; cursor: pointer; color: #062330; font-weight: 700; font-style: italic; background: linear-gradient(90deg, #0ec4fc, #19e0ff); border: none; border-radius: 5px; padding: 8px 15px; transition: filter 140ms ease; }
  .lb-match:hover { filter: brightness(1.08); }
  .lb-match[disabled] { background: rgba(14, 196, 252, 0.14); color: var(--brand-cyan); cursor: default; }
  .lb-match-note { margin: 14px 0 0; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12.5px; line-height: 1.6; color: rgba(245, 241, 232, 0.7); max-width: 64ch; }
  .lb-match-note[hidden] { display: none; }
  .lb-match-note b { color: #f5f1e8; }

  .lb-hint { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 10.5px; color: rgba(245, 241, 232, 0.42); margin: 14px 0 0; letter-spacing: 0.03em; max-width: none; }
  .lb-hint kbd { color: rgba(245, 241, 232, 0.78); border: 1px solid rgba(245, 241, 232, 0.22); background: rgba(245, 241, 232, 0.03); border-radius: 2px; padding: 1px 5px; margin: 0 1px; font-size: 10px; }
  .lb-hint-vote { color: var(--brand-yellow); }

  @media (max-width: 640px) { .lb-key-id { font-size: 8px; } .lb-key-num { font-size: 15px; } }
  @media (prefers-reduced-motion: reduce) {
    .lb-bar, .lb-play, .lb-key { transition: none; }
    .lb-hold-fill { transition: none; }
    .lb-key[data-holding="true"] .lb-key-num { animation: none; }
  }
</style>
