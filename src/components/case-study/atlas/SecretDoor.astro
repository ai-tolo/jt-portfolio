---
// THE THRESHOLD — the closing. A piece of Jon's gear sits dark on the bench.
// Power it on, solve its one riddle, and the wall opens onto the console itself,
// running on loop like a thing you're meant to stand and watch.
//
//   gate    → a tall vault-terminal. The POWER button wakes it: a bright cyan
//             light-line traces each panel's perimeter from top-middle to
//             bottom-middle (the screen stays dark until it lands), then the panel
//             warms up fallout-style and a prompt types in. Five little CRTs hold
//             the riddle — 💨 💧 ⛰️ 🔥 and 🔊 — and come up slowly, like old bulbs.
//             A garbled readout extinguishes into "BENDER" on hover, lighting the
//             🔊 panel with it. Type soundbender.
//   cross   → the console, spectated: two substantial, label-free instruments —
//             the index (left) and the kiln (right) — wired by a data highway that
//             ships a track across, fires the kiln, and crowns a master, on a calm
//             satisfying loop. You just watch it run.
//   exit    → a tasteful esc keycap in the corner steps back out.
//
// Touch, keyboard (focus + type + Enter + Esc + focus-trap), reduced-motion all
// work. No-JS shows a sealed, dormant panel.
import Richard from "./Richard.astro";

const WORD = "soundbender";
const SLOTS = Array.from({ length: WORD.length }, (_, i) => i);

// ── 14-segment alphanumeric display geometry (one glyph, viewBox 0 0 60 96) ──
const SEG: Record<string, [number, number, number, number]> = {
  A: [10, 10, 50, 10], B: [50, 10, 50, 48], C: [50, 48, 50, 86], D: [10, 86, 50, 86],
  E: [10, 48, 10, 86], F: [10, 10, 10, 48], G1: [10, 48, 30, 48], G2: [30, 48, 50, 48],
  H: [10, 10, 30, 48], I: [30, 10, 30, 48], J: [50, 10, 30, 48],
  K: [30, 48, 10, 86], L: [30, 48, 30, 86], M: [30, 48, 50, 86],
};
const SEG_ORDER = ["A", "B", "C", "D", "E", "F", "G1", "G2", "H", "I", "J", "K", "L", "M"];
const GLYPH: Record<string, string[]> = {
  B: ["A", "B", "C", "D", "G2", "I", "L"],
  E: ["A", "D", "E", "F", "G1", "G2"],
  N: ["B", "C", "E", "F", "H", "M"],
  D: ["A", "B", "C", "D", "I", "L"],
  R: ["A", "B", "E", "F", "G1", "G2", "M"],
};
const BENDER = ["B", "E", "N", "D", "E", "R"];
// per-glyph vertical jog for the garbled (powered, un-hovered) state
const GOFF = [7, -5, 9, -6, 4, -8];
const ELEMENTS = [
  { e: "💨", el: "air" }, { e: "💧", el: "water" }, { e: "⛰️", el: "earth" }, { e: "🔥", el: "fire" },
];

// ── the crossing: the catalog that streams through the kiln ──
const TIER: Record<string, string> = { jam: "Jam", tracks: "Track", field: "Field", loops: "Loop", inbox: "Inbox" };
const BUCKETS = [
  // BUCKETS[0] is the crowned king mix of the case-study song. SONG_TITLE (see FileTransform.astro).
  { kind: "tracks", title: "head to toe · king mix", dur: "3:48", keeper: true, seed: 7 },
  { kind: "jam", title: "Sunday session · half-time chorus", dur: "123:41", keeper: true, seed: 2 },
  { kind: "loops", title: "descending rhodes · 8 bars", dur: "0:14", seed: 9 },
  { kind: "tracks", title: "supersonic bionic · master v4", dur: "4:12", seed: 5 },
  { kind: "field", title: "Rooftop, 6am · before traffic", dur: "21:38", seed: 4 },
  { kind: "inbox", title: "Note to self · drop the bridge", dur: "0:48", seed: 1 },
  { kind: "jam", title: "car demo · that bassline", dur: "8:03", seed: 8 },
  { kind: "loops", title: "808 sub + shaker", dur: "0:08", seed: 3 },
];
const wbars = (seed: number) => Array.from({ length: 22 }, (_, i) => Math.round((0.24 + 0.58 * Math.abs(Math.sin(i * 0.7 + seed))) * 100));
const AXES = [
  { label: "tone", lo: "bright", hi: "warm", lit: 1, c: "cyan" },
  { label: "width", lo: "dry", hi: "wide", lit: 0, c: "pink" },
  { label: "dynamics", lo: "dense", hi: "open", lit: 1, c: "yellow" },
];
const SEEDS = ["cyan", "cyan", "pink", "pink", "yellow", "yellow"];
const KTICKS = Array.from({ length: 44 }, (_, i) => i);
const KWAVE = Array.from({ length: 19 }, (_, i) => {
  const c = 1 - Math.abs(i - 9) / 11;
  return Math.max(0.16, Math.min(1, (0.34 + 0.5 * Math.abs(Math.sin(i * 0.7))) * (0.5 + 0.5 * c)));
});
---

<section class="sd" data-sd data-powered="off" data-booted="off" aria-label="Step into Tolo.Cloud, the running console">
  <!-- ── the access console ── -->
  <div class="sd-console" data-sd-console>
    <span class="sd-bolt sd-b-tl" aria-hidden="true"></span><span class="sd-bolt sd-b-tr" aria-hidden="true"></span>
    <span class="sd-bolt sd-b-bl" aria-hidden="true"></span><span class="sd-bolt sd-b-br" aria-hidden="true"></span>

    <div class="sd-top">
      <span class="sd-brand">Tolo<span class="sd-brand-dot">.</span>Cloud</span>
      <span class="sd-top-tag" aria-hidden="true">SEC · GATEWAY</span>
      <span class="sd-lock" aria-hidden="true">
        <svg viewBox="0 0 18 18" width="12" height="12"><path d="M5 8V6a4 4 0 018 0v2M4 8h10v6H4z" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </span>
      <button type="button" class="sd-power" data-sd-power aria-label="Power" aria-pressed="false">
        <span class="sd-power-bezel" aria-hidden="true"></span>
        <span class="sd-power-ring" aria-hidden="true"></span>
        <svg class="sd-power-glyph" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.2v8.2" /><path d="M6.3 6.6a8 8 0 1011.4 0" /></svg>
      </button>
    </div>

    <div class="sd-body">
      <!-- the riddle: five little vault-terminal CRTs that wake like old bulbs -->
      <div class="sd-strip" data-sd-decoder tabindex="0" role="button" aria-label="Decode the riddle">
        {[...ELEMENTS, { e: "🔊", el: "sound" }].map((m, i) => (
          <span class:list={["sd-crt", { "sd-crt-sound": m.el === "sound" }]} data-el={m.el} style={`--bd:${(i * 0.3).toFixed(2)}s`} aria-hidden="true">
            <span class="sd-crt-emoji">{m.e}</span>
            <span class="sd-crt-scan"></span><span class="sd-crt-vig"></span>
          </span>
        ))}
      </div>

      <div class="sd-right">
        <!-- the code-entry screen -->
        <div class="sd-screen sd-screen-code" data-sd-trace>
          <svg class="sd-trace" preserveAspectRatio="none" aria-hidden="true"><path class="sd-trace-l"></path><path class="sd-trace-r"></path></svg>
          <span class="sd-roll" aria-hidden="true"></span>
          <span class="sd-screen-label" aria-hidden="true">ACCESS CODE</span>
          <div class="sd-codewrap">
            <div class="sd-prompt" aria-hidden="true"><span class="sd-prompt-txt">ENTER ACCESS CODE</span></div>
            <div class="sd-tiles" aria-hidden="true">
              {SLOTS.map((i) => <span class="sd-tile" data-sd-tile data-i={i} data-lit="false"></span>)}
            </div>
          </div>
          <input class="sd-input" data-sd-input type="text" inputmode="text" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" aria-label="Type the passcode to glimpse the cloud" />
        </div>

        <!-- the decode screen — a garbled readout that extinguishes into BENDER -->
        <div class="sd-screen sd-screen-decode" data-sd-trace data-sd-decoder2 aria-hidden="true">
          <svg class="sd-trace" preserveAspectRatio="none" aria-hidden="true"><path class="sd-trace-l"></path><path class="sd-trace-r"></path></svg>
          <span class="sd-roll" aria-hidden="true"></span>
          <span class="sd-screen-label" aria-hidden="true">DECODE</span>
          <div class="sd-readout" data-sd-readout>
            {BENDER.map((ch, ci) => (
              <span class="sd-glyph" data-sd-glyph data-ci={ci} style={`--oy:${GOFF[ci]}px`}>
                <svg viewBox="0 0 60 96" preserveAspectRatio="xMidYMid meet">
                  {SEG_ORDER.map((s) => {
                    const [x1, y1, x2, y2] = SEG[s];
                    return <line class="sd-seg" data-seg={s} data-on={GLYPH[ch].includes(s) ? "true" : "false"} x1={x1} y1={y1} x2={x2} y2={y2} />;
                  })}
                </svg>
              </span>
            ))}
          </div>
        </div>
      </div>
    </div>

    <div class="sd-foot">
      <span class="sd-grille" aria-hidden="true"></span>
      <span class="sd-foot-tag" data-sd-foottag>press power to wake</span>
      <button type="button" class="sd-q" data-sd-hint aria-label="reveal the passcode" aria-expanded="false">?</button>
      <span class="sd-q-ans" data-sd-hinttext hidden>soundbender</span>
    </div>
  </div>

  <!-- ── the crossing → the console, spectated ── -->
  <div class="sd-cross" data-sd-cross data-phase="idle" hidden>
    <div class="rig" role="dialog" aria-modal="true" aria-label="Tolo.Cloud, the console, running">
      <header class="rig-bar">
        <span class="rig-wm">Tolo<span class="rig-wm-dot">.</span>Cloud</span>
        <button type="button" class="rig-esc" data-sd-exit aria-label="Step back out">
          <span class="rig-esc-key">esc</span>
          <svg viewBox="0 0 20 20" width="13" height="13" aria-hidden="true"><path d="M5 5l10 10M15 5L5 15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
        </button>
      </header>

      <div class="rig-bench">
        <span class="rig-floor" aria-hidden="true"></span>

        <!-- LEFT · the index — a tall archive tower -->
        <section class="inst inst-dex" aria-label="The index, streaming a track out">
          <span class="inst-bolt b1" aria-hidden="true"></span><span class="inst-bolt b2" aria-hidden="true"></span>
          <span class="inst-bolt b3" aria-hidden="true"></span><span class="inst-bolt b4" aria-hidden="true"></span>
          <div class="inst-head">
            <span class="inst-led led-cyan" aria-hidden="true"></span>
            <span class="inst-emblem" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="inst-count">20,279</span>
          </div>
          <div class="inst-screen dex-screen">
            <div class="dex-scroll">
              <div class="dex-track" data-sd-cattrack>
                {[...BUCKETS, ...BUCKETS].map((b, i) => (
                  <article class:list={["dex-card", `k-${b.kind}`]} data-card={i % BUCKETS.length}>
                    <span class="dex-tier">{TIER[b.kind]}</span>
                    <span class="dex-title">{b.title}</span>
                    {b.keeper && <span class="dex-keeper">★</span>}
                    <span class="dex-dur">{b.dur}</span>
                    <span class="dex-wave">{wbars(b.seed).map((h) => <i style={`--h:${h}%`}></i>)}</span>
                  </article>
                ))}
              </div>
            </div>
            <span class="dex-eject" aria-hidden="true"></span>
            <span class="dex-fade" aria-hidden="true"></span>
          </div>
          <div class="inst-foot"><span class="inst-grille" aria-hidden="true"></span><span class="inst-meter" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span></div>
        </section>

        <!-- the data highway -->
        <div class="rig-highway" aria-hidden="true">
          <svg class="hw-svg" viewBox="0 0 240 80" preserveAspectRatio="none">
            <defs>
              <linearGradient id="sdHwy" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0" stop-color="#19e0ff" /><stop offset="0.4" stop-color="#7b5cff" /><stop offset="0.72" stop-color="#ff2d8b" /><stop offset="1" stop-color="#ffd23d" />
              </linearGradient>
            </defs>
            <path class="hw-rail" d="M0 40 H240" fill="none" stroke="rgba(120,170,220,0.22)" stroke-width="2" />
            <path class="hw-lane" d="M0 40 H240" fill="none" stroke="rgba(120,170,220,0.5)" stroke-width="1.4" stroke-dasharray="2 12" />
            <path class="hw-flow" d="M0 40 H240" fill="none" stroke="url(#sdHwy)" stroke-width="2.4" stroke-linecap="round" stroke-dasharray="8 16" />
          </svg>
          <span class="hw-node hw-node-a" aria-hidden="true"></span>
          <span class="hw-node hw-node-b" aria-hidden="true"></span>
          <span class="hw-packet" data-sd-packet aria-hidden="true"><span class="hw-packet-core"></span></span>
        </div>

        <!-- RIGHT · the kiln — a wide mastering desk -->
        <section class="inst inst-kiln" aria-label="The kiln, mastering the track">
          <span class="inst-bolt b1" aria-hidden="true"></span><span class="inst-bolt b2" aria-hidden="true"></span>
          <span class="inst-bolt b3" aria-hidden="true"></span><span class="inst-bolt b4" aria-hidden="true"></span>
          <div class="inst-head">
            <span class="inst-led led-green" aria-hidden="true"></span>
            <span class="kiln-turtle"><Richard size={50} speaking={true} /></span>
            <span class="kiln-state" data-sd-kstate>idle</span>
          </div>
          <div class="inst-screen kiln-screen">
            <div class="kiln-dome" aria-hidden="true">
              <span class="kiln-body"></span>
              <span class="kiln-iris"></span>
              <svg class="kiln-svg" viewBox="0 0 200 200">
                <g class="kiln-ticks" stroke="rgba(120,210,255,0.5)" stroke-width="1.2">
                  {KTICKS.map((i) => {
                    const a = (i / KTICKS.length) * Math.PI * 2;
                    const r1 = i % 4 === 0 ? 82 : 86, r2 = 92;
                    return <line x1={100 + Math.cos(a) * r1} y1={100 + Math.sin(a) * r1} x2={100 + Math.cos(a) * r2} y2={100 + Math.sin(a) * r2} opacity={i % 4 === 0 ? 0.7 : 0.3} />;
                  })}
                </g>
                <circle class="kiln-charge" cx="100" cy="100" r="95" fill="none" stroke="var(--brand-cyan)" stroke-width="2.4" stroke-linecap="round" transform="rotate(-90 100 100)" />
                <g class="kiln-wave">
                  {KWAVE.map((h, i) => <rect class="kiln-wbar" x={100 - 60 + (i * 120) / (KWAVE.length - 1) - 1.2} y={100 - (h * 46) / 2} width="2.4" height={h * 46} rx="1.2" style={`--i:${i}`} />)}
                </g>
                <circle class="kiln-core" cx="100" cy="100" r="22" fill="url(#sdKcore)" />
                <defs><radialGradient id="sdKcore" cx="50%" cy="50%" r="50%"><stop offset="0" stop-color="#eaffff" /><stop offset="42%" stop-color="#19e0ff" /><stop offset="100%" stop-color="#0a3b52" stop-opacity="0" /></radialGradient></defs>
              </svg>
              <span class="kiln-glass"></span>
            </div>
            <div class="kiln-meters">
              {AXES.map((a) => (
                <div class:list={["kiln-axis", `c-${a.c}`]}>
                  <span class="kiln-axis-name">{a.label}</span>
                  <span class="kiln-track"><span class="kiln-fill" style={`--p:${a.lit === 0 ? 26 : 74}%`}></span></span>
                </div>
              ))}
            </div>
            <div class="kiln-out" aria-hidden="true">
              <span class="kiln-bloom">{SEEDS.map((c) => <i class={`s-${c}`}></i>)}</span>
              <span class="kiln-king" data-sd-king>♛</span>
            </div>
          </div>
          <div class="inst-foot"><span class="inst-grille" aria-hidden="true"></span><span class="inst-meter" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span></div>
        </section>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-sd]").forEach((root) => {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const consoleEl = root.querySelector<HTMLElement>("[data-sd-console]");
    const powerBtn = root.querySelector<HTMLButtonElement>("[data-sd-power]");
    const footTag = root.querySelector<HTMLElement>("[data-sd-foottag]");
    const input = root.querySelector<HTMLInputElement>("[data-sd-input]");
    const tiles = Array.from(root.querySelectorAll<HTMLElement>("[data-sd-tile]"));
    const decoders = Array.from(root.querySelectorAll<HTMLElement>("[data-sd-decoder], [data-sd-decoder2]"));
    const strip = root.querySelector<HTMLElement>("[data-sd-decoder]");
    const glyphs = Array.from(root.querySelectorAll<HTMLElement>("[data-sd-glyph]"));
    const traceHosts = Array.from(root.querySelectorAll<HTMLElement>("[data-sd-trace]"));
    const hintBtn = root.querySelector<HTMLButtonElement>("[data-sd-hint]");
    const hintText = root.querySelector<HTMLElement>("[data-sd-hinttext]");
    const cross = root.querySelector<HTMLElement>("[data-sd-cross]");
    const exitBtn = root.querySelector<HTMLElement>("[data-sd-exit]");
    const kstate = root.querySelector<HTMLElement>("[data-sd-kstate]");
    if (!consoleEl || !input || !cross) return;

    const WORD = "soundbender";
    let crossed = false, powered = false, decoded = false, hovering = false, shakeTimer = 0, bootTimer = 0;
    root.dataset.ready = "true";

    const segEls = glyphs.map((g) => Array.from(g.querySelectorAll<SVGLineElement>("[data-seg]")));
    const masks = segEls.map((segs) => segs.map((s) => s.dataset.on === "true"));
    const lockTrue = () => segEls.forEach((segs, gi) => segs.forEach((el, si) => (el.dataset.on = masks[gi][si] ? "true" : "false")));
    const garbleAll = () => segEls.forEach((segs) => segs.forEach((el) => (el.dataset.on = "true")));

    const place = (p: number) => {
      tiles.forEach((el, i) => {
        const lit = i < p;
        el.dataset.lit = String(lit);
        el.textContent = lit ? WORD[i] : "";
        el.dataset.active = String(i === p && powered && !crossed);
      });
    };
    const shake = () => {
      root.dataset.shake = "1";
      window.clearTimeout(shakeTimer);
      shakeTimer = window.setTimeout(() => (root.dataset.shake = "0"), reduce ? 120 : 360);
    };
    const curLen = () => {
      const v = input.value.toLowerCase().replace(/[^a-z]/g, "");
      let p = 0; while (p < v.length && p < WORD.length && v[p] === WORD[p]) p++; return p;
    };

    // ── border trace: one cyan line each side, top-middle → bottom-middle ──
    const buildTrace = (host: HTMLElement) => {
      const pl = host.querySelector<SVGPathElement>(".sd-trace-l");
      const pr = host.querySelector<SVGPathElement>(".sd-trace-r");
      const svg = host.querySelector<SVGSVGElement>("svg.sd-trace");
      if (!pl || !pr || !svg) return;
      const w = host.clientWidth, h = host.clientHeight;
      if (!w || !h) return;
      const r = Math.max(2, Math.min(parseFloat(getComputedStyle(host).borderTopLeftRadius) || 12, Math.min(w, h) / 2 - 1));
      svg.setAttribute("viewBox", `0 0 ${w} ${h}`);
      pr.setAttribute("d", `M${w / 2} 1 H${w - r} A${r} ${r} 0 0 1 ${w - 1} ${r} V${h - r} A${r} ${r} 0 0 1 ${w - r} ${h - 1} H${w / 2}`);
      pl.setAttribute("d", `M${w / 2} 1 H${r} A${r} ${r} 0 0 0 1 ${r} V${h - r} A${r} ${r} 0 0 0 ${r} ${h - 1} H${w / 2}`);
      [pl, pr].forEach((p) => { const L = p.getTotalLength(); p.style.strokeDasharray = String(L); p.style.strokeDashoffset = String(L); });
    };
    const runBoot = () => {
      window.clearTimeout(bootTimer);
      traceHosts.forEach((host) => { buildTrace(host); host.dataset.trace = "draw"; });
      void root.offsetWidth;
      const stagger = reduce ? 0 : 160;
      traceHosts.forEach((host, i) => {
        window.setTimeout(() => {
          host.querySelectorAll<SVGPathElement>(".sd-trace-l, .sd-trace-r").forEach((p) => (p.style.strokeDashoffset = "0"));
        }, i * stagger);
      });
      const total = reduce ? 0 : traceHosts.length * stagger + 1240;
      bootTimer = window.setTimeout(() => {
        root.dataset.booted = "on";
        traceHosts.forEach((host) => (host.dataset.trace = "done"));
      }, total);
    };
    const resetBoot = () => {
      window.clearTimeout(bootTimer);
      root.dataset.booted = "off";
      traceHosts.forEach((host) => {
        host.dataset.trace = "off";
        host.querySelectorAll<SVGPathElement>(".sd-trace-l, .sd-trace-r").forEach((p) => (p.style.strokeDashoffset = p.style.strokeDasharray));
      });
    };

    // ── the readout: garbled (all segments lit, jogged) → extinguishes to BENDER ──
    const resolve = () => {
      if (!powered) return;
      hovering = true;
      lockTrue();
      root.dataset.decoding = "true";
      if (!decoded) { decoded = true; root.dataset.decoded = "true"; }
    };
    const unresolve = () => { hovering = false; root.dataset.decoding = "false"; garbleAll(); };

    // ── power toggle ──
    const powerOn = () => {
      if (powered) return;
      powered = true;
      root.dataset.powered = "on";
      powerBtn?.setAttribute("aria-pressed", "true");
      if (footTag) footTag.textContent = "SEC · GATEWAY";
      garbleAll();
      place(curLen());
      runBoot();
    };
    const powerOff = () => {
      powered = false;
      root.dataset.powered = "off";
      powerBtn?.setAttribute("aria-pressed", "false");
      if (footTag) footTag.textContent = "press power to wake";
      root.dataset.decoding = "false";
      hovering = false;
      resetBoot();
      place(0);
    };
    const togglePower = () => (powered ? powerOff() : powerOn());

    // the power button is the ONLY way in — the screens never auto-boot. Once it's
    // on, clicking the panel just focuses the input so you can type.
    powerBtn?.addEventListener("click", (e) => { e.stopPropagation(); togglePower(); if (powered) input.focus(); });
    consoleEl.addEventListener("click", (e) => {
      if (!powered) return;
      if ((e.target as HTMLElement).closest("[data-sd-power], [data-sd-hint], [data-sd-decoder]")) return;
      input.focus();
    });

    decoders.forEach((d) => {
      d.addEventListener("pointerenter", resolve);
      d.addEventListener("pointerleave", unresolve);
    });
    strip?.addEventListener("focus", resolve);
    strip?.addEventListener("blur", unresolve);
    strip?.addEventListener("keydown", (e) => { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); resolve(); } });

    input.addEventListener("input", () => {
      if (!powered) { input.value = ""; return; }
      const v = input.value.toLowerCase().replace(/[^a-z]/g, "");
      let p = 0; while (p < v.length && p < WORD.length && v[p] === WORD[p]) p++;
      const broke = v.length > p;
      if (v.length !== p) input.value = WORD.slice(0, p);
      place(p);
      if (broke) shake();
      if (p === WORD.length && !crossed) open();
    });

    hintBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      if (!hintText) return;
      const on = !hintText.hasAttribute("hidden");
      if (on) { hintText.setAttribute("hidden", ""); hintBtn!.setAttribute("aria-expanded", "false"); }
      else { hintText.removeAttribute("hidden"); hintBtn!.setAttribute("aria-expanded", "true"); }
    });

    // ── the crossing: a looping index → highway → kiln → crown process ──
    const PHASES: [string, number][] = [["select", 1500], ["send", 1900], ["fire", 2700], ["crown", 1700], ["reset", 800]];
    let procTimers: number[] = [];
    const KSTATE: Record<string, string> = { select: "queued", send: "incoming", fire: "mastering", crown: "crowned", reset: "idle", idle: "idle" };
    const clearProc = () => { procTimers.forEach((t) => window.clearTimeout(t)); procTimers = []; };
    const runProc = () => {
      clearProc();
      if (reduce) { cross.dataset.phase = "fire"; if (kstate) kstate.textContent = "mastering"; return; }
      let i = 0;
      const step = () => {
        const [name, dur] = PHASES[i % PHASES.length];
        cross.dataset.phase = name;
        if (kstate) kstate.textContent = KSTATE[name];
        i++;
        procTimers.push(window.setTimeout(step, dur));
      };
      step();
    };

    const open = () => {
      crossed = true;
      root.dataset.crossed = "true";
      place(WORD.length);
      if (cross.parentElement !== document.body) document.body.appendChild(cross);
      cross.removeAttribute("hidden");
      void cross.offsetWidth;
      cross.dataset.on = "true";
      document.documentElement.style.overflow = "hidden";
      runProc();
      window.setTimeout(() => exitBtn?.focus(), reduce ? 0 : 80);
    };
    const close = () => {
      cross.dataset.on = "false";
      clearProc();
      cross.dataset.phase = "idle";
      document.documentElement.style.overflow = "";
      window.setTimeout(() => cross.setAttribute("hidden", ""), reduce ? 0 : 520);
      crossed = false;
      root.dataset.crossed = "false";
      input.value = "";
      place(0);
      window.setTimeout(() => input.focus(), reduce ? 0 : 80);
    };
    exitBtn?.addEventListener("click", close);
    document.addEventListener("keydown", (e) => {
      if (!crossed) return;
      if (e.key === "Escape") { e.preventDefault(); close(); return; }
      if (e.key === "Tab") {
        const f = Array.from(cross.querySelectorAll<HTMLElement>("a[href], button:not([disabled])")).filter((el) => el.offsetParent !== null);
        if (!f.length) return;
        const first = f[0], last = f[f.length - 1];
        if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
        else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
      }
    });

    place(0);
  });
</script>

<style>
  .sd {
    position: relative;
