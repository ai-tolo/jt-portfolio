---
// THE THRESHOLD — the closing. A piece of Jon's gear sits dark on the bench.
// Power it on, solve its one riddle, and the wall opens onto the console itself,
// running on loop like a thing you're meant to stand and watch.
//
//   gate    → a tall vault-terminal. The POWER button wakes it: a bright cyan
//             light-line traces each panel's perimeter from top-middle to
//             bottom-middle (the screen stays dark until it lands), then the panel
//             warms up fallout-style and a prompt types in. Five little CRTs hold
//             the riddle — 💨 💧 ⛰️ 🔥 and 🔊 — and come up slowly, like old bulbs.
//             A garbled readout extinguishes into "BENDER" on hover, lighting the
//             🔊 panel with it. Type soundbender.
//   cross   → the console, spectated: two substantial, label-free instruments —
//             the index (left) and the kiln (right) — wired by a data highway that
//             ships a track across, fires the kiln, and crowns a master, on a calm
//             satisfying loop. You just watch it run.
//   exit    → a tasteful esc keycap in the corner steps back out.
//
// Touch, keyboard (focus + type + Enter + Esc + focus-trap), reduced-motion all
// work. No-JS shows a sealed, dormant panel.
import Richard from "./Richard.astro";

const WORD = "soundbender";
const SLOTS = Array.from({ length: WORD.length }, (_, i) => i);

// ── 14-segment alphanumeric display geometry (one glyph, viewBox 0 0 60 96) ──
const SEG: Record<string, [number, number, number, number]> = {
  A: [10, 10, 50, 10], B: [50, 10, 50, 48], C: [50, 48, 50, 86], D: [10, 86, 50, 86],
  E: [10, 48, 10, 86], F: [10, 10, 10, 48], G1: [10, 48, 30, 48], G2: [30, 48, 50, 48],
  H: [10, 10, 30, 48], I: [30, 10, 30, 48], J: [50, 10, 30, 48],
  K: [30, 48, 10, 86], L: [30, 48, 30, 86], M: [30, 48, 50, 86],
};
const SEG_ORDER = ["A", "B", "C", "D", "E", "F", "G1", "G2", "H", "I", "J", "K", "L", "M"];
const GLYPH: Record<string, string[]> = {
  B: ["A", "B", "C", "D", "G2", "I", "L"],
  E: ["A", "D", "E", "F", "G1", "G2"],
  N: ["B", "C", "E", "F", "H", "M"],
  D: ["A", "B", "C", "D", "I", "L"],
  R: ["A", "B", "E", "F", "G1", "G2", "M"],
};
const BENDER = ["B", "E", "N", "D", "E", "R"];
// per-glyph vertical jog for the garbled (powered, un-hovered) state
const GOFF = [7, -5, 9, -6, 4, -8];
const ELEMENTS = [
  { e: "💨", el: "air" }, { e: "💧", el: "water" }, { e: "⛰️", el: "earth" }, { e: "🔥", el: "fire" },
];

// ── the crossing: the catalog that streams through the kiln ──
const TIER: Record<string, string> = { jam: "Jam", tracks: "Track", field: "Field", loops: "Loop", inbox: "Inbox" };
const BUCKETS = [
  // BUCKETS[0] is the crowned king mix of the case-study song. SONG_TITLE (see FileTransform.astro).
  { kind: "tracks", title: "head to toe · king mix", dur: "3:48", keeper: true, seed: 7 },
  { kind: "jam", title: "Sunday session · half-time chorus", dur: "123:41", keeper: true, seed: 2 },
  { kind: "loops", title: "descending rhodes · 8 bars", dur: "0:14", seed: 9 },
  { kind: "tracks", title: "supersonic bionic · master v4", dur: "4:12", seed: 5 },
  { kind: "field", title: "Rooftop, 6am · before traffic", dur: "21:38", seed: 4 },
  { kind: "inbox", title: "Note to self · drop the bridge", dur: "0:48", seed: 1 },
  { kind: "jam", title: "car demo · that bassline", dur: "8:03", seed: 8 },
  { kind: "loops", title: "808 sub + shaker", dur: "0:08", seed: 3 },
];
const wbars = (seed: number) => Array.from({ length: 22 }, (_, i) => Math.round((0.24 + 0.58 * Math.abs(Math.sin(i * 0.7 + seed))) * 100));
const AXES = [
  { label: "tone", lo: "bright", hi: "warm", lit: 1, c: "cyan" },
  { label: "width", lo: "dry", hi: "wide", lit: 0, c: "pink" },
  { label: "dynamics", lo: "dense", hi: "open", lit: 1, c: "yellow" },
];
const SEEDS = ["cyan", "cyan", "pink", "pink", "yellow", "yellow"];

// ── THE EQUIPMENT BAY ── the gateway sits at the head of a facility aisle: a short
// row of dark server-rack silhouettes recedes down each flank (outer = nearest/tallest,
// inner = farther, greyed by haze). Achromatic steel; a sparse few status LEDs are lit,
// a couple "wake" on power-on. cls: "" dim steel · g/a/c lit (with blink delay) · w wakes.
const BAY_FLOOR_Y = 346;
const BAY_CABS = [
  { x: 4,   w: 64, top: 26,  rank: 0, leds: [{ cls: "g", d: 0 }, { cls: "" }, { cls: "" }, { cls: "c", d: 2.6 }, { cls: "" }, { cls: "" }] },
  { x: 76,  w: 50, top: 86,  rank: 1, leds: [{ cls: "" }, { cls: "a", d: 1.3 }, { cls: "w", d: 0.18 }, { cls: "" }, { cls: "" }] },
  { x: 132, w: 38, top: 146, rank: 2, leds: [{ cls: "" }, { cls: "w", d: 0.34 }, { cls: "" }, { cls: "" }] },
];
const baySlots = (top: number) => { const r: number[] = []; for (let y = top + 13; y < BAY_FLOOR_Y - 6; y += 11) r.push(y); return r; };

// ── POST-LOGIN BACKDROP ── the rest of Tolo.Cloud, grayed out behind the live module.
// The module is the Engineer stage of a real 3-step pipeline; the backdrop shows the
// catalog it draws from (AudioDex buckets, left) and the proof it leaves (Engineer,
// right), tabs across the top — a read-only preview so the module reads as one lit,
// working stage of an actual product, not a standalone animation.
const PIPE_TABS = [
  { key: "audiodex", label: "AudioDex", sub: "buckets" },
  { key: "engineer", label: "Engineer", sub: "master · prove", active: true },
  { key: "sounds", label: "Sounds", sub: "publish" },
];
const DEX_BUCKETS = [
  { name: "Inbox", n: "7,589", bar: 100 },
  { name: "Jam", n: "329", bar: 22 },
  { name: "Loops", n: "339", bar: 23 },
  { name: "Field", n: "1,389", bar: 40 },
  { name: "Tracks", n: "169", bar: 16, active: true },
];
const ENG_ROWS = [
  { k: "variants forged", v: "6" },
  { k: "blind A / B", v: "won 5 / 6" },
  { k: "loudness", v: "−9.2 LUFS" },
  { k: "verdict", v: "king mix", win: true },
];
---

<section class="sd" data-sd data-powered="off" data-booted="off" aria-label="Step into Tolo.Cloud, the running console">
  <!-- ── THE EQUIPMENT BAY · the gateway is the one lit terminal at the head of a
       facility aisle; dark rack silhouettes recede into haze down each flank. A pure
       background SET behind the panel (z-index 0, pointer-events none) — nothing
       touches the casing, nothing recolors it. ── -->
  <div class="sd-set" aria-hidden="true">
    <span class="sd-set-haze"></span>
    <span class="sd-set-floor"></span>
    <span class="sd-set-conduit"><i></i></span>
    <span class="sd-set-contact"></span>
    <div class="sd-racks">
      {["left", "right"].map((side) => (
        <svg class:list={[side]} viewBox="0 0 174 360" preserveAspectRatio="xMidYMax meet">
          {BAY_CABS.map((cab) => (
            <g class:list={["bay-cab", `rank-${cab.rank}`]}>
              <rect class="cab-body" x={cab.x} y={cab.top} width={cab.w} height={BAY_FLOOR_Y - cab.top} rx="2.5" />
              <rect class="cab-bezel" x={cab.x} y={cab.top} width={cab.w} height="3" />
              {baySlots(cab.top).map((y) => <rect class="cab-slot" x={cab.x + 4} y={y} width={cab.w - 8} height="4" rx="1" />)}
              {cab.leds.map((l, i) => (
                <circle class:list={["led", l.cls === "g" && "on-green blink", l.cls === "a" && "on-amber blink", l.cls === "c" && "on-cyan blink", l.cls === "w" && "wake"]}
                  cx={cab.x + cab.w - 8} cy={cab.top + 15 + i * 11} r="1.7" style={l.d != null ? `--d:${l.d}s` : undefined} />
              ))}
            </g>
          ))}
        </svg>
      ))}
    </div>
  </div>

  <!-- ── the access console · the gateway terminal, bolted into the bay ── -->
  <div class="sd-gate">
  <div class="sd-console" data-sd-console>
    <span class="sd-bolt sd-b-tl" aria-hidden="true"></span><span class="sd-bolt sd-b-tr" aria-hidden="true"></span>
    <span class="sd-bolt sd-b-bl" aria-hidden="true"></span><span class="sd-bolt sd-b-br" aria-hidden="true"></span>

    <div class="sd-top">
      <span class="sd-brand">Tolo<span class="sd-brand-dot">.</span>Cloud</span>
      <span class="sd-top-tag" aria-hidden="true">SEC · GATEWAY</span>
      <span class="sd-lock" aria-hidden="true">
        <svg viewBox="0 0 18 18" width="12" height="12"><path d="M5 8V6a4 4 0 018 0v2M4 8h10v6H4z" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </span>
      <button type="button" class="sd-power" data-sd-power aria-label="Power" aria-pressed="false">
        <span class="sd-power-bezel" aria-hidden="true"></span>
        <span class="sd-power-ring" aria-hidden="true"></span>
        <svg class="sd-power-glyph" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.2v8.2" /><path d="M6.3 6.6a8 8 0 1011.4 0" /></svg>
      </button>
    </div>

    <div class="sd-body">
      <!-- the riddle: five little vault-terminal CRTs that wake like old bulbs -->
      <div class="sd-strip" data-sd-decoder tabindex="0" role="button" aria-label="Decode the riddle">
        {[...ELEMENTS, { e: "🔊", el: "sound" }].map((m, i) => (
          <span class:list={["sd-crt", { "sd-crt-sound": m.el === "sound" }]} data-el={m.el} style={`--bd:${(i * 0.3).toFixed(2)}s`} aria-hidden="true">
            <span class="sd-crt-emoji">{m.e}</span>
            <span class="sd-crt-scan"></span><span class="sd-crt-vig"></span>
          </span>
        ))}
      </div>

      <div class="sd-right">
        <!-- the code-entry screen -->
        <div class="sd-screen sd-screen-code" data-sd-trace>
          <svg class="sd-trace" preserveAspectRatio="none" aria-hidden="true"><path class="sd-trace-l"></path><path class="sd-trace-r"></path></svg>
          <span class="sd-roll" aria-hidden="true"></span>
          <span class="sd-screen-label" aria-hidden="true">ACCESS CODE</span>
          <div class="sd-codewrap">
            <div class="sd-prompt" aria-hidden="true"><span class="sd-prompt-txt">ENTER ACCESS CODE</span></div>
            <div class="sd-tiles" aria-hidden="true">
              {SLOTS.map((i) => <span class="sd-tile" data-sd-tile data-i={i} data-lit="false"></span>)}
            </div>
          </div>
          <input class="sd-input" data-sd-input type="text" inputmode="text" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" aria-label="Type the passcode to glimpse the cloud" />
        </div>

        <!-- the decode screen — a garbled readout that extinguishes into BENDER -->
        <div class="sd-screen sd-screen-decode" data-sd-trace data-sd-decoder2 aria-hidden="true">
          <svg class="sd-trace" preserveAspectRatio="none" aria-hidden="true"><path class="sd-trace-l"></path><path class="sd-trace-r"></path></svg>
          <span class="sd-roll" aria-hidden="true"></span>
          <span class="sd-screen-label" aria-hidden="true">DECODE</span>
          <div class="sd-readout" data-sd-readout>
            {BENDER.map((ch, ci) => (
              <span class="sd-glyph" data-sd-glyph data-ci={ci} style={`--oy:${GOFF[ci]}px`}>
                <svg viewBox="0 0 60 96" preserveAspectRatio="xMidYMid meet">
                  {SEG_ORDER.map((s) => {
                    const [x1, y1, x2, y2] = SEG[s];
                    return <line class="sd-seg" data-seg={s} data-on={GLYPH[ch].includes(s) ? "true" : "false"} x1={x1} y1={y1} x2={x2} y2={y2} />;
                  })}
                </svg>
              </span>
            ))}
          </div>
        </div>
      </div>
    </div>

    <div class="sd-foot">
      <span class="sd-grille" aria-hidden="true"></span>
      <span class="sd-foot-tag" data-sd-foottag>press power to wake</span>
      <button type="button" class="sd-q" data-sd-hint aria-label="reveal the passcode" aria-expanded="false">?</button>
      <span class="sd-q-ans" data-sd-hinttext hidden>soundbender</span>
    </div>
  </div>
  </div>

  <!-- ── the crossing → the console, spectated ── -->
  <div class="sd-cross" data-sd-cross data-phase="idle" hidden>
    <div class="rig" role="dialog" aria-modal="true" aria-label="Tolo.Cloud, the console, running">
      <header class="rig-bar">
        <span class="rig-wm">Tolo<span class="rig-wm-dot">.</span>Cloud</span>
        <!-- the pipeline as tabs: the live module is the Engineer stage (lit); the rest grayed -->
        <nav class="rig-tabs" aria-hidden="true">
          {PIPE_TABS.map((t, i) => (
            <Fragment>
              <span class:list={["rig-tab", { "rig-tab-on": t.active }]}>
                <span class="rig-tab-label">{t.label}</span>
                <span class="rig-tab-sub">{t.sub}</span>
              </span>
              {i < PIPE_TABS.length - 1 && <span class="rig-tab-arrow" aria-hidden="true">→</span>}
            </Fragment>
          ))}
        </nav>
        <span class="rig-preview" aria-hidden="true"><span class="rig-preview-dot"></span>preview · read-only</span>
        <button type="button" class="rig-esc" data-sd-exit aria-label="Step back out">
          <span class="rig-esc-key">esc</span>
          <svg viewBox="0 0 20 20" width="13" height="13" aria-hidden="true"><path d="M5 5l10 10M15 5L5 15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
        </button>
      </header>

      <div class="rig-stage">
        <span class="rig-floor" aria-hidden="true"></span>

        <!-- ── the grayed-out backdrop: the rest of Tolo.Cloud around the live module —
             the catalog it draws from (left) + the proof it leaves (right), read-only.
             Decorative + dim, behind the module, never competing with it. ── -->
        <div class="rig-backdrop" aria-hidden="true">
          <span class="rig-spot"></span>

          <!-- LEFT · AudioDex catalog (where the file comes from) -->
          <aside class="rig-panel rig-panel-dex">
            <div class="rig-panel-head"><span class="rig-panel-dot"></span>AudioDex<em>browse · 20,279</em></div>
            <ul class="rig-bucketlist">
              {DEX_BUCKETS.map((b) => (
                <li class:list={["rig-bucket", { "rig-bucket-on": b.active }]}>
                  <span class="rig-bucket-name">{b.name}</span>
                  <span class="rig-bucket-bar"><i style={`--w:${b.bar}%`}></i></span>
                  <span class="rig-bucket-n">{b.n}</span>
                </li>
              ))}
            </ul>
            <div class="rig-panel-foot">▸ head to toe · in Tracks</div>
          </aside>

          <!-- RIGHT · Engineer proof (what the module leaves behind) -->
          <aside class="rig-panel rig-panel-eng">
            <div class="rig-panel-head"><span class="rig-panel-dot"></span>Engineer<em>head to toe</em></div>
            <ul class="rig-englist">
              {ENG_ROWS.map((r) => (
                <li class:list={["rig-engrow", { "rig-engrow-win": r.win }]}>
                  <span class="rig-eng-k">{r.k}</span><span class="rig-eng-v">{r.v}</span>
                </li>
              ))}
            </ul>
            <div class="rig-panel-foot">proven blind, not guessed</div>
          </aside>

          <!-- bottom status strip -->
          <div class="rig-status">
            <span>TOLO.CLOUD</span><span class="rig-status-sep">·</span>
            <span>preview build v0.9</span><span class="rig-status-sep">·</span>
            <span class="rig-status-live">engineer: live</span><span class="rig-status-sep">·</span>
            <span>audiodex synced</span>
          </div>
        </div>

        <!-- ONE machine, seen from inside: the file runs down it. AudioDex finds it,
             the cell reads it, the kiln masters it, the king mix is crowned. -->
        <section class="rig-console" aria-label="The running console: it finds head to toe, masters it, and crowns the king mix">
          <span class="rig-bolt b1" aria-hidden="true"></span><span class="rig-bolt b2" aria-hidden="true"></span>
          <span class="rig-bolt b3" aria-hidden="true"></span><span class="rig-bolt b4" aria-hidden="true"></span>

          <!-- the conduit the file runs down, behind the zones -->
          <span class="rig-conduit" aria-hidden="true"><span class="rig-conduit-flow"></span></span>

          <!-- INTAKE · AudioDex holds the one file we follow -->
          <div class="rig-intake">
            <div class="rig-zone-head">
              <span class="inst-led led-cyan" aria-hidden="true"></span>
              <span class="rig-zone-name rig-zone-adx">AudioDex</span>
              <span class="inst-count">20,279 catalogued</span>
            </div>
            <div class="rig-intake-body">
              <div class="rig-ghost" aria-hidden="true">
                {BUCKETS.slice(1, 5).map((b) => <span class="rig-ghost-row">{b.title}</span>)}
              </div>
              <article class="dex-card k-tracks rig-focus" data-card="0" aria-hidden="true">
                <span class="dex-tier">Track</span>
                <span class="dex-title">head to toe</span>
                <span class="dex-keeper">★</span>
                <span class="dex-dur">3:48</span>
                <span class="dex-wave">{wbars(7).map((h) => <i style={`--h:${h}%`}></i>)}</span>
              </article>
            </div>
          </div>

          <!-- THE HEART · the charge cell reads + titles it -->
          <div class="rig-cell" aria-hidden="true">
            <span class="rig-cell-aura"></span>
            <span class="rig-cell-glass"></span>
            <span class="rig-cell-core"></span>
          </div>

          <!-- THE KILN · the hero engine, Richard inside -->
          <div class="rig-kiln">
            <div class="rig-zone-head rig-kiln-head">
              <span class="inst-led led-green" aria-hidden="true"></span>
              <span class="rig-zone-name rig-zone-kiln">The Kiln</span>
              <span class="kiln-state" data-sd-kstate>idle</span>
            </div>

            <!-- THE HERO · the signature forge button from §02 (the kiln control),
                 with Richard riding the rim of its spinning dial, partying as the
                 file is catalogued. ids namespaced sdpl-* (both forges share a page). -->
            <div class="kiln-dome ft-forge-host" aria-hidden="true">
              <span class="ft-forge-dome">
                <span class="ft-forge-body"></span>
                <span class="ft-forge-dial">
                  <span class="ft-dial-rim"></span>
                  <svg class="ft-forge-bezel" viewBox="0 0 240 240">
                    <line class="ft-dial-index" x1="120" y1="92" x2="120" y2="100" stroke="#c9b6ff" stroke-width="2.2" stroke-linecap="round" />
                    <circle class="ft-dial-index-dot" cx="120" cy="88" r="2.4" fill="#c9b6ff" />
                  </svg>
                </span>
                <span class="ft-dial-lip"></span>
                <span class="ft-forge-screen">
                  <span class="ft-scope"></span>
                  <svg class="ft-reactor" viewBox="0 0 240 240">
                    <defs>
                      <radialGradient id="sdpl-core" cx="50%" cy="50%" r="50%">
                        <stop offset="0%" stop-color="#ffffff" /><stop offset="22%" stop-color="#eaffff" /><stop offset="48%" stop-color="#aef9ff" /><stop offset="72%" stop-color="#19e0ff" /><stop offset="100%" stop-color="#19e0ff" stop-opacity="0" />
                      </radialGradient>
                      <radialGradient id="sdpl-bloom" cx="50%" cy="50%" r="50%">
                        <stop offset="0%" stop-color="#7b5cff" stop-opacity="0.55" /><stop offset="45%" stop-color="#3a6cff" stop-opacity="0.22" /><stop offset="100%" stop-color="#063444" stop-opacity="0" />
                      </radialGradient>
                      <radialGradient id="sdpl-globe" cx="42%" cy="38%" r="62%">
                        <stop offset="0%" stop-color="#19e0ff" stop-opacity="0.10" /><stop offset="60%" stop-color="#1166aa" stop-opacity="0.06" /><stop offset="100%" stop-color="#7b5cff" stop-opacity="0.05" />
                      </radialGradient>
                      <linearGradient id="sdpl-fil" x1="0" y1="0" x2="1" y2="0">
                        <stop offset="0%" stop-color="#ffffff" /><stop offset="35%" stop-color="#aef9ff" /><stop offset="80%" stop-color="#19e0ff" /><stop offset="100%" stop-color="#7b5cff" />
                      </linearGradient>
                      <filter id="sdpl-arc" x="-60%" y="-60%" width="220%" height="220%" color-interpolation-filters="sRGB">
                        <feTurbulence type="fractalNoise" baseFrequency="0.018 0.026" numOctaves="3" seed="7" stitchTiles="stitch" result="n"><animate attributeName="seed" values="7;8;9;10;7" dur="3.2s" repeatCount="indefinite" /></feTurbulence>
                        <feDisplacementMap in="SourceGraphic" in2="n" scale="22" xChannelSelector="R" yChannelSelector="G" />
                      </filter>
                      <filter id="sdpl-fork" x="-60%" y="-60%" width="220%" height="220%" color-interpolation-filters="sRGB">
                        <feTurbulence type="fractalNoise" baseFrequency="0.045 0.06" numOctaves="2" seed="21" stitchTiles="stitch" result="n"><animate attributeName="seed" values="21;23;25;21" dur="2.3s" repeatCount="indefinite" /></feTurbulence>
                        <feDisplacementMap in="SourceGraphic" in2="n" scale="14" xChannelSelector="R" yChannelSelector="G" />
                      </filter>
                      <filter id="sdpl-soft" x="-80%" y="-80%" width="260%" height="260%"><feGaussianBlur stdDeviation="3.2" /></filter>
                      <filter id="sdpl-glow" x="-120%" y="-120%" width="340%" height="340%"><feGaussianBlur stdDeviation="7" /></filter>
                      <clipPath id="sdpl-clip"><circle cx="120" cy="120" r="118" /></clipPath>
                    </defs>
                    <g class="ft-pl-field" clip-path="url(#sdpl-clip)">
                      <circle cx="120" cy="120" r="112" fill="url(#sdpl-globe)" />
                      <circle class="ft-pl-bloom" cx="120" cy="120" r="106" fill="url(#sdpl-bloom)" filter="url(#sdpl-glow)" />
                      <g transform="translate(120 120) scale(1.9) translate(-120 -120)">
                        <g fill="none" stroke="url(#sdpl-fil)" stroke-linecap="round">
                          <g filter="url(#sdpl-glow)" opacity="0.7" stroke-width="3.4">
                            <g filter="url(#sdpl-arc)">
                              <path d="M120 120 L84 70" /><path d="M120 120 L168 80" /><path d="M120 120 L178 138" /><path d="M120 120 L132 184" /><path d="M120 120 L66 150" /><path d="M120 120 L60 110" />
                            </g>
                          </g>
                          <g class="ft-pl-arcs" filter="url(#sdpl-arc)" stroke-width="1.5">
                            <path d="M120 120 L84 70" /><path d="M120 120 L168 80" /><path d="M120 120 L178 138" /><path d="M120 120 L132 184" /><path d="M120 120 L66 150" /><path d="M120 120 L60 110" />
                          </g>
                          <g class="ft-pl-forks" fill="none" stroke="#aef9ff" stroke-linecap="round" stroke-width="0.9" filter="url(#sdpl-fork)" opacity="0.85">
                            <path d="M101 95 L78 96" /><path d="M145 100 L160 86" /><path d="M150 130 L172 122" /><path d="M126 152 L114 168" /><path d="M92 136 L74 132" /><path d="M90 115 L72 104" /><path d="M134 112 L150 104" />
                          </g>
                          <g class="ft-pl-tips" fill="#eaffff" filter="url(#sdpl-soft)">
                            <circle cx="84" cy="70" r="1.6" /><circle cx="168" cy="80" r="1.6" /><circle cx="178" cy="138" r="1.4" /><circle cx="132" cy="184" r="1.5" /><circle cx="66" cy="150" r="1.5" /><circle cx="60" cy="110" r="1.4" />
                          </g>
                        </g>
                      </g>
                      <circle cx="120" cy="120" r="22" fill="url(#sdpl-core)" filter="url(#sdpl-soft)" class="ft-pl-core" />
                      <circle cx="120" cy="120" r="9" fill="url(#sdpl-core)" />
                      <circle cx="120" cy="120" r="3.6" fill="#ffffff" />
                      <circle cx="116.5" cy="116" r="1.2" fill="#ffffff" opacity="0.9" />
                    </g>
                  </svg>
                  <span class="ft-pl-flash"></span>
                </span>
                <span class="ft-forge-glass"></span>
              </span>

              <!-- Richard floats in the center of the disc, slowly turning like he's on
                   an inner tube in a lazy river — a push from the kiln spins him up -->
              <span class="kiln-float">
                <span class="kiln-spin"><Richard size={46} speaking={true} /></span>
              </span>
              <span class="kiln-confetti" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span>
            </div>

            <div class="kiln-meters">
              {AXES.map((a) => (
                <div class:list={["kiln-axis", `c-${a.c}`]}>
                  <span class="kiln-axis-name">{a.label}</span>
                  <span class="kiln-track"><span class="kiln-fill" style={`--p:${a.lit === 0 ? 26 : 74}%`}></span></span>
                </div>
              ))}
            </div>
          </div>

          <!-- OUTPUT LIP · the crowned king mix, the final image -->
          <div class="rig-out" aria-hidden="true">
            <span class="kiln-bloom">{SEEDS.map((c) => <i class={`s-${c}`}></i>)}</span>
            <span class="rig-out-king" data-sd-king>♛</span>
            <span class="rig-crowned">head to toe · king mix</span>
          </div>

          <!-- chassis plates -->
          <span class="rig-brand" aria-hidden="true">TOLO·CLOUD · LIVE</span>
          <span class="rig-serial" aria-hidden="true">MK·III · THE LATHE</span>
          <span class="rig-vents" aria-hidden="true"></span>
        </section>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-sd]").forEach((root) => {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const consoleEl = root.querySelector<HTMLElement>("[data-sd-console]");
    const powerBtn = root.querySelector<HTMLButtonElement>("[data-sd-power]");
    const footTag = root.querySelector<HTMLElement>("[data-sd-foottag]");
    const input = root.querySelector<HTMLInputElement>("[data-sd-input]");
    const tiles = Array.from(root.querySelectorAll<HTMLElement>("[data-sd-tile]"));
    const decoders = Array.from(root.querySelectorAll<HTMLElement>("[data-sd-decoder], [data-sd-decoder2]"));
    const strip = root.querySelector<HTMLElement>("[data-sd-decoder]");
    const glyphs = Array.from(root.querySelectorAll<HTMLElement>("[data-sd-glyph]"));
    const traceHosts = Array.from(root.querySelectorAll<HTMLElement>("[data-sd-trace]"));
    const hintBtn = root.querySelector<HTMLButtonElement>("[data-sd-hint]");
    const hintText = root.querySelector<HTMLElement>("[data-sd-hinttext]");
    const cross = root.querySelector<HTMLElement>("[data-sd-cross]");
    const exitBtn = root.querySelector<HTMLElement>("[data-sd-exit]");
    const kstate = root.querySelector<HTMLElement>("[data-sd-kstate]");
    if (!consoleEl || !input || !cross) return;

    const WORD = "soundbender";
    let crossed = false, powered = false, decoded = false, hovering = false, shakeTimer = 0, bootTimer = 0;
    root.dataset.ready = "true";

    const segEls = glyphs.map((g) => Array.from(g.querySelectorAll<SVGLineElement>("[data-seg]")));
    const masks = segEls.map((segs) => segs.map((s) => s.dataset.on === "true"));
    const lockTrue = () => segEls.forEach((segs, gi) => segs.forEach((el, si) => (el.dataset.on = masks[gi][si] ? "true" : "false")));
    const garbleAll = () => segEls.forEach((segs) => segs.forEach((el) => (el.dataset.on = "true")));

    const place = (p: number) => {
      tiles.forEach((el, i) => {
        const lit = i < p;
        el.dataset.lit = String(lit);
        el.textContent = lit ? WORD[i] : "";
        el.dataset.active = String(i === p && powered && !crossed);
      });
    };
    const shake = () => {
      root.dataset.shake = "1";
      window.clearTimeout(shakeTimer);
      shakeTimer = window.setTimeout(() => (root.dataset.shake = "0"), reduce ? 120 : 360);
    };
    const curLen = () => {
      const v = input.value.toLowerCase().replace(/[^a-z]/g, "");
      let p = 0; while (p < v.length && p < WORD.length && v[p] === WORD[p]) p++; return p;
    };

    // ── border trace: one cyan line each side, top-middle → bottom-middle ──
    const buildTrace = (host: HTMLElement) => {
      const pl = host.querySelector<SVGPathElement>(".sd-trace-l");
      const pr = host.querySelector<SVGPathElement>(".sd-trace-r");
      const svg = host.querySelector<SVGSVGElement>("svg.sd-trace");
      if (!pl || !pr || !svg) return;
      const w = host.clientWidth, h = host.clientHeight;
      if (!w || !h) return;
      const r = Math.max(2, Math.min(parseFloat(getComputedStyle(host).borderTopLeftRadius) || 12, Math.min(w, h) / 2 - 1));
      svg.setAttribute("viewBox", `0 0 ${w} ${h}`);
      pr.setAttribute("d", `M${w / 2} 1 H${w - r} A${r} ${r} 0 0 1 ${w - 1} ${r} V${h - r} A${r} ${r} 0 0 1 ${w - r} ${h - 1} H${w / 2}`);
      pl.setAttribute("d", `M${w / 2} 1 H${r} A${r} ${r} 0 0 0 1 ${r} V${h - r} A${r} ${r} 0 0 0 ${r} ${h - 1} H${w / 2}`);
      // suppress the draw transition while we seat the full-offset (hidden) baseline,
      // so the very first power-on draws too — see runBoot
      [pl, pr].forEach((p) => { const L = p.getTotalLength(); p.style.transition = "none"; p.style.strokeDasharray = String(L); p.style.strokeDashoffset = String(L); });
    };
    const runBoot = () => {
      window.clearTimeout(bootTimer);
      traceHosts.forEach((host) => { buildTrace(host); host.dataset.trace = "draw"; });
      void root.offsetWidth;   // commit the hidden full-offset baseline with transitions suppressed
      // restore the draw transition now that the "from" value is the committed baseline;
      // previously the first build animated the default 0 -> L, leaving the -> 0 with nothing to draw
      traceHosts.forEach((host) => host.querySelectorAll<SVGPathElement>(".sd-trace-l, .sd-trace-r").forEach((p) => { p.style.transition = ""; }));
      void root.offsetWidth;
      const stagger = reduce ? 0 : 160;
      traceHosts.forEach((host, i) => {
        window.setTimeout(() => {
          host.querySelectorAll<SVGPathElement>(".sd-trace-l, .sd-trace-r").forEach((p) => (p.style.strokeDashoffset = "0"));
        }, i * stagger);
      });
      const total = reduce ? 0 : traceHosts.length * stagger + 1240;
      bootTimer = window.setTimeout(() => {
        root.dataset.booted = "on";
        traceHosts.forEach((host) => (host.dataset.trace = "done"));
      }, total);
    };
    const resetBoot = () => {
      window.clearTimeout(bootTimer);
      root.dataset.booted = "off";
      traceHosts.forEach((host) => {
        host.dataset.trace = "off";
        host.querySelectorAll<SVGPathElement>(".sd-trace-l, .sd-trace-r").forEach((p) => (p.style.strokeDashoffset = p.style.strokeDasharray));
      });
    };

    // ── the readout: garbled (all segments lit, jogged) → extinguishes to BENDER ──
    const resolve = () => {
      if (!powered) return;
      hovering = true;
      lockTrue();
      root.dataset.decoding = "true";
      if (!decoded) { decoded = true; root.dataset.decoded = "true"; }
    };
    const unresolve = () => { hovering = false; root.dataset.decoding = "false"; garbleAll(); };

    // ── power toggle ──
    const powerOn = () => {
      if (powered) return;
      powered = true;
      root.dataset.powered = "on";
      powerBtn?.setAttribute("aria-pressed", "true");
      if (footTag) footTag.textContent = "SEC · GATEWAY";
      garbleAll();
      place(curLen());
      runBoot();
    };
    const powerOff = () => {
      powered = false;
      root.dataset.powered = "off";
      powerBtn?.setAttribute("aria-pressed", "false");
      if (footTag) footTag.textContent = "press power to wake";
      root.dataset.decoding = "false";
      hovering = false;
      resetBoot();
      place(0);
    };
    const togglePower = () => (powered ? powerOff() : powerOn());

    // the power button is the ONLY way in — the screens never auto-boot. Once it's
    // on, clicking the panel just focuses the input so you can type.
    powerBtn?.addEventListener("click", (e) => { e.stopPropagation(); togglePower(); if (powered) input.focus(); });
    consoleEl.addEventListener("click", (e) => {
      if (!powered) return;
      if ((e.target as HTMLElement).closest("[data-sd-power], [data-sd-hint], [data-sd-decoder]")) return;
      input.focus();
    });

    decoders.forEach((d) => {
      d.addEventListener("pointerenter", resolve);
      d.addEventListener("pointerleave", unresolve);
    });
    strip?.addEventListener("focus", resolve);
    strip?.addEventListener("blur", unresolve);
    strip?.addEventListener("keydown", (e) => { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); resolve(); } });

    input.addEventListener("input", () => {
      if (!powered) { input.value = ""; return; }
      const v = input.value.toLowerCase().replace(/[^a-z]/g, "");
      let p = 0; while (p < v.length && p < WORD.length && v[p] === WORD[p]) p++;
      const broke = v.length > p;
      if (v.length !== p) input.value = WORD.slice(0, p);
      place(p);
      if (broke) shake();
      if (p === WORD.length && !crossed) open();
    });

    hintBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      if (!hintText) return;
      const on = !hintText.hasAttribute("hidden");
      if (on) { hintText.setAttribute("hidden", ""); hintBtn!.setAttribute("aria-expanded", "false"); }
      else { hintText.removeAttribute("hidden"); hintBtn!.setAttribute("aria-expanded", "true"); }
    });

    // ── the crossing: a looping index → highway → kiln → crown process ──
    const PHASES: [string, number][] = [["select", 1500], ["send", 1900], ["fire", 2700], ["crown", 1700], ["reset", 800]];
    let procTimers: number[] = [];
    const KSTATE: Record<string, string> = { select: "queued", send: "incoming", fire: "mastering", crown: "crowned", reset: "idle", idle: "idle" };
    const clearProc = () => { procTimers.forEach((t) => window.clearTimeout(t)); procTimers = []; };

    // ── Richard's lazy-river spin, with real momentum ──
    // At rest he BARELY turns (SPIN_BASE). A push (the kiln firing) feeds a brief
    // acceleration ramp toward SPIN_PEAK; once that's spent, friction eases the extra
    // velocity back down to the base. The angle accumulates continuously, so a push
    // never resets him — it just shoves a wheel that's already turning.
    const spinEl = root.querySelector<HTMLElement>(".kiln-spin");
    const SPIN_BASE = 0.05, SPIN_PEAK = 2.4, SPIN_ACCEL = 0.18, SPIN_FRICTION = 0.986;
    let spinAngle = 0, spinVel = SPIN_BASE, spinAccelLeft = 0, spinRAF = 0;
    const spinStep = () => {
      if (spinAccelLeft > 0) { spinVel = Math.min(SPIN_PEAK, spinVel + SPIN_ACCEL); spinAccelLeft--; }
      else { spinVel = SPIN_BASE + (spinVel - SPIN_BASE) * SPIN_FRICTION; }
      spinAngle = (spinAngle + spinVel) % 360;
      if (spinEl) spinEl.style.transform = `rotate(${spinAngle.toFixed(2)}deg)`;
    };
    const spinTick = () => { spinStep(); spinRAF = requestAnimationFrame(spinTick); };
    const pushSpin = (frames = 14) => { spinAccelLeft = Math.max(spinAccelLeft, frames); };
    const startSpin = () => { if (!spinRAF && !reduce && spinEl) spinTick(); };
    const stopSpin = () => { if (spinRAF) { cancelAnimationFrame(spinRAF); spinRAF = 0; } };
    // deterministic test hook (rAF is throttled headless, atlas gotcha #6)
    (root as any).__spin = { push: pushSpin, step: spinStep, get angle() { return spinAngle; }, get vel() { return spinVel; } };

    const runProc = () => {
      clearProc();
      if (reduce) { cross.dataset.phase = "crown"; if (kstate) kstate.textContent = "crowned"; return; }
      let i = 0;
      const step = () => {
        const [name, dur] = PHASES[i % PHASES.length];
        cross.dataset.phase = name;
        if (kstate) kstate.textContent = KSTATE[name];
        if (name === "fire") pushSpin();   // the kiln fires → shove the inner tube
        i++;
        procTimers.push(window.setTimeout(step, dur));
      };
      step();
    };

    const open = () => {
      crossed = true;
      root.dataset.crossed = "true";
      place(WORD.length);
      if (cross.parentElement !== document.body) document.body.appendChild(cross);
      cross.removeAttribute("hidden");
      void cross.offsetWidth;
      cross.dataset.on = "true";
      document.documentElement.style.overflow = "hidden";
      startSpin(); pushSpin(8);   // wake the drift with a gentle initial nudge
      runProc();
      window.setTimeout(() => exitBtn?.focus(), reduce ? 0 : 80);
    };
    const close = () => {
      cross.dataset.on = "false";
      clearProc();
      stopSpin();
      cross.dataset.phase = "idle";
      document.documentElement.style.overflow = "";
      window.setTimeout(() => cross.setAttribute("hidden", ""), reduce ? 0 : 520);
      crossed = false;
      root.dataset.crossed = "false";
      input.value = "";
      place(0);
      window.setTimeout(() => input.focus(), reduce ? 0 : 80);
    };
    exitBtn?.addEventListener("click", close);
    document.addEventListener("keydown", (e) => {
      if (!crossed) return;
      if (e.key === "Escape") { e.preventDefault(); close(); return; }
      if (e.key === "Tab") {
        const f = Array.from(cross.querySelectorAll<HTMLElement>("a[href], button:not([disabled])")).filter((el) => el.offsetParent !== null);
        if (!f.length) return;
        const first = f[0], last = f[f.length - 1];
        if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
        else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
      }
    });

    place(0);
  });
</script>

<style>
  .sd {
    position: relative;
    min-height: clamp(720px, 100vh, 1040px);
    display: grid; place-items: center;
    padding: clamp(36px, 6vh, 72px) clamp(16px, 4vw, 40px) clamp(28px, 4vh, 48px);
    border-top: 1px solid rgba(245, 241, 232, 0.08);
    background:
      radial-gradient(60% 54% at 50% 44%, rgba(14, 196, 252, 0.055), transparent 78%),
      radial-gradient(132% 112% at 50% 56%, transparent 44%, rgba(0, 0, 0, 0.64) 100%);
    text-align: left;
  }

  /* ════ THE EQUIPMENT BAY ════ a pure background SET: the gateway is bolted into the
     head of a facility aisle. Server-rack silhouettes recede into a cool haze down each
     flank; a perspective floor runs far below; one warm key-light from upper-left makes
     it read as one room. Achromatic steel (built BELOW the panel's darkest value) so the
     panel's own amber/cyan/green stay the only saturated pixels. z-index 0, behind the
     panel (.sd-gate is z-index 1), pointer-events none, every plane masked to dissolve
     before it reaches the casing — nothing fused to the panel, nothing recolored. */
  .sd-set { position: absolute; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
  .sd-gate { position: relative; z-index: 1; display: flex; justify-content: center; }

  /* 1 · cool volumetric haze + the single warm key-light (upper-left). low alpha;
        this greys the far racks (aerial perspective) */
  .sd-set-haze { position: absolute; inset: 0;
    background:
      radial-gradient(70% 56% at 22% 12%, rgba(255, 246, 230, 0.05), transparent 60%),
      radial-gradient(120% 64% at 50% 98%, rgba(150, 180, 205, 0.05), transparent 62%),
      radial-gradient(58% 42% at 50% 88%, rgba(14, 196, 252, 0.02), transparent 72%); }

  /* 2 · the receding aisle floor, far below + tilted away, masked off the panel */
  .sd-set-floor { position: absolute; left: 50%; bottom: -4%; width: 188%; height: 320px;
    transform: translateX(-50%) perspective(900px) rotateX(74deg); transform-origin: 50% 100%;
    background:
      repeating-linear-gradient(90deg, rgba(120, 150, 180, 0.1) 0 1px, transparent 1px 66px),
      repeating-linear-gradient(0deg, rgba(120, 150, 180, 0.06) 0 1px, transparent 1px 54px);
    -webkit-mask-image: radial-gradient(76% 100% at 50% 0, #000, transparent 70%);
            mask-image: radial-gradient(76% 100% at 50% 0, #000, transparent 70%);
    opacity: 0.5; }

  /* 3 · a cable conduit on the floor running toward the panel base; idle = tray only,
        boot = one bright segment travels it once (the facility answering) */
  .sd-set-conduit { position: absolute; left: 50%; bottom: 3%; width: 4px; height: 22%; transform: translateX(-50%);
    border-radius: 2px; overflow: hidden; opacity: 0.42;
    background: linear-gradient(180deg, rgba(120, 150, 180, 0.14), rgba(120, 150, 180, 0.05)); }
  .sd-set-conduit i { position: absolute; left: 0; right: 0; top: -50%; height: 50%; border-radius: 2px; opacity: 0;
    background: linear-gradient(0deg, transparent, #19e0ff 60%, transparent); }
  .sd[data-booted="on"] .sd-set-conduit i { animation: sd-set-flow 2.4s ease-out 0.3s 1 both; }
  @keyframes sd-set-flow { 0% { top: -50%; opacity: 0; } 18% { opacity: 0.8; } 100% { top: 120%; opacity: 0; } }

  /* 4 · contact-shadow / AO pool directly UNDER the panel base — welds it to the floor.
        the only set element near the footprint, and it's a dark pool below, not a line beside */
  .sd-set-contact { position: absolute; left: 50%; bottom: 22%; width: 70%; max-width: 1000px; height: 60px; transform: translateX(-50%);
    background: radial-gradient(60% 100% at 50% 50%, rgba(0, 0, 0, 0.6), transparent 72%); }

  /* 5 · server-rack silhouettes flanking the panel, anchored OUTSIDE its 1080px footprint */
  .sd-racks { position: absolute; inset: 0; }
  /* anchored OUTSIDE the panel: each flank's inner edge sits at the panel's max
     half-width (540px) + a 26px gutter, extending outward and clipping at the frame.
     As the viewport narrows the panel claims the width and the racks slide off. */
  .sd-racks svg { position: absolute; bottom: 5%; width: clamp(120px, 15vw, 230px); height: auto; }
  .sd-racks .left { right: calc(50% + 566px); }
  .sd-racks .right { left: calc(50% + 566px); transform: scaleX(-1); }
  .bay-cab .cab-body { fill: #0c1016; stroke: rgba(0, 0, 0, 0.6); stroke-width: 1; }
  .bay-cab.rank-1 .cab-body { fill: #11161e; } .bay-cab.rank-2 .cab-body { fill: #161c25; }   /* farther = greyer (haze) */
  .bay-cab .cab-bezel { fill: rgba(150, 168, 190, 0.12); }                                     /* top edge lit by the key-light */
  .bay-cab .cab-slot { fill: rgba(0, 0, 0, 0.42); }
  .bay-cab.rank-0 .cab-slot { fill: rgba(0, 0, 0, 0.5); }
  .led { fill: rgba(120, 150, 180, 0.2); }                                                      /* most dots: dim, unlit steel */
  .led.on-green { fill: #00ff4d; filter: drop-shadow(0 0 2px rgba(0, 255, 77, 0.8)); }
  .led.on-amber { fill: #ff8e2e; filter: drop-shadow(0 0 2px rgba(255, 142, 46, 0.8)); }
  .led.on-cyan  { fill: #19e0ff; filter: drop-shadow(0 0 2px rgba(25, 224, 255, 0.8)); }
  .led.blink { animation: sd-set-tele 11s ease-in-out var(--d, 0s) infinite; }                 /* slow desynced telemetry */
  @keyframes sd-set-tele { 0%, 44%, 100% { opacity: 1; } 48%, 52% { opacity: 0.25; } }
  .led.wake { opacity: 0; }                                                                     /* a couple answer the boot */
  .sd[data-booted="on"] .led.wake { fill: #19e0ff; filter: drop-shadow(0 0 2px rgba(25, 224, 255, 0.7)); animation: sd-set-wake 0.5s ease-out var(--d, 0s) both; }
  @keyframes sd-set-wake { from { opacity: 0; } to { opacity: 1; } }

  @media (max-width: 760px) {
    .sd-racks { display: none; }
    .sd-set-floor { opacity: 0.3; }
    .sd-set-contact { width: 86%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .sd-set-conduit i { animation: none !important; opacity: 0.45; }
    .led.blink { animation: none !important; }
    .sd[data-booted="on"] .led.wake { animation: none !important; opacity: 1; }
  }

  /* ── the access console ── */
  .sd-console {
    position: relative; width: min(1080px, 94vw); border-radius: 26px; padding: clamp(15px, 1.7vw, 24px) clamp(17px, 1.9vw, 28px) clamp(13px, 1.5vw, 20px);
    cursor: default;
    background:
      radial-gradient(78% 64% at 50% 18%, rgba(38, 46, 60, 0.6), transparent 72%),
      repeating-linear-gradient(98deg, rgba(255, 255, 255, 0.012) 0 2px, transparent 2px 5px),
      linear-gradient(162deg, #2b313d 0%, #181c25 46%, #0f1219 100%);
    border: 1px solid rgba(0, 0, 0, 0.6);
    box-shadow: 0 64px 120px -44px rgba(0, 0, 0, 0.92), inset 0 2px 0 rgba(255, 255, 255, 0.14), inset 0 -5px 12px rgba(0, 0, 0, 0.6), inset 0 0 0 1px rgba(120, 160, 210, 0.05);
    transition: filter 600ms ease, box-shadow 600ms ease;
  }
  .sd[data-powered="off"] .sd-console { filter: brightness(0.9) saturate(0.82); }
  .sd[data-booted="on"] .sd-console { box-shadow: 0 64px 120px -44px rgba(0, 0, 0, 0.92), inset 0 2px 0 rgba(255, 255, 255, 0.14), inset 0 -5px 12px rgba(0, 0, 0, 0.6), inset 0 0 0 1px rgba(0, 255, 77, 0.13), 0 0 64px -30px rgba(0, 255, 77, 0.32); }

  .sd-bolt { position: absolute; width: 11px; height: 11px; border-radius: 50%; background: radial-gradient(circle at 38% 32%, #535a67, #14171d); box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.55), 0 1px 0 rgba(255, 255, 255, 0.06); }
  .sd-bolt::after { content: ""; position: absolute; inset: 3px; border-top: 1px solid rgba(0, 0, 0, 0.5); transform: rotate(40deg); }
  .sd-b-tl { top: 15px; left: 15px; } .sd-b-tr { top: 15px; right: 15px; } .sd-b-bl { bottom: 13px; left: 15px; } .sd-b-br { bottom: 13px; right: 15px; }

  /* top bar — wordmark etched into the casing */
  .sd-top { display: flex; align-items: center; gap: 13px; padding: 2px 14px 14px; }
  .sd-brand { flex: 1; font-family: ui-monospace, "SF Mono", SFMono-Regular, Menlo, monospace; font-weight: 700; font-size: 16px; letter-spacing: 0.06em;
    color: #20242c; text-shadow: 0 1px 0 rgba(255, 255, 255, 0.13), 0 -1px 1px rgba(0, 0, 0, 0.7); }
  .sd-brand-dot { color: #14525e; text-shadow: 0 1px 0 rgba(120, 230, 255, 0.18), 0 -1px 1px rgba(0, 0, 0, 0.6); }
  .sd[data-booted="on"] .sd-brand-dot { color: #1c6c7a; }
  .sd-top-tag { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 8.5px; letter-spacing: 0.18em; text-transform: uppercase; color: #1c2129; text-shadow: 0 1px 0 rgba(255, 255, 255, 0.08); }
  .sd-lock { display: inline-flex; color: rgba(20, 24, 30, 0.9); filter: drop-shadow(0 1px 0 rgba(255, 255, 255, 0.1)); transition: color 240ms ease; }
  .sd[data-booted="on"] .sd-lock { color: rgba(14, 196, 252, 0.8); filter: none; }

  /* the cool dedicated power button */
  .sd-power { position: relative; width: clamp(50px, 4.8vw, 60px); aspect-ratio: 1; border-radius: 50%; flex: 0 0 auto; cursor: pointer; display: grid; place-items: center; border: 1px solid rgba(0, 0, 0, 0.72); padding: 0;
    background: radial-gradient(circle at 50% 36%, #2c333e 0%, #171b22 58%, #0b0e13 100%);
    box-shadow: 0 6px 14px -3px rgba(0, 0, 0, 0.72), inset 0 2px 1px rgba(255, 255, 255, 0.22), inset 0 -6px 11px rgba(0, 0, 0, 0.78), inset 0 0 0 1px rgba(120, 160, 210, 0.06);
    transition: transform 90ms ease, box-shadow 240ms ease; }
  .sd-power-bezel { position: absolute; inset: -3px; border-radius: 50%; z-index: -1; background: conic-gradient(from 130deg, #474e5b, #15181e 24%, #474e5b 50%, #15181e 74%, #474e5b); box-shadow: 0 2px 7px rgba(0, 0, 0, 0.6); }
  .sd-power-ring { position: absolute; inset: 6px; border-radius: 50%; border: 1.6px solid rgba(255, 142, 46, 0.5); box-shadow: 0 0 10px rgba(255, 142, 46, 0.4), inset 0 0 9px rgba(255, 142, 46, 0.28); transition: border-color 280ms ease, box-shadow 280ms ease; }
  .sd[data-powered="off"] .sd-power-ring { animation: sd-standby 1.9s ease-in-out infinite; }
  @keyframes sd-standby { 0%, 100% { opacity: 0.46; } 50% { opacity: 1; } }
  .sd-power-glyph { width: 42%; height: 42%; fill: none; stroke: rgba(255, 150, 60, 0.92); stroke-width: 2.3; stroke-linecap: round; z-index: 1; transition: stroke 280ms ease, filter 280ms ease; }
  .sd[data-powered="on"] .sd-power { box-shadow: 0 6px 14px -3px rgba(0, 0, 0, 0.72), inset 0 2px 1px rgba(255, 255, 255, 0.22), inset 0 -6px 11px rgba(0, 0, 0, 0.78), 0 0 22px -4px rgba(14, 196, 252, 0.7); }
  .sd[data-powered="on"] .sd-power-ring { border-color: rgba(14, 196, 252, 0.85); box-shadow: 0 0 16px rgba(14, 196, 252, 0.7), inset 0 0 11px rgba(14, 196, 252, 0.45); }
  .sd[data-powered="on"] .sd-power-glyph { stroke: #cdf4ff; filter: drop-shadow(0 0 6px rgba(14, 196, 252, 0.95)); }
  .sd-power:hover { transform: translateY(-1px); }
  .sd-power:active { transform: translateY(2px) scale(0.97); box-shadow: inset 0 4px 9px rgba(0, 0, 0, 0.85), inset 0 0 0 1px rgba(120, 160, 210, 0.06); }
  .sd-power:focus-visible { outline: none; box-shadow: 0 0 0 3px rgba(14, 196, 252, 0.5), inset 0 2px 1px rgba(255, 255, 255, 0.22); }

  .sd-body { display: flex; align-items: stretch; gap: clamp(12px, 1.4vw, 18px); }

  /* the five vault-terminal CRTs — wake slowly, like old bulbs */
  .sd-strip { display: flex; flex-direction: column; gap: clamp(8px, 1vw, 12px); flex: 0 0 auto; cursor: help; border-radius: 10px; }
  .sd-strip:focus-visible { outline: none; }
  .sd-strip:focus-visible .sd-crt { box-shadow: inset 0 0 0 1px rgba(14, 196, 252, 0.6), inset 0 3px 10px rgba(0,0,0,.85); }
  .sd-crt { position: relative; flex: 1 1 0; min-height: 56px; width: clamp(66px, 7vw, 88px); border-radius: 12px; overflow: hidden; display: grid; place-items: center;
    background: radial-gradient(120% 120% at 50% 30%, #0a160e, #050b07 70%, #030604);
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.8), inset 0 3px 10px rgba(0, 0, 0, 0.85), inset 0 0 22px rgba(0, 0, 0, 0.7);
    transition: box-shadow 1.6s ease calc(1s + var(--bd, 0s)); }
  .sd-crt-emoji { position: relative; z-index: 2; font-size: clamp(28px, 3.1vw, 38px); line-height: 1; opacity: 0; filter: grayscale(0.6) brightness(0.4); }
  /* the emoji panels hold dark, then ~2s after the borders land they warm up like
     old bulbs — slow (3.5s), catching a couple of times, staggered down the stack */
  .sd[data-booted="on"] .sd-crt-emoji {
    filter: blur(0.45px) saturate(1.08) contrast(1.04) brightness(0.68)
      drop-shadow(0.5px 0 0 rgba(255, 70, 70, 0.22)) drop-shadow(-0.5px 0 0 rgba(70, 170, 255, 0.22)) drop-shadow(0 0 4px rgba(43, 255, 136, 0.24));
    animation: sd-bulb 3.5s ease-out calc(1s + var(--bd, 0s)) both, sd-analog 5s steps(1) calc(1s + var(--bd, 0s) + 3.7s) infinite; }
  @keyframes sd-bulb {
    0% { opacity: 0; } 12% { opacity: 0.13; } 16% { opacity: 0.03; }
    31% { opacity: 0.34; } 36% { opacity: 0.08; } 54% { opacity: 0.66; } 60% { opacity: 0.44; }
    100% { opacity: 1; } }
  @keyframes sd-analog { 0%, 92%, 100% { opacity: 1; } 93% { opacity: 0.82; } 95% { opacity: 1; } 97% { opacity: 0.9; } }
  .sd-crt-scan { position: absolute; inset: 0; z-index: 3; pointer-events: none; opacity: 0; background: repeating-linear-gradient(0deg, rgba(43, 255, 136, 0.08) 0 1px, transparent 1px 3px); transition: opacity 1.6s ease calc(1s + var(--bd, 0s)); mix-blend-mode: screen; }
  .sd[data-booted="on"] .sd-crt-scan { opacity: 1; }
  .sd-crt-vig { position: absolute; inset: 0; z-index: 4; pointer-events: none; border-radius: 12px; background: radial-gradient(120% 100% at 50% 38%, transparent 50%, rgba(0, 0, 0, 0.58)); box-shadow: inset 0 0 20px rgba(0, 0, 0, 0.65); }
  .sd-crt::after { content: ""; position: absolute; inset: 0; z-index: 5; pointer-events: none; border-radius: 12px; background: radial-gradient(60% 36% at 38% 18%, rgba(255, 255, 255, 0.14), transparent 60%); }
  .sd[data-booted="on"] .sd-crt { box-shadow: inset 0 0 0 1px rgba(43, 255, 136, 0.16), inset 0 3px 10px rgba(0, 0, 0, 0.85), inset 0 0 26px rgba(43, 255, 136, 0.08); transition: box-shadow 1.6s ease calc(1s + var(--bd, 0s)); }
  .sd[data-booted="on"] .sd-crt::before { content: ""; position: absolute; inset: 0; z-index: 1; opacity: 0; background: radial-gradient(80% 70% at 50% 60%, rgba(43, 255, 136, 0.11), transparent 72%); animation: sd-bulbwash 3.5s ease-out calc(1s + var(--bd, 0s)) forwards; }
  @keyframes sd-bulbwash { 0% { opacity: 0; } 50% { opacity: 0.36; } 100% { opacity: 1; } }
  /* the sound screen: identical to the others until you hover — and its glow stays
     inside the glass (all-inset, no outer bleed onto the casing) */
  .sd[data-decoding="true"] .sd-crt-sound { box-shadow: inset 0 0 0 1.5px rgba(14, 196, 252, 0.9), inset 0 3px 10px rgba(0, 0, 0, 0.6), inset 0 0 52px rgba(14, 196, 252, 0.62); transition: box-shadow 240ms ease; }
  .sd[data-decoding="true"] .sd-crt-sound::before { opacity: 1; background: radial-gradient(80% 74% at 50% 52%, rgba(120, 230, 255, 0.55), rgba(14, 196, 252, 0.3) 48%, transparent 74%); }
  .sd[data-decoding="true"] .sd-crt-sound .sd-crt-emoji { filter: brightness(1.16) drop-shadow(0 0 10px rgba(120, 230, 255, 0.85)); transform: scale(1.06); transition: filter 240ms ease, transform 240ms ease; }

  .sd-right { flex: 1 1 auto; display: flex; flex-direction: column; gap: clamp(10px, 1.2vw, 16px); min-width: 0; }

  /* the two big screens — vault-terminal CRT glass (fallout) */
  .sd-screen { position: relative; border-radius: 14px; overflow: hidden;
    background: radial-gradient(120% 116% at 50% 24%, #0a160e, #050b07 72%, #030604);
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.8), inset 0 3px 13px rgba(0, 0, 0, 0.84), inset 0 0 28px rgba(0, 0, 0, 0.62);
    transition: box-shadow 500ms ease; }
  .sd-screen::before { content: ""; position: absolute; inset: 0; z-index: 6; pointer-events: none; opacity: 0; transition: opacity 500ms ease; background: repeating-linear-gradient(0deg, rgba(43, 255, 136, 0.055) 0 1px, transparent 1px 3px); mix-blend-mode: screen; }
  .sd[data-booted="on"] .sd-screen::before { opacity: 1; }
  .sd-screen::after { content: ""; position: absolute; inset: 0; z-index: 7; pointer-events: none; border-radius: 14px; background: radial-gradient(122% 104% at 50% 40%, transparent 52%, rgba(0, 0, 0, 0.52)); box-shadow: inset 0 0 26px rgba(0, 0, 0, 0.6); }
  .sd[data-booted="on"] .sd-screen { box-shadow: inset 0 0 0 1px rgba(43, 255, 136, 0.16), inset 0 3px 13px rgba(0, 0, 0, 0.84), inset 0 0 32px rgba(43, 255, 136, 0.06); }
  .sd-screen-label { position: absolute; top: 11px; left: 14px; z-index: 8; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 8px; letter-spacing: 0.24em; color: rgba(43, 255, 136, 0.1); transition: color 500ms ease; }
  .sd[data-booted="on"] .sd-screen-label { color: rgba(43, 255, 136, 0.46); }

  .sd-roll { position: absolute; left: 0; right: 0; top: -42%; height: 42%; z-index: 7; pointer-events: none; opacity: 0; background: linear-gradient(transparent, rgba(43, 255, 136, 0.12), transparent); }
  .sd[data-booted="on"] .sd-roll { animation: sd-roll 0.9s ease-out 0.04s; }
  @keyframes sd-roll { 0% { opacity: 0; transform: translateY(0); } 18% { opacity: 1; } 100% { opacity: 0; transform: translateY(280%); } }

  /* the border trace — one bright cyan LED line each side, slow + smooth */
  .sd-trace { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 9; pointer-events: none; overflow: visible; opacity: 0; transition: opacity 520ms ease; }
  [data-sd-trace][data-trace="draw"] .sd-trace { opacity: 1; }
  [data-sd-trace][data-trace="done"] .sd-trace { opacity: 0; }
  .sd-trace-l, .sd-trace-r { fill: none; stroke: #b9f3ff; stroke-width: 2.1; stroke-linecap: round; vector-effect: non-scaling-stroke;
    filter: drop-shadow(0 0 4px #19e0ff) drop-shadow(0 0 12px rgba(25, 224, 255, 0.9)) drop-shadow(0 0 22px rgba(25, 224, 255, 0.5));
    transition: stroke-dashoffset 1.2s cubic-bezier(0.62, 0, 0.2, 1); }

  /* code-entry screen — left-justified terminal column */
  .sd-screen-code { flex: 1 1 auto; min-height: clamp(230px, 32vh, 330px); display: flex; align-items: center; justify-content: flex-start; padding: clamp(26px, 3.4vw, 44px) clamp(30px, 4vw, 56px); }
  .sd-codewrap { position: relative; z-index: 2; display: flex; flex-direction: column; align-items: flex-start; gap: clamp(14px, 1.8vw, 22px); opacity: 0; transition: opacity 520ms ease 0.12s; }
  .sd[data-booted="on"] .sd-codewrap { opacity: 1; }
  .sd-prompt { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: clamp(11px, 1.2vw, 13px); letter-spacing: 0.24em; text-transform: uppercase; color: #34ff79; text-shadow: 0 0 7px rgba(0, 255, 77, 0.55); }
  .sd-prompt-txt { display: inline-block; overflow: hidden; white-space: nowrap; vertical-align: bottom; }
  .sd[data-booted="on"] .sd-prompt-txt { width: 0; animation: sd-type 1s steps(17) 0.34s forwards; }
  @keyframes sd-type { to { width: 17ch; } }
  .sd-tiles { display: inline-flex; align-items: center; gap: clamp(6px, 0.8vw, 10px); }
  .sd-tile { position: relative; width: clamp(30px, 3.2vw, 42px); height: clamp(40px, 4.3vw, 54px); border-radius: 5px; display: inline-flex; align-items: center; justify-content: center; font-family: "Space Grotesk Variable", "Space Grotesk", sans-serif; font-weight: 700; font-size: clamp(19px, 2.3vw, 27px); text-transform: lowercase; color: #bdf2cf; border: 1px solid rgba(43, 255, 136, 0.12); background: rgba(8, 18, 12, 0.32); transition: border-color 220ms ease, background 220ms ease, color 200ms ease; }
  /* empty cells: a faint terminal underscore */
  .sd-tile[data-lit="false"]::before { content: ""; position: absolute; left: 24%; right: 24%; bottom: 8px; height: 2px; border-radius: 1px; background: rgba(43, 255, 136, 0.2); transition: background 220ms ease, box-shadow 220ms ease; }
  .sd-tile[data-lit="true"] { border-color: rgba(0, 255, 77, 0.28); background: rgba(0, 255, 77, 0.045); color: #d8ffe4; text-shadow: 0 0 8px rgba(0, 255, 77, 0.6); animation: sd-pop 0.3s cubic-bezier(0.2, 1, 0.32, 1); }
  @keyframes sd-pop { 0% { transform: translateY(-3px) scale(1.1); } 100% { transform: none; } }
  /* the active cell: a soft green cursor — subtle, gently blinking (no bright fill) */
  .sd-tile[data-active="true"] { border-color: rgba(0, 255, 77, 0.34); background: rgba(0, 255, 77, 0.05); }
  .sd-tile[data-active="true"]::before { background: #34ff79; box-shadow: 0 0 8px rgba(0, 255, 77, 0.7); }
  .sd[data-booted="on"] .sd-tile[data-active="true"]::before { animation: sd-curblink 1.15s ease-in-out infinite; }
  @keyframes sd-curblink { 0%, 100% { opacity: 1; } 50% { opacity: 0.22; } }
  .sd[data-shake="1"] .sd-tiles { animation: sd-shake 0.34s cubic-bezier(0.36, 0.07, 0.19, 0.97); }
  @keyframes sd-shake { 10%, 90% { transform: translateX(-1px); } 20%, 80% { transform: translateX(2px); } 30%, 50%, 70% { transform: translateX(-4px); } 40%, 60% { transform: translateX(4px); } }
  .sd-input { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 10; opacity: 0; border: 0; background: transparent; cursor: text; color: transparent; caret-color: transparent; font-size: 16px; }

  /* decode screen — garbled block that extinguishes into BENDER (left-justified) */
  .sd-screen-decode { flex: 0 0 auto; min-height: clamp(120px, 16vh, 158px); display: flex; align-items: center; justify-content: flex-start; padding: 18px clamp(30px, 4vw, 56px); cursor: help; }
  .sd-readout { position: relative; z-index: 2; display: flex; align-items: center; justify-content: flex-start; gap: clamp(5px, 0.7vw, 9px); opacity: 0; transition: opacity 380ms ease; }
  .sd[data-booted="on"] .sd-readout { opacity: 0.85; }
  .sd[data-booted="on"]:not([data-decoding="true"]) .sd-readout { animation: sd-garble 1.7s steps(1) infinite; }
  @keyframes sd-garble { 0%, 100% { opacity: 0.62; transform: translateX(0); } 19% { opacity: 0.46; } 33% { opacity: 0.66; transform: translateX(-2px); } 35% { transform: translateX(0); } 58% { opacity: 0.4; } 76% { opacity: 0.64; transform: translateX(2px); } 78% { transform: translateX(0); } }
  .sd[data-decoding="true"] .sd-readout { opacity: 1; }
  .sd-glyph { display: inline-flex; width: clamp(24px, 2.8vw, 34px); transform: skewX(-7deg) translateY(var(--oy, 0)); transition: transform 300ms cubic-bezier(0.3, 1, 0.32, 1); }
  .sd[data-decoding="true"] .sd-glyph { transform: skewX(-7deg) translateY(0); }
  .sd-glyph svg { width: 100%; height: auto; overflow: visible; }
  .sd-seg { stroke: rgba(0, 255, 77, 0.08); stroke-width: 8; stroke-linecap: round; transition: stroke 120ms linear; }
  /* garbled: every segment lit, dim + cold; resolved: only the true word, bright */
  .sd-seg[data-on="true"] { stroke: #1c7a3c; filter: none; }
  .sd[data-decoding="true"] .sd-seg[data-on="true"] { stroke: #9bffbf; filter: drop-shadow(0 0 5px rgba(0, 255, 77, 1)) drop-shadow(0 0 14px rgba(0, 255, 77, 0.65)); }
  .sd[data-decoding="true"] .sd-seg { transition: stroke 260ms ease; }

  .sd-foot { display: flex; align-items: center; gap: 12px; padding: 14px 14px 2px; }
  .sd-grille { width: 32px; height: 8px; border-radius: 2px; background: repeating-linear-gradient(90deg, rgba(245, 241, 232, 0.22) 0 1.5px, transparent 1.5px 4px); opacity: 0.55; }
  .sd-foot-tag { flex: 1; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 8.5px; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(245, 241, 232, 0.32); transition: color 300ms ease; }
  .sd[data-powered="off"] .sd-foot-tag { color: rgba(255, 142, 46, 0.6); }
  .sd-q { width: 22px; height: 22px; border-radius: 50%; display: none; align-items: center; justify-content: center; font-family: "Space Grotesk Variable", "Space Grotesk", sans-serif; font-weight: 700; font-size: 13px; color: rgba(245, 241, 232, 0.5); background: rgba(245, 241, 232, 0.04); border: 1px solid rgba(245, 241, 232, 0.2); cursor: pointer; transition: color 160ms ease, border-color 160ms ease, background 160ms ease; }
  .sd[data-decoded="true"] .sd-q { display: inline-flex; }
  .sd-q:hover, .sd-q:focus-visible { color: var(--brand-cyan); border-color: var(--brand-cyan); background: rgba(14, 196, 252, 0.08); outline: none; }
  .sd-q-ans { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 11px; letter-spacing: 0.12em; color: var(--brand-green); font-weight: 600; }

  @media (max-width: 760px) {
    .sd-body { flex-direction: column; align-items: center; }
    .sd-strip { flex-direction: row; flex-wrap: wrap; justify-content: center; }
    .sd-crt { flex: 0 0 auto; width: clamp(58px, 16vw, 76px); height: clamp(58px, 16vw, 76px); min-height: 0; }
    .sd-right { width: 100%; }
    .sd-screen-code, .sd-screen-decode { padding-left: clamp(20px, 6vw, 36px); padding-right: clamp(20px, 6vw, 36px); }
    .sd-top-tag { display: none; }
  }

  /* ───────────────────────── the crossing ───────────────────────── */
  .sd-cross { position: fixed; inset: 0; z-index: 200; overflow: hidden; opacity: 0; transition: opacity 300ms ease;
    background: radial-gradient(130% 78% at 50% -12%, rgba(255, 59, 110, 0.15), transparent 58%), radial-gradient(130% 92% at 50% 116%, rgba(14, 196, 252, 0.17), transparent 56%), #050409; }
  .sd-cross[hidden] { display: none; }
  .sd-cross[data-on="true"] { opacity: 1; }
  .rig { position: absolute; inset: 0; display: flex; flex-direction: column; color: #e8edf4; font-family: "Geist Variable", ui-sans-serif, system-ui, sans-serif; }

  .rig-bar { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 16px clamp(18px, 4vw, 44px); flex: 0 0 auto; z-index: 3; }
  .rig-wm { font-family: ui-monospace, "SF Mono", SFMono-Regular, Menlo, monospace; font-weight: 700; font-size: 16px; letter-spacing: -0.01em; background: linear-gradient(96deg, #ff3b6e, #ff6e21); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .rig-wm-dot { -webkit-text-fill-color: #0ec4fc; color: #0ec4fc; }
  .rig-esc { display: inline-flex; align-items: center; gap: 8px; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(245, 241, 232, 0.62); background: rgba(245, 241, 232, 0.04); border: 1px solid rgba(245, 241, 232, 0.16); border-radius: 7px; padding: 7px 11px; cursor: pointer; transition: color 160ms ease, border-color 160ms ease, background 160ms ease; }
  .rig-esc:hover, .rig-esc:focus-visible { outline: none; color: #f5f1e8; border-color: rgba(245, 241, 232, 0.42); background: rgba(245, 241, 232, 0.08); }
  .rig-esc-key { font-size: 9px; letter-spacing: 0.12em; padding: 2px 5px; border-radius: 3px; border: 1px solid rgba(245, 241, 232, 0.26); color: rgba(245, 241, 232, 0.5); }

  /* ── pipeline tabs in the top bar — the live module is the Engineer stage (lit) ── */
  .rig-tabs { flex: 1; display: flex; align-items: center; justify-content: center; gap: 6px; min-width: 0; }
  .rig-tab { display: flex; flex-direction: column; align-items: center; line-height: 1.12; padding: 4px 12px; border-radius: 7px; border: 1px solid rgba(245, 241, 232, 0.08); background: rgba(245, 241, 232, 0.012); }
  .rig-tab-label { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 11px; font-weight: 700; letter-spacing: 0.03em; color: rgba(245, 241, 232, 0.34); }
  .rig-tab-sub { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 7.5px; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(245, 241, 232, 0.2); margin-top: 2px; }
  .rig-tab-arrow { color: rgba(245, 241, 232, 0.2); font-size: 12px; flex: 0 0 auto; }
  .rig-tab-on { border-color: rgba(14, 196, 252, 0.38); background: rgba(14, 196, 252, 0.06); box-shadow: 0 0 18px -7px rgba(14, 196, 252, 0.6); }
  .rig-tab-on .rig-tab-label { color: var(--brand-cyan); }
  .rig-tab-on .rig-tab-sub { color: rgba(14, 196, 252, 0.55); }
  .rig-preview { display: inline-flex; align-items: center; gap: 6px; flex: 0 0 auto; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 9px; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(255, 179, 71, 0.7); border: 1px solid rgba(255, 179, 71, 0.26); border-radius: 5px; padding: 4px 9px; }
  .rig-preview-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--brand-yellow); box-shadow: 0 0 7px rgba(255, 179, 71, 0.9); }

  /* ── the grayed-out product backdrop (decorative, dim, behind the module) ── */
  .rig-backdrop { position: absolute; inset: 0; z-index: 1; pointer-events: none; overflow: hidden; }
  /* a soft spotlight pops the module out of the dim UI + a gentle vignette (first child,
     so it paints BEHIND the panels — they stay readable) */
  .rig-spot { position: absolute; inset: 0;
    background:
      radial-gradient(44vw 58vh at 50% 47%, rgba(14, 196, 252, 0.05), transparent 60%),
      radial-gradient(140% 108% at 50% 46%, transparent 42%, rgba(5, 4, 9, 0.55) 100%); }

  .rig-panel { position: absolute; top: 50%; transform: translateY(-50%); width: clamp(186px, 17vw, 250px);
    border: 1px solid rgba(245, 241, 232, 0.08); border-radius: 10px; padding: 12px 13px;
    background: linear-gradient(180deg, rgba(245, 241, 232, 0.025), rgba(245, 241, 232, 0.008));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.03); }
  .rig-panel-dex { left: clamp(18px, 4vw, 64px); }
  .rig-panel-eng { right: clamp(18px, 4vw, 64px); }
  .rig-panel-head { display: flex; align-items: center; gap: 7px; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 11px; font-weight: 700; letter-spacing: 0.05em; color: rgba(245, 241, 232, 0.5); padding-bottom: 9px; margin-bottom: 9px; border-bottom: 1px solid rgba(245, 241, 232, 0.07); }
  .rig-panel-head em { margin-left: auto; font-style: normal; font-size: 8px; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(245, 241, 232, 0.28); }
  .rig-panel-dot { width: 6px; height: 6px; border-radius: 50%; background: rgba(245, 241, 232, 0.3); flex: 0 0 auto; }
  .rig-panel-dex .rig-panel-dot { background: rgba(14, 196, 252, 0.55); box-shadow: 0 0 6px rgba(14, 196, 252, 0.5); }
  .rig-panel-eng .rig-panel-dot { background: rgba(0, 255, 77, 0.5); box-shadow: 0 0 6px rgba(0, 255, 77, 0.45); }
  .rig-panel-foot { margin-top: 10px; padding-top: 8px; border-top: 1px solid rgba(245, 241, 232, 0.07); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 8.5px; letter-spacing: 0.03em; color: rgba(245, 241, 232, 0.3); }

  .rig-bucketlist, .rig-englist { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 6px; }
  .rig-bucket { display: grid; grid-template-columns: 4em 1fr auto; align-items: center; gap: 8px; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 10.5px; color: rgba(245, 241, 232, 0.4); }
  .rig-bucket-bar { height: 3px; border-radius: 2px; background: rgba(245, 241, 232, 0.06); overflow: hidden; }
  .rig-bucket-bar i { display: block; height: 100%; width: var(--w); border-radius: 2px; background: rgba(245, 241, 232, 0.22); }
  .rig-bucket-n { font-feature-settings: "tnum"; color: rgba(245, 241, 232, 0.34); font-size: 10px; }
  .rig-bucket-on { color: var(--brand-cyan); }
  .rig-bucket-on .rig-bucket-bar i { background: var(--brand-cyan); box-shadow: 0 0 6px rgba(14, 196, 252, 0.5); }
  .rig-bucket-on .rig-bucket-n { color: var(--brand-cyan); }

  .rig-engrow { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 10.5px; }
  .rig-eng-k { color: rgba(245, 241, 232, 0.36); }
  .rig-eng-v { color: rgba(245, 241, 232, 0.5); font-feature-settings: "tnum"; }
  .rig-engrow-win .rig-eng-k { color: rgba(255, 179, 71, 0.7); }
  .rig-engrow-win .rig-eng-v { color: var(--brand-yellow); text-shadow: 0 0 8px rgba(255, 179, 71, 0.4); }

  .rig-status { position: absolute; left: 0; right: 0; bottom: clamp(10px, 2.4vh, 22px); display: flex; align-items: center; justify-content: center; gap: 9px; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 8.5px; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(245, 241, 232, 0.26); }
  .rig-status-sep { opacity: 0.5; }
  .rig-status-live { color: rgba(0, 255, 77, 0.55); }

  @media (max-width: 1180px) { .rig-panel, .rig-spot { display: none; } }
  @media (max-width: 760px) { .rig-tabs, .rig-preview { display: none; } .rig-status { font-size: 7.5px; gap: 6px; } }

  .rig-stage { position: relative; flex: 1; min-height: 0; display: flex; align-items: safe center; justify-content: center; overflow-y: auto; padding: 0 clamp(18px, 4vw, 56px) clamp(20px, 5vh, 48px); perspective: 1500px; }
  /* short viewports: shrink the hero so the whole machine stays on screen */
  /* short viewports: scale the whole forge+orbit down (the forge internals are px-tuned,
     so scale rather than resize). margin compensates so it doesn't reserve 232px of height. */
  @media (max-height: 820px) {
    .kiln-dome.ft-forge-host { transform: scale(0.82); margin: -20px 0; }
    .rig-console { gap: clamp(5px, 1vh, 11px); padding-bottom: clamp(34px, 5vh, 46px); }
  }
  .rig-floor { position: absolute; left: 0; right: 0; bottom: 0; height: 46%; pointer-events: none; opacity: 0.6;
    background: repeating-linear-gradient(90deg, rgba(14, 196, 252, 0.1) 0 1px, transparent 1px 58px), repeating-linear-gradient(0deg, rgba(14, 196, 252, 0.06) 0 1px, transparent 1px 46px);
    -webkit-mask-image: linear-gradient(transparent, #000 82%); mask-image: linear-gradient(transparent, #000 82%);
    transform: perspective(540px) rotateX(64deg); transform-origin: bottom; }

  /* ONE machine, leaning toward the room. Material lifted from the kiln console. */
  .rig-console {
    position: relative; flex: 0 0 auto; z-index: 2;
    width: clamp(430px, 46vw, 600px);
    display: flex; flex-direction: column; align-items: center; gap: clamp(7px, 1.3vh, 15px);
    padding: clamp(18px, 2.4vh, 30px) clamp(22px, 2.4vw, 38px) clamp(42px, 5vh, 52px);
    border-radius: 26px; border: 1px solid rgba(0, 0, 0, 0.6);
    background:
      radial-gradient(80% 58% at 50% 13%, rgba(40, 48, 62, 0.6), transparent 70%),
      repeating-linear-gradient(98deg, rgba(255, 255, 255, 0.012) 0 2px, transparent 2px 5px),
      linear-gradient(162deg, #2b313d 0%, #181c25 46%, #0f1219 100%);
    box-shadow: 0 60px 110px -40px rgba(0, 0, 0, 0.92), inset 0 2px 0 rgba(255, 255, 255, 0.14), inset 0 -5px 12px rgba(0, 0, 0, 0.6), inset 0 0 0 1px rgba(14, 196, 252, 0.05);
    transform: rotateX(3.5deg); transform-origin: center 76%;
    transition: transform 800ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .sd-cross[data-on="true"] .rig-console { transform: rotateX(2deg); }
  .rig-console::before { content: ""; position: absolute; inset: 13px; border-radius: 18px; pointer-events: none;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.5), inset 0 2px 6px rgba(0, 0, 0, 0.45), inset 0 -1px 0 rgba(255, 255, 255, 0.05); }
  .rig-bolt { position: absolute; width: 9px; height: 9px; border-radius: 50%; z-index: 3; background: radial-gradient(circle at 38% 32%, #525a67, #14171d); box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.5); }
  .rig-bolt.b1 { top: 13px; left: 13px; } .rig-bolt.b2 { top: 13px; right: 13px; } .rig-bolt.b3 { bottom: 13px; left: 13px; } .rig-bolt.b4 { bottom: 13px; right: 13px; }
  .rig-brand { position: absolute; left: 26px; bottom: 15px; z-index: 3; font-family: "Space Grotesk Variable", "Space Grotesk", sans-serif; font-weight: 700; font-size: 10px; letter-spacing: 0.26em; text-transform: uppercase; color: rgba(245, 241, 232, 0.3); }
  .rig-serial { position: absolute; right: 28px; bottom: 16px; z-index: 3; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 8px; letter-spacing: 0.2em; text-transform: uppercase; color: rgba(245, 241, 232, 0.22); }
  .rig-vents { position: absolute; left: 50%; bottom: 13px; transform: translateX(-50%); z-index: 3; width: 92px; height: 9px; border-radius: 3px; background: repeating-linear-gradient(90deg, rgba(0, 0, 0, 0.4) 0 2px, rgba(245, 241, 232, 0.06) 2px 5px); opacity: 0.5; }

  /* the feed conduit: a short recessed channel delivering the file from the AudioDex
     intake down INTO the charge cell (it stops there — the cell feeds the kiln). It no
     longer runs the whole console height through the hero. */
  .rig-conduit { position: absolute; top: 96px; height: 50px; left: 50%; width: 4px; transform: translateX(-50%); border-radius: 3px; z-index: 1; overflow: hidden;
    background: linear-gradient(180deg, rgba(120, 170, 220, 0.05), rgba(120, 170, 220, 0.2));
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.5), inset 1px 0 1px rgba(255, 255, 255, 0.05); }
  .rig-conduit-flow { position: absolute; left: 0; right: 0; top: -60%; height: 60%; border-radius: 3px; background: linear-gradient(180deg, transparent, #19e0ff 50%, #7b5cff 80%, transparent); opacity: 0; }
  .sd-cross[data-phase="select"] .rig-conduit-flow, .sd-cross[data-phase="send"] .rig-conduit-flow { opacity: 1; animation: sd-flowdown 1.1s linear infinite; }
  @keyframes sd-flowdown { from { top: -60%; } to { top: 100%; } }

  /* status leds + chips (reused) */
  .inst-led { width: 9px; height: 9px; border-radius: 50%; flex: 0 0 auto; }
  .led-cyan { background: radial-gradient(circle at 35% 30%, #bff4ff, #0ec4fc 70%); box-shadow: 0 0 10px rgba(14, 196, 252, 0.95); }
  .led-green { background: radial-gradient(circle at 35% 30%, #d8ffe4, #00ff4d 70%); box-shadow: 0 0 10px rgba(0, 255, 77, 0.85); }
  .sd-cross[data-phase="select"] .rig-intake .led-cyan, .sd-cross[data-phase="send"] .rig-intake .led-cyan { animation: sd-ledblink 0.5s steps(1) infinite; }
  @keyframes sd-ledblink { 50% { opacity: 0.35; } }
  .inst-count, .kiln-state { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 9.5px; letter-spacing: 0.16em; text-transform: uppercase; border-radius: 4px; padding: 3px 8px; flex: 0 0 auto; }
  .inst-count { color: var(--brand-cyan); border: 1px solid rgba(14, 196, 252, 0.34); }
  .kiln-state { color: var(--brand-green); border: 1px solid rgba(0, 255, 77, 0.34); min-width: 6.4em; text-align: center; }
  .sd-cross[data-phase="fire"] .kiln-state { color: #19e0ff; border-color: rgba(25, 224, 255, 0.45); }
  .sd-cross[data-phase="crown"] .kiln-state { color: var(--brand-yellow); border-color: rgba(255, 179, 71, 0.5); }

  .rig-zone-head { display: flex; align-items: center; gap: 10px; width: 100%; }
  .rig-zone-name { flex: 1; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 11px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; }
  .rig-zone-adx { color: var(--brand-cyan); }

  /* INTAKE: AudioDex holding the one file we follow */
  .rig-intake { position: relative; z-index: 2; width: 100%; display: flex; flex-direction: column; gap: 9px; }
  .rig-intake-body { position: relative; min-height: 62px; display: flex; align-items: center; }
  .rig-ghost { position: absolute; inset: 0; display: flex; flex-direction: column; gap: 5px; justify-content: center; padding: 0 16px; opacity: 0.16; pointer-events: none; overflow: hidden; }
  .rig-ghost-row { font-family: "Space Grotesk Variable", "Space Grotesk", sans-serif; font-weight: 700; font-size: 11px; color: rgba(245, 241, 232, 0.7); white-space: nowrap; }
  .rig-focus { position: relative; z-index: 1; width: 100%; transition: box-shadow 300ms ease; }
  .sd-cross[data-phase="select"] .rig-focus, .sd-cross[data-phase="send"] .rig-focus { box-shadow: 0 0 0 1px rgba(25, 224, 255, 0.7), 0 0 24px -4px rgba(25, 224, 255, 0.7); }

  /* the focused record card (reused dex-card visuals, Track palette) */
  .dex-card { position: relative; display: grid; grid-template-columns: auto 1fr auto auto; align-items: center; gap: 7px 10px; padding: 9px 12px; border: 1px solid transparent; border-radius: 10px;
    background: linear-gradient(180deg, rgba(18, 16, 26, 0.96), rgba(11, 9, 16, 0.97)) padding-box, linear-gradient(135deg, rgba(14, 196, 252, 0.4), rgba(123, 92, 255, 0.24) 52%, rgba(255, 45, 139, 0.3)) border-box; }
  .dex-tier { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 8px; letter-spacing: 0.14em; text-transform: uppercase; border-radius: 3px; padding: 2px 6px; }
  .k-tracks .dex-tier { color: #ff7a4d; border: 1px solid rgba(255, 122, 77, 0.4); }
  .dex-title { font-family: "Space Grotesk Variable", "Space Grotesk", sans-serif; font-weight: 700; font-size: 13px; color: #f3efe6; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; }
  .dex-keeper { color: #00ff4d; font-size: 11px; }
  .dex-dur { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-style: italic; font-size: 11.5px; font-weight: 700; color: #ff3b6e; text-shadow: 0 0 4px rgba(255, 59, 110, 0.55); }
  .dex-wave { grid-column: 1 / -1; display: flex; align-items: center; gap: 1px; height: 16px; }
  .dex-wave i { flex: 1; height: var(--h); align-self: center; border-radius: 1px; background: linear-gradient(180deg, rgba(255, 122, 77, 0.5), rgba(255, 122, 77, 0.18)); }

  /* THE HEART: a glass charge cell, the read-and-title step */
  .rig-cell { position: relative; z-index: 2; width: 34px; height: 34px; display: grid; place-items: center; }
  .rig-cell-aura { position: absolute; inset: -9px; border-radius: 50%; background: radial-gradient(circle, rgba(25, 224, 255, 0.55), transparent 66%); opacity: 0.22; transition: opacity 300ms ease; }
  .rig-cell-glass { position: absolute; inset: 0; border-radius: 50%; background: radial-gradient(circle at 38% 30%, rgba(255, 255, 255, 0.3), rgba(20, 30, 45, 0.6) 58%, rgba(8, 12, 20, 0.92)); box-shadow: inset 0 0 0 1px rgba(120, 170, 220, 0.3), inset 0 2px 4px rgba(255, 255, 255, 0.16); }
  .rig-cell-core { position: relative; width: 12px; height: 12px; border-radius: 50%; background: radial-gradient(circle, #eaffff, #19e0ff 60%, transparent); opacity: 0.4; animation: sd-cellhum 4s ease-in-out infinite; }
  @keyframes sd-cellhum { 0%, 100% { opacity: 0.3; transform: scale(0.85); } 50% { opacity: 0.55; transform: scale(1); } }
  .sd-cross[data-phase="send"] .rig-cell-core { animation: sd-cellfill 1.9s ease-out forwards; }
  @keyframes sd-cellfill { 0% { opacity: 0.4; transform: scale(0.85); } 64% { opacity: 1; transform: scale(1.55); } 100% { opacity: 0.95; transform: scale(1.3); } }
  .sd-cross[data-phase="send"] .rig-cell-aura, .sd-cross[data-phase="fire"] .rig-cell-aura { opacity: 0.6; }
  .sd-cross[data-phase="fire"] .rig-cell-core { animation: sd-celldischarge 0.7s ease-in forwards; }
  @keyframes sd-celldischarge { 0% { opacity: 1; transform: scale(1.4); } 100% { opacity: 0.35; transform: scale(0.85); } }

  /* THE KILN: the hero engine */
  .rig-kiln { position: relative; z-index: 2; width: 100%; display: flex; flex-direction: column; align-items: center; gap: 12px; }
  .rig-kiln-head { width: 100%; }
  .rig-zone-kiln { color: var(--brand-green); }

  /* OUTPUT LIP: the crowned king mix, held as the final image */
  .rig-out { position: relative; z-index: 2; display: flex; flex-direction: column; align-items: center; gap: 7px; margin-top: 2px; }
  .rig-out-king { font-size: 22px; color: rgba(255, 210, 61, 0.25); transition: color 300ms ease, text-shadow 300ms ease, transform 300ms ease; }
  .sd-cross[data-phase="crown"] .rig-out-king, .sd-cross[data-phase="reset"] .rig-out-king { color: #ffd23d; text-shadow: 0 0 12px rgba(255, 210, 61, 0.9); }
  .sd-cross[data-phase="crown"] .rig-out-king { animation: sd-crownpop 600ms cubic-bezier(0.2, 1.5, 0.45, 1); }
  .rig-crowned { font-family: "Space Grotesk Variable", "Space Grotesk", sans-serif; font-weight: 700; font-size: 14px; letter-spacing: 0.04em; color: #19e0ff; text-shadow: 0 0 10px rgba(25, 224, 255, 0.5); opacity: 0; transition: opacity 400ms ease; }
  .sd-cross[data-phase="crown"] .rig-crowned, .sd-cross[data-phase="reset"] .rig-crowned { opacity: 1; }

  /* ════ the forge button (the §02 kiln control), lifted into the post-login hero.
     232px native — the internals are px-tuned to it. ids namespaced sdpl-* in markup. ════ */
  .kiln-dome.ft-forge-host { position: relative; width: 232px; height: 232px; flex: 0 0 auto; }
  .ft-forge-dome { position: relative; width: 100%; height: 100%; display: grid; place-items: center; }
  .ft-forge-body { position: absolute; inset: 0; border-radius: 50%; z-index: 0;
    background: radial-gradient(132% 132% at 33% 25%, #2a2740 0%, #14121f 40%, #0a0810 74%, #050409 100%);
    box-shadow: 0 24px 48px -18px rgba(0,0,0,0.9), inset 0 2px 3px rgba(180,160,255,0.18), inset 0 -22px 36px rgba(0,0,0,0.65), 0 0 48px -10px rgba(123,92,255,0.30); border: 1px solid rgba(150,130,210,0.08); }
  .ft-forge-dial { position: absolute; inset: 0; border-radius: 50%; display: grid; place-items: center; transform-origin: center; animation: ft-spin 12s linear infinite; will-change: transform; z-index: 1; pointer-events: none; }
  .ft-dial-rim { position: absolute; inset: 0; border-radius: 50%; pointer-events: none;
    background: repeating-radial-gradient(circle, rgba(200,190,235,0.05) 0 0.75px, rgba(0,0,0,0.12) 0.75px 2.25px), conic-gradient(from 210deg, #3a3550 0deg, #6b6480 8%, #2b2838 18%, #4a4560 28%, #211f2c 38%, #5e5775 50%, #2e2b3a 60%, #4d4763 72%, #26232f 82%, #635c7a 92%, #36323f 100%);
    box-shadow: inset 0 0 0 1px rgba(170,150,220,0.28), inset 0 1px 1px rgba(220,210,255,0.16), inset 0 0 22px rgba(0,0,0,0.6);
    -webkit-mask: radial-gradient(circle, transparent 0 48px, #000 51px, #000 114px, transparent 116px); mask: radial-gradient(circle, transparent 0 48px, #000 51px, #000 114px, transparent 116px); }
  .ft-forge-bezel { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .ft-dial-index { filter: drop-shadow(0 0 4px rgba(170,130,255,0.85)); }
  .ft-dial-index-dot { filter: drop-shadow(0 0 5px rgba(170,130,255,0.9)); }
  @keyframes ft-spin { to { transform: rotate(360deg); } }
  .ft-dial-lip { position: absolute; inset: 0; border-radius: 50%; z-index: 1; pointer-events: none;
    background: conic-gradient(from 200deg, #6a6385, #9b94b5, #46415c, #837ca0, #3a3650, #908ab0, #4a4663, #6f6890);
    -webkit-mask: radial-gradient(circle, transparent 0 45px, #000 48px, #000 55px, transparent 57px); mask: radial-gradient(circle, transparent 0 45px, #000 48px, #000 55px, transparent 57px); }
  .ft-forge-screen { position: absolute; width: 96px; height: 96px; border-radius: 50%; display: grid; place-items: center; z-index: 2; pointer-events: none; box-shadow: 0 0 0 1px rgba(123,92,255,0.55), 0 0 22px rgba(123,92,255,0.42); transition: box-shadow 240ms ease; }
  .ft-forge-screen::after { content: ""; position: absolute; inset: 0; border-radius: 50%; pointer-events: none; z-index: 3; background: radial-gradient(64% 46% at 33% 21%, rgba(255,255,255,0.16), rgba(255,255,255,0.03) 42%, transparent 64%); mix-blend-mode: screen; }
  .ft-scope { position: absolute; inset: 0; border-radius: 50%; overflow: hidden;
    background: radial-gradient(circle at 50% 50%, rgba(8,30,50,0) 46%, rgba(2,6,12,0.85) 100%), radial-gradient(120% 120% at 50% 16%, #0a2b3a 0%, #051a26 46%, #02101a 100%);
    box-shadow: inset 0 0 18px rgba(0,0,0,0.9), inset 0 0 0 1px rgba(150,210,255,0.20), inset 0 2px 12px rgba(150,140,255,0.12); animation: ft-scope-breathe 4.5s ease-in-out infinite; }
  @keyframes ft-scope-breathe { 0%,100% { box-shadow: inset 0 0 18px rgba(0,0,0,0.9), inset 0 0 0 1px rgba(150,210,255,0.18), inset 0 2px 12px rgba(150,140,255,0.10); } 50% { box-shadow: inset 0 0 18px rgba(0,0,0,0.9), inset 0 0 0 1px rgba(170,160,255,0.26), inset 0 2px 12px rgba(150,140,255,0.18); } }
  .ft-reactor { position: absolute; width: 96px; height: 96px; overflow: visible; pointer-events: none; }
  .ft-pl-core { transform-box: fill-box; transform-origin: center; animation: ft-pl-breathe 2.6s ease-in-out infinite; }
  .ft-pl-bloom { transform-box: fill-box; transform-origin: center; animation: ft-pl-blow 4.1s ease-in-out infinite; }
  .ft-pl-arcs, .ft-pl-tips { animation: ft-pl-flick 2.9s steps(1) infinite; }
  .ft-pl-forks { animation: ft-pl-fork 1.7s steps(1) infinite; }
  .ft-pl-field { transform-box: fill-box; transform-origin: center; }
  @keyframes ft-pl-breathe { 0%,100% { transform: scale(1); opacity: 0.95; } 50% { transform: scale(1.1); opacity: 1; } }
  @keyframes ft-pl-blow { 0%,100% { opacity: 0.7; transform: scale(1); } 50% { opacity: 1; transform: scale(1.06); } }
  @keyframes ft-pl-flick { 0%,46%,100% { opacity: 1; } 47%,52% { opacity: 0.55; } 53%,72% { opacity: 1; } 73%,76% { opacity: 0.7; } }
  @keyframes ft-pl-fork { 0%,40% { opacity: 0.85; } 41%,49% { opacity: 0.25; } 50%,100% { opacity: 0.85; } }
  .ft-pl-flash { position: absolute; inset: 0; border-radius: 50%; z-index: 3; pointer-events: none; opacity: 0; background: radial-gradient(circle, #f4ffff 0%, #b8ecff 38%, #7d5cff 78%, #5e44d8 100%); }
  .ft-forge-glass { position: absolute; inset: 0; border-radius: 50%; pointer-events: none; z-index: 4; background: radial-gradient(58% 42% at 34% 22%, rgba(255,255,255,0.28), transparent 60%); mix-blend-mode: screen; }
  /* fire whips the dial + blazes the plasma (driven by the loop phase, not a press) */
  .sd-cross[data-phase="fire"] .ft-forge-dial { animation-duration: 0.7s; }
  .sd-cross[data-phase="fire"] .ft-pl-core { animation-duration: 0.9s; filter: drop-shadow(0 0 6px rgba(174,249,255,0.9)); }
  .sd-cross[data-phase="fire"] .ft-pl-arcs { filter: brightness(1.7); }
  .sd-cross[data-phase="fire"] .ft-forge-screen { box-shadow: 0 0 0 1px rgba(123,92,255,0.82), 0 0 34px rgba(123,92,255,0.7); }
  .sd-cross[data-phase="crown"] .ft-forge-screen { box-shadow: 0 0 0 1px rgba(255,210,61,0.6), 0 0 26px rgba(255,179,71,0.5); }

  /* ════ Richard floats in the center of the disc — a lazy-river inner-tube spin ════
     He rests over the plasma "water", bobbing gently, slowly turning with the disc.
     The kiln firing gives the tube a push (a brief acceleration), then friction eases
     him back down to barely-turning. The rotation is a real momentum model in JS (see
     the script) so it never resets the way swapping a CSS animation-duration does. */
  .kiln-float { position: absolute; top: 50%; left: 50%; z-index: 5; pointer-events: none; line-height: 0;
    transform: translate(-50%, -50%); animation: kiln-bobfloat 5.5s ease-in-out infinite; }
  @keyframes kiln-bobfloat {
    0%, 100% { transform: translate(-50%, -50%) translate(1.5px, 2px); }
    50%      { transform: translate(-50%, -50%) translate(-1.5px, -3px); }
  }
