---
// THE DOOR — the closing. The study has been a window onto a system that's
// otherwise private, so the page keeps a way in. Not a riddle and not a vault:
// a clean gate that echoes my real login. It tells you plainly that the
// workshop is real and gated, hints the one word (and will spell it out if you
// ask), then opens full-screen onto a glimpse of the room.
//
//   gate    → an honest line + a passphrase field. A clear hint points at the
//             word "soundbender"; "spell it out" removes all doubt.
//   type    → the field charges toward unlock as the right letters land; a
//             wrong key gives a soft shake, not a scold.
//   cross   → a clean full-screen takeover, the way the real login owns the
//             screen — the room resolves, no theatrics.
//   arrive  → a short, warm, true word. Esc steps back out.
//
// Touch (tap the field → keyboard), keyboard (type + Enter + Esc + focus-trap),
// and reduced-motion (a plain fade) all work. The lock is enhancement: with no
// JS the gate reads as a sealed panel, never a dead field. Real gate: /portal.
import Richard from "./Richard.astro";

const WORD = "soundbender";
---

<section class="td" data-td aria-label="A way into the workshop">
  <div class="td-seam" aria-hidden="true"></div>

  <div class="td-gate">
    <p class="td-intro">
      This whole thing is real, and it lives behind a login. Want to look?
      Type the one word for what I do, and I'll crack the door for a second.
    </p>

    <form class="td-field" data-td-form>
      <span class="td-field-glyph" aria-hidden="true">
        <svg viewBox="0 0 18 18" width="15" height="15"><path d="M5 8V6a4 4 0 018 0v2M4 8h10v6H4z" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </span>
      <input
        class="td-input"
        data-td-input
        type="text"
        inputmode="text"
        autocomplete="off"
        autocapitalize="off"
        autocorrect="off"
        spellcheck="false"
        placeholder="one word…"
        aria-label="Type the passphrase to glimpse the workshop"
        aria-describedby="td-hint"
      />
      <span class="td-charge" data-td-charge aria-hidden="true"></span>
      <button type="submit" class="td-enter" aria-label="Enter">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </form>

    <p class="td-hint" id="td-hint">
      <span class="td-hint-text">It's what I am: someone who <em>bends</em> sound instead of picking it.</span>
      <button type="button" class="td-reveal" data-td-reveal aria-expanded="false">spell it out</button>
      <span class="td-spelled" data-td-spelled hidden>&rarr; <b>soundbender</b></span>
    </p>
  </div>

  <!-- ── the crossing + arrival ── -->
  <div class="td-cross" data-td-cross hidden>
    <div class="td-room" aria-hidden="true">
      <div class="td-floor"></div>
      <div class="td-aurora"></div>
      <div class="td-stars"></div>
    </div>

    <div class="td-arrival" role="dialog" aria-modal="true" aria-label="Inside the workshop">
      <p class="td-wordmark"><span aria-hidden="true">◍</span> Tolo<span class="td-wm-dot">.</span>Cloud <span class="td-wm-sub">· the real gate</span></p>

      <div class="td-richard" aria-hidden="true"><Richard size={90} speaking={true} /></div>

      <h2 class="td-arrival-head">You're in.</h2>
      <p class="td-arrival-copy">
        This is the real workshop — where eight years of sound actually live, and where
        <span class="td-rich-name">Richard</span> and <span class="td-adx">AudioDex</span> do their work.
        It's behind a login that's only mine. Thanks for finding the door.
      </p>
      <p class="td-richard-line"><span aria-hidden="true">🐢</span> <em>oh, hey — didn't hear you come in.</em></p>

      <div class="td-actions">
        <a class="td-realdoor" href="/portal" target="_blank" rel="noopener">see the real gate <span aria-hidden="true">↗</span></a>
        <button type="button" class="td-exit" data-td-exit><span class="td-exit-key" aria-hidden="true">esc</span> step back out</button>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-td]").forEach((root) => {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const form = root.querySelector<HTMLFormElement>("[data-td-form]");
    const input = root.querySelector<HTMLInputElement>("[data-td-input]");
    const charge = root.querySelector<HTMLElement>("[data-td-charge]");
    const reveal = root.querySelector<HTMLButtonElement>("[data-td-reveal]");
    const spelled = root.querySelector<HTMLElement>("[data-td-spelled]");
    const cross = root.querySelector<HTMLElement>("[data-td-cross]");
    const exitBtn = root.querySelector<HTMLElement>("[data-td-exit]");
    if (!form || !input || !cross) return;

    const WORD = "soundbender";
    let crossed = false;
    let shakeTimer = 0;

    root.dataset.ready = "true";

    const setCharge = (p: number) => {
      charge?.style.setProperty("--p", String(p / WORD.length));
      root.dataset.full = String(p === WORD.length);
    };

    const shake = () => {
      root.dataset.shake = "1";
      window.clearTimeout(shakeTimer);
      shakeTimer = window.setTimeout(() => (root.dataset.shake = "0"), reduce ? 120 : 360);
    };

    input.addEventListener("input", () => {
      const v = input.value.toLowerCase().replace(/[^a-z]/g, "");
      let p = 0;
      while (p < v.length && p < WORD.length && v[p] === WORD[p]) p++;
      const broke = v.length > p;
      if (v.length !== p) input.value = WORD.slice(0, p); // hold the valid prefix
      setCharge(p);
      if (broke) shake();
    });

    const tryOpen = () => {
      const v = input.value.toLowerCase().replace(/[^a-z]/g, "");
      if (v === WORD && !crossed) open();
      else if (!crossed) shake();
    };
    form.addEventListener("submit", (e) => { e.preventDefault(); tryOpen(); });

    reveal?.addEventListener("click", () => {
      const on = spelled && !spelled.hasAttribute("hidden");
      if (!spelled) return;
      if (on) { spelled.setAttribute("hidden", ""); reveal!.setAttribute("aria-expanded", "false"); }
      else { spelled.removeAttribute("hidden"); reveal!.setAttribute("aria-expanded", "true"); input.focus(); }
    });

    // ── the crossing ──
    const open = () => {
      crossed = true;
      root.dataset.crossed = "true";
      setCharge(WORD.length);
      // Escape .cs-main's z-index:1 stacking context so the footer can't paint
      // over the takeover. <body> carries .cs-body, so brand tokens inherit.
      if (cross.parentElement !== document.body) document.body.appendChild(cross);
      cross.removeAttribute("hidden");
      void cross.offsetWidth;
      cross.dataset.on = "true";
      document.documentElement.style.overflow = "hidden";
      window.setTimeout(() => exitBtn?.focus(), reduce ? 0 : 80);
    };

    const close = () => {
      cross.dataset.on = "false";
      document.documentElement.style.overflow = "";
      window.setTimeout(() => cross.setAttribute("hidden", ""), reduce ? 0 : 520);
      crossed = false;
      root.dataset.crossed = "false";
      input.value = "";
      setCharge(0);
      window.setTimeout(() => input.focus(), reduce ? 0 : 80);
    };

    exitBtn?.addEventListener("click", close);

    document.addEventListener("keydown", (e) => {
      if (!crossed) return;
      if (e.key === "Escape") { e.preventDefault(); close(); return; }
      if (e.key === "Tab") {
        const f = Array.from(cross.querySelectorAll<HTMLElement>("a[href], button:not([disabled])")).filter((el) => el.offsetParent !== null);
        if (!f.length) return;
        const first = f[0], last = f[f.length - 1];
        if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
        else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
      }
    });

    setCharge(0);
  });
</script>

<style>
  .td { position: relative; padding: 34px 24px 8px; border-top: 1px solid rgba(245, 241, 232, 0.08); }

  /* a quiet seam of light — the only flourish */
  .td-seam {
    width: min(680px, 88%); height: 1px; margin: 0 auto 34px;
    background: linear-gradient(90deg, transparent, rgba(14, 196, 252, 0.55) 50%, transparent);
    box-shadow: 0 0 14px rgba(14, 196, 252, 0.3);
  }

  .td-gate { max-width: 470px; margin: 0 auto; text-align: center; }
  .td-intro {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 13px; line-height: 1.65;
    color: rgba(245, 241, 232, 0.7); margin: 0 0 20px;
  }

  /* the field — echoes the real Tolo.Cloud login row */
  .td-field {
    position: relative; display: flex; align-items: center; gap: 8px; width: 100%;
    padding: 6px 6px 6px 12px; border-radius: 12px;
    background: rgba(245, 241, 232, 0.04); border: 1px solid rgba(245, 241, 232, 0.16);
    transition: border-color 180ms ease, box-shadow 180ms ease;
  }
  .td-field:focus-within { border-color: rgba(14, 196, 252, 0.5); box-shadow: 0 0 0 3px rgba(14, 196, 252, 0.14); }
  .td[data-full="true"] .td-field { border-color: rgba(0, 255, 77, 0.6); box-shadow: 0 0 0 3px rgba(0, 255, 77, 0.18), 0 0 28px -8px rgba(0, 255, 77, 0.5); }
  .td[data-shake="1"] .td-field { animation: td-shake 0.34s cubic-bezier(0.36, 0.07, 0.19, 0.97); border-color: rgba(255, 90, 60, 0.6); }
  @keyframes td-shake {
    10%, 90% { transform: translateX(-1px); } 20%, 80% { transform: translateX(2px); }
    30%, 50%, 70% { transform: translateX(-4px); } 40%, 60% { transform: translateX(4px); }
  }
  .td-field-glyph { display: inline-flex; color: rgba(245, 241, 232, 0.4); flex: 0 0 auto; transition: color 180ms ease; }
  .td-field:focus-within .td-field-glyph { color: var(--brand-cyan); }
  .td[data-full="true"] .td-field-glyph { color: var(--brand-green); }
  .td-input {
    flex: 1; min-width: 0; background: transparent; border: 0; outline: none; color: #f5f1e8;
    font: 500 16px/1 ui-monospace, SFMono-Regular, Menlo, monospace; letter-spacing: 0.08em; padding: 12px 4px;
  }
  .td-input::placeholder { color: rgba(245, 241, 232, 0.34); letter-spacing: 0.04em; }
  /* the charge line — fills under the field as the right letters land */
  .td-charge {
    position: absolute; left: 12px; right: 56px; bottom: 5px; height: 2px; border-radius: 2px;
    background: rgba(245, 241, 232, 0.08); overflow: hidden;
  }
  .td-charge::after {
    content: ""; position: absolute; inset: 0; transform: scaleX(var(--p, 0)); transform-origin: left center;
    background: linear-gradient(90deg, var(--brand-cyan), var(--brand-green));
    box-shadow: 0 0 8px rgba(14, 196, 252, 0.55); transition: transform 200ms cubic-bezier(0.2, 1, 0.32, 1);
  }
  .td-enter {
    flex: 0 0 auto; display: inline-flex; align-items: center; justify-content: center;
    width: 40px; height: 40px; border: 0; border-radius: 9px; cursor: pointer; color: #fff;
    background: linear-gradient(135deg, #0ec4fc, #1f8bff); transition: filter 140ms ease, transform 80ms ease;
  }
  .td[data-full="true"] .td-enter { background: linear-gradient(135deg, #00ff4d, #19e0a0); }
  .td-enter:hover { filter: brightness(1.1); }
  .td-enter:active { transform: scale(0.95); }
  .td-enter svg { width: 19px; height: 19px; }

  .td-hint {
    display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; justify-content: center;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 11.5px; line-height: 1.5;
    color: rgba(245, 241, 232, 0.5); margin: 14px 0 0;
  }
  .td-hint-text em { font-style: italic; color: var(--brand-cyan); }
  .td-reveal {
    font: inherit; font-size: 11px; color: rgba(245, 241, 232, 0.45); background: transparent;
    border: 0; border-bottom: 1px dotted rgba(245, 241, 232, 0.35); padding: 0 0 1px; cursor: pointer;
    transition: color 150ms ease, border-color 150ms ease;
  }
  .td-reveal:hover, .td-reveal:focus-visible { color: var(--brand-cyan); border-color: var(--brand-cyan); outline: none; }
  .td-spelled { color: rgba(245, 241, 232, 0.7); letter-spacing: 0.06em; }
  .td-spelled b { color: var(--brand-green); font-weight: 700; letter-spacing: 0.14em; }
  /* no-JS: the gate is a sealed panel, the reveal is meaningless → hide it */
  .td:not([data-ready="true"]) .td-reveal { display: none; }

  /* ── the crossing + arrival ── */
  .td-cross {
    position: fixed; inset: 0; z-index: 200; overflow: hidden; display: grid; place-items: center;
    background: #050309; opacity: 0; transition: opacity 260ms ease;
  }
  .td-cross[hidden] { display: none; }
  .td-cross[data-on="true"] { opacity: 1; }

  .td-room {
    position: absolute; inset: 0; overflow: hidden;
    background:
      radial-gradient(120% 80% at 50% -12%, rgba(255, 39, 97, 0.18), transparent 60%),
      radial-gradient(130% 90% at 50% 116%, rgba(14, 196, 252, 0.22), transparent 58%),
      #050309;
    transform: scale(1.08); opacity: 0;
    transition: transform 1100ms cubic-bezier(0.16, 1, 0.3, 1), opacity 600ms ease 120ms;
  }
  .td-cross[data-on="true"] .td-room { transform: scale(1); opacity: 1; }
  .td-floor {
    position: absolute; left: 50%; bottom: -2%; width: 220%; height: 50%;
    background-image: linear-gradient(rgba(14, 196, 252, 0.45) 1px, transparent 1px), linear-gradient(90deg, rgba(14, 196, 252, 0.45) 1px, transparent 1px);
    background-size: 64px 64px;
    -webkit-mask-image: linear-gradient(180deg, transparent, #000 62%); mask-image: linear-gradient(180deg, transparent, #000 62%);
    transform: translateX(-50%) perspective(420px) rotateX(64deg); opacity: 0.5;
  }
  .td-aurora { position: absolute; left: 50%; top: 36%; width: 70%; height: 220px; transform: translateX(-50%); background: radial-gradient(closest-side, rgba(255, 90, 60, 0.34), transparent 70%); filter: blur(42px); opacity: 0.7; }
  .td-stars { position: absolute; inset: 0; background-image: url("/speckles.svg"); background-repeat: repeat; opacity: 0.1; }

  .td-arrival {
    position: relative; z-index: 2; width: min(560px, 90vw); text-align: center; padding: 24px; color: #f5f1e8;
    transform: translateY(14px); opacity: 0;
    transition: transform 640ms cubic-bezier(0.16, 1, 0.3, 1) 280ms, opacity 560ms ease 320ms;
  }
  .td-cross[data-on="true"] .td-arrival { transform: none; opacity: 1; }
  .td-wordmark { font-family: ui-monospace, "SF Mono", SFMono-Regular, Menlo, monospace; font-size: 11px; letter-spacing: 0.04em; color: rgba(245, 241, 232, 0.68); margin: 0 0 16px; }
  .td-wm-dot { color: var(--brand-cyan); }
  .td-wm-sub { color: rgba(245, 241, 232, 0.4); letter-spacing: 0.16em; text-transform: uppercase; font-size: 9.5px; }
  .td-richard { display: flex; justify-content: center; margin-bottom: 14px; filter: drop-shadow(0 8px 26px rgba(0, 255, 77, 0.3)); }
  .td-arrival-head {
    font-family: "Space Grotesk Variable", "Space Grotesk", sans-serif; font-weight: 700;
    font-size: clamp(32px, 5vw, 48px); letter-spacing: -0.03em; line-height: 1; margin: 0 0 16px;
    background: linear-gradient(92deg, #ff2761, #ff5a3c 48%, #ffb347);
    -webkit-background-clip: text; background-clip: text; color: transparent; -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 6px 30px rgba(255, 89, 60, 0.3));
  }
  .td-arrival-copy { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 14px; line-height: 1.65; color: rgba(245, 241, 232, 0.82); margin: 0 auto 14px; max-width: 48ch; }
  .td-adx { color: var(--brand-cyan); font-weight: 600; }
  .td-rich-name { color: var(--brand-green); font-weight: 600; }
  .td-richard-line { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12.5px; margin: 0 0 26px; color: rgba(245, 241, 232, 0.58); }
  .td-richard-line em { font-style: italic; color: rgba(245, 241, 232, 0.8); }

  .td-actions { display: inline-flex; align-items: center; gap: 14px; flex-wrap: wrap; justify-content: center; }
  .td-realdoor {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 11px; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--brand-cyan); text-decoration: none; padding: 9px 16px;
    border: 1px solid rgba(14, 196, 252, 0.45); border-radius: 6px; transition: color 160ms ease, background 160ms ease, border-color 160ms ease;
  }
  .td-realdoor:hover, .td-realdoor:focus-visible { outline: none; color: #050309; background: var(--brand-cyan); border-color: var(--brand-cyan); }
  .td-exit {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 11px; letter-spacing: 0.12em;
    text-transform: uppercase; color: rgba(245, 241, 232, 0.7); cursor: pointer; background: transparent;
    border: 1px solid rgba(245, 241, 232, 0.2); border-radius: 6px; padding: 9px 16px;
    display: inline-flex; align-items: center; gap: 8px; transition: color 160ms ease, border-color 160ms ease, background 160ms ease;
  }
  .td-exit:hover, .td-exit:focus-visible { outline: none; color: #f5f1e8; border-color: rgba(245, 241, 232, 0.5); background: rgba(245, 241, 232, 0.05); }
  .td-exit-key { font-size: 9px; letter-spacing: 0.1em; padding: 2px 5px; border-radius: 3px; border: 1px solid rgba(245, 241, 232, 0.28); color: rgba(245, 241, 232, 0.55); }

  @media (prefers-reduced-motion: reduce) {
    .td-charge::after { transition: none; }
    .td[data-shake="1"] .td-field { animation: none; }
    .td-cross, .td-room, .td-arrival { transition: opacity 200ms ease !important; transform: none !important; }
  }
</style>
