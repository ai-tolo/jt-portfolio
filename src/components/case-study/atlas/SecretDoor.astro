---
// THE THRESHOLD — the closing ritual. The whole study has been a window onto a
// system that's otherwise private. So the page keeps a seam in the wall.
//
//   discover → a seam of light resolves into an engraved lockplate. No "type X."
//              The door "answers to its maker," and the page planted the word
//              (a soundbender). Eleven tumblers hint the length.
//   ignite   → every keystroke wakes the mechanism: a tumbler falls, a rune
//              lights, the reactor charges. A wrong letter slips, it doesn't
//              scold. Spell the maker's name and the vault releases.
//   cross    → a full-screen takeover: a vault grinds apart, you dolly through.
//   arrive   → a console bridge. True words, a little reverent. Esc steps out.
//
// Works on touch (tap the plate → keyboard), full keyboard (focus + type + Esc),
// and prefers-reduced-motion (the ritual still resolves, without the spectacle).
// The lock is progressive enhancement; with no JS the plate reads as a sealed
// engraving, never a broken input. Real gate: it actually lives at /portal.
import Richard from "./Richard.astro";

const WORD = "soundbender";
const SLOTS = Array.from({ length: WORD.length }, (_, i) => i);
---

<section class="td" data-td aria-label="A hidden door">
  <div class="td-seam" aria-hidden="true"><span class="td-glint"></span></div>

  <div class="td-plate">
    <p class="td-engrave">
      <span class="td-dot" aria-hidden="true"></span>
      Everything you just read is real. It runs behind one locked door.
    </p>

    <div class="td-lock" data-td-lock>
      <div class="td-runes" role="group" aria-hidden="true">
        {SLOTS.map((i) => (
          <span class="td-rune" data-td-rune data-i={i} data-lit="false"></span>
        ))}
        <span class="td-caret" data-td-caret aria-hidden="true"></span>
      </div>

      <div class="td-meter" aria-hidden="true"><span class="td-meter-fill"></span></div>

      <p class="td-prompt" data-td-prompt>
        <span class="td-prompt-on">The door doesn't answer to the machine. It answers to its <em>maker</em>. Speak the name.</span>
        <span class="td-prompt-off">Sealed.</span>
      </p>

      <input
        class="td-input"
        data-td-input
        type="text"
        inputmode="text"
        autocomplete="off"
        autocapitalize="off"
        autocorrect="off"
        spellcheck="false"
        aria-label="Speak the maker's name to cross the threshold"
      />
    </div>
  </div>

  <!-- ── the crossing + arrival (full-screen) ── -->
  <div class="td-cross" data-td-cross hidden>
    <div class="td-room" aria-hidden="true">
      <div class="td-floor"></div>
      <div class="td-aurora"></div>
      <div class="td-stars"></div>
    </div>

    <div class="td-arrival" role="dialog" aria-modal="true" aria-label="Inside the Lathe">
      <p class="td-plate-wordmark"><span aria-hidden="true">◍</span> Tolo<span class="td-wm-dot">.</span>Cloud <span class="td-wm-sub">· the real gate</span></p>

      <div class="td-richard" aria-hidden="true"><Richard size={92} speaking={true} /></div>

      <h2 class="td-arrival-head">You're standing in it.</h2>
      <p class="td-arrival-copy">
        This is where the eight years live. Every file named, every track Richard has an opinion on,
        the whole machine humming behind one locked door. The door is real. The key is mine.
        But now you know it's here.
      </p>
      <p class="td-richard-line"><span aria-hidden="true">🐢</span> <span class="td-rich-name">Richard:</span> <em>huh. nobody's supposed to be back here.</em></p>

      <div class="td-actions">
        <a class="td-realdoor" href="/portal" target="_blank" rel="noopener">find the real door <span aria-hidden="true">↗</span></a>
        <button type="button" class="td-exit" data-td-exit>
          <span class="td-exit-key" aria-hidden="true">esc</span> step back out
        </button>
      </div>
    </div>

    <!-- the vault: two leaves that grind apart, revealing the room behind -->
    <div class="td-vault" aria-hidden="true">
      <div class="td-leaf td-leaf-l">
        <span class="td-glyphs"></span>
      </div>
      <div class="td-leaf td-leaf-r">
        <span class="td-glyphs"></span>
      </div>
      <div class="td-vault-seam"></div>
      <div class="td-vault-core"></div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-td]").forEach((root) => {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const input = root.querySelector<HTMLInputElement>("[data-td-input]");
    const lock = root.querySelector<HTMLElement>("[data-td-lock]");
    const runes = Array.from(root.querySelectorAll<HTMLElement>("[data-td-rune]"));
    const caret = root.querySelector<HTMLElement>("[data-td-caret]");
    const meterFill = root.querySelector<HTMLElement>(".td-meter-fill");
    const cross = root.querySelector<HTMLElement>("[data-td-cross]");
    const exitBtn = root.querySelector<HTMLElement>("[data-td-exit]");
    if (!input || !lock || !cross) return;

    const WORD = "soundbender";
    let crossed = false;
    let slipTimer = 0;

    // Enables the live lock visuals only when JS is present — no-JS sees a
    // sealed engraving, never a dead input.
    root.dataset.ready = "true";

    const place = (progress: number) => {
      runes.forEach((el, i) => {
        const lit = i < progress;
        el.dataset.lit = String(lit);
        el.textContent = lit ? WORD[i] : "";
        el.dataset.active = String(i === progress && !crossed);
      });
      if (caret) {
        const at = runes[Math.min(progress, runes.length - 1)];
        const done = progress >= runes.length;
        caret.style.opacity = done || crossed ? "0" : "1";
        if (at) {
          caret.style.left = `${at.offsetLeft + (progress >= runes.length ? at.offsetWidth : 0)}px`;
        }
      }
      meterFill?.style.setProperty("--p", String(progress / WORD.length));
    };

    const slip = () => {
      root.dataset.slip = "1";
      window.clearTimeout(slipTimer);
      slipTimer = window.setTimeout(() => (root.dataset.slip = "0"), reduce ? 160 : 380);
    };

    input.addEventListener("input", () => {
      const v = input.value.toLowerCase().replace(/[^a-z]/g, "");
      let p = 0;
      while (p < v.length && p < WORD.length && v[p] === WORD[p]) p++;
      const broke = v.length > p; // a wrong (or extra) key broke the prefix
      if (v.length !== p) input.value = WORD.slice(0, p); // hold the valid prefix
      place(p);
      if (broke) slip();
      if (p === WORD.length && !crossed) open();
    });

    // Tap / click anywhere on the plate wakes the lock (mobile keyboard, too).
    lock.addEventListener("click", () => input.focus());
    input.addEventListener("focus", () => (root.dataset.awake = "true"));
    input.addEventListener("blur", () => {
      if (!crossed) root.dataset.awake = "false";
    });

    // ── the crossing ──
    const open = () => {
      crossed = true;
      root.dataset.crossed = "true";
      place(WORD.length);
      // Escape .cs-main's stacking context so the footer can't paint over the
      // full-screen takeover. <body> carries .cs-body, so brand tokens inherit.
      if (cross.parentElement !== document.body) document.body.appendChild(cross);
      cross.removeAttribute("hidden");
      void cross.offsetWidth; // commit closed state, then transition open
      cross.dataset.on = "true";
      document.documentElement.style.overflow = "hidden";
      window.setTimeout(() => exitBtn?.focus(), reduce ? 0 : 60);
    };

    const close = () => {
      cross.dataset.on = "false";
      document.documentElement.style.overflow = "";
      window.setTimeout(() => cross.setAttribute("hidden", ""), reduce ? 0 : 640);
      crossed = false;
      root.dataset.crossed = "false";
      input.value = "";
      place(0);
      window.setTimeout(() => input.focus(), reduce ? 0 : 60);
    };

    exitBtn?.addEventListener("click", close);

    // Esc to leave; trap Tab inside the arrival while it's open.
    document.addEventListener("keydown", (e) => {
      if (!crossed) return;
      if (e.key === "Escape") {
        e.preventDefault();
        close();
        return;
      }
      if (e.key === "Tab") {
        const focusables = Array.from(
          cross.querySelectorAll<HTMLElement>("a[href], button:not([disabled])")
        ).filter((el) => el.offsetParent !== null);
        if (!focusables.length) return;
        const first = focusables[0];
        const last = focusables[focusables.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    });

    place(0);
  });
</script>

<style>
  .td {
    position: relative;
    padding: 30px 24px 8px;
    border-top: 1px solid rgba(245, 241, 232, 0.08);
    text-align: center;
  }

  /* ── the seam in the wall ── */
  .td-seam {
    position: relative;
    width: min(760px, 92%);
    height: 1px;
    margin: 0 auto 38px;
    background: linear-gradient(90deg, transparent, rgba(255, 90, 60, 0.5) 22%, rgba(14, 196, 252, 0.6) 50%, rgba(255, 90, 60, 0.5) 78%, transparent);
    box-shadow: 0 0 14px rgba(14, 196, 252, 0.35);
    opacity: 0.5;
    transition: opacity 700ms ease, box-shadow 700ms ease;
  }
  .td[data-awake="true"] .td-seam { opacity: 1; box-shadow: 0 0 22px rgba(14, 196, 252, 0.55); }
  .td-glint {
    position: absolute; top: -1px; left: 0; width: 60px; height: 3px; border-radius: 3px;
    background: radial-gradient(closest-side, rgba(234, 248, 255, 0.95), transparent);
    animation: td-glint 7s ease-in-out infinite;
  }
  @keyframes td-glint {
    0% { left: 6%; opacity: 0; }
    18% { opacity: 1; }
    82% { opacity: 1; }
    100% { left: 90%; opacity: 0; }
  }

  /* ── the lockplate ── */
  .td-plate { max-width: 640px; margin: 0 auto; }
  .td-engrave {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 12.5px; line-height: 1.6; letter-spacing: 0.04em;
    color: rgba(245, 241, 232, 0.56); margin: 0 0 26px;
    display: inline-flex; align-items: center; gap: 10px; flex-wrap: wrap; justify-content: center;
  }
  .td-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--brand-cyan); box-shadow: 0 0 8px var(--brand-cyan); flex: 0 0 auto; }

  .td-lock {
    position: relative;
    display: inline-flex; flex-direction: column; align-items: center; gap: 16px;
    padding: 26px 30px 22px; border-radius: 14px;
    border: 1px solid rgba(245, 241, 232, 0.1);
    background:
      radial-gradient(120% 100% at 50% 0%, rgba(14, 196, 252, 0.06), transparent 60%),
      linear-gradient(180deg, rgba(18, 16, 26, 0.8), rgba(9, 8, 13, 0.9));
    cursor: text;
    box-shadow: inset 0 1px 0 rgba(245, 241, 232, 0.05), 0 24px 60px -40px rgba(0, 0, 0, 0.9);
    transition: border-color 200ms ease, box-shadow 200ms ease, transform 90ms ease;
  }
  .td[data-awake="true"] .td-lock {
    border-color: rgba(14, 196, 252, 0.4);
    box-shadow: inset 0 1px 0 rgba(245, 241, 232, 0.06), 0 0 50px -22px rgba(14, 196, 252, 0.6);
  }
  .td[data-slip="1"] .td-lock { animation: td-shake 0.36s cubic-bezier(0.36, 0.07, 0.19, 0.97); }
  @keyframes td-shake {
    10%, 90% { transform: translateX(-1.5px); }
    20%, 80% { transform: translateX(3px); }
    30%, 50%, 70% { transform: translateX(-5px); }
    40%, 60% { transform: translateX(5px); }
  }

  /* tumbler runes */
  .td-runes { position: relative; display: inline-flex; align-items: center; gap: 7px; }
  .td-rune {
    position: relative; width: 22px; height: 30px; border-radius: 4px;
    display: inline-flex; align-items: center; justify-content: center;
    font-family: "Space Grotesk Variable", "Space Grotesk", sans-serif; font-weight: 700; font-size: 16px;
    text-transform: lowercase; color: #eaf8ff;
    border: 1px solid rgba(245, 241, 232, 0.14);
    background: rgba(245, 241, 232, 0.025);
    transition: border-color 200ms ease, background 200ms ease, box-shadow 220ms ease, color 200ms ease;
  }
  /* unlit slot shows a faint rune mark */
  .td-rune[data-lit="false"]::before {
    content: ""; width: 5px; height: 5px; border-radius: 1px;
    background: rgba(245, 241, 232, 0.18); transform: rotate(45deg);
  }
  .td-rune[data-lit="true"] {
    border-color: rgba(0, 255, 77, 0.5);
    background: rgba(0, 255, 77, 0.08);
    color: #d8ffe4;
    box-shadow: 0 0 14px -3px rgba(0, 255, 77, 0.7), inset 0 0 8px -4px rgba(0, 255, 77, 0.6);
    animation: td-lock-in 0.34s cubic-bezier(0.2, 1, 0.32, 1);
  }
  @keyframes td-lock-in {
    0% { transform: translateY(-4px) scale(1.18); box-shadow: 0 0 22px rgba(25, 224, 255, 0.9); border-color: var(--brand-cyan); }
    100% { transform: none; }
  }
  .td-rune[data-active="true"] { border-color: rgba(14, 196, 252, 0.6); }

  .td-caret {
    position: absolute; top: 50%; width: 2px; height: 18px; margin-left: -1px;
    transform: translateY(-50%); background: var(--brand-cyan);
    box-shadow: 0 0 8px var(--brand-cyan); border-radius: 2px;
    transition: left 120ms ease; animation: td-blink 1.05s step-end infinite; opacity: 0;
  }
  .td[data-awake="true"] .td-caret { opacity: 1; }
  @keyframes td-blink { 50% { opacity: 0; } }

  /* the reactor charge meter */
  .td-meter {
    width: 168px; height: 3px; border-radius: 3px; overflow: hidden;
    background: rgba(245, 241, 232, 0.08);
  }
  .td-meter-fill {
    --p: 0; display: block; height: 100%; width: 100%;
    transform: scaleX(var(--p)); transform-origin: left center;
    background: linear-gradient(90deg, #ff2761, #ff5a3c, #ffb347, #0ec4fc);
    box-shadow: 0 0 10px rgba(14, 196, 252, 0.6);
    transition: transform 260ms cubic-bezier(0.2, 1, 0.32, 1);
  }

  .td-prompt {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 11px;
    line-height: 1.5; letter-spacing: 0.02em; color: rgba(245, 241, 232, 0.5); margin: 0; max-width: 42ch;
  }
  .td-prompt em { font-style: italic; color: var(--brand-orange); }
  .td-prompt-off { display: none; color: rgba(245, 241, 232, 0.4); letter-spacing: 0.18em; text-transform: uppercase; }
  /* no-JS: show "Sealed.", hide the type-prompt */
  .td:not([data-ready="true"]) .td-prompt-on { display: none; }
  .td:not([data-ready="true"]) .td-prompt-off { display: inline; }
  .td:not([data-ready="true"]) .td-caret { display: none; }

  /* the focusable input overlays the runes so a tap lands on it */
  .td-input {
    position: absolute; left: 0; top: 0; width: 100%; height: 100%;
    opacity: 0; border: 0; background: transparent; cursor: text;
    color: transparent; caret-color: transparent; font-size: 16px; /* 16px = no iOS zoom */
  }

  /* ── the crossing + arrival ── */
  .td-cross {
    position: fixed; inset: 0; z-index: 200; overflow: hidden;
    display: grid; place-items: center;
    background: #050309;
    opacity: 0; transition: opacity 240ms ease;
  }
  .td-cross[hidden] { display: none; }
  .td-cross[data-on="true"] { opacity: 1; }

  /* the room behind the vault */
  .td-room { position: absolute; inset: 0; overflow: hidden;
    background:
      radial-gradient(120% 80% at 50% -12%, rgba(255, 39, 97, 0.2), transparent 60%),
      radial-gradient(130% 90% at 50% 116%, rgba(14, 196, 252, 0.22), transparent 58%),
      #050309;
    transform: scale(1.12); opacity: 0;
    transition: transform 1300ms cubic-bezier(0.16, 1, 0.3, 1), opacity 600ms ease 200ms;
  }
  .td-cross[data-on="true"] .td-room { transform: scale(1); opacity: 1; }
  .td-floor {
    position: absolute; left: 50%; bottom: -2%; width: 220%; height: 52%; transform: translateX(-50%);
    background-image: linear-gradient(rgba(14, 196, 252, 0.5) 1px, transparent 1px), linear-gradient(90deg, rgba(14, 196, 252, 0.5) 1px, transparent 1px);
    background-size: 64px 64px;
    -webkit-mask-image: linear-gradient(180deg, transparent, #000 62%);
    mask-image: linear-gradient(180deg, transparent, #000 62%);
    transform: translateX(-50%) perspective(420px) rotateX(64deg);
    opacity: 0.5;
  }
  .td-aurora {
    position: absolute; left: 50%; top: 38%; width: 70%; height: 220px; transform: translateX(-50%);
    background: radial-gradient(closest-side, rgba(255, 90, 60, 0.4), transparent 70%);
    filter: blur(40px); opacity: 0.7;
  }
  .td-stars {
    position: absolute; inset: 0; background-image: url("/speckles.svg"); background-repeat: repeat;
    opacity: 0.1;
  }

  .td-arrival {
    position: relative; z-index: 2; width: min(560px, 90vw); text-align: center; padding: 24px;
    color: #f5f1e8;
    transform: translateY(16px); opacity: 0;
    transition: transform 700ms cubic-bezier(0.16, 1, 0.3, 1) 360ms, opacity 600ms ease 420ms;
  }
  .td-cross[data-on="true"] .td-arrival { transform: none; opacity: 1; }
  .td-plate-wordmark {
    font-family: ui-monospace, "SF Mono", SFMono-Regular, Menlo, monospace; font-size: 11px;
    letter-spacing: 0.04em; color: rgba(245, 241, 232, 0.7); margin: 0 0 18px;
  }
  .td-wm-dot { color: var(--brand-cyan); }
  .td-wm-sub { color: rgba(245, 241, 232, 0.4); letter-spacing: 0.16em; text-transform: uppercase; font-size: 9.5px; }
  .td-richard { display: flex; justify-content: center; margin-bottom: 14px; filter: drop-shadow(0 8px 26px rgba(0, 255, 77, 0.3)); }
  .td-arrival-head {
    font-family: "Space Grotesk Variable", "Space Grotesk", sans-serif; font-weight: 700;
    font-size: clamp(30px, 5vw, 46px); letter-spacing: -0.03em; line-height: 1; margin: 0 0 18px;
    background: linear-gradient(92deg, #ff2761, #ff5a3c 48%, #ffb347);
    -webkit-background-clip: text; background-clip: text; color: transparent; -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 6px 30px rgba(255, 89, 60, 0.3));
  }
  .td-arrival-copy {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 14px; line-height: 1.65;
    color: rgba(245, 241, 232, 0.82); margin: 0 auto 16px; max-width: 46ch;
  }
  .td-richard-line {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12.5px; margin: 0 0 26px;
    color: rgba(245, 241, 232, 0.6);
  }
  .td-rich-name { color: var(--brand-green); }
  .td-richard-line em { font-style: italic; color: rgba(245, 241, 232, 0.85); }

  .td-actions { display: inline-flex; align-items: center; gap: 14px; flex-wrap: wrap; justify-content: center; }
  .td-realdoor {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 11px; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--brand-cyan); text-decoration: none;
    padding: 9px 16px; border: 1px solid rgba(14, 196, 252, 0.45); border-radius: 6px;
    transition: color 160ms ease, background 160ms ease, border-color 160ms ease;
  }
  .td-realdoor:hover, .td-realdoor:focus-visible { outline: none; color: #050309; background: var(--brand-cyan); border-color: var(--brand-cyan); }
  .td-exit {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 11px; letter-spacing: 0.12em;
    text-transform: uppercase; color: rgba(245, 241, 232, 0.7); cursor: pointer;
    background: transparent; border: 1px solid rgba(245, 241, 232, 0.2); border-radius: 6px; padding: 9px 16px;
    display: inline-flex; align-items: center; gap: 8px;
    transition: color 160ms ease, border-color 160ms ease, background 160ms ease;
  }
  .td-exit:hover, .td-exit:focus-visible { outline: none; color: #f5f1e8; border-color: rgba(245, 241, 232, 0.5); background: rgba(245, 241, 232, 0.05); }
  .td-exit-key {
    font-size: 9px; letter-spacing: 0.1em; padding: 2px 5px; border-radius: 3px;
    border: 1px solid rgba(245, 241, 232, 0.28); color: rgba(245, 241, 232, 0.55);
  }

  /* the vault leaves — closed at center, grind apart on cross */
  .td-vault { position: absolute; inset: 0; z-index: 3; pointer-events: none; }
  .td-leaf {
    position: absolute; top: 0; bottom: 0; width: 50.6%;
    background: linear-gradient(180deg, #15121c, #0a0810);
    box-shadow: inset 0 0 120px rgba(0, 0, 0, 0.7);
    transition: transform 1150ms cubic-bezier(0.76, 0, 0.24, 1);
    overflow: hidden;
  }
  .td-leaf-l { left: 0; border-right: 1px solid rgba(14, 196, 252, 0.25); }
  .td-leaf-r { right: 0; border-left: 1px solid rgba(14, 196, 252, 0.25); }
  .td-glyphs {
    position: absolute; top: 50%; transform: translateY(-50%); width: 90px; height: 320px;
    opacity: 0.5;
    background:
      repeating-linear-gradient(0deg, transparent 0 22px, rgba(14, 196, 252, 0.4) 22px 23px),
      radial-gradient(circle at 50% 30%, rgba(255, 90, 60, 0.4), transparent 60%);
    -webkit-mask: radial-gradient(circle at 50% 50%, #000 60%, transparent 72%);
    mask: radial-gradient(circle at 50% 50%, #000 60%, transparent 72%);
  }
  .td-leaf-l .td-glyphs { right: 16px; }
  .td-leaf-r .td-glyphs { left: 16px; }
  .td-vault-seam {
    position: absolute; left: 50%; top: 0; bottom: 0; width: 3px; transform: translateX(-50%);
    background: linear-gradient(180deg, transparent, rgba(234, 248, 255, 0.95) 50%, transparent);
    box-shadow: 0 0 30px 6px rgba(14, 196, 252, 0.8); opacity: 0;
    transition: opacity 300ms ease;
  }
  .td-vault-core {
    position: absolute; left: 50%; top: 50%; width: 120px; height: 120px; transform: translate(-50%, -50%) scale(0.4);
    border-radius: 50%; border: 2px solid rgba(14, 196, 252, 0.6);
    box-shadow: 0 0 50px rgba(14, 196, 252, 0.7), inset 0 0 30px rgba(14, 196, 252, 0.5); opacity: 0;
  }
  .td-cross[data-on="true"] .td-vault-seam { opacity: 1; animation: td-seam-pulse 1.15s ease forwards; }
  .td-cross[data-on="true"] .td-vault-core { animation: td-core 0.85s ease forwards; }
  .td-cross[data-on="true"] .td-leaf-l { transform: translateX(-101%); }
  .td-cross[data-on="true"] .td-leaf-r { transform: translateX(101%); }
  @keyframes td-seam-pulse { 0% { opacity: 0; } 30% { opacity: 1; } 100% { opacity: 0; } }
  @keyframes td-core {
    0% { opacity: 0; transform: translate(-50%, -50%) scale(0.3); }
    45% { opacity: 1; transform: translate(-50%, -50%) scale(1.1); }
