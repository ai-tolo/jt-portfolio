---
// THE THRESHOLD — the closing. A piece of Jon's gear sits dark on the bench.
// Power it on, solve its one riddle, and the wall opens onto the LISTENING
// ROOM: nine sections talk about "head to toe"; behind the door it finally
// plays. A lathe cuts a record; somebody gets to drop the needle.
//
//   gate    → a tall vault-terminal. The POWER button wakes it: a bright cyan
//             light-line traces each panel's perimeter from top-middle to
//             bottom-middle (the screen stays dark until it lands), then the panel
//             warms up fallout-style and a prompt types in. Five little CRTs hold
//             the riddle — 💨 💧 ⛰️ 🔥 and 🔊 — and come up slowly, like old bulbs.
//             A garbled readout extinguishes into "BENDER" on hover, lighting the
//             🔊 panel with it. Type soundbender.
//   room    → the kiln dial's bones re-machined as a PLATTER: side A's lacquer
//             turns at one constant slow rate, the real engraved waveform sits
//             under it (scrubbable), and the crowned master streams on an
//             explicit press. Crown + confetti at the needle drop and at the
//             end, by any means — scrub-to-end counts.
//   exit    → a tasteful esc keycap in the corner steps back out.
//
// Touch, keyboard (focus + type + Enter + Esc + focus-trap), reduced-motion all
// work (the platter alone keeps its constant slow rate; the engraving renders
// pre-drawn). No-JS shows a sealed, dormant panel.

const WORD = "soundbender";
const SLOTS = Array.from({ length: WORD.length }, (_, i) => i);

// ── 14-segment alphanumeric display geometry (one glyph, viewBox 0 0 60 96) ──
const SEG: Record<string, [number, number, number, number]> = {
  A: [10, 10, 50, 10], B: [50, 10, 50, 48], C: [50, 48, 50, 86], D: [10, 86, 50, 86],
  E: [10, 48, 10, 86], F: [10, 10, 10, 48], G1: [10, 48, 30, 48], G2: [30, 48, 50, 48],
  H: [10, 10, 30, 48], I: [30, 10, 30, 48], J: [50, 10, 30, 48],
  K: [30, 48, 10, 86], L: [30, 48, 30, 86], M: [30, 48, 50, 86],
};
const SEG_ORDER = ["A", "B", "C", "D", "E", "F", "G1", "G2", "H", "I", "J", "K", "L", "M"];
const GLYPH: Record<string, string[]> = {
  B: ["A", "B", "C", "D", "G2", "I", "L"],
  E: ["A", "D", "E", "F", "G1", "G2"],
  N: ["B", "C", "E", "F", "H", "M"],
  D: ["A", "B", "C", "D", "I", "L"],
  R: ["A", "B", "E", "F", "G1", "G2", "M"],
};
const BENDER = ["B", "E", "N", "D", "E", "R"];
// per-glyph vertical jog for the garbled (powered, un-hovered) state
const GOFF = [7, -5, 9, -6, 4, -8];
const ELEMENTS = [
  { e: "💨", el: "air" }, { e: "💧", el: "water" }, { e: "⛰️", el: "earth" }, { e: "🔥", el: "fire" },
];

// ── THE RECORD ── side A of "head to toe": the crowned master (job 139's
// king, re-exported through the engine at the corrected -2 dBTP ceiling), cut
// at the detected halfway boundary (210.6s) with a 3s side-out fade. The peaks
// JSON is measured from the shipped audio itself (one-off script on the M1)
// and imported at build, so the engraved waveform is SSR'd — no runtime fetch,
// pre-drawn under reduced motion.
import peaksFile from "../../../../public/case-studies/the-console/master/head-to-toe-side-a.peaks.json";
const SIDE_A_SRC = "/case-studies/the-console/master/head-to-toe-side-a.mp3";
const SIDE_A_DUR: number = peaksFile.duration_s;
const fmtTime = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, "0")}`;
const SIDE_A_LEN = fmtTime(SIDE_A_DUR);

// the engraved waveform: an area path mirrored around the midline, built from
// the real peak buckets (1500 max-pooled to 500 so the path string stays sane)
const W = 1000, H = 120, MID = H / 2;
const _pk: number[] = peaksFile.buckets;
const _pool = Math.max(1, Math.floor(_pk.length / 500));
const PEAKS = Array.from({ length: Math.floor(_pk.length / _pool) }, (_, i) => Math.max(..._pk.slice(i * _pool, (i + 1) * _pool)));
const _pts = PEAKS.map((p, i) => [(i + 0.5) * (W / PEAKS.length), Math.max(2.2, p * (MID - 6))]);
const WAVE_D =
  `M0 ${MID}` +
  _pts.map(([x, a]) => `L${x.toFixed(1)} ${(MID - a).toFixed(1)}`).join("") +
  `L${W} ${MID}` +
  [..._pts].reverse().map(([x, a]) => `L${x.toFixed(1)} ${(MID + a).toFixed(1)}`).join("") +
  "Z";

// ── HYPERSPACE ── the gateway hangs in digital space; stars streak outward from a
// vanishing point (dead-center, behind the panel), accelerating into lightspeed toward
// the cloud it opens onto. Pure CSS: radial streaks flying from center + a faint static
// starfield for depth. Deterministic scatter so SSR + the boot reaction stay stable.
const fr = (x: number) => x - Math.floor(x);
const rnd = (i: number, s: number) => fr(Math.sin((i + 1) * s) * 43758.5453);
const WARP = Array.from({ length: 72 }, (_, i) => ({
  a: Math.round(fr((i + 1) * 0.61803398875) * 360),   // golden-angle spread = even, non-banded
  delay: +(-6 * rnd(i, 12.9898)).toFixed(2),           // negative offset → each already mid-flight
  dur: +(2.8 + 2.6 * rnd(i, 78.233)).toFixed(2),
  len: Math.round(120 + 180 * rnd(i, 39.425)),
  cyan: i % 4 === 0,
}));
const STARS = Array.from({ length: 46 }, (_, i) => ({
  x: +(rnd(i, 11.13) * 100).toFixed(1),
  y: +(rnd(i, 91.7) * 100).toFixed(1),
  r: +(0.6 + 1.1 * rnd(i, 47.3)).toFixed(2),
  o: +(0.2 + 0.5 * rnd(i, 7.7)).toFixed(2),
  tw: +(3 + 5 * rnd(i, 23.1)).toFixed(1),
}));

---

<section class="sd" data-sd data-powered="off" data-booted="off" aria-label="One song behind this door: the Listening Room">
  <!-- ── HYPERSPACE · the gateway hangs in digital space, stars streaking past at
       lightspeed toward the cloud it opens onto. Pure background behind the panel
       (z-index 0, pointer-events none) — nothing touches the casing. ── -->
  <div class="sd-set" aria-hidden="true">
    <span class="sd-warp-core"></span>
    <div class="sd-stars">
      {STARS.map((s) => <span class="sd-star" style={`left:${s.x}%; top:${s.y}%; --r:${s.r}px; --o:${s.o}; --tw:${s.tw}s`}></span>)}
    </div>
    <div class="sd-streaks">
      {WARP.map((s) => (
        <span class:list={["sd-streak", { "sd-streak-c": s.cyan }]} style={`--a:${s.a}deg; --delay:${s.delay}s; --dur:${s.dur}s; --len:${s.len}px`}><i></i></span>
      ))}
    </div>
  </div>

  <!-- ── the access console · the gateway terminal, hanging in hyperspace ── -->
  <div class="sd-gate">
  <div class="sd-console" data-sd-console>
    <span class="sd-bolt sd-b-tl" aria-hidden="true"></span><span class="sd-bolt sd-b-tr" aria-hidden="true"></span>
    <span class="sd-bolt sd-b-bl" aria-hidden="true"></span><span class="sd-bolt sd-b-br" aria-hidden="true"></span>

    <div class="sd-top">
      <span class="sd-brand">Tolo<span class="sd-brand-dot">.</span>Cloud</span>
      <span class="sd-top-tag" aria-hidden="true">LISTENING ROOM</span>
      <span class="sd-lock" aria-hidden="true">
        <svg viewBox="0 0 18 18" width="12" height="12"><path d="M5 8V6a4 4 0 018 0v2M4 8h10v6H4z" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </span>
      <button type="button" class="sd-power" data-sd-power aria-label="Power" aria-pressed="false">
        <span class="sd-power-bezel" aria-hidden="true"></span>
        <span class="sd-power-ring" aria-hidden="true"></span>
        <svg class="sd-power-glyph" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.2v8.2" /><path d="M6.3 6.6a8 8 0 1011.4 0" /></svg>
      </button>
    </div>

    <div class="sd-body">
      <!-- the riddle: five little vault-terminal CRTs that wake like old bulbs -->
      <div class="sd-strip" data-sd-decoder tabindex="0" role="button" aria-label="Decode the riddle">
        {[...ELEMENTS, { e: "🔊", el: "sound" }].map((m, i) => (
          <span class:list={["sd-crt", { "sd-crt-sound": m.el === "sound" }]} data-el={m.el} style={`--bd:${(i * 0.3).toFixed(2)}s`} aria-hidden="true">
            <span class="sd-crt-emoji">{m.e}</span>
            <span class="sd-crt-scan"></span><span class="sd-crt-vig"></span>
          </span>
        ))}
      </div>

      <div class="sd-right">
        <!-- the code-entry screen -->
        <div class="sd-screen sd-screen-code" data-sd-trace>
          <svg class="sd-trace" preserveAspectRatio="none" aria-hidden="true"><path class="sd-trace-l"></path><path class="sd-trace-r"></path></svg>
          <span class="sd-roll" aria-hidden="true"></span>
          <span class="sd-screen-label" aria-hidden="true">ACCESS CODE</span>
          <div class="sd-codewrap">
            <div class="sd-prompt" aria-hidden="true"><span class="sd-prompt-txt">ENTER ACCESS CODE</span></div>
            <div class="sd-tiles" aria-hidden="true">
              {SLOTS.map((i) => <span class="sd-tile" data-sd-tile data-i={i} data-lit="false"></span>)}
            </div>
          </div>
          <input class="sd-input" data-sd-input type="text" inputmode="text" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" aria-label="Type the passcode to enter the Listening Room" />
        </div>

        <!-- the decode screen — a garbled readout that extinguishes into BENDER -->
        <div class="sd-screen sd-screen-decode" data-sd-trace data-sd-decoder2 aria-hidden="true">
          <svg class="sd-trace" preserveAspectRatio="none" aria-hidden="true"><path class="sd-trace-l"></path><path class="sd-trace-r"></path></svg>
          <span class="sd-roll" aria-hidden="true"></span>
          <span class="sd-screen-label" aria-hidden="true">DECODE</span>
          <div class="sd-readout" data-sd-readout>
            {BENDER.map((ch, ci) => (
              <span class="sd-glyph" data-sd-glyph data-ci={ci} style={`--oy:${GOFF[ci]}px`}>
                <svg viewBox="0 0 60 96" preserveAspectRatio="xMidYMid meet">
                  {SEG_ORDER.map((s) => {
                    const [x1, y1, x2, y2] = SEG[s];
                    return <line class="sd-seg" data-seg={s} data-on={GLYPH[ch].includes(s) ? "true" : "false"} x1={x1} y1={y1} x2={x2} y2={y2} />;
                  })}
                </svg>
              </span>
            ))}
          </div>
        </div>
      </div>
    </div>

    <div class="sd-foot">
      <span class="sd-grille" aria-hidden="true"></span>
      <span class="sd-foot-tag" data-sd-foottag>press power to wake</span>
      <button type="button" class="sd-q" data-sd-hint aria-label="reveal the passcode" aria-expanded="false">?</button>
      <span class="sd-q-ans" data-sd-hinttext hidden>soundbender</span>
    </div>
  </div>
  </div>

  <!-- ── the crossing → THE LISTENING ROOM ──
       The door's destination: the lathe finally plays what it cut. The kiln
       dial's bones, re-machined as a platter — the lacquer of "head to toe"
       side A spins slow, the real engraved waveform sits under it, and the
       crowned master streams on an explicit press. Inherits the old diorama
       shell wholesale: fullscreen takeover, focus trap, esc back out through
       the warp. The needle drop and reaching the end (by any means, scrubbing
       counts) each fire the crown. -->
  <div class="sd-cross" data-sd-cross hidden>
    <div class="rig" role="dialog" aria-modal="true" aria-label="The Listening Room: head to toe, side A">
      <header class="rig-bar">
        <span class="rig-wm">Tolo<span class="rig-wm-dot">.</span>Cloud</span>
        <button type="button" class="rig-esc" data-sd-exit aria-label="Step back out">
          <span class="rig-esc-key">esc</span>
          <svg viewBox="0 0 20 20" width="13" height="13" aria-hidden="true"><path d="M5 5l10 10M15 5L5 15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
        </button>
      </header>

      <div class="rig-stage">
        <span class="rig-floor" aria-hidden="true"></span>

        <section class="room" aria-label="head to toe, side A: the crowned master, ready to play">
          <span class="rig-bolt b1" aria-hidden="true"></span><span class="rig-bolt b2" aria-hidden="true"></span>
          <span class="rig-bolt b3" aria-hidden="true"></span><span class="rig-bolt b4" aria-hidden="true"></span>

          <!-- THE PLATTER · the kiln dial's bones re-machined: dark-glass
               lacquer, the dial's machined rim, runout etching that actually
               turns. The crown caps the static spindle and blazes at the
               payoffs. No wood, no VU meters, no tonearm (that's Cut 2). -->
          <div class="room-deck">
            <div class="room-platter" aria-hidden="true">
              <span class="room-lacquer"></span>
              <span class="room-rotor" data-nd-rotor>
                <svg class="room-runout" viewBox="0 0 200 200">
                  <defs><path id="nd-runout-arc" d="M100 38a62 62 0 1 1 -0.01 0" fill="none" /></defs>
                  <text><textPath href="#nd-runout-arc">HEAD TO TOE · SIDE A · MK·III · TOLO.CLOUD</textPath></text>
                </svg>
                <span class="room-hairline"></span>
              </span>
              <span class="room-sheen"></span>
              <span class="room-spindle"></span>
              <span class="room-crown" data-nd-crown>♛</span>
              <span class="room-confetti" data-nd-confetti><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span>
            </div>
          </div>

          <!-- TRANSPORT · the solve was the consent; this is the explicit press -->
          <div class="room-transport">
            <button type="button" class="room-play" data-nd-play aria-label="Play side A" aria-pressed="false">
              <span class="room-play-ring" aria-hidden="true"></span>
              <svg class="room-play-glyph" viewBox="0 0 24 24" aria-hidden="true">
                <path class="rp-play" d="M9.2 6.4v11.2l9.4-5.6z" />
                <g class="rp-pause"><rect x="7.8" y="6.4" width="2.7" height="11.2" rx="0.9" /><rect x="13.5" y="6.4" width="2.7" height="11.2" rx="0.9" /></g>
              </svg>
            </button>
            <span class="room-time" aria-hidden="true"><b data-nd-elapsed>0:00</b><i>/</i><span>{SIDE_A_LEN}</span></span>
          </div>

          <!-- THE CUT · the real waveform of side A (peaks measured from the
               shipped audio), engraved at build, scrubbable. Draws itself once
               on entry; reduced motion gets it pre-drawn. -->
          <div class="room-wave" data-nd-wave data-dur={SIDE_A_DUR} role="slider" tabindex="0"
            aria-label="Scrub side A" aria-valuemin="0" aria-valuemax={Math.round(SIDE_A_DUR)} aria-valuenow="0" aria-valuetext={`0:00 of ${SIDE_A_LEN}`}>
            <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" aria-hidden="true">
              <defs>
                <clipPath id="nd-drawn"><rect class="nd-draw-rect" x="0" y="0" width={W} height={H} /></clipPath>
                <clipPath id="nd-played"><rect data-nd-playedrect x="0" y="0" width="0" height={H} /></clipPath>
              </defs>
              <g clip-path="url(#nd-drawn)"><path class="room-wave-base" d={WAVE_D} /></g>
              <g clip-path="url(#nd-played)"><path class="room-wave-played" d={WAVE_D} /></g>
            </svg>
          </div>

          <!-- THE PLATE -->
          <div class="room-plate">
            <p class="room-plate-head">HEAD TO TOE. The master, side A. Crowned blind, 5/6. My rounds, n=1.</p>
            <p class="room-plate-graft">You judged this song five times without hearing it. Here is side A.</p>
            <p class="room-ledger" data-nd-ledger hidden></p>
          </div>

          <span class="rig-brand" aria-hidden="true">TOLO·CLOUD · LIVE</span>
          <span class="rig-serial" aria-hidden="true">MK·III · THE LATHE</span>
          <span class="rig-vents" aria-hidden="true"></span>
        </section>
      </div>

      <audio data-nd-audio preload="none" data-src={SIDE_A_SRC}></audio>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-sd]").forEach((root) => {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const consoleEl = root.querySelector<HTMLElement>("[data-sd-console]");
    const powerBtn = root.querySelector<HTMLButtonElement>("[data-sd-power]");
    const footTag = root.querySelector<HTMLElement>("[data-sd-foottag]");
    const input = root.querySelector<HTMLInputElement>("[data-sd-input]");
    const tiles = Array.from(root.querySelectorAll<HTMLElement>("[data-sd-tile]"));
    const decoders = Array.from(root.querySelectorAll<HTMLElement>("[data-sd-decoder], [data-sd-decoder2]"));
    const strip = root.querySelector<HTMLElement>("[data-sd-decoder]");
    const glyphs = Array.from(root.querySelectorAll<HTMLElement>("[data-sd-glyph]"));
    const traceHosts = Array.from(root.querySelectorAll<HTMLElement>("[data-sd-trace]"));
    const hintBtn = root.querySelector<HTMLButtonElement>("[data-sd-hint]");
    const hintText = root.querySelector<HTMLElement>("[data-sd-hinttext]");
    const cross = root.querySelector<HTMLElement>("[data-sd-cross]");
    const exitBtn = root.querySelector<HTMLElement>("[data-sd-exit]");
    if (!consoleEl || !input || !cross) return;

    const WORD = "soundbender";
    let crossed = false, powered = false, decoded = false, hovering = false, shakeTimer = 0, bootTimer = 0;
    root.dataset.ready = "true";

    const segEls = glyphs.map((g) => Array.from(g.querySelectorAll<SVGLineElement>("[data-seg]")));
    const masks = segEls.map((segs) => segs.map((s) => s.dataset.on === "true"));
    const lockTrue = () => segEls.forEach((segs, gi) => segs.forEach((el, si) => (el.dataset.on = masks[gi][si] ? "true" : "false")));
    const garbleAll = () => segEls.forEach((segs) => segs.forEach((el) => (el.dataset.on = "true")));

    const place = (p: number) => {
      tiles.forEach((el, i) => {
        const lit = i < p;
        el.dataset.lit = String(lit);
        el.textContent = lit ? WORD[i] : "";
        el.dataset.active = String(i === p && powered && !crossed);
      });
    };
    const shake = () => {
      root.dataset.shake = "1";
      window.clearTimeout(shakeTimer);
      shakeTimer = window.setTimeout(() => (root.dataset.shake = "0"), reduce ? 120 : 360);
    };
    const curLen = () => {
      const v = input.value.toLowerCase().replace(/[^a-z]/g, "");
      let p = 0; while (p < v.length && p < WORD.length && v[p] === WORD[p]) p++; return p;
    };

    // ── border trace: one cyan line each side, top-middle → bottom-middle ──
    const buildTrace = (host: HTMLElement) => {
      const pl = host.querySelector<SVGPathElement>(".sd-trace-l");
      const pr = host.querySelector<SVGPathElement>(".sd-trace-r");
      const svg = host.querySelector<SVGSVGElement>("svg.sd-trace");
      if (!pl || !pr || !svg) return;
      const w = host.clientWidth, h = host.clientHeight;
      if (!w || !h) return;
      const r = Math.max(2, Math.min(parseFloat(getComputedStyle(host).borderTopLeftRadius) || 12, Math.min(w, h) / 2 - 1));
      svg.setAttribute("viewBox", `0 0 ${w} ${h}`);
      // the code screen (top) draws top-middle -> down both sides -> bottom-middle.
      // the decode/BENDER screen (bottom) is INVERTED: it starts at the bottom-middle
      // and draws UP both sides to the top-middle — mirroring the top screen's motion.
      if (host.classList.contains("sd-screen-decode")) {
        pr.setAttribute("d", `M${w / 2} ${h - 1} H${w - r} A${r} ${r} 0 0 0 ${w - 1} ${h - r} V${r} A${r} ${r} 0 0 0 ${w - r} 1 H${w / 2}`);
        pl.setAttribute("d", `M${w / 2} ${h - 1} H${r} A${r} ${r} 0 0 1 1 ${h - r} V${r} A${r} ${r} 0 0 1 ${r} 1 H${w / 2}`);
      } else {
        pr.setAttribute("d", `M${w / 2} 1 H${w - r} A${r} ${r} 0 0 1 ${w - 1} ${r} V${h - r} A${r} ${r} 0 0 1 ${w - r} ${h - 1} H${w / 2}`);
        pl.setAttribute("d", `M${w / 2} 1 H${r} A${r} ${r} 0 0 0 1 ${r} V${h - r} A${r} ${r} 0 0 0 ${r} ${h - 1} H${w / 2}`);
      }
      // suppress the draw transition while we seat the full-offset (hidden) baseline,
      // so the very first power-on draws too — see runBoot
      [pl, pr].forEach((p) => { const L = p.getTotalLength(); p.style.transition = "none"; p.style.strokeDasharray = String(L); p.style.strokeDashoffset = String(L); });
    };
    const runBoot = () => {
      window.clearTimeout(bootTimer);
      traceHosts.forEach((host) => { buildTrace(host); host.dataset.trace = "draw"; });
      void root.offsetWidth;   // commit the hidden full-offset baseline with transitions suppressed
      // restore the draw transition now that the "from" value is the committed baseline;
      // previously the first build animated the default 0 -> L, leaving the -> 0 with nothing to draw
      traceHosts.forEach((host) => host.querySelectorAll<SVGPathElement>(".sd-trace-l, .sd-trace-r").forEach((p) => { p.style.transition = ""; }));
      void root.offsetWidth;
      const stagger = reduce ? 0 : 160;
      traceHosts.forEach((host, i) => {
        window.setTimeout(() => {
          host.querySelectorAll<SVGPathElement>(".sd-trace-l, .sd-trace-r").forEach((p) => (p.style.strokeDashoffset = "0"));
        }, i * stagger);
      });
      const total = reduce ? 0 : traceHosts.length * stagger + 1240;
      bootTimer = window.setTimeout(() => {
        root.dataset.booted = "on";
        traceHosts.forEach((host) => (host.dataset.trace = "done"));
      }, total);
    };
    const resetBoot = () => {
      window.clearTimeout(bootTimer);
      root.dataset.booted = "off";
      traceHosts.forEach((host) => {
        host.dataset.trace = "off";
        host.querySelectorAll<SVGPathElement>(".sd-trace-l, .sd-trace-r").forEach((p) => (p.style.strokeDashoffset = p.style.strokeDasharray));
      });
    };

    // ── the readout: garbled (all segments lit, jogged) → extinguishes to BENDER ──
    const resolve = () => {
      if (!powered) return;
      hovering = true;
      lockTrue();
      root.dataset.decoding = "true";
      if (!decoded) { decoded = true; root.dataset.decoded = "true"; }
    };
    const unresolve = () => { hovering = false; root.dataset.decoding = "false"; garbleAll(); };

    // ── power toggle ──
    const powerOn = () => {
      if (powered) return;
      powered = true;
      root.dataset.powered = "on";
      powerBtn?.setAttribute("aria-pressed", "true");
      if (footTag) footTag.textContent = "one song behind this door · head to toe";
      garbleAll();
      place(curLen());
      runBoot();
    };
    const powerOff = () => {
      powered = false;
      root.dataset.powered = "off";
      powerBtn?.setAttribute("aria-pressed", "false");
      if (footTag) footTag.textContent = "press power to wake";
      root.dataset.decoding = "false";
      hovering = false;
      resetBoot();
      place(0);
    };
    const togglePower = () => (powered ? powerOff() : powerOn());

    // the power button is the ONLY way in — the screens never auto-boot. Once it's
    // on, clicking the panel just focuses the input so you can type.
    powerBtn?.addEventListener("click", (e) => { e.stopPropagation(); togglePower(); if (powered) input.focus(); });
    consoleEl.addEventListener("click", (e) => {
      if (!powered) return;
      if ((e.target as HTMLElement).closest("[data-sd-power], [data-sd-hint], [data-sd-decoder]")) return;
      input.focus();
    });

    decoders.forEach((d) => {
      d.addEventListener("pointerenter", resolve);
      d.addEventListener("pointerleave", unresolve);
    });
    strip?.addEventListener("focus", resolve);
    strip?.addEventListener("blur", unresolve);
    strip?.addEventListener("keydown", (e) => { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); resolve(); } });

    input.addEventListener("input", () => {
      if (!powered) { input.value = ""; return; }
      const v = input.value.toLowerCase().replace(/[^a-z]/g, "");
      let p = 0; while (p < v.length && p < WORD.length && v[p] === WORD[p]) p++;
      const broke = v.length > p;
      if (v.length !== p) input.value = WORD.slice(0, p);
      place(p);
      if (broke) shake();
      if (p === WORD.length && !crossed) open();
    });

    hintBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      if (!hintText) return;
      const on = !hintText.hasAttribute("hidden");
      if (on) { hintText.setAttribute("hidden", ""); hintBtn!.setAttribute("aria-expanded", "false"); }
      else { hintText.removeAttribute("hidden"); hintBtn!.setAttribute("aria-expanded", "true"); }
    });

    // ── THE LISTENING ROOM ── the master streams on an explicit press; honest
    // payoffs: crown + confetti at the needle drop and at reaching the end by
    // any means (scrub-to-end counts), never only at the final chord.
    //
    // (Cut 2 note: Richard's momentum model — rest drift 0.05 deg/frame, shove
    // toward 2.4 with accel 0.18, friction coast 0.986, angle accumulating so a
    // push never resets him — lived right here pre-needle-drop; see this file's
    // git history at the swap commit. It rehomes onto the platter when Richard
    // rides it in Cut 2, shoved by an AnalyserNode low band instead of the old
    // kiln phase loop.)
    const audio = root.querySelector<HTMLAudioElement>("[data-nd-audio]");
    const playBtn = root.querySelector<HTMLButtonElement>("[data-nd-play]");
    const waveEl = root.querySelector<HTMLElement>("[data-nd-wave]");
    const playedRect = root.querySelector<SVGRectElement>("[data-nd-playedrect]");
    const elapsedEl = root.querySelector<HTMLElement>("[data-nd-elapsed]");
    const ledgerEl = root.querySelector<HTMLElement>("[data-nd-ledger]");
    const DUR = parseFloat(waveEl?.dataset.dur || "210.6");
    const fmt = (s: number) => `${Math.floor(Math.max(0, s) / 60)}:${String(Math.floor(Math.max(0, s) % 60)).padStart(2, "0")}`;
    let dropFired = false, endFired = false, scrubbing = false, wasPlaying = false, tickRAF = 0, celebrateTimer = 0;

    const setProgress = (t: number) => {
      const c = Math.min(Math.max(t, 0), DUR);
      if (playedRect) playedRect.setAttribute("width", String(Math.round((c / DUR) * 10000) / 10));
      if (elapsedEl) elapsedEl.textContent = fmt(c);
      if (waveEl) {
        waveEl.setAttribute("aria-valuenow", String(Math.round(c)));
        waveEl.setAttribute("aria-valuetext", `${fmt(c)} of ${fmt(DUR)}`);
      }
    };
    const celebrate = () => {
      cross.dataset.celebrate = "0";
      void cross.offsetWidth;
      cross.dataset.celebrate = "1";
      window.clearTimeout(celebrateTimer);
      celebrateTimer = window.setTimeout(() => (cross.dataset.celebrate = "0"), 1100);
    };
    const fireEnd = () => { if (!endFired) { endFired = true; celebrate(); } };
    const stopTick = () => { if (tickRAF) { cancelAnimationFrame(tickRAF); tickRAF = 0; } };
    const tick = () => { if (audio && !scrubbing) setProgress(audio.currentTime); tickRAF = requestAnimationFrame(tick); };
    const startTick = () => { if (!tickRAF) tick(); };

    audio?.addEventListener("playing", () => {
      cross.dataset.playing = "1";
      playBtn?.setAttribute("aria-pressed", "true");
      playBtn?.setAttribute("aria-label", "Pause side A");
      if (!dropFired) { dropFired = true; cross.dataset.dropped = "1"; celebrate(); }   // the needle drop
      startTick();
    });
    audio?.addEventListener("pause", () => {
      cross.dataset.playing = "0";
      playBtn?.setAttribute("aria-pressed", "false");
      playBtn?.setAttribute("aria-label", "Play side A");
      stopTick();
      if (audio) setProgress(audio.currentTime);
    });
    audio?.addEventListener("ended", () => { setProgress(DUR); fireEnd(); });

    playBtn?.addEventListener("click", () => {
      if (!audio) return;
      if (audio.paused) {
        // parked at the runout: pressing play starts the side over
        if (audio.ended || audio.currentTime >= DUR - 0.05) { audio.currentTime = 0; setProgress(0); }
        void audio.play();
      } else audio.pause();
    });

    // scrub: drag anywhere on the engraving; releasing at the runout counts as
    // reaching the end (the payoff is for arriving, not for sitting through it)
    const seekFrac = (clientX: number) => {
      if (!audio || !waveEl) return;
      const r = waveEl.getBoundingClientRect();
      const f = Math.min(Math.max((clientX - r.left) / Math.max(1, r.width), 0), 1);
      audio.currentTime = f * DUR;
      setProgress(f * DUR);
    };
    waveEl?.addEventListener("pointerdown", (e) => {
      if (!audio) return;
      scrubbing = true;
      wasPlaying = !audio.paused;
      audio.pause();
      waveEl.setPointerCapture(e.pointerId);
      seekFrac(e.clientX);
    });
    waveEl?.addEventListener("pointermove", (e) => { if (scrubbing) seekFrac(e.clientX); });
    const endScrub = () => {
      if (!scrubbing || !audio) return;
      scrubbing = false;
      if (audio.currentTime >= DUR - 0.3) { setProgress(DUR); fireEnd(); }
      else if (wasPlaying) void audio.play();
    };
    waveEl?.addEventListener("pointerup", endScrub);
    waveEl?.addEventListener("pointercancel", endScrub);
    waveEl?.addEventListener("keydown", (e) => {
      if (!audio) return;
      let t: number | null = null;
      if (e.key === "ArrowRight") t = Math.min(DUR, audio.currentTime + 5);
      else if (e.key === "ArrowLeft") t = Math.max(0, audio.currentTime - 5);
      else if (e.key === "Home") t = 0;
      else if (e.key === "End") t = DUR;
      if (t === null) return;
      e.preventDefault();
      audio.currentTime = t;
      setProgress(t);
      if (t >= DUR - 0.3) fireEnd();
    });

    // deterministic test hook (rAF is throttled headless, atlas gotcha #6)
    (root as any).__room = {
      seek: (t: number) => { if (audio) audio.currentTime = t; setProgress(t); },
      celebrate,
      get t() { return audio ? audio.currentTime : 0; },
    };

    const open = () => {
      crossed = true;
      root.dataset.crossed = "true";
      place(WORD.length);
      if (cross.parentElement !== document.body) document.body.appendChild(cross);
      cross.removeAttribute("hidden");
      void cross.offsetWidth;
      cross.dataset.on = "true";
      document.documentElement.style.overflow = "hidden";
      // the room wakes: stream the master only now (the solve was the consent
      // gesture), arm the per-entry payoffs, surface the visitor's own ledger
      if (audio && !audio.getAttribute("src")) {
        audio.src = audio.dataset.src || "";
        audio.preload = "auto";
        audio.load();
      }
      dropFired = false; endFired = false;
      cross.dataset.dropped = "0";
      cross.dataset.playing = "0";
      setProgress(audio ? audio.currentTime : 0);
      try { localStorage.setItem("jt-sound", "on"); } catch {}
      try {
        const n = Object.keys(JSON.parse(localStorage.getItem("lathe-verdicts-v1") || "{}")).length;
        if (ledgerEl && n > 0) {
          ledgerEl.textContent = `You crowned takes of this song ${n} ${n === 1 ? "time" : "times"}.`;
          ledgerEl.removeAttribute("hidden");
        }
      } catch {}
      window.setTimeout(() => playBtn?.focus(), reduce ? 0 : 80);
    };
    const close = () => {
      cross.dataset.on = "false";
      audio?.pause();
      stopTick();
      document.documentElement.style.overflow = "";
      window.setTimeout(() => cross.setAttribute("hidden", ""), reduce ? 0 : 520);
      crossed = false;
      root.dataset.crossed = "false";
      input.value = "";
      place(0);
      window.setTimeout(() => input.focus(), reduce ? 0 : 80);
    };
    exitBtn?.addEventListener("click", close);
    document.addEventListener("keydown", (e) => {
      if (!crossed) return;
      if (e.key === "Escape") { e.preventDefault(); close(); return; }
      if (e.key === "Tab") {
        const f = Array.from(cross.querySelectorAll<HTMLElement>('a[href], button:not([disabled]), [tabindex="0"]')).filter((el) => el.offsetParent !== null);
        if (!f.length) return;
        const first = f[0], last = f[f.length - 1];
        if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
        else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
      }
    });

    place(0);
  });
</script>

<style>
  .sd {
    position: relative;
    min-height: clamp(720px, 100vh, 1040px);
    display: grid; place-items: center;
    padding: clamp(36px, 6vh, 72px) clamp(16px, 4vw, 40px) clamp(28px, 4vh, 48px);
    border-top: 1px solid rgba(245, 241, 232, 0.08);
    background:
      radial-gradient(60% 54% at 50% 44%, rgba(14, 196, 252, 0.055), transparent 78%),
      radial-gradient(132% 112% at 50% 56%, transparent 44%, rgba(0, 0, 0, 0.64) 100%);
    text-align: left;
  }

  /* ════ HYPERSPACE ════ a pure background behind the panel: the gateway hangs in digital
     space and stars streak outward from a vanishing point (dead-center, behind the panel)
     into lightspeed. z-index 0, behind the panel (.sd-gate is z-index 1), pointer-events
     none — nothing fused to the casing, nothing recolored. */
  .sd-set { position: absolute; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
  .sd-gate { position: relative; z-index: 1; display: flex; justify-content: center; }

  /* the destination glow — the cloud the gateway opens onto, dead-center behind the panel */
  .sd-warp-core { position: absolute; left: 50%; top: 50%; width: 52vw; height: 52vw; max-width: 760px; max-height: 760px; transform: translate(-50%, -50%); border-radius: 50%;
    background: radial-gradient(circle, rgba(14, 196, 252, 0.08) 0%, rgba(123, 92, 255, 0.045) 34%, transparent 64%);
    opacity: 0.7; transition: opacity 700ms ease; }
  .sd[data-booted="on"] .sd-warp-core { opacity: 1; }

  /* faint static starfield for depth (always present; a slow desynced twinkle) */
  .sd-stars { position: absolute; inset: 0; }
  .sd-star { position: absolute; width: var(--r); height: var(--r); border-radius: 50%; background: #cfeaff; opacity: var(--o);
    animation: sd-twinkle var(--tw) ease-in-out infinite; }
  @keyframes sd-twinkle { 0%, 100% { opacity: calc(var(--o) * 0.45); } 50% { opacity: var(--o); } }

  /* the lightspeed streaks — each a radial line flying out from center, accelerating.
     the parent rotates to the streak's angle; the line translates + elongates outward. */
  .sd-streaks { position: absolute; left: 50%; top: 50%; }
  .sd-streak { position: absolute; left: 0; top: 0; transform: rotate(var(--a)); transform-origin: 0 0; }
  .sd-streak i { position: absolute; left: 0; top: -0.75px; height: 1.5px; width: var(--len); border-radius: 2px; transform-origin: left center;
    background: linear-gradient(90deg, transparent, rgba(190, 240, 255, 0.85));
    animation: sd-warp-fly var(--dur) cubic-bezier(0.55, 0, 0.95, 0.45) var(--delay) infinite; }
  .sd-streak-c i { background: linear-gradient(90deg, transparent, rgba(120, 230, 255, 0.95)); }
  @keyframes sd-warp-fly {
    0% { transform: translateX(2vmax) scaleX(0.04); opacity: 0; }
    10% { opacity: 0.85; }
    100% { transform: translateX(82vmax) scaleX(1); opacity: 0; }
  }
  /* boot — the jump energizes: the destination + the streaks brighten */
  .sd[data-booted="on"] .sd-streak i { filter: drop-shadow(0 0 3px rgba(120, 230, 255, 0.55)); }

  @media (max-width: 760px) { .sd-warp-core { width: 86vw; height: 86vw; } }
  @media (prefers-reduced-motion: reduce) {
    /* freeze the warp into a still starfield (each streak holds at its phase offset) */
    .sd-streak i, .sd-star { animation-play-state: paused; }
  }

  /* ── the access console ── */
  .sd-console {
    position: relative; width: min(1080px, 94vw); border-radius: 26px; padding: clamp(15px, 1.7vw, 24px) clamp(17px, 1.9vw, 28px) clamp(13px, 1.5vw, 20px);
    cursor: default;
    background:
      radial-gradient(78% 64% at 50% 18%, rgba(38, 46, 60, 0.6), transparent 72%),
      repeating-linear-gradient(98deg, rgba(255, 255, 255, 0.012) 0 2px, transparent 2px 5px),
      linear-gradient(162deg, #2b313d 0%, #181c25 46%, #0f1219 100%);
    border: 1px solid rgba(0, 0, 0, 0.6);
    box-shadow: 0 64px 120px -44px rgba(0, 0, 0, 0.92), inset 0 2px 0 rgba(255, 255, 255, 0.14), inset 0 -5px 12px rgba(0, 0, 0, 0.6), inset 0 0 0 1px rgba(120, 160, 210, 0.05);
    transition: filter 600ms ease, box-shadow 600ms ease;
  }
  .sd[data-powered="off"] .sd-console { filter: brightness(0.9) saturate(0.82); }
  .sd[data-booted="on"] .sd-console { box-shadow: 0 64px 120px -44px rgba(0, 0, 0, 0.92), inset 0 2px 0 rgba(255, 255, 255, 0.14), inset 0 -5px 12px rgba(0, 0, 0, 0.6), inset 0 0 0 1px rgba(0, 255, 77, 0.13), 0 0 64px -30px rgba(0, 255, 77, 0.32); }

  .sd-bolt { position: absolute; width: 11px; height: 11px; border-radius: 50%; background: radial-gradient(circle at 38% 32%, #535a67, #14171d); box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.55), 0 1px 0 rgba(255, 255, 255, 0.06); }
  .sd-bolt::after { content: ""; position: absolute; inset: 3px; border-top: 1px solid rgba(0, 0, 0, 0.5); transform: rotate(40deg); }
  .sd-b-tl { top: 15px; left: 15px; } .sd-b-tr { top: 15px; right: 15px; } .sd-b-bl { bottom: 13px; left: 15px; } .sd-b-br { bottom: 13px; right: 15px; }

  /* top bar — wordmark etched into the casing */
  .sd-top { display: flex; align-items: center; gap: 13px; padding: 2px 14px 14px; }
  .sd-brand { flex: 1; font-family: ui-monospace, "SF Mono", SFMono-Regular, Menlo, monospace; font-weight: 700; font-size: 16px; letter-spacing: 0.06em;
    color: #20242c; text-shadow: 0 1px 0 rgba(255, 255, 255, 0.13), 0 -1px 1px rgba(0, 0, 0, 0.7); }
