  }

  /* ── the access console ── */
  .sd-console {
    position: relative; width: min(1080px, 94vw); border-radius: 26px; padding: clamp(15px, 1.7vw, 24px) clamp(17px, 1.9vw, 28px) clamp(13px, 1.5vw, 20px);
    cursor: default;
    background:
      radial-gradient(78% 64% at 50% 18%, rgba(38, 46, 60, 0.6), transparent 72%),
      repeating-linear-gradient(98deg, rgba(255, 255, 255, 0.012) 0 2px, transparent 2px 5px),
      linear-gradient(162deg, #2b313d 0%, #181c25 46%, #0f1219 100%);
    border: 1px solid rgba(0, 0, 0, 0.6);
    box-shadow: 0 64px 120px -44px rgba(0, 0, 0, 0.92), inset 0 2px 0 rgba(255, 255, 255, 0.14), inset 0 -5px 12px rgba(0, 0, 0, 0.6), inset 0 0 0 1px rgba(120, 160, 210, 0.05);
    transition: filter 600ms ease, box-shadow 600ms ease;
  }
  .sd[data-powered="off"] .sd-console { filter: brightness(0.9) saturate(0.82); }
  .sd[data-booted="on"] .sd-console { box-shadow: 0 64px 120px -44px rgba(0, 0, 0, 0.92), inset 0 2px 0 rgba(255, 255, 255, 0.14), inset 0 -5px 12px rgba(0, 0, 0, 0.6), inset 0 0 0 1px rgba(0, 255, 77, 0.13), 0 0 64px -30px rgba(0, 255, 77, 0.32); }

  .sd-bolt { position: absolute; width: 11px; height: 11px; border-radius: 50%; background: radial-gradient(circle at 38% 32%, #535a67, #14171d); box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.55), 0 1px 0 rgba(255, 255, 255, 0.06); }
  .sd-bolt::after { content: ""; position: absolute; inset: 3px; border-top: 1px solid rgba(0, 0, 0, 0.5); transform: rotate(40deg); }
  .sd-b-tl { top: 15px; left: 15px; } .sd-b-tr { top: 15px; right: 15px; } .sd-b-bl { bottom: 13px; left: 15px; } .sd-b-br { bottom: 13px; right: 15px; }

  /* top bar — wordmark etched into the casing */
  .sd-top { display: flex; align-items: center; gap: 13px; padding: 2px 14px 14px; }
  .sd-brand { flex: 1; font-family: ui-monospace, "SF Mono", SFMono-Regular, Menlo, monospace; font-weight: 700; font-size: 16px; letter-spacing: 0.06em;
    color: #20242c; text-shadow: 0 1px 0 rgba(255, 255, 255, 0.13), 0 -1px 1px rgba(0, 0, 0, 0.7); }
  .sd-brand-dot { color: #14525e; text-shadow: 0 1px 0 rgba(120, 230, 255, 0.18), 0 -1px 1px rgba(0, 0, 0, 0.6); }
  .sd[data-booted="on"] .sd-brand-dot { color: #1c6c7a; }
  .sd-top-tag { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 8.5px; letter-spacing: 0.18em; text-transform: uppercase; color: #1c2129; text-shadow: 0 1px 0 rgba(255, 255, 255, 0.08); }
  .sd-lock { display: inline-flex; color: rgba(20, 24, 30, 0.9); filter: drop-shadow(0 1px 0 rgba(255, 255, 255, 0.1)); transition: color 240ms ease; }
  .sd[data-booted="on"] .sd-lock { color: rgba(14, 196, 252, 0.8); filter: none; }

  /* the cool dedicated power button */
  .sd-power { position: relative; width: clamp(50px, 4.8vw, 60px); aspect-ratio: 1; border-radius: 50%; flex: 0 0 auto; cursor: pointer; display: grid; place-items: center; border: 1px solid rgba(0, 0, 0, 0.72); padding: 0;
    background: radial-gradient(circle at 50% 36%, #2c333e 0%, #171b22 58%, #0b0e13 100%);
    box-shadow: 0 6px 14px -3px rgba(0, 0, 0, 0.72), inset 0 2px 1px rgba(255, 255, 255, 0.22), inset 0 -6px 11px rgba(0, 0, 0, 0.78), inset 0 0 0 1px rgba(120, 160, 210, 0.06);
    transition: transform 90ms ease, box-shadow 240ms ease; }
  .sd-power-bezel { position: absolute; inset: -3px; border-radius: 50%; z-index: -1; background: conic-gradient(from 130deg, #474e5b, #15181e 24%, #474e5b 50%, #15181e 74%, #474e5b); box-shadow: 0 2px 7px rgba(0, 0, 0, 0.6); }
  .sd-power-ring { position: absolute; inset: 6px; border-radius: 50%; border: 1.6px solid rgba(255, 142, 46, 0.5); box-shadow: 0 0 10px rgba(255, 142, 46, 0.4), inset 0 0 9px rgba(255, 142, 46, 0.28); transition: border-color 280ms ease, box-shadow 280ms ease; }
  .sd[data-powered="off"] .sd-power-ring { animation: sd-standby 1.9s ease-in-out infinite; }
  @keyframes sd-standby { 0%, 100% { opacity: 0.46; } 50% { opacity: 1; } }
  .sd-power-glyph { width: 42%; height: 42%; fill: none; stroke: rgba(255, 150, 60, 0.92); stroke-width: 2.3; stroke-linecap: round; z-index: 1; transition: stroke 280ms ease, filter 280ms ease; }
  .sd[data-powered="on"] .sd-power { box-shadow: 0 6px 14px -3px rgba(0, 0, 0, 0.72), inset 0 2px 1px rgba(255, 255, 255, 0.22), inset 0 -6px 11px rgba(0, 0, 0, 0.78), 0 0 22px -4px rgba(14, 196, 252, 0.7); }
  .sd[data-powered="on"] .sd-power-ring { border-color: rgba(14, 196, 252, 0.85); box-shadow: 0 0 16px rgba(14, 196, 252, 0.7), inset 0 0 11px rgba(14, 196, 252, 0.45); }
  .sd[data-powered="on"] .sd-power-glyph { stroke: #cdf4ff; filter: drop-shadow(0 0 6px rgba(14, 196, 252, 0.95)); }
  .sd-power:hover { transform: translateY(-1px); }
  .sd-power:active { transform: translateY(2px) scale(0.97); box-shadow: inset 0 4px 9px rgba(0, 0, 0, 0.85), inset 0 0 0 1px rgba(120, 160, 210, 0.06); }
  .sd-power:focus-visible { outline: none; box-shadow: 0 0 0 3px rgba(14, 196, 252, 0.5), inset 0 2px 1px rgba(255, 255, 255, 0.22); }

  .sd-body { display: flex; align-items: stretch; gap: clamp(12px, 1.4vw, 18px); }

  /* the five vault-terminal CRTs — wake slowly, like old bulbs */
  .sd-strip { display: flex; flex-direction: column; gap: clamp(8px, 1vw, 12px); flex: 0 0 auto; cursor: help; border-radius: 10px; }
  .sd-strip:focus-visible { outline: none; }
  .sd-strip:focus-visible .sd-crt { box-shadow: inset 0 0 0 1px rgba(14, 196, 252, 0.6), inset 0 3px 10px rgba(0,0,0,.85); }
  .sd-crt { position: relative; flex: 1 1 0; min-height: 56px; width: clamp(66px, 7vw, 88px); border-radius: 12px; overflow: hidden; display: grid; place-items: center;
    background: radial-gradient(120% 120% at 50% 30%, #0a160e, #050b07 70%, #030604);
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.8), inset 0 3px 10px rgba(0, 0, 0, 0.85), inset 0 0 22px rgba(0, 0, 0, 0.7);
    transition: box-shadow 1.6s ease calc(1s + var(--bd, 0s)); }
  .sd-crt-emoji { position: relative; z-index: 2; font-size: clamp(28px, 3.1vw, 38px); line-height: 1; opacity: 0; filter: grayscale(0.6) brightness(0.4); }
  /* the emoji panels hold dark, then ~2s after the borders land they warm up like
     old bulbs — slow (3.5s), catching a couple of times, staggered down the stack */
  .sd[data-booted="on"] .sd-crt-emoji {
    filter: blur(0.45px) saturate(1.08) contrast(1.04) brightness(0.68)
      drop-shadow(0.5px 0 0 rgba(255, 70, 70, 0.22)) drop-shadow(-0.5px 0 0 rgba(70, 170, 255, 0.22)) drop-shadow(0 0 4px rgba(43, 255, 136, 0.24));
    animation: sd-bulb 3.5s ease-out calc(1s + var(--bd, 0s)) both, sd-analog 5s steps(1) calc(1s + var(--bd, 0s) + 3.7s) infinite; }
  @keyframes sd-bulb {
    0% { opacity: 0; } 12% { opacity: 0.13; } 16% { opacity: 0.03; }
    31% { opacity: 0.34; } 36% { opacity: 0.08; } 54% { opacity: 0.66; } 60% { opacity: 0.44; }
    100% { opacity: 1; } }
  @keyframes sd-analog { 0%, 92%, 100% { opacity: 1; } 93% { opacity: 0.82; } 95% { opacity: 1; } 97% { opacity: 0.9; } }
  .sd-crt-scan { position: absolute; inset: 0; z-index: 3; pointer-events: none; opacity: 0; background: repeating-linear-gradient(0deg, rgba(43, 255, 136, 0.08) 0 1px, transparent 1px 3px); transition: opacity 1.6s ease calc(1s + var(--bd, 0s)); mix-blend-mode: screen; }
  .sd[data-booted="on"] .sd-crt-scan { opacity: 1; }
  .sd-crt-vig { position: absolute; inset: 0; z-index: 4; pointer-events: none; border-radius: 12px; background: radial-gradient(120% 100% at 50% 38%, transparent 50%, rgba(0, 0, 0, 0.58)); box-shadow: inset 0 0 20px rgba(0, 0, 0, 0.65); }
  .sd-crt::after { content: ""; position: absolute; inset: 0; z-index: 5; pointer-events: none; border-radius: 12px; background: radial-gradient(60% 36% at 38% 18%, rgba(255, 255, 255, 0.14), transparent 60%); }
  .sd[data-booted="on"] .sd-crt { box-shadow: inset 0 0 0 1px rgba(43, 255, 136, 0.16), inset 0 3px 10px rgba(0, 0, 0, 0.85), inset 0 0 26px rgba(43, 255, 136, 0.08); transition: box-shadow 1.6s ease calc(1s + var(--bd, 0s)); }
  .sd[data-booted="on"] .sd-crt::before { content: ""; position: absolute; inset: 0; z-index: 1; opacity: 0; background: radial-gradient(80% 70% at 50% 60%, rgba(43, 255, 136, 0.11), transparent 72%); animation: sd-bulbwash 3.5s ease-out calc(1s + var(--bd, 0s)) forwards; }
  @keyframes sd-bulbwash { 0% { opacity: 0; } 50% { opacity: 0.36; } 100% { opacity: 1; } }
  /* the sound screen: identical to the others until you hover — and its glow stays
     inside the glass (all-inset, no outer bleed onto the casing) */
  .sd[data-decoding="true"] .sd-crt-sound { box-shadow: inset 0 0 0 1.5px rgba(14, 196, 252, 0.9), inset 0 3px 10px rgba(0, 0, 0, 0.6), inset 0 0 52px rgba(14, 196, 252, 0.62); transition: box-shadow 240ms ease; }
  .sd[data-decoding="true"] .sd-crt-sound::before { opacity: 1; background: radial-gradient(80% 74% at 50% 52%, rgba(120, 230, 255, 0.55), rgba(14, 196, 252, 0.3) 48%, transparent 74%); }
  .sd[data-decoding="true"] .sd-crt-sound .sd-crt-emoji { filter: brightness(1.16) drop-shadow(0 0 10px rgba(120, 230, 255, 0.85)); transform: scale(1.06); transition: filter 240ms ease, transform 240ms ease; }

  .sd-right { flex: 1 1 auto; display: flex; flex-direction: column; gap: clamp(10px, 1.2vw, 16px); min-width: 0; }

  /* the two big screens — vault-terminal CRT glass (fallout) */
  .sd-screen { position: relative; border-radius: 14px; overflow: hidden;
    background: radial-gradient(120% 116% at 50% 24%, #0a160e, #050b07 72%, #030604);
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.8), inset 0 3px 13px rgba(0, 0, 0, 0.84), inset 0 0 28px rgba(0, 0, 0, 0.62);
    transition: box-shadow 500ms ease; }
  .sd-screen::before { content: ""; position: absolute; inset: 0; z-index: 6; pointer-events: none; opacity: 0; transition: opacity 500ms ease; background: repeating-linear-gradient(0deg, rgba(43, 255, 136, 0.055) 0 1px, transparent 1px 3px); mix-blend-mode: screen; }
  .sd[data-booted="on"] .sd-screen::before { opacity: 1; }
  .sd-screen::after { content: ""; position: absolute; inset: 0; z-index: 7; pointer-events: none; border-radius: 14px; background: radial-gradient(122% 104% at 50% 40%, transparent 52%, rgba(0, 0, 0, 0.52)); box-shadow: inset 0 0 26px rgba(0, 0, 0, 0.6); }
  .sd[data-booted="on"] .sd-screen { box-shadow: inset 0 0 0 1px rgba(43, 255, 136, 0.16), inset 0 3px 13px rgba(0, 0, 0, 0.84), inset 0 0 32px rgba(43, 255, 136, 0.06); }
  .sd-screen-label { position: absolute; top: 11px; left: 14px; z-index: 8; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 8px; letter-spacing: 0.24em; color: rgba(43, 255, 136, 0.1); transition: color 500ms ease; }
  .sd[data-booted="on"] .sd-screen-label { color: rgba(43, 255, 136, 0.46); }

  .sd-roll { position: absolute; left: 0; right: 0; top: -42%; height: 42%; z-index: 7; pointer-events: none; opacity: 0; background: linear-gradient(transparent, rgba(43, 255, 136, 0.12), transparent); }
  .sd[data-booted="on"] .sd-roll { animation: sd-roll 0.9s ease-out 0.04s; }
  @keyframes sd-roll { 0% { opacity: 0; transform: translateY(0); } 18% { opacity: 1; } 100% { opacity: 0; transform: translateY(280%); } }

  /* the border trace — one bright cyan LED line each side, slow + smooth */
  .sd-trace { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 9; pointer-events: none; overflow: visible; opacity: 0; transition: opacity 520ms ease; }
  [data-sd-trace][data-trace="draw"] .sd-trace { opacity: 1; }
  [data-sd-trace][data-trace="done"] .sd-trace { opacity: 0; }
  .sd-trace-l, .sd-trace-r { fill: none; stroke: #b9f3ff; stroke-width: 2.1; stroke-linecap: round; vector-effect: non-scaling-stroke;
    filter: drop-shadow(0 0 4px #19e0ff) drop-shadow(0 0 12px rgba(25, 224, 255, 0.9)) drop-shadow(0 0 22px rgba(25, 224, 255, 0.5));
    transition: stroke-dashoffset 1.2s cubic-bezier(0.62, 0, 0.2, 1); }

  /* code-entry screen — left-justified terminal column */
  .sd-screen-code { flex: 1 1 auto; min-height: clamp(230px, 32vh, 330px); display: flex; align-items: center; justify-content: flex-start; padding: clamp(26px, 3.4vw, 44px) clamp(30px, 4vw, 56px); }
  .sd-codewrap { position: relative; z-index: 2; display: flex; flex-direction: column; align-items: flex-start; gap: clamp(14px, 1.8vw, 22px); opacity: 0; transition: opacity 520ms ease 0.12s; }
  .sd[data-booted="on"] .sd-codewrap { opacity: 1; }
  .sd-prompt { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: clamp(11px, 1.2vw, 13px); letter-spacing: 0.24em; text-transform: uppercase; color: #34ff79; text-shadow: 0 0 7px rgba(0, 255, 77, 0.55); }
  .sd-prompt-txt { display: inline-block; overflow: hidden; white-space: nowrap; vertical-align: bottom; }
  .sd[data-booted="on"] .sd-prompt-txt { width: 0; animation: sd-type 1s steps(17) 0.34s forwards; }
  @keyframes sd-type { to { width: 17ch; } }
  .sd-tiles { display: inline-flex; align-items: center; gap: clamp(6px, 0.8vw, 10px); }
  .sd-tile { position: relative; width: clamp(30px, 3.2vw, 42px); height: clamp(40px, 4.3vw, 54px); border-radius: 5px; display: inline-flex; align-items: center; justify-content: center; font-family: "Space Grotesk Variable", "Space Grotesk", sans-serif; font-weight: 700; font-size: clamp(19px, 2.3vw, 27px); text-transform: lowercase; color: #bdf2cf; border: 1px solid rgba(43, 255, 136, 0.12); background: rgba(8, 18, 12, 0.32); transition: border-color 220ms ease, background 220ms ease, color 200ms ease; }
  /* empty cells: a faint terminal underscore */
  .sd-tile[data-lit="false"]::before { content: ""; position: absolute; left: 24%; right: 24%; bottom: 8px; height: 2px; border-radius: 1px; background: rgba(43, 255, 136, 0.2); transition: background 220ms ease, box-shadow 220ms ease; }
  .sd-tile[data-lit="true"] { border-color: rgba(0, 255, 77, 0.28); background: rgba(0, 255, 77, 0.045); color: #d8ffe4; text-shadow: 0 0 8px rgba(0, 255, 77, 0.6); animation: sd-pop 0.3s cubic-bezier(0.2, 1, 0.32, 1); }
  @keyframes sd-pop { 0% { transform: translateY(-3px) scale(1.1); } 100% { transform: none; } }
  /* the active cell: a soft green cursor — subtle, gently blinking (no bright fill) */
  .sd-tile[data-active="true"] { border-color: rgba(0, 255, 77, 0.34); background: rgba(0, 255, 77, 0.05); }
  .sd-tile[data-active="true"]::before { background: #34ff79; box-shadow: 0 0 8px rgba(0, 255, 77, 0.7); }
  .sd[data-booted="on"] .sd-tile[data-active="true"]::before { animation: sd-curblink 1.15s ease-in-out infinite; }
  @keyframes sd-curblink { 0%, 100% { opacity: 1; } 50% { opacity: 0.22; } }
  .sd[data-shake="1"] .sd-tiles { animation: sd-shake 0.34s cubic-bezier(0.36, 0.07, 0.19, 0.97); }
  @keyframes sd-shake { 10%, 90% { transform: translateX(-1px); } 20%, 80% { transform: translateX(2px); } 30%, 50%, 70% { transform: translateX(-4px); } 40%, 60% { transform: translateX(4px); } }
  .sd-input { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 10; opacity: 0; border: 0; background: transparent; cursor: text; color: transparent; caret-color: transparent; font-size: 16px; }

  /* decode screen — garbled block that extinguishes into BENDER (left-justified) */
  .sd-screen-decode { flex: 0 0 auto; min-height: clamp(120px, 16vh, 158px); display: flex; align-items: center; justify-content: flex-start; padding: 18px clamp(30px, 4vw, 56px); cursor: help; }
  .sd-readout { position: relative; z-index: 2; display: flex; align-items: center; justify-content: flex-start; gap: clamp(5px, 0.7vw, 9px); opacity: 0; transition: opacity 380ms ease; }
  .sd[data-booted="on"] .sd-readout { opacity: 0.85; }
  .sd[data-booted="on"]:not([data-decoding="true"]) .sd-readout { animation: sd-garble 1.7s steps(1) infinite; }
  @keyframes sd-garble { 0%, 100% { opacity: 0.62; transform: translateX(0); } 19% { opacity: 0.46; } 33% { opacity: 0.66; transform: translateX(-2px); } 35% { transform: translateX(0); } 58% { opacity: 0.4; } 76% { opacity: 0.64; transform: translateX(2px); } 78% { transform: translateX(0); } }
  .sd[data-decoding="true"] .sd-readout { opacity: 1; }
  .sd-glyph { display: inline-flex; width: clamp(24px, 2.8vw, 34px); transform: skewX(-7deg) translateY(var(--oy, 0)); transition: transform 300ms cubic-bezier(0.3, 1, 0.32, 1); }
  .sd[data-decoding="true"] .sd-glyph { transform: skewX(-7deg) translateY(0); }
  .sd-glyph svg { width: 100%; height: auto; overflow: visible; }
  .sd-seg { stroke: rgba(0, 255, 77, 0.08); stroke-width: 8; stroke-linecap: round; transition: stroke 120ms linear; }
  /* garbled: every segment lit, dim + cold; resolved: only the true word, bright */
  .sd-seg[data-on="true"] { stroke: #1c7a3c; filter: none; }
  .sd[data-decoding="true"] .sd-seg[data-on="true"] { stroke: #9bffbf; filter: drop-shadow(0 0 5px rgba(0, 255, 77, 1)) drop-shadow(0 0 14px rgba(0, 255, 77, 0.65)); }
  .sd[data-decoding="true"] .sd-seg { transition: stroke 260ms ease; }

  .sd-foot { display: flex; align-items: center; gap: 12px; padding: 14px 14px 2px; }
  .sd-grille { width: 32px; height: 8px; border-radius: 2px; background: repeating-linear-gradient(90deg, rgba(245, 241, 232, 0.22) 0 1.5px, transparent 1.5px 4px); opacity: 0.55; }
  .sd-foot-tag { flex: 1; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 8.5px; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(245, 241, 232, 0.32); transition: color 300ms ease; }
  .sd[data-powered="off"] .sd-foot-tag { color: rgba(255, 142, 46, 0.6); }
  .sd-q { width: 22px; height: 22px; border-radius: 50%; display: none; align-items: center; justify-content: center; font-family: "Space Grotesk Variable", "Space Grotesk", sans-serif; font-weight: 700; font-size: 13px; color: rgba(245, 241, 232, 0.5); background: rgba(245, 241, 232, 0.04); border: 1px solid rgba(245, 241, 232, 0.2); cursor: pointer; transition: color 160ms ease, border-color 160ms ease, background 160ms ease; }
  .sd[data-decoded="true"] .sd-q { display: inline-flex; }
  .sd-q:hover, .sd-q:focus-visible { color: var(--brand-cyan); border-color: var(--brand-cyan); background: rgba(14, 196, 252, 0.08); outline: none; }
  .sd-q-ans { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 11px; letter-spacing: 0.12em; color: var(--brand-green); font-weight: 600; }

  @media (max-width: 760px) {
