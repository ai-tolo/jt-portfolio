<script>
  document.querySelectorAll(".sx").forEach((root) => {
    const frame = root.querySelector("[data-sx]");
    const brand = root.querySelector('[data-role="brand"]');
    const chip = root.querySelector(".sx-chip");
    const cueBtn = root.querySelector(".sx-cue");
    const cueAudio = root.querySelector('.sx-audio[data-mode="loop"]');
    const towers = Array.from(root.querySelectorAll(".sx-tower"));
    const playBtn = root.querySelector("[data-play]");
    const barEl = root.querySelector('[data-role="bar"]');
    const plate = root.querySelector('[data-role="plate"]');
    const viewTabs = Array.from(root.querySelectorAll("[data-view-tab]"));
    const views = Array.from(root.querySelectorAll("[data-view]"));
    const armBtn = root.querySelector("[data-arm]");
    const lcd = root.querySelector("[data-lcd]");
    const liveLane = root.querySelector(".sx-lane-live");
    const tray = root.querySelector("[data-tray]");
    const trayHint = root.querySelector("[data-tray-hint]");
    const arrPlayBtn = root.querySelector("[data-arr-play]");
    const gridHead = root.querySelector(".sx-grid-head");

    const DID = {
      drums: "drums — the same loop, chopped into a kit",
      keys: "keys — the same loop, repitched into chords",
      bass: "bass — the same loop, sunk into a bassline",
    };
    const FILES = {
      drums: "/case-studies/the-console/studio/drums.mp3",
      keys: "/case-studies/the-console/studio/keys.mp3",
      bass: "/case-studies/the-console/studio/bass.mp3",
    };
    // measured lane gains: drums anchor, sum = -18.6 LUFS / -1.3 dBTP
    const GAINS = { drums: 0.8035, keys: 0.4842, bass: 0.4842 };
    const LOOP = 8, BAR = 2;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // ── grow moment ──
    const grow = () => {
      if (frame.classList.contains("grown")) return;
      frame.classList.add("grown");
      if (brand) brand.textContent = "SIGNAL STUDIO";
    };
    if (reduce) grow();
    else if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver((es) => es.forEach((e) => {
        if (e.isIntersecting) { setTimeout(grow, 550); io.disconnect(); }
      }), { threshold: 0.55 });
      io.observe(frame);
    } else grow();

    // ── audio core: one clock ──
    let ctx = null, t0 = 0, raf = 0, started = false;
    const lanes = {};
    let grooveSeconds = 0;   // cumulative, for the stream-tab nudge
    let lastTickAt = 0;

    const claimStage = () => document.dispatchEvent(new CustomEvent("bench:play", { detail: { source: root } }));
    async function ensureCtx() {
      if (!ctx) ctx = new (window.AudioContext || window.webkitAudioContext)();
      if (ctx.state === "suspended") await ctx.resume();
    }
    async function loadLane(mode) {
      if (lanes[mode]) return lanes[mode];
      const res = await fetch(FILES[mode]);
      const buf = await ctx.decodeAudioData(await res.arrayBuffer());
      const gain = ctx.createGain();
      gain.gain.value = 0;
      gain.connect(ctx.destination);
      lanes[mode] = { gain, buffer: buf, source: null, live: false, muted: false, pendingAt: 0 };
      return lanes[mode];
    }
    function startSource(l, when) {
      if (l.source) { try { l.source.stop(); } catch (e) {} }
      const s = ctx.createBufferSource();
      s.buffer = l.buffer; s.loop = true; s.loopStart = 0; s.loopEnd = LOOP;
      s.connect(l.gain);
      const offset = ((when - t0) % LOOP + LOOP) % LOOP;
      s.start(when, offset);
      l.source = s;
    }
    function startClock() {
      t0 = ctx.currentTime + 0.06;
      Object.values(lanes).forEach((l) => startSource(l, t0));
      started = true;
      root.classList.add("playing");
      lastTickAt = 0;
      tick();
    }
    const nextBar = () => t0 + Math.ceil((ctx.currentTime - t0 + 0.02) / BAR) * BAR;

    async function arm(mode) {
      await ensureCtx();
      stopArrange();
      claimStage();
      const l = await loadLane(mode);
      const tower = towers.find((t) => t.dataset.mode === mode);
      const node = tower.querySelector("[data-node]");
      node.classList.add("armed");
      if (!started) {
        startClock();
        l.gain.gain.setValueAtTime(GAINS[mode], t0);
        l.live = true;
        tower.classList.add("live");
      } else {
        if (!l.source) startSource(l, ctx.currentTime + 0.03);
        const at = nextBar();
        l.pendingAt = at;
        node.classList.add("pending");
        l.gain.gain.setValueAtTime(GAINS[mode], at);
        l.live = true;
      }
      // the stream was listening — its lane now holds what you played
      const streamLane = root.querySelector(`.sx-lane[data-lane="${mode}"]`);
      if (streamLane) streamLane.classList.add("filled");
      if (plate) plate.textContent = DID[mode] || "";
      if (playBtn) playBtn.disabled = false;
      setCarry(false);
    }

    function stopGroove() {
      Object.values(lanes).forEach((l) => { if (l.source) { try { l.source.stop(); } catch (e) {} l.source = null; } });
      started = false;
      root.classList.remove("playing");
      cancelAnimationFrame(raf);
      towers.forEach((t) => {
        t.querySelectorAll(".sx-mech i").forEach((c) => c.classList.remove("hit"));
        const sub = t.querySelector(".sx-sub"); if (sub) sub.style.setProperty("--p", "0");
        const ph = t.querySelector(".sx-playhead"); if (ph) ph.style.left = "0%";
      });
      if (barEl) barEl.textContent = "stopped — press play";
    }
    function resumeGroove() {
      claimStage();
      stopArrange();
      t0 = ctx.currentTime + 0.06;
      Object.values(lanes).forEach((l) => { if (l.live) startSource(l, t0); });
      started = true;
      root.classList.add("playing");
      lastTickAt = 0;
      tick();
    }

    function tick() {
      if (!started || !ctx) return;
      const now = ctx.currentTime;
      if (now >= t0) {
        if (lastTickAt) grooveSeconds += now - lastTickAt;
        lastTickAt = now;
        if (grooveSeconds > 8) nudgeTab("stream");
        const pos = ((now - t0) % LOOP) / LOOP;
        const bar = Math.floor(((now - t0) % LOOP) / BAR) + 1;
        if (barEl) barEl.textContent = `bar ${bar} · 4`;
        towers.forEach((t) => {
          const mode = t.dataset.mode;
          const l = lanes[mode];
          if (!l || !l.live) return;
          const node = t.querySelector("[data-node]");
          if (l.pendingAt && now >= l.pendingAt) { l.pendingAt = 0; node.classList.remove("pending"); t.classList.add("live"); }
          if (!t.classList.contains("live")) return;
          const ph = t.querySelector(".sx-playhead");
          if (ph) ph.style.left = (pos * 100).toFixed(2) + "%";
          if (mode === "drums") {
            const i = Math.min(15, Math.floor(pos * 16));
            t.querySelectorAll(".sx-mech-drums i").forEach((c, k) => c.classList.toggle("hit", k === i && !l.muted));
          } else if (mode === "keys") {
            const i = Math.min(3, Math.floor(pos * 4));
            t.querySelectorAll(".sx-mech-keys i").forEach((c, k) => c.classList.toggle("hit", k === i && !l.muted));
          } else if (mode === "bass") {
            const sub = t.querySelector(".sx-sub");
            if (sub) sub.style.setProperty("--p", l.muted ? "0" : pos.toFixed(3));
          }
          // stream lanes share the clock — the playhead sweeps there too
          const sl = root.querySelector(`.sx-lane[data-lane="${mode}"] .sx-lane-head`);
          if (sl) {
            const inset = sl.parentElement.getBoundingClientRect().width > 0 ? 56 : 56;
            sl.style.left = `calc(${inset}px + (100% - ${inset + 8}px) * ${pos.toFixed(3)})`;
          }
        });
      }
      raf = requestAnimationFrame(tick);
    }

    // ── views ──
    function setView(v) {
      views.forEach((el) => el.classList.toggle("on", el.dataset.view === v));
      viewTabs.forEach((t) => {
        const on = t.dataset.viewTab === v;
        t.classList.toggle("on", on);
        // selection is carried by ARIA too, not by the .on class alone
        t.setAttribute("aria-selected", on ? "true" : "false");
        if (on) t.classList.remove("nudge");
      });
    }
    const visited = new Set(["signal"]);
    viewTabs.forEach((t) => t.addEventListener("click", () => { visited.add(t.dataset.viewTab); setView(t.dataset.viewTab); }));
    function nudgeTab(v) {
      if (visited.has(v)) return;
      const t = viewTabs.find((x) => x.dataset.viewTab === v);
      if (t && !t.classList.contains("on")) t.classList.add("nudge");
    }

    // ── ARM / live-in (demonstrated) ──
    if (armBtn) armBtn.addEventListener("click", () => {
      const on = armBtn.getAttribute("aria-pressed") !== "true";
      armBtn.setAttribute("aria-pressed", String(on));
      if (lcd) lcd.textContent = on ? "listening" : "";
      if (liveLane) liveLane.classList.toggle("armed", on);
    });

    // ── STREAM · drag-to-grab ──
    const grabbed = [];
    root.querySelectorAll(".sx-lane[data-lane]:not(.sx-lane-live)").forEach((lane) => {
      const mode = lane.dataset.lane;
      const sel = lane.querySelector(".sx-lane-sel");
      let dragging = false, x0 = 0;
      const waveLeft = () => 56;
      const waveWidth = () => lane.getBoundingClientRect().width - waveLeft() - 8;
      const toBar = (clientX) => {
        const r = lane.getBoundingClientRect();
        const frac = Math.min(1, Math.max(0, (clientX - r.left - waveLeft()) / waveWidth()));
        return Math.min(3, Math.floor(frac * 4));
      };
      lane.addEventListener("pointerdown", (e) => {
        if (!lane.classList.contains("filled")) return;
        dragging = true; x0 = e.clientX;
        lane.setPointerCapture(e.pointerId);
        sel.classList.add("on");
        paintSel(e.clientX);
      });
      const paintSel = (x1) => {
        const a = Math.min(toBar(x0), toBar(x1));
        const b = Math.max(toBar(x0), toBar(x1));
        const left = waveLeft() + (a / 4) * waveWidth();
        const width = ((b - a + 1) / 4) * waveWidth();
        sel.style.left = left + "px";
        sel.style.width = width + "px";
        sel.dataset.a = String(a);
        sel.dataset.b = String(b);
      };
      lane.addEventListener("pointermove", (e) => { if (dragging) paintSel(e.clientX); });
      lane.addEventListener("pointerup", () => {
        if (!dragging) return;
        dragging = false;
        const a = Number(sel.dataset.a || 0), b = Number(sel.dataset.b || 0);
        sel.classList.remove("on");
        makeChip(mode, a, b - a + 1);
      });
      lane.addEventListener("pointercancel", () => { dragging = false; sel.classList.remove("on"); });
    });

    function makeChip(mode, startBar, lenBars) {
      if (grabbed.length >= 6) return;
      const id = `${mode}-${startBar}-${lenBars}-${grabbed.length}`;
      grabbed.push({ id, mode, startBar, lenBars });
      const el = document.createElement("button");
      el.type = "button";
      el.className = "sx-loopchip";
      el.dataset.lcMode = mode;
      el.dataset.lcId = id;
      el.innerHTML = `<i></i>${mode} · bar${lenBars > 1 ? "s" : ""} ${startBar + 1}${lenBars > 1 ? "–" + (startBar + lenBars) : ""}`;
      el.setAttribute("aria-label", `grabbed loop: ${mode}, ${lenBars} bar${lenBars > 1 ? "s" : ""} — carry it to the arrange grid`);
      if (trayHint) trayHint.textContent = "drop them on the grid →";
      tray.appendChild(el);
      nudgeTab("arrange");
      // grab feedback: play the slice once (only if the groove is quiet)
      if (!started && ctx && lanes[mode]) {
        claimStage();
        const l = lanes[mode];
        const s = ctx.createBufferSource();
        s.buffer = l.buffer;
        s.connect(l.gain);
        l.gain.gain.setValueAtTime(GAINS[mode], ctx.currentTime);
        s.start(ctx.currentTime + 0.02, startBar * BAR, lenBars * BAR);
      }
      // chip carry (tap to pick up, tap a cell to place)
      el.addEventListener("click", () => {
        const on = !el.classList.contains("carry");
        tray.querySelectorAll(".sx-loopchip").forEach((c) => c.classList.remove("carry"));
        el.classList.toggle("carry", on);
        root.classList.toggle("chipcarry", on);
        if (on) root.dataset.carrymode = mode; else delete root.dataset.carrymode;
        carriedChip = on ? { id, mode, startBar, lenBars, el } : null;
      });
    }

    // ── ARRANGE · place blocks, sequence them ──
    let carriedChip = null;
    const placed = [];  // {mode, srcBar, lenBars, destBar, el}
    root.querySelectorAll("[data-grow]").forEach((row) => {
      const rowMode = row.dataset.grow;
      row.querySelectorAll("[data-cell]").forEach((cell) => {
        cell.addEventListener("pointerenter", () => { if (carriedChip && carriedChip.mode === rowMode) cell.classList.add("over"); });
        cell.addEventListener("pointerleave", () => cell.classList.remove("over"));
        cell.addEventListener("click", () => {
          if (!carriedChip || carriedChip.mode !== rowMode) return;
          const destBar = Number(cell.dataset.cell);
          const len = Math.min(carriedChip.lenBars, 8 - destBar);
          placeBlock(row, carriedChip.mode, carriedChip.startBar, len, destBar);
          carriedChip.el.classList.remove("carry");
          root.classList.remove("chipcarry");
          delete root.dataset.carrymode;
          carriedChip = null;
          cell.classList.remove("over");
        });
      });
    });
    function placeBlock(row, mode, srcBar, lenBars, destBar) {
      const el = document.createElement("span");
      el.className = "sx-block";
      el.style.left = `calc(${(destBar / 8) * 100}% + 1px)`;
      el.style.width = `calc(${(lenBars / 8) * 100}% - 2px)`;
      el.textContent = mode;
      el.title = "remove";
      const rec = { mode, srcBar, lenBars, destBar, el };
      placed.push(rec);
      el.addEventListener("click", () => {
        const i = placed.indexOf(rec);
        if (i >= 0) placed.splice(i, 1);
        el.remove();
        if (arrPlayBtn) arrPlayBtn.disabled = placed.length === 0;
      });
      row.appendChild(el);
      if (arrPlayBtn) arrPlayBtn.disabled = false;
    }

    let arrSources = [], arrRaf = 0, arrT0 = 0, arrPlaying = false, arrStopTimer = 0;
    async function playArrange() {
      await ensureCtx();
      stopGroove();
      claimStage();
      // make sure every placed mode is decoded
      for (const rec of placed) await loadLane(rec.mode);
      arrT0 = ctx.currentTime + 0.08;
      arrSources = placed.map((rec) => {
        const l = lanes[rec.mode];
        const s = ctx.createBufferSource();
        s.buffer = l.buffer;
        const g = ctx.createGain();
        g.gain.value = GAINS[rec.mode];
        s.connect(g); g.connect(ctx.destination);
        s.start(arrT0 + rec.destBar * BAR, rec.srcBar * BAR, rec.lenBars * BAR);
        return s;
      });
      arrPlaying = true;
      root.classList.add("arrplaying");
      const total = 8 * BAR;
      const sweep = () => {
        if (!arrPlaying) return;
        const p = Math.min(1, (ctx.currentTime - arrT0) / total);
        if (gridHead && p >= 0) gridHead.style.left = (p * 100).toFixed(2) + "%";
        arrRaf = requestAnimationFrame(sweep);
      };
      arrRaf = requestAnimationFrame(sweep);
      arrStopTimer = window.setTimeout(stopArrange, (total + 0.3) * 1000);
    }
    function stopArrange() {
      if (!arrPlaying) return;
      arrPlaying = false;
      window.clearTimeout(arrStopTimer);
      arrSources.forEach((s) => { try { s.stop(); } catch (e) {} });
      arrSources = [];
      cancelAnimationFrame(arrRaf);
      root.classList.remove("arrplaying");
      if (gridHead) gridHead.style.left = "0%";
    }
    if (arrPlayBtn) arrPlayBtn.addEventListener("click", () => { arrPlaying ? stopArrange() : playArrange(); });

    // ── the MIDI voice beat (demonstrated) ──
    towers.filter((t) => t.dataset.mode === "bass").forEach((tower) => {
      const btn = tower.querySelector("[data-voice-btn]");
      const stateEl = tower.querySelector("[data-voice-state]");
      const notes = Array.from(tower.querySelectorAll(".sx-vnotes i"));
      if (!btn) return;
      btn.addEventListener("click", () => {
        if (reduce) {
          tower.dataset.voiced = "true";
          if (plate) plate.textContent = "the studio played the synth over MIDI and mapped the return across the keys";
          return;
        }
        tower.dataset.voicing = "true";
        if (stateEl) stateEl.textContent = "playing the synth over MIDI…";
        notes.forEach((n, i) => setTimeout(() => n.classList.add("hit"), 300 + i * 340));
        setTimeout(() => { if (stateEl) stateEl.textContent = "sampling the return…"; }, 2100);
        setTimeout(() => { if (stateEl) stateEl.textContent = "onset-trim → 12 zones"; }, 3100);
        setTimeout(() => {
          tower.dataset.voicing = "false";
          tower.dataset.voiced = "true";
          if (plate) plate.textContent = "the studio played the synth over MIDI and mapped the return across the keys — velocity and all";
        }, 4100);
      });
    });

    // ── carry / drop (the found sound → towers) ──
    let carrying = false;
    function setCarry(on) { carrying = on; if (chip) chip.classList.toggle("carry", on); root.classList.toggle("carrying", on); }
    if (chip) {
      chip.addEventListener("dragstart", (e) => {
        chip.classList.add("dragging");
        if (e.dataTransfer) { e.dataTransfer.setData("text/plain", "src"); e.dataTransfer.effectAllowed = "copy"; }
      });
      chip.addEventListener("dragend", () => chip.classList.remove("dragging"));
      chip.addEventListener("click", () => setCarry(!carrying));
    }
    towers.forEach((tower) => {
      const node = tower.querySelector("[data-node]");
      const mode = tower.dataset.mode;
      node.addEventListener("dragover", (e) => { e.preventDefault(); node.classList.add("over"); });
      node.addEventListener("dragleave", () => node.classList.remove("over"));
      node.addEventListener("drop", (e) => { e.preventDefault(); node.classList.remove("over"); arm(mode); });
      node.addEventListener("click", () => { if (carrying) arm(mode); });
      const mute = tower.querySelector("[data-mute]");
      mute.addEventListener("click", () => {
        const l = lanes[mode];
        if (!l || !ctx) return;
        l.muted = !l.muted;
        l.gain.gain.setTargetAtTime(l.muted ? 0 : GAINS[mode], ctx.currentTime, 0.015);
        tower.classList.toggle("muted", l.muted);
        mute.setAttribute("aria-pressed", String(l.muted));
      });
    });

    if (playBtn) playBtn.addEventListener("click", async () => {
      await ensureCtx();
      if (started) stopGroove();
      else resumeGroove();
    });

    // ── the sidebar cue ──
    if (cueBtn && cueAudio) {
      cueAudio.volume = 0.9;
      cueBtn.addEventListener("click", () => {
        if (!cueAudio.paused) { cueAudio.pause(); cueAudio.currentTime = 0; return; }
        if (started) stopGroove();
        stopArrange();
        claimStage();
        cueAudio.currentTime = 0;
        const p = cueAudio.play(); if (p && p.catch) p.catch(() => {});
      });
      cueAudio.addEventListener("play", () => cueBtn.classList.add("on"));
      cueAudio.addEventListener("pause", () => cueBtn.classList.remove("on"));
      cueAudio.addEventListener("ended", () => cueBtn.classList.remove("on"));
    }

    // one audio stage page-wide
    document.addEventListener("bench:play", (e) => {
      if (!e.detail || e.detail.source === root) return;
      if (started) stopGroove();
      stopArrange();
      if (cueAudio && !cueAudio.paused) cueAudio.pause();
    });
    if ("IntersectionObserver" in window) {
      new IntersectionObserver((es) => es.forEach((e) => {
        if (!e.isIntersecting) { if (started) stopGroove(); stopArrange(); }
      }), { threshold: 0.05 }).observe(root);
    }
  });
</script>
