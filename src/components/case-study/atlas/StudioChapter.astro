---
// CH 2 · PLAY, DON'T FIDDLE — Signal Studio as the working system it is, told
// in one frame with the real app's three views:
//
//   SIGNAL  — the instrument. The homepage toy grows into three engine towers;
//             drop the found sound and lanes enter the groove ON THE BAR. Plus
//             the topbar ARM cluster (line-in, demonstrated) and the MIDI voice
//             beat: the studio plays a real synth over MIDI, samples the return,
//             and maps it into a velocity-aware zone voice (demonstrated).
//   STREAM  — the reveal: it was listening the whole time. The lanes already
//             hold the four bars you just played. Drag across a lane and the
//             selection snaps to bars and becomes a loop chip — the real
//             product's grab gesture, with real audio (the slice plays).
//   ARRANGE — Lego blocks into stems: grabbed chips drop onto an 8-bar grid,
//             snap, and PLAY sequences the actual buffer slices on the same
//             clock. The action row is the real page's: print stems · keep ·
//             send to Ableton · engineer ↗ (the handoff into chapter 3).
//
// All waveforms are the real geometry of the real renders (waves.ts, made by
// the studio's own samplers). One Web Audio clock; no autoplay; one page-wide
// audio stage (bench:play). Reduced-motion: the morph and sequences are
// instant, playheads stay (information).
import { WAVE_LOOP, WAVE_DRUMS, WAVE_KEYS, WAVE_BASS, DRUM_STEPS } from "./waves";

const CLIP = "/case-studies/the-console/studio";
const TOWERS = [
  { mode: "drums", label: "DRUMS", wave: WAVE_DRUMS },
  { mode: "keys",  label: "KEYS",  wave: WAVE_KEYS },
  { mode: "bass",  label: "BASS",  wave: WAVE_BASS },
];
const LANES = [
  { mode: "drums", label: "drums", wave: WAVE_DRUMS },
  { mode: "keys",  label: "keys",  wave: WAVE_KEYS },
  { mode: "bass",  label: "bass",  wave: WAVE_BASS },
];
const CHORDS = ["C", "Am", "F", "G"];
const KEYCAPS = ["a", "s", "d", "f", "g", "h", "j", "k"];
const GEAR = ["Bass Station II", "MODX", "TR-8S"];
const VOICE_NOTES = ["C1", "G1", "C2", "G2", "C3"];
import Transport from "../../Transport.astro";
---

<section class="sx cs-bleed" aria-label="the Studio — the working system">
  <p class="sx-origin">Built first as the instrument on this site's homepage — then it demanded a room of its own.</p>
  <p class="sx-direction">The studio has a law now: a jam is not a song, and the room knows the difference.
  Everything it grows — drums, bass, chords, effects — grows toward the moment a loop earns its way into a track.</p>

  <div class="sx-frame" data-sx>
    <!-- sidebar: the library -->
    <aside class="sx-side" aria-label="library">
      <span class="sx-side-h">library</span>
      <button type="button" class="sx-chip" draggable="true" aria-label="head to toe, the found loop — carry it to an engine">
        <span class="sx-chip-was" aria-hidden="true">Audio 14.m4a</span>
        <svg class="sx-chip-wave" viewBox="0 0 72 40" preserveAspectRatio="none" aria-hidden="true"><path d={WAVE_LOOP} /></svg>
        <span class="sx-chip-name">head to toe</span>
      </button>
      <button type="button" class="sx-cue" aria-label="hear the loop, untouched">
        <svg class="c-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5 v14 l11 -7 z"/></svg>
        <svg class="c-stop" viewBox="0 0 24 24" aria-hidden="true"><path d="M6.5 6.5 h11 v11 h-11 z"/></svg>
        <span>the loop · 0:04</span>
      </button>
      <div class="sx-fresh" aria-hidden="true">
        <span class="sx-fresh-h">fresh</span>
        <span class="sx-fresh-row">walking note.m4a</span>
        <span class="sx-fresh-row">rain outside.m4a</span>
      </div>
      <span class="sx-side-hint" aria-hidden="true">drag it onto an engine</span>
      <a class="sx-side-eng" href="#engineer">engineer ↗</a>
    </aside>

    <div class="sx-main">
      <!-- topbar: live view tabs + the ARM cluster -->
      <div class="sx-top">
        <div class="sx-tabs" role="tablist" aria-label="studio view">
          <button type="button" class="sx-tab on" role="tab" aria-selected="true" data-view-tab="signal">signal</button>
          <button type="button" class="sx-tab" role="tab" aria-selected="false" data-view-tab="stream">stream<i class="sx-nudge" aria-hidden="true"></i></button>
          <button type="button" class="sx-tab" role="tab" aria-selected="false" data-view-tab="arrange">arrange<i class="sx-nudge" aria-hidden="true"></i></button>
        </div>
        <span class="sx-brand" data-role="brand">the homepage instrument</span>
        <span class="sx-armwrap">
          <button type="button" class="sx-arm" data-arm aria-pressed="false" aria-label="arm the line-in (demonstrated)">arm</button>
          <span class="sx-lcd" data-lcd aria-hidden="true"></span>
        </span>
      </div>

      <!-- ═══ VIEW · SIGNAL ═══ -->
      <div class="sx-view sx-view-signal on" data-view="signal">
        <div class="sx-towers">
          {TOWERS.map((t) => (
            <div class={`sx-tower tw-${t.mode}`} data-mode={t.mode}>
              <button type="button" class="sx-node" data-node aria-label={`${t.label} — drop the loop here`}>
                <span class="sx-node-empty" aria-hidden="true">drop</span>
                <span class="sx-node-name" aria-hidden="true">head to toe</span>
              </button>
              <span class="sx-tower-name">{t.label}</span>
              <span class="sx-screen">
                <svg class="sx-wave" viewBox="0 0 72 40" preserveAspectRatio="none" aria-hidden="true"><path d={t.wave} /></svg>
                <span class="sx-playhead" aria-hidden="true"></span>
              </span>
              {t.mode === "drums" && (
                <span class="sx-mech sx-mech-drums" aria-hidden="true">{DRUM_STEPS.map((v) => <i style={`--e:${v}`}></i>)}</span>
              )}
              {t.mode === "keys" && (
                <span class="sx-mech sx-mech-keys" aria-hidden="true">{CHORDS.map((c) => <i>{c}</i>)}</span>
              )}
              {t.mode === "bass" && (
                <span class="sx-mech sx-mech-bass" aria-hidden="true"><i class="sx-sub"></i><em>sub</em></span>
              )}
              <button type="button" class="sx-mute" data-mute aria-label={`mute ${t.label}`} aria-pressed="false">mute</button>
              {t.mode === "bass" && (
                <div class="sx-voicebay">
                  <button type="button" class="sx-voice-btn" data-voice-btn>render a voice · MIDI</button>
                  <span class="sx-voice-seq" data-voice-seq aria-hidden="true">
                    <span class="sx-vnotes">{VOICE_NOTES.map((n) => <i>{n}</i>)}</span>
                    <span class="sx-vstate" data-voice-state></span>
                  </span>
                  <span class="sx-voice-cart" data-voice-cart aria-hidden="true"><i></i>Bass Station II · 12 zones · velocity in</span>
                </div>
              )}
              {t.mode === "keys" && (
                <span class="sx-toyface" aria-hidden="true">
                  {KEYCAPS.map((k) => <i class="sx-keycap">{k}</i>)}
                </span>
              )}
            </div>
          ))}
        </div>
        <div class="sx-transport">
          <button type="button" class="sx-play" data-play aria-label="play or stop the groove" disabled>
            <svg class="c-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5 v14 l11 -7 z"/></svg>
            <svg class="c-stop" viewBox="0 0 24 24" aria-hidden="true"><path d="M6.5 6.5 h11 v11 h-11 z"/></svg>
          </button>
          <span class="sx-bar" data-role="bar">drop the loop to start</span>
          <span class="sx-bpm">120 bpm</span>
        </div>
      </div>

      <!-- ═══ VIEW · STREAM ═══ -->
      <div class="sx-view sx-view-stream" data-view="stream">
        <div class="sx-ruler" aria-hidden="true">
          {[1, 2, 3, 4].map((b) => <span>{b}</span>)}
        </div>
        <div class="sx-lanes">
          {LANES.map((l) => (
            <div class={`sx-lane ln-${l.mode}`} data-lane={l.mode} aria-label={`${l.label} lane — drag across it to grab a loop`}>
              <span class="sx-lane-tag">{l.label}</span>
              <svg class="sx-lane-wave" viewBox="0 0 72 40" preserveAspectRatio="none" aria-hidden="true"><path d={l.wave} /></svg>
              <span class="sx-lane-empty" aria-hidden="true">not played yet</span>
              <span class="sx-lane-sel" aria-hidden="true"></span>
              <span class="sx-lane-head" aria-hidden="true"></span>
            </div>
          ))}
          <div class="sx-lane sx-lane-live" data-lane="live" aria-label="live input lane">
            <span class="sx-lane-tag">live in<b>LIVE</b></span>
            <span class="sx-lane-meter" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span>
            <span class="sx-lane-empty" aria-hidden="true">arm to listen</span>
          </div>
        </div>
        <p class="sx-view-plate" data-stream-plate>always rolling — the jam is never lost. drag across a lane to grab a loop.</p>
      </div>

      <!-- ═══ VIEW · ARRANGE ═══ -->
      <div class="sx-view sx-view-arrange" data-view="arrange">
        <div class="sx-actions" aria-hidden="true">
          <span class="sx-act">print stems</span>
          <span class="sx-act">keep</span>
          <span class="sx-act">send to Ableton</span>
          <a class="sx-act sx-act-eng" href="#engineer" aria-hidden="false">engineer ↗</a>
        </div>
        <div class="sx-tray" data-tray>
          <span class="sx-tray-hint" data-tray-hint>grab loops in the stream view — they land here</span>
        </div>
        <div class="sx-gridwrap">
          <button type="button" class="sx-play sx-play-arr" data-arr-play aria-label="play the arrangement" disabled>
            <svg class="c-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5 v14 l11 -7 z"/></svg>
            <svg class="c-stop" viewBox="0 0 24 24" aria-hidden="true"><path d="M6.5 6.5 h11 v11 h-11 z"/></svg>
          </button>
          <div class="sx-grid" data-grid>
            <div class="sx-grid-ruler" aria-hidden="true">{[1, 2, 3, 4, 5, 6, 7, 8].map((b) => <span>{b}</span>)}</div>
            {["drums", "keys", "bass"].map((m) => (
              <div class={`sx-grow gr-${m}`} data-grow={m}>
                {[0, 1, 2, 3, 4, 5, 6, 7].map((c) => <span class="sx-cell" data-cell={String(c)}></span>)}
              </div>
            ))}
            <span class="sx-grid-head" aria-hidden="true"></span>
          </div>
        </div>
        <p class="sx-view-plate">blocks snap to bars — build the idea, then ship it.</p>
      </div>
    </div>
  </div>

  <p class="sx-plate" data-role="plate" aria-live="polite"></p>

  <div class="sx-gear">
    <p>A synth on a MIDI cable can become a voice: the studio plays it and samples what comes back.
    The round trip is real on my desk; making it one press is the current build.</p>
    <p class="sx-since" aria-hidden="false">Since this was written the room has kept growing:
    drums ripped from my own hardware with a sequencer that swings, and reverb, drive, and motion
    as lanes you perform rather than menus you set.</p>
    <div class="sx-gear-row" aria-hidden="true">
      <span class="sx-gear-label">the desk:</span>
      {GEAR.map((g) => (
        <span class="sx-cart"><i></i>{g}</span>
      ))}
    </div>
  </div>

  <div class="sx-handoff-wrap">
    <div class="sx-fourbars">
      <Transport src="/case-studies/the-console/studio/loop.mp3" peaks="loop"
        title="the four bars" accent="#8b6bff" compact />
    </div>
    <p class="sx-handoff">
      Four bars I'd keep — an idea that now deserves finishing.
      <a href="#engineer">send it to the engineer ↓</a>
    </p>
  </div>

  <audio class="sx-audio" data-mode="loop" preload="none" src={`${CLIP}/loop.mp3`}></audio>
</section>

{/* is:global (namespaced sx-*): the loop chips and arrange blocks are created
    at runtime with document.createElement, which never receives Astro's scope
    attribute — scoped styles would silently skip them (learned the hard way) */}
<style is:global>
  .sx-direction {
    max-width: 56ch;
    margin: 14px auto 0;
    font-family: "Space Grotesk Variable", "Space Grotesk", ui-sans-serif, system-ui, sans-serif;
    font-size: clamp(14px, 1.7vw, 16.5px);
    line-height: 1.6;
    color: var(--cs-text-muted);
  }
  .sx-since {
    max-width: 56ch;
    margin: 12px 0 0;
    /* the same running prose chapters 01 and 03 set flush left — it only
       inherited centring from the .sx-gear block */
    text-align: start;
    color: var(--cs-text-muted);
    font-size: 0.92em;
    line-height: 1.6;
  }
  .sx-gear-label {
    font-family: var(--cs-mono);
    font-size: 10.5px;
    letter-spacing: 0.08em;
    color: var(--cs-text-dim);
    margin-right: 4px;
  }
  .sx-fourbars {
    max-width: 560px;
    margin: 0 auto 14px;
  }
  .sx-handoff-wrap {
    margin-top: 30px;
  }

  .sx { --v: #8b6bff; position: relative; padding: 8px 24px 44px; }

  .sx .sx-origin {
    max-width: 52ch; margin: 0 auto 26px; text-align: center;
    font-family: var(--cs-mono); font-style: italic;
    font-size: clamp(13.5px, 1.6vw, 16px); line-height: 1.6; color: var(--cs-text-muted);
  }

  /* ── the frame ── */
  .sx-frame {
    display: flex; gap: 0; max-width: 1280px; margin: 0 auto;
    border-radius: 16px; border: 1px solid rgba(0, 0, 0, 0.6); isolation: isolate; overflow: hidden;
    background: radial-gradient(80% 60% at 50% 12%, rgba(139, 107, 255, 0.08), transparent 72%),
      linear-gradient(162deg, #221f2d 0%, #16131e 48%, #0d0b12 100%);
    box-shadow: 0 60px 110px -46px rgba(0, 0, 0, 0.92), inset 0 2px 0 rgba(255, 255, 255, 0.09), inset 0 -5px 12px rgba(0, 0, 0, 0.55);
    transition: max-width 0.9s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .sx-frame:not(.grown) { max-width: 560px; }

  /* sidebar */
  .sx-side {
    flex: 0 0 204px; display: flex; flex-direction: column; gap: 14px;
    padding: 18px 14px; border-right: 1px solid rgba(245, 241, 232, 0.08);
    background: rgba(0, 0, 0, 0.22);
    transition: margin-left 0.9s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.6s ease 0.25s;
  }
  .sx-frame:not(.grown) .sx-side { margin-left: -205px; opacity: 0; }
  .sx-side-h { font-family: var(--cs-mono); font-size: 9.5px; letter-spacing: 0.28em; text-transform: uppercase; color: rgba(245, 241, 232, 0.45); }
  .sx-chip {
    display: flex; flex-direction: column; align-items: center; gap: 7px;
    padding: 12px 12px 10px; border-radius: 10px; cursor: grab; color: var(--v);
    background: linear-gradient(160deg, #241f31, #14111b); border: 1px solid rgba(139, 107, 255, 0.42);
    box-shadow: 0 0 20px -10px var(--v), inset 0 1px 0 rgba(255, 255, 255, 0.06);
    transition: transform 0.14s ease, box-shadow 0.25s ease;
  }
  .sx-chip:hover { transform: translateY(-2px); box-shadow: 0 0 26px -6px var(--v); }
  .sx-chip:active { cursor: grabbing; }
  .sx-chip.carry { transform: translateY(-2px) scale(1.03); box-shadow: 0 0 30px -4px var(--v); }
  .sx-chip.dragging { opacity: 0.4; }
  .sx-chip:focus-visible { outline: 2px solid var(--v); outline-offset: 3px; }
  .sx-chip-was { font-family: var(--cs-mono); font-size: 9px; color: rgba(245, 241, 232, 0.34);
    text-decoration: line-through; text-decoration-color: rgba(255, 90, 60, 0.55); }
  .sx-chip-wave { width: 100%; height: 26px; fill: rgba(139, 107, 255, 0.45); }
  .sx-chip-name { font-family: var(--cs-mono); font-size: 12px; color: #f5f1e8; }
  .sx-cue {
    display: inline-flex; align-items: center; justify-content: center; gap: 7px; padding: 6px 10px; border-radius: 999px; cursor: pointer;
    background: rgba(255, 255, 255, 0.025); border: 1px solid rgba(139, 107, 255, 0.28); color: rgba(245, 241, 232, 0.6);
    font-family: var(--cs-mono); font-size: 10px; letter-spacing: 0.05em;
    transition: color 0.18s, border-color 0.18s;
  }
  .sx-cue:hover, .sx-cue.on { color: var(--v); border-color: var(--v); }
  .sx-cue:focus-visible { outline: 2px solid var(--v); outline-offset: 3px; }
  .sx-cue svg { width: 10px; height: 10px; fill: currentColor; flex: 0 0 auto; }
  .sx-cue .c-stop { display: none; }
  .sx-cue.on .c-play { display: none; }
  .sx-cue.on .c-stop { display: block; }
  .sx-cue span { white-space: nowrap; }
  .sx-fresh { display: flex; flex-direction: column; gap: 5px; padding-top: 4px; }
  .sx-fresh-h { font-family: var(--cs-mono); font-size: 8.5px; letter-spacing: 0.24em; text-transform: uppercase; color: rgba(245, 241, 232, 0.3); }
  .sx-fresh-row { font-family: var(--cs-mono); font-size: 9.5px; color: rgba(245, 241, 232, 0.4);
    padding: 4px 7px; border: 1px solid rgba(245, 241, 232, 0.07); border-radius: 5px; }
  .sx-side-hint { margin-top: auto; font-family: var(--cs-mono); font-size: 9.5px; line-height: 1.5; color: rgba(245, 241, 232, 0.35); }
  .sx .sx-side-eng { font-family: var(--cs-mono); font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase;
    color: rgba(0, 255, 77, 0.55); text-decoration: none; padding-top: 10px; border-top: 1px solid rgba(245, 241, 232, 0.08); transition: color 0.18s; }
  .sx .sx-side-eng:hover { color: var(--brand-green); }

  /* main + topbar */
  .sx-main { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; }
  .sx-top {
    display: flex; align-items: center; height: 40px; padding: 0 12px 0 0;
    border-bottom: 1px solid rgba(245, 241, 232, 0.08);
  }
  /* the three view switches are a real tablist — the group is a box so the
     assistive-tech grouping and the visual grouping are the same thing */
  .sx-tabs { display: flex; align-items: stretch; height: 100%; }
  .sx-tab {
    position: relative;
    padding: 0 16px; height: 100%; display: inline-flex; align-items: center; gap: 6px;
    background: transparent; border: none; cursor: pointer;
    font-family: var(--cs-mono); font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase;
    color: rgba(245, 241, 232, 0.4); border-right: 1px solid rgba(245, 241, 232, 0.06);
    transition: color 0.18s;
  }
  .sx-frame:not(.grown) .sx-tab { opacity: 0; pointer-events: none; }
  .sx-tab:hover { color: rgba(245, 241, 232, 0.75); }
  .sx-tab.on { color: #f5f1e8; box-shadow: inset 0 -2px 0 var(--v); }
  .sx-tab:focus-visible { outline: 2px solid var(--v); outline-offset: -3px; }
  .sx-nudge { display: none; width: 6px; height: 6px; border-radius: 50%; background: var(--v); box-shadow: 0 0 8px var(--v); }
  .sx-tab.nudge .sx-nudge { display: inline-block; animation: sx-nudgepulse 1.2s ease-in-out infinite; }
  @keyframes sx-nudgepulse { 0%, 100% { opacity: 0.5; } 50% { opacity: 1; } }
  .sx-brand { margin-left: auto; font-family: var(--cs-mono); font-size: 9.5px; letter-spacing: 0.22em; text-transform: uppercase; color: rgba(245, 241, 232, 0.38); }
  .sx-armwrap { display: inline-flex; align-items: center; gap: 8px; margin-left: 14px; transition: opacity 0.5s ease 0.35s; }
  .sx-frame:not(.grown) .sx-armwrap { opacity: 0; pointer-events: none; }
  .sx-arm {
    padding: 4px 10px; border-radius: 5px; cursor: pointer;
    font-family: var(--cs-mono); font-size: 9px; letter-spacing: 0.18em; text-transform: uppercase;
    color: rgba(245, 241, 232, 0.55); background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(245, 241, 232, 0.18);
    transition: color 0.18s, border-color 0.18s, background 0.18s;
  }
  .sx-arm[aria-pressed="true"] { color: #ff5d63; border-color: rgba(255, 93, 99, 0.6); background: rgba(255, 93, 99, 0.08); }
  .sx-lcd:empty { display: none; }
  .sx-lcd { min-width: 64px; height: 20px; border-radius: 4px; background: rgba(0, 0, 0, 0.45); box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.6);
    font-family: var(--cs-mono); font-size: 8.5px; letter-spacing: 0.12em; text-transform: uppercase;
    color: rgba(255, 93, 99, 0.85); display: inline-flex; align-items: center; justify-content: center; }

  /* views */
  .sx-view { display: none; flex-direction: column; }
  .sx-view.on { display: flex; }

  /* ═══ signal ═══ */
  .sx-towers { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; padding: 22px 22px 8px; }
  .sx-tower {
    --tw: var(--v);
    position: relative; display: flex; flex-direction: column; gap: 12px; padding: 14px 14px 14px;
    border-radius: 12px; background: rgba(255, 255, 255, 0.015); border: 1px solid rgba(245, 241, 232, 0.12);
    transition: opacity 0.55s ease, transform 0.55s ease, border-color 0.25s ease, box-shadow 0.3s ease;
  }
  /* the studio's own module colors */
  .tw-drums { --tw: #ffd24a; }
  .tw-keys { --tw: #17c4fc; }
  .tw-bass { --tw: #c05dff; }
  .sx-lane.ln-drums { --tw: #ffd24a; }
  .sx-lane.ln-keys { --tw: #17c4fc; }
  .sx-lane.ln-bass { --tw: #c05dff; }
  .sx-frame:not(.grown) .tw-drums, .sx-frame:not(.grown) .tw-bass { opacity: 0; transform: scale(0.92); pointer-events: none; }
  .sx-frame:not(.grown) .sx-towers { grid-template-columns: 0fr 1fr 0fr; gap: 0; }
  .sx-frame:not(.grown) .tw-keys .sx-node, .sx-frame:not(.grown) .sx-mute, .sx-frame:not(.grown) .sx-mech, .sx-frame:not(.grown) .sx-screen, .sx-frame:not(.grown) .sx-tower-name, .sx-frame:not(.grown) .sx-voicebay { opacity: 0; height: 0; padding: 0; margin: 0; overflow: hidden; border: none; }
  .sx-frame:not(.grown) .sx-toyface { display: flex; }

  .sx-toyface { display: none; gap: 6px; justify-content: center; padding: 18px 4px 14px; }
  .sx-frame.grown .sx-toyface { display: none; }
  .sx-keycap {
    width: 34px; height: 34px; border-radius: 8px; display: grid; place-items: center; font-style: normal;
    font-family: var(--cs-mono); font-size: 11px; color: rgba(245, 241, 232, 0.75);
    background: linear-gradient(180deg, #262233, #171420); border: 1px solid rgba(0, 0, 0, 0.55);
