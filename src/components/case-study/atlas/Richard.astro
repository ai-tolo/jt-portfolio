---
/**
 * Richard — the Engineer's avatar, snapshotted into the case study so the page
 * never imports portal internals (and stays decoupled from the live portal art).
 * Faithful copy of components/portal/EngineerTurtle.astro as of 2026-06-03 (the
 * "Richard" pass): a chubby green big-headed turtle music engineer playing a
 * futuristic mini electric guitar (holographic cyan→violet→pink finish), with a
 * tie-dye bandana, studio headphones, and a rainbow gemstone necklace.
 *
 * Static by design (no movement); `speaking` only nudges the glow. IDs are
 * namespaced (rd*) so this can never collide with the portal copy. Keeps the
 * .atlas-turtle wrapper the reveal scripts target.
 */
interface Props {
  size?: number;
  speaking?: boolean;
  class?: string;
}
const { size = 72, speaking = false, class: className = "" } = Astro.props;
---

<span
  class:list={["atlas-turtle", className]}
  data-speaking={speaking ? "true" : "false"}
  style={`--turtle-size:${size}px`}
  aria-hidden="true"
>
  <svg viewBox="0 0 100 100" width={size} height={size} role="img" aria-label="Richard, the engineer">
    <defs>
      <linearGradient id="rdSkin" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#7ad492" />
        <stop offset="100%" stop-color="#45a863" />
      </linearGradient>
      <linearGradient id="rdShell" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#eab867" />
        <stop offset="100%" stop-color="#b9772f" />
      </linearGradient>
      <radialGradient id="rdBelly" cx="50%" cy="40%" r="68%">
        <stop offset="0%" stop-color="#fbeebc" />
        <stop offset="100%" stop-color="#edcd84" />
      </radialGradient>
      <linearGradient id="rdHolo" x1="0" y1="1" x2="1" y2="0">
        <stop offset="0%" stop-color="#0ec4fc" />
        <stop offset="50%" stop-color="#7b5cff" />
        <stop offset="100%" stop-color="#ff2d8b" />
      </linearGradient>
      <linearGradient id="rdBand" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0%" stop-color="#ff2d8b" />
        <stop offset="50%" stop-color="#ff8a3d" />
        <stop offset="100%" stop-color="#ffd23d" />
      </linearGradient>
      <radialGradient id="rdNeon" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#22d3ff" stop-opacity="0.6" />
        <stop offset="100%" stop-color="#22d3ff" stop-opacity="0" />
      </radialGradient>
    </defs>

    <!-- feet -->
    <ellipse cx="37" cy="91" rx="8" ry="5.5" fill="url(#rdSkin)" stroke="#1f7040" stroke-width="2" />
    <ellipse cx="61" cy="92" rx="8" ry="5.5" fill="url(#rdSkin)" stroke="#1f7040" stroke-width="2" />
    <g stroke="#1f7040" stroke-width="1.2" opacity="0.5" stroke-linecap="round">
      <line x1="35" y1="90" x2="34" y2="94" /><line x1="39" y1="90" x2="39" y2="94" />
      <line x1="59" y1="91" x2="58" y2="95" /><line x1="63" y1="91" x2="63" y2="95" />
    </g>

    <!-- shell bordering the torso: tan carapace ring + cream plastron -->
    <ellipse cx="49" cy="66" rx="27" ry="23" fill="url(#rdShell)" stroke="#7a4a1e" stroke-width="2.2" />
    <g stroke="#7a4a1e" stroke-width="1.4" opacity="0.7" stroke-linecap="round">
      <line x1="24" y1="66" x2="21" y2="66" /><line x1="74" y1="66" x2="77" y2="66" />
      <line x1="34" y1="85" x2="31" y2="87" /><line x1="64" y1="85" x2="67" y2="87" />
      <line x1="49" y1="88" x2="49" y2="91" />
    </g>
    <ellipse cx="49" cy="69" rx="17.5" ry="15.5" fill="url(#rdBelly)" stroke="#c99a52" stroke-width="1.6" />
    <g stroke="#cda85d" stroke-width="1.1" opacity="0.55" stroke-linecap="round">
      <line x1="49" y1="55" x2="49" y2="83" />
      <line x1="49" y1="64" x2="39" y2="66" /><line x1="49" y1="64" x2="59" y2="66" />
    </g>

    <!-- far arm reaching to the fretboard -->
    <path d="M62 61 q5 -3 2 -11" fill="none" stroke="#45a863" stroke-width="7" stroke-linecap="round" />

    <!-- futuristic mini electric guitar -->
    <g>
      <g transform="translate(37 74) rotate(43)">
        <ellipse cx="0" cy="2" rx="16" ry="18" fill="url(#rdNeon)" opacity="0.85" />
        <path d="M1 -14 C 6 -15 10 -13 10 -7 C 15 -6 16.5 2 13 8 C 10 15 3 17 -2 16 C -9 15 -14.5 9 -13 2 C -14 -3 -12 -7 -9 -6 C -7 -9.5 -10.5 -13 -5 -14 C -3 -15 -1 -15 1 -14 Z"
          fill="url(#rdHolo)" stroke="#eaf8ff" stroke-width="1.3" />
        <ellipse cx="-5" cy="-6" rx="5" ry="7.5" fill="#ffffff" opacity="0.18" />
        <rect x="-8.5" y="-3" width="17" height="3" rx="1.3" fill="#0e1320" />
        <rect x="-8.5" y="4" width="17" height="3" rx="1.3" fill="#0e1320" />
        <rect x="-5" y="11" width="10" height="2.6" rx="0.8" fill="#0e1320" />
        <circle cx="9.5" cy="11.5" r="1.5" fill="#0b0f1a" stroke="#eaf8ff" stroke-width="0.4" />
      </g>
      <line x1="46" y1="64" x2="67" y2="46" stroke="#1a2030" stroke-width="6" stroke-linecap="round" />
      <line x1="46" y1="64" x2="67" y2="46" stroke="#3a445e" stroke-width="2.4" stroke-linecap="round" />
      <g stroke="#b8c2da" stroke-width="0.8" opacity="0.7">
        <line x1="50" y1="62" x2="53.5" y2="59" /><line x1="55" y1="57.5" x2="58.5" y2="54.5" /><line x1="60" y1="53" x2="63.5" y2="50" />
      </g>
      <g stroke="#dcf9ff" stroke-width="0.55">
        <line x1="44" y1="66" x2="66" y2="47.5" /><line x1="45.2" y1="67" x2="67.2" y2="48.5" /><line x1="46.4" y1="67.8" x2="68.2" y2="49.3" />
      </g>
      <path d="M64 49 L70 43.5 L73.5 46 L67.5 51.5 Z" fill="#1a2030" stroke="#2c344a" stroke-width="0.8" />
      <circle cx="68.5" cy="45.8" r="0.95" fill="#22d3ff" /><circle cx="70.2" cy="47.4" r="0.95" fill="#22d3ff" /><circle cx="71.8" cy="49" r="0.95" fill="#22d3ff" />
    </g>

    <!-- near hand picking over the body -->
    <ellipse cx="42" cy="73" rx="6.2" ry="5" fill="url(#rdSkin)" stroke="#1f7040" stroke-width="2" transform="rotate(18 42 73)" />

    <!-- head (bigger) -->
    <ellipse cx="47" cy="26" rx="19" ry="17.5" fill="url(#rdSkin)" stroke="#1f7040" stroke-width="2.2" />
    <g fill="#2f9e6e" opacity="0.55">
      <circle cx="34" cy="30" r="0.9" /><circle cx="37" cy="32.5" r="0.9" />
      <circle cx="60" cy="30" r="0.9" /><circle cx="57" cy="32.5" r="0.9" />
    </g>

    <!-- tie-dye bandana -->
    <g>
      <path d="M30 22 Q24 28 22 38 L26 38 Q27 29 33 23 Z" fill="url(#rdBand)" stroke="#b81e63" stroke-width="0.6" />
      <path d="M32 23 Q28 30 29 39 L33 38 Q32 30 35 24 Z" fill="url(#rdBand)" stroke="#b81e63" stroke-width="0.6" />
      <path d="M30 18.5 Q47 11 64 18.5 L64 23 Q47 16 30 23 Z" fill="url(#rdBand)" stroke="#b81e63" stroke-width="0.7" />
      <g fill="#fff1d6" opacity="0.85"><circle cx="38" cy="18.6" r="0.8" /><circle cx="47" cy="16.9" r="0.8" /><circle cx="56" cy="18.6" r="0.8" /></g>
      <circle cx="30.5" cy="20.5" r="2.5" fill="url(#rdBand)" stroke="#b81e63" stroke-width="0.6" />
    </g>

    <!-- eyes -->
    <ellipse cx="40" cy="30" rx="4.2" ry="5.5" fill="#15203a" />
    <circle cx="38.5" cy="27.5" r="1.7" fill="#fff" /><circle cx="41.4" cy="32.2" r="0.9" fill="#fff" opacity="0.85" />
    <ellipse cx="54" cy="30" rx="4.2" ry="5.5" fill="#15203a" />
    <circle cx="52.5" cy="27.5" r="1.7" fill="#fff" /><circle cx="55.4" cy="32.2" r="0.9" fill="#fff" opacity="0.85" />
    <!-- blush -->
    <ellipse cx="33" cy="36" rx="3.2" ry="2" fill="#ff7ab8" opacity="0.45" />
    <ellipse cx="61" cy="36" rx="3.2" ry="2" fill="#ff7ab8" opacity="0.45" />
    <!-- nose + smile -->
    <circle cx="45" cy="37" r="0.65" fill="#1f5a40" /><circle cx="49" cy="37" r="0.65" fill="#1f5a40" />
    <path d="M42 39.4 Q47 44 52 39.4" fill="none" stroke="#1f5a40" stroke-width="1.8" stroke-linecap="round" />

    <!-- studio headphones -->
    <g>
      <path d="M28 23 Q47 -7 66 23" fill="none" stroke="#2b2f3c" stroke-width="4.2" stroke-linecap="round" />
      <path d="M29 23 Q47 -3 65 23" fill="none" stroke="#0ec4fc" stroke-width="1" stroke-linecap="round" opacity="0.5" />
      <g stroke="#171a24" stroke-width="1.2">
        <ellipse cx="27" cy="30" rx="5.6" ry="7.8" fill="#2b2f3c" />
        <ellipse cx="67" cy="30" rx="5.6" ry="7.8" fill="#2b2f3c" />
      </g>
      <ellipse cx="27.6" cy="30" rx="2.8" ry="4.8" fill="#3a4150" />
      <ellipse cx="66.4" cy="30" rx="2.8" ry="4.8" fill="#3a4150" />
      <circle cx="27.6" cy="30" r="1.4" fill="#0ec4fc" opacity="0.85" />
      <circle cx="66.4" cy="30" r="1.4" fill="#0ec4fc" opacity="0.85" />
    </g>

    <!-- rainbow gemstone necklace -->
    <g>
      <path d="M34 46 Q47 52.5 60 46" fill="none" stroke="#caa24a" stroke-width="1.1" opacity="0.85" />
      <g stroke="#ffffff" stroke-width="0.3" stroke-opacity="0.6">
        <rect x="-1.5" y="-1.5" width="3" height="3" transform="translate(35 46.6) rotate(45)" fill="#a06cf0" />
        <rect x="-1.5" y="-1.5" width="3" height="3" transform="translate(39 48.7) rotate(45)" fill="#4f8cff" />
        <rect x="-1.5" y="-1.5" width="3" height="3" transform="translate(43 50.1) rotate(45)" fill="#3ddc84" />
        <rect x="-2.1" y="-2.1" width="4.2" height="4.2" transform="translate(47 50.8) rotate(45)" fill="#ffd23d" />
        <rect x="-1.5" y="-1.5" width="3" height="3" transform="translate(51 50.1) rotate(45)" fill="#ff8a3d" />
        <rect x="-1.5" y="-1.5" width="3" height="3" transform="translate(55 48.7) rotate(45)" fill="#ff2d8b" />
        <rect x="-1.5" y="-1.5" width="3" height="3" transform="translate(59 46.6) rotate(45)" fill="#ff5fa0" />
      </g>
    </g>
  </svg>
</span>

<style>
  .atlas-turtle {
    display: inline-flex;
    width: var(--turtle-size, 72px);
    height: var(--turtle-size, 72px);
    line-height: 0;
    filter: drop-shadow(0 4px 10px rgba(14, 196, 252, 0.22));
  }
  .atlas-turtle svg { overflow: visible; }
  .atlas-turtle[data-speaking="true"] { filter: drop-shadow(0 4px 14px rgba(14, 196, 252, 0.4)); }
</style>
