---
// A "movement" pillar — the dramatic, minimalist chapter break that names one
// of the two halves the whole system stands on (AudioDex · the index, then
// Richard · the engineer). Hero-scale Space Grotesk wordmark, an accent kicker
// + rule, and a giant ghost numeral behind it. Static by design (a title should
// never be trapped invisible behind a reveal). Accent colour-codes the half.
interface Props {
  index: string;   // "I" / "II"
  kicker: string;  // "The index" / "The engineer"
  name: string;    // "AudioDex" / "Richard"
  tagline: string;
  accent?: "cyan" | "green" | "orange" | "pink";
  /** Flow continuously out of the module above (no top rule, tight top pad). */
  flush?: boolean;
}
const { index, kicker, name, tagline, accent = "cyan", flush = false } = Astro.props;
---

<section class:list={["mv", `mv-${accent}`, "cs-bleed", { "mv-flush": flush }]}>
  <div class="mv-inner">
    <span class="mv-ghost" aria-hidden="true">{index}</span>
    <p class="mv-eyebrow"><span class="mv-tick" aria-hidden="true"></span>Movement {index} — {kicker}</p>
    <h2 class="mv-name">{name}</h2>
    <span class="mv-rule" aria-hidden="true"></span>
    <p class="mv-tag">{tagline}</p>
  </div>
</section>

<style>
  .mv {
    position: relative;
    padding: clamp(76px, 13vh, 156px) 0 clamp(46px, 8vh, 92px);
    overflow: hidden;
    isolation: isolate;
    border-top: 1px solid rgba(245, 241, 232, 0.08);
    --mv-accent: var(--brand-cyan);
  }
  .mv-flush { border-top: none; padding-top: clamp(10px, 3.5vh, 40px); }
  .mv-green { --mv-accent: var(--brand-green); }
  .mv-orange { --mv-accent: var(--brand-orange); }
  .mv-pink { --mv-accent: var(--brand-pink); }

  .mv-inner {
    position: relative;
    max-width: 1160px;
    margin: 0 auto;
    padding: 0 32px;
  }

  /* giant ghost numeral, sunk far back */
  .mv-ghost {
    position: absolute;
    top: 50%;
    right: 12px;
    transform: translateY(-52%);
    font-family: "Space Grotesk Variable", "Space Grotesk", sans-serif;
    font-weight: 700;
    font-size: clamp(180px, 36vw, 460px);
    line-height: 0.74;
    letter-spacing: -0.05em;
    color: var(--mv-accent);
    opacity: 0.055;
    z-index: -1;
    pointer-events: none;
    user-select: none;
  }

  .mv-eyebrow {
    display: flex;
    align-items: center;
    gap: 13px;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--mv-accent);
    margin: 0 0 20px;
  }
  .mv-tick {
    width: 26px;
    height: 2px;
    flex: 0 0 auto;
    background: var(--mv-accent);
    box-shadow: 0 0 12px var(--mv-accent);
  }

  .mv-name {
    font-family: "Space Grotesk Variable", "Space Grotesk", ui-sans-serif, system-ui, sans-serif;
    font-weight: 700;
    font-size: clamp(54px, 11.5vw, 138px);
    letter-spacing: -0.046em;
    line-height: 0.9;
    margin: 0;
    color: #f8f6ef;
    filter: drop-shadow(0 6px 34px color-mix(in srgb, var(--mv-accent) 22%, transparent));
  }

  .mv-rule {
    display: block;
    width: 76px;
    height: 4px;
    margin: 28px 0 0;
    background: var(--mv-accent);
    border-radius: 2px;
    box-shadow: 0 0 20px var(--mv-accent);
  }

  .mv-tag {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-style: italic;
    font-size: clamp(15px, 1.85vw, 20px);
    line-height: 1.5;
    color: rgba(245, 241, 232, 0.76);
    margin: 24px 0 0;
    max-width: 46ch;
  }

  @media (max-width: 720px) {
    .mv { padding: clamp(56px, 10vh, 96px) 0 40px; }
    .mv-name { font-size: clamp(42px, 15vw, 70px); }
    .mv-ghost { font-size: 210px; right: -12px; opacity: 0.045; }
  }
</style>
