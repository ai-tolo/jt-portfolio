---
// AudioDex emblem — a hand-kept journal of sound (coil-bound, a bookmark, a
// catalogued page). A stand-in for the real journal Jon designed with "AudioDex"
// on the cover; the production asset can replace this SVG without touching callers.
// Shared by the Movement-I reveal and the closing duo.
interface Props { size?: number; class?: string; }
const { size = 104, class: className = "" } = Astro.props;
const h = Math.round((size / 104) * 116);
---
<span class:list={["adxmark", className]} style={`--adx-size:${size}px`} aria-hidden="true">
  <svg viewBox="0 0 104 116" width={size} height={h} role="img" aria-label="AudioDex — a journal of sound">
    <defs>
      <linearGradient id={`adxCover-${size}`} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#16242f" /><stop offset="1" stop-color="#0b141b" />
      </linearGradient>
      <radialGradient id={`adxGlow-${size}`} cx="50%" cy="42%" r="60%">
        <stop offset="0" stop-color="#0ec4fc" stop-opacity="0.18" /><stop offset="1" stop-color="#0ec4fc" stop-opacity="0" />
      </radialGradient>
    </defs>
    <ellipse cx="52" cy="58" rx="52" ry="50" fill={`url(#adxGlow-${size})`} />
    <rect x="22" y="18" width="70" height="88" rx="5" fill="#0a1016" stroke="#0ec4fc" stroke-opacity="0.16" />
    <rect x="19" y="15" width="70" height="88" rx="5" fill="#0b1219" stroke="#0ec4fc" stroke-opacity="0.22" />
    <rect x="15" y="11" width="70" height="88" rx="6" fill={`url(#adxCover-${size})`} stroke="#0ec4fc" stroke-opacity="0.6" />
    <path d="M70 11 v23 l-4.5 -5 -4.5 5 V11 Z" fill="#0ec4fc" opacity="0.85" />
    <g stroke="#0ec4fc" stroke-opacity="0.65" stroke-width="1.5" fill="none">
      <path d="M15 22 q-7 1 -7 5.5 t7 5" /><path d="M15 38 q-7 1 -7 5.5 t7 5" />
      <path d="M15 54 q-7 1 -7 5.5 t7 5" /><path d="M15 70 q-7 1 -7 5.5 t7 5" />
      <path d="M15 86 q-7 1 -7 5.5 t7 5" />
    </g>
    <g stroke="#0ec4fc" stroke-width="1.6" stroke-linecap="round" opacity="0.85">
      <path d="M28 28 q3 -6 6 0 t6 0 q3 6 6 0 t6 0 t6 0 t6 0 t6 0" fill="none" />
    </g>
    <text x="50" y="48" text-anchor="middle" font-family="'Space Grotesk Variable','Space Grotesk',sans-serif" font-size="11.5" font-weight="700" letter-spacing="-0.3" fill="#dff6ff">AudioDex</text>
    <g>
      <circle cx="29" cy="62" r="2" fill="#00ff4d" /><rect x="35" y="60.6" width="36" height="2.6" rx="1.3" fill="#0ec4fc" opacity="0.4" />
      <circle cx="29" cy="72" r="2" fill="#0ec4fc" /><rect x="35" y="70.6" width="30" height="2.6" rx="1.3" fill="#0ec4fc" opacity="0.3" />
      <circle cx="29" cy="82" r="2" fill="#ffb347" /><rect x="35" y="80.6" width="33" height="2.6" rx="1.3" fill="#0ec4fc" opacity="0.3" />
    </g>
    <text x="50" y="94" text-anchor="middle" font-family="ui-monospace,Menlo,monospace" font-size="6" letter-spacing="0.5" fill="#0ec4fc" opacity="0.55">20,279 ENTRIES</text>
  </svg>
</span>

<style>
  .adxmark { display: inline-flex; width: var(--adx-size, 104px); line-height: 0; filter: drop-shadow(0 6px 16px rgba(14, 196, 252, 0.28)); }
  .adxmark svg { overflow: visible; }
</style>
