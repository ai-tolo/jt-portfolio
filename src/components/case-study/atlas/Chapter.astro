---
// Chapter marker. The JOB is the headline ("Know what you have") because the
// jobs are the story; the product that answers it rides underneath, small.
// One optional "why not the tools I own" line — the market answer, one plain
// sentence, never a table. Static by design; a title is never trapped behind
// a reveal. Accents follow the section's single color.
interface Props {
  index: string;              // "01"
  job: string;                // "Know what you have"
  product: string;            // "AudioDex — the catalog"
  tagline?: string;           // one italic line under the product
  market?: string;            // the why-not-existing-tools sentence
  accent?: "cyan" | "violet" | "green" | "amber";
  flush?: boolean;            // trim bottom padding when a module mounts right below
}
const { index, job, product, tagline, market, accent = "cyan", flush = false } = Astro.props;
// --ch paints the eyebrow TEXT as well as the rule, so it has to be AA on the
// day ground: the route's *-text tokens resolve back to the raw brand hues at
// night. Violet has no brand token, so it rides a local property the style
// block re-points per mode.
const ACCENTS = { cyan: "var(--cs-cyan-text)", violet: "var(--ch-violet)", green: "var(--cs-green-text)", amber: "var(--cs-yellow-text)" };
---

<section class:list={["ch", { "ch-flush": flush }]} style={`--ch: ${ACCENTS[accent]}`}>
  <div class="ch-inner">
    <p class="ch-eyebrow"><span class="ch-num">{index}</span>{product}</p>
    <h2 class="ch-job">{job}</h2>
    <span class="ch-rule" aria-hidden="true"></span>
    {tagline && <p class="ch-tagline">{tagline}</p>}
    {market && <p class="ch-market">{market}</p>}
  </div>
</section>

<style>
  .ch {
    --ch-violet: #6d4fd8;
    padding: clamp(72px, 11vh, 128px) 24px clamp(40px, 6vh, 72px);
  }
  /* screen-only, the way the route's night block is: print always resolves day */
  @media screen {
    :global(html[data-night]) .ch { --ch-violet: #8b6bff; }
  }
  .ch.ch-flush { padding-bottom: 18px; }
  .ch-inner { max-width: 1060px; margin: 0 auto; }

  .ch-eyebrow {
    margin: 0 0 14px;
    font-family: var(--cs-mono);
    font-size: 11px; letter-spacing: 0.24em; text-transform: uppercase;
    color: var(--ch);
  }
  .ch-num {
    display: inline-block; margin-right: 14px; padding-right: 14px;
    border-right: 1px solid color-mix(in srgb, var(--ch) 45%, transparent);
    color: var(--cs-text-dim);
  }

  .ch-job {
    margin: 0;
    font-family: "Space Grotesk Variable", "Space Grotesk", ui-sans-serif, system-ui, sans-serif;
    font-weight: 700;
    font-size: clamp(40px, 6.4vw, 84px);
    letter-spacing: -0.03em;
    line-height: 1.0;
    color: var(--cs-text);
    /* the accent bloom is a lit-room effect: it only reads on a dark canvas */
    text-shadow: none;
    max-width: 18ch;
  }
  @media screen {
    :global(html[data-night]) .ch-job {
      text-shadow: 0 0 46px color-mix(in srgb, var(--ch) 26%, transparent);
    }
  }
  .ch-rule { display: block; width: 76px; height: 3px; border-radius: 2px; background: var(--ch); margin: 22px 0 0; }

  .ch-tagline {
    margin: 18px 0 0;
    font-family: var(--cs-mono);
    font-style: italic;
    font-size: clamp(15px, 1.8vw, 19px);
    line-height: 1.55;
    color: var(--cs-prose);
    max-width: 52ch;
  }
  .ch-market {
    margin: 12px 0 0;
    font-family: "Space Grotesk Variable", "Space Grotesk", ui-sans-serif, system-ui, sans-serif;
    font-size: clamp(14px, 1.6vw, 17px);
    line-height: 1.55;
    color: var(--cs-text-muted);
    max-width: 56ch;
  }

  @media (max-width: 720px) {
    .ch { padding-left: 20px; padding-right: 20px; }
  }
</style>
