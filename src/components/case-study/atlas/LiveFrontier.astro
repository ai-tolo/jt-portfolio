---
// ROUND 05 — THE LIVE FRONTIER · the system map (v4, 2026-06-11).
//
// Reads as one vertical story, tuned against three blind comprehension panels:
//   1. the catch  — a PROMINENT top banner: even within one song the verse wants
//                   it processed and the drop wants it raw (verse ≠ drop) — so no
//                   single master fits both. (Pulled OUT of the loop center, where
//                   prior versions buried it and readers skimmed past.)
//   2. the loop   — so the engine never stops: it asks the round it's least sure
//                   of -> you vote blind -> it learns -> it asks again.
//   3. the edge   — each round it gets surer, until all that's left are genuine
//                   toss-ups only blind ears can call. That residue is the frontier.
//
// v4 changes: message 1 is a big banner up top (was a buried sub-panel); the
// verse/drop contrast is shown with a literal "≠"; the n=1 / -2 dBTP footnotes are
// demoted to quiet fine-print (they read as load-bearing jargon as bordered chips).
//
// Only motion is a calm breathing aura on the active node; pure CSS, reduced-motion
// freezes it. 100% server-rendered, no IO/scroll/rAF, fully readable with no JS.
// Rhymes with RoundFrame/TasteTrial (Round-05 yellow header, yellow = live).
---

<section class="lf" data-live-frontier>
  <header class="lf-head">
    <span class="lf-num">Round 05</span>
    <span class="lf-phase">the live frontier</span>
  </header>

  <p class="lf-sub">No single master wins a whole song — so the engine never stops asking.</p>

  <div class="lf-panel">
    <svg
      class="lf-svg"
      viewBox="0 0 560 462"
      role="img"
      aria-label="A system, top to bottom. The catch: even within one song the verse wants it processed and the drop wants it raw — verse does not equal drop — so no single master fits both. The loop: so the engine never stops — it asks the round it's least sure of, you vote blind, it learns, then asks again, with the engine at its center. The edge: each round it gets surer, until all that's left are genuine toss-ups only blind ears can decide."
    >
      <defs>
        <filter id="lf-glow" x="-60%" y="-60%" width="220%" height="220%">
          <feGaussianBlur stdDeviation="7" />
        </filter>
        <marker id="lf-ah" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0 1 L9 5 L0 9 z" class="lf-ahfill" />
        </marker>
      </defs>

      <!-- ═══ 1 · THE CATCH — a prominent banner, the "why" up front. The
              smooth-vs-jagged waveform makes "processed/raw" felt, not lexical. ═══ -->
      <text x="280" y="20" class="lf-incap">even within one song</text>
      <rect x="98" y="30" width="160" height="58" rx="8" class="lf-cell lf-cell-proc" />
      <path class="lf-wave lf-wave-proc" d="M120 47 Q139 43 158 47 T196 47 T234 47" />
      <text x="178" y="71" class="lf-cell-sec">verse</text>
      <text x="178" y="83" class="lf-cell-tag lf-cell-tag-proc">wants it processed</text>
      <text x="280" y="61" class="lf-neq">&#8800;</text>
      <rect x="302" y="30" width="160" height="58" rx="8" class="lf-cell lf-cell-raw" />
      <path class="lf-wave lf-wave-raw" d="M324 47 L332 32 L340 60 L348 33 L356 59 L364 32 L372 60 L380 33 L388 59 L396 33 L404 60 L412 34 L420 58 L428 38 L436 47" />
      <text x="382" y="71" class="lf-cell-sec">drop</text>
      <text x="382" y="83" class="lf-cell-tag lf-cell-tag-raw">wants it raw</text>
      <text x="280" y="108" class="lf-verdict">no single master fits both</text>

      <!-- connector into the loop -->
      <path class="lf-drop" marker-end="url(#lf-ah)" d="M280 118 L280 142" />
      <text x="295" y="134" class="lf-conn">so it never stops asking</text>

      <!-- ═══ 2 · THE LOOP ═══ -->
      <ellipse cx="280" cy="174" rx="92" ry="34" class="lf-aura" filter="url(#lf-glow)" />
      <!-- edges, clockwise, arrowheaded -->
      <path class="lf-edge" marker-end="url(#lf-ah)" d="M362 194 Q478 230 446 286" />
      <path class="lf-edge" marker-end="url(#lf-ah)" d="M346 326 Q280 364 214 326" />
      <path class="lf-edge lf-edge-live" marker-end="url(#lf-ah)" d="M84 288 Q36 216 196 190" />

      <text x="280" y="258" class="lf-core">the engine</text>

      <!-- it asks (top, active) -->
      <g class="lf-node lf-node-live">
        <rect x="198" y="149" width="164" height="50" rx="9" />
        <text x="280" y="172" class="lf-node-t">it asks</text>
        <text x="280" y="188" class="lf-node-s">the round it's least sure of</text>
      </g>
      <!-- you vote (lower-right) -->
      <g class="lf-node">
        <rect x="346" y="287" width="152" height="50" rx="9" />
        <text x="422" y="310" class="lf-node-t">you vote</text>
        <text x="422" y="326" class="lf-node-s">blind</text>
      </g>
      <!-- it learns (lower-left) -->
      <g class="lf-node">
        <rect x="62" y="287" width="152" height="50" rx="9" />
        <text x="138" y="310" class="lf-node-t">it learns</text>
        <text x="138" y="326" class="lf-node-s">from your call</text>
      </g>

      <!-- ═══ 3 · THE EDGE — the residue of the loop ═══ -->
      <path class="lf-drop" marker-end="url(#lf-ah)" d="M280 368 L280 400" />
      <text x="295" y="388" class="lf-drop-lab">each round, surer</text>

      <line x1="78" y1="426" x2="482" y2="426" class="lf-frontier-line" />
      <text x="280" y="418" class="lf-frontier-lab">what's left: real toss-ups</text>
      <text x="280" y="444" class="lf-frontier-gloss">the only calls left — blind ears decide</text>
    </svg>

    {/*
      REAL-AUDIO HOOK — when the CantBreathe blind-A/B clips exist (uniform master
      vs the section-aware hybrid, loudness-matched), a player drops in here. Ships
      invisible until then: no chrome, no layout cost.
    */}
    <div class="lf-audio-slot" data-audio-slot="round05-section-ab" hidden></div>
  </div>

  <p class="lf-foot">
    <span>n=1 — one builder, working in the open.</span>
    <span>−2 dBTP true-peak floor — survives streaming codecs.</span>
  </p>
</section>

<style>
  .lf { max-width: 760px; margin: 0 auto; color: #f5f1e8; }

  /* ── header: rhymes RoundFrame / LiveFrontier; the num is yellow = live ── */
  .lf-head { display: flex; align-items: baseline; gap: 12px; margin-bottom: 10px; flex-wrap: wrap; }
  .lf-num {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11px; font-weight: 700; letter-spacing: 0.24em; text-transform: uppercase;
    color: var(--brand-yellow, #ffb347);
  }
  .lf-phase {
    font-family: "Space Grotesk Variable", "Space Grotesk", ui-sans-serif, system-ui, sans-serif;
    font-weight: 700; font-size: clamp(18px, 2.2vw, 22px); color: #f5f1e8; letter-spacing: -0.01em;
  }
  .lf-sub {
    margin: 0 0 14px; max-width: 64ch;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 13px; line-height: 1.6; color: var(--cs-text-muted, rgba(245, 241, 232, 0.62));
  }

  /* ── the single centered panel ── */
  .lf-panel {
    background: rgba(245, 241, 232, 0.02);
    border: 1px solid var(--cs-line, rgba(245, 241, 232, 0.1));
    border-left: 2px solid var(--brand-yellow, #ffb347);
    border-radius: 8px; padding: 18px 18px 16px;
  }
  .lf-svg { display: block; width: 100%; max-width: 500px; height: auto; margin: 0 auto; }
  .lf-audio-slot[hidden] { display: none; }

  /* ── 1 · the catch banner ── */
  .lf-incap {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 10px; letter-spacing: 0.16em; text-transform: uppercase;
    fill: rgba(245, 241, 232, 0.55); text-anchor: middle;
  }
  .lf-cell-proc { fill: rgba(14, 196, 252, 0.16); stroke: rgba(14, 196, 252, 0.6); stroke-width: 1.2; }
  .lf-cell-raw { fill: rgba(245, 241, 232, 0.07); stroke: rgba(245, 241, 232, 0.44); stroke-width: 1.2; }
  .lf-cell-sec { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 15px; font-weight: 700; fill: #f5f1e8; text-anchor: middle; }
  .lf-cell-tag { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 9px; letter-spacing: 0.02em; text-anchor: middle; }
  .lf-cell-tag-proc { fill: #8fe0ff; }
  .lf-cell-tag-raw { fill: rgba(245, 241, 232, 0.72); }
  /* the felt contrast: smooth (processed) vs jagged (raw) */
  .lf-wave { fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .lf-wave-proc { stroke: #8fe0ff; }
  .lf-wave-raw { stroke: rgba(245, 241, 232, 0.78); }
  .lf-neq { font-family: "Space Grotesk Variable", ui-sans-serif, sans-serif; font-size: 22px; font-weight: 700; fill: rgba(245, 241, 232, 0.55); text-anchor: middle; }
  .lf-verdict {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 10px; letter-spacing: 0.03em; fill: rgba(245, 241, 232, 0.78); text-anchor: middle; font-style: italic;
  }

  /* connector labels */
  .lf-conn { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 9px; letter-spacing: 0.03em; fill: rgba(245, 241, 232, 0.6); }

  /* ── the breathing aura on the active node (the only motion) ── */
  .lf-aura { fill: rgba(255, 179, 71, 0.16); animation: lf-breathe 4.2s ease-in-out infinite; }
  @keyframes lf-breathe { 0%, 100% { opacity: 0.32; } 50% { opacity: 0.82; } }

  /* ── 2 · loop edges + arrowheads ── */
  .lf-edge { fill: none; stroke: rgba(245, 241, 232, 0.36); stroke-width: 1.5; }
  .lf-edge-live { stroke: rgba(255, 179, 71, 0.55); }
  .lf-ahfill { fill: rgba(245, 241, 232, 0.55); }
  .lf-core {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 9px; letter-spacing: 0.16em; text-transform: uppercase;
    fill: rgba(245, 241, 232, 0.34); text-anchor: middle;
  }

  /* ── nodes ── */
  .lf-node rect { fill: rgba(245, 241, 232, 0.02); stroke: rgba(245, 241, 232, 0.24); stroke-width: 1; }
  .lf-node-live rect { fill: rgba(255, 179, 71, 0.07); stroke: var(--brand-yellow, #ffb347); stroke-width: 1.5; }
  .lf-node-t { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 13px; font-weight: 700; fill: #f5f1e8; text-anchor: middle; }
  .lf-node-live .lf-node-t { fill: var(--brand-yellow, #ffb347); }
  .lf-node-s { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 9px; fill: rgba(245, 241, 232, 0.66); text-anchor: middle; }
  .lf-node-live .lf-node-s { fill: rgba(255, 179, 71, 0.8); }

  /* ── 3 · descent (progress) + the named edge ── */
  .lf-drop { fill: none; stroke: rgba(255, 179, 71, 0.5); stroke-width: 1.5; }
  .lf-drop-lab { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 9.5px; font-weight: 600; letter-spacing: 0.03em; fill: rgba(255, 179, 71, 0.9); }
  .lf-frontier-line { stroke: var(--brand-yellow, #ffb347); stroke-width: 1.4; stroke-dasharray: 4 4; opacity: 0.7; }
  .lf-frontier-lab {
    font-family: "Space Grotesk Variable", "Space Grotesk", ui-sans-serif, sans-serif;
    font-size: 13px; font-weight: 700; letter-spacing: 0.01em; fill: var(--brand-yellow, #ffb347); text-anchor: middle;
  }
  .lf-frontier-gloss {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 9px; letter-spacing: 0.05em; fill: rgba(245, 241, 232, 0.62); text-anchor: middle;
  }

  /* ── footnotes: quiet fine-print, not badges ── */
  .lf-foot {
    display: flex; gap: 6px 22px; flex-wrap: wrap; margin: 12px 0 0;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 10px; line-height: 1.4; color: var(--cs-text-dim, rgba(245, 241, 232, 0.38));
  }

  .lf :focus-visible { outline: 2px solid var(--brand-yellow, #ffb347); outline-offset: 2px; }

  @media (prefers-reduced-motion: reduce) {
    .lf-aura { animation: none; opacity: 0.5; }
  }
</style>
