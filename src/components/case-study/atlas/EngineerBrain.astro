---
// ACT 4a — the Engineer's taste.
//
// Its taste isn't a knob. It's built from a corpus of finished records the
// curator loves, each tagged with what works in it. Those notes anchor the
// three taste axes; every job masters the track six ways across them. Tap a
// record to see what the engineer learned from it and which pole it anchors.

// The three taste axes are the dimensions a mastering chain actually controls
// on the WHOLE mix — tonal balance, dynamics, and stereo width. (Reference-
// matching shapes the mix's character; it never isolates or moves parts.)
const AXES = [
  { key: "focal",    label: "tone",     poles: ["forward · bright", "recessed · warm"], color: "cyan" },
  { key: "space",    label: "width",    poles: ["punchy · dry", "spacious · wide"], color: "pink" },
  { key: "dynamics", label: "dynamics", poles: ["modern · dense", "vintage · open"], color: "yellow" },
];

// real-flavor reference catalog: loved records + "what I like" notes + the pole
// each anchors. Each record carries its own accent so the shelf reads like a
// row of distinct sleeves, and the note adopts the selected record's color.
const REFS = [
  { artist: "Tame Impala", track: "Let It Happen", note: "huge low end that never turns to mud", axis: "dynamics", pole: 1, color: "#00ff4d" },
  { artist: "Frank Ocean", track: "Pyramids", note: "a warm, unforward balance — nothing claws at you up top", axis: "focal", pole: 1, color: "#a06cf0" },
  { artist: "070 Shake", track: "Guilty Conscience", note: "walls of synth, still hits punchy and dry", axis: "space", pole: 0, color: "#ff2d8b" },
  { artist: "Bon Iver", track: "715 - CRΣΣKS", note: "intimate and warm — every breath is in the room", axis: "focal", pole: 1, color: "#0ec4fc" },
  { artist: "Blood Orange", track: "Charcoal Baby", note: "soft tape transients, nothing brittle up top", axis: "dynamics", pole: 1, color: "#ff7a3d" },
  { artist: "Caroline Polachek", track: "So Hot…", note: "a bright top end that somehow never hurts", axis: "focal", pole: 0, color: "#ffd23d" },
];
---

<div class="eb" data-eb data-sel="0">
  <div class="eb-shelf" role="list" aria-label="Reference records">
    {REFS.map((r, i) => (
      <button type="button" class="eb-rec" data-eb-rec={String(i)} data-axis={r.axis} data-active={i === 0 ? "true" : "false"} role="listitem" style={`--rc:${r.color}`}>
        <span class="eb-vinyl" aria-hidden="true"><span class="eb-vinyl-hole"></span></span>
        <span class="eb-rec-meta">
          <span class="eb-rec-artist">{r.artist}</span>
          <span class="eb-rec-track">{r.track}</span>
        </span>
      </button>
    ))}
  </div>

  <div class="eb-note" data-eb-note>
    <span class="eb-note-q">“</span><span data-eb-note-text>{REFS[0].note}</span><span class="eb-note-q">”</span>
    <span class="eb-note-anchor" data-eb-note-anchor>anchors <b>recessed · warm</b></span>
  </div>

  <div class="eb-axes">
    {AXES.map((a) => (
      <div class={`eb-axis eb-axis-${a.color}`} data-eb-axis={a.key}>
        <span class="eb-axis-label">{a.label}</span>
        <div class="eb-axis-poles">
          <span class="eb-pole" data-eb-pole={`${a.key}-0`}>{a.poles[0]}</span>
          <span class="eb-axis-vs">↔</span>
          <span class="eb-pole" data-eb-pole={`${a.key}-1`}>{a.poles[1]}</span>
        </div>
      </div>
    ))}
  </div>

  <div class="eb-out">
    <span class="eb-out-arrow">↳</span>
    <span class="eb-out-text">every job masters the track <b>six ways</b> across these axes — one variant per pole</span>
    <div class="eb-bloom" aria-hidden="true">
      {["cyan","cyan","pink","pink","yellow","yellow"].map((c) => <span class={`eb-seed eb-seed-${c}`}></span>)}
    </div>
  </div>
</div>

<script>
  const REFS = [
    { note: "huge low end that never turns to mud", axis: "dynamics", pole: 1, poleLabel: "vintage · open" },
    { note: "a warm, unforward balance — nothing claws at you up top", axis: "focal", pole: 1, poleLabel: "recessed · warm" },
    { note: "walls of synth, still hits punchy and dry", axis: "space", pole: 0, poleLabel: "punchy · dry" },
    { note: "intimate and warm — every breath is in the room", axis: "focal", pole: 1, poleLabel: "recessed · warm" },
    { note: "soft tape transients, nothing brittle up top", axis: "dynamics", pole: 1, poleLabel: "vintage · open" },
    { note: "a bright top end that somehow never hurts", axis: "focal", pole: 0, poleLabel: "forward · bright" },
  ];
  document.querySelectorAll<HTMLElement>("[data-eb]").forEach((root) => {
    const recs = [...root.querySelectorAll<HTMLButtonElement>("[data-eb-rec]")];
    const noteText = root.querySelector<HTMLElement>("[data-eb-note-text]");
    const noteAnchor = root.querySelector<HTMLElement>("[data-eb-note-anchor]");
    const poles = [...root.querySelectorAll<HTMLElement>("[data-eb-pole]")];

    const select = (i: number) => {
      const r = REFS[i];
      root.dataset.sel = String(i);
      // the note + lit pole adopt the selected record's accent
      const rc = recs[i].style.getPropertyValue("--rc") || "#0ec4fc";
      root.style.setProperty("--rc", rc);
      recs.forEach((el, idx) => el.dataset.active = idx === i ? "true" : "false");
      if (noteText) noteText.textContent = r.note;
      if (noteAnchor) noteAnchor.innerHTML = `anchors <b>${r.poleLabel}</b>`;
      const targetPole = `${r.axis}-${r.pole}`;
      poles.forEach((p) => p.dataset.lit = p.dataset.ebPole === targetPole ? "true" : "false");
    };
    recs.forEach((el, i) => {
      el.addEventListener("click", () => select(i));
      el.addEventListener("mouseenter", () => select(i));
    });
    select(0);
  });
</script>

<style>
  .eb { color: #f5f1e8; --rc: #00ff4d; }

  /* ── reference shelf ── */
  .eb-shelf {
    display: grid; grid-template-columns: repeat(6, 1fr); gap: 10px; margin-bottom: 16px;
  }
  @media (max-width: 820px) { .eb-shelf { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 460px) { .eb-shelf { grid-template-columns: repeat(2, 1fr); } }
  .eb-rec {
    display: flex; flex-direction: column; align-items: center; gap: 8px;
    background: rgba(245, 241, 232, 0.02); border: 1px solid rgba(245, 241, 232, 0.1);
    border-radius: 8px; padding: 14px 8px 10px; cursor: pointer;
    transition: border-color 180ms ease, background 180ms ease, transform 180ms ease;
  }
  .eb-rec:hover { transform: translateY(-2px); border-color: color-mix(in srgb, var(--rc) 55%, transparent); background: color-mix(in srgb, var(--rc) 9%, transparent); }
  .eb-rec[data-active="true"] {
    border-color: color-mix(in srgb, var(--rc) 70%, transparent);
    background: color-mix(in srgb, var(--rc) 13%, transparent);
    box-shadow: 0 0 20px -5px color-mix(in srgb, var(--rc) 75%, transparent);
  }
  .eb-rec[data-active="true"] .eb-rec-artist { color: var(--rc); }
  .eb-vinyl {
    width: 46px; height: 46px; border-radius: 50%; position: relative; flex: 0 0 auto;
    background: radial-gradient(circle at 50% 50%, #14101a 0 30%, #2a1f33 31% 33%, #14101a 34% 46%, #2a1f33 47% 49%, #14101a 50%);
    box-shadow: 0 4px 12px -4px rgba(0, 0, 0, 0.7), inset 0 0 0 1px rgba(245, 241, 232, 0.06);
    transition: transform 600ms ease;
  }
  .eb-rec[data-active="true"] .eb-vinyl { animation: eb-spin 3.6s linear infinite; box-shadow: 0 4px 12px -4px rgba(0,0,0,0.7), 0 0 16px -1px var(--rc); }
  .eb-rec[data-active="true"] .eb-vinyl-hole { background: var(--rc); box-shadow: 0 0 8px var(--rc); }
  .eb-vinyl-hole { position: absolute; top: 50%; left: 50%; width: 8px; height: 8px; border-radius: 50%; transform: translate(-50%, -50%); background: linear-gradient(135deg, #ff2d8b, #ffb347); }
  @keyframes eb-spin { to { transform: rotate(360deg); } }
  .eb-rec-meta { display: flex; flex-direction: column; align-items: center; gap: 1px; text-align: center; }
  .eb-rec-artist { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 11px; font-weight: 700; color: rgba(245, 241, 232, 0.92); }
  .eb-rec-track { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-style: italic; font-size: 9.5px; color: rgba(245, 241, 232, 0.45); }

  /* ── note ── */
  .eb-note {
    background: color-mix(in srgb, var(--rc) 7%, transparent);
    border: 1px solid color-mix(in srgb, var(--rc) 34%, transparent);
    border-radius: 6px; padding: 12px 16px; margin-bottom: 18px;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-style: italic; font-size: 14px;
    color: rgba(245, 241, 232, 0.86); display: flex; align-items: baseline; gap: 4px; flex-wrap: wrap;
    transition: background 200ms ease, border-color 200ms ease;
  }
  .eb-note-q { color: var(--rc); font-size: 18px; }
  .eb-note-anchor { margin-left: auto; font-style: normal; font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: rgba(245, 241, 232, 0.5); }
  .eb-note-anchor b { color: var(--rc); }

  /* ── axes ── */
  .eb-axes { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 20px; }
  @media (max-width: 700px) { .eb-axes { grid-template-columns: 1fr; } }
  .eb-axis { border: 1px solid rgba(245, 241, 232, 0.1); border-radius: 6px; padding: 12px 14px; background: rgba(245, 241, 232, 0.015); }
  .eb-axis-label { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase; color: rgba(245, 241, 232, 0.5); }
  .eb-axis-cyan .eb-axis-label { color: var(--brand-cyan); }
  .eb-axis-pink .eb-axis-label { color: var(--brand-pink); }
  .eb-axis-yellow .eb-axis-label { color: var(--brand-yellow); }
  .eb-axis-poles { display: flex; align-items: center; gap: 8px; margin-top: 8px; }
  .eb-pole {
    flex: 1; text-align: center; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 11px;
    color: rgba(245, 241, 232, 0.62); border: 1px solid rgba(245, 241, 232, 0.12); border-radius: 4px; padding: 6px 4px;
    transition: all 220ms ease;
  }
  .eb-axis-vs { color: rgba(245, 241, 232, 0.3); font-size: 12px; }
  .eb-pole[data-lit="true"] {
    color: #0d060f; font-weight: 700;
    background: var(--rc); border-color: transparent;
    box-shadow: 0 0 18px -2px var(--rc);
  }

  /* ── outcome ── */
  .eb-out { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 13px; color: rgba(245, 241, 232, 0.7); }
  .eb-out-arrow { color: var(--brand-green); font-size: 16px; }
  .eb-out-text b { color: #f5f1e8; }
  .eb-bloom { display: inline-flex; gap: 5px; margin-left: auto; }
  .eb-seed { width: 11px; height: 11px; border-radius: 50%; animation: eb-pulse 2.4s ease-in-out infinite; }
  .eb-seed-cyan { background: var(--brand-cyan); box-shadow: 0 0 8px rgba(14, 196, 252, 0.5); }
  .eb-seed-pink { background: var(--brand-pink); box-shadow: 0 0 8px rgba(255, 39, 97, 0.5); }
  .eb-seed-yellow { background: var(--brand-yellow); box-shadow: 0 0 8px rgba(255, 179, 71, 0.5); }
  .eb-seed:nth-child(2) { animation-delay: 0.3s; }
  .eb-seed:nth-child(3) { animation-delay: 0.6s; }
  .eb-seed:nth-child(4) { animation-delay: 0.9s; }
  .eb-seed:nth-child(5) { animation-delay: 1.2s; }
  .eb-seed:nth-child(6) { animation-delay: 1.5s; }
  @keyframes eb-pulse { 0%, 100% { opacity: 0.5; transform: scale(0.85); } 50% { opacity: 1; transform: scale(1.1); } }

  @media (prefers-reduced-motion: reduce) {
    .eb-rec[data-active="true"] .eb-vinyl, .eb-seed { animation: none; }
  }
</style>
