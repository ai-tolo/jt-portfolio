---
// ACT 1 + 2 — Chaos → The Sweep.
//
// A sticky-stage theater. ~60 file chips start scattered and drifting (the
// chaos). As the reader scrolls into the scene, the whole swarm is swept up
// and snaps into the five named bins (Inbox · Jam · Loops · Field · Tracks),
// de-duping and rendering waveforms as it lands. One chip — Audio 14.wav —
// flies into Tracks, highlighted: the protagonist file we follow.
//
// Motion is one toggled CSS phase (chaos → swept); a ↻ replay re-runs it.
// IntersectionObserver fires the sweep; prefers-reduced-motion lands binned
// with no flight. All copy + counters are real values from the build log.

interface Chip { name: string; bin: number; dupe?: boolean; hero?: boolean }

// Bin order matches the product Browse strip framing in the brief.
const BINS = [
  { key: "inbox",  label: "Inbox",  count: 7589, blurb: "unsorted — everything lands here first", accent: "white" },
  { key: "jam",    label: "Jam",    count: 329,  blurb: "long-form musical captures", accent: "cyan" },
  { key: "loops",  label: "Loops",  count: 339,  blurb: "pasteable in Live, -14 LUFS", accent: "yellow" },
  { key: "field",  label: "Field",  count: 1389, blurb: "voice memos + audio pulled from video", accent: "pink" },
  { key: "tracks", label: "Tracks", count: 169,  blurb: "finished songs + their bounces", accent: "green" },
];

// 60 chips, distributed across the five bins. The protagonist + two dup pairs
// live in Tracks. Names are the same scattered-audio vocabulary as the hero.
const CHIPS: Chip[] = [
  // Tracks (8) — protagonist first, two dup pairs
  { name: "Audio 14.wav", bin: 4, hero: true },
  { name: "bounce_v1.wav", bin: 4 },
  { name: "bounce_v1 (2).wav", bin: 4, dupe: true },
  { name: "FINAL_master.wav", bin: 4 },
  { name: "FINAL_master_real.wav", bin: 4, dupe: true },
  { name: "mix_for_jake.wav", bin: 4 },
  { name: "track2_real_final.wav", bin: 4 },
  { name: "2023-02-18.wav", bin: 4 },
  // Inbox (13)
  { name: "New Recording 7.m4a", bin: 0 }, { name: "Untitled.als", bin: 0 },
  { name: "demo_mix.mp3", bin: 0 }, { name: "snippet.wav", bin: 0 },
  { name: "3am.wav", bin: 0 }, { name: "backup_final.wav", bin: 0 },
  { name: "recording.wav", bin: 0 }, { name: "weird synth thing.wav", bin: 0 },
  { name: "the good one.wav", bin: 0 }, { name: "Audio 9.wav", bin: 0 },
  { name: "Audio 15.wav", bin: 0 }, { name: "project_OLD.als", bin: 0 },
  { name: "car demo.m4a", bin: 0 },
  // Jam (12)
  { name: "jam_sunday_2.wav", bin: 1 }, { name: "sunday breakdown.wav", bin: 1 },
  { name: "30min noodle.wav", bin: 1 }, { name: "live take 3.wav", bin: 1 },
  { name: "garage jam.wav", bin: 1 }, { name: "feb session.wav", bin: 1 },
  { name: "looped an hour.wav", bin: 1 }, { name: "basement_4.wav", bin: 1 },
  { name: "warmup.wav", bin: 1 }, { name: "long one.wav", bin: 1 },
  { name: "improv_b.wav", bin: 1 }, { name: "tuesday.wav", bin: 1 },
  // Loops (10)
  { name: "808_sub.wav", bin: 2 }, { name: "guitar loop.wav", bin: 2 },
  { name: "shaker_120.wav", bin: 2 }, { name: "vox_chop.wav", bin: 2 },
  { name: "Splice_kick_03.wav", bin: 2 }, { name: "rhodes_loop.wav", bin: 2 },
  { name: "hat_16.wav", bin: 2 }, { name: "bass_groove.wav", bin: 2 },
  { name: "stab_C.wav", bin: 2 }, { name: "perc_top.wav", bin: 2 },
  // Field (12)
  { name: "voice memo 41.m4a", bin: 3 }, { name: "shower idea.m4a", bin: 3 },
  { name: "chorus?.wav", bin: 3 }, { name: "idea.wav", bin: 3 },
  { name: "lyric fragment.m4a", bin: 3 }, { name: "walking note.m4a", bin: 3 },
  { name: "rain_outside.m4a", bin: 3 }, { name: "humming.m4a", bin: 3 },
  { name: "melody hum.m4a", bin: 3 }, { name: "2am thought.m4a", bin: 3 },
  { name: "from video_12.wav", bin: 3 }, { name: "phone vox.m4a", bin: 3 },
];

// deterministic fractional pseudo-random
const fr = (x: number) => x - Math.floor(x);
const rnd = (i: number, s: number) => fr(Math.sin((i + 1) * s) * 43758.5453);

// per-bin running slot index for target stacking
const slotCount = [0, 0, 0, 0, 0];
const chips = CHIPS.map((c, i) => {
  const slot = slotCount[c.bin]++;
  const binCenter = c.bin * 20 + 10;          // % across the stage
  // % down, stacked in the bin. Starts at 21% — BELOW the kicker/counters
  // header band so the left column never collides with the act subtext. Step
  // tuned so the tallest column (13 chips) nests inside its frame (84%).
  const ty = 21 + slot * 4.6;
  // chaos scatter
  const cx = 6 + rnd(i, 12.9898) * 88;
  const cy = 8 + rnd(i, 78.233) * 80;
  const rot = (rnd(i, 39.425) - 0.5) * 26;
  const ddur = 7 + rnd(i, 21.17) * 7;
  const ddelay = -rnd(i, 5.31) * 8;
  const dx = (rnd(i, 8.7) - 0.5) * 24;         // chaos drift vector
  const dy = (rnd(i, 3.3) - 0.5) * 20;
  return { ...c, cx, cy, tx: binCenter, ty, rot, ddur, ddelay, dx, dy, slot };
});
const maxSlots = Math.max(...slotCount);
---

<section class="ctb" aria-label="Chaos to catalog">
  <div class="ctb-sticky">
    <div class="ctb-stage" data-ctb-stage data-phase="chaos" style={`--rows:${maxSlots}`}>

      <!-- phase kicker overlay -->
      <div class="ctb-kicker" data-ctb-kicker>
        <p class="ctb-kicker-chaos">
          <span class="ctb-eyebrow">Act I — the mess</span>
          Eight years of sound. Four drives. Forty-seven sub-folders deep.
          Somewhere in here is the vocal you hummed into your phone last Tuesday.
        </p>
        <p class="ctb-kicker-swept">
          <span class="ctb-eyebrow ctb-eyebrow-swept">Act II — the sweep</span>
          So I built the thing that sweeps it all up. One inventory that knows
          what it has, sorted by what it actually is.
        </p>
      </div>

      <!-- counters -->
      <div class="ctb-counters" data-ctb-counters aria-hidden="true">
        <div class="ctb-counter"><b data-ctb-n data-to="20279">0</b><span>catalogued</span></div>
        <div class="ctb-counter"><b data-ctb-n data-to="1718">0</b><span>auto-sorted</span></div>
        <div class="ctb-counter"><b data-ctb-n data-to="20">0</b><span>dup groups merged</span></div>
      </div>

      <!-- bins backdrop -->
      <div class="ctb-bins" aria-hidden="true">
        {BINS.map((b) => (
          <div class={`ctb-bin ctb-bin-${b.accent}`} data-bin-key={b.key}>
            <div class="ctb-bin-frame"></div>
            <div class="ctb-bin-foot">
              <span class="ctb-bin-label">{b.label}</span>
              <span class="ctb-bin-count" data-ctb-binn data-to={String(b.count)}>0</span>
              <span class="ctb-bin-blurb">{b.blurb}</span>
            </div>
          </div>
        ))}
      </div>

      <!-- chips -->
      <div class="ctb-chips">
        {chips.map((c) => (
          <span
            class:list={["ctb-chip", { "ctb-chip-hero": c.hero, "ctb-chip-dupe": c.dupe }]}
            data-bin={c.bin}
            style={`--cx:${c.cx}%; --cy:${c.cy}%; --tx:${c.tx}%; --ty:${c.ty}%; --rot:${c.rot}deg; --ddur:${c.ddur}s; --ddelay:${c.ddelay}s; --dx:${c.dx}px; --dy:${c.dy}px;`}
          >
            <span class="ctb-chip-inner">
              <svg class="ctb-chip-wave" viewBox="0 0 40 12" preserveAspectRatio="none" aria-hidden="true">
                <path d="M0,6 Q3,1 6,6 T12,6 Q15,11 18,6 T24,6 Q27,2 30,6 T36,6 T40,6" fill="none" stroke="currentColor" stroke-width="1.1"/>
              </svg>
              <span class="ctb-chip-name">{c.name}</span>
              {c.dupe && <span class="ctb-chip-dup">⤬ dup</span>}
            </span>
          </span>
        ))}
      </div>

      <!-- replay -->
      <button type="button" class="ctb-replay" data-ctb-replay>↻ watch it organize</button>
    </div>
  </div>
  <!-- sweep trigger lives in the tall scroll track (not the pinned stage) so it
       actually crosses the viewport as you scroll. -->
  <div class="ctb-fire" data-ctb-fire aria-hidden="true"></div>
</section>

<script>
  const stages = document.querySelectorAll<HTMLElement>("[data-ctb-stage]");
  stages.forEach((stage) => {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const section = stage.closest<HTMLElement>(".ctb");
    const replay = stage.querySelector<HTMLButtonElement>("[data-ctb-replay]");
    const counters = stage.querySelectorAll<HTMLElement>("[data-ctb-n]");
    const binCounts = stage.querySelectorAll<HTMLElement>("[data-ctb-binn]");
    let swept = false;

    const countUp = (el: HTMLElement, to: number, ms: number) => {
      const final = to.toLocaleString("en-US");
      if (reduce) { el.textContent = final; return; }
      const start = performance.now();
      const tick = (now: number) => {
        const t = Math.min(1, (now - start) / ms);
        const eased = 1 - Math.pow(1 - t, 3);
        el.textContent = Math.round(to * eased).toLocaleString("en-US");
        if (t < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
      // Guarantee the final value lands even if rAF is throttled/never fires
      // (headless preview tabs do this). Real browsers animate; this is a no-op
      // re-set there.
      window.setTimeout(() => { el.textContent = final; }, ms + 120);
    };

    const sweep = () => {
      if (swept) return;
      swept = true;
      stage.dataset.phase = "swept";
      counters.forEach((c) => countUp(c, Number(c.dataset.to || "0"), 1200));
      binCounts.forEach((c) => countUp(c, Number(c.dataset.to || "0"), 1400));
    };

    const reset = () => {
      swept = false;
      stage.dataset.phase = "chaos";
      counters.forEach((c) => (c.textContent = "0"));
      binCounts.forEach((c) => (c.textContent = "0"));
    };

    // Fire the sweep once the reader is ~a third of the way through the pinned
    // section. Scroll-progress is robust where an IntersectionObserver sentinel
    // isn't (the sticky stage keeps a sentinel pinned, never crossing).
    let manualReset = false;
    const onScroll = () => {
      if (swept || manualReset || !section) return;
      const total = section.offsetHeight - window.innerHeight;
      const scrolled = -section.getBoundingClientRect().top;
      if (total > 0 && scrolled / total >= 0.32) sweep();
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();

    replay?.addEventListener("click", () => {
      manualReset = true;
      reset();
      window.setTimeout(() => { manualReset = false; sweep(); }, reduce ? 0 : 420);
    });
  });
</script>

<style>
  .ctb {
    position: relative;
    height: 215vh;
    margin-top: 10px;
  }
  .ctb-sticky {
    position: sticky;
    top: 6vh;
    height: 88vh;
    display: flex;
    align-items: stretch;
  }
  .ctb-stage {
    position: relative;
    flex: 1;
    margin: 0 auto;
    max-width: 1280px;
    width: 100%;
    border: 1px solid var(--cs-line);
    border-radius: 8px;
    background:
      radial-gradient(120% 90% at 50% 0%, rgba(255, 39, 97, 0.05), transparent 60%),
      linear-gradient(180deg, #0c0a12 0%, #08070d 100%);
    overflow: hidden;
    box-shadow: 0 30px 80px -40px rgba(0,0,0,0.8);
  }

  /* ── kicker copy ── */
  .ctb-kicker {
    position: absolute;
    top: 0; left: 0; right: 0;
    z-index: 6;
    padding: 26px 30px 0;
    pointer-events: none;
  }
  .ctb-kicker p {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 14px;
    line-height: 1.55;
    max-width: 50ch;
    margin: 0;
    transition: opacity 500ms ease;
  }
  .ctb-eyebrow {
    display: block;
    font-size: 10px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--brand-pink);
    margin-bottom: 8px;
  }
  .ctb-eyebrow-swept { color: var(--brand-green); }
  .ctb-kicker-chaos { color: rgba(245,241,232,0.74); }
  .ctb-kicker-swept {
    position: absolute;
    top: 26px; left: 30px; right: 30px;
    color: rgba(245,241,232,0.82);
  }
  .ctb-stage[data-phase="chaos"] .ctb-kicker-swept { opacity: 0; }
  .ctb-stage[data-phase="swept"] .ctb-kicker-chaos { opacity: 0; }

  /* ── counters ── */
  .ctb-counters {
    position: absolute;
    top: 24px; right: 30px;
    z-index: 6;
    display: flex;
    gap: 22px;
    opacity: 0;
    transform: translateY(-6px);
    transition: opacity 500ms ease 260ms, transform 500ms ease 260ms;
  }
  .ctb-stage[data-phase="swept"] .ctb-counters { opacity: 1; transform: none; }
  .ctb-counter { text-align: right; }
  .ctb-counter b {
    display: block;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-style: italic;
    font-size: 22px;
    font-weight: 700;
    color: #f5f1e8;
    font-feature-settings: "tnum";
  }
  .ctb-counter span {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 9px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(245,241,232,0.45);
  }

  /* ── bins ── */
  .ctb-bins {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    z-index: 1;
  }
  .ctb-bin { position: relative; }
  .ctb-bin-frame {
    position: absolute;
    inset: 18% 8% 16% 8%;
    border: 1px dashed rgba(245,241,232,0.12);
    border-radius: 6px;
    opacity: 0;
    transform: scale(0.96);
    transition: opacity 500ms ease, transform 500ms ease, border-color 500ms ease;
  }
  .ctb-stage[data-phase="swept"] .ctb-bin-frame { opacity: 1; transform: none; }
  .ctb-bin-foot {
    position: absolute;
    bottom: 4%; left: 8%; right: 8%;
    text-align: center;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 500ms ease 120ms, transform 500ms ease 120ms;
  }
  .ctb-stage[data-phase="swept"] .ctb-bin-foot { opacity: 1; transform: none; }
  .ctb-bin-label {
    display: block;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-style: italic;
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 0.02em;
  }
  .ctb-bin-count {
    display: block;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 12px;
    font-feature-settings: "tnum";
    color: rgba(245,241,232,0.55);
    margin-top: 2px;
  }
  .ctb-bin-blurb {
    display: block;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 9.5px;
    line-height: 1.3;
    color: rgba(245,241,232,0.34);
    margin-top: 4px;
  }
  .ctb-bin-white .ctb-bin-label { color: #f5f1e8; }
  .ctb-bin-cyan  .ctb-bin-label { color: var(--brand-cyan); }
  .ctb-bin-yellow .ctb-bin-label { color: var(--brand-yellow); }
  .ctb-bin-pink  .ctb-bin-label { color: var(--brand-pink); }
  .ctb-bin-green .ctb-bin-label { color: var(--brand-green); }
  .ctb-stage[data-phase="swept"] .ctb-bin-cyan  .ctb-bin-frame { border-color: rgba(14,196,252,0.3); }
  .ctb-stage[data-phase="swept"] .ctb-bin-yellow .ctb-bin-frame { border-color: rgba(255,179,71,0.3); }
  .ctb-stage[data-phase="swept"] .ctb-bin-pink  .ctb-bin-frame { border-color: rgba(255,39,97,0.3); }
  .ctb-stage[data-phase="swept"] .ctb-bin-green .ctb-bin-frame { border-color: rgba(0,255,77,0.3); }

  /* ── chips ── */
  .ctb-chips { position: absolute; inset: 0; z-index: 3; }
  .ctb-chip {
    position: absolute;
    left: var(--cx);
    top: var(--cy);
    transform: translate(-50%, -50%);
    transition: left 1100ms cubic-bezier(0.22, 1, 0.36, 1),
                top 1100ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: left, top;
  }
  /* chaos drift lives on the inner so it composes with the chip's flight */
  .ctb-chip-inner {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 9px;
    border-radius: 5px;
    background: linear-gradient(180deg, rgba(42, 34, 52, 0.96), rgba(28, 22, 38, 0.96));
    border: 1px solid rgba(245,241,232,0.2);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11px;
    white-space: nowrap;
    color: rgba(245,241,232,0.82);
    transform: rotate(var(--rot));
    animation: ctb-drift var(--ddur) ease-in-out var(--ddelay) infinite alternate;
    box-shadow: 0 6px 18px -8px rgba(0,0,0,0.85);
  }
  .ctb-chip-wave { width: 26px; height: 11px; color: rgba(245,241,232,0.3); opacity: 0; transition: opacity 500ms ease 500ms; flex: 0 0 auto; }
  .ctb-chip-name { overflow: hidden; text-overflow: ellipsis; max-width: 15vw; }
  .ctb-chip-dup {
    font-size: 9px; color: var(--brand-pink);
    opacity: 0; transition: opacity 300ms ease;
  }

  @keyframes ctb-drift {
    from { transform: rotate(var(--rot)) translate(0, 0); }
    to   { transform: rotate(var(--rot)) translate(var(--dx), var(--dy)); }
  }

  /* swept: chips fly to their bin slot, stop drifting, straighten, get legible */
  .ctb-stage[data-phase="swept"] .ctb-chip { left: var(--tx); top: var(--ty); }
  .ctb-stage[data-phase="swept"] .ctb-chip-inner {
    animation: none;
    transform: rotate(0deg);
    background: linear-gradient(180deg, rgba(26, 20, 34, 0.97), rgba(18, 14, 24, 0.97));
    border-color: rgba(245,241,232,0.22);
    color: rgba(245,241,232,0.86);
    transition: transform 700ms ease, background 500ms ease, border-color 500ms ease, color 500ms ease;
  }
  .ctb-stage[data-phase="swept"] .ctb-chip-wave { opacity: 1; color: var(--brand-cyan); }

  /* protagonist */
  .ctb-chip-hero { z-index: 5; }
  .ctb-chip-hero .ctb-chip-inner {
    border-color: rgba(0,255,77,0.5);
    color: #00ff4d;
    box-shadow: 0 0 16px rgba(0,255,77,0.18);
  }
  .ctb-stage[data-phase="swept"] .ctb-chip-hero .ctb-chip-inner {
    color: #00ff4d;
    border-color: rgba(0,255,77,0.6);
  }
  .ctb-stage[data-phase="swept"] .ctb-chip-hero .ctb-chip-wave { color: #00ff4d; }

  /* dup chips merge: fly to bin, then collapse */
  .ctb-stage[data-phase="swept"] .ctb-chip-dupe {
    animation: ctb-merge 700ms ease 1100ms forwards;
  }
  .ctb-stage[data-phase="swept"] .ctb-chip-dupe .ctb-chip-dup { opacity: 1; transition: opacity 300ms ease 1100ms; }
  @keyframes ctb-merge {
    to { opacity: 0; transform: translate(-50%, -50%) scale(0.6); }
  }

  /* ── replay ── */
  .ctb-replay {
    position: absolute;
    bottom: 16px; left: 50%;
    transform: translateX(-50%);
    z-index: 7;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11px;
    letter-spacing: 0.1em;
    color: rgba(245,241,232,0.7);
    background: rgba(20,16,26,0.85);
    border: 1px solid rgba(245,241,232,0.2);
    border-radius: 20px;
    padding: 7px 16px;
    cursor: pointer;
    opacity: 0;
    transition: opacity 400ms ease 700ms, color 160ms ease, border-color 160ms ease;
  }
  .ctb-stage[data-phase="swept"] .ctb-replay { opacity: 1; }
  .ctb-replay:hover { color: #f5f1e8; border-color: rgba(245,241,232,0.45); }

  .ctb-fire { position: absolute; top: 92vh; left: 0; width: 1px; height: 1px; pointer-events: none; }

  @media (max-width: 720px) {
    .ctb { height: 180vh; }
    .ctb-sticky { top: 5vh; height: 90vh; }
    .ctb-chip-inner { font-size: 9.5px; padding: 4px 6px; }
    .ctb-chip-name { max-width: 16vw; }
    .ctb-chip-wave { display: none; }
    .ctb-counters { position: static; flex-direction: row; gap: 14px; padding: 0 30px; margin-top: 64px; justify-content: flex-start; }
    .ctb-counter { text-align: left; }
    .ctb-counter b { font-size: 16px; }
    .ctb-bin-blurb { display: none; }
    .ctb-kicker p { font-size: 12px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ctb-chip { transition: none; }
    .ctb-chip-inner { animation: none !important; }
    .ctb-stage[data-phase="swept"] .ctb-chip-dupe { animation: none; opacity: 0; }
  }
</style>
