---
// ACT 1 + 2 — Chaos to catalog, scroll-scrubbed.
//
// A sticky stage the reader scrubs: as you scroll the pinned section, ~55
// scattered file chips fly into the five named bins (Inbox, Jam, Loops, Field,
// Tracks), counters climb, duplicate copies fold away, and the protagonist
// (Audio 14.wav) lands last in Tracks. Everything on screen is a pure function
// of one scroll fraction p, so the sweep is fully reversible (scroll back and it
// un-sweeps) and there are no timers to get stuck.
//
// Robust by design: p comes from a passive scroll handler reading the section's
// rect over its scrollable height (NOT a CSS scroll-timeline, NOT an
// IntersectionObserver, both of which the preview throttles). The whole frame is
// painted by one idempotent apply(p); a test hook (root.__ctb.setProgress) drives
// it without scrolling. Transform-only motion (no left/top). prefers-reduced-
// motion paints one settled poster and never scrubs. All copy + counts are real.

interface Chip { name: string; bin: number; dupe?: boolean; hero?: boolean }

// Bin order matches the product Browse strip framing in the brief.
const BINS = [
  { key: "inbox",  label: "Inbox",  count: 7589, blurb: "unsorted; everything lands here first", accent: "white" },
  { key: "jam",    label: "Jam",    count: 329,  blurb: "long-form musical captures", accent: "cyan" },
  { key: "loops",  label: "Loops",  count: 339,  blurb: "pasteable in Live, -14 LUFS", accent: "yellow" },
  { key: "field",  label: "Field",  count: 1389, blurb: "voice memos + audio pulled from video", accent: "pink" },
  { key: "tracks", label: "Tracks", count: 169,  blurb: "finished songs + their bounces", accent: "green" },
];

// The chips, distributed across the five bins. The protagonist + two dup pairs
// live in Tracks. Names are the same scattered-audio vocabulary as the hero.
const CHIPS: Chip[] = [
  // Tracks (8) — protagonist first, two dup pairs
  { name: "Audio 14.m4a", bin: 4, hero: true },
  { name: "bounce_v1.wav", bin: 4 },
  { name: "bounce_v1 (2).wav", bin: 4, dupe: true },
  { name: "FINAL_master.wav", bin: 4 },
  { name: "FINAL_master_real.wav", bin: 4, dupe: true },
  { name: "mix_for_jake.wav", bin: 4 },
  { name: "track2_real_final.wav", bin: 4 },
  { name: "2023-02-18.wav", bin: 4 },
  // Inbox (13)
  { name: "New Recording 7.m4a", bin: 0 }, { name: "Untitled.als", bin: 0 },
  { name: "demo_mix.mp3", bin: 0 }, { name: "snippet.wav", bin: 0 },
  { name: "3am.wav", bin: 0 }, { name: "backup_final.wav", bin: 0 },
  { name: "recording.wav", bin: 0 }, { name: "weird synth thing.wav", bin: 0 },
  { name: "the good one.wav", bin: 0 }, { name: "Audio 9.wav", bin: 0 },
  { name: "Audio 15.wav", bin: 0 }, { name: "project_OLD.als", bin: 0 },
  { name: "car demo.m4a", bin: 0 },
  // Jam (12)
  { name: "jam_sunday_2.wav", bin: 1 }, { name: "sunday breakdown.wav", bin: 1 },
  { name: "30min noodle.wav", bin: 1 }, { name: "live take 3.wav", bin: 1 },
  { name: "garage jam.wav", bin: 1 }, { name: "feb session.wav", bin: 1 },
  { name: "looped an hour.wav", bin: 1 }, { name: "basement_4.wav", bin: 1 },
  { name: "warmup.wav", bin: 1 }, { name: "long one.wav", bin: 1 },
  { name: "improv_b.wav", bin: 1 }, { name: "tuesday.wav", bin: 1 },
  // Loops (10)
  { name: "808_sub.wav", bin: 2 }, { name: "guitar loop.wav", bin: 2 },
  { name: "shaker_120.wav", bin: 2 }, { name: "vox_chop.wav", bin: 2 },
  { name: "Splice_kick_03.wav", bin: 2 }, { name: "rhodes_loop.wav", bin: 2 },
  { name: "hat_16.wav", bin: 2 }, { name: "bass_groove.wav", bin: 2 },
  { name: "stab_C.wav", bin: 2 }, { name: "perc_top.wav", bin: 2 },
  // Field (12)
  { name: "voice memo 41.m4a", bin: 3 }, { name: "shower idea.m4a", bin: 3 },
  { name: "chorus?.wav", bin: 3 }, { name: "idea.wav", bin: 3 },
  { name: "lyric fragment.m4a", bin: 3 }, { name: "walking note.m4a", bin: 3 },
  { name: "rain_outside.m4a", bin: 3 }, { name: "humming.m4a", bin: 3 },
  { name: "melody hum.m4a", bin: 3 }, { name: "2am thought.m4a", bin: 3 },
  { name: "from video_12.wav", bin: 3 }, { name: "phone vox.m4a", bin: 3 },
];

// deterministic fractional pseudo-random
const fr = (x: number) => x - Math.floor(x);
const rnd = (i: number, s: number) => fr(Math.sin((i + 1) * s) * 43758.5453);

// per-bin running slot index for target stacking
const slotCount = [0, 0, 0, 0, 0];
const chips = CHIPS.map((c, i) => {
  const slot = slotCount[c.bin]++;
  const binCenter = c.bin * 20 + 10;          // % across the stage
  // % down, stacked in the bin. Starts at 21% — BELOW the kicker/counters band.
  const ty = 21 + slot * 4.6;
  // chaos scatter
  const cx = 6 + rnd(i, 12.9898) * 88;
  const cy = 8 + rnd(i, 78.233) * 80;
  const rot = (rnd(i, 39.425) - 0.5) * 26;
  return { ...c, cx, cy, tx: binCenter, ty, rot, binIndex: c.bin, slot };
});
const maxSlots = Math.max(...slotCount);
---

<section class="ctb" aria-label="Chaos to catalog">
  <div class="ctb-sticky">
    <div class="ctb-stage" data-ctb-stage data-beat="0" style={`--rows:${maxSlots}; --resolve:0`}>

      <!-- per-beat captions (stacked; one is opaque at a time, driven by p) -->
      <div class="ctb-kicker">
        <p class="ctb-caption" data-ctb-caption style="opacity:1">
          <span class="ctb-eyebrow ctb-eyebrow-pink">the problem</span>
          Twenty thousand files. Four drives, iCloud, the Voice&nbsp;Memos vault,
          friends' DMs. No master list, no way to even ask what's in here.
        </p>
        <p class="ctb-caption" data-ctb-caption style="opacity:0">
          <span class="ctb-eyebrow ctb-eyebrow-green">the sweep</span>
          Every file read by sound, fingerprinted, and flown into the bin it
          actually belongs in. Watch the pile become a shape.
        </p>
        <p class="ctb-caption" data-ctb-caption style="opacity:0">
          <span class="ctb-eyebrow ctb-eyebrow-yellow">deduped</span>
          Same take, three names. The catalog hears that they are identical and
          folds the copies away. Twenty groups, gone.
        </p>
        <p class="ctb-caption" data-ctb-caption style="opacity:0">
          <span class="ctb-eyebrow ctb-eyebrow-cyan">a catalog</span>
          Twenty thousand two hundred seventy nine files, read and filed. Now you
          can browse any category, or ask it anything. Audio&nbsp;14.m4a is in
          Tracks, waiting. Scroll on.
        </p>
      </div>

      <!-- counters (present from the start, climb with p) -->
      <div class="ctb-counters" aria-hidden="true">
        <div class="ctb-counter"><b data-ctb-counter="catalogued">0</b><span>catalogued</span></div>
        <div class="ctb-counter"><b data-ctb-counter="autosorted">0</b><span>auto-sorted</span></div>
        <div class="ctb-counter"><b data-ctb-counter="dupgroups">0</b><span>dup groups merged</span></div>
      </div>

      <!-- bins backdrop: labeled UP FRONT; frames fill toward their accent as
           their chips land (driven by --fill) -->
      <div class="ctb-bins" aria-hidden="true">
        {BINS.map((b) => (
          <div class={`ctb-bin ctb-bin-${b.accent}`} data-bin-key={b.key} data-bin-frame style="--fill:0">
            <div class="ctb-bin-frame"></div>
            <div class="ctb-bin-foot">
              <span class="ctb-bin-label">{b.label}</span>
              <span class="ctb-bin-count" data-ctb-binn>0</span>
              <span class="ctb-bin-blurb">{b.blurb}</span>
            </div>
          </div>
        ))}
      </div>

      <!-- chips: positioned by transform alone (no left/top). The SSR inline
           transform is the scatter; apply(p) owns it from then on. Decorative
           theater, hidden from the a11y tree (the section aria-label + the
           surrounding prose carry the narrative). -->
      <div class="ctb-chips" aria-hidden="true">
        {chips.map((c) => (
          <span
            class:list={["ctb-chip", { "ctb-chip-hero": c.hero, "ctb-chip-dupe": c.dupe }]}
            data-cx={c.cx} data-cy={c.cy} data-tx={c.tx} data-ty={c.ty}
            data-rot={c.rot} data-bin={c.binIndex} data-slot={c.slot}
            style={`--lit:0; transform: translate(${c.cx}cqw, ${c.cy}cqh) translate(-50%, -50%) rotate(${c.rot}deg);`}
          >
            <span class="ctb-chip-inner">
              <svg class="ctb-chip-wave" viewBox="0 0 40 12" preserveAspectRatio="none" aria-hidden="true">
                <path d="M0,6 Q3,1 6,6 T12,6 Q15,11 18,6 T24,6 Q27,2 30,6 T36,6 T40,6" fill="none" stroke="currentColor" stroke-width="1.1"/>
              </svg>
              <span class="ctb-chip-name">{c.name}</span>
              {c.dupe && <span class="ctb-chip-dup">⤬ dup</span>}
              {c.hero && <span class="ctb-chip-follow">▸ the one we follow</span>}
            </span>
          </span>
        ))}
      </div>

      <!-- scroll-progress cue -->
      <div class="ctb-prog" aria-hidden="true">
        <i class="ctb-prog-fill" data-ctb-prog-fill></i>
        <span class="ctb-prog-pct" data-ctb-prog-pct>0%</span>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>(".ctb").forEach((section) => {
    const stage = section.querySelector<HTMLElement>("[data-ctb-stage]");
    if (!stage) return;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const clamp01 = (x: number) => Math.max(0, Math.min(1, x));
    const easeOutCubic = (t: number) => 1 - Math.pow(1 - t, 3);

    // ── precompute one frozen record per chip (scatter + target + sweep window) ──
    const SW0 = 0.22, SW1 = 0.70;
    const els = [...stage.querySelectorAll<HTMLElement>(".ctb-chip")];
    const PRE = els.map((el, i) => {
      const cx = +(el.dataset.cx || 0), cy = +(el.dataset.cy || 0);
      const tx = +(el.dataset.tx || 0), ty = +(el.dataset.ty || 0);
      const rot = +(el.dataset.rot || 0);
      const binIndex = +(el.dataset.bin || 0), slotIndex = +(el.dataset.slot || 0);
      const dupe = el.classList.contains("ctb-chip-dupe");
      const hero = el.classList.contains("ctb-chip-hero");
      // bin-then-slot stagger, compressed into the leading 0.08 of the sweep band
      const start = binIndex * 0.06 + slotIndex * 0.004 + (hero ? 0.05 : 0);
      const s0 = hero ? SW0 + 0.06 : SW0 + (start / 0.34) * 0.08;
      return { el, i, cx, cy, tx, ty, rot, binIndex, slotIndex, dupe, hero, s0, s1: SW1 };
    });

    const captions = [...stage.querySelectorAll<HTMLElement>("[data-ctb-caption]")];
    const counters: Record<string, HTMLElement | null> = {
      catalogued: stage.querySelector('[data-ctb-counter="catalogued"]'),
      autosorted: stage.querySelector('[data-ctb-counter="autosorted"]'),
      dupgroups: stage.querySelector('[data-ctb-counter="dupgroups"]'),
    };
    const binFrames = [...stage.querySelectorAll<HTMLElement>("[data-bin-frame]")];
    const binCounts = [...stage.querySelectorAll<HTMLElement>("[data-ctb-binn]")];
    const progFill = stage.querySelector<HTMLElement>("[data-ctb-prog-fill]");
    const progPct = stage.querySelector<HTMLElement>("[data-ctb-prog-pct]");
    const BIN_TARGETS = [7589, 329, 339, 1389, 169];
    const fmt = (n: number) => n.toLocaleString("en-US");
    const setCounter = (k: string, v: number) => { const el = counters[k]; if (el) el.textContent = fmt(v); };

    const heroScale = (p: number) => {
      const a = clamp01((p - 0.70) / 0.04);   // 1 -> 1.16 across 0.70..0.74
      const b = clamp01((p - 0.74) / 0.04);   // back to 1 across 0.74..0.78
      return 1 + 0.16 * (a - b);
    };

    // ── the single source of truth: paint the whole frame from p ──
    function apply(p: number) {
      p = clamp01(p);
      const beat = p < 0.22 ? 0 : p < 0.70 ? 1 : p < 0.88 ? 2 : 3;
      stage!.dataset.beat = String(beat);
      captions.forEach((c, idx) => (c.style.opacity = idx === beat ? "1" : "0"));

      const fill = [0, 0, 0, 0, 0], cnt = [0, 0, 0, 0, 0];
      for (const r of PRE) {
        const ct = clamp01((p - r.s0) / (r.s1 - r.s0));
        const e = easeOutCubic(ct);
        const X = r.cx + (r.tx - r.cx) * e;
        const Y = r.cy + (r.ty - r.cy) * e;
        const R = r.rot * (1 - e);
        // chaos wobble: scroll-driven, fades out as the chip flies (e -> 1)
        const dX = (1 - e) * 0.6 * Math.sin(p * 6.283 * 1.3 + r.i);
        const dY = (1 - e) * 0.5 * Math.cos(p * 6.283 * 1.1 + r.i);
        let S = 1, O = 1;
        if (r.dupe) { const t = clamp01((p - 0.70) / 0.18); S = 1 - 0.4 * t; O = 1 - t; }
        else if (r.hero) { S = heroScale(p); }
        r.el.style.transform =
          `translate(${(X + dX).toFixed(2)}cqw, ${(Y + dY).toFixed(2)}cqh) translate(-50%, -50%) rotate(${R.toFixed(2)}deg) scale(${S.toFixed(3)})`;
        r.el.style.opacity = O !== 1 ? O.toFixed(3) : "";
        r.el.style.setProperty("--lit", e.toFixed(3));
        if (r.hero) r.el.style.setProperty("--glow", clamp01((p - 0.70) / 0.06).toFixed(3));
        fill[r.binIndex] += e; cnt[r.binIndex] += 1;
      }
      binFrames.forEach((bf, b) => bf.style.setProperty("--fill", (cnt[b] ? fill[b] / cnt[b] : 0).toFixed(3)));

      const rmp = easeOutCubic(clamp01((p - 0.22) / 0.56));
      setCounter("catalogued", Math.floor(20279 * rmp));
      setCounter("autosorted", Math.floor(1718 * rmp));
      setCounter("dupgroups", Math.floor(20 * rmp));
      binCounts.forEach((el, b) => (el.textContent = fmt(Math.floor(BIN_TARGETS[b] * rmp))));

      stage!.style.setProperty("--resolve", clamp01((p - 0.88) / 0.12).toFixed(3));
      if (progFill) progFill.style.transform = `scaleX(${p.toFixed(4)})`;
      if (progPct) progPct.textContent = Math.round(p * 100) + "%";
      stage!.dataset.p = p.toFixed(4);
    }

    // ── test hook: drive the frame deterministically without scrolling/rAF ──
    (section as any).__ctb = {
      setProgress: (p: number) => apply(clamp01(p)),
      apply,
      get beat() { return Number(stage!.dataset.beat); },
      get p() { return Number(stage!.dataset.p); },
    };
    (window as any).__ctb = (section as any).__ctb;

    if (reduce) {
      // one settled poster, no scrub, no scroll listener
      apply(1);
      return;
    }

    // ── scroll driver: rect-fraction, passive, rAF-coalesced. apply() stays
    //    directly callable + idempotent, so the test hook never needs rAF. ──
    let queued = false, lastP = 0;
    const onScroll = () => {
      const total = section.offsetHeight - window.innerHeight;
      const scrolled = -section.getBoundingClientRect().top;
      lastP = total > 0 ? clamp01(scrolled / total) : 0;
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => { queued = false; apply(lastP); });
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    apply(0);      // paint the initial frame immediately (don't wait for a scroll)
    onScroll();
  });
</script>

<style>
  .ctb { position: relative; height: 215vh; margin-top: 10px; }
  .ctb-sticky { position: sticky; top: 6vh; height: 88vh; display: flex; align-items: stretch; }
  .ctb-stage {
    position: relative; flex: 1; margin: 0 auto; max-width: 1280px; width: 100%;
    container-type: size;          /* makes cqw/cqh equal 1% of the stage box */
    border: 1px solid var(--cs-line); border-radius: 8px;
    background:
      radial-gradient(120% 90% at 50% 0%, rgba(255, 39, 97, 0.05), transparent 60%),
      linear-gradient(180deg, #0c0a12 0%, #08070d 100%);
    overflow: hidden; box-shadow: 0 30px 80px -40px rgba(0,0,0,0.8);
    /* resolve tint: neutral -> cyan as p crosses the last beat */
    border-color: color-mix(in srgb, var(--brand-cyan) calc(var(--resolve, 0) * 18%), var(--cs-line));
  }

  /* ── captions (stacked, opacity-toggled per beat) ── */
  .ctb-kicker { position: absolute; top: 0; left: 0; right: 0; z-index: 6; padding: 26px 30px 0; pointer-events: none; }
  .ctb-caption {
    position: absolute; top: 26px; left: 30px; right: 30px;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 14px; line-height: 1.55;
    max-width: 52ch; margin: 0; color: rgba(245, 241, 232, 0.78);
    padding: 13px 16px; border-radius: 9px;
    background: rgba(8, 7, 13, 0.64); border: 1px solid rgba(245, 241, 232, 0.08);
    backdrop-filter: blur(5px); -webkit-backdrop-filter: blur(5px);
    box-shadow: 0 12px 32px -18px rgba(0, 0, 0, 0.8);
    transition: opacity 420ms ease;
  }
  .ctb-eyebrow {
    display: inline-flex; align-items: center; gap: 9px;
    font-size: 12.5px; font-weight: 700; letter-spacing: 0.24em; text-transform: uppercase;
    color: var(--brand-pink); margin-bottom: 12px;
  }
  .ctb-eyebrow::before { content: ""; width: 22px; height: 3px; border-radius: 2px; background: currentColor; box-shadow: 0 0 10px currentColor; }
  .ctb-eyebrow-pink { color: var(--brand-pink); }
  .ctb-eyebrow-green { color: var(--brand-green); }
  .ctb-eyebrow-yellow { color: var(--brand-yellow); }
  .ctb-eyebrow-cyan { color: var(--brand-cyan); }

  /* ── counters ── */
  .ctb-counters { position: absolute; top: 24px; right: 30px; z-index: 6; display: flex; gap: 22px; }
  .ctb-counter { text-align: right; }
  .ctb-counter b {
    display: block; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-style: italic;
    font-size: 22px; font-weight: 700; color: #f5f1e8; font-feature-settings: "tnum";
  }
  .ctb-counter span {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 9px;
    letter-spacing: 0.16em; text-transform: uppercase; color: rgba(245,241,232,0.45);
  }

  /* ── bins (labeled up front; frame fills toward accent via --fill) ── */
  .ctb-bins { position: absolute; inset: 0; display: grid; grid-template-columns: repeat(5, 1fr); z-index: 1; }
  .ctb-bin { position: relative; --bin-accent: #f5f1e8; }
  .ctb-bin-cyan { --bin-accent: var(--brand-cyan); }
  .ctb-bin-yellow { --bin-accent: var(--brand-yellow); }
  .ctb-bin-pink { --bin-accent: var(--brand-pink); }
  .ctb-bin-green { --bin-accent: var(--brand-green); }
  .ctb-bin-frame {
    position: absolute; inset: 18% 8% 16% 8%;
    border: 1px dashed; border-radius: 6px;
    border-color: color-mix(in srgb, var(--bin-accent) calc(var(--fill, 0) * 100%), rgba(245,241,232,0.16));
    opacity: calc(0.5 + 0.5 * var(--fill, 0));
  }
  .ctb-bin-foot { position: absolute; bottom: 4%; left: 8%; right: 8%; text-align: center; }
  .ctb-bin-label {
    display: block; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-style: italic;
    font-weight: 700; font-size: 15px; letter-spacing: 0.02em; color: var(--bin-accent);
  }
  .ctb-bin-count {
    display: block; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12px;
    font-feature-settings: "tnum"; color: rgba(245,241,232,0.55); margin-top: 2px;
  }
  .ctb-bin-blurb {
    display: block; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 9.5px;
    line-height: 1.3; color: rgba(245,241,232,0.34); margin-top: 4px;
  }

  /* ── chips (transform-only; JS owns the transform; no transition on it) ── */
  .ctb-chips { position: absolute; inset: 0; z-index: 3; }
  .ctb-chip { position: absolute; left: 0; top: 0; will-change: transform; }
  .ctb-chip-inner {
    position: relative; display: inline-flex; align-items: center; gap: 6px;
    padding: 5px 9px; border-radius: 5px;
    background: linear-gradient(180deg, rgba(42, 34, 52, 0.96), rgba(28, 22, 38, 0.96));
    /* border tints toward cyan as the chip is read + filed (--lit 0 -> 1) */
    border: 1px solid color-mix(in srgb, var(--brand-cyan) calc(var(--lit, 0) * 30%), rgba(245,241,232,0.2));
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 11px;
    white-space: nowrap; color: rgba(245,241,232,0.82);
    box-shadow: 0 6px 18px -8px rgba(0,0,0,0.85);
    transition: border-color 300ms ease, color 300ms ease;
  }
  .ctb-chip-wave {
    width: 26px; height: 11px; flex: 0 0 auto;
    color: color-mix(in srgb, var(--brand-cyan) calc(var(--lit, 0) * 100%), rgba(245,241,232,0.3));
    opacity: calc(0.25 + 0.75 * var(--lit, 0));
  }
  .ctb-chip-name { overflow: hidden; text-overflow: ellipsis; max-width: 15vw; }
  .ctb-chip-dup { font-size: 9px; color: var(--brand-pink); }

  /* protagonist */
  .ctb-chip-hero { z-index: 5; }
  .ctb-chip-hero .ctb-chip-inner {
    border-color: rgba(0,255,77,0.5); color: #00ff4d;
    /* glow strength is p-derived (--glow), so reversing un-glows cleanly */
    box-shadow: 0 0 calc(10px + 20px * var(--glow, 0)) rgba(0,255,77, calc(0.14 + 0.3 * var(--glow, 0)));
  }
  .ctb-chip-hero .ctb-chip-wave { color: #00ff4d; }
  .ctb-chip-follow {
    position: absolute; bottom: calc(100% + 8px); left: 50%; transform: translateX(-50%);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 8.5px;
    letter-spacing: 0.1em; text-transform: uppercase; color: #00ff4d; white-space: nowrap;
    background: rgba(7, 6, 12, 0.95); border: 1px solid rgba(0,255,77,0.45); border-radius: 5px;
    padding: 3px 9px; box-shadow: 0 8px 20px -8px rgba(0,0,0,0.85);
    opacity: var(--glow, 0); pointer-events: none; transition: opacity 200ms ease;
