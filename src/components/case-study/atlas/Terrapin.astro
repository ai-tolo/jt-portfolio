---
/**
 * Terrapin — the Engineer's avatar, snapshotted into the case study so the
 * page never imports portal internals (and so the live portal art can keep
 * evolving in parallel without touching this flagship page). Faithful copy of
 * components/portal/EngineerTurtle.astro as of 2026-06-03: a cute futuristic-
 * hippie robot turtle mastering engineer — Grateful Dead's Terrapin Station
 * banjo turtle × a Daft-Punk cyan glow × hippie tie-dye/flower. The
 * oscilloscope chest reactor carries the speaking state.
 *
 * Self-contained SVG, no deps. Scales cleanly from a 44px chip to a 240px
 * theatrical reveal. `speaking` amps the chest scope.
 */
interface Props {
  size?: number;
  speaking?: boolean;
  class?: string;
}
const { size = 72, speaking = false, class: className = "" } = Astro.props;
---

<span
  class:list={["atlas-turtle", className]}
  data-speaking={speaking ? "true" : "false"}
  style={`--turtle-size:${size}px`}
  aria-hidden="true"
>
  <svg viewBox="0 0 100 100" width={size} height={size} role="img" aria-label="Terrapin, the engineer">
    <defs>
      <linearGradient id="atHead" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#8ff0b6" />
        <stop offset="100%" stop-color="#43bd86" />
      </linearGradient>
      <radialGradient id="atCara" cx="42%" cy="30%" r="82%">
        <stop offset="0%" stop-color="#ffe487" />
        <stop offset="32%" stop-color="#ffae4d" />
        <stop offset="66%" stop-color="#ff5fa0" />
        <stop offset="100%" stop-color="#d2286f" />
      </radialGradient>
      <linearGradient id="atDye" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#ff2d8b" />
        <stop offset="50%" stop-color="#ff8a3d" />
        <stop offset="100%" stop-color="#ffd23d" />
      </linearGradient>
      <radialGradient id="atGlow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#9af4ff" />
        <stop offset="100%" stop-color="#0ec4fc" stop-opacity="0" />
      </radialGradient>
      <clipPath id="atScopeClip"><circle cx="50" cy="79" r="8.6" /></clipPath>
    </defs>

    <line x1="50" y1="18" x2="50" y2="8" stroke="#0ec4fc" stroke-width="2.2" stroke-linecap="round" />

    <ellipse cx="41" cy="95" rx="6" ry="4" fill="url(#atHead)" stroke="#2c8a60" stroke-width="1.1" />
    <ellipse cx="59" cy="95" rx="6" ry="4" fill="url(#atHead)" stroke="#2c8a60" stroke-width="1.1" />

    <ellipse cx="15" cy="76" rx="7.5" ry="5" fill="url(#atHead)" stroke="#2c8a60" stroke-width="1.1" transform="rotate(-20 15 76)" />
    <ellipse cx="85" cy="76" rx="7.5" ry="5" fill="url(#atHead)" stroke="#2c8a60" stroke-width="1.1" transform="rotate(20 85 76)" />

    <g class="at-shell">
      <ellipse cx="50" cy="75" rx="31" ry="21" fill="url(#atCara)" stroke="#7a1f54" stroke-width="1.6" />
      <ellipse cx="50" cy="74" rx="23" ry="14.5" fill="none" stroke="#ffffff" stroke-width="1.6" opacity="0.12" />
      <ellipse cx="50" cy="73" rx="13" ry="8" fill="none" stroke="#ffe487" stroke-width="1.6" opacity="0.22" />
      <ellipse cx="40" cy="66" rx="8" ry="3" fill="#ffffff" opacity="0.16" transform="rotate(-18 40 66)" />
      <g stroke="#7a1f54" stroke-width="1" opacity="0.45" stroke-linecap="round">
        <line x1="34" y1="79" x2="29" y2="79" />
        <line x1="66" y1="79" x2="71" y2="79" />
        <line x1="50" y1="91" x2="50" y2="95" />
      </g>
      <g transform="translate(28 64)">
        <circle r="1.7" fill="#ffd23d" />
        <g fill="#ff8ec2">
          <ellipse cx="0" cy="-3.3" rx="1.4" ry="2.3" />
          <ellipse cx="3.1" cy="-1" rx="1.4" ry="2.3" transform="rotate(72 3.1 -1)" />
          <ellipse cx="1.9" cy="2.7" rx="1.4" ry="2.3" transform="rotate(144 1.9 2.7)" />
          <ellipse cx="-1.9" cy="2.7" rx="1.4" ry="2.3" transform="rotate(216 -1.9 2.7)" />
          <ellipse cx="-3.1" cy="-1" rx="1.4" ry="2.3" transform="rotate(288 -3.1 -1)" />
        </g>
      </g>
    </g>

    <ellipse cx="50" cy="39" rx="25" ry="23" fill="url(#atHead)" stroke="#2c8a60" stroke-width="1.5" />
    <ellipse cx="43" cy="27" rx="9" ry="5" fill="#ffffff" opacity="0.2" transform="rotate(-20 43 27)" />

    <g class="at-ear">
      <ellipse cx="24" cy="40" rx="9" ry="9" fill="url(#atGlow)" opacity="0.5" />
      <ellipse cx="24" cy="40" rx="5.4" ry="8" fill="#14182a" stroke="#0ec4fc" stroke-width="1.2" />
      <ellipse cx="24" cy="40" rx="2.4" ry="5" fill="#0ec4fc" opacity="0.85" />
      <circle class="at-ear-led" cx="24" cy="34.5" r="1.1" fill="#d6fbff" />
    </g>
    <g class="at-ear">
      <ellipse cx="76" cy="40" rx="9" ry="9" fill="url(#atGlow)" opacity="0.5" />
      <ellipse cx="76" cy="40" rx="5.4" ry="8" fill="#14182a" stroke="#0ec4fc" stroke-width="1.2" />
      <ellipse cx="76" cy="40" rx="2.4" ry="5" fill="#0ec4fc" opacity="0.85" />
      <circle class="at-ear-led" cx="76" cy="34.5" r="1.1" fill="#d6fbff" />
    </g>

    <path d="M37 31 Q50 28 63 31" fill="none" stroke="#19e0ff" stroke-width="1.5" stroke-linecap="round" opacity="0.5" />
    <ellipse cx="33" cy="47" rx="3.7" ry="2.3" fill="#ff7ab8" opacity="0.45" />
    <ellipse cx="67" cy="47" rx="3.7" ry="2.3" fill="#ff7ab8" opacity="0.45" />
    <g class="at-eyes">
      <ellipse cx="40" cy="40" rx="5.2" ry="6.7" fill="#141a36" />
      <ellipse cx="40" cy="40" rx="5.2" ry="6.7" fill="none" stroke="#0ec4fc" stroke-width="0.6" opacity="0.4" />
      <circle cx="38.2" cy="37.4" r="1.9" fill="#ffffff" />
      <circle cx="41.7" cy="42" r="0.95" fill="#ffffff" opacity="0.8" />
      <ellipse cx="60" cy="40" rx="5.2" ry="6.7" fill="#141a36" />
      <ellipse cx="60" cy="40" rx="5.2" ry="6.7" fill="none" stroke="#0ec4fc" stroke-width="0.6" opacity="0.4" />
      <circle cx="58.2" cy="37.4" r="1.9" fill="#ffffff" />
      <circle cx="61.7" cy="42" r="0.95" fill="#ffffff" opacity="0.8" />
    </g>
    <circle cx="48" cy="47.5" r="0.55" fill="#2c6b4f" opacity="0.7" />
    <circle cx="52" cy="47.5" r="0.55" fill="#2c6b4f" opacity="0.7" />
    <path d="M45 50.5 Q50 54.5 55 50.5" fill="none" stroke="#2c6b4f" stroke-width="1.7" stroke-linecap="round" />

    <g class="at-reactor">
      <circle class="at-scope-glow" cx="50" cy="79" r="15" fill="url(#atGlow)" opacity="0.55" />
      <circle cx="50" cy="79" r="10.6" fill="#080a16" stroke="#1a2142" stroke-width="1" />
      <g clip-path="url(#atScopeClip)">
        <line x1="41" y1="79" x2="59" y2="79" stroke="#0ec4fc" stroke-width="0.6" opacity="0.25" />
        <g class="at-wave">
          <path class="at-wave-line"
            d="M28,79 Q33.5,72 39,79 Q44.5,86 50,79 Q55.5,72 61,79 Q66.5,86 72,79"
            fill="none" stroke="#19e0ff" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
        </g>
      </g>
      <circle cx="50" cy="79" r="11.6" fill="none" stroke="url(#atDye)" stroke-width="2.4" />
      <circle cx="50" cy="79" r="8.7" fill="none" stroke="#0ec4fc" stroke-width="0.7" opacity="0.5" />
    </g>

    <circle cx="50" cy="7" r="7" fill="url(#atGlow)" />
    <g class="at-antenna" transform="translate(50 7)">
      <g fill="#ff8ec2">
        <ellipse cx="0" cy="-3.4" rx="1.5" ry="2.5" />
        <ellipse cx="3.2" cy="-1" rx="1.5" ry="2.5" transform="rotate(72 3.2 -1)" />
        <ellipse cx="2" cy="2.8" rx="1.5" ry="2.5" transform="rotate(144 2 2.8)" />
        <ellipse cx="-2" cy="2.8" rx="1.5" ry="2.5" transform="rotate(216 -2 2.8)" />
        <ellipse cx="-3.2" cy="-1" rx="1.5" ry="2.5" transform="rotate(288 -3.2 -1)" />
      </g>
      <circle r="1.8" fill="#ffd23d" />
    </g>
  </svg>
</span>

<style>
  .atlas-turtle {
    display: inline-flex;
    width: var(--turtle-size, 72px);
    height: var(--turtle-size, 72px);
    line-height: 0;
    filter: drop-shadow(0 6px 14px rgba(14, 196, 252, 0.28));
    animation: at-bob 3.6s ease-in-out infinite;
  }
  .atlas-turtle svg { overflow: visible; }

  .at-antenna { animation: at-antenna 1.9s ease-in-out infinite; transform-origin: 50px 7px; }
  .at-eyes { transform-box: fill-box; transform-origin: center; animation: at-blink 5.4s ease-in-out infinite; }
  .at-ear-led { animation: at-led 2.2s ease-in-out infinite; }
  .at-wave { animation: at-scroll 2.6s linear infinite; }
  .at-wave-line { transform-box: fill-box; transform-origin: center; }
  .at-scope-glow { transform-box: fill-box; transform-origin: center; animation: at-scope 3s ease-in-out infinite; }

  .atlas-turtle[data-speaking="true"] .at-wave { animation-duration: 0.85s; }
  .atlas-turtle[data-speaking="true"] .at-wave-line {
    stroke: #c8f6ff;
    transform: scaleY(1.55);
    filter: drop-shadow(0 0 2px rgba(25, 224, 255, 0.9));
  }
  .atlas-turtle[data-speaking="true"] .at-scope-glow { animation-duration: 0.85s; opacity: 0.95; }
  .atlas-turtle[data-speaking="true"] .at-antenna { animation-duration: 1.1s; }

  @keyframes at-bob {
    0%, 100% { transform: translateY(0) rotate(-1deg); }
    50% { transform: translateY(-2.5px) rotate(1deg); }
  }
  @keyframes at-antenna {
    0%, 100% { opacity: 0.75; transform: scale(0.92); }
    50% { opacity: 1; transform: scale(1.12); }
  }
  @keyframes at-blink {
    0%, 93%, 100% { transform: scaleY(1); }
    96% { transform: scaleY(0.1); }
  }
  @keyframes at-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-11px); }
  }
  @keyframes at-scope {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 0.8; }
  }
  @keyframes at-led {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .atlas-turtle, .at-antenna, .at-eyes, .at-ear-led, .at-wave, .at-wave-line, .at-scope-glow {
      animation: none;
    }
  }
</style>
