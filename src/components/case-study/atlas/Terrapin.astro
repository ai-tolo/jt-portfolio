---
/**
 * Terrapin — the Engineer's avatar, snapshotted into the case study so the
 * page never imports portal internals (and so the live portal art can keep
 * evolving in parallel without touching this flagship page). Faithful copy of
 * components/portal/EngineerTurtle.astro as of 2026-06-03 (the "real green
 * turtle" pass): a green domed shell with bold hexagonal scutes, tie-dye brand
 * washes, a cream plastron whose central plate is an Iron-Man oscilloscope
 * reactor (carries the speaking state), cyber ear-patches, a flower antenna.
 *
 * Self-contained SVG, no deps. IDs/classes are namespaced (at*) so it can never
 * collide with the portal copy. Scales from a 44px chip to a 240px reveal.
 */
interface Props {
  size?: number;
  speaking?: boolean;
  class?: string;
}
const { size = 72, speaking = false, class: className = "" } = Astro.props;
---

<span
  class:list={["atlas-turtle", className]}
  data-speaking={speaking ? "true" : "false"}
  style={`--turtle-size:${size}px`}
  aria-hidden="true"
>
  <svg viewBox="0 0 100 100" width={size} height={size} role="img" aria-label="Terrapin, the engineer">
    <defs>
      <linearGradient id="atHead" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#86e8ac" />
        <stop offset="100%" stop-color="#3ba876" />
      </linearGradient>
      <radialGradient id="atShellG" cx="44%" cy="26%" r="86%">
        <stop offset="0%" stop-color="#67ac78" />
        <stop offset="52%" stop-color="#3c8552" />
        <stop offset="100%" stop-color="#235236" />
      </radialGradient>
      <radialGradient id="atBlobP" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#ff2d8b" stop-opacity="0.75" />
        <stop offset="100%" stop-color="#ff2d8b" stop-opacity="0" />
      </radialGradient>
      <radialGradient id="atBlobO" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#ff8a3d" stop-opacity="0.75" />
        <stop offset="100%" stop-color="#ff8a3d" stop-opacity="0" />
      </radialGradient>
      <radialGradient id="atBlobY" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#ffd23d" stop-opacity="0.8" />
        <stop offset="100%" stop-color="#ffd23d" stop-opacity="0" />
      </radialGradient>
      <radialGradient id="atPlas" cx="50%" cy="40%" r="68%">
        <stop offset="0%" stop-color="#fff1c9" />
        <stop offset="100%" stop-color="#eecb80" />
      </radialGradient>
      <linearGradient id="atDye" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#ff2d8b" />
        <stop offset="50%" stop-color="#ff8a3d" />
        <stop offset="100%" stop-color="#ffd23d" />
      </linearGradient>
      <radialGradient id="atGlow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#9af4ff" />
        <stop offset="100%" stop-color="#0ec4fc" stop-opacity="0" />
      </radialGradient>
      <clipPath id="atShellClip"><ellipse cx="50" cy="74" rx="33" ry="24" /></clipPath>
      <clipPath id="atScopeClip"><circle cx="50" cy="82" r="6.6" /></clipPath>
    </defs>

    <line x1="50" y1="15" x2="50" y2="7" stroke="#0ec4fc" stroke-width="2.2" stroke-linecap="round" />

    <ellipse cx="39" cy="97" rx="6" ry="4" fill="url(#atHead)" stroke="#237a55" stroke-width="1.5" />
    <ellipse cx="61" cy="97" rx="6" ry="4" fill="url(#atHead)" stroke="#237a55" stroke-width="1.5" />

    <g>
      <ellipse cx="13" cy="79" rx="7.5" ry="5" fill="url(#atHead)" stroke="#237a55" stroke-width="1.5" transform="rotate(-20 13 79)" />
      <circle cx="11" cy="78" r="0.8" fill="#2f9e6e" opacity="0.6" />
    </g>
    <g>
      <ellipse cx="87" cy="79" rx="7.5" ry="5" fill="url(#atHead)" stroke="#237a55" stroke-width="1.5" transform="rotate(20 87 79)" />
      <circle cx="89" cy="78" r="0.8" fill="#2f9e6e" opacity="0.6" />
    </g>

    <g class="at-shell">
      <ellipse cx="50" cy="74" rx="33" ry="24" fill="url(#atShellG)" stroke="#173a23" stroke-width="2" />
      <g clip-path="url(#atShellClip)">
        <circle cx="33" cy="66" r="17" fill="url(#atBlobP)" />
        <circle cx="69" cy="62" r="16" fill="url(#atBlobO)" />
        <circle cx="54" cy="90" r="18" fill="url(#atBlobY)" />
        <circle cx="40" cy="86" r="11" fill="url(#atBlobP)" />
        <circle cx="74" cy="84" r="11" fill="url(#atBlobO)" />
      </g>
      <g fill="#4f9462" fill-opacity="0.32" stroke="#173a23" stroke-width="1.5" stroke-linejoin="round">
        <polygon points="50,55 55.2,58 55.2,64 50,67 44.8,64 44.8,58" />
        <polygon points="34,57.8 38.5,60.4 38.5,65.6 34,68.2 29.5,65.6 29.5,60.4" />
        <polygon points="66,57.8 70.5,60.4 70.5,65.6 66,68.2 61.5,65.6 61.5,60.4" />
        <polygon points="24,74 28.33,71.5 28.33,76.5 24,79 19.67,76.5 19.67,71.5" />
        <polygon points="76,74 80.33,71.5 80.33,76.5 76,79 71.67,76.5 71.67,71.5" />
        <polygon points="33,87 36.98,84.7 36.98,89.3 33,91.6 29.02,89.3 29.02,84.7" />
        <polygon points="67,87 70.98,84.7 70.98,89.3 67,91.6 63.02,89.3 63.02,84.7" />
      </g>
      <g stroke="#173a23" stroke-width="1.5" opacity="0.85" stroke-linecap="round">
        <line x1="71.2" y1="87" x2="75.3" y2="89.4" />
        <line x1="63.85" y1="91.5" x2="66.5" y2="94.8" />
        <line x1="50" y1="94.2" x2="50" y2="98" />
        <line x1="36.15" y1="91.5" x2="33.5" y2="94.8" />
        <line x1="28.8" y1="87" x2="24.7" y2="89.4" />
      </g>
      <g transform="translate(23 73)">
        <g fill="#ff8ec2">
          <circle cx="0" cy="-2.1" r="1.6" />
          <circle cx="2" cy="-0.65" r="1.6" />
          <circle cx="1.23" cy="1.7" r="1.6" />
          <circle cx="-1.23" cy="1.7" r="1.6" />
          <circle cx="-2" cy="-0.65" r="1.6" />
        </g>
        <circle r="1.3" fill="#ffd23d" />
      </g>
      <ellipse cx="50" cy="82" rx="15.5" ry="12.5" fill="url(#atPlas)" stroke="#bf9350" stroke-width="1.6" />
      <g stroke="#b07636" stroke-width="1.2" opacity="0.7" stroke-linecap="round">
        <line x1="50" y1="70.5" x2="50" y2="74.5" />
        <line x1="50" y1="90.5" x2="50" y2="93.5" />
        <line x1="41" y1="82" x2="35" y2="82" />
        <line x1="59" y1="82" x2="65" y2="82" />
        <line x1="43.5" y1="75" x2="38" y2="72" />
        <line x1="56.5" y1="75" x2="62" y2="72" />
        <line x1="43.5" y1="89" x2="38" y2="92" />
        <line x1="56.5" y1="89" x2="62" y2="92" />
      </g>
    </g>

    <ellipse cx="50" cy="36" rx="23" ry="21" fill="url(#atHead)" stroke="#237a55" stroke-width="2" />
    <ellipse cx="43" cy="25" rx="7" ry="3.4" fill="#ffffff" opacity="0.14" transform="rotate(-20 43 25)" />
    <g fill="#2f9e6e" opacity="0.55">
      <circle cx="30" cy="41" r="0.85" />
      <circle cx="33.5" cy="43" r="0.85" />
      <circle cx="70" cy="41" r="0.85" />
      <circle cx="66.5" cy="43" r="0.85" />
      <circle cx="45" cy="22" r="0.7" />
      <circle cx="55" cy="22" r="0.7" />
    </g>

    <g>
      <ellipse cx="27" cy="40" rx="3.4" ry="4.4" fill="#22c6e6" opacity="0.45" />
      <ellipse cx="27" cy="40" rx="3.4" ry="4.4" fill="none" stroke="#0e9bc0" stroke-width="0.9" opacity="0.8" />
      <circle class="at-ear-led" cx="26.4" cy="39" r="1.5" fill="#d6fbff" />
    </g>
    <g>
      <ellipse cx="73" cy="40" rx="3.4" ry="4.4" fill="#22c6e6" opacity="0.45" />
      <ellipse cx="73" cy="40" rx="3.4" ry="4.4" fill="none" stroke="#0e9bc0" stroke-width="0.9" opacity="0.8" />
      <circle class="at-ear-led" cx="73.6" cy="39" r="1.5" fill="#d6fbff" />
    </g>

    <ellipse cx="32" cy="45" rx="3.6" ry="2.3" fill="#ff7ab8" opacity="0.4" />
    <ellipse cx="68" cy="45" rx="3.6" ry="2.3" fill="#ff7ab8" opacity="0.4" />
    <g class="at-eyes">
      <ellipse cx="40" cy="37" rx="5.1" ry="6.5" fill="#141a36" />
      <circle cx="38.2" cy="34.5" r="1.9" fill="#ffffff" />
      <circle cx="41.7" cy="39" r="0.95" fill="#ffffff" opacity="0.85" />
      <ellipse cx="60" cy="37" rx="5.1" ry="6.5" fill="#141a36" />
      <circle cx="58.2" cy="34.5" r="1.9" fill="#ffffff" />
      <circle cx="61.7" cy="39" r="0.95" fill="#ffffff" opacity="0.85" />
    </g>
    <path d="M46 45.4 Q50 46.3 54 45.4" fill="none" stroke="#2c6b4f" stroke-width="1.2" stroke-linecap="round" opacity="0.55" />
    <circle cx="48" cy="44" r="0.55" fill="#2c6b4f" opacity="0.7" />
    <circle cx="52" cy="44" r="0.55" fill="#2c6b4f" opacity="0.7" />
    <path d="M45.5 47.4 Q50 51 54.5 47.4" fill="none" stroke="#2c6b4f" stroke-width="1.7" stroke-linecap="round" />

    <g class="at-reactor">
      <circle class="at-scope-glow" cx="50" cy="82" r="11.5" fill="url(#atGlow)" opacity="0.5" />
      <circle cx="50" cy="82" r="8.2" fill="#0a0e1f" stroke="#1a2142" stroke-width="1" />
      <g clip-path="url(#atScopeClip)">
        <line x1="43.6" y1="82" x2="56.4" y2="82" stroke="#0ec4fc" stroke-width="0.6" opacity="0.3" />
        <g class="at-wave">
          <path class="at-wave-line"
            d="M27,82 Q29,76 31,82 Q33,88 35,82 Q37,76 39,82 Q41,88 43,82 Q45,76 47,82 Q49,88 51,82 Q53,76 55,82 Q57,88 59,82 Q61,76 63,82 Q65,88 67,82 Q69,76 71,82 Q73,88 75,82"
            fill="none" stroke="#34ecff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
        </g>
      </g>
      <circle cx="50" cy="82" r="9.1" fill="none" stroke="url(#atDye)" stroke-width="2.2" />
      <circle cx="50" cy="82" r="6.8" fill="none" stroke="#0ec4fc" stroke-width="0.7" opacity="0.5" />
    </g>

    <circle cx="50" cy="6" r="5.6" fill="url(#atGlow)" />
    <g class="at-antenna" transform="translate(50 6)">
      <g fill="#ff79b0">
        <circle cx="0" cy="-2.7" r="2" />
        <circle cx="2.57" cy="-0.83" r="2" />
        <circle cx="1.59" cy="2.18" r="2" />
        <circle cx="-1.59" cy="2.18" r="2" />
        <circle cx="-2.57" cy="-0.83" r="2" />
      </g>
      <circle r="1.8" fill="#ffd23d" />
      <circle r="0.7" fill="#fff3b0" />
    </g>
  </svg>
</span>

<style>
  .atlas-turtle {
    display: inline-flex;
    width: var(--turtle-size, 72px);
    height: var(--turtle-size, 72px);
    line-height: 0;
    filter: drop-shadow(0 6px 12px rgba(14, 196, 252, 0.22));
    animation: at-bob 3.6s ease-in-out infinite;
  }
  .atlas-turtle svg { overflow: visible; }

  .at-antenna { animation: at-antenna 1.9s ease-in-out infinite; transform-origin: 50px 6px; }
  .at-eyes { transform-box: fill-box; transform-origin: center; animation: at-blink 5.4s ease-in-out infinite; }
  .at-ear-led { animation: at-led 2.2s ease-in-out infinite; }
  .at-wave { animation: at-scroll 2.6s linear infinite; }
  .at-wave-line { transform-box: fill-box; transform-origin: center; }
  .at-scope-glow { transform-box: fill-box; transform-origin: center; animation: at-scope 3s ease-in-out infinite; }

  .atlas-turtle[data-speaking="true"] .at-wave { animation-duration: 0.85s; }
  .atlas-turtle[data-speaking="true"] .at-wave-line {
    stroke: #c8f6ff;
    transform: scaleY(1.5);
    filter: drop-shadow(0 0 2px rgba(25, 224, 255, 0.9));
  }
  .atlas-turtle[data-speaking="true"] .at-scope-glow { animation-duration: 0.85s; opacity: 0.9; }
  .atlas-turtle[data-speaking="true"] .at-antenna { animation-duration: 1.1s; }

  @keyframes at-bob {
    0%, 100% { transform: translateY(0) rotate(-1deg); }
    50% { transform: translateY(-2.5px) rotate(1deg); }
  }
  @keyframes at-antenna {
    0%, 100% { opacity: 0.75; transform: scale(0.92); }
    50% { opacity: 1; transform: scale(1.12); }
  }
  @keyframes at-blink {
    0%, 93%, 100% { transform: scaleY(1); }
    96% { transform: scaleY(0.1); }
  }
  @keyframes at-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-8px); }
  }
  @keyframes at-scope {
    0%, 100% { opacity: 0.45; }
    50% { opacity: 0.75; }
  }
  @keyframes at-led {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .atlas-turtle, .at-antenna, .at-eyes, .at-ear-led, .at-wave, .at-wave-line, .at-scope-glow {
      animation: none;
    }
  }
</style>
