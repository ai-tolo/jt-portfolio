---
// THE KILN — §02. One physical console: a single backplate with three modules
// bolted to it — a VOICE MEMOS handheld (the Finder is its screen), the KILN
// engine beneath it (the 3D chromatic control), and the AUDIODEX terminal to the
// right — wired together by conduit traces. Press the kiln: the source-conduit
// lights, the memos scan, energy runs the trace into a CHARGE CELL that fills,
// the cell discharges down the trace into the terminal, and its screen populates
// with the forged record. Each file forges its own card.
//
// Desktop-first per direction: the console is a fixed-px object (so the conduits
// stay registered to the modules) and scales as one unit on smaller screens.
// running→done is one setTimeout (rAF throttles headless, atlas gotcha #6).

const musicBars = Array.from({ length: 84 }, (_, i) => {
  const lull = 0.2 + 0.12 * Math.sin(i * 0.16);
  const spike = (i > 38 && i < 49) || (i > 68 && i < 76) ? 0.5 : 0;
  const chatter = 0.14 * Math.abs(Math.sin(i * 0.9));
  return Math.round(Math.max(0.08, Math.min(1, lull + chatter + spike)) * 100);
});
const ambientBars = Array.from({ length: 84 }, (_, i) => {
  const base = 0.22 + 0.1 * Math.sin(i * 0.07) + 0.05 * Math.sin(i * 0.31);
  return Math.round(Math.max(0.08, Math.min(0.62, base)) * 100);
});
const speechBars = Array.from({ length: 84 }, (_, i) => {
  const burst = Math.sin(i * 0.5) > 0.05 ? 0.3 + 0.42 * Math.abs(Math.sin(i * 1.7)) : 0.1;
  const gap = i % 16 < 3 ? 0.1 : 1;
  return Math.round(Math.max(0.08, Math.min(1, burst * gap)) * 100);
});

// The case-study song. SWAP HERE to change which track we follow; also synced as a
// plain literal in the-console.astro (rounds 1/2/3 source) + SecretDoor.astro BUCKETS[0].
const SONG_TITLE = "head to toe";

// The Voice Memos finder: three raw iOS recordings from one session week. Audio 14
// is the keeper we follow (DEFAULT_FILE); firing it forges the card titled SONG_TITLE,
// the literal payoff of "a date and a number becomes a title". ids stay 46/47/48 so the
// script guards + done-state CSS keep working.
const FILES = [
  { id: "46", name: "Audio 13.m4a", date: "Feb 13, 2024" },
  { id: "47", name: "Audio 14.m4a", date: "Feb 14, 2024" },
  { id: "48", name: "Audio 15.m4a", date: "Feb 15, 2024" },
];
const DEFAULT_FILE = "47";

type Seg = { t: string; s?: string; dim?: string; hl?: string; after?: string };
type Rec = {
  tier: string; kind: string; title: string; keeper: string | null;
  /** Source filename this record was forged from — shown struck-through beside
      the title so the rename (a date and a number becomes a title) is explicit. */
  from?: string;
  /** Public URL of the take itself. When set, the card's waveform IS the play
      surface (the real BucketCard law) — the first hearing of the found sound
      happens inside the catalog record, not in a separate player. */
  audio?: string;
  duration: string; rel: string; stamped: string; days: string;
  summary: { t?: string; b?: string }[];
  txLabel: string; txCount: string; tx: Seg[];
  tags: string[]; bars: number[];
};
const RECORDS: Record<string, Rec> = {
  "46": {
    tier: "Field", kind: "field",
    title: "Rooftop, 6am: the city before the traffic",
    keeper: null, duration: "21:38", rel: "2y", stamped: "02-09-2024", days: "850d",
    summary: [
      { t: "Pure field capture. Twenty minutes of a city waking up before the cars take it over. No part to keep, but the " },
      { b: "low hum underneath" },
      { t: " would bed a pad beautifully." },
    ],
    txLabel: "Sound log", txCount: "ambience · no speech",
    tx: [
      { t: "0:00", dim: "[wind across the mic]" },
      { t: "4:12", dim: "[a train, far off]" },
      { t: "11:50", hl: "…first cars." },
      { t: "18:30", dim: "[one bird, three notes, close]" },
    ],
    tags: ["field recording", "city", "6am", "texture", "auto-filed"],
    bars: ambientBars,
  },
  "47": {
    tier: "Track", kind: "tracks",
    title: SONG_TITLE,
    from: FILES[1].name,
    audio: "/case-studies/the-console/source/arc-01-original-rough.mp3",
    keeper: "★ 1 keeper", duration: "3:48", rel: "2y", stamped: "02-14-2024", days: "845d",
    summary: [
      { t: "A phone memo, recorded once at 2am, never re-recorded. The audio is rough and it does not matter: " },
      { b: "the take is the song" },
      { t: ". Filed, titled, and kept so it could actually get finished." },
    ],
    txLabel: "Transcript", txCount: "one take, never redone",
    tx: [
      { t: "0:00", s: "…okay, just play it, don't fix it." },
      { t: "0:41", hl: "…head to toe, that's the line." },
      { t: "1:12", dim: "[humming the next part]" },
      { t: "1:31", s: "…leave it. that's the one." },
    ],
    tags: ["voice memo", "2am", "one take", "the keeper"],
    bars: musicBars,
  },
  "48": {
    tier: "Inbox", kind: "inbox",
    title: "Note to self: drop the bridge out, don't build it",
    keeper: null, duration: "0:48", rel: "2y", stamped: "02-20-2024", days: "839d",
    summary: [
      { t: "Not a song. Me talking through a fix for a track I'd left half-open: " },
      { b: "pull everything but the vocal for two bars" },
      { t: " before the last chorus. Filed so I'd actually find it again." },
    ],
    txLabel: "Transcript", txCount: "121 words",
    tx: [
      { t: "0:03", s: "okay, the bridge. the bridge is too much." },
      { t: "0:19", hl: "drop it out. just the vocal, two bars,", after: " right before the last chorus." },
      { t: "0:35", s: "then slam back in. that's the move. don't forget this one." },
    ],
    tags: ["voice memo", "note to self", "mix idea", "tracks"],
    bars: speechBars,
  },
};
const ORDER = ["46", "47", "48"];
---

<section class="ft" data-ft data-state="idle" data-file={DEFAULT_FILE} aria-label="Fire a voice memo through the kiln into an AudioDex record">
  <div class="ft-stage">
    <div class="ft-console">
      <!-- chassis decoration: the whole console is one device, "AudioDex" -->
      <span class="ft-devplate" aria-hidden="true">AudioDex</span>
      <span class="ft-devports" aria-hidden="true"><span class="ft-port-jack"></span><span class="ft-port-usb"></span></span>
      <span class="ft-chassis-vents" aria-hidden="true"></span>
      <span class="ft-bolt ft-bolt-tl" aria-hidden="true"></span><span class="ft-bolt ft-bolt-tr" aria-hidden="true"></span>
      <span class="ft-bolt ft-bolt-bl" aria-hidden="true"></span><span class="ft-bolt ft-bolt-br" aria-hidden="true"></span>

      <!-- the working stage (conduits + modules) lives in a fixed 1160×660 inner
           field, dropped below the AudioDex header band, so every conduit coord
           stays registered while the body gains a proper top margin -->
      <div class="ft-stage-inner">
      <!-- conduit traces + charge cell, registered to the module positions -->
      <svg class="ft-traces" viewBox="0 0 1160 660" aria-hidden="true">
        <g class="ft-trace-base" fill="none" stroke="rgba(120,170,220,0.16)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
          <path d="M238 332 L238 257" />
          <path d="M430 168 H470 L492 190 V338 L508 358" />
          <path d="M588 358 L637 340" />
        </g>
        <g class="ft-trace-flow" fill="none" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
          <path class="ft-flow ft-flow-power" d="M238 332 L238 257" />
          <path class="ft-flow ft-flow-charge" d="M430 168 H470 L492 190 V338 L508 358" />
          <!-- the canal splits symmetrically around the bigger orb (top + bottom), meets on the far side -->
          <path class="ft-flow ft-flow-arc ft-flow-arc-top" d="M508 358 A 40 40 0 0 0 588 358" />
          <path class="ft-flow ft-flow-arc ft-flow-arc-bot" d="M508 358 A 40 40 0 0 1 588 358" />
          <path class="ft-flow ft-flow-dis" d="M588 358 L637 340" />
          <!-- then the flow traces the AudioDex SCREEN border, splitting both ways to meet on the right -->
          <path class="ft-flow ft-flow-border ft-flow-border-top" d="M637 340 V116 A11 11 0 0 1 648 105 H1090 A11 11 0 0 1 1101 116 V340" />
          <path class="ft-flow ft-flow-border ft-flow-border-bot" d="M637 340 V564 A11 11 0 0 0 648 575 H1090 A11 11 0 0 0 1101 564 V340" />
        </g>
        <defs>
          <linearGradient id="ftRainbow" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="#19e0ff" /><stop offset="0.38" stop-color="#7b5cff" /><stop offset="0.7" stop-color="#ff2d8b" /><stop offset="1" stop-color="#ffd23d" />
          </linearGradient>
        </defs>
      </svg>

      <!-- the charge cell · a glass diode in a socket -->
      <div class="ft-cell" aria-hidden="true">
        <span class="ft-cell-aura"></span>
        <svg class="ft-cell-ring" viewBox="0 0 70 70">
          <circle cx="35" cy="35" r="30" fill="#0a0f18" stroke="rgba(120,170,220,0.32)" stroke-width="1.5" />
          <circle class="ft-cell-ring-glow" cx="35" cy="35" r="30" fill="none" stroke="#19e0ff" stroke-width="2" opacity="0" />
        </svg>
        <span class="ft-cell-diode"><span class="ft-cell-diode-core"></span><span class="ft-cell-diode-spec"></span></span>
        <span class="ft-cell-chamber"></span>
        <span class="ft-cell-rainbow"></span>
      </div>

      <!-- ── VOICE MEMOS handheld ── -->
      <div class="dev ft-mod ft-source-dev">
        <!-- title row removed: the Finder header inside the screen already reads
             "Voice Memos", so the panel chrome was redundant -->
        <div class="dev-screen">
          <div class="ft-finder">
            <div class="ft-finder-bar">
              <span class="ft-tl" aria-hidden="true"><i></i><i></i><i></i></span>
              <span class="ft-finder-folder">Voice Memos</span>
              <span class="ft-finder-view" aria-hidden="true">
                <svg viewBox="0 0 14 11" width="13" height="10"><g fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"><path d="M1 1.5h2M5 1.5h8M1 5.5h2M5 5.5h8M1 9.5h2M5 9.5h8"/></g></svg>
              </span>
            </div>
            <div class="ft-finder-cols"><span class="ft-col-name">Name <i aria-hidden="true">▲</i></span><span class="ft-col-date">Date Modified</span></div>
            <ul class="ft-finder-list" role="listbox" aria-label="Pick a voice memo to fire">
              {FILES.map((f) => (
                <li>
                  <button type="button" class="ft-frow" data-ft-pick={f.id} role="option" aria-selected={f.id === DEFAULT_FILE ? "true" : "false"}>
                    <span class="ft-fname">
                      <svg class="ft-fic" viewBox="0 0 14 14" width="13" height="13" aria-hidden="true"><rect x="0.6" y="0.6" width="12.8" height="12.8" rx="3" fill="currentColor" opacity="0.16"/><path d="M4 9.5V5.2l5-1.1v4.1" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/><circle cx="3.4" cy="9.6" r="1.2" fill="currentColor"/><circle cx="8.4" cy="8.2" r="1.2" fill="currentColor"/></svg>
                      {f.name}
                    </span>
                    <span class="ft-fdate">{f.date}</span>
                  </button>
                </li>
              ))}
            </ul>
            <div class="ft-scan" aria-hidden="true"></div>
          </div>
        </div>
        <div class="dev-foot"><span class="dev-grille" aria-hidden="true"></span><span class="dev-tag">how the Mac sees it</span></div>
      </div>

      <!-- ── KILN engine (the control) ── -->
      <button type="button" class="ft-mod ft-forge" data-ft-fire aria-label="Fire the kiln" aria-describedby="ft-forge-note">
        <span class="ft-forge-dome" aria-hidden="true">
          <span class="ft-forge-body"></span>

          {/* ══ ROTATING DIAL — the ONLY element that spins (bezel rim + concentric grooves + index notch) ══ */}
          <span class="ft-forge-dial">
            <span class="ft-dial-rim"></span>
            <svg class="ft-forge-bezel" viewBox="0 0 240 240" aria-hidden="true">
              <line class="ft-dial-index" x1="120" y1="92" x2="120" y2="100" stroke="#c9b6ff" stroke-width="2.2" stroke-linecap="round" />
              <circle class="ft-dial-index-dot" cx="120" cy="88" r="2.4" fill="#c9b6ff" />
            </svg>
          </span>

          {/* ══ STATIC SCREEN — plasma globe set into the vibranium album · NEVER rotates ══ */}
          <span class="ft-dial-lip" aria-hidden="true"></span>
          <span class="ft-forge-screen">
            <span class="ft-scope"></span>
            <svg class="ft-reactor" viewBox="0 0 240 240" aria-hidden="true">
              <defs>
                <radialGradient id="ftpl-core" cx="50%" cy="50%" r="50%">
                  <stop offset="0%" stop-color="#ffffff"/>
                  <stop offset="22%" stop-color="#eaffff"/>
                  <stop offset="48%" stop-color="#aef9ff"/>
                  <stop offset="72%" stop-color="#19e0ff"/>
                  <stop offset="100%" stop-color="#19e0ff" stop-opacity="0"/>
                </radialGradient>
                <radialGradient id="ftpl-bloom" cx="50%" cy="50%" r="50%">
                  <stop offset="0%" stop-color="#7b5cff" stop-opacity="0.55"/>
                  <stop offset="45%" stop-color="#3a6cff" stop-opacity="0.22"/>
                  <stop offset="100%" stop-color="#063444" stop-opacity="0"/>
                </radialGradient>
                <radialGradient id="ftpl-globe" cx="42%" cy="38%" r="62%">
                  <stop offset="0%" stop-color="#19e0ff" stop-opacity="0.10"/>
                  <stop offset="60%" stop-color="#1166aa" stop-opacity="0.06"/>
                  <stop offset="100%" stop-color="#7b5cff" stop-opacity="0.05"/>
                </radialGradient>
                <linearGradient id="ftpl-fil" x1="0" y1="0" x2="1" y2="0">
                  <stop offset="0%" stop-color="#ffffff"/>
                  <stop offset="35%" stop-color="#aef9ff"/>
                  <stop offset="80%" stop-color="#19e0ff"/>
                  <stop offset="100%" stop-color="#7b5cff"/>
                </linearGradient>

                <filter id="ftpl-arc" x="-60%" y="-60%" width="220%" height="220%" color-interpolation-filters="sRGB">
                  <feTurbulence type="fractalNoise" baseFrequency="0.018 0.026" numOctaves="3" seed="7" stitchTiles="stitch" result="n">
                    <animate attributeName="seed" values="7;8;9;10;7" dur="3.2s" repeatCount="indefinite"/>
                  </feTurbulence>
                  <feDisplacementMap in="SourceGraphic" in2="n" scale="22" xChannelSelector="R" yChannelSelector="G"/>
                </filter>

                <filter id="ftpl-fork" x="-60%" y="-60%" width="220%" height="220%" color-interpolation-filters="sRGB">
                  <feTurbulence type="fractalNoise" baseFrequency="0.045 0.06" numOctaves="2" seed="21" stitchTiles="stitch" result="n">
                    <animate attributeName="seed" values="21;23;25;21" dur="2.3s" repeatCount="indefinite"/>
                  </feTurbulence>
                  <feDisplacementMap in="SourceGraphic" in2="n" scale="14" xChannelSelector="R" yChannelSelector="G"/>
                </filter>

                <filter id="ftpl-soft" x="-80%" y="-80%" width="260%" height="260%">
                  <feGaussianBlur stdDeviation="3.2"/>
                </filter>
                <filter id="ftpl-glow" x="-120%" y="-120%" width="340%" height="340%">
                  <feGaussianBlur stdDeviation="7"/>
                </filter>

                <clipPath id="ftpl-clip"><circle cx="120" cy="120" r="118"/></clipPath>
              </defs>

              <g class="ft-pl-field" clip-path="url(#ftpl-clip)">
                <!-- ambient globe haze + violet bloom -->
                <circle cx="120" cy="120" r="112" fill="url(#ftpl-globe)"/>
                <circle class="ft-pl-bloom" cx="120" cy="120" r="106" fill="url(#ftpl-bloom)" filter="url(#ftpl-glow)"/>

                <!-- PRIMARY ARCS: crooked filaments displaced by turbulence -->
                <g transform="translate(120 120) scale(1.9) translate(-120 -120)">
                    <g fill="none" stroke="url(#ftpl-fil)" stroke-linecap="round">
                  <!-- glow underlay -->
                  <g filter="url(#ftpl-glow)" opacity="0.7" stroke-width="3.4">
                    <g filter="url(#ftpl-arc)">
                      <path d="M120 120 L84 70"/>
                      <path d="M120 120 L168 80"/>
                      <path d="M120 120 L178 138"/>
                      <path d="M120 120 L132 184"/>
                      <path d="M120 120 L66 150"/>
                      <path d="M120 120 L60 110"/>
                    </g>
                  </g>
                  <!-- crisp filament cores -->
                  <g class="ft-pl-arcs" filter="url(#ftpl-arc)" stroke-width="1.5">
                    <path d="M120 120 L84 70"/>
                    <path d="M120 120 L168 80"/>
                    <path d="M120 120 L178 138"/>
                    <path d="M120 120 L132 184"/>
                    <path d="M120 120 L66 150"/>
                    <path d="M120 120 L60 110"/>
                  </g>
                </g>

                <!-- SECONDARY FORKS: finer branches off the primaries -->
                <g class="ft-pl-forks" fill="none" stroke="#aef9ff" stroke-linecap="round" stroke-width="0.9"
                   filter="url(#ftpl-fork)" opacity="0.85">
                  <path d="M101 95 L78 96"/>
                  <path d="M145 100 L160 86"/>
                  <path d="M150 130 L172 122"/>
                  <path d="M126 152 L114 168"/>
                  <path d="M92 136 L74 132"/>
                  <path d="M90 115 L72 104"/>
                  <path d="M134 112 L150 104"/>
                </g>

                <!-- terminal sparks where arcs meet the rim -->
                <g class="ft-pl-tips" fill="#eaffff" filter="url(#ftpl-soft)">
                  <circle cx="84" cy="70" r="1.6"/>
                  <circle cx="168" cy="80" r="1.6"/>
                  <circle cx="178" cy="138" r="1.4"/>
                  <circle cx="132" cy="184" r="1.5"/>
                  <circle cx="66" cy="150" r="1.5"/>
                  <circle cx="60" cy="110" r="1.4"/>
                </g>
                  </g>

                <!-- HOT CORE: electrode -->
                <circle cx="120" cy="120" r="22" fill="url(#ftpl-core)" filter="url(#ftpl-soft)" class="ft-pl-core"/>
                <circle cx="120" cy="120" r="9" fill="url(#ftpl-core)"/>
                <circle cx="120" cy="120" r="3.6" fill="#ffffff"/>
                <circle cx="116.5" cy="116" r="1.2" fill="#ffffff" opacity="0.9"/>
              </g>
            </svg>
            <span class="ft-pl-flash" aria-hidden="true"></span>
          </span>

          <span class="ft-forge-glass"></span>
          <span class="ft-forge-arm" aria-hidden="true"></span>
        </span>
        <span class="ft-forge-label" aria-hidden="true" data-ft-label>forge</span>
      </button>
      <p id="ft-forge-note" class="ft-sr">Fire the kiln on the selected voice memo to forge its catalog entry.</p>

      <!-- ── AUDIODEX terminal ── -->
      <div class="dev ft-mod ft-out-dev" data-ft-platen>
        <div class="dev-top">
          <span class="dev-led dev-led-amber" aria-hidden="true"></span>
          <span class="dev-brand">Catalog</span>
          <span class="dev-readout" data-ft-readout>standby</span>
        </div>
        <div class="dev-screen ft-screen">
          <div class="ft-standby" data-ft-empty aria-hidden="true"><span class="ft-standby-mark"></span>awaiting signal</div>
          <div class="ft-screen-wake" aria-hidden="true"></div>

          {ORDER.map((id) => {
            const r = RECORDS[id];
            return (
              <article class="ft-card" data-rec={id} data-kind={r.kind} data-open="true" aria-label={`${r.title}, AudioDex ${r.tier} entry`}>
                <header class="ft-card-head">
                  <span class:list={["ft-tier", `ft-tier-${r.kind}`]}>{r.tier}</span>
                  {r.from && <span class="ft-from" aria-label={`renamed from ${r.from}`}><s>{r.from}</s> →</span>}
                  <span class="ft-title">{r.title}</span>
                  {r.keeper && <span class="ft-keeper">{r.keeper}</span>}
                </header>
                <div class="ft-wave-row">
                  <span class="ft-duration" aria-label="Length">{r.duration}</span>
                  {r.audio ? (
                    <button type="button" class="ft-wave-card ft-wave-play" data-ft-play aria-label="Play an excerpt of the raw take — the sound this record was forged from">
                      <span class="ft-playglyph" aria-hidden="true">
                        <svg class="g-play" viewBox="0 0 24 24"><path d="M8 5 v14 l11 -7 z"/></svg>
                        <svg class="g-pause" viewBox="0 0 24 24"><path d="M7 5 h4 v14 h-4 z M13 5 h4 v14 h-4 z"/></svg>
                      </span>
                      {r.bars.map((h, i) => <span class="ft-bar" style={`--h:${h}%; --i:${i}`}></span>)}
                      <audio class="ft-card-audio" preload="none" src={r.audio}></audio>
                    </button>
                  ) : (
                    <div class="ft-wave-card">
                      {r.bars.map((h, i) => <span class="ft-bar" style={`--h:${h}%; --i:${i}`}></span>)}
                    </div>
                  )}
                </div>
                <button type="button" class="ft-date" data-ft-cardtoggle aria-expanded="true" aria-label="Collapse or expand this entry">
                  <span class="ft-date-rel">{r.rel}</span><span class="ft-date-bracket"> [</span><span class="ft-date-stamped">{r.stamped}</span><span class="ft-date-bracket">]</span><span class="ft-date-sep"> · </span><span class="ft-date-days">{r.days}</span><span class="ft-date-chev" aria-hidden="true">▾</span>
                </button>
                <div class="ft-body">
                  <div class="ft-body-inner">
                    <div class="ft-summary">
                      <span class="ft-line-label">Summary</span>
                      <p>{r.summary.map((s) => (s.b ? <b>{s.b}</b> : s.t))}</p>
                    </div>
                    <div class="ft-tx" data-ft-tx data-open="false">
                      <button type="button" class="ft-tx-toggle" data-ft-txtoggle aria-expanded="false">
                        {r.txLabel}<em class="ft-wordcount">{r.txCount}</em><span class="ft-tx-chev" aria-hidden="true">▾</span>
                      </button>
                      <div class="ft-tx-body">
                        <div class="ft-tx-scroll">
                          {r.tx.map((seg) => (
                            <p class="ft-tx-seg"><span class="ft-tx-time">{seg.t}</span><span>{seg.s}{seg.dim && <span class="ft-dim">{seg.dim}</span>}{seg.hl && <span class="ft-hl">{seg.hl}</span>}{seg.after}</span></p>
                          ))}
                        </div>
                      </div>
                    </div>
                    <div class="ft-tags">
                      {r.tags.map((t) => <span class="ft-tag">{t}</span>)}
                    </div>
                    <div class="ft-actions">
                      <button type="button" class="ft-act"><span class="ft-act-ic" aria-hidden="true">✂</span>rip the keeper</button>
                      <button type="button" class="ft-act ft-act-hot"><span class="ft-act-ic" aria-hidden="true">🐢</span>send to Richard</button>
                      <button type="button" class="ft-act"><span class="ft-act-ic" aria-hidden="true">▲</span>promote to Live</button>
                    </div>
                  </div>
                </div>
              </article>
            );
          })}
        </div>
        <div class="dev-foot"><span class="dev-grille" aria-hidden="true"></span><span class="dev-tag">what the catalog understands</span></div>
      </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-ft]").forEach((root) => {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const readout = root.querySelector<HTMLElement>("[data-ft-readout]");
    const fire = root.querySelector<HTMLButtonElement>("[data-ft-fire]");
    const picks = root.querySelectorAll<HTMLButtonElement>("[data-ft-pick]");
    const READOUT: Record<string, string> = { idle: "standby", running: "charging…", done: "online" };
    const LABEL: Record<string, string> = { idle: "forge", running: "forging", done: "forged" };
    const labelEl = root.querySelector<HTMLElement>("[data-ft-label]");
    let timer = 0;

    // give each conduit path its TRUE length so the draw fills over its full duration (uniform + fluid — kills the fast-then-wait "stop at the orb")
    root.querySelectorAll<SVGPathElement>(".ft-trace-flow .ft-flow").forEach((p) => p.style.setProperty("--len", String(p.getTotalLength())));

    const sync = () => {
      const st = root.dataset.state || "idle";
      if (readout) readout.textContent = READOUT[st] ?? "standby";
      if (labelEl) labelEl.textContent = LABEL[st] ?? "forge";
    };
    const select = (id: string) => {
      if (!["46", "47", "48"].includes(id)) return;
      root.dataset.file = id;
      picks.forEach((p) => p.setAttribute("aria-selected", String(p.dataset.ftPick === id)));
      if (root.dataset.state === "done") { root.dataset.state = "idle"; sync(); }
    };
    const run = () => {
      root.dataset.fired = "true";              // first press proves it is a control — retires the invite ring
      if (root.dataset.state === "running") return;
      if (root.dataset.state === "done") { root.dataset.state = "idle"; sync(); return; }
      if (reduce) { root.dataset.state = "done"; sync(); return; }
      root.dataset.state = "running"; sync();
      window.clearTimeout(timer);
      timer = window.setTimeout(() => { root.dataset.state = "done"; sync(); }, 2200);
    };
    picks.forEach((p) => p.addEventListener("click", () => select(p.dataset.ftPick || "")));
    fire?.addEventListener("click", run);

    root.querySelectorAll<HTMLElement>(".ft-card").forEach((card) => {
      // the keeper's waveform is the play surface — bars light as the take speaks
      const playBtn = card.querySelector<HTMLButtonElement>("[data-ft-play]");
      const audio = card.querySelector<HTMLAudioElement>(".ft-card-audio");
      if (playBtn && audio) {
        const bars = [...playBtn.querySelectorAll<HTMLElement>(".ft-bar")];
        let raf = 0;
        audio.volume = 0.9;
        const paint = () => {
          const n = audio.duration ? Math.floor((audio.currentTime / audio.duration) * bars.length) : 0;
          bars.forEach((b, i) => b.classList.toggle("played", i < n));
          if (!audio.paused) raf = requestAnimationFrame(paint);
        };
        playBtn.addEventListener("click", () => {
          if (audio.paused) {
            document.dispatchEvent(new CustomEvent("bench:play", { detail: { source: card } }));
            const p = audio.play(); if (p && p.catch) p.catch(() => {});
          } else audio.pause();
        });
        audio.addEventListener("play", () => { card.dataset.playing = "true"; raf = requestAnimationFrame(paint); });
        audio.addEventListener("pause", () => { card.dataset.playing = "false"; cancelAnimationFrame(raf); });
        audio.addEventListener("ended", () => { card.dataset.playing = "false"; cancelAnimationFrame(raf); bars.forEach((b) => b.classList.remove("played")); });
        document.addEventListener("bench:play", (e) => {
          if ((e as CustomEvent).detail?.source !== card && !audio.paused) audio.pause();
        });
      }
      const cardToggle = card.querySelector<HTMLButtonElement>("[data-ft-cardtoggle]");
      cardToggle?.addEventListener("click", () => {
        const open = card.dataset.open !== "false";
        card.dataset.open = open ? "false" : "true";
        cardToggle.setAttribute("aria-expanded", String(!open));
      });
      const tx = card.querySelector<HTMLElement>("[data-ft-tx]");
      const txToggle = card.querySelector<HTMLButtonElement>("[data-ft-txtoggle]");
      txToggle?.addEventListener("click", () => {
        const open = tx!.dataset.open === "true";
        tx!.dataset.open = open ? "false" : "true";
        txToggle.setAttribute("aria-expanded", String(!open));
      });
    });
    sync();
  });
</script>

<style>
  .ft { position: relative; width: 100%; color: #f5f1e8; overflow: hidden; isolation: isolate;
    min-height: clamp(620px, 88vh, 880px); display: flex; align-items: center; justify-content: center;
    padding: clamp(20px, 4vh, 44px) clamp(16px, 4vw, 56px);
    background: radial-gradient(70% 60% at 50% 50%, rgba(14, 196, 252, 0.05), transparent 75%); }
  .ft-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .ft-stage { display: flex; align-items: center; justify-content: center; }

  /* ── the unifying console (one physical object) ── */
  .ft-console {
    position: relative; width: 1160px; height: 712px; flex: 0 0 auto; border-radius: 30px;
    background:
      radial-gradient(80% 70% at 50% 30%, rgba(36, 44, 58, 0.6), transparent 70%),
      repeating-linear-gradient(98deg, rgba(255, 255, 255, 0.012) 0 2px, transparent 2px 5px),
      linear-gradient(162deg, #2b313d 0%, #181c25 46%, #0f1219 100%);
    border: 1px solid rgba(0, 0, 0, 0.6);
    box-shadow: 0 60px 110px -44px rgba(0, 0, 0, 0.92), inset 0 2px 0 rgba(255, 255, 255, 0.14), inset 0 -5px 12px rgba(0, 0, 0, 0.6), inset 0 0 0 1px rgba(120, 160, 210, 0.05);
  }
  .ft-console::before { /* inner recessed bezel */
    content: ""; position: absolute; inset: 14px; border-radius: 20px; pointer-events: none;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.5), inset 0 2px 6px rgba(0, 0, 0, 0.45), inset 0 -1px 0 rgba(255, 255, 255, 0.05);
  }
  /* the working stage: the original 1160×660 field, dropped 52px so the AudioDex
     header band sits clear of it. All module + conduit coords stay registered to it. */
  .ft-stage-inner { position: absolute; top: 52px; left: 0; width: 1160px; height: 660px; }
  @media (max-width: 1240px) { .ft-console { transform: scale(0.92); } }
  @media (max-width: 1080px) { .ft-console { transform: scale(0.8); } }
  /* From here down, transform:scale no longer matches the 712px layout box, so
     the stage takes the SCALED height explicitly (712 × scale) — otherwise the
     console floats in a well of dead space it no longer occupies visually. */
  @media (max-width: 920px) {
    .ft { min-height: 0; }
    .ft-stage { align-items: flex-start; height: 470px; }
    .ft-console { transform: scale(0.66); transform-origin: top center; }
  }
  @media (max-width: 760px) { .ft-console { transform: scale(0.52); } .ft-stage { height: 370px; } }
  /* phones: keep the whole machine on screen (it stays an object you fire and
     watch respond — the card text is recovered by the transport just below) */
  @media (max-width: 620px) { .ft-console { transform: scale(0.44); } .ft-stage { height: 313px; } }
  @media (max-width: 520px) { .ft-console { transform: scale(0.36); } .ft-stage { height: 256px; } }
  @media (max-width: 430px) { .ft-console { transform: scale(0.29); } .ft-stage { height: 207px; } }

  .ft-chassis-serial { position: absolute; right: 34px; bottom: 19px; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 9px; letter-spacing: 0.22em; text-transform: uppercase; color: rgba(245, 241, 232, 0.24); }
  .ft-chassis-vents { position: absolute; left: 50%; bottom: 16px; transform: translateX(-50%); width: 120px; height: 12px; border-radius: 3px; background: repeating-linear-gradient(90deg, rgba(0, 0, 0, 0.4) 0 2px, rgba(245, 241, 232, 0.06) 2px 5px); opacity: 0.6; }
  .ft-bolt { position: absolute; width: 11px; height: 11px; border-radius: 50%; background: radial-gradient(circle at 38% 32%, #535a67, #14171d); box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.55), 0 1px 0 rgba(255, 255, 255, 0.06); }
  .ft-bolt::after { content: ""; position: absolute; inset: 3px; border-top: 1px solid rgba(0, 0, 0, 0.5); transform: rotate(40deg); }
  .ft-bolt-tl { top: 20px; left: 20px; } .ft-bolt-tr { top: 20px; right: 20px; } .ft-bolt-bl { bottom: 20px; left: 20px; } .ft-bolt-br { bottom: 20px; right: 20px; }

  /* conduit traces */
  /* lifted above the modules (z-index 2) so the canal can trace the AudioDex screen border on top */
  .ft-traces { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 3; overflow: visible; pointer-events: none; }
  .ft-flow { stroke: #19e0ff; stroke-dasharray: var(--len, 1200); stroke-dashoffset: var(--len, 1200); opacity: 0; filter: drop-shadow(0 0 5px rgba(25, 224, 255, 0.9)); }
  /* ONE fluid trace at constant speed (linear): the canal runs kiln -> charge cell, then continues around the orb's perimeter, with no decel-stall at the junction. The charge does not begin until the perimeter is closed (~1.0s). */
  .ft[data-state="running"] .ft-flow-power  { opacity: 1; animation: ft-draw 0.05s linear 0.04s forwards; }
  .ft[data-state="running"] .ft-flow-charge { opacity: 1; animation: ft-draw 0.6s linear 0.1s forwards; }
  .ft[data-state="running"] .ft-flow-arc    { opacity: 1; animation: ft-draw 0.3s linear 0.7s forwards; }
  /* then the cell CHARGES (1.0s -> 2.0s); at the BURST the discharge + AudioDex border shoot fast and the record lands */
  .ft[data-state="running"] .ft-flow-dis    { opacity: 1; animation: ft-draw 0.07s ease-in 2.04s forwards; }
  .ft[data-state="running"] .ft-flow-border { opacity: 1; animation: ft-draw 0.13s cubic-bezier(0.16, 0.85, 0.3, 1) 2.06s forwards; }
  @keyframes ft-draw { from { stroke-dashoffset: var(--len, 1200); } to { stroke-dashoffset: 0; } }
  /* past the orb the canal carries the rainbow the cell forges — discharge + the AudioDex border */
  .ft-flow-dis, .ft-flow-border { stroke: url(#ftRainbow); filter: drop-shadow(0 0 5px rgba(255, 90, 180, 0.7)); }
  .ft-flow-border { stroke-width: 2.4; }

  /* charge cell · a glass diode seated in a socket */
  .ft-cell { position: absolute; left: 502px; top: 312px; width: 92px; height: 92px; z-index: 3; display: grid; place-items: center; }
  .ft-cell-ring { position: absolute; inset: 0; width: 100%; height: 100%; }
  /* an ETHEREAL soft aura around the whole glass chamber — a quiet idle hum that swells as it charges */
  .ft-cell-aura { position: absolute; width: 132px; height: 132px; border-radius: 50%; pointer-events: none; mix-blend-mode: screen; opacity: 0.45;
    background: radial-gradient(circle, rgba(25,224,255,0.42) 0%, rgba(123,92,255,0.18) 40%, transparent 70%); filter: blur(7px);
    animation: ft-aura-hum 5s ease-in-out infinite; }
  @keyframes ft-aura-hum { 0%,100% { opacity: 0.38; transform: scale(0.95); } 50% { opacity: 0.6; transform: scale(1.05); } }
  .ft[data-state="running"] .ft-cell-aura { animation: ft-aura-charge 1s ease-out 1s both; }
  @keyframes ft-aura-charge {
    0% { opacity: 0.45; transform: scale(0.95); }
    55% { opacity: 0.72; transform: scale(1.22); }
    68% { opacity: 0.78; transform: scale(1.3); }
    76% { opacity: 0.7; transform: scale(1.22); }
    84% { opacity: 1; transform: scale(1.66); }
    100% { opacity: 0.45; transform: scale(0.98); }
  }
  .ft-cell-rainbow { position: absolute; width: 68px; height: 68px; border-radius: 50%; opacity: 0; mix-blend-mode: screen; filter: blur(10px);
    background: conic-gradient(from 0deg, #19e0ff, #7b5cff, #ff2d8b, #ffd23d, #19e0ff); }
  /* the orb — an EMPTY GLASS bulb at rest (clear, dark interior, glassy highlights + a faint cold filament); FILLS the chamber so no dead-space to the ring, and lights up with energy as it charges */
  .ft-cell-diode { position: relative; width: 74px; height: 74px; border-radius: 50%; overflow: hidden; border: 1px solid rgba(150, 205, 235, 0.3);
    background:
      radial-gradient(circle at 36% 28%, rgba(255,255,255,0.22), transparent 26%),
      radial-gradient(circle at 68% 76%, rgba(120,200,240,0.12), transparent 40%),
      radial-gradient(circle at 50% 48%, rgba(18,46,66,0.45) 0%, rgba(9,24,36,0.62) 58%, rgba(6,16,26,0.8) 100%);
    box-shadow: inset 0 0 16px rgba(0,0,0,0.55), inset 0 2px 6px rgba(255,255,255,0.14), inset 0 -6px 12px rgba(0,0,0,0.35), 0 0 12px rgba(14,196,252,0.2); }
  .ft-cell-diode-core { position: absolute; inset: 40%; border-radius: 50%; background: radial-gradient(circle, rgba(174,249,255,0.55), rgba(25,224,255,0.12) 70%); opacity: 0.32; filter: blur(1.4px); }
  .ft-cell-diode-spec { position: absolute; top: 14%; left: 24%; width: 26%; height: 18%; border-radius: 50%; background: rgba(255,255,255,0.7); filter: blur(1.6px); }
  /* the orb stays at rest while the conduit traces TO and AROUND it; the charge is DELAYED until the perimeter closes (~1.0s), then runs over the second half */
  .ft[data-state="running"] .ft-cell-diode-core { animation: ft-diodecore 1.2s linear 1s both; }
  /* FILL -> HOLD -> FLASH: the core fills to a held full charge, holds steady briefly, then a sudden flash empties into the record */
  @keyframes ft-diodecore {
    0% { opacity: 0.32; transform: scale(1); animation-timing-function: ease-out; }
    50% { opacity: 0.82; transform: scale(2.1); }
    58% { opacity: 0.85; transform: scale(2.18); }
    78% { opacity: 0.85; transform: scale(2.18); animation-timing-function: cubic-bezier(0.6, 0, 0.1, 1); }
    88% { opacity: 1; transform: scale(3.8); }
    100% { opacity: 0.32; transform: scale(1); }
  }
  .ft[data-state="running"] .ft-cell-diode { animation: ft-diodeglow 1.2s linear 1s both; }
  @keyframes ft-diodeglow {
    0% { box-shadow: inset 0 0 16px rgba(0,0,0,0.55), inset 0 2px 6px rgba(255,255,255,0.14), inset 0 -6px 12px rgba(0,0,0,0.35), 0 0 12px rgba(14,196,252,0.2); animation-timing-function: ease-out; }
    50% { box-shadow: inset 0 0 30px rgba(120,210,245,0.62), inset 0 2px 6px rgba(255,255,255,0.22), 0 0 40px rgba(25,224,255,0.66); }
    58% { box-shadow: inset 0 0 34px rgba(150,225,255,0.76), 0 0 48px rgba(25,224,255,0.76); }
    78% { box-shadow: inset 0 0 34px rgba(150,225,255,0.76), 0 0 48px rgba(25,224,255,0.76); animation-timing-function: cubic-bezier(0.6, 0, 0.1, 1); }
    88% { box-shadow: inset 0 0 42px rgba(255,255,255,0.98), 0 0 90px 22px rgba(123,92,255,0.98); }
    100% { box-shadow: inset 0 0 16px rgba(0,0,0,0.55), inset 0 2px 6px rgba(255,255,255,0.14), inset 0 -6px 12px rgba(0,0,0,0.35), 0 0 12px rgba(14,196,252,0.2); }
  }
  .ft[data-state="running"] .ft-cell-rainbow { animation: ft-cellrainbow 1.2s linear 1s both; }
  @keyframes ft-cellrainbow {
    0%, 80% { opacity: 0; transform: scale(0.4) rotate(0deg); }
    88% { opacity: 1; transform: scale(1.9) rotate(60deg); }
    95% { opacity: 0.8; transform: scale(2.5) rotate(200deg); }
    100% { opacity: 0; transform: scale(3) rotate(320deg); }
  }

  /* the glass chamber HARNESSES energy in its dead-space once the perimeter is full, then discharges into the AudioDex */
  .ft-cell-chamber { position: absolute; width: 72px; height: 72px; border-radius: 50%; opacity: 0; mix-blend-mode: screen; pointer-events: none; filter: blur(2.5px);
    background: radial-gradient(circle, rgba(234,255,255,0.92) 0%, rgba(25,224,255,0.72) 32%, rgba(123,92,255,0.44) 64%, rgba(123,92,255,0.1) 84%, transparent 100%); }
  .ft[data-state="running"] .ft-cell-chamber { animation: ft-chamber 1.2s ease-out 1s both; }
  @keyframes ft-chamber {
    0%, 80% { opacity: 0; transform: scale(0.3); }
    88% { opacity: 1; transform: scale(1.15); }
    94% { opacity: 0.2; transform: scale(0.85); }
    100% { opacity: 0; transform: scale(0.5); }
  }
  /* the chamber's glass border lights up as it charges */
  .ft-cell-ring-glow { filter: drop-shadow(0 0 3px #19e0ff); }
  .ft[data-state="running"] .ft-cell-ring-glow { animation: ft-ringglow 1.2s ease-out 1s both; }
  @keyframes ft-ringglow { 0% { opacity: 0; } 50% { opacity: 0.8; } 58% { opacity: 0.85; } 78% { opacity: 0.85; } 88% { opacity: 1; } 100% { opacity: 0; } }

  /* ── modules mounted on the console ── */
  .ft-mod { position: absolute; }
  .dev { border-radius: 18px; padding: 10px 11px 11px;
    background: linear-gradient(158deg, #3a4150 0%, #1d222c 46%, #0f1219 100%);
    border: 1px solid rgba(0, 0, 0, 0.6);
    box-shadow: 0 20px 40px -20px rgba(0, 0, 0, 0.85), inset 0 1.5px 0 rgba(255, 255, 255, 0.16), inset 0 -3px 7px rgba(0, 0, 0, 0.6); }
  .dev-top { display: flex; align-items: center; gap: 9px; padding: 2px 7px 9px; }
  .dev-brand { flex: 1; font-family: "Space Grotesk Variable", "Space Grotesk", sans-serif; font-weight: 700; font-size: 12px; letter-spacing: 0.04em; color: rgba(245, 241, 232, 0.62); }
  .ft-adx { color: var(--brand-cyan); }
  .dev-led { width: 8px; height: 8px; border-radius: 50%; flex: 0 0 auto; }
  .dev-led-cyan { background: radial-gradient(circle at 35% 30%, #bff4ff, #0ec4fc 70%); box-shadow: 0 0 8px rgba(14, 196, 252, 0.9), inset 0 0 2px rgba(255, 255, 255, 0.6); }
  .dev-led-amber { background: radial-gradient(circle at 35% 30%, #ffe6b0, #ffb347 70%); box-shadow: 0 0 8px rgba(255, 179, 71, 0.8); transition: background 200ms ease, box-shadow 200ms ease; }
  .ft[data-state="running"] .dev-led-amber { background: radial-gradient(circle at 35% 30%, #bff4ff, #0ec4fc 70%); box-shadow: 0 0 10px rgba(14, 196, 252, 0.9); }
  .ft[data-state="done"] .dev-led-amber { background: radial-gradient(circle at 35% 30%, #d8ffe4, #00ff4d 70%); box-shadow: 0 0 10px rgba(0, 255, 77, 0.8); }
  .dev-readout, .dev-port { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 9px; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(245, 241, 232, 0.46); border: 1px solid rgba(245, 241, 232, 0.16); border-radius: 4px; padding: 2px 7px; }
  .ft[data-state="done"] .dev-readout { color: var(--brand-green); border-color: rgba(0, 255, 77, 0.4); }
  .ft[data-state="running"] .dev-readout { color: var(--brand-cyan); border-color: rgba(14, 196, 252, 0.4); }
  .dev-port { padding: 4px 5px; border-style: dashed; opacity: 0.6; }
  .dev-screen { position: relative; border-radius: 11px; overflow: hidden; background: #07060c; box-shadow: inset 0 3px 11px rgba(0, 0, 0, 0.8), inset 0 0 0 1px rgba(0, 0, 0, 0.7), inset 0 0 0 2px rgba(120, 160, 210, 0.06); }
  .dev-screen::after { content: ""; position: absolute; inset: 0; pointer-events: none; z-index: 9; background: linear-gradient(135deg, rgba(255, 255, 255, 0.07), transparent 36%); }
  .dev-foot { display: flex; align-items: center; gap: 10px; padding: 8px 7px 1px; }
  .dev-grille { flex: 0 0 auto; width: 28px; height: 7px; border-radius: 2px; background: repeating-linear-gradient(90deg, rgba(245, 241, 232, 0.22) 0 1.5px, transparent 1.5px 4px); opacity: 0.55; }
  .dev-tag { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 8.5px; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(245, 241, 232, 0.32); }

  /* module placements (console coords) */
  .ft-source-dev { left: 48px; top: 40px; width: 380px; z-index: 2; }
  .ft-forge { left: 56px; top: 332px; width: 364px; z-index: 2; }
  .ft-out-dev { left: 624px; top: 62px; width: 488px; z-index: 2; }

  /* SOURCE · Finder */
  .ft-finder { position: relative; font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", system-ui, sans-serif; }
  .ft-finder-bar { display: flex; align-items: center; gap: 10px; padding: 7px 12px; background: linear-gradient(180deg, #323234, #2a2a2c); border-bottom: 1px solid rgba(0, 0, 0, 0.45); }
  .ft-tl { display: inline-flex; gap: 6px; }
  .ft-tl i { width: 10px; height: 10px; border-radius: 50%; display: block; }
  .ft-tl i:nth-child(1) { background: #ff5f57; } .ft-tl i:nth-child(2) { background: #febc2e; } .ft-tl i:nth-child(3) { background: #28c840; }
  .ft-finder-folder { font-size: 12.5px; font-weight: 600; color: rgba(255, 255, 255, 0.92); }
  .ft-finder-view { margin-left: auto; color: rgba(255, 255, 255, 0.5); display: inline-flex; }
  .ft-finder-cols { display: flex; justify-content: space-between; padding: 6px 14px; background: #252527; border-bottom: 1px solid rgba(0, 0, 0, 0.4); font-size: 11px; color: rgba(255, 255, 255, 0.5); }
  .ft-col-name i { color: rgba(255, 255, 255, 0.7); font-style: normal; font-size: 8px; }
  .ft-finder-list { list-style: none; margin: 0; padding: 5px; background: #1d1d1f; }
  .ft-finder-list li { margin: 0; }
  .ft-frow { display: flex; justify-content: space-between; align-items: center; gap: 12px; width: 100%; padding: 8px 11px; font-size: 12.5px; color: rgba(255, 255, 255, 0.82); background: transparent; border: 1px solid transparent; border-radius: 6px; cursor: pointer; text-align: left; transition: background 140ms ease, border-color 140ms ease, box-shadow 200ms ease; }
  .ft-fname { display: inline-flex; align-items: center; gap: 9px; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ft-fic { color: #8aa9c9; flex: 0 0 auto; }
  .ft-fdate { color: rgba(255, 255, 255, 0.5); font-size: 11.5px; flex: 0 0 auto; }
  .ft-frow:hover { background: rgba(255, 255, 255, 0.06); border-color: rgba(255, 255, 255, 0.12); }
  .ft-frow:focus-visible { outline: none; border-color: rgba(14, 196, 252, 0.6); box-shadow: 0 0 0 2px rgba(14, 196, 252, 0.18); }
  .ft-frow[aria-selected="true"] { background: #0a63d6; color: #fff; border-color: #0a63d6; }
  .ft-frow[aria-selected="true"] .ft-fic { color: #cfe0f3; }
  .ft-frow[aria-selected="true"] .ft-fdate { color: rgba(255, 255, 255, 0.82); }

  .ft-scan { position: absolute; top: 0; bottom: 0; left: 0; width: 36%; pointer-events: none; opacity: 0; z-index: 5;
    background: linear-gradient(90deg, transparent, rgba(25, 224, 255, 0.08) 55%, rgba(25, 224, 255, 0.8) 90%, rgba(191, 244, 255, 0.95));
    border-right: 1.5px solid rgba(191, 244, 255, 0.95); box-shadow: 0 0 22px rgba(25, 224, 255, 0.7);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 65%); mask-image: linear-gradient(90deg, transparent, #000 65%); }
  .ft[data-state="running"] .ft-scan { animation: ft-scan 0.7s cubic-bezier(0.5, 0, 0.5, 1) 0.08s forwards; }
  @keyframes ft-scan { 0% { opacity: 0; transform: translateX(-100%); } 14% { opacity: 1; } 86% { opacity: 1; } 100% { opacity: 0; transform: translateX(320%); } }
  .ft[data-state="running"] .ft-frow[aria-selected="true"] { box-shadow: 0 0 0 1px rgba(25, 224, 255, 0.7), 0 0 22px -4px rgba(25, 224, 255, 0.7); }

  /* ════ KILN forge — ROTATING vibranium-album DIAL + STATIC plasma-globe SCREEN ════ */

  .ft-forge { border: 0; padding: 0; background: transparent; cursor: pointer; display: flex; flex-direction: column; align-items: center; }
  .ft-forge-dome { position: relative; width: 232px; aspect-ratio: 1; display: grid; place-items: center; }

  /* BOTTOM layer (KEPT) — dark dome base */
  .ft-forge-body { position: absolute; inset: 0; border-radius: 50%; z-index: 0;
    background: radial-gradient(132% 132% at 33% 25%, #2a2740 0%, #14121f 40%, #0a0810 74%, #050409 100%);
    box-shadow: 0 24px 48px -18px rgba(0,0,0,0.9), inset 0 2px 3px rgba(180,160,255,0.18), inset 0 -22px 36px rgba(0,0,0,0.65), 0 0 48px -10px rgba(123,92,255,0.30);
    border: 1px solid rgba(150,130,210,0.08); }

  /* ════ ROTATING DIAL — the ONLY element that spins (bezel rim + concentric grooves + index notch) ════ */
  .ft-forge-dial { position: absolute; inset: 0; border-radius: 50%; display: grid; place-items: center;
    transform-origin: center; animation: ft-spin 12s linear infinite; will-change: transform;
    z-index: 1; pointer-events: none; }                          /* slow idle */
  /* the dial reads as a vibranium record: concentric alloy grooves + a violet-graphite sheen that catches light as it spins */
  .ft-dial-rim { position: absolute; inset: 0; border-radius: 50%; pointer-events: none;
    background:
      repeating-radial-gradient(circle, rgba(200,190,235,0.05) 0 0.75px, rgba(0,0,0,0.12) 0.75px 2.25px),
      conic-gradient(from 210deg, #3a3550 0deg, #6b6480 8%, #2b2838 18%, #4a4560 28%, #211f2c 38%, #5e5775 50%, #2e2b3a 60%, #4d4763 72%, #26232f 82%, #635c7a 92%, #36323f 100%);
    box-shadow: inset 0 0 0 1px rgba(170,150,220,0.28), inset 0 1px 1px rgba(220,210,255,0.16), inset 0 0 22px rgba(0,0,0,0.6);
    -webkit-mask: radial-gradient(circle, transparent 0 48px, #000 51px, #000 114px, transparent 116px);
            mask: radial-gradient(circle, transparent 0 48px, #000 51px, #000 114px, transparent 116px); }
  .ft-forge-bezel { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .ft-dial-index { filter: drop-shadow(0 0 4px rgba(170,130,255,0.85)); }
  .ft-dial-index-dot { filter: drop-shadow(0 0 5px rgba(170,130,255,0.9)); }
  @keyframes ft-spin { to { transform: rotate(360deg); } }

  /* ════ vibranium bezel LIP — a polished alloy ring framing the inset screen (static) ════ */
  .ft-dial-lip { position: absolute; inset: 0; border-radius: 50%; z-index: 1; pointer-events: none;
    background: conic-gradient(from 200deg, #6a6385, #9b94b5, #46415c, #837ca0, #3a3650, #908ab0, #4a4663, #6f6890);
    -webkit-mask: radial-gradient(circle, transparent 0 45px, #000 48px, #000 55px, transparent 57px);
            mask: radial-gradient(circle, transparent 0 45px, #000 48px, #000 55px, transparent 57px); }

  /* ════ STATIC SCREEN — the inset plasma display; never rotates ════ */
  .ft-forge-screen { position: absolute; width: 96px; height: 96px; border-radius: 50%;
    display: grid; place-items: center; z-index: 2; pointer-events: none;
    box-shadow: 0 0 0 1px rgba(123,92,255,0.55), 0 0 22px rgba(123,92,255,0.42); }
  /* a glass cover over the plasma — top-left specular sheen */
  .ft-forge-screen::after { content: ""; position: absolute; inset: 0; border-radius: 50%; pointer-events: none; z-index: 3;
    background: radial-gradient(64% 46% at 33% 21%, rgba(255,255,255,0.16), rgba(255,255,255,0.03) 42%, transparent 64%); mix-blend-mode: screen; }

  /* dark scope well behind the plasma + slow breathe glow */
  .ft-scope { position: absolute; inset: 0; border-radius: 50%; overflow: hidden;
    background:
      radial-gradient(circle at 50% 50%, rgba(8,30,50,0) 46%, rgba(2,6,12,0.85) 100%),
      radial-gradient(120% 120% at 50% 16%, #0a2b3a 0%, #051a26 46%, #02101a 100%);
    box-shadow: inset 0 0 18px rgba(0,0,0,0.9), inset 0 0 0 1px rgba(150,210,255,0.20),
      inset 0 2px 12px rgba(150,140,255,0.12);
    animation: ft-scope-breathe 4.5s ease-in-out infinite; }
  @keyframes ft-scope-breathe {
    0%,100% { box-shadow: inset 0 0 18px rgba(0,0,0,0.9), inset 0 0 0 1px rgba(150,210,255,0.18), inset 0 2px 12px rgba(150,140,255,0.10); }
    50%     { box-shadow: inset 0 0 18px rgba(0,0,0,0.9), inset 0 0 0 1px rgba(170,160,255,0.26), inset 0 2px 12px rgba(150,140,255,0.18); } }

  /* the plasma SVG fills the inset screen (240 viewBox, center 120,120) */
  .ft-reactor { position: absolute; width: 96px; height: 96px; overflow: visible; pointer-events: none; }

  /* ── plasma globe · idle life (gentle breathe + electric flicker) ── */
  .ft-pl-core { transform-box: fill-box; transform-origin: center; animation: ft-pl-breathe 2.6s ease-in-out infinite; }
  .ft-pl-bloom { transform-box: fill-box; transform-origin: center; animation: ft-pl-blow 4.1s ease-in-out infinite; }
  .ft-pl-arcs, .ft-pl-tips { animation: ft-pl-flick 2.9s steps(1) infinite; }
  .ft-pl-forks { animation: ft-pl-fork 1.7s steps(1) infinite; }
  .ft-pl-field { transform-box: fill-box; transform-origin: center; } /* the whole plasma field — whirls up during activation */
  @keyframes ft-pl-breathe { 0%,100% { transform: scale(1); opacity: 0.95; } 50% { transform: scale(1.1); opacity: 1; } }
  @keyframes ft-pl-blow { 0%,100% { opacity: 0.7; transform: scale(1); } 50% { opacity: 1; transform: scale(1.06); } }
  @keyframes ft-pl-flick { 0%,46%,100% { opacity: 1; } 47%,52% { opacity: 0.55; } 53%,72% { opacity: 1; } 73%,76% { opacity: 0.7; } }
  @keyframes ft-pl-fork { 0%,40% { opacity: 0.85; } 41%,49% { opacity: 0.25; } 50%,100% { opacity: 0.85; } }
  .ft-forge:hover .ft-pl-core { filter: drop-shadow(0 0 7px rgba(255,255,255,0.95)) drop-shadow(0 0 14px rgba(123,92,255,0.6)); }
  .ft-forge:hover .ft-pl-arcs { filter: brightness(1.3); }

  /* the BOOM flash overlay that flares the screen at release */
  .ft-pl-flash { position: absolute; inset: 0; border-radius: 50%; z-index: 3; pointer-events: none; opacity: 0;
    background: radial-gradient(circle, #f4ffff 0%, #b8ecff 38%, #7d5cff 78%, #5e44d8 100%); }

  /* TOP layer (KEPT) — glassy dome highlight */
  .ft-forge-glass { position: absolute; inset: 0; border-radius: 50%; pointer-events: none; z-index: 4;
    background: radial-gradient(58% 42% at 34% 22%, rgba(255,255,255,0.28), transparent 60%); mix-blend-mode: screen; }

  /* idle press / hover / focus — the dome lifts and the screen brightens on hover
     so the object reads as a pressable control, not a status display */
  .ft-forge-dome { transition: transform 200ms cubic-bezier(0.22, 1, 0.36, 1); }
  .ft-forge-screen { transition: box-shadow 240ms ease; }
  .ft-forge:focus-visible { outline: none; }
  .ft-forge:focus-visible .ft-forge-body { box-shadow: 0 22px 44px -18px rgba(0,0,0,0.85), 0 0 0 3px rgba(14,196,252,0.5); }
  .ft-forge:hover .ft-forge-dome { transform: translateY(-3px) scale(1.015); }
  .ft-forge:active .ft-forge-dome { transform: translateY(1px) scale(0.985); }
  .ft-forge:hover .ft-forge-screen { box-shadow: 0 0 0 1px rgba(123,92,255,0.72), 0 0 30px rgba(123,92,255,0.6); }

  /* ── PRESS SIGNIFIER: a sighted "press to fire" label so a first-time visitor
     knows this object is a control. Legible at rest, tracks state
     (firing / fired), goes full on hover. ── */
  /* a diegetic machine legend, not a UI instruction: the kiln's function ("forge")
     etched in micro-type, led by a small status LED that breathes "live / ready".
     The verb + the live LED + the invite ring + cursor read as "operable" without
     a shouted "press to fire". Tracks state: forge -> forging -> forged. */
  .ft-forge-label {
    margin-top: 16px; display: inline-flex; align-items: center; gap: 8px;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 10px; font-weight: 600; letter-spacing: 0.34em; text-transform: lowercase;
    color: rgba(245, 241, 232, 0.5); white-space: nowrap; padding-left: 2px;
    transition: color 260ms ease, text-shadow 260ms ease;
  }
  .ft-forge-label::before {
    content: ""; width: 6px; height: 6px; border-radius: 50%; flex: 0 0 auto;
    background: radial-gradient(circle at 35% 30%, #d6c4ff, #7b5cff 70%);
    box-shadow: 0 0 8px rgba(123, 92, 255, 0.9);
    animation: ft-led 2.3s ease-in-out infinite;
  }
  @keyframes ft-led { 0%, 100% { opacity: 0.4; } 50% { opacity: 1; } }
  .ft-forge:hover .ft-forge-label { color: rgba(245, 241, 232, 0.95); text-shadow: 0 0 12px rgba(123, 92, 255, 0.6); }
  .ft[data-state="running"] .ft-forge-label { color: var(--brand-cyan); }
  .ft[data-state="running"] .ft-forge-label::before { background: radial-gradient(circle at 35% 30%, #bff4ff, #0ec4fc 70%); box-shadow: 0 0 9px rgba(14,196,252,0.95); animation: none; opacity: 1; }
  .ft[data-state="done"] .ft-forge-label { color: var(--brand-green); }
  .ft[data-state="done"] .ft-forge-label::before { background: radial-gradient(circle at 35% 30%, #d8ffe4, #00ff4d 70%); box-shadow: 0 0 9px rgba(0,255,77,0.95); animation: none; opacity: 1; }

  /* ── INVITE RING: a calm ring breathes from the dome edge ("live control,
     press me") until the first fire retires it. Rhythmic, never spinning, so it
     never reads as loading. ── */
  .ft-forge-arm {
    position: absolute; inset: -7px; border-radius: 50%; z-index: 5; pointer-events: none;
    border: 1.5px solid rgba(123, 92, 255, 0.6); opacity: 0;
  }
  .ft:not([data-fired="true"]) .ft-forge-arm { animation: ft-arm 2.3s ease-out infinite; }
  @keyframes ft-arm {
    0% { opacity: 0.75; transform: scale(0.9); }
    70% { opacity: 0; transform: scale(1.16); }
    100% { opacity: 0; transform: scale(1.16); }
  }

  /* ════ RUNNING (~2.2s) — once the circuit closes (~1.0s) the kiln's CENTER SCREEN fills with energy, holds at full, then flares on release; the charge cell fills + bursts in lockstep ════ */
  .ft[data-state="running"] .ft-forge-dial { animation: ft-spin 0.7s linear infinite; }
  .ft[data-state="running"] .ft-pl-core { animation: ft-pl-charge 1.2s linear 1s both; }
  /* the plasma core fills (grows + brightens), holds at full, then flares wide on release, then settles to idle */
  @keyframes ft-pl-charge { 0% { transform: scale(1); animation-timing-function: ease-out; } 50% { transform: scale(1.42); } 58% { transform: scale(1.46); } 78% { transform: scale(1.46); animation-timing-function: cubic-bezier(0.6, 0, 0.1, 1); } 88% { transform: scale(1.95); } 100% { transform: scale(1); } }
  .ft[data-state="running"] .ft-pl-bloom { animation: ft-pl-bloomcharge 1.2s linear 1s both; }
  @keyframes ft-pl-bloomcharge { 0% { opacity: 0.7; transform: scale(1); animation-timing-function: ease-out; } 50% { opacity: 1; transform: scale(1.24); } 78% { opacity: 1; transform: scale(1.24); } 88% { opacity: 1; transform: scale(1.5); } 100% { opacity: 0.7; transform: scale(1.02); } }
  /* the electric arcs intensify as the screen fills, hold, blaze on release, then settle back to idle arcs (no solid disc) */
  .ft[data-state="running"] .ft-pl-arcs, .ft[data-state="running"] .ft-pl-forks, .ft[data-state="running"] .ft-pl-tips { animation: ft-pl-meld 1.2s linear 1s both; }
  @keyframes ft-pl-meld { 0% { opacity: 0.85; filter: brightness(1); animation-timing-function: ease-out; } 50% { opacity: 1; filter: brightness(1.5); } 78% { opacity: 1; filter: brightness(1.5); } 86% { opacity: 1; filter: brightness(2.6); } 94% { opacity: 0.7; filter: brightness(1.4); } 100% { opacity: 0.85; filter: brightness(1); } }
  .ft[data-state="running"] .ft-pl-flash { animation: ft-pl-fill 1.2s linear 1s both; }
  /* the white flash overlay flares ONLY on release, then fades so the screen returns to its plasma */
  @keyframes ft-pl-fill { 0%, 78% { opacity: 0; transform: scale(0.9); } 88% { opacity: 1; transform: scale(1); } 100% { opacity: 0; transform: scale(1); } }

  /* ════ DONE — the screen settles back to its idle plasma after the flash; a faint warm rim lingers ════ */
  .ft[data-state="done"] .ft-forge-screen { box-shadow: 0 0 0 1px rgba(123,92,255,0.5), 0 0 20px rgba(123,92,255,0.32); }

  /* ════ reduced motion — NO motion anywhere; static, lit, OPEN reactor screen ════ */
  @media (prefers-reduced-motion: reduce) {
    .ft-forge-dial, .ft-scope,
    .ft-pl-core, .ft-pl-bloom, .ft-pl-arcs, .ft-pl-forks, .ft-pl-tips, .ft-pl-field,
    .ft[data-state="running"] .ft-forge-dial,
    .ft[data-state="running"] .ft-pl-core, .ft[data-state="running"] .ft-pl-bloom,
    .ft[data-state="running"] .ft-pl-arcs, .ft[data-state="running"] .ft-pl-forks, .ft[data-state="running"] .ft-pl-tips,
    .ft[data-state="running"] .ft-pl-field, .ft[data-state="running"] .ft-pl-flash {
      animation: none !important; transition: none !important; }
    .ft-forge-dial, .ft[data-state="running"] .ft-forge-dial, .ft-pl-field { transform: none !important; }
    .ft-pl-core, .ft-pl-bloom { opacity: 1 !important; transform: none !important; }
    .ft-pl-arcs, .ft-pl-tips, .ft-pl-forks { opacity: 1 !important; }
    .ft-pl-flash { opacity: 0 !important; }
    .ft-forge:hover .ft-forge-dome, .ft-forge:active .ft-forge-dome { transform: none; }
    .ft-forge-arm { animation: none !important; opacity: 0 !important; }
  }

  /* ── AUDIODEX terminal ── */
  .ft-screen { min-height: 470px; }

  /* The whole console is one device, "AudioDex" — etched straight into the dark
     casing in the EXACT wordmark style of the Tolo.Cloud gateway (.sd-brand): mono,
     debossed, no nameplate. Sits in the top-left header band, clear of the body. */
  .ft-devplate {
    position: absolute; top: 19px; left: 48px; z-index: 4;
    font-family: ui-monospace, "SF Mono", SFMono-Regular, Menlo, monospace;
    font-weight: 700; font-size: 16px; line-height: 1; letter-spacing: 0.06em;
    color: #20242c; text-shadow: 0 1px 0 rgba(255, 255, 255, 0.13), 0 -1px 1px rgba(0, 0, 0, 0.7);
  }

  /* the device's I/O on the body: an aux jack + a USB-C charging slot, lower-left,
     sized like real hardware with breathing room from the chassis edge */
  .ft-devports { position: absolute; left: 42px; bottom: 30px; z-index: 3; display: inline-flex; align-items: center; gap: 15px; }
  .ft-port-jack {
    width: 24px; height: 24px; border-radius: 50%;
    background: radial-gradient(circle at 50% 42%, #07090d 0 30%, #2b3038 35% 50%, #11141a 54%, #1b1f26 70%);
    box-shadow: inset 0 0 0 1.5px rgba(0, 0, 0, 0.8), inset 0 2px 3px rgba(255, 255, 255, 0.14), inset 0 -2px 4px rgba(0, 0, 0, 0.6), 0 1px 0 rgba(255, 255, 255, 0.05);
  }
  .ft-port-usb {
    position: relative; width: 38px; height: 14px; border-radius: 7px;
    background: linear-gradient(180deg, #05070a, #0e1218);
    box-shadow: inset 0 0 0 1.5px rgba(0, 0, 0, 0.8), inset 0 2px 4px rgba(0, 0, 0, 0.85), 0 1px 0 rgba(255, 255, 255, 0.05);
  }
  .ft-port-usb::after { content: ""; position: absolute; inset: 4px 6px; border-radius: 4px; background: linear-gradient(180deg, rgba(140, 150, 165, 0.5), rgba(90, 100, 115, 0.42)); }
  .ft-standby { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 16px;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 10.5px; letter-spacing: 0.22em; text-transform: uppercase; color: rgba(245, 241, 232, 0.26);
    background: repeating-linear-gradient(0deg, transparent 0 3px, rgba(120, 160, 210, 0.025) 3px 4px); }
  .ft-standby-mark { width: 30px; height: 30px; border-radius: 50%; border: 1px solid rgba(14, 196, 252, 0.3); position: relative; }
  .ft-standby-mark::after { content: ""; position: absolute; inset: 9px; border-radius: 50%; background: rgba(14, 196, 252, 0.2); }
  .ft[data-state="done"] .ft-standby { display: none; }
  .ft-screen-wake { position: absolute; inset: 0; z-index: 4; opacity: 0; pointer-events: none; background: radial-gradient(circle at 6% 50%, rgba(234, 255, 255, 0.8), rgba(25, 224, 255, 0.2) 40%, transparent 72%); }
  .ft[data-state="running"] .ft-screen-wake { animation: ft-wake 2.2s linear forwards; }
  @keyframes ft-wake { 0%, 91% { opacity: 0; } 96% { opacity: 0.9; } 100% { opacity: 0; } }

  .ft-card { display: none; }
  .ft[data-state="done"][data-file="46"] .ft-card[data-rec="46"],
  .ft[data-state="done"][data-file="47"] .ft-card[data-rec="47"],
  .ft[data-state="done"][data-file="48"] .ft-card[data-rec="48"] { display: block; animation: ft-populate 0.6s cubic-bezier(0.2, 1, 0.32, 1) both; }
  @keyframes ft-populate { 0% { opacity: 0; transform: scale(0.96); filter: brightness(2.2); } 55% { filter: brightness(1.2); } 100% { opacity: 1; transform: none; filter: none; } }

  .ft-card { position: relative; border: 1.5px solid transparent; border-radius: 11px; padding: 16px 18px 15px; text-align: left; margin: 11px;
    background:
      radial-gradient(130% 80% at 100% 0%, rgba(255, 110, 33, 0.07), transparent 55%) padding-box,
      linear-gradient(180deg, rgba(18, 16, 26, 0.97), rgba(11, 9, 16, 0.975)) padding-box,
      linear-gradient(135deg, #ff2761 0%, #ff5a3c 52%, #ff6e21 100%) border-box;
    box-shadow: 0 24px 60px -34px rgba(0, 0, 0, 0.82), 0 0 38px -16px rgba(255, 60, 70, 0.28); }
  .ft-card-head { display: flex; align-items: center; gap: 10px; margin-bottom: 12px; flex-wrap: wrap; }
  .ft-tier { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 9.5px; letter-spacing: 0.18em; text-transform: uppercase; border-radius: 3px; padding: 3px 8px; }
  .ft-tier-jam { color: var(--brand-cyan); border: 1px solid rgba(14, 196, 252, 0.4); background: rgba(14, 196, 252, 0.06); }
  .ft-tier-tracks { color: var(--brand-green); border: 1px solid rgba(0, 255, 77, 0.45); background: rgba(0, 255, 77, 0.07); }
  .ft-tier-field { color: var(--brand-green); border: 1px solid rgba(0, 255, 77, 0.4); background: rgba(0, 255, 77, 0.06); }
  .ft-tier-inbox { color: rgba(245, 241, 232, 0.7); border: 1px solid rgba(245, 241, 232, 0.28); background: rgba(245, 241, 232, 0.04); }
  .ft-title { flex: 1; min-width: 12ch; font-family: "Space Grotesk Variable", "Space Grotesk", ui-sans-serif, system-ui, sans-serif; font-weight: 700; font-size: 18px; line-height: 1.15; color: #f8f6ef; letter-spacing: -0.01em; }
  /* the naming hinge, explicit: the filename the record was forged from, struck
     through, pointing at the title it became. Lands one beat after the card pop. */
  .ft-from { flex: 0 0 auto; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 10.5px; letter-spacing: 0.04em; color: rgba(245, 241, 232, 0.42); }
  .ft-from s { text-decoration-color: rgba(255, 90, 60, 0.6); text-decoration-thickness: 1px; }
  .ft[data-state="done"] .ft-card .ft-from { animation: ft-from-in 0.5s ease 0.55s both; }
  @keyframes ft-from-in { from { opacity: 0; } to { opacity: 1; } }
  .ft-keeper { flex: 0 0 auto; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 9.5px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: #00ff4d; border: 1px solid rgba(0, 255, 77, 0.4); border-radius: 3px; padding: 2px 7px; background: rgba(0, 255, 77, 0.06); }
  .ft-wave-row { display: flex; align-items: center; gap: 12px; min-width: 0; }
  .ft-duration { flex: 0 0 auto; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-style: italic; font-size: 16px; font-weight: 700; color: #ff3b6e; font-feature-settings: "tnum"; line-height: 1; letter-spacing: 0.04em; min-width: 3.6em; text-align: right; text-shadow: 0 0 4px rgba(255, 59, 110, 0.65), 0 0 10px rgba(255, 59, 110, 0.35); }
  .ft-wave-card { flex: 1 1 auto; display: flex; align-items: center; gap: 1px; height: 46px; padding: 0 3px; background: #07060c; border-radius: 4px; overflow: hidden; }
  /* the keeper's waveform doubles as the play surface — button reset + a quiet
     glyph that strengthens on hover and flips to pause while the take speaks */
  .ft-wave-play { position: relative; border: none; cursor: pointer; }
  .ft-wave-play:focus-visible { outline: 2px solid var(--brand-cyan); outline-offset: 2px; }
  .ft-wave-play:hover .ft-bar { filter: brightness(1.25); }
  .ft-playglyph { position: absolute; left: 8px; top: 50%; transform: translateY(-50%); z-index: 1;
    width: 26px; height: 26px; border-radius: 50%; display: grid; place-items: center;
    background: rgba(7, 6, 12, 0.72); border: 1px solid rgba(14, 196, 252, 0.55); color: var(--brand-cyan);
    opacity: 0.75; transition: opacity 0.15s, transform 0.15s; }
  .ft-wave-play:hover .ft-playglyph { opacity: 1; transform: translateY(-50%) scale(1.06); }
  .ft-playglyph svg { width: 12px; height: 12px; fill: currentColor; }
  .ft-playglyph .g-pause { display: none; }
  .ft-card[data-playing="true"] .g-play { display: none; }
  .ft-card[data-playing="true"] .g-pause { display: block; }
