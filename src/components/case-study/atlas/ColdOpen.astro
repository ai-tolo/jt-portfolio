---
// The cold open. Before any title or prose: a dead slab of carbon, one lit POWER
// keycap, a serial plate, and one dim chip — the protagonist file at rest. Press
// POWER and the bench ignites (a rail sweeps cyan→violet→green), the chip lights,
// and the real degraded 2 a.m. hum plays once — you operate the machine and hear
// the sound before you read a word. Press again to power down (audio stops).
// Scrolling the bench out of view also stops it. Progressive enhancement: with
// no JS the page simply begins below. Audio is opt-in (the press). Honors
// reduced-motion.
interface Props { audio?: string; }
const { audio = "/case-studies/the-console/source/arc-01-original-rough.mp3" } = Astro.props;
---

<section class="co cs-bleed" aria-label="power on">
  <div class="co-swarm" aria-hidden="true"></div>
  <div class="co-slab">
    <span class="co-serial" aria-hidden="true">ONE SOUND · MK-SERIES</span>

    <span class="co-rail" aria-hidden="true"><span class="co-rail-fill"></span></span>

    <div class="co-chip" aria-hidden="true">
      <span class="co-chip-dot"></span>
      <span class="co-chip-name">Audio&nbsp;14.m4a</span>
      <span class="co-chip-meta">0:47 · 2:14&nbsp;a.m.</span>
    </div>

    <button type="button" class="co-power" aria-label="power on — hear the file" aria-pressed="false">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.5 v9" /><path d="M6.8 6 a7.5 7.5 0 1 0 10.4 0" /></svg>
    </button>
    <span class="co-label" aria-hidden="true">power</span>

    <span class="co-cue" aria-hidden="true">
      <svg viewBox="0 0 12 22" width="12" height="22"><path d="M6 1 v16 M2 13 l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </span>
  </div>
  <audio class="co-audio" preload="none" src={audio}></audio>
</section>

<style>
  .co { position: relative; min-height: 100vh; display: flex; align-items: center; justify-content: center;
    overflow: hidden; isolation: isolate; background:
      radial-gradient(60% 50% at 50% 46%, rgba(20, 22, 30, 0.7), transparent 70%),
      linear-gradient(180deg, #08070c 0%, #0b0a11 60%, #08070c 100%); }
  .co-swarm { position: absolute; inset: 0; z-index: -1; opacity: 0.5;
    background-image: url("/speckles.svg"); background-repeat: repeat; -webkit-mask-image: radial-gradient(55% 45% at 50% 46%, #000 30%, transparent 75%); mask-image: radial-gradient(55% 45% at 50% 46%, #000 30%, transparent 75%); }

  .co-slab { position: relative; display: flex; flex-direction: column; align-items: center; gap: 20px; padding: 40px; }
  .co-serial { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 10px; letter-spacing: 0.34em; text-transform: uppercase; color: rgba(245, 241, 232, 0.3); }

  .co-rail { position: relative; width: min(70vw, 520px); height: 2px; border-radius: 2px; background: rgba(245, 241, 232, 0.08); overflow: hidden; }
  .co-rail-fill { position: absolute; inset: 0; width: 0; border-radius: 2px;
    background: linear-gradient(90deg, #17c4fc 0%, #8b6bff 52%, #24e284 100%); box-shadow: 0 0 14px rgba(139, 107, 255, 0.6); }
  .co.lit .co-rail-fill { width: 100%; transition: width 1.1s cubic-bezier(0.4, 0, 0.1, 1); }

  .co-chip { display: flex; flex-direction: column; align-items: center; gap: 4px; padding: 14px 20px; border-radius: 12px;
    background: linear-gradient(160deg, #16151d, #0c0b11); border: 1px solid rgba(245, 241, 232, 0.1); opacity: 0.4;
    transition: opacity 0.6s ease, border-color 0.6s ease, box-shadow 0.6s ease; }
  .co.lit .co-chip { opacity: 1; border-color: rgba(23, 196, 252, 0.5); box-shadow: 0 0 30px -8px #17c4fc; }
  .co-chip-dot { width: 9px; height: 9px; border-radius: 50%; background: #3a2016; transition: background 0.6s, box-shadow 0.6s; }
  .co.lit .co-chip-dot { background: #17c4fc; box-shadow: 0 0 12px #17c4fc; }
  .co.playing .co-chip-dot { animation: co-speak 1.1s ease-in-out infinite; }
  @keyframes co-speak { 0%, 100% { box-shadow: 0 0 6px #17c4fc; } 50% { box-shadow: 0 0 18px #17c4fc; } }
  .co-chip-name { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 13px; color: #f5f1e8; }
  .co-chip-meta { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 10px; color: rgba(245, 241, 232, 0.5); }

  .co-power { margin-top: 8px; width: 66px; height: 66px; border-radius: 16px; cursor: pointer; display: grid; place-items: center;
    background: linear-gradient(180deg, #2a1416, #1a0e10); border: 1px solid rgba(255, 60, 70, 0.35);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06), 0 4px 0 #0a0708, 0 8px 18px -6px #000; transition: transform 0.1s, box-shadow 0.3s; }
  .co-power svg { width: 26px; height: 26px; fill: none; stroke: #ff3c46; stroke-width: 2; stroke-linecap: round; filter: drop-shadow(0 0 6px rgba(255, 60, 70, 0.7)); animation: co-breathe 3.4s ease-in-out infinite; }
  @keyframes co-breathe { 0%, 100% { opacity: 0.7; } 50% { opacity: 1; } }
  .co-power:hover { transform: translateY(1px); }
  .co.lit .co-power { border-color: rgba(0, 255, 77, 0.4); }
  .co.lit .co-power svg { stroke: #24e284; animation: none; opacity: 1; filter: drop-shadow(0 0 6px rgba(36, 226, 132, 0.7)); }
  .co-label { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 9px; letter-spacing: 0.28em; text-transform: uppercase; color: rgba(245, 241, 232, 0.4); }

  .co-cue { color: rgba(245, 241, 232, 0.4); opacity: 0; transition: opacity 0.5s ease 0.8s; margin-top: 10px; }
  .co.lit .co-cue { opacity: 1; animation: co-bob 1.8s ease-in-out infinite; }
  @keyframes co-bob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(4px); } }

  @media (prefers-reduced-motion: reduce) {
    .co-power svg, .co.lit .co-cue { animation: none; }
    .co.lit .co-rail-fill { transition: none; }
  }
</style>

<script>
  document.querySelectorAll(".co").forEach((root) => {
    const btn = root.querySelector(".co-power");
    const audio = root.querySelector(".co-audio");
    if (!btn) return;

    const powerDown = () => {
      root.classList.remove("lit", "playing");
      btn.setAttribute("aria-pressed", "false");
      if (audio) { audio.pause(); audio.currentTime = 0; }
    };

    btn.addEventListener("click", () => {
      if (root.classList.contains("lit")) { powerDown(); return; }
      root.classList.add("lit");
      btn.setAttribute("aria-pressed", "true");
      if (audio) {
        // the press is the consent — the machine wakes, then the file speaks
        setTimeout(() => {
          if (!root.classList.contains("lit")) return;
          document.dispatchEvent(new CustomEvent("bench:play", { detail: { source: root } }));
          const p = audio.play();
          if (p && p.catch) p.catch(() => {});
        }, 650);
      }
    });

    if (audio) {
      audio.volume = 0.9;
      audio.addEventListener("play", () => root.classList.add("playing"));
      audio.addEventListener("pause", () => root.classList.remove("playing"));
      audio.addEventListener("ended", () => root.classList.remove("playing"));
      // someone else claimed the stage — the bench hum yields
      document.addEventListener("bench:play", (e) => {
        if (e.detail && e.detail.source !== root && !audio.paused) audio.pause();
      });
      // leaving the bench stops the hum — no orphaned sound below the fold
      new IntersectionObserver(
        (entries) => entries.forEach((e) => { if (!e.isIntersecting && !audio.paused) audio.pause(); }),
        { threshold: 0.2 }
      ).observe(root);
    }
  });
</script>
