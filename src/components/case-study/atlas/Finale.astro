---
// RESOLUTION · the payoff as a real A/B. The same eighteen seconds, before and
// after: the degraded 2 a.m. take against the finished master, flipped at the
// same instant so you hear the whole distance in one toggle — and SEE it: both
// waveforms are the real geometry of the real files, drawn on a shared scale
// (waves.ts), so the master visibly fills the frame the rough take only sketched.
// One controlled player — play/pause, scrub (click or arrow keys), time. Then
// one closing line, and the same POWER keycap that opened the page closes it:
// press it and the bench goes dark, leaving the two ways out lit. No autoplay;
// claims the page's one audio stage (bench:play). Honors reduced-motion.
import { WAVE_ARC01, WAVE_ARC04 } from "./waves";
const BEFORE = "/case-studies/the-console/source/arc-01-original-rough.mp3";
const AFTER = "/case-studies/the-console/source/arc-04-master-final.mp3";
---
<section class="fin" aria-label="before and after">
  <div class="fin-stage">
    <div class="fin-ab">
      <div class="fin-toggle" role="tablist" aria-label="before or after">
        <button type="button" class="fin-tab on" data-side="before" role="tab" aria-selected="true">before · the 2 a.m. take</button>
        <button type="button" class="fin-tab" data-side="after" role="tab" aria-selected="false">after · the finished master</button>
      </div>

      <div class="fin-wavebox" data-fin-wave aria-hidden="true">
        <svg class="fin-wave fin-wave-before" viewBox="0 0 96 40" preserveAspectRatio="none"><path d={WAVE_ARC01} /></svg>
        <svg class="fin-wave fin-wave-after" viewBox="0 0 96 40" preserveAspectRatio="none"><path d={WAVE_ARC04} /></svg>
        <span class="fin-playhead"></span>
      </div>

      <div class="fin-player">
        <button type="button" class="fin-play" aria-label="play">
          <svg class="fin-i-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5 v14 l11 -7 z"/></svg>
          <svg class="fin-i-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5 h4 v14 h-4 z M13 5 h4 v14 h-4 z"/></svg>
        </button>
        <div class="fin-bar" role="slider" tabindex="0" aria-label="seek" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><span class="fin-fill"></span></div>
        <span class="fin-time"><span class="fin-cur">0:00</span> / <span class="fin-dur">0:00</span></span>
      </div>
    </div>

    <p class="fin-line">Found, made, and judged by one pair of hands — and it never touched a note.</p>

    <button type="button" class="fin-power" aria-label="power down" aria-pressed="false">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.5 v9" /><path d="M6.8 6 a7.5 7.5 0 1 0 10.4 0" /></svg>
    </button>
    <span class="fin-power-label" aria-hidden="true">power</span>

    <div class="fin-out-row">
      <a class="fin-out fin-out-back" href="/#work">← selected work</a>
      <a class="fin-out" href="/resume">résumé →</a>
    </div>

    <audio class="fin-before" preload="metadata" src={BEFORE}></audio>
    <audio class="fin-after" preload="metadata" src={AFTER}></audio>
  </div>
</section>

<style>
  .fin { --gold: #ffb347; position: relative; }
  .fin-stage { max-width: 560px; margin: 0 auto; padding: clamp(44px, 7vw, 84px) clamp(20px, 5vw, 40px) clamp(30px, 5vw, 56px);
    display: flex; flex-direction: column; align-items: center; gap: 24px; }

  .fin-ab { width: 100%; display: flex; flex-direction: column; gap: 14px;
    padding: 20px; border-radius: 14px; background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 179, 71, 0.18);
    transition: opacity 0.7s ease, filter 0.7s ease; }
  .fin-toggle { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; padding: 4px; border-radius: 10px; background: rgba(0, 0, 0, 0.3); }
  .fin-tab { cursor: pointer; padding: 10px 8px; border-radius: 7px; border: none; background: transparent;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 11px; letter-spacing: 0.02em; color: rgba(245, 241, 232, 0.55); transition: background 0.18s, color 0.18s; }
  .fin-tab.on { background: color-mix(in srgb, var(--gold) 18%, transparent); color: var(--gold); }

  /* the distance, visible: both real waveforms on one shared scale */
  .fin-wavebox { position: relative; height: 64px; border-radius: 8px; overflow: hidden;
    background: rgba(0, 0, 0, 0.35); box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.5); cursor: pointer; }
  .fin-wave { position: absolute; inset: 5px 4px; width: calc(100% - 8px); height: 54px;
    transition: opacity 0.35s ease; }
  .fin-wave-before { fill: rgba(245, 241, 232, 0.34); opacity: 1; }
  .fin-wave-after { fill: var(--gold); opacity: 0; }
  .fin.side-after .fin-wave-before { opacity: 0; }
  .fin.side-after .fin-wave-after { opacity: 0.92; }
  .fin-playhead { position: absolute; top: 3px; bottom: 3px; left: 0; width: 1.5px;
    background: #f5f1e8; box-shadow: 0 0 6px rgba(245, 241, 232, 0.8); opacity: 0; }
  .fin.playing .fin-playhead { opacity: 0.9; }

  .fin-player { display: flex; align-items: center; gap: 14px; }
  .fin-play { flex: 0 0 auto; width: 44px; height: 44px; border-radius: 50%; cursor: pointer; display: grid; place-items: center;
    background: radial-gradient(circle at 38% 32%, #ffe3ad, var(--gold)); color: #12100a; border: none; box-shadow: 0 0 24px -6px var(--gold); transition: transform 0.1s; }
  .fin-play:active { transform: scale(0.96); }
  .fin-play svg { width: 18px; height: 18px; fill: currentColor; }
  .fin-i-pause { display: none; }
  .fin.playing .fin-i-play { display: none; }
  .fin.playing .fin-i-pause { display: block; }
  .fin-bar { position: relative; flex: 1; height: 6px; border-radius: 3px; background: rgba(245, 241, 232, 0.14); cursor: pointer; }
  .fin-bar:focus-visible { outline: 2px solid var(--gold); outline-offset: 3px; }
  .fin-fill { position: absolute; left: 0; top: 0; bottom: 0; width: 0; border-radius: 3px; background: var(--gold); box-shadow: 0 0 8px color-mix(in srgb, var(--gold) 60%, transparent); }
  .fin-time { flex: 0 0 auto; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 11px; font-variant-numeric: tabular-nums; color: rgba(245, 241, 232, 0.55); }

  .fin-line { text-align: center; max-width: 40ch; margin: 4px 0 0; text-wrap: balance;
    font-family: "Space Grotesk Variable", "Space Grotesk", ui-sans-serif, system-ui, sans-serif; font-weight: 500; font-size: clamp(16px, 2.4vw, 22px); line-height: 1.45; color: #e9e6de;
    transition: opacity 0.7s ease; }

  /* the closing POWER keycap — the twin of the one that opened the page */
  .fin-power { margin-top: 4px; width: 58px; height: 58px; border-radius: 14px; cursor: pointer; display: grid; place-items: center;
    background: linear-gradient(180deg, #202a1a, #131a10); border: 1px solid rgba(0, 255, 77, 0.35);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06), 0 4px 0 #0a0708, 0 8px 18px -6px #000; transition: transform 0.1s, border-color 0.4s; }
  .fin-power svg { width: 23px; height: 23px; fill: none; stroke: #24e284; stroke-width: 2; stroke-linecap: round; filter: drop-shadow(0 0 6px rgba(36, 226, 132, 0.7)); transition: stroke 0.4s, filter 0.4s; }
  .fin-power:hover { transform: translateY(1px); }
  .fin-power-label { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 9px; letter-spacing: 0.28em; text-transform: uppercase; color: rgba(245, 241, 232, 0.4); margin-top: -14px; }
  .fin.off .fin-power { border-color: rgba(255, 60, 70, 0.3); }
  .fin.off .fin-power svg { stroke: #ff3c46; filter: drop-shadow(0 0 5px rgba(255, 60, 70, 0.5)); }

  /* powered down: the bench sleeps, the ways out stay lit */
  .fin.off .fin-ab, .fin.off .fin-line { opacity: 0.16; filter: saturate(0.2); pointer-events: none; }

  .fin-out-row { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; }
  .fin-out { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--gold);
    text-decoration: none; border: 1px solid rgba(255, 179, 71, 0.5); border-radius: 3px; padding: 9px 18px; transition: background 0.2s, color 0.2s, border-color 0.2s; }
  .fin-out:hover { background: rgba(255, 179, 71, 0.1); color: #fff; }
  .fin-out-back { color: rgba(245, 241, 232, 0.6); border-color: rgba(245, 241, 232, 0.25); }
  .fin-out-back:hover { color: #f5f1e8; border-color: rgba(245, 241, 232, 0.5); background: rgba(245, 241, 232, 0.05); }

  @media (prefers-reduced-motion: reduce) {
    .fin-ab, .fin-line, .fin-wave { transition: none; }
  }
</style>

<script>
  document.querySelectorAll(".fin").forEach((root) => {
    const before = root.querySelector(".fin-before");
    const after = root.querySelector(".fin-after");
    const play = root.querySelector(".fin-play");
    const bar = root.querySelector(".fin-bar");
    const fill = root.querySelector(".fin-fill");
    const cur = root.querySelector(".fin-cur");
    const dur = root.querySelector(".fin-dur");
    const wavebox = root.querySelector("[data-fin-wave]");
    const playhead = root.querySelector(".fin-playhead");
    const power = root.querySelector(".fin-power");
    const tabs = Array.from(root.querySelectorAll(".fin-tab"));
    if (!before || !after) return;
    let side = "before";
    let raf = 0;
    const fmt = (s) => { if (!isFinite(s)) return "0:00"; const m = Math.floor(s / 60), ss = Math.floor(s % 60); return m + ":" + String(ss).padStart(2, "0"); };
    function applyVol() { before.volume = side === "before" ? 1 : 0; after.volume = side === "after" ? 1 : 0; root.classList.toggle("side-after", side === "after"); }
    applyVol();

    const paintLoop = () => {
      const pct = before.duration ? (before.currentTime / before.duration) * 100 : 0;
      if (fill) fill.style.width = pct + "%";
      if (playhead) playhead.style.left = pct + "%";
      if (cur) cur.textContent = fmt(before.currentTime);
      if (bar) bar.setAttribute("aria-valuenow", String(Math.round(pct)));
      if (!before.paused) raf = requestAnimationFrame(paintLoop);
    };

    play.addEventListener("click", () => {
      if (before.paused) {
        document.dispatchEvent(new CustomEvent("bench:play", { detail: { source: root } }));
        after.currentTime = before.currentTime;
        const p1 = before.play(), p2 = after.play(); [p1, p2].forEach((p) => p && p.catch && p.catch(() => {}));
      } else { before.pause(); after.pause(); }
    });
    // someone else claimed the stage — this player yields
    document.addEventListener("bench:play", (e) => {
      if (e.detail && e.detail.source !== root && !before.paused) { before.pause(); after.pause(); }
    });

    before.addEventListener("play", () => { root.classList.add("playing"); raf = requestAnimationFrame(paintLoop); });
    before.addEventListener("pause", () => { root.classList.remove("playing"); cancelAnimationFrame(raf); });
    before.addEventListener("ended", () => { root.classList.remove("playing"); after.pause(); cancelAnimationFrame(raf); if (fill) fill.style.width = "0%"; });
    // set duration now if metadata beat us to the listener, else on the event
    const setDur = () => { if (dur) dur.textContent = fmt(before.duration); };
    if (before.readyState >= 1) setDur();
    before.addEventListener("loadedmetadata", setDur);
    tabs.forEach((t) => t.addEventListener("click", () => {
      side = t.dataset.side; applyVol();
      tabs.forEach((x) => { const on = x === t; x.classList.toggle("on", on); x.setAttribute("aria-selected", String(on)); });
    }));

    const seekTo = (frac) => { if (before.duration) { before.currentTime = frac * before.duration; after.currentTime = before.currentTime; paintLoop(); } };
    const seekEvt = (e) => { const el = e.currentTarget; const r = el.getBoundingClientRect(); seekTo(Math.min(1, Math.max(0, (e.clientX - r.left) / r.width))); };
    bar.addEventListener("click", seekEvt);
    if (wavebox) wavebox.addEventListener("click", seekEvt);
    bar.addEventListener("keydown", (e) => {
      if (e.key !== "ArrowLeft" && e.key !== "ArrowRight") return;
      e.preventDefault();
      const d = before.duration || 0;
      if (!d) return;
      const step = 2 * (e.key === "ArrowLeft" ? -1 : 1);
      seekTo(Math.min(1, Math.max(0, (before.currentTime + step) / d)));
    });

    // power down: the bench sleeps, the ways out stay lit; press again to wake
    if (power) power.addEventListener("click", () => {
      const off = root.classList.toggle("off");
      power.setAttribute("aria-pressed", String(off));
      if (off) { before.pause(); after.pause(); }
    });
  });
</script>
