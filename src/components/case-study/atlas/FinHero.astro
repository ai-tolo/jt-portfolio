---
// FINISHABLE · the open. Not a product shot — a question. The gear rack states
// what Jon already owns (world-class, and none of it helped); the title answers
// what was actually missing. Three short lines name the three ways songs die —
// they are the chapters. Static, fully visible with no JS; the only motion is
// the scroll cue (reduced-motion safe).
interface Props {
  meta?: { label: string; value: string }[];
}
const { meta = [] } = Astro.props;

const GEAR = ["Ableton Live", "FabFilter", "Bass Station II", "MODX", "TR-8S", "a wall of plugins"];
const DEATHS = [
  { word: "lost", rest: "twenty thousand fragments no tool could read" },
  { word: "stalled", rest: "ideas gone before a project was even set up" },
  { word: "doubted", rest: "mixes redone forever, because louder always wins" },
];
---

<section class="fh cs-bleed" aria-label="Finishable — why build any of this">
  <div class="fh-grid">
    <div class="fh-rack" aria-label="what I already owned">
      {GEAR.map((g, i) => (
        <span class="fh-gear"><i class="fh-lamp" aria-hidden="true"></i>{g}</span>
      ))}
    </div>

    <h1 class="fh-title">Finishable</h1>

    <p class="fh-question">
      I own all of it — and eight years of music still wasn't getting finished.
    </p>

    <ul class="fh-deaths">
      {DEATHS.map((d) => (
        <li><b>{d.word}</b><span>{d.rest}</span></li>
      ))}
    </ul>

    <p class="fh-answer">Songs were dying in three places, so I built three tools — one for each.</p>

    {meta.length > 0 && (
      <dl class="fh-meta">
        {meta.map((m) => (
          <div>
            <dt>{m.label}</dt>
            <dd>{m.value}</dd>
          </div>
        ))}
      </dl>
    )}

    <div class="fh-cue" aria-hidden="true">
      <span>scroll</span>
      <svg viewBox="0 0 12 22" width="12" height="22"><path d="M6 1 v16 M2 13 l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </div>
  </div>
</section>

<style>
  .fh {
    position: relative;
    min-height: 92vh;
    display: flex;
    align-items: center;
    padding: 96px 48px 56px;
    overflow: hidden;
    isolation: isolate;
    border-bottom: 1px solid var(--cs-line);
    background:
      radial-gradient(60% 50% at 24% 88%, rgba(255, 39, 97, 0.05) 0%, transparent 100%),
      radial-gradient(56% 48% at 80% 10%, rgba(14, 196, 252, 0.035) 0%, transparent 100%);
  }
  .fh-grid {
    position: relative;
    max-width: 1160px;
    margin: 0 auto;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }

  /* the rack: everything already owned, lamps dim — none of it helped */
  .fh-rack { display: flex; flex-wrap: wrap; gap: 8px 10px; margin-bottom: 4px; }
  .fh-gear {
    display: inline-flex; align-items: center; gap: 7px;
    padding: 6px 12px; border-radius: 5px;
    border: 1px solid var(--cs-line);
    background: color-mix(in srgb, var(--cs-text) 3.5%, transparent);
    font-family: var(--cs-mono);
    font-size: 11px; letter-spacing: 0.08em;
    color: var(--cs-text-muted);
  }
  .fh-lamp { width: 5px; height: 5px; border-radius: 50%; background: color-mix(in srgb, var(--cs-text) 25%, transparent); }

  .fh-title {
    font-family: "Space Grotesk Variable", "Space Grotesk", ui-sans-serif, system-ui, sans-serif;
    font-weight: 700;
    font-size: clamp(64px, 12.5vw, 168px);
    letter-spacing: -0.045em;
    line-height: 0.92;
    margin: 0;
    background: var(--cs-grad-text);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
    padding-bottom: 6px;
  }

  .fh-question {
    font-family: var(--cs-mono);
    font-style: italic;
    font-size: clamp(16px, 2vw, 23px);
    line-height: 1.45;
    color: var(--cs-prose);
    max-width: 44ch;
    margin: 0;
    border-left: 2px solid var(--brand-orange);
    padding-left: 18px;
  }

  .fh-deaths {
    list-style: none; padding: 0; margin: 10px 0 0;
    display: flex; flex-direction: column; gap: 9px;
  }
  .fh-deaths li {
    display: flex; align-items: baseline; gap: 14px;
    font-family: var(--cs-mono);
    font-size: clamp(13px, 1.5vw, 15px);
    line-height: 1.5;
    color: var(--cs-text-muted);
  }
  .fh-deaths b {
    flex: 0 0 auto; width: 7.5ch;
    font-weight: 700; letter-spacing: 0.06em;
    color: var(--cs-text);
  }

  .fh-answer {
    margin: 12px 0 0;
    font-family: "Space Grotesk Variable", "Space Grotesk", ui-sans-serif, system-ui, sans-serif;
    font-size: clamp(16px, 1.9vw, 21px);
    font-weight: 500;
    color: var(--cs-prose);
    max-width: 46ch;
  }

  .fh-meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 18px 22px;
    border-top: 1px solid var(--cs-line-strong);
    padding-top: 22px;
    margin: 22px 0 0;
    width: 100%;
    max-width: 900px;
  }
  .fh-meta div { display: flex; flex-direction: column; gap: 5px; }
  /* phones: auto-fit still lands 2-up at 375 and starves the STACK value */
  @media (max-width: 599px) {
    .fh-meta { grid-template-columns: 1fr; }
  }
  .fh-meta dt {
    font-family: var(--cs-mono);
    font-size: 10px; letter-spacing: 0.22em; text-transform: uppercase;
    color: var(--cs-text-muted);
  }
  .fh-meta dd {
    margin: 0;
    font-family: var(--cs-mono);
    font-style: italic; font-size: 13px;
    color: var(--cs-prose);
  }

  .fh-cue {
    display: inline-flex; align-items: center; gap: 8px; margin-top: 26px;
    font-family: var(--cs-mono);
    font-size: 10px; letter-spacing: 0.24em; text-transform: uppercase;
    color: var(--cs-text-dim);
  }
  .fh-cue svg { animation: fh-bob 1.8s ease-in-out infinite; }
  @keyframes fh-bob {
    0%, 100% { transform: translateY(0); opacity: 0.55; }
    50% { transform: translateY(4px); opacity: 1; }
  }

  /* Night: the pre-toggle dark hero, verbatim — tint pair + title glow. */
  :global(html[data-night]) .fh {
    background:
      radial-gradient(60% 50% at 24% 88%, rgba(255, 39, 97, 0.10) 0%, transparent 100%),
      radial-gradient(56% 48% at 80% 10%, rgba(14, 196, 252, 0.07) 0%, transparent 100%);
  }
  :global(html[data-night]) .fh-title {
    filter: drop-shadow(0 8px 40px rgba(255, 89, 60, 0.28));
  }

  @media (max-width: 720px) {
    .fh { padding: 80px 24px 44px; min-height: 88vh; }
    .fh-gear { font-size: 10px; padding: 5px 9px; }
    .fh-deaths b { width: 7ch; }
  }
  @media (prefers-reduced-motion: reduce) {
    .fh-cue svg { animation: none; }
  }
</style>
