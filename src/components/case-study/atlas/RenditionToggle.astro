---
// ★ THE CENTERPIECE — the rendition toggle.
//
// A faithful, self-contained recreation of the Engineer's Arena card (NOT an
// import of portal internals). Shared waveform + transport + three numbered
// 3D keycaps. Press 1·2·3 (or click a key) and the SAME eight seconds plays
// in each rendition — the playhead never losing its place. That carry is the
// whole feeling the brief asks for.
//
// The audio is real and synthesized in the browser: one dry musical loop is
// rendered once (OfflineAudioContext), then fanned into three loudness-matched
// processing chains (forward+bright · warm+recessed · punchy+open). Switching
// crossfades which chain is audible while all three read the same source at the
// same instant — so the moment is identical, only the mix changes.
//
// Blind by default (Take 1·2·3); a reveal shows each take's identity + the
// reference it was mastered toward. Hold a take to crown it. Keyboard: 1·2·3
// switch, space play/pause, R reveal. Honors prefers-reduced-motion.

interface Take {
  pole: string;
  ref: string;
  why: string;
  lufs: string;
  tp: string;
}
// Display identities (revealed on demand). Order here = take 1/2/3.
const TAKES: Take[] = [
  { pole: "forward · bright", ref: "→ Tame Impala, “Let It Happen”", why: "vocal pulled up over the bus · presence lift at 5 kHz · tight, dry", lufs: "-9.4 LUFS", tp: "-1.0 dBTP" },
  { pole: "warm · recessed",  ref: "→ Frank Ocean, “Pyramids”",      why: "low-shelf weight under the mix · softer top · a longer plate tail", lufs: "-9.6 LUFS", tp: "-1.0 dBTP" },
  { pole: "punchy · open",    ref: "→ blood orange, “Nikes”",        why: "mid-forward · a touch of tape saturation · short room, big transients", lufs: "-9.5 LUFS", tp: "-1.0 dBTP" },
];

// Pseudo-waveform bars (musical-looking envelope: kick pulses under a pad).
const BARS = Array.from({ length: 128 }, (_, i) => {
  const beat = (i % 16) / 16;
  const kick = beat < 0.06 || (beat > 0.5 && beat < 0.56) ? 1 : 0;
  const swell = 0.42 + 0.3 * Math.sin(i * 0.18) + 0.16 * Math.cos(i * 0.5);
  const arp = 0.16 * Math.abs(Math.sin(i * 1.31));
  const h = Math.max(0.16, Math.min(1, swell + arp + kick * 0.45));
  return Math.round(h * 100);
});
---

<div class="rt" data-rt data-active="0" data-playing="false" data-revealed="false">
  <header class="rt-head">
    <div class="rt-head-left">
      <span class="rt-source">Audio 14.wav</span>
      <span class="rt-tag">3 renditions · blind</span>
    </div>
    <span class="rt-loud" title="Every take is played back at a matched level, so you're voting on the mix — not on whichever one is louder.">⚖ loudness-matched</span>
  </header>

  <!-- transport -->
  <div class="rt-transport">
    <button type="button" class="rt-play" data-rt-play aria-label="Play / pause">▶</button>
    <span class="rt-time" data-rt-time>0:00 / 0:00</span>
    <span class="rt-now" data-rt-now>Take 1</span>
  </div>

  <!-- shared waveform + playhead -->
  <div class="rt-wave" data-rt-wave role="img" aria-label="Waveform — click to seek">
    {BARS.map((h) => <span class="rt-bar" style={`height:${h}%`}></span>)}
    <div class="rt-playhead" data-rt-playhead></div>
    <div class="rt-buffering" data-rt-buffering></div>
  </div>

  <!-- 1·2·3 keycaps -->
  <div class="rt-switch" role="group" aria-label="Three takes — tap a number or press 1·2·3 to switch which mix plays. The playhead carries.">
    {TAKES.map((_, i) => (
      <button
        type="button"
        class="rt-key"
        data-rt-key={String(i)}
        data-active={i === 0 ? "true" : "false"}
        aria-label={`Take ${i + 1} — tap to audition, hold to crown`}
      >
        <span class="rt-hold-fill" aria-hidden="true"></span>
        <span class="rt-key-num">{i + 1}</span>
        <span class="rt-key-id" data-rt-key-id={String(i)}>Take {i + 1}</span>
      </button>
    ))}
  </div>

  <!-- reveal + crown row -->
  <div class="rt-foot">
    <button type="button" class="rt-reveal" data-rt-reveal>🔍 reveal what I'm hearing</button>
    <span class="rt-status" data-rt-status aria-live="polite"></span>
  </div>

  <p class="rt-hint">
    <kbd>1</kbd><kbd>2</kbd><kbd>3</kbd> switch · <kbd>space</kbd> play · <kbd>R</kbd> reveal · hold a key to <span class="rt-hint-crown">♛ crown</span>
  </p>
</div>

<script>
  // ── Each card is self-contained. ─────────────────────────────────────────
  const TAKE_META = [
    { pole: "forward · bright", ref: "→ Tame Impala", lufs: "-9.4" },
    { pole: "warm · recessed", ref: "→ Frank Ocean", lufs: "-9.6" },
    { pole: "punchy · open", ref: "→ blood orange", lufs: "-9.5" },
  ];

  document.querySelectorAll<HTMLElement>("[data-rt]").forEach((root) => {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const playBtn = root.querySelector<HTMLButtonElement>("[data-rt-play]");
    const timeEl = root.querySelector<HTMLElement>("[data-rt-time]");
    const nowEl = root.querySelector<HTMLElement>("[data-rt-now]");
    const wave = root.querySelector<HTMLElement>("[data-rt-wave]");
    const playhead = root.querySelector<HTMLElement>("[data-rt-playhead]");
    const buffering = root.querySelector<HTMLElement>("[data-rt-buffering]");
    const keys = [...root.querySelectorAll<HTMLButtonElement>("[data-rt-key]")];
    const keyIds = [...root.querySelectorAll<HTMLElement>("[data-rt-key-id]")];
    const revealBtn = root.querySelector<HTMLButtonElement>("[data-rt-reveal]");
    const statusEl = root.querySelector<HTMLElement>("[data-rt-status]");

    const N = 3;
    let ctx: AudioContext | null = null;
    let buffer: AudioBuffer | null = null;
    let source: AudioBufferSourceNode | null = null;
    let chainGains: GainNode[] = [];
    let loopDur = 0;
    let active = 0;
    let playing = false;
    let startCtxTime = 0;     // ctx.currentTime at which the loop's t=0 played
    let raf = 0;
    let building = false;

    const fmt = (s: number) => {
      const m = Math.floor(s / 60);
      const r = Math.floor(s % 60);
      return `${m}:${String(r).padStart(2, "0")}`;
    };
    const flash = (msg: string) => {
      if (!statusEl) return;
      statusEl.textContent = msg;
      window.setTimeout(() => { if (statusEl.textContent === msg) statusEl.textContent = ""; }, 2200);
    };

    // ── Synthesize the dry loop once (offline), then build the live graph. ──
    async function ensureGraph() {
      if (ctx) return;
      const AC = window.AudioContext || (window as any).webkitAudioContext;
      ctx = new AC();
      buffer = await renderDryLoop(ctx.sampleRate);
      loopDur = buffer.duration;
      buildLiveGraph();
    }

    function buildLiveGraph() {
      if (!ctx || !buffer) return;
      const master = ctx.createGain();
      master.gain.value = 0.92;
      master.connect(ctx.destination);

      source = ctx.createBufferSource();
      source.buffer = buffer;
      source.loop = true;

      const irLong = makeImpulse(ctx, 2.2, 3.2);
      const irShort = makeImpulse(ctx, 0.5, 2.6);

      // Three loudness-trimmed rendition chains, all reading `source`.
      chainGains = [];
      const chains = [
        () => brightChain(ctx!, source!, irShort),   // forward · bright
        () => warmChain(ctx!, source!, irLong),      // warm · recessed
        () => punchyChain(ctx!, source!, irShort),   // punchy · open
      ];
      chains.forEach((make, i) => {
        const out = make();
        const g = ctx!.createGain();
        g.gain.value = i === active ? 1 : 0;
        out.connect(g);
        g.connect(master);
        chainGains.push(g);
      });
      source.start();
      startCtxTime = ctx.currentTime;
    }

    function setActive(i: number, announce = true) {
      active = i;
      root.dataset.active = String(i);
      keys.forEach((k, idx) => k.dataset.active = idx === i ? "true" : "false");
      if (nowEl) nowEl.textContent = `Take ${i + 1}`;
      // Crossfade chain gains — same source, same instant; only the mix changes.
      if (ctx && chainGains.length) {
        const now = ctx.currentTime;
        chainGains.forEach((g, idx) => {
          g.gain.cancelScheduledValues(now);
          g.gain.setTargetAtTime(idx === i ? 1 : 0, now, 0.035);
        });
      }
      if (announce) flash(`take ${i + 1}${root.dataset.revealed === "true" ? " · " + TAKE_META[i].pole : ""}`);
    }

    async function play() {
      building = true;
      buffering?.setAttribute("data-on", "true");
      playBtn?.setAttribute("data-state", "loading");
      await ensureGraph();
      await ctx!.resume();
      buffering?.setAttribute("data-on", "false");
      playBtn?.removeAttribute("data-state");
      building = false;
      playing = true;
      root.dataset.playing = "true";
      if (playBtn) playBtn.textContent = "❚❚";
      loop();
    }
    async function pause() {
      playing = false;
      root.dataset.playing = "false";
      if (playBtn) playBtn.textContent = "▶";
      if (raf) cancelAnimationFrame(raf);
      await ctx?.suspend();
    }
    const toggle = () => { if (building) return; playing ? pause() : play(); };

    function loop() {
      if (!playing || !ctx) return;
      const elapsed = (ctx.currentTime - startCtxTime) % loopDur;
      const frac = elapsed / loopDur;
      if (playhead) playhead.style.left = `${frac * 100}%`;
      if (timeEl) timeEl.textContent = `${fmt(elapsed)} / ${fmt(loopDur)}`;
      raf = requestAnimationFrame(loop);
    }

    // controls
    playBtn?.addEventListener("click", toggle);
    keys.forEach((k, i) => {
      // tap = switch (start playback if idle); hold = crown
      let holdTimer = 0;
      let held = false;
      const startHold = (e: Event) => {
        e.preventDefault();
        held = false;
        k.dataset.holding = "true";
        holdTimer = window.setTimeout(() => {
          held = true;
          k.dataset.holding = "false";
          crown(i);
        }, reduce ? 1 : 650);
      };
      const endHold = () => {
        k.dataset.holding = "false";
        if (holdTimer) clearTimeout(holdTimer);
        if (!held) { if (!playing) play(); setActive(i); }
      };
      k.addEventListener("pointerdown", startHold);
      k.addEventListener("pointerup", endHold);
      k.addEventListener("pointerleave", () => { k.dataset.holding = "false"; if (holdTimer) clearTimeout(holdTimer); });
    });

    function crown(i: number) {
      setActive(i, false);
      keys.forEach((k, idx) => k.dataset.crowned = idx === i ? "true" : "false");
      const id = root.dataset.revealed === "true" ? ` — ${TAKE_META[i].pole} ${TAKE_META[i].ref}` : "";
      flash(`♛ crowned Take ${i + 1}${id} · sent to your taste model`);
    }

    function setRevealed(on: boolean) {
      root.dataset.revealed = on ? "true" : "false";
      keyIds.forEach((el, i) => {
        el.textContent = on ? TAKE_META[i].pole : `Take ${i + 1}`;
      });
      if (revealBtn) revealBtn.textContent = on ? "🙈 hide identities" : "🔍 reveal what I'm hearing";
    }
    revealBtn?.addEventListener("click", () => setRevealed(root.dataset.revealed !== "true"));

    // click-to-seek on the waveform
    wave?.addEventListener("click", (e) => {
      if (!ctx || !loopDur) { if (!playing) play(); return; }
      const rect = wave.getBoundingClientRect();
      const frac = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
      // re-anchor startCtxTime so the loop reads from the new position
      startCtxTime = ctx.currentTime - frac * loopDur;
    });

    // keyboard (when the card has focus)
    root.tabIndex = 0;
    root.addEventListener("keydown", (e) => {
      const k = e.key.toLowerCase();
      if (k === " " || k === "spacebar") { e.preventDefault(); toggle(); }
      else if (k === "1" || k === "2" || k === "3") { e.preventDefault(); if (!playing) play(); setActive(Number(k) - 1); }
      else if (k === "r") { e.preventDefault(); setRevealed(root.dataset.revealed !== "true"); }
    });

    // ── DSP helpers ──────────────────────────────────────────────────────
    async function renderDryLoop(sr: number): Promise<AudioBuffer> {
      const bpm = 100, beat = 60 / bpm, bars = 2, dur = bars * 4 * beat; // 4.8s
      const OAC = window.OfflineAudioContext || (window as any).webkitOfflineAudioContext;
      const off: OfflineAudioContext = new OAC(2, Math.ceil(dur * sr), sr);
      const master = off.createGain(); master.gain.value = 0.85;
      const glue = off.createBiquadFilter(); glue.type = "lowpass"; glue.frequency.value = 6500; glue.Q.value = 0.4;
      glue.connect(master); master.connect(off.destination);

      // noise buffer for shaker
      const nb = off.createBuffer(1, sr * 0.3, sr);
      const nd = nb.getChannelData(0);
      for (let i = 0; i < nd.length; i++) nd[i] = Math.random() * 2 - 1;

      const chords = [
        [261.63, 329.63, 392.0, 493.88, 587.33], // Cmaj9
        [220.0, 261.63, 329.63, 392.0, 493.88],  // Am9
      ];
      for (let bar = 0; bar < bars; bar++) {
        const t0 = bar * 4 * beat;
        const notes = chords[bar % chords.length];
        // ── PAD ──
        const padGain = off.createGain();
        padGain.gain.setValueAtTime(0, t0);
        padGain.gain.linearRampToValueAtTime(0.15, t0 + 0.5);
        padGain.gain.setValueAtTime(0.15, t0 + 4 * beat - 0.35);
        padGain.gain.linearRampToValueAtTime(0, t0 + 4 * beat);
        const padLp = off.createBiquadFilter(); padLp.type = "lowpass"; padLp.frequency.value = 2000; padLp.Q.value = 0.5;
        padLp.connect(padGain); padGain.connect(glue);
        notes.forEach((f, idx) => {
          [-1, 1].forEach((det) => {
            const o = off.createOscillator();
            o.type = idx === 0 ? "triangle" : "sawtooth";
            o.frequency.value = f;
            o.detune.value = det * 5 + idx * 1.2;
            const g = off.createGain(); g.gain.value = idx === 0 ? 0.4 : 0.13;
            o.connect(g); g.connect(padLp);
            o.start(t0); o.stop(t0 + 4 * beat);
          });
        });
        // ── ARP (8 eighths) ──
        for (let e = 0; e < 8; e++) {
          const te = t0 + e * (beat / 2);
          const f = notes[[0, 2, 4, 3, 2, 4, 1, 2][e] % notes.length] * 2;
          const o = off.createOscillator(); o.type = "triangle"; o.frequency.value = f;
          const g = off.createGain();
          g.gain.setValueAtTime(0, te);
          g.gain.linearRampToValueAtTime(0.12, te + 0.01);
          g.gain.exponentialRampToValueAtTime(0.0008, te + 0.28);
          const ad = off.createBiquadFilter(); ad.type = "highpass"; ad.frequency.value = 400;
          o.connect(g); g.connect(ad); ad.connect(glue);
          o.start(te); o.stop(te + 0.3);
        }
        // ── KICK on beats 1 & 3 ──
        [0, 2].forEach((b) => {
          const tk = t0 + b * beat;
          const o = off.createOscillator(); o.type = "sine";
          o.frequency.setValueAtTime(120, tk);
          o.frequency.exponentialRampToValueAtTime(45, tk + 0.12);
          const g = off.createGain();
          g.gain.setValueAtTime(0.0001, tk);
          g.gain.linearRampToValueAtTime(0.9, tk + 0.005);
          g.gain.exponentialRampToValueAtTime(0.0008, tk + 0.34);
          o.connect(g); g.connect(master);
          o.start(tk); o.stop(tk + 0.4);
        });
        // ── SHAKER on offbeats ──
        for (let b = 0; b < 4; b++) {
          const ts = t0 + (b + 0.5) * beat;
          const s = off.createBufferSource(); s.buffer = nb;
          const hp = off.createBiquadFilter(); hp.type = "highpass"; hp.frequency.value = 7000;
          const g = off.createGain();
          g.gain.setValueAtTime(0.0001, ts);
          g.gain.linearRampToValueAtTime(0.08, ts + 0.005);
          g.gain.exponentialRampToValueAtTime(0.0006, ts + 0.09);
          s.connect(hp); hp.connect(g); g.connect(master);
          s.start(ts); s.stop(ts + 0.12);
        }
      }
      return off.startRendering();
    }

    function makeImpulse(c: AudioContext, dur: number, decay: number): AudioBuffer {
      const sr = c.sampleRate, len = Math.ceil(sr * dur);
      const buf = c.createBuffer(2, len, sr);
      for (let ch = 0; ch < 2; ch++) {
        const d = buf.getChannelData(ch);
        for (let i = 0; i < len; i++) d[i] = (Math.random() * 2 - 1) * Math.pow(1 - i / len, decay);
      }
      return buf;
    }
    const peaking = (c: AudioContext, f: number, q: number, gain: number) => {
      const b = c.createBiquadFilter(); b.type = "peaking"; b.frequency.value = f; b.Q.value = q; b.gain.value = gain; return b;
    };
    const shelf = (c: AudioContext, type: "lowshelf" | "highshelf", f: number, gain: number) => {
      const b = c.createBiquadFilter(); b.type = type; b.frequency.value = f; b.gain.value = gain; return b;
    };
    function wet(c: AudioContext, input: AudioNode, ir: AudioBuffer, dryAmt: number, wetAmt: number): GainNode {
      const out = c.createGain();
      const dry = c.createGain(); dry.gain.value = dryAmt;
      const conv = c.createConvolver(); conv.buffer = ir;
      const wg = c.createGain(); wg.gain.value = wetAmt;
      input.connect(dry); dry.connect(out);
      input.connect(conv); conv.connect(wg); wg.connect(out);
      return out;
    }
    function makeShaper(c: AudioContext, amount: number): WaveShaperNode {
      const ws = c.createWaveShaper();
      const n = 1024, curve = new Float32Array(n);
      for (let i = 0; i < n; i++) { const x = (i / (n - 1)) * 2 - 1; curve[i] = Math.tanh(x * amount); }
      ws.curve = curve; ws.oversample = "2x";
      return ws;
    }

    // forward · bright — presence lift, tight lows, dry, trimmed down a touch
    function brightChain(c: AudioContext, src: AudioNode, ir: AudioBuffer): AudioNode {
      const hp = c.createBiquadFilter(); hp.type = "highpass"; hp.frequency.value = 95;
      const pres = peaking(c, 4800, 0.9, 4.5);
      const hs = shelf(c, "highshelf", 9000, 3);
      const trim = c.createGain(); trim.gain.value = 0.82;
      src.connect(hp); hp.connect(pres); pres.connect(hs); hs.connect(trim);
      return wet(c, trim, ir, 0.96, 0.06);
    }
    // warm · recessed — low weight, soft top, longer tail
    function warmChain(c: AudioContext, src: AudioNode, ir: AudioBuffer): AudioNode {
      const ls = shelf(c, "lowshelf", 170, 3.5);
      const dip = peaking(c, 5200, 1.1, -4);
      const lp = c.createBiquadFilter(); lp.type = "lowpass"; lp.frequency.value = 9500; lp.Q.value = 0.6;
      const trim = c.createGain(); trim.gain.value = 1.04;
      src.connect(ls); ls.connect(dip); dip.connect(lp); lp.connect(trim);
      return wet(c, trim, ir, 0.74, 0.5);
    }
    // punchy · open — mid-forward, tape saturation, short room
    function punchyChain(c: AudioContext, src: AudioNode, ir: AudioBuffer): AudioNode {
      const mid = peaking(c, 1250, 0.8, 3);
      const ls = shelf(c, "lowshelf", 110, 1.5);
      const sat = makeShaper(c, 1.8);
      const trim = c.createGain(); trim.gain.value = 0.78;
      src.connect(mid); mid.connect(ls); ls.connect(sat); sat.connect(trim);
      return wet(c, trim, ir, 0.86, 0.16);
    }

    // expose minimal state for verification
    (root as any).__rt = {
      get active() { return active; },
      get playing() { return playing; },
      get gains() { return chainGains.map((g) => Math.round(g.gain.value * 100) / 100); },
      get ctxState() { return ctx?.state ?? "none"; },
    };
  });
</script>

<style>
  .rt {
    background: linear-gradient(180deg, rgba(17, 12, 22, 0.96), rgba(11, 8, 15, 0.96));
    border: 1px solid rgba(245, 241, 232, 0.12);
    border-radius: 10px;
    padding: 22px 24px 18px;
    color: #f5f1e8;
    font-family: "Geist Variable", ui-sans-serif, system-ui, sans-serif;
    outline: none;
    transition: border-color 200ms ease, box-shadow 200ms ease;
  }
  .rt:focus-within {
    border-color: rgba(255, 150, 80, 0.4);
    box-shadow: 0 0 0 1px rgba(255, 150, 80, 0.28);
  }

  /* head */
  .rt-head { display: flex; align-items: center; justify-content: space-between; gap: 14px; margin-bottom: 16px; flex-wrap: wrap; }
  .rt-head-left { display: flex; align-items: center; gap: 12px; min-width: 0; }
  .rt-source {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-style: italic; font-weight: 700; font-size: 16px;
    color: #00ff4d; background: rgba(0, 255, 77, 0.05);
    border: 1px solid rgba(0, 255, 77, 0.32); border-radius: 4px;
    padding: 5px 11px; box-shadow: 0 0 12px rgba(0, 255, 77, 0.12);
  }
  .rt-tag, .rt-loud {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 10px; letter-spacing: 0.16em; text-transform: uppercase;
    color: rgba(245, 241, 232, 0.5);
  }
  .rt-loud {
    color: var(--brand-yellow);
    border: 1px solid rgba(255, 179, 71, 0.4);
    border-radius: 20px; padding: 4px 11px; cursor: help;
  }

  /* transport */
  .rt-transport { display: flex; align-items: center; gap: 14px; margin-bottom: 12px; }
  .rt-play {
    width: 38px; height: 38px; border-radius: 50%; flex: 0 0 auto;
    border: 1px solid rgba(245, 241, 232, 0.3); background: rgba(245, 241, 232, 0.04);
    color: #f5f1e8; font-size: 13px; cursor: pointer; position: relative;
    display: flex; align-items: center; justify-content: center;
    transition: background 160ms ease, border-color 160ms ease;
  }
  .rt[data-playing="true"] .rt-play { background: rgba(0, 255, 77, 0.08); border-color: rgba(0, 255, 77, 0.5); color: #00ff4d; }
  .rt-play[data-state="loading"] { color: transparent; }
  .rt-play[data-state="loading"]::after {
    content: ""; position: absolute; width: 15px; height: 15px;
    border: 2px solid rgba(245, 241, 232, 0.6); border-top-color: transparent;
    border-radius: 50%; animation: rt-spin 0.7s linear infinite;
  }
  @keyframes rt-spin { to { transform: rotate(360deg); } }
  .rt-time { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12px; color: rgba(245, 241, 232, 0.62); font-feature-settings: "tnum"; }
  .rt-now {
    margin-left: auto; font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11px; letter-spacing: 0.08em; color: rgba(245, 241, 232, 0.7);
    background: rgba(245, 241, 232, 0.04); border: 1px solid rgba(245, 241, 232, 0.14);
    border-radius: 4px; padding: 4px 10px;
  }

  /* waveform */
  .rt-wave {
    position: relative; height: 72px; background: #07060c;
    border-radius: 4px; overflow: hidden; margin-bottom: 16px;
