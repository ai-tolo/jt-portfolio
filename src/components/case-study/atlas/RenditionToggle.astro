---
// ★ THE CENTERPIECE — the rendition toggle.
//
// Three takes, REAL audio — three masters Richard actually rendered for my
// track "head to toe," the crowned champions across his three taste axes:
// bright & forward, warm & intimate, and open & unhyped. The SAME 16 bars play
// in each; pressing 1·2·3 crossfades which master is audible while the playhead
// never loses its place, so the moment is identical and only the finishing
// changes.
//
// Each is a beat-aligned loop, loudness-matched to −14 LUFS (so you judge the
// mix, not the volume — the bright one was naturally 3 LU louder), served from
// /public/case-studies/the-console/renditions/. Blind by default; reveal shows
// each take's identity + the record it was matched toward; hold a key to crown.
// Keyboard: 1·2·3 + R work whenever the demo is on screen; space play/pause
// when it's hovered/focused (so it never hijacks page scroll). Reduced-motion safe.
interface Take { id: string; ref: string; file: string; }
const TAKES: Take[] = [
  { id: "bright · forward", ref: "toward Caroline Polachek’s never-harsh top end",   file: "/case-studies/the-console/renditions/take1.mp3" },
  { id: "warm · intimate",  ref: "toward Frank Ocean’s recessed, in-the-room vocal", file: "/case-studies/the-console/renditions/take2.mp3" },
  { id: "open · unhyped",   ref: "toward Tame Impala’s big, open low end",           file: "/case-studies/the-console/renditions/take3.mp3" },
];

// Placeholder waveform bars for SSR; the script overwrites these heights with
// the real peak envelope once the audio decodes.
const BARS = Array.from({ length: 128 }, (_, i) => {
  const beat = (i % 16) / 16;
  const kick = beat < 0.06 || (beat > 0.5 && beat < 0.56) ? 1 : 0;
  const swell = 0.42 + 0.3 * Math.sin(i * 0.18) + 0.16 * Math.cos(i * 0.5);
  const arp = 0.16 * Math.abs(Math.sin(i * 1.31));
  const h = Math.max(0.16, Math.min(1, swell + arp + kick * 0.45));
  return Math.round(h * 100);
});
---

<div class="rt" data-rt data-active="0" data-playing="false" data-revealed="false">
  <header class="rt-head">
    <div class="rt-head-left">
      <span class="rt-source">head to toe</span>
      <span class="rt-tag">real masters · blind</span>
    </div>
    <span class="rt-loud" title="All three are normalized to the same loudness, so you're voting on the mix — not on whichever one is louder.">⚖ loudness-matched</span>
  </header>

  <!-- transport -->
  <div class="rt-transport">
    <button type="button" class="rt-play" data-rt-play aria-label="Play / pause">▶</button>
    <span class="rt-time" data-rt-time>0:00 / 0:00</span>
    <span class="rt-now" data-rt-now>Take 1</span>
  </div>

  <!-- shared waveform + playhead -->
  <div class="rt-wave" data-rt-wave role="img" aria-label="Waveform — click to seek">
    {BARS.map((h) => <span class="rt-bar" style={`height:${h}%`}></span>)}
    <div class="rt-playhead" data-rt-playhead></div>
    <div class="rt-buffering" data-rt-buffering></div>
  </div>

  <!-- 1·2·3 keycaps -->
  <div class="rt-switch" role="group" aria-label="Three takes — tap a number or press 1·2·3 to switch which mix plays. The playhead carries.">
    {TAKES.map((_, i) => (
      <button
        type="button"
        class="rt-key"
        data-rt-key={String(i)}
        data-active={i === 0 ? "true" : "false"}
        aria-label={`Take ${i + 1} — tap to audition, hold to crown`}
      >
        <span class="rt-hold-fill" aria-hidden="true"></span>
        <span class="rt-key-num">{i + 1}</span>
        <span class="rt-key-id" data-rt-key-id={String(i)}>Take {i + 1}</span>
      </button>
    ))}
  </div>

  <!-- reveal + crown row -->
  <div class="rt-foot">
    <button type="button" class="rt-reveal" data-rt-reveal>🔍 reveal what I'm hearing</button>
    <span class="rt-status" data-rt-status aria-live="polite"></span>
  </div>

  <!-- on reveal: what the active take was matched toward -->
  <p class="rt-refline" data-rt-refline hidden></p>

  <p class="rt-hint">
    <kbd>1</kbd><kbd>2</kbd><kbd>3</kbd> switch · hold to <span class="rt-hint-crown">♛ vote</span> · <kbd>R</kbd> reveal mixes · <kbd>space</kbd> play when selected
  </p>
</div>

<script>
  // ── Each card is self-contained. Real audio: three takes decoded once and
  //    played as sample-aligned looping sources; switching only crossfades
  //    which one is audible, so the playhead carries across takes. ──────────
  const TAKES = [
    { id: "bright · forward", ref: "toward Caroline Polachek’s never-harsh top end", file: "/case-studies/the-console/renditions/take1.mp3" },
    { id: "warm · intimate", ref: "toward Frank Ocean’s recessed, in-the-room vocal", file: "/case-studies/the-console/renditions/take2.mp3" },
    { id: "open · unhyped", ref: "toward Tame Impala’s big, open low end", file: "/case-studies/the-console/renditions/take3.mp3" },
  ];

  document.querySelectorAll<HTMLElement>("[data-rt]").forEach((root) => {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const playBtn = root.querySelector<HTMLButtonElement>("[data-rt-play]");
    const timeEl = root.querySelector<HTMLElement>("[data-rt-time]");
    const nowEl = root.querySelector<HTMLElement>("[data-rt-now]");
    const wave = root.querySelector<HTMLElement>("[data-rt-wave]");
    const waveBars = [...root.querySelectorAll<HTMLElement>(".rt-bar")];
    const playhead = root.querySelector<HTMLElement>("[data-rt-playhead]");
    const buffering = root.querySelector<HTMLElement>("[data-rt-buffering]");
    const keys = [...root.querySelectorAll<HTMLButtonElement>("[data-rt-key]")];
    const keyIds = [...root.querySelectorAll<HTMLElement>("[data-rt-key-id]")];
    const revealBtn = root.querySelector<HTMLButtonElement>("[data-rt-reveal]");
    const statusEl = root.querySelector<HTMLElement>("[data-rt-status]");
    const refline = root.querySelector<HTMLElement>("[data-rt-refline]");

    let ctx: AudioContext | null = null;
    let master: GainNode | null = null;
    let buffers: AudioBuffer[] = [];
    let sources: AudioBufferSourceNode[] = [];
    let chainGains: GainNode[] = [];
    let loopDur = 0;
    let active = 0;
    let playing = false;
    let loaded = false;
    let loadingPromise: Promise<void> | null = null;
    let startCtxTime = 0;      // ctx.currentTime mapped to the loop's t=0
    let raf = 0;

    const fmt = (s: number) => {
      const m = Math.floor(s / 60);
      const r = Math.floor(s % 60);
      return `${m}:${String(r).padStart(2, "0")}`;
    };
    const flash = (msg: string) => {
      if (!statusEl) return;
      statusEl.textContent = msg;
      window.setTimeout(() => { if (statusEl.textContent === msg) statusEl.textContent = ""; }, 2600);
    };

    // ── Load + decode all three clips once, build the persistent graph. ──
    async function ensureLoaded() {
      if (loaded) return;
      if (loadingPromise) return loadingPromise;
      loadingPromise = (async () => {
        const AC = window.AudioContext || (window as any).webkitAudioContext;
        ctx = new AC();
        master = ctx.createGain();
        master.gain.value = 0.95;
        master.connect(ctx.destination);
        buffers = await Promise.all(TAKES.map(async (t) => {
          const ab = await fetch(t.file).then((r) => r.arrayBuffer());
          return await ctx!.decodeAudioData(ab);
        }));
        loopDur = Math.min(...buffers.map((b) => b.duration));
        chainGains = buffers.map((_, i) => {
          const g = ctx!.createGain();
          g.gain.value = i === active ? 1 : 0;
          g.connect(master!);
          return g;
        });
        drawWaveform(buffers[0]);
        loaded = true;
      })();
      return loadingPromise;
    }

    // (Re)start all three sources sample-aligned from `offset` seconds. Forcing
    // a shared loopEnd keeps them locked together however the decoder padded.
    function startSources(offset: number) {
      if (!ctx) return;
      sources.forEach((s) => { try { s.stop(); } catch {} });
      const off = ((offset % loopDur) + loopDur) % loopDur;
      sources = buffers.map((buf, i) => {
        const s = ctx!.createBufferSource();
        s.buffer = buf;
        s.loop = true;
        s.loopStart = 0;
        s.loopEnd = loopDur;
        s.connect(chainGains[i]);
        return s;
      });
      const t = ctx.currentTime + 0.03;
      sources.forEach((s) => s.start(t, off));
      startCtxTime = t - off;
    }

    function drawWaveform(buf: AudioBuffer) {
      const data = buf.getChannelData(0);
      const N = waveBars.length;
      const step = Math.max(1, Math.floor(data.length / N));
      const peaks: number[] = [];
      let max = 0.0001;
      for (let i = 0; i < N; i++) {
        let p = 0;
        const start = i * step;
        for (let j = 0; j < step; j += 16) { const a = Math.abs(data[start + j] || 0); if (a > p) p = a; }
        peaks.push(p);
        if (p > max) max = p;
      }
      waveBars.forEach((b, i) => { b.style.height = `${Math.max(6, Math.round(Math.pow(peaks[i] / max, 0.7) * 100))}%`; });
    }

    function updateRefline() {
      if (!refline) return;
      if (root.dataset.revealed === "true") {
        refline.innerHTML = `<b>Take ${active + 1} — ${TAKES[active].id}</b> · ${TAKES[active].ref}`;
        refline.removeAttribute("hidden");
      } else {
        refline.setAttribute("hidden", "");
      }
    }

    function setActive(i: number, announce = true) {
      active = i;
      root.dataset.active = String(i);
      keys.forEach((k, idx) => (k.dataset.active = idx === i ? "true" : "false"));
      if (nowEl) nowEl.textContent = root.dataset.revealed === "true" ? TAKES[i].id : `Take ${i + 1}`;
      updateRefline();
      // Crossfade chain gains — same sources, same instant; only the mix changes.
      if (ctx && chainGains.length) {
        const now = ctx.currentTime;
        chainGains.forEach((g, idx) => {
          g.gain.cancelScheduledValues(now);
          g.gain.setTargetAtTime(idx === i ? 1 : 0, now, 0.04);
        });
      }
      if (announce) flash(`take ${i + 1}${root.dataset.revealed === "true" ? " · " + TAKES[i].id : ""}`);
    }

    async function play() {
      buffering?.setAttribute("data-on", "true");
      playBtn?.setAttribute("data-state", "loading");
      try {
        await ensureLoaded();
        await ctx!.resume();
      } catch (err) {
        buffering?.setAttribute("data-on", "false");
        playBtn?.removeAttribute("data-state");
        flash("couldn't load audio — check your connection");
        return;
      }
      if (!sources.length) startSources(0);
      buffering?.setAttribute("data-on", "false");
      playBtn?.removeAttribute("data-state");
      playing = true;
      root.dataset.playing = "true";
      if (playBtn) playBtn.textContent = "❚❚";
      loopTick();
    }
    async function pause() {
      playing = false;
      root.dataset.playing = "false";
      if (playBtn) playBtn.textContent = "▶";
      if (raf) cancelAnimationFrame(raf);
      await ctx?.suspend();
    }
    const toggle = () => { playing ? pause() : play(); };

    function loopTick() {
      if (!playing || !ctx) return;
      const elapsed = (ctx.currentTime - startCtxTime) % loopDur;
      const frac = elapsed / loopDur;
      if (playhead) playhead.style.left = `${frac * 100}%`;
      if (timeEl) timeEl.textContent = `${fmt(elapsed)} / ${fmt(loopDur)}`;
      raf = requestAnimationFrame(loopTick);
    }

    // controls
    playBtn?.addEventListener("click", toggle);
    keys.forEach((k, i) => {
      // tap = switch (start playback if idle); hold = crown
      let holdTimer = 0;
      let held = false;
      const startHold = (e: Event) => {
        e.preventDefault();
        held = false;
        k.dataset.holding = "true";
        holdTimer = window.setTimeout(() => {
          held = true;
          k.dataset.holding = "false";
          crown(i);
        }, reduce ? 1 : 650);
      };
      const endHold = () => {
        k.dataset.holding = "false";
        if (holdTimer) clearTimeout(holdTimer);
        if (!held) { if (!playing) play(); setActive(i); }
      };
      k.addEventListener("pointerdown", startHold);
      k.addEventListener("pointerup", endHold);
      k.addEventListener("pointerleave", () => { k.dataset.holding = "false"; if (holdTimer) clearTimeout(holdTimer); });
    });

    function crown(i: number) {
      setActive(i, false);
      keys.forEach((k, idx) => (k.dataset.crowned = idx === i ? "true" : "false"));
      const id = root.dataset.revealed === "true" ? ` — ${TAKES[i].id}` : "";
      flash(`♛ crowned Take ${i + 1}${id} · Richard logs the win and leans your references this way`);
    }

    function setRevealed(on: boolean) {
      root.dataset.revealed = on ? "true" : "false";
      keyIds.forEach((el, i) => { el.textContent = on ? TAKES[i].id : `Take ${i + 1}`; });
      if (nowEl) nowEl.textContent = on ? TAKES[active].id : `Take ${active + 1}`;
      if (revealBtn) revealBtn.textContent = on ? "🙈 hide identities" : "🔍 reveal what I'm hearing";
      updateRefline();
    }
    revealBtn?.addEventListener("click", () => setRevealed(root.dataset.revealed !== "true"));

    // click-to-seek on the waveform (restarts the aligned sources at the offset)
    wave?.addEventListener("click", (e) => {
      if (!loaded || !loopDur) { if (!playing) play(); return; }
      const rect = wave.getBoundingClientRect();
      const frac = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
      startSources(frac * loopDur);
      if (!playing) play();
    });

    // ── Keyboard. The old handler was bound to the card and only fired once the
    //    card had focus, so 1·2·3 silently did nothing on first load (the live-site
    //    glitch). Now it's document-level and gated on visibility: 1·2·3 + R work
    //    whenever the demo is on screen; space is scoped to hover/focus so it can
    //    never hijack page-scroll. ──
    root.tabIndex = 0;
    let inView = false;
    new IntersectionObserver(
      (es) => es.forEach((e) => (inView = e.isIntersecting)),
      { threshold: 0.45 }
    ).observe(root);
    let hovered = false;
    root.addEventListener("pointerenter", () => (hovered = true));
    root.addEventListener("pointerleave", () => (hovered = false));
    const focused = () => root.contains(document.activeElement);

    document.addEventListener("keydown", (e) => {
      const t = e.target as HTMLElement | null;
      if (t && (t.tagName === "INPUT" || t.tagName === "TEXTAREA" || t.isContentEditable)) return;
      const k = e.key.toLowerCase();
      if (k === "1" || k === "2" || k === "3") {
        if (!inView) return;
        e.preventDefault();
        if (!playing) play();
        setActive(Number(k) - 1);
      } else if (k === "r") {
        if (!inView) return;
        e.preventDefault();
        setRevealed(root.dataset.revealed !== "true");
      } else if (k === " " || k === "spacebar") {
        if (!hovered && !focused()) return; // never steal page scroll
        e.preventDefault();
        toggle();
      }
    });

    // expose minimal state for verification
    (root as any).__rt = {
      get active() { return active; },
      get playing() { return playing; },
      get loaded() { return loaded; },
      get gains() { return chainGains.map((g) => Math.round(g.gain.value * 100) / 100); },
      get ctxState() { return ctx?.state ?? "none"; },
      get loopDur() { return Math.round(loopDur * 100) / 100; },
      get takes() { return TAKES.length; },
    };
  });
</script>

<style>
  .rt {
    background: linear-gradient(180deg, rgba(17, 12, 22, 0.96), rgba(11, 8, 15, 0.96));
    border: 1px solid rgba(245, 241, 232, 0.12);
    border-radius: 10px;
    padding: 22px 24px 18px;
    color: #f5f1e8;
    font-family: "Geist Variable", ui-sans-serif, system-ui, sans-serif;
    outline: none;
    transition: border-color 200ms ease, box-shadow 200ms ease;
  }
  .rt:focus-within {
    border-color: rgba(255, 150, 80, 0.4);
    box-shadow: 0 0 0 1px rgba(255, 150, 80, 0.28);
  }

  /* head */
  .rt-head { display: flex; align-items: center; justify-content: space-between; gap: 14px; margin-bottom: 16px; flex-wrap: wrap; }
  .rt-head-left { display: flex; align-items: center; gap: 12px; min-width: 0; }
  .rt-source {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-style: italic; font-weight: 700; font-size: 16px;
    color: #00ff4d; background: rgba(0, 255, 77, 0.05);
    border: 1px solid rgba(0, 255, 77, 0.32); border-radius: 4px;
    padding: 5px 11px; box-shadow: 0 0 12px rgba(0, 255, 77, 0.12);
  }
  .rt-tag, .rt-loud {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 10px; letter-spacing: 0.16em; text-transform: uppercase;
    color: rgba(245, 241, 232, 0.5);
  }
  .rt-loud {
    color: var(--brand-yellow);
    border: 1px solid rgba(255, 179, 71, 0.4);
    border-radius: 20px; padding: 4px 11px; cursor: help;
  }

  /* transport */
  .rt-transport { display: flex; align-items: center; gap: 14px; margin-bottom: 12px; }
  .rt-play {
    width: 38px; height: 38px; border-radius: 50%; flex: 0 0 auto;
    border: 1px solid rgba(245, 241, 232, 0.3); background: rgba(245, 241, 232, 0.04);
    color: #f5f1e8; font-size: 13px; cursor: pointer; position: relative;
    display: flex; align-items: center; justify-content: center;
    transition: background 160ms ease, border-color 160ms ease;
  }
  .rt[data-playing="true"] .rt-play { background: rgba(0, 255, 77, 0.08); border-color: rgba(0, 255, 77, 0.5); color: #00ff4d; }
  .rt-play[data-state="loading"] { color: transparent; }
  .rt-play[data-state="loading"]::after {
    content: ""; position: absolute; width: 15px; height: 15px;
    border: 2px solid rgba(245, 241, 232, 0.6); border-top-color: transparent;
    border-radius: 50%; animation: rt-spin 0.7s linear infinite;
  }
  @keyframes rt-spin { to { transform: rotate(360deg); } }
  /* track time — the pink italic LCD readout from the real BucketCard */
  .rt-time {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-style: italic; font-weight: 700; font-size: 15px; color: #ff3b6e;
    font-feature-settings: "tnum"; letter-spacing: 0.04em; line-height: 1;
    text-shadow: 0 0 4px rgba(255, 59, 110, 0.65), 0 0 10px rgba(255, 59, 110, 0.35);
  }
  .rt-now {
    margin-left: auto; font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11px; letter-spacing: 0.08em; color: rgba(245, 241, 232, 0.7);
    background: rgba(245, 241, 232, 0.04); border: 1px solid rgba(245, 241, 232, 0.14);
    border-radius: 4px; padding: 4px 10px;
  }

  /* waveform */
  .rt-wave {
    position: relative; height: 72px; background: #07060c;
    border-radius: 4px; overflow: hidden; margin-bottom: 16px;
    display: flex; align-items: center; gap: 1px; padding: 0 6px; cursor: pointer;
  }
  .rt-bar {
    flex: 1 1 0; border-radius: 1px;
    background: linear-gradient(180deg, rgba(14, 196, 252, 0.62) 0%, rgba(14, 196, 252, 0.26) 100%);
    transition: background 280ms ease, height 280ms ease;
  }
  .rt[data-active="1"] .rt-bar { background: linear-gradient(180deg, rgba(255, 39, 97, 0.6) 0%, rgba(255, 39, 97, 0.24) 100%); }
  .rt[data-active="2"] .rt-bar { background: linear-gradient(180deg, rgba(255, 179, 71, 0.62) 0%, rgba(255, 179, 71, 0.26) 100%); }
  .rt-playhead {
    position: absolute; top: 0; bottom: 0; width: 2px; left: 0%;
    background: #f5f1e8; box-shadow: 0 0 8px rgba(245, 241, 232, 0.6);
    pointer-events: none; z-index: 3;
  }
  .rt[data-playing="false"] .rt-playhead { opacity: 0.35; }
  .rt-buffering {
    position: absolute; inset: 0; pointer-events: none; opacity: 0;
    background: linear-gradient(90deg, transparent, rgba(245, 241, 232, 0.07), transparent);
    transition: opacity 200ms ease;
  }
  .rt-buffering[data-on="true"] { opacity: 1; animation: rt-shimmer 1s linear infinite; }
  @keyframes rt-shimmer { 0% { transform: translateX(-100%); } 100% { transform: translateX(100%); } }

  /* 1·2·3 keycaps — faithful to the production Arena 3D keycap */
  .rt-switch { display: flex; gap: 8px; margin-bottom: 14px; }
  .rt-key {
    position: relative; flex: 1; overflow: hidden;
    display: flex; flex-direction: column; align-items: center; gap: 3px;
    padding: 12px 10px 11px; cursor: pointer;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    color: #ece3f2; user-select: none; touch-action: none;
    border: 1px solid rgba(236, 227, 242, 0.22);
    border-bottom-color: rgba(0, 0, 0, 0.55);
    border-radius: 8px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.12) 0%, rgba(236, 227, 242, 0.05) 46%, rgba(0, 0, 0, 0.12) 100%);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.24),
      inset 0 -2px 4px rgba(0, 0, 0, 0.3),
      0 2px 0 rgba(0, 0, 0, 0.5),
      0 4px 7px rgba(0, 0, 0, 0.42);
    transition: transform 120ms ease, box-shadow 120ms ease, border-color 120ms ease, color 120ms ease;
  }
  .rt-key:hover {
    border-color: rgba(236, 227, 242, 0.5); color: #fff; transform: translateY(-1px);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.32), inset 0 -2px 4px rgba(0, 0, 0, 0.3), 0 3px 0 rgba(0, 0, 0, 0.5), 0 6px 12px rgba(0, 0, 0, 0.48);
  }
  .rt-key[data-active="true"] {
    background: linear-gradient(135deg, #ff2d8b, #ff7a3d, #ffd23d);
    color: #0d060f; border-color: rgba(255, 180, 90, 0.55);
    border-bottom-color: rgba(120, 45, 10, 0.7);
    transform: translateY(2px);
    box-shadow: 0 0 24px rgba(255, 140, 80, 0.5), 0 1px 0 rgba(0, 0, 0, 0.35),
      inset 0 2px 3px rgba(255, 255, 255, 0.45), inset 0 -3px 6px rgba(150, 55, 10, 0.5);
  }
  .rt-key-num { font-size: 17px; font-weight: 700; line-height: 1; position: relative; z-index: 2; }
  .rt-key-id {
    font-size: 10px; letter-spacing: 0.02em; position: relative; z-index: 2;
    color: inherit; opacity: 0.78; text-align: center; white-space: nowrap;
  }
  .rt-key[data-active="true"] .rt-key-id { opacity: 0.92; }
  .rt-key[data-crowned="true"]::before {
    content: "♛"; position: absolute; top: 3px; right: 6px; font-size: 12px; z-index: 4;
    color: #ffd23d; text-shadow: 0 0 7px rgba(255, 210, 61, 0.9);
    animation: rt-crownpop 480ms cubic-bezier(0.2, 1.5, 0.45, 1) 1;
  }
  .rt-key[data-active="true"][data-crowned="true"]::before { color: #0d060f; text-shadow: none; }
  @keyframes rt-crownpop {
    0% { transform: scale(0) rotate(-30deg); opacity: 0; }
