---
// Layout wrapper for rich, custom case-study pages. Pins the portal dark
// palette via [data-theme="dark"] so the public site's theme cycling
// doesn't reach in. Provides the shared brand tokens used by the CS
// primitives.
import "@fontsource-variable/geist";
import "@fontsource-variable/space-grotesk";
import "@fontsource/ibm-plex-mono/latin-400.css";
import "@fontsource/ibm-plex-mono/latin-500.css";
import "@fontsource/ibm-plex-mono/latin-600.css";
import "../../styles/tokens.css";
import CSProgress from "./CSProgress.astro";
import AwayRail from "../studio/AwayRail.astro";

interface Props {
  title: string;
  description?: string;
  /** Open-graph cover URL. Falls back to /og-image.png. */
  ogImage?: string;
}

const { title, description, ogImage = "/og-image.png" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="article" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {/* Tolo.Cloud case study runs in the portal's pinned dark theme so the
        page looks and feels like the product it describes. The public site
        theme cycler is bypassed entirely on this route. */}
    <script is:inline>
      document.documentElement.dataset.theme = "dark";
    </script>
  </head>
  <body class="cs-body">
    {/* The site's nav column (home + résumé), dark to match the canvas, with
        the comet trail riding its right edge (2026-08-16 — replaces the old
        back/resume text nav). */}
    <AwayRail variant="dark" />
    <CSProgress />

    <main class="cs-main">
      <slot />
    </main>

    {/* The house floor, dark clothes (2026-08-23 — the old site Footer with
        its credo/colophon/Substack retires; this matches the homepage's). */}
    <footer class="cs-floor">
      <span class="cs-floor-lines">
        <a href="mailto:jtollefson123@gmail.com">jtollefson123@gmail.com</a>
        <span class="cs-floor-city">Minneapolis, MN</span>
      </span>
      <a class="cs-floor-resume" href="/resume">résumé</a>
    </footer>
  </body>
</html>

<style is:global>
  /* Custom case-study pages run on a focused, dark canvas. They opt OUT
     of the public-site theme cycler — the <script is:inline> in the head
     pins data-theme="dark" so the only palette in play is the portal's. */
  /* tokens.css hides the system cursor on fine-pointer devices to let the
     public-site custom cursor (Cursor.astro) take over. The case-study
     route doesn't include Cursor.astro, so restore the system cursor here
     to prevent an invisible-mouse state. */
  @media (pointer: fine) {
    .cs-body,
    .cs-body a,
    .cs-body button,
    .cs-body input,
    .cs-body textarea,
    .cs-body [role="button"] {
      cursor: auto;
    }
    .cs-body a,
    .cs-body button,
    .cs-body [role="button"],
    .cs-body [data-bc-rename],
    .cs-body [data-bc-expand],
    .cs-body [data-vh-verb],
    .cs-body [data-pb-promote],
    .cs-body [data-pb-reset],
    .cs-body [data-ce-slider]::-webkit-slider-thumb,
    .cs-body .ce-dot {
      cursor: pointer;
    }
    .cs-body input[type="range"] {
      cursor: ew-resize;
    }
    .cs-body [contenteditable="true"] {
      cursor: text;
    }
  }

  :root[data-theme="dark"] .cs-body {
    /* Brand tokens lifted from the portal so the case study can speak
       with the product's voice. */
    --brand-pink: #ff2761;
    --brand-orange: #ff5a3c;
    --brand-yellow: #ffb347;
    --brand-cyan: #0ec4fc;
    --brand-green: #00ff4d;
    --brand-grad: linear-gradient(90deg, #ff2761 0%, #ff5a3c 50%, #ffb347 100%);
    --brand-grad-soft: linear-gradient(90deg, rgba(255,39,97,0.18) 0%, rgba(255,90,60,0.18) 50%, rgba(255,179,71,0.18) 100%);

    --cs-bg: #07060c;
    --cs-surface: #0f0a12;
    --cs-surface-2: #15101a;
    --cs-text: #f5f1e8;
    --cs-text-muted: rgba(245, 241, 232, 0.62);
    --cs-text-dim: rgba(245, 241, 232, 0.38);
    --cs-line: rgba(245, 241, 232, 0.10);
    --cs-line-strong: rgba(245, 241, 232, 0.22);

    background: var(--cs-bg);
    color: var(--cs-text);
    font-family: "Geist Variable", ui-sans-serif, system-ui, sans-serif;
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  .cs-body * {
    box-sizing: border-box;
  }

  /* Subtle starfield-ish noise so the dark canvas doesn't feel flat. The
     speckles.svg is reused from the public homepage; here we cut its
     alpha way down. */
  .cs-body::before {
    content: "";
    position: fixed;
    inset: 0;
    background-image: url("/speckles.svg");
    background-repeat: repeat;
    opacity: 0.06;
    pointer-events: none;
    z-index: 0;
  }

  .cs-body .cs-main,
  .cs-body .cs-floor {
    position: relative;
    z-index: 1;
  }

  /* the floor — same object as the homepage's, in the room's dark */
  .cs-floor {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    max-width: 1160px;
    margin: 0 auto;
    padding: 26px 32px 34px;
    border-top: 1px solid var(--cs-line);
    font-family: var(--cs-mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
  }
  @media (min-width: 900px) {
    .cs-floor {
      margin-left: 92px;
    }
  }
  .cs-floor-lines {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  .cs-floor a {
    color: var(--cs-text);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .cs-floor a:hover,
  .cs-floor a:focus-visible {
    color: var(--brand-orange);
  }
  .cs-floor-city {
    color: var(--cs-text-muted);
  }

  /* Body-wide section spacing. Sections are full-bleed (1fr) and content
     lives in .cs-inner which limits to a generous reading width but lets
     figures break out via .cs-bleed. */
  .cs-main {
    padding: 0 0 96px;
  }
  /* the fixed 92px rail is opaque — give the reading column its offset
     HERE, once, so page-local max-width wrappers stop sharing pixels
     with it between 900 and 1280px (2026-08-23 cohesion pass) */
  @media (min-width: 900px) {
    .cs-main {
      padding-left: 92px;
    }
  }

  /* one mono for the whole dark route — the same Plex the house chrome
     uses; pages reference the token instead of restating a system stack */
  .cs-body {
    --cs-mono: "IBM Plex Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  /* the standard end-of-page line, shared by all five studies: quiet
     lowercase mono, no pill, no shout. Below 900px (rail hidden) it is
     also the only way home, so it stays on every page. */
  .cs-foot {
    text-align: center;
    padding: 56px 0 0;
  }
  .cs-foot-back {
    font-family: var(--cs-mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: var(--cs-text-muted);
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: color 160ms ease;
  }
  .cs-foot-back:hover,
  .cs-foot-back:focus-visible {
    color: var(--brand-orange);
  }

  .cs-inner {
    max-width: 1160px;
    margin: 0 auto;
    padding: 0 32px;
  }
  .cs-narrow {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 32px;
  }
  .cs-wide {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 32px;
  }
  /* Full-bleed escape for figures that want every available pixel. */
  .cs-bleed {
    width: 100vw;
    margin-left: 50%;
    transform: translateX(-50%);
  }
  /* Cap demos and figures at a sane max-width on big monitors so the
     interactive frames don't sprawl across a 1920+ viewport and pull the
     eye away from the reading column. The hero stays uncapped (its band
     fills the viewport while its inner content sets its own width). */
  .cs-live.cs-bleed,
  .cs-fig.cs-bleed {
    max-width: 1440px;
  }

  /* Typography defaults for case-study prose. Light cream on near-black,
     a hair larger than the public-site default so it reads at scale. */
  .cs-main p {
    font-size: 17px;
    line-height: 1.65;
    color: rgba(245, 241, 232, 0.88);
    margin: 0 0 18px;
    max-width: 64ch;
  }
  .cs-main p:last-child { margin-bottom: 0; }
  .cs-main p code,
  .cs-main li code,
  .cs-main td code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.88em;
    background: rgba(14, 196, 252, 0.08);
    color: var(--brand-cyan);
    border: 1px solid rgba(14, 196, 252, 0.18);
    border-radius: 3px;
    padding: 1px 5px;
  }
  .cs-main strong { color: var(--cs-text); font-weight: 700; }
  .cs-main a {
    color: var(--cs-text);
    text-decoration: underline;
    text-decoration-color: var(--brand-orange);
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }
  .cs-main a:hover { text-decoration-thickness: 2px; }

  /* Footer on the dark case-study route should sit on the dark canvas
     without re-introducing the public theme tokens. */
  .cs-body footer {
    border-top: 1px solid var(--cs-line);
    margin-top: 64px;
  }
</style>
