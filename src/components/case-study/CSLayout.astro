---
// Layout wrapper for rich, custom case-study pages. Light by default and
// governed by the sitewide day/night axis (html[data-night]) like every
// other route — the pinned always-dark canvas was retired 2026-08-28 on
// Jon's call ("it breaks the rule of light mode and dark mode switch").
// Night mode reproduces the old dark palette verbatim. Provides the
// shared brand tokens used by the CS primitives.
import "@fontsource-variable/geist";
import "@fontsource-variable/space-grotesk";
import "@fontsource/ibm-plex-mono/latin-400.css";
import "@fontsource/ibm-plex-mono/latin-500.css";
import "@fontsource/ibm-plex-mono/latin-600.css";
import "../../styles/tokens.css";
import CSProgress from "./CSProgress.astro";
import AwayRail from "../studio/AwayRail.astro";
import Cursor from "../Cursor.astro";
import NightBoot from "../NightBoot.astro";

interface Props {
  title: string;
  description?: string;
  /** Open-graph cover URL. Falls back to /og-image.png. */
  ogImage?: string;
}

const { title, description, ogImage = "/og-image.png" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <link rel="canonical" href={new URL(Astro.url.pathname, "https://uxjon.com").href} />
    <meta property="og:url" content={new URL(Astro.url.pathname, "https://uxjon.com").href} />
    <meta property="og:site_name" content="Jonathan Tollefson" />
    <meta property="og:image" content={new URL(ogImage, "https://uxjon.com").href} />
    <meta property="og:type" content="article" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#e9e8e5" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {/* Same pre-paint night bootstrap as Layout.astro — the case-study
        route follows the sitewide day/night axis. */}
    <NightBoot />
  </head>
  <body class="cs-body">
    {/* The site's nav column (home + résumé + night switch), themed by the
        sitewide axis, with the comet trail riding its right edge. */}
    <AwayRail />
    <CSProgress />
    <Cursor />

    <main class="cs-main">
      <slot />

    {/* The house floor, dark clothes — INSIDE main so it shares the
        rail-inset content column (QA 2026-08-28). */}
    <footer class="cs-floor">
      <span class="cs-floor-lines">
        <a href="mailto:jtollefson123@gmail.com">jtollefson123@gmail.com</a>
        <span class="cs-floor-city">Minneapolis, MN</span>
      </span>
      <span class="cs-floor-right">
        <a class="cs-floor-li" href="https://linkedin.com/in/jtollefson123" aria-label="LinkedIn" target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3" /><path d="M8 11v5" /><path d="M8 8v.01" /><path d="M12 16v-5" /><path d="M16 16v-3a2 2 0 0 0-4 0" /></svg></a>
        <a class="cs-floor-resume" href="/resume">résumé</a>
      </span>
    </footer>
    </main>
  </body>
</html>

<style is:global>
  /* Case-study pages run on the studio's light canvas by default; the
     sitewide night switch flips the whole route to the old dark palette
     (verbatim values in the html[data-night] block below). Product
     demos and screenshot stages keep their own dark skins in BOTH
     temperatures — the product is dark; only the page around it turns. */
  /* tokens.css hides the system cursor on body/a/button for the custom
     cursor (Cursor.astro), which this route now includes (2026-08-28 —
     one cursor sitewide, Jon's call). Extend cursor: none to this route's
     interactive elements so the system cursor never doubles the dot; the
     media guard mirrors tokens.css so reduced-motion keeps a real cursor. */
  @media (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .cs-body input,
    .cs-body textarea,
    .cs-body [role="button"],
    .cs-body input[type="range"],
    .cs-body [contenteditable="true"] {
      cursor: none;
    }
  }

  .cs-body {
    /* Brand tokens lifted from the portal so the case study can speak
       with the product's voice. Same hues in both temperatures — they
       belong to the product's graphics, not the page. */
    --brand-pink: #ff2761;
    --brand-orange: #ff5a3c;
    --brand-yellow: #ffb347;
    --brand-cyan: #0ec4fc;
    --brand-green: #00ff4d;
    --brand-grad: linear-gradient(90deg, #ff2761 0%, #ff5a3c 50%, #ffb347 100%);
    --brand-grad-soft: linear-gradient(90deg, rgba(255,39,97,0.18) 0%, rgba(255,90,60,0.18) 50%, rgba(255,179,71,0.18) 100%);

    /* Day canvas — the same ground as the homepage studio. */
    --cs-bg: #e9e8e5;
    --cs-surface: #f4f3f0;
    --cs-surface-2: #eceae6;
    --cs-text: #141210;
    --cs-text-muted: rgba(20, 18, 16, 0.66);
    /* 0.56, not a mirror of night's 0.38: the dim tier must keep the
       ~4:1 read it has on the dark ground (three converters flagged
       0.44 at ~2.8:1 on day) */
    --cs-text-dim: rgba(20, 18, 16, 0.56);
    --cs-line: rgba(20, 18, 16, 0.14);
    --cs-line-strong: rgba(20, 18, 16, 0.32);
    /* Prose ink (was a hardcoded cream on .cs-main p). */
    --cs-prose: rgba(20, 18, 16, 0.88);
    /* Screenshot MAT — a light backdrop for dark/transparent captures.
       Deliberately the SAME in night: a mat is a mat. Never paint mats
       with --cs-text (that inverts into a black slab on day). */
    --cs-mat: #f5f1e8;
    /* Brand hues used AS TEXT need AA on the light ground; night maps
       them back to the raw brand values. */
    --cs-accent: #b33a2a;
    --cs-pink-text: #c2184c;
    --cs-cyan-text: #0b6e96;
    --cs-green-text: #0a7a33;
    --cs-yellow-text: #8a6d00;
    /* the brand gradient for background-clip:text titles — deepened on
       day so the amber end doesn't wash out on the light ground */
    --cs-grad-text: linear-gradient(90deg, #c2184c 0%, #c53a20 50%, #8a6d00 100%);

    background: var(--cs-bg);
    color: var(--cs-text);
    font-family: "Geist Variable", ui-sans-serif, system-ui, sans-serif;
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
    transition: background 560ms ease, color 560ms ease;
  }
  /* Night — the pre-2026-08-28 dark route, value for value. Screen-only
     so print can never resolve a dark page. */
  @media screen {
    html[data-night] .cs-body {
      --cs-bg: #07060c;
      --cs-surface: #0f0a12;
      --cs-surface-2: #15101a;
      --cs-text: #f5f1e8;
      --cs-text-muted: rgba(245, 241, 232, 0.62);
      --cs-text-dim: rgba(245, 241, 232, 0.38);
      --cs-line: rgba(245, 241, 232, 0.10);
      --cs-line-strong: rgba(245, 241, 232, 0.22);
      --cs-prose: rgba(245, 241, 232, 0.88);
      --cs-accent: var(--brand-orange);
      --cs-pink-text: var(--brand-pink);
      --cs-cyan-text: var(--brand-cyan);
      --cs-green-text: var(--brand-green);
      --cs-yellow-text: var(--brand-yellow);
      --cs-grad-text: var(--brand-grad);
    }
  }

  .cs-body * {
    box-sizing: border-box;
  }

  /* Subtle starfield-ish noise so the dark canvas doesn't feel flat.
     Night-only: the speckles are light-colored and invisible on the day
     ground anyway. */
  @media screen {
    html[data-night] .cs-body::before {
      content: "";
      position: fixed;
      inset: 0;
      background-image: url("/speckles.svg");
      background-repeat: repeat;
      opacity: 0.06;
      pointer-events: none;
      z-index: 0;
    }
  }

  .cs-body .cs-main,
  .cs-body .cs-floor {
    position: relative;
    z-index: 1;
  }

  /* the floor — same object as the homepage's, in the room's dark */
  .cs-floor {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    max-width: 1160px;
    margin: 0 auto;
    padding: 26px 32px 34px;
    border-top: 1px solid var(--cs-line);
    font-family: var(--cs-mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
  }
  .cs-floor {
    margin-top: 24px;
    margin-bottom: 40px;
  }
  .cs-floor-lines {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  .cs-floor a {
    color: var(--cs-text);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .cs-floor a:hover,
  .cs-floor a:focus-visible {
    color: var(--cs-accent);
  }
  .cs-floor-city {
    color: var(--cs-text-muted);
  }
  .cs-floor-right {
    display: inline-flex;
    align-items: center;
    gap: 14px;
  }
  .cs-floor-li {
    display: inline-flex;
    color: var(--cs-text-muted);
  }
  .cs-floor-li svg {
    width: 21px;
    height: 21px;
  }
  .cs-floor-li:hover,
  .cs-floor-li:focus-visible {
    color: var(--cs-accent);
  }
  @media screen and (max-width: 899px) {
    .cs-floor-resume {
      display: none; /* the bottom bar already carries résumé */
    }
  }

  /* Body-wide section spacing. Sections are full-bleed (1fr) and content
     lives in .cs-inner which limits to a generous reading width but lets
     figures break out via .cs-bleed. */
  .cs-main {
    padding: 0 0 96px;
  }
  /* the fixed rail is opaque — give the reading column its offset
     HERE, once, so page-local max-width wrappers stop sharing pixels
     with it between 900 and 1280px (2026-08-23 cohesion pass; width
     unified on var(--railw) 2026-08-28) */
  @media (min-width: 900px) {
    .cs-main {
      padding-left: var(--railw, 110px);
    }
    /* .cs-bleed spans the rail-inset area [railw, 100vw] so every section
       shares ONE center axis and heroes never slide under the rail
       (QA 2026-08-28; supersedes the 46px correction) */
    .cs-main .cs-bleed {
      width: calc(100vw - var(--railw, 110px));
      margin-left: 50%;
      transform: translateX(-50%);
    }
  }

  /* one mono for the whole dark route — the same Plex the house chrome
     uses; pages reference the token instead of restating a system stack */
  .cs-body {
    --cs-mono: "IBM Plex Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  /* the standard end-of-page line, shared by all five studies: quiet
     lowercase mono, no pill, no shout. Below 900px (rail hidden) it is
     also the only way home, so it stays on every page. */
  .cs-foot {
    text-align: center;
    padding: 56px 0 0;
  }
  .cs-foot-back {
    font-family: var(--cs-mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: var(--cs-text-muted);
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: color 160ms ease;
  }
  .cs-foot-back:hover,
  .cs-foot-back:focus-visible {
    color: var(--cs-accent);
  }

  .cs-inner {
    max-width: 1160px;
    margin: 0 auto;
    padding: 0 32px;
  }
  .cs-narrow {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 32px;
  }
  .cs-wide {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 32px;
  }
  /* Full-bleed escape for figures that want every available pixel. */
  .cs-bleed {
    width: 100vw;
    margin-left: 50%;
    transform: translateX(-50%);
  }
  /* Cap demos and figures at a sane max-width on big monitors so the
     interactive frames don't sprawl across a 1920+ viewport and pull the
     eye away from the reading column. The hero stays uncapped (its band
     fills the viewport while its inner content sets its own width). */
  .cs-live.cs-bleed,
  .cs-fig.cs-bleed {
    max-width: 1440px;
  }

  /* Typography defaults for case-study prose — a hair larger than the
     public-site default so it reads at scale. Ink rides the theme axis. */
  .cs-main p {
    font-size: 17px;
    line-height: 1.65;
    color: var(--cs-prose);
    margin: 0 0 18px;
    max-width: 64ch;
  }
  .cs-main p:last-child { margin-bottom: 0; }
  .cs-main p code,
  .cs-main li code,
  .cs-main td code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.88em;
    background: color-mix(in srgb, var(--cs-cyan-text) 9%, transparent);
    color: var(--cs-cyan-text);
    border: 1px solid color-mix(in srgb, var(--cs-cyan-text) 22%, transparent);
    border-radius: 3px;
    padding: 1px 5px;
  }
  .cs-main strong { color: var(--cs-text); font-weight: 700; }
  .cs-main a {
    color: var(--cs-text);
    text-decoration: underline;
    text-decoration-color: var(--cs-accent);
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }
  .cs-main a:hover { text-decoration-thickness: 2px; }

  /* Footer on the dark case-study route should sit on the dark canvas
     without re-introducing the public theme tokens. */
  .cs-body footer {
    border-top: 1px solid var(--cs-line);
    margin-top: 64px;
  }
</style>
