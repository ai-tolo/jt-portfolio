---
// Tenant switcher — the star of the Momence case study.
//
// The four-category schema stays constant on the left rail. On the right,
// ONE persistent customer-detail card physically reshuffles when the tenant
// changes: the lead-KPI card slides into the lead slot, its value COUNTS UP
// from the old number to the new, flex-field chips crossfade, subscription
// labels swap, activity rewrites. Same bones, different priority order.
//
// Before the reader touches anything the card AUTO-CYCLES through the four
// tenants on a slow ambient loop (~2.6s each) so the concept proves itself
// before it's named. Any interaction (or focus) pauses the loop for good.
//
// The card is a single live DOM tree updated in place — NOT a display:none
// swap — so the transforms actually read as motion. All discrete state is
// driven by direct handlers; the count-up + cycle guarantee final values via
// setTimeout, because headless preview tabs throttle rAF / setInterval / CSS
// transitions. prefers-reduced-motion: no cycle, no count-up motion, final
// states only.

const TENANTS = [
  {
    id: "yoga",
    name: "Yoga studio",
    tag: "LoHi Studio · Denver",
    leadKpi: { label: "Sessions attended", n: 44, display: "44", trend: "+11%" },
    secondaryKpi: { label: "Total spend", n: 863, display: "$863", trend: "+17%" },
    subs: ["Barre Fit Advanced · 1st renewal", "Vinyasa Pro"],
    flexFields: ["Mat preference", "Instructor pref", "Injury notes"],
    tags: ["Yoga", "Pilates", "Core Series", "Concession"],
    activity: ["Check in · Gentle Vinyasa · 3h ago", "Payment · $37 · Feb Guest Pass · 2d", "Email · May Availability · 3d"],
  },
  {
    id: "coaching",
    name: "B2B coaching",
    tag: "Lattice for Coaches · Remote",
    leadKpi: { label: "Hours coached", n: 112, display: "112", trend: "+24%" },
    secondaryKpi: { label: "Contract", n: 12400, display: "$12,400", trend: "renews 90d", trendArrow: false },
    subs: ["Enterprise team coaching · Q2 cohort", "Executive 1:1 · Q3"],
    flexFields: ["Engagement type", "Renewal owner", "Success metric"],
    tags: ["Mid-market", "Executive", "Active", "Renewal"],
    activity: ["1:1 session · Susan B. · 4h ago", "Invoice · $4,200 · Q2 · 1d", "Email · Q3 scope discussion · 5d"],
  },
  {
    id: "pilates",
    name: "Pilates / reformer",
    tag: "RebelReformer · Brooklyn",
    leadKpi: { label: "Reformer sessions", n: 27, display: "27", trend: "+8%" },
    secondaryKpi: { label: "Total spend", n: 1420, display: "$1,420", trend: "+22%" },
    subs: ["Reformer Founder · monthly", "Tower Add-on"],
    flexFields: ["Apparatus pref", "Spring strength", "Body comp goal"],
    tags: ["Reformer", "Tower", "Founder", "Beginner"],
    activity: ["Check in · Reformer 102 · 1h ago", "Payment · $42 · Drop-in · 2d", "Note · added stretch goal · 3d"],
  },
  {
    id: "wellness",
    name: "Massage / wellness",
    tag: "GoodPress Wellness · Austin",
    leadKpi: { label: "Treatments YTD", n: 9, display: "9", trend: "+50%" },
    secondaryKpi: { label: "Total spend", n: 1140, display: "$1,140", trend: "+30%" },
    subs: ["Monthly Member · auto-renew", "Add-on: Cupping"],
    flexFields: ["Allergy notes", "Therapist pref", "Pressure preference"],
    tags: ["Deep tissue", "Member", "Sensitive skin", "Returning"],
    activity: ["Treatment · 90-min deep · 5d ago", "Payment · $135 · Renewal · 7d", "Note · update allergies · 12d"],
  },
];

const CATEGORIES = [
  { id: "contact", name: "Client Contact", desc: "Identity, communication." },
  { id: "business", name: "Business-Specific", desc: "Financials, subscriptions, credits." },
  { id: "flex", name: "Flex Fields", desc: "Per-tenant custom configuration." },
  { id: "activity", name: "User Interactions", desc: "Activity, messages, notes." },
];

// First tenant renders server-side so the card is fully present (and correct)
// with JS off. JS takes over to drive the reshuffle + auto-cycle.
const t0 = TENANTS[0];
---

<div class="mo-tn" data-mo-tn>
  {/* The tenant data island. {JSON.stringify} does NOT interpolate inside a
      <script> body in Astro, so hand it to JS via a typed JSON script tag and
      set:html. */}
  <script type="application/json" data-mo-tn-data set:html={JSON.stringify(TENANTS)}></script>

  <div class="mo-tn-picker" role="tablist" aria-label="Pick a tenant">
    {TENANTS.map((t, i) => (
      <button
        type="button"
        class:list={["mo-tn-opt", { active: i === 0 }]}
        role="tab"
        aria-selected={i === 0 ? "true" : "false"}
        data-mo-tn-opt={t.id}
      >
        <span class="mo-tn-opt-name">{t.name}</span>
        <span class="mo-tn-opt-tag">{t.tag}</span>
        <span class="mo-tn-opt-bar" aria-hidden="true"></span>
      </button>
    ))}
  </div>

  <div class="mo-tn-stage">
    <div class="mo-tn-schema">
      <span class="mo-tn-rail-lbl">schema · stays constant</span>
      <ul>
        {CATEGORIES.map((c) => (
          <li>
            <span class="mo-tn-cat-name">{c.name}</span>
            <span class="mo-tn-cat-desc">{c.desc}</span>
          </li>
        ))}
      </ul>
      <p class="mo-tn-rail-foot">Same four categories. What changes per tenant is priority, density, and flex.</p>
    </div>

    {/* ONE persistent card. Its contents are rewritten on switch; the lead KPI
        slides, its number counts up, chips crossfade. data-mo-tn-card carries
        the active tenant id for styling hooks. */}
    <div class="mo-tn-card" data-mo-tn-card={t0.id} aria-live="polite">
      <div class="mo-tn-card-head">
        <div class="mo-tn-avatar"><span>YK</span></div>
        <div>
          <p class="mo-tn-card-name">Yaz Kahrouf</p>
          <p class="mo-tn-card-meta">Joined Aug 2022 · <span class="mo-tn-on">attended today</span></p>
          <p class="mo-tn-card-tenant"><strong data-mo-tn-tname>{t0.name}</strong> · <span data-mo-tn-ttag>{t0.tag}</span></p>
        </div>
      </div>

      <div class="mo-tn-kpis">
        <div class="mo-tn-kpi mo-tn-kpi-lead" data-mo-tn-lead>
          <span class="mo-tn-kpi-lbl" data-mo-tn-lead-lbl>{t0.leadKpi.label}</span>
          <span class="mo-tn-kpi-n" data-mo-tn-lead-n data-mo-tn-n={t0.leadKpi.n}>{t0.leadKpi.display}</span>
          <span class="mo-tn-kpi-trend" data-mo-tn-lead-trend>{(t0.leadKpi as any).trendArrow === false ? "" : "↗ "}{t0.leadKpi.trend}</span>
        </div>
        <div class="mo-tn-kpi" data-mo-tn-sec>
          <span class="mo-tn-kpi-lbl" data-mo-tn-sec-lbl>{t0.secondaryKpi.label}</span>
          <span class="mo-tn-kpi-n" data-mo-tn-sec-n>{t0.secondaryKpi.display}</span>
          <span class="mo-tn-kpi-trend" data-mo-tn-sec-trend>{(t0.secondaryKpi as any).trendArrow === false ? "" : "↗ "}{t0.secondaryKpi.trend}</span>
        </div>
      </div>

      <div class="mo-tn-row">
        <span class="mo-tn-row-lbl">Subscriptions</span>
        <ul class="mo-tn-subs" data-mo-tn-subs>
          {t0.subs.map((s) => <li>{s}</li>)}
        </ul>
      </div>

      <div class="mo-tn-row">
        <span class="mo-tn-row-lbl">Flex fields</span>
        <ul class="mo-tn-flex" data-mo-tn-flex>
          {t0.flexFields.map((f) => <li>{f}</li>)}
        </ul>
      </div>

      <div class="mo-tn-row">
        <span class="mo-tn-row-lbl">Tags</span>
        <ul class="mo-tn-tags" data-mo-tn-tags>
          {t0.tags.map((tag) => <li>{tag}</li>)}
        </ul>
      </div>

      <div class="mo-tn-row mo-tn-row-activity">
        <span class="mo-tn-row-lbl">Recent activity</span>
        <ul class="mo-tn-activity" data-mo-tn-activity>
          {t0.activity.map((a) => <li>· {a}</li>)}
        </ul>
      </div>
    </div>
  </div>

  <p class="mo-tn-hint" data-mo-tn-hint aria-hidden="true">auto-cycling — pick any tenant to take over</p>
</div>

<script>
  type KPI = { label: string; n: number; display: string; trend: string };
  type Tenant = {
    id: string; name: string; tag: string;
    leadKpi: KPI; secondaryKpi: KPI;
    subs: string[]; flexFields: string[]; tags: string[]; activity: string[];
  };

  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  document.querySelectorAll<HTMLElement>("[data-mo-tn]").forEach((root) => {
    const dataEl = root.querySelector<HTMLScriptElement>("[data-mo-tn-data]");
    if (!dataEl?.textContent) return;
    let TENANTS: Tenant[];
    try { TENANTS = JSON.parse(dataEl.textContent); } catch { return; }
    if (!TENANTS.length) return;

    const opts = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-mo-tn-opt]"));
    const card = root.querySelector<HTMLElement>("[data-mo-tn-card]");
    const hint = root.querySelector<HTMLElement>("[data-mo-tn-hint]");
    if (!card) return;

    const $ = <T extends HTMLElement>(sel: string) => card.querySelector<T>(sel)!;
    const tName = $("[data-mo-tn-tname]");
    const tTag = $("[data-mo-tn-ttag]");
    const lead = $("[data-mo-tn-lead]");
    const leadLbl = $("[data-mo-tn-lead-lbl]");
    const leadN = $("[data-mo-tn-lead-n]");
    const leadTrend = $("[data-mo-tn-lead-trend]");
    const secLbl = $("[data-mo-tn-sec-lbl]");
    const secN = $("[data-mo-tn-sec-n]");
    const secTrend = $("[data-mo-tn-sec-trend]");
    const subsUl = $("[data-mo-tn-subs]");
    const flexUl = $("[data-mo-tn-flex]");
    const tagsUl = $("[data-mo-tn-tags]");
    const actUl = $("[data-mo-tn-activity]");

    let current = 0;
    let countRaf = 0;
    let countDone = 0;

    // Count the lead KPI up (or down) from its current value to the next.
    // Preserves a "$" prefix and integer formatting. A setTimeout guarantees
    // the final string lands even if rAF is throttled (headless preview).
    const countUp = (from: number, to: number, display: string, ms: number) => {
      window.cancelAnimationFrame(countRaf);
      window.clearTimeout(countDone);
      const dollar = display.trim().startsWith("$");
      const fmt = (v: number) => (dollar ? "$" : "") + Math.round(v).toLocaleString("en-US");
      if (reduce || from === to) { leadN.textContent = display; return; }
      const start = performance.now();
      const tick = (now: number) => {
        const t = Math.min(1, (now - start) / ms);
        const eased = 1 - Math.pow(1 - t, 3);
        leadN.textContent = fmt(from + (to - from) * eased);
        if (t < 1) countRaf = window.requestAnimationFrame(tick);
      };
      countRaf = window.requestAnimationFrame(tick);
      // Guarantee the exact final display string (commas, $, etc.).
      countDone = window.setTimeout(() => { leadN.textContent = display; }, ms + 140) as unknown as number;
    };

    const chips = (ul: HTMLElement, items: string[], prefix = "") => {
      ul.innerHTML = items.map((x) => `<li>${prefix}${x}</li>`).join("");
    };

    const render = (next: number, animate: boolean) => {
      const t = TENANTS[next];
      const prev = TENANTS[current];
      current = next;

      // picker state
      opts.forEach((b) => {
        const on = b.dataset.moTnOpt === t.id;
        b.classList.toggle("active", on);
        b.setAttribute("aria-selected", on ? "true" : "false");
      });

      // tenant id hook for accenting
      card.dataset.moTnCard = t.id;

      // The reshuffle pulse: a quick fade/lift on the body so the swap reads
      // as a physical re-deal rather than a flicker. Re-trigger by toggling.
      if (animate && !reduce) {
        card.classList.remove("mo-tn-shuffle");
        // force reflow so the animation restarts
        void card.offsetWidth;
        card.classList.add("mo-tn-shuffle");
      }

      // text / labels
      tName.textContent = t.name;
      tTag.textContent = t.tag;
      leadLbl.textContent = t.leadKpi.label;
      leadTrend.textContent = (t.leadKpi.trendArrow === false ? "" : "↗ ") + t.leadKpi.trend;
      secLbl.textContent = t.secondaryKpi.label;
      secN.textContent = t.secondaryKpi.display;
      secTrend.textContent = (t.secondaryKpi.trendArrow === false ? "" : "↗ ") + t.secondaryKpi.trend;

      // chips crossfade (CSS handles the fade-in via the shuffle keyframe)
      chips(subsUl, t.subs);
      chips(flexUl, t.flexFields);
      chips(tagsUl, t.tags);
      chips(actUl, t.activity, "· ");

      // lead KPI counts from old to new
      const from = animate ? prev.leadKpi.n : t.leadKpi.n;
      leadN.dataset.moTnN = String(t.leadKpi.n);
      countUp(from, t.leadKpi.n, t.leadKpi.display, 720);
    };

    // ── auto-cycle ──────────────────────────────────────────────────────
    // Ambient loop that proves the concept before the reader names it. Driven
    // by setTimeout (NOT setInterval) so each step is independent and the
    // final value always lands; pauses permanently on first interaction.
    let cycleTimer = 0;
    let cycling = !reduce;

    const stopCycle = (userInitiated: boolean) => {
      if (!cycling && !userInitiated) return;
      cycling = false;
      window.clearTimeout(cycleTimer);
      root.classList.add("mo-tn-took-over");
      if (hint) hint.textContent = "you're driving — pick any tenant";
    };

    const step = () => {
      if (!cycling) return;
      const next = (current + 1) % TENANTS.length;
      render(next, true);
      cycleTimer = window.setTimeout(step, 2600) as unknown as number;
    };

    // user interaction → switch + kill the loop. Re-clicking the shown tenant
    // still re-pulses (render always animates on a direct handler).
    opts.forEach((o, i) => {
      o.addEventListener("click", () => { stopCycle(true); render(i, true); });
      o.addEventListener("focus", () => { if (cycling) stopCycle(true); });
    });

    // Pause the cycle if the reader hovers the card itself (intent to read).
    card.addEventListener("mouseenter", () => stopCycle(true));

    // Kick the loop off only when the demo scrolls into view, and only the
    // first time. Gate via IntersectionObserver so it doesn't burn cycles
    // off-screen.
    if (cycling && "IntersectionObserver" in window) {
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            io.disconnect();
            if (cycling) cycleTimer = window.setTimeout(step, 2200) as unknown as number;
          }
        }
      }, { threshold: 0.4 });
      io.observe(root);
    } else if (cycling) {
      // No IO support — just start.
      cycleTimer = window.setTimeout(step, 2200) as unknown as number;
    }

    if (reduce && hint) hint.textContent = "pick a tenant to reshuffle the profile";
  });
</script>

<style>
  .mo-tn { display: grid; gap: 22px; }

  /* picker ─────────────────────────────────────────────────────────────── */
  .mo-tn-picker {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
  }
  @media (max-width: 880px) {
    .mo-tn-picker { grid-template-columns: 1fr 1fr; }
  }
  .mo-tn-opt {
    position: relative;
    text-align: left;
    background: rgba(245, 241, 232, 0.02);
    border: 1px solid var(--cs-line);
    border-radius: 4px;
    padding: 12px 14px 14px;
    cursor: pointer;
    transition: border-color 160ms ease, background 160ms ease;
    display: grid;
    gap: 4px;
    overflow: hidden;
  }
  .mo-tn-opt:hover {
    border-color: var(--cs-line-strong);
    background: rgba(245, 241, 232, 0.04);
  }
  .mo-tn-opt.active {
    border-color: var(--brand-orange);
    background: rgba(255, 90, 60, 0.06);
  }
  .mo-tn-opt-name {
    font-family: var(--cs-mono);
    font-style: italic;
    font-weight: 700;
    font-size: 14px;
    color: var(--cs-text);
  }
  .mo-tn-opt.active .mo-tn-opt-name { color: var(--brand-orange); }
  .mo-tn-opt-tag {
    font-size: 11.5px;
    color: rgba(245, 241, 232, 0.55);
    line-height: 1.3;
  }
  /* the under-bar fills while a tenant is the active auto-cycle slot, like a
     slideshow timer. Only animates during the ambient loop. */
  .mo-tn-opt-bar {
    position: absolute;
    left: 0; bottom: 0;
    height: 2px;
    width: 100%;
    transform: scaleX(0);
    transform-origin: left;
    background: var(--brand-grad);
    opacity: 0;
  }
  .mo-tn:not(.mo-tn-took-over) .mo-tn-opt.active .mo-tn-opt-bar {
    opacity: 1;
    animation: mo-tn-bar 2600ms linear forwards;
  }
  @keyframes mo-tn-bar {
    from { transform: scaleX(0); }
    to   { transform: scaleX(1); }
  }

  /* stage ──────────────────────────────────────────────────────────────── */
  .mo-tn-stage {
    display: grid;
    grid-template-columns: minmax(220px, 280px) minmax(0, 1fr);
    gap: 24px;
    align-items: start;
    position: relative;
  }
  @media (max-width: 880px) {
    .mo-tn-stage { grid-template-columns: 1fr; }
  }

  /* schema rail */
  .mo-tn-schema {
    background: rgba(14, 196, 252, 0.03);
    border: 1px dashed rgba(14, 196, 252, 0.30);
    border-radius: 4px;
    padding: 16px 18px;
  }
  .mo-tn-rail-lbl {
    display: block;
    font-family: var(--cs-mono);
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--brand-cyan);
    margin-bottom: 12px;
  }
  .mo-tn-schema ul { list-style: none; padding: 0; margin: 0 0 14px; display: grid; gap: 8px; }
  .mo-tn-schema li {
    padding: 8px 10px;
    background: rgba(245, 241, 232, 0.03);
    border: 1px solid var(--cs-line);
    border-radius: 3px;
    display: grid;
    gap: 2px;
  }
  .mo-tn-cat-name {
    font-family: var(--cs-mono);
    font-style: italic;
    font-weight: 700;
    font-size: 12.5px;
    color: var(--cs-text);
  }
  .mo-tn-cat-desc { font-size: 11px; color: rgba(245, 241, 232, 0.55); line-height: 1.4; }
  .mo-tn-rail-foot {
    font-family: var(--cs-mono);
    font-style: italic;
    font-size: 11.5px;
    color: rgba(245, 241, 232, 0.55);
    margin: 0;
    line-height: 1.5;
    max-width: none !important;
  }

  /* customer card ──────────────────────────────────────────────────────── */
  .mo-tn-card {
    background: #fff;
    color: #1c1c1e;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 24px 60px -30px rgba(0,0,0,0.7), 0 0 0 1px rgba(245, 241, 232, 0.06);
    font-family: "Geist Variable", ui-sans-serif, system-ui, sans-serif;
  }

  .mo-tn-card-head {
    background: #2e2e35;
    color: #f5f5f7;
    padding: 16px 18px;
    display: flex;
    gap: 14px;
    align-items: center;
  }
  .mo-tn-avatar {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #1c1c1e;
    display: grid;
    place-items: center;
    font-weight: 700;
    color: #fff;
    font-size: 18px;
    flex: 0 0 auto;
  }
  .mo-tn-card-name {
    font-size: 22px;
    font-weight: 800;
    margin: 0 0 2px;
  }
  .mo-tn-card-meta {
    font-size: 12px;
    color: rgba(245, 245, 247, 0.62);
    margin: 0 0 2px;
  }
  .mo-tn-on { color: #4ade80; }
  .mo-tn-card-tenant {
    font-size: 11.5px;
    color: rgba(245, 245, 247, 0.62);
    margin: 0;
    font-style: italic;
  }
  .mo-tn-card-tenant strong {
    color: #fbbf24; font-style: normal; font-weight: 700;
    transition: color 200ms ease;
  }

  .mo-tn-kpis {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    padding: 16px 18px 8px;
    background: #fafafa;
  }
  .mo-tn-kpi {
    background: #fff;
    border-radius: 8px;
    padding: 12px 14px;
    box-shadow: 0 1px 0 rgba(0,0,0,0.04), 0 4px 18px -10px rgba(0,0,0,0.10);
    display: grid;
    gap: 2px;
    /* the lead-card promotion reads as a settle; border + shadow ease too */
    transition: border-color 280ms ease, box-shadow 280ms ease;
  }
  .mo-tn-kpi-lead {
    border: 1.5px solid #7c3aed;
    box-shadow: 0 1px 0 rgba(0,0,0,0.04), 0 8px 20px -10px rgba(124, 58, 237, 0.32);
  }
  .mo-tn-kpi-lbl { font-size: 11px; color: #555; }
  .mo-tn-kpi-n {
    font-size: 22px; font-weight: 800; color: #1c1c1e;
    font-variant-numeric: tabular-nums;
    font-feature-settings: "tnum";
  }
  .mo-tn-kpi-trend { font-size: 11px; color: #7c3aed; font-weight: 700; }

  .mo-tn-row {
    padding: 12px 18px;
    border-top: 1px solid #f0f0f0;
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 12px;
    align-items: start;
    background: #fff;
  }
  .mo-tn-row-lbl {
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #888;
    padding-top: 2px;
  }
  .mo-tn-subs, .mo-tn-flex, .mo-tn-tags, .mo-tn-activity {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .mo-tn-activity { flex-direction: column; gap: 4px; }
  .mo-tn-subs li {
    font-size: 11.5px;
    padding: 3px 8px;
    border-radius: 3px;
    background: #ede9fe;
    color: #5b21b6;
    font-weight: 600;
  }
  .mo-tn-flex li {
    font-size: 11.5px;
    padding: 3px 8px;
    border-radius: 3px;
    background: #fef3c7;
    color: #92400e;
    font-weight: 600;
  }
  .mo-tn-tags li {
    font-size: 11.5px;
    padding: 3px 8px;
    border-radius: 3px;
    background: #f1f5f9;
    color: #475569;
    font-weight: 600;
  }
  .mo-tn-activity li {
    font-family: var(--cs-mono);
    font-size: 11.5px;
    color: #1c1c1e;
    line-height: 1.5;
  }
  .mo-tn-row-activity { padding-bottom: 18px; }

  /* the reshuffle pulse ────────────────────────────────────────────────── */
  /* On switch we add .mo-tn-shuffle for one run. The KPI band lifts/settles
