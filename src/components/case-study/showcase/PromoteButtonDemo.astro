---
// Live promote-to-Live pipeline. Renders a fragment of a loops-bucket
// BucketCard with a real PROMOTE TO LIVE button. Clicking runs the
// three-step animation (copy → loudnorm → set live_loop_path), then
// flips the button to ✓ IN LIVE. A small reset link re-runs the demo.
//
// The animation timing approximates the real engine's sub-second-per-loop
// behavior on M1 — the loudnorm pass is the slowest of the three.
---

<div class="pb-stage" data-pb-stage>
  <div class="pb-card">
    <div class="pb-card-head">
      <h4 class="pb-card-title">55_Cmaj_0_what_you_know<span class="pb-card-ext">.wav</span></h4>
      <span class="pb-bucket">LOOPS</span>
    </div>

    <div class="pb-wave" aria-hidden="true">
      {Array.from({ length: 84 }).map((_, i) => {
        const h = 36 + Math.round(36 * Math.sin(i * 0.35) + 22 * Math.cos(i * 0.61));
        return <span class="pb-bar" style={`height:${Math.max(18, Math.min(94, h))}%`}></span>;
      })}
    </div>

    <div class="pb-tech">
      <span class="pb-tech-lbl">TECH</span>
      <span class="pb-bpm">55</span><span class="pb-bpm-u">BPM</span>
      <span class="pb-sep">·</span>
      <span class="pb-key">C</span><span class="pb-key-mode">major</span>
      <span class="pb-sep">·</span>
      <span class="pb-dur">0:08</span>
    </div>

    <div class="pb-live-row">
      <span class="pb-live-lbl">LIVE</span>
      <div class="pb-live-action">
        <button type="button" class="pb-promote" data-pb-promote>→ Promote to Live</button>
        <span class="pb-in-live" data-pb-in-live hidden>✓ In Live</span>
        <button type="button" class="pb-reset" data-pb-reset hidden>↻ run again</button>
      </div>
    </div>

    <div class="pb-pipeline" data-pb-pipeline hidden>
      <ol class="pb-steps">
        <li data-pb-step="copy">
          <span class="pb-step-glyph">①</span>
          <span class="pb-step-cmd"><span class="pb-cmd-key">cp</span> source.wav → _Soundbending/loops/55_Cmaj_0_what_you_know.wav</span>
          <span class="pb-step-state">…</span>
        </li>
        <li data-pb-step="loudnorm">
          <span class="pb-step-glyph">②</span>
          <span class="pb-step-cmd"><span class="pb-cmd-key">ffmpeg</span> -af loudnorm=I=-14:TP=-1.5:LRA=11 -ar 44100 -c:a pcm_s16le -f wav</span>
          <span class="pb-step-state">…</span>
        </li>
        <li data-pb-step="db">
          <span class="pb-step-glyph">③</span>
          <span class="pb-step-cmd"><span class="pb-cmd-key">UPDATE</span> assets SET live_loop_path = '/Users/jontollefson/...';</span>
          <span class="pb-step-state">…</span>
        </li>
      </ol>
      <div class="pb-progress-track" aria-hidden="true">
        <div class="pb-progress-fill" data-pb-progress></div>
      </div>
      <p class="pb-meta" data-pb-meta>idle</p>
    </div>
  </div>

  <div class="pb-aside">
    <h4>Three steps. Sub-second per loop.</h4>
    <p>The promote pipeline runs synchronously on the M1 the moment you click. Each step writes real state. Re-promoting is idempotent — the file overwrites in place, the LUFS pass re-runs, the column gets the same path.</p>
    <p class="pb-aside-meta">First three loops landed in <code>_Soundbending/loops/</code> on 2026-05-17 evening. The Ableton Browser Place was set up once. After that, every promoted loop appears in Live's own sidebar.</p>
  </div>
</div>

<script>
  const stage = document.querySelector<HTMLElement>("[data-pb-stage]");
  const promoteBtn = stage?.querySelector<HTMLButtonElement>("[data-pb-promote]");
  const inLive = stage?.querySelector<HTMLElement>("[data-pb-in-live]");
  const resetBtn = stage?.querySelector<HTMLButtonElement>("[data-pb-reset]");
  const pipeline = stage?.querySelector<HTMLElement>("[data-pb-pipeline]");
  const progress = stage?.querySelector<HTMLElement>("[data-pb-progress]");
  const meta = stage?.querySelector<HTMLElement>("[data-pb-meta]");
  const steps = stage?.querySelectorAll<HTMLElement>("[data-pb-step]") ?? [];

  type Phase = { key: string; label: string; end: number; ms: number };
  const PHASES: Phase[] = [
    { key: "copy", label: "copy source → loops/", end: 18, ms: 320 },
    { key: "loudnorm", label: "ffmpeg loudnorm -14 LUFS", end: 86, ms: 1200 },
    { key: "db", label: "UPDATE assets.live_loop_path", end: 100, ms: 280 },
  ];

  let running = false;

  const setStep = (key: string, state: "pending" | "running" | "done") => {
    steps.forEach((li) => {
      if (li.dataset.pbStep === key) {
        li.dataset.state = state;
        const s = li.querySelector<HTMLElement>(".pb-step-state");
        if (s) {
          s.textContent = state === "done" ? "✓" : state === "running" ? "…" : "·";
        }
      }
    });
  };

  const setProgress = (pct: number) => {
    if (progress) progress.style.width = `${pct}%`;
  };

  const sleep = (ms: number) => new Promise<void>((r) => window.setTimeout(r, ms));

  const animate = async (from: number, to: number, ms: number) => {
    const start = performance.now();
    return new Promise<void>((resolve) => {
      const tick = () => {
        const t = Math.min(1, (performance.now() - start) / ms);
        const eased = 1 - Math.pow(1 - t, 3);
        setProgress(from + (to - from) * eased);
        if (t < 1) requestAnimationFrame(tick);
        else resolve();
      };
      requestAnimationFrame(tick);
    });
  };

  const run = async () => {
    if (running) return;
    running = true;
    promoteBtn?.setAttribute("hidden", "");
    resetBtn?.setAttribute("hidden", "");
    inLive?.setAttribute("hidden", "");
    pipeline?.removeAttribute("hidden");
    setProgress(0);
    steps.forEach((li) => { li.dataset.state = "pending"; const s = li.querySelector(".pb-step-state"); if (s) s.textContent = "·"; });
    if (meta) meta.textContent = "starting…";

    let prev = 0;
    for (const p of PHASES) {
      setStep(p.key, "running");
      if (meta) meta.textContent = p.label;
      await animate(prev, p.end, p.ms);
      setStep(p.key, "done");
      prev = p.end;
      await sleep(120);
    }

    if (meta) meta.textContent = "live_loop_path = /Users/jontollefson/Library/Mobile Documents/com~apple~CloudDocs/_Soundbending/loops/55_Cmaj_0_what_you_know.wav";

    await sleep(380);
    inLive?.removeAttribute("hidden");
    resetBtn?.removeAttribute("hidden");
    running = false;
  };

  const reset = () => {
    if (running) return;
    setProgress(0);
    pipeline?.setAttribute("hidden", "");
    inLive?.setAttribute("hidden", "");
    resetBtn?.setAttribute("hidden", "");
    promoteBtn?.removeAttribute("hidden");
    if (meta) meta.textContent = "idle";
    steps.forEach((li) => { delete li.dataset.state; const s = li.querySelector(".pb-step-state"); if (s) s.textContent = "·"; });
  };

  promoteBtn?.addEventListener("click", run);
  resetBtn?.addEventListener("click", reset);
</script>

<style>
  .pb-stage {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(280px, 1fr);
    gap: 32px;
    align-items: start;
  }
  @media (max-width: 880px) {
    .pb-stage { grid-template-columns: 1fr; }
  }

  .pb-card {
    background: rgba(15, 10, 18, 0.94);
    border: 1px solid rgba(245, 241, 232, 0.10);
    border-radius: 8px;
    padding: 22px 24px;
    color: #f5f1e8;
    font-family: "Geist Variable", ui-sans-serif, system-ui, sans-serif;
    box-shadow: 0 24px 60px -30px rgba(0,0,0,0.7);
  }

  .pb-card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 14px;
  }
  .pb-card-title {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-style: italic;
    font-size: 16px;
    font-weight: 700;
    color: #00ff4d;
    background: rgba(0, 255, 77, 0.04);
    border: 1px solid rgba(0, 255, 77, 0.32);
    border-radius: 4px;
    padding: 5px 10px;
    margin: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    min-width: 0;
    box-shadow: 0 0 12px rgba(0, 255, 77, 0.12);
  }
  .pb-card-ext { opacity: 0.42; font-style: italic; font-weight: 500; font-size: 0.7em; color: #f5f1e8; }
  .pb-bucket {
    flex: 0 0 auto;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 9px;
    letter-spacing: 0.22em;
    color: #ff2761;
    background: rgba(255, 39, 97, 0.10);
    border: 1px solid rgba(255, 39, 97, 0.45);
    border-radius: 2px;
    padding: 4px 8px;
  }

  .pb-wave {
    height: 56px;
    background: #07060c;
    border-radius: 3px;
    overflow: hidden;
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 0 8px;
    margin-bottom: 14px;
  }
  .pb-bar {
    flex: 1 1 0;
    background: linear-gradient(180deg, rgba(14, 196, 252, 0.7) 0%, rgba(14, 196, 252, 0.32) 100%);
    border-radius: 1px;
  }

  .pb-tech,
  .pb-live-row {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 12px;
    margin-bottom: 10px;
  }
  .pb-tech-lbl,
  .pb-live-lbl {
    flex: 0 0 56px;
    font-size: 9px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(14, 196, 252, 0.78);
  }
  .pb-bpm,
  .pb-key,
  .pb-dur {
    font-style: italic;
    font-weight: 700;
    color: #0ec4fc;
  }
  .pb-bpm-u,
  .pb-key-mode {
    font-style: italic;
    color: rgba(245, 241, 232, 0.55);
  }
  .pb-sep { color: rgba(245, 241, 232, 0.32); }

  .pb-live-action {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .pb-promote {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-style: italic;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: #0e0c14;
    background: linear-gradient(90deg, #ff2761 0%, #ff5a3c 50%, #ffb347 100%);
    border: 0;
    border-radius: 4px;
    padding: 10px 18px;
    cursor: pointer;
    transition: filter 160ms ease, transform 80ms ease, box-shadow 160ms ease;
    box-shadow: 0 0 0 0 rgba(255, 90, 60, 0.0);
  }
  .pb-promote:hover {
    filter: brightness(1.08);
    box-shadow: 0 0 0 3px rgba(255, 90, 60, 0.16);
  }
  .pb-promote:active { transform: translateY(1px); }
  .pb-in-live[hidden],
  .pb-reset[hidden],
  .pb-pipeline[hidden],
  .pb-promote[hidden] {
    display: none !important;
  }
  .pb-in-live {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-style: italic;
    font-size: 13px;
    font-weight: 700;
    color: #00ff4d;
    background: rgba(0, 255, 77, 0.08);
    border: 1px solid rgba(0, 255, 77, 0.45);
    border-radius: 3px;
    padding: 7px 12px;
    box-shadow: 0 0 18px rgba(0, 255, 77, 0.22);
    animation: pb-flash 540ms ease-out;
  }
  @keyframes pb-flash {
    0% { transform: scale(0.96); opacity: 0; }
    60% { transform: scale(1.04); opacity: 1; box-shadow: 0 0 32px rgba(0, 255, 77, 0.45); }
    100% { transform: scale(1); opacity: 1; box-shadow: 0 0 18px rgba(0, 255, 77, 0.22); }
  }
  .pb-reset {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11px;
    letter-spacing: 0.06em;
    color: rgba(245, 241, 232, 0.55);
    background: transparent;
    border: 0;
    border-bottom: 1px dotted rgba(245, 241, 232, 0.32);
    padding: 0 0 1px 0;
    cursor: pointer;
  }
  .pb-reset:hover { color: #f5f1e8; border-color: #0ec4fc; }

  .pb-pipeline {
    margin-top: 18px;
    padding: 16px 14px 12px;
    border: 1px solid rgba(14, 196, 252, 0.28);
    border-radius: 4px;
    background: rgba(14, 196, 252, 0.03);
  }
  .pb-steps {
    list-style: none;
    padding: 0;
    margin: 0 0 14px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .pb-steps li {
    display: grid;
    grid-template-columns: 24px 1fr 22px;
    align-items: center;
    gap: 10px;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11.5px;
    color: rgba(245, 241, 232, 0.45);
    transition: color 200ms ease;
  }
  .pb-step-glyph { text-align: center; opacity: 0.55; }
  .pb-step-cmd { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .pb-cmd-key { color: #0ec4fc; font-weight: 700; margin-right: 4px; }
  .pb-step-state {
    text-align: center;
    color: rgba(245, 241, 232, 0.32);
    font-weight: 700;
  }
  .pb-steps li[data-state="running"] {
    color: #f5f1e8;
  }
  .pb-steps li[data-state="running"] .pb-step-glyph {
    color: var(--brand-orange);
    opacity: 1;
  }
  .pb-steps li[data-state="running"] .pb-step-state {
    color: var(--brand-orange);
    animation: pb-blink 0.8s ease-in-out infinite alternate;
  }
  @keyframes pb-blink {
    from { opacity: 0.4; }
    to { opacity: 1; }
  }
  .pb-steps li[data-state="done"] {
    color: rgba(245, 241, 232, 0.85);
  }
  .pb-steps li[data-state="done"] .pb-step-glyph { color: #00ff4d; opacity: 1; }
  .pb-steps li[data-state="done"] .pb-step-state { color: #00ff4d; }

  .pb-progress-track {
    height: 4px;
    background: rgba(245, 241, 232, 0.08);
    border-radius: 2px;
    overflow: hidden;
  }
  .pb-progress-fill {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, #ff2761 0%, #ff5a3c 50%, #ffb347 100%);
    transition: width 80ms linear;
  }
  .pb-meta {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11px;
    color: rgba(245, 241, 232, 0.55);
    margin: 10px 0 0;
    line-height: 1.4;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .pb-aside {
    padding-top: 8px;
  }
  .pb-aside h4 {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-style: italic;
    font-size: 20px;
    font-weight: 700;
    line-height: 1.15;
    margin: 0 0 12px;
    color: #f5f1e8;
  }
  .pb-aside p {
    font-size: 15px;
    color: rgba(245, 241, 232, 0.82);
    margin: 0 0 12px;
    line-height: 1.55;
  }
  .pb-aside-meta {
    font-size: 13px !important;
    color: rgba(245, 241, 232, 0.55) !important;
  }
  .pb-aside code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.88em;
    background: rgba(14, 196, 252, 0.08);
    color: var(--brand-cyan);
    border: 1px solid rgba(14, 196, 252, 0.18);
    border-radius: 3px;
    padding: 1px 5px;
  }
</style>
