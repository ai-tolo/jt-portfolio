---
// Inline replacement for the comprehension-surface PNG.
//
// Two columns (Tool capability ↔ Audience reach) with a small dot at
// the foot of each. Three dotted feeders descend into a brand-gradient
// "Comprehension surface" box that names the four interaction patterns
// the design work produced.
//
// No arrows, no signed PNG — pure HTML/CSS, themes with the page.

const CAPABILITY = [
  "vector embeddings",
  "RAG pipelines",
  "function calling",
  "custom models on internal data",
  "prompt engineering",
  "multi-step agents",
];

const REACH = [
  "“what does this do for me?”",
  "“is this different from GPT?”",
  "“where do I start?”",
  "“how do I add my data?”",
  "“what’s a knowledge base?”",
  "“can it just do the thing?”",
];

const SURFACE_ITEMS = [
  "task-flow docs",
  "starter templates",
  "differentiation messaging",
  "dogfooded docs-chat",
];
---

<figure class="comp-surface" aria-labelledby="comp-surface-title">
  <header class="comp-surface-head">
    <p class="comp-surface-eyebrow">THE DESIGN PROBLEM IN ONE PICTURE</p>
    <h3 id="comp-surface-title" class="comp-surface-title">The comprehension surface</h3>
  </header>

  <div class="comp-surface-grid">
    <div class="comp-surface-col comp-surface-cap">
      <span class="comp-surface-col-lbl">TOOL CAPABILITY</span>
      <p class="comp-surface-col-sub">what the platform can do</p>
      <ul class="comp-surface-list">
        {CAPABILITY.map((c) => <li>{c}</li>)}
      </ul>
      <span class="comp-surface-anchor" aria-hidden="true"></span>
    </div>

    <div class="comp-surface-col comp-surface-aud">
      <span class="comp-surface-col-lbl">AUDIENCE REACH</span>
      <p class="comp-surface-col-sub">what a non-technical user can grasp</p>
      <ul class="comp-surface-list">
        {REACH.map((q) => <li>{q}</li>)}
      </ul>
      <span class="comp-surface-anchor" aria-hidden="true"></span>
    </div>

    <div class="comp-surface-feeders" aria-hidden="true">
      <span class="comp-surface-feeder feeder-l"></span>
      <span class="comp-surface-feeder feeder-r"></span>
    </div>

    <div class="comp-surface-box">
      <span class="comp-surface-box-anchor" aria-hidden="true"></span>
      <span class="comp-surface-box-lbl">COMPREHENSION SURFACE</span>
      <ul class="comp-surface-box-items">
        {SURFACE_ITEMS.map((s) => <li>{s}</li>)}
      </ul>
    </div>
  </div>

  <figcaption class="comp-surface-foot">Where senior UX earns its keep</figcaption>
</figure>

<style>
  .comp-surface {
    margin: 0;
    padding: 32px clamp(20px, 4vw, 48px);
    background:
      radial-gradient(80% 60% at 50% 0%, rgba(255, 90, 60, 0.08) 0%, transparent 70%),
      #07060c;
    border: 1px solid var(--cs-line);
    border-radius: 6px;
  }

  .comp-surface-head {
    margin-bottom: 28px;
  }
  .comp-surface-eyebrow {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11px;
    letter-spacing: 0.22em;
    color: rgba(245, 241, 232, 0.45);
    margin: 0 0 6px;
  }
  .comp-surface-title {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-style: italic;
    font-size: clamp(20px, 2.4vw, 26px);
    font-weight: 700;
    color: var(--cs-text);
    margin: 0;
    border-bottom: 2px solid var(--brand-orange);
    padding-bottom: 6px;
    display: inline-block;
  }

  .comp-surface-grid {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: auto auto auto;
    gap: 64px 32px;
    align-items: start;
  }
  @media (max-width: 720px) {
    .comp-surface-grid { grid-template-columns: 1fr; gap: 36px; }
  }

  .comp-surface-col {
    position: relative;
  }
  .comp-surface-col-lbl {
    display: block;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11px;
    letter-spacing: 0.22em;
    margin-bottom: 4px;
    color: var(--brand-cyan);
  }
  .comp-surface-aud .comp-surface-col-lbl { color: var(--brand-orange); }
  .comp-surface-col-sub {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-style: italic;
    font-size: 12px;
    color: rgba(245, 241, 232, 0.55);
    margin: 0 0 12px;
    max-width: none !important;
  }
  .comp-surface-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 6px;
  }
  .comp-surface-list li {
    font-size: 14.5px;
    line-height: 1.5;
    color: rgba(245, 241, 232, 0.85);
    padding-left: 16px;
    position: relative;
  }
  .comp-surface-list li::before {
    content: "·";
    position: absolute;
    left: 0;
    color: rgba(245, 241, 232, 0.45);
    font-weight: 700;
  }
  .comp-surface-aud .comp-surface-list li {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 13.5px;
  }

  /* Anchor dots at the foot of each column. */
  .comp-surface-anchor {
    position: absolute;
    bottom: -22px;
    left: 50%;
    transform: translateX(-50%);
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--brand-cyan);
    box-shadow: 0 0 8px var(--brand-cyan);
  }
  .comp-surface-aud .comp-surface-anchor {
    background: var(--brand-orange);
    box-shadow: 0 0 8px var(--brand-orange);
  }

  /* Feeders: two dotted lines descend from the column dots into the
     surface box. */
  .comp-surface-feeders {
    grid-column: 1 / -1;
    position: relative;
    height: 28px;
    pointer-events: none;
  }
  .comp-surface-feeder {
    position: absolute;
    top: -22px;
    bottom: 4px;
    width: 0;
    border-left: 1px dotted rgba(245, 241, 232, 0.32);
  }
  .feeder-l {
    left: 25%;
  }
  .feeder-r {
    right: 25%;
    border-color: rgba(255, 90, 60, 0.45);
  }
  @media (max-width: 720px) {
    .comp-surface-feeders { display: none; }
  }

  /* Surface box */
  .comp-surface-box {
    grid-column: 1 / -1;
    position: relative;
    text-align: center;
    background: rgba(255, 90, 60, 0.06);
    border: 1px solid rgba(255, 90, 60, 0.42);
    border-radius: 4px;
    padding: 18px 24px;
  }
  .comp-surface-box-anchor {
    position: absolute;
    top: -6px;
    left: 50%;
    transform: translateX(-50%);
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--brand-orange);
    box-shadow: 0 0 12px var(--brand-orange);
  }
  .comp-surface-box-lbl {
    display: block;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11px;
    letter-spacing: 0.22em;
    color: var(--brand-orange);
    font-weight: 700;
    margin-bottom: 8px;
  }
  .comp-surface-box-items {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4px 14px;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 13px;
    color: var(--cs-text);
  }
  .comp-surface-box-items li {
    position: relative;
    padding-right: 14px;
  }
  .comp-surface-box-items li:not(:last-child)::after {
    content: "·";
    position: absolute;
    right: 0;
    color: rgba(245, 241, 232, 0.32);
  }

  .comp-surface-foot {
    margin-top: 14px;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11px;
    letter-spacing: 0.18em;
    color: rgba(245, 241, 232, 0.45);
    text-transform: uppercase;
  }
</style>
