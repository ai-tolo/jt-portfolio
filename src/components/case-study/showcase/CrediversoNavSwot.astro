---
// The V1 nav-bar SWOT, interactive. Two defensible options: Split (a
// dedicated Family tab) and Combined (a single Accounts surface). Click
// either to see its mock home screen, its SWOT, and the tap-count for the
// Garcia Family use case (Juan sends $200 to his cousin).
//
// The "what tipped it" panel reveals after either is selected. The
// resolution is not "best UX" — it's "which option reinforces the
// product's identity." That tiebreaker is the case study's whole spine.

const SCENARIO_TAPS = {
  split: [
    "Open app · 1",
    "Tap Family tab · 2",
    "Tap Garcia Family · 3",
    "Tap Move money · 4",
    "Tap cousin · 5",
    "Enter $200 · 6",
    "Confirm · 7",
  ],
  combined: [
    "Open app · 1",
    "Tap Move money · 2",
    "Tap Garcia → cousin · 3",
    "Enter $200 · 4",
    "Confirm · 5",
  ],
};

const SWOT = {
  split: {
    s: ["Single-user clarity on the home screen", "Family feature visible in all UI previews", "Easy to implement page-specific features"],
    w: ["Lacks a dedicated Move-money page", "25% of menu nav irrelevant for single-user", "Primary accounts compete for clarity"],
    o: ["Family page → primary onboarding for new household members"],
    t: ["Buries the family thesis behind a tab"],
  },
  combined: {
    s: ["Accounts is all-inclusive", "Family accounts visible on the same page as primary", "Lots of info on the home page"],
    w: ["Higher screen density", "Move-money becomes its own action surface"],
    o: ["Develops an intuitive UI muscle other partner products inherit"],
    t: ["Requires careful UI lift to avoid feeling cluttered"],
  },
};
---

<div class="cv-swot" data-cv-swot>
  <div class="cv-swot-picker" role="tablist" aria-label="Pick a nav model">
    <button type="button" class="cv-swot-opt active" role="tab" data-cv-swot-opt="split" aria-selected="true">
      <span class="cv-swot-opt-glyph" aria-hidden="true">
        <span class="cv-swot-tab"></span>
        <span class="cv-swot-tab"></span>
      </span>
      <span class="cv-swot-opt-name">Split</span>
      <span class="cv-swot-opt-blurb">Dedicated Family tab, single-user home.</span>
    </button>
    <button type="button" class="cv-swot-opt" role="tab" data-cv-swot-opt="combined" aria-selected="false">
      <span class="cv-swot-opt-glyph" aria-hidden="true">
        <span class="cv-swot-tab cv-swot-tab-wide"></span>
      </span>
      <span class="cv-swot-opt-name">Combined</span>
      <span class="cv-swot-opt-blurb">One Accounts surface, family on the home screen.</span>
    </button>
  </div>

  <div class="cv-swot-stage">
    {/* SPLIT PANE */}
    <div class="cv-swot-pane active" data-cv-swot-pane="split">
      <div class="cv-swot-phone">
        <div class="cv-swot-phone-head">
          <span class="cv-swot-bar"></span>
        </div>
        <div class="cv-swot-phone-body">
          <p class="cv-swot-screen-title">Juan's Account</p>
          <p class="cv-swot-screen-num">$3,450.76 <span class="cv-swot-screen-mask">····1234</span></p>
          <ul class="cv-swot-screen-tx">
            <li><span>Netflix sub</span><span>−$12.01</span></li>
            <li><span>Macy's</span><span>−$32.99</span></li>
            <li><span>Amazon</span><span>−$18.07</span></li>
            <li class="pos"><span>ACH payment</span><span>+$1,200.07</span></li>
          </ul>
          <p class="cv-swot-screen-hint">family lives one tab away →</p>
        </div>
        <div class="cv-swot-phone-tabs">
          <span class="cv-swot-phone-tab on">Account</span>
          <span class="cv-swot-phone-tab">Family</span>
          <span class="cv-swot-phone-tab">ATM Map</span>
          <span class="cv-swot-phone-tab">More</span>
        </div>
      </div>

      <div class="cv-swot-side">
        <div class="cv-swot-block">
          <span class="cv-swot-block-lbl">Strengths · S</span>
          <ul>{SWOT.split.s.map((t) => <li>{t}</li>)}</ul>
        </div>
        <div class="cv-swot-block">
          <span class="cv-swot-block-lbl cv-swot-w">Weaknesses · W</span>
          <ul>{SWOT.split.w.map((t) => <li>{t}</li>)}</ul>
        </div>
        <div class="cv-swot-block cv-swot-half">
          <span class="cv-swot-block-lbl cv-swot-o">Opp. · O</span>
          <ul>{SWOT.split.o.map((t) => <li>{t}</li>)}</ul>
        </div>
        <div class="cv-swot-block cv-swot-half">
          <span class="cv-swot-block-lbl cv-swot-t">Threats · T</span>
          <ul>{SWOT.split.t.map((t) => <li>{t}</li>)}</ul>
        </div>
      </div>
    </div>

    {/* COMBINED PANE */}
    <div class="cv-swot-pane" data-cv-swot-pane="combined">
      <div class="cv-swot-phone">
        <div class="cv-swot-phone-head">
          <span class="cv-swot-bar"></span>
        </div>
        <div class="cv-swot-phone-body">
          <p class="cv-swot-screen-title">Hi, Juan.</p>
          <p class="cv-swot-screen-num">$3,450.76 <span class="cv-swot-screen-mask">····1234</span></p>
          <ul class="cv-swot-screen-tx">
            <li><span>Netflix sub</span><span>−$12.01</span></li>
            <li class="pos"><span>ACH payment</span><span>+$1,200.07</span></li>
          </ul>
          <p class="cv-swot-screen-subtitle">Family</p>
          <div class="cv-swot-fam">
            <div class="cv-swot-fam-card">
              <span class="cv-swot-fam-name">Garcia Family</span>
              <span class="cv-swot-fam-amt">$5,000.00</span>
              <span class="cv-swot-fam-avatars">👤👤👤 4 members</span>
            </div>
            <div class="cv-swot-fam-card alt">
              <span class="cv-swot-fam-name">College Buddies</span>
              <span class="cv-swot-fam-amt">$2,000.00</span>
              <span class="cv-swot-fam-avatars">👤👤 3 members</span>
            </div>
          </div>
        </div>
        <div class="cv-swot-phone-tabs">
          <span class="cv-swot-phone-tab on">Accounts</span>
          <span class="cv-swot-phone-tab cv-swot-phone-tab-move">Move Money</span>
          <span class="cv-swot-phone-tab">ATM Map</span>
          <span class="cv-swot-phone-tab">More</span>
        </div>
      </div>

      <div class="cv-swot-side">
        <div class="cv-swot-block">
          <span class="cv-swot-block-lbl">Strengths · S</span>
          <ul>{SWOT.combined.s.map((t) => <li>{t}</li>)}</ul>
        </div>
        <div class="cv-swot-block">
          <span class="cv-swot-block-lbl cv-swot-w">Weaknesses · W</span>
          <ul>{SWOT.combined.w.map((t) => <li>{t}</li>)}</ul>
        </div>
        <div class="cv-swot-block cv-swot-half">
          <span class="cv-swot-block-lbl cv-swot-o">Opp. · O</span>
          <ul>{SWOT.combined.o.map((t) => <li>{t}</li>)}</ul>
        </div>
        <div class="cv-swot-block cv-swot-half">
          <span class="cv-swot-block-lbl cv-swot-t">Threats · T</span>
          <ul>{SWOT.combined.t.map((t) => <li>{t}</li>)}</ul>
        </div>
      </div>
    </div>
  </div>

  <div class="cv-swot-foot">
    <div class="cv-swot-foot-row">
      <span class="cv-swot-foot-lbl">Garcia scenario · send $200 to a cousin</span>
      <span class="cv-swot-foot-taps" data-cv-swot-taps>
        {SCENARIO_TAPS.split.length} taps
      </span>
    </div>
    <ol class="cv-swot-foot-flow" data-cv-swot-flow>
      {SCENARIO_TAPS.split.map((step) => <li>{step}</li>)}
    </ol>
    <div class="cv-swot-tip">
      <span class="cv-swot-tip-tag">WHAT TIPPED IT</span>
      <p>
        Both SWOTs are defensible. Tap-counts favor Combined, but Split has its own strengths.
        The tiebreaker isn't the matrix — it's the thesis: <em>family-first identity.</em>
        Splitting the household behind a tab would dilute the entire product premise.
        Combined ships. The Move Money tab becomes its own dedicated action surface
        inside it.
      </p>
    </div>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>("[data-cv-swot]");
  if (root) {
    const SCENARIO_TAPS_MAP: Record<string, string[]> = {
      split: [
        "Open app · 1",
        "Tap Family tab · 2",
        "Tap Garcia Family · 3",
        "Tap Move money · 4",
        "Tap cousin · 5",
        "Enter $200 · 6",
        "Confirm · 7",
      ],
      combined: [
        "Open app · 1",
        "Tap Move money · 2",
        "Tap Garcia → cousin · 3",
        "Enter $200 · 4",
        "Confirm · 5",
      ],
    };

    const opts = root.querySelectorAll<HTMLButtonElement>("[data-cv-swot-opt]");
    const panes = root.querySelectorAll<HTMLElement>("[data-cv-swot-pane]");
    const taps = root.querySelector<HTMLElement>("[data-cv-swot-taps]");
    const flow = root.querySelector<HTMLOListElement>("[data-cv-swot-flow]");

    const activate = (id: string) => {
      opts.forEach((o) => {
        const on = o.dataset.cvSwotOpt === id;
        o.classList.toggle("active", on);
        o.setAttribute("aria-selected", on ? "true" : "false");
      });
      panes.forEach((p) => p.classList.toggle("active", p.dataset.cvSwotPane === id));
      const steps = SCENARIO_TAPS_MAP[id] || [];
      if (taps) taps.textContent = `${steps.length} taps`;
      if (flow) flow.innerHTML = steps.map((s) => `<li>${s}</li>`).join("");
    };

    opts.forEach((o) => {
      o.addEventListener("click", () => activate(o.dataset.cvSwotOpt || "split"));
    });
  }
</script>

<style>
  .cv-swot {
    display: grid;
    gap: 24px;
  }

  /* Picker */
  .cv-swot-picker {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  @media (max-width: 720px) {
    .cv-swot-picker { grid-template-columns: 1fr; }
  }
  .cv-swot-opt {
    display: grid;
    grid-template-columns: 36px 1fr;
    grid-template-rows: auto auto;
    column-gap: 14px;
    row-gap: 2px;
    text-align: left;
    background: rgba(245, 241, 232, 0.02);
    border: 1px solid var(--cs-line);
    border-radius: 4px;
    padding: 14px 16px;
    cursor: pointer;
    transition: border-color 160ms ease, background 160ms ease;
  }
  .cv-swot-opt:hover {
    border-color: var(--cs-line-strong);
    background: rgba(245, 241, 232, 0.04);
  }
  .cv-swot-opt.active {
    border-color: var(--brand-orange);
    background: rgba(255, 90, 60, 0.06);
  }
  .cv-swot-opt-glyph {
    grid-row: 1 / span 2;
    align-self: center;
    display: inline-flex;
    gap: 3px;
    align-items: center;
    justify-content: center;
    height: 26px;
    width: 36px;
    border: 1px solid rgba(245, 241, 232, 0.32);
    border-radius: 3px;
    padding: 0 4px;
  }
  .cv-swot-tab {
    width: 6px;
    height: 12px;
    border-radius: 1px;
    background: rgba(245, 241, 232, 0.45);
  }
  .cv-swot-tab-wide { width: 22px; background: rgba(255, 90, 60, 0.72); }
  .cv-swot-opt.active .cv-swot-tab { background: var(--brand-orange); }
  .cv-swot-opt-name {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-style: italic;
    font-weight: 700;
    font-size: 15px;
    color: var(--cs-text);
  }
  .cv-swot-opt.active .cv-swot-opt-name { color: var(--brand-orange); }
  .cv-swot-opt-blurb {
    font-size: 12.5px;
    color: rgba(245, 241, 232, 0.55);
    line-height: 1.4;
  }

  /* Stage */
  .cv-swot-stage { position: relative; }
  .cv-swot-pane {
    display: none;
    grid-template-columns: minmax(220px, 280px) minmax(0, 1fr);
    gap: 28px;
    align-items: start;
  }
  .cv-swot-pane.active { display: grid; }
  @media (max-width: 880px) {
    .cv-swot-pane.active { grid-template-columns: 1fr; }
  }

  /* Phone */
  .cv-swot-phone {
    background: #f5f1e8;
    color: #11283F;
    border-radius: 22px;
    overflow: hidden;
    box-shadow: 0 24px 60px -30px rgba(0,0,0,0.7), 0 0 0 1px rgba(245, 241, 232, 0.10);
    font-family: "Geist Variable", ui-sans-serif, system-ui, sans-serif;
  }
  .cv-swot-phone-head {
    background: #f5f1e8;
    padding: 12px 0 6px;
    display: flex;
    justify-content: center;
  }
  .cv-swot-bar {
    width: 56px;
    height: 4px;
    background: #11283F;
    border-radius: 2px;
    opacity: 0.32;
  }
  .cv-swot-phone-body { padding: 14px 16px 18px; }

  .cv-swot-screen-title {
    font-size: 18px;
    font-weight: 700;
    margin: 0 0 8px;
    color: #11283F;
  }
  .cv-swot-screen-num {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 22px;
    font-weight: 700;
    margin: 0 0 12px;
    color: #11283F;
    display: flex;
    align-items: baseline;
    gap: 8px;
  }
  .cv-swot-screen-mask {
    font-size: 11px;
    color: #3F5870;
    font-weight: 500;
  }
  .cv-swot-screen-tx {
    list-style: none;
    padding: 0;
    margin: 0 0 14px;
    display: grid;
    gap: 4px;
    font-size: 12px;
  }
  .cv-swot-screen-tx li {
    display: flex;
    justify-content: space-between;
    padding: 6px 0;
    border-bottom: 1px solid rgba(17, 40, 63, 0.08);
    color: #11283F;
  }
  .cv-swot-screen-tx li.pos { color: #2E7D32; font-weight: 700; }
  .cv-swot-screen-hint {
    font-size: 11px;
    color: #D43F2E;
    margin: 0 0 4px;
    font-style: italic;
    text-align: right;
  }
  .cv-swot-screen-subtitle {
    font-size: 13px;
    font-weight: 700;
    color: #11283F;
    margin: 4px 0 8px;
    border-top: 1px solid rgba(17, 40, 63, 0.10);
    padding-top: 10px;
  }
  .cv-swot-fam {
    display: grid;
    gap: 8px;
  }
  .cv-swot-fam-card {
    background: linear-gradient(135deg, #2563eb 0%, #6366f1 100%);
    color: #f5f1e8;
    border-radius: 8px;
    padding: 8px 10px;
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto auto;
    gap: 2px 6px;
  }
  .cv-swot-fam-card.alt { background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%); }
  .cv-swot-fam-name { font-size: 12px; font-weight: 700; }
  .cv-swot-fam-amt {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 14px;
    font-weight: 700;
    text-align: right;
    grid-row: 1;
    grid-column: 2;
  }
  .cv-swot-fam-avatars { font-size: 10px; opacity: 0.78; grid-column: 1 / span 2; }

  .cv-swot-phone-tabs {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 4px;
    padding: 8px 8px 10px;
    border-top: 2px solid #D43F2E;
    background: #f5f1e8;
  }
  .cv-swot-phone-tab {
    text-align: center;
    font-size: 9.5px;
    font-weight: 700;
    color: #3F5870;
    padding: 6px 2px;
    border-radius: 3px;
  }
  .cv-swot-phone-tab.on { color: #2563eb; }
  .cv-swot-phone-tab-move { color: #2E7D32; }

  /* SWOT side */
  .cv-swot-side {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  .cv-swot-block {
    background: rgba(245, 241, 232, 0.02);
    border: 1px solid var(--cs-line);
    border-radius: 4px;
    padding: 12px 14px;
  }
  .cv-swot-block.cv-swot-half { /* half-width default in 2-col grid */ }
  .cv-swot-block-lbl {
    display: block;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--brand-cyan);
    margin-bottom: 8px;
  }
  .cv-swot-block-lbl.cv-swot-w { color: var(--brand-pink); }
  .cv-swot-block-lbl.cv-swot-o { color: var(--brand-yellow); }
  .cv-swot-block-lbl.cv-swot-t { color: var(--brand-orange); }
  .cv-swot-block ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 5px;
  }
  .cv-swot-block li {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 12px;
    line-height: 1.4;
    color: rgba(245, 241, 232, 0.78);
    padding-left: 12px;
    position: relative;
  }
  .cv-swot-block li::before {
    content: "·";
    position: absolute;
    left: 0;
    color: rgba(245, 241, 232, 0.45);
    font-weight: 700;
  }

  /* Footer scenario */
  .cv-swot-foot {
    margin-top: 4px;
    padding: 18px 20px;
    background: rgba(255, 90, 60, 0.04);
    border: 1px solid rgba(255, 90, 60, 0.18);
    border-radius: 4px;
  }
  .cv-swot-foot-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 10px;
  }
  .cv-swot-foot-lbl {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 12px;
    color: rgba(245, 241, 232, 0.72);
  }
  .cv-swot-foot-taps {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-style: italic;
    font-weight: 700;
    font-size: 14px;
    color: var(--brand-orange);
  }
  .cv-swot-foot-flow {
    list-style: none;
    padding: 0;
    margin: 0 0 14px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .cv-swot-foot-flow li {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11px;
    color: rgba(245, 241, 232, 0.62);
    padding: 4px 8px;
    border: 1px solid rgba(245, 241, 232, 0.10);
    border-radius: 2px;
    background: rgba(245, 241, 232, 0.02);
  }

  .cv-swot-tip {
    padding: 14px 16px;
    border-left: 2px solid var(--brand-orange);
    background: rgba(255, 90, 60, 0.06);
    border-radius: 0 4px 4px 0;
  }
  .cv-swot-tip-tag {
    display: inline-block;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 10px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--brand-orange);
    font-weight: 700;
    margin-bottom: 6px;
  }
  .cv-swot-tip p {
    font-size: 14px;
    line-height: 1.55;
    color: var(--cs-text);
    margin: 0;
    max-width: none !important;
  }
  .cv-swot-tip em {
    font-style: italic;
    color: var(--brand-orange);
    font-weight: 700;
  }
</style>
