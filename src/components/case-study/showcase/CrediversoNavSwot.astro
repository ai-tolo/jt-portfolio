---
// The V1 nav-bar SWOT, as a participatory decision. Two defensible options:
// Split (a dedicated Family tab) and Combined (one Accounts surface). Tap
// either to see its mock home screen, its SWOT, and the tap-cost for the
// Garcia Family use case (Juan sends $200 to his cousin).
//
// The decision is GATED. The reader has to look at BOTH options before the
// product gets to break the tie — the "what tipped it" panel stays sealed
// until Split AND Combined have been viewed, then arrives with weight.
// The tiebreaker isn't the matrix or even the tap-count. It's the thesis:
// family-first identity. That gate is the case study's whole spine, made
// into a thing the reader does instead of reads.

const SCENARIO_TAPS = {
  split: [
    "Open app · 1",
    "Tap Family tab · 2",
    "Tap Garcia Family · 3",
    "Tap Move Money · 4",
    "Tap cousin · 5",
    "Enter $200 · 6",
    "Confirm · 7",
  ],
  combined: [
    "Open app · 1",
    "Tap Move Money · 2",
    "Tap Garcia → cousin · 3",
    "Enter $200 · 4",
    "Confirm · 5",
  ],
};

const SWOT = {
  split: {
    s: ["Single-user clarity on the home screen", "Family feature visible in all UI previews", "Easy to implement page-specific features"],
    w: ["Lacks a dedicated Move Money page", "25% of menu nav irrelevant for single-user", "Primary accounts compete for clarity"],
    o: ["Family page → primary onboarding for new household members"],
    t: ["Buries the family thesis behind a tab"],
  },
  combined: {
    s: ["Accounts is all-inclusive", "Family accounts visible on the same page as primary", "Lots of info on the home page"],
    w: ["Higher screen density", "Move Money becomes its own action surface"],
    o: ["Develops an intuitive UI muscle other partner products inherit"],
    t: ["Requires careful UI lift to avoid feeling cluttered"],
  },
};
---

<div class="cv-swot" data-cv-swot>
  <header class="cv-swot-head">
    <span class="cv-swot-live"><span class="cv-swot-live-dot" aria-hidden="true"></span>You break the tie</span>
    <p class="cv-swot-head-prompt">Two defensible navs for the Garcia household — you're sending a cousin $200. View each, then ship one.</p>
  </header>

  <div class="cv-swot-picker" role="tablist" aria-label="Pick a nav model">
    <button type="button" class="cv-swot-opt active" role="tab" data-cv-swot-opt="split" aria-selected="true">
      <span class="cv-swot-opt-name">Split</span>
      <span class="cv-swot-opt-blurb">Dedicated Family tab, single-user home</span>
      <span class="cv-swot-opt-seen" data-cv-seen-badge="split" aria-hidden="true">seen ✓</span>
    </button>
    <button type="button" class="cv-swot-opt" role="tab" data-cv-swot-opt="combined" aria-selected="false">
      <span class="cv-swot-opt-name">Combined</span>
      <span class="cv-swot-opt-blurb">One Accounts surface, family on home</span>
      <span class="cv-swot-opt-seen" data-cv-seen-badge="combined" aria-hidden="true">seen ✓</span>
    </button>
  </div>

  {/* THE TAP-COST — placed high (right under the toggle) so a switch's effect
      is always in view. The active option lights; both numbers stay comparable. */}
  <div class="cv-swot-cost" data-cv-swot-cost>
    <div class="cv-swot-cost-cell" data-cv-cost-cell="split">
      <span class="cv-swot-cost-name">Split</span>
      <span class="cv-swot-cost-n">7</span>
      <span class="cv-swot-cost-unit">taps</span>
    </div>
    <span class="cv-swot-cost-vs" aria-hidden="true">vs</span>
    <div class="cv-swot-cost-cell" data-cv-cost-cell="combined">
      <span class="cv-swot-cost-name">Combined</span>
      <span class="cv-swot-cost-n">5</span>
      <span class="cv-swot-cost-unit">taps</span>
    </div>
    <span class="cv-swot-cost-delta" data-cv-cost-delta>2 fewer taps on Combined</span>
    <ol class="cv-swot-cost-flow" data-cv-swot-flow aria-label="Tap-by-tap flow for the selected option">
      {SCENARIO_TAPS.split.map((step) => <li>{step}</li>)}
    </ol>
  </div>

  <div class="cv-swot-stage">
    {/* SPLIT PANE */}
    <div class="cv-swot-pane active" data-cv-swot-pane="split">
      <div class="cv-swot-phone">
        <div class="cv-swot-phone-head">
          <span class="cv-swot-bar"></span>
        </div>
        <div class="cv-swot-phone-body">
          <p class="cv-swot-screen-title">Juan's Account</p>
          <p class="cv-swot-screen-num">$3,450.76 <span class="cv-swot-screen-mask">····1234</span></p>
          <ul class="cv-swot-screen-tx">
            <li><span>Netflix sub</span><span>−$12.01</span></li>
            <li><span>Macy's</span><span>−$32.99</span></li>
            <li><span>Amazon</span><span>−$18.07</span></li>
            <li class="pos"><span>ACH payment</span><span>+$1,200.07</span></li>
          </ul>
          <p class="cv-swot-screen-hint">family lives one tab away →</p>
        </div>
        <div class="cv-swot-phone-tabs">
          <span class="cv-swot-phone-tab on">Account</span>
          <span class="cv-swot-phone-tab">Family</span>
          <span class="cv-swot-phone-tab">ATM Map</span>
          <span class="cv-swot-phone-tab">More</span>
        </div>
      </div>

      <div class="cv-swot-side">
        <div class="cv-swot-block">
          <span class="cv-swot-block-lbl">Strengths · S</span>
          <ul>{SWOT.split.s.map((t) => <li>{t}</li>)}</ul>
        </div>
        <div class="cv-swot-block">
          <span class="cv-swot-block-lbl cv-swot-w">Weaknesses · W</span>
          <ul>{SWOT.split.w.map((t) => <li>{t}</li>)}</ul>
        </div>
        <div class="cv-swot-block cv-swot-half">
          <span class="cv-swot-block-lbl cv-swot-o">Opportunities · O</span>
          <ul>{SWOT.split.o.map((t) => <li>{t}</li>)}</ul>
        </div>
        <div class="cv-swot-block cv-swot-half">
          <span class="cv-swot-block-lbl cv-swot-t">Threats · T</span>
          <ul>{SWOT.split.t.map((t) => <li>{t}</li>)}</ul>
        </div>
      </div>
    </div>

    {/* COMBINED PANE */}
    <div class="cv-swot-pane" data-cv-swot-pane="combined">
      <div class="cv-swot-phone">
        <div class="cv-swot-phone-head">
          <span class="cv-swot-bar"></span>
        </div>
        <div class="cv-swot-phone-body">
          <p class="cv-swot-screen-title">Hi, Juan.</p>
          <p class="cv-swot-screen-num">$3,450.76 <span class="cv-swot-screen-mask">····1234</span></p>
          <ul class="cv-swot-screen-tx">
            <li><span>Netflix sub</span><span>−$12.01</span></li>
            <li class="pos"><span>ACH payment</span><span>+$1,200.07</span></li>
          </ul>
          <p class="cv-swot-screen-subtitle">Family</p>
          <div class="cv-swot-fam">
            <div class="cv-swot-fam-card">
              <span class="cv-swot-fam-name">Garcia Family</span>
              <span class="cv-swot-fam-amt">$5,000.00</span>
              <span class="cv-swot-fam-avatars">👤👤👤 4 members</span>
            </div>
            <div class="cv-swot-fam-card alt">
              <span class="cv-swot-fam-name">College Buddies</span>
              <span class="cv-swot-fam-amt">$2,000.00</span>
              <span class="cv-swot-fam-avatars">👤👤 3 members</span>
            </div>
          </div>
        </div>
        <div class="cv-swot-phone-tabs">
          <span class="cv-swot-phone-tab on">Accounts</span>
          <span class="cv-swot-phone-tab cv-swot-phone-tab-move">Move Money</span>
          <span class="cv-swot-phone-tab">ATM Map</span>
          <span class="cv-swot-phone-tab">More</span>
        </div>
      </div>

      <div class="cv-swot-side">
        <div class="cv-swot-block">
          <span class="cv-swot-block-lbl">Strengths · S</span>
          <ul>{SWOT.combined.s.map((t) => <li>{t}</li>)}</ul>
        </div>
        <div class="cv-swot-block">
          <span class="cv-swot-block-lbl cv-swot-w">Weaknesses · W</span>
          <ul>{SWOT.combined.w.map((t) => <li>{t}</li>)}</ul>
        </div>
        <div class="cv-swot-block cv-swot-half">
          <span class="cv-swot-block-lbl cv-swot-o">Opportunities · O</span>
          <ul>{SWOT.combined.o.map((t) => <li>{t}</li>)}</ul>
        </div>
        <div class="cv-swot-block cv-swot-half">
          <span class="cv-swot-block-lbl cv-swot-t">Threats · T</span>
          <ul>{SWOT.combined.t.map((t) => <li>{t}</li>)}</ul>
        </div>
      </div>
    </div>
  </div>

  {/* THE GATE — three states. (1) locked: look at both options. (2) commit:
       you've seen both, now SHIP one — skin in the game before the answer.
       (3) unlocked: the reveal, branched on the choice you committed to. */}
  <div class="cv-swot-gate" data-cv-swot-gate data-state="locked">
    <div class="cv-swot-gate-locked" data-cv-gate-locked>
      <span class="cv-swot-gate-lock" aria-hidden="true">⌧</span>
      <p class="cv-swot-gate-prompt">
        The matrix ran even and the tap-count favors Combined — but that's not the
        whole story. <strong>Look at both options,</strong> then you make the call.
      </p>
      <div class="cv-swot-gate-progress" aria-hidden="true">
        <span class="cv-swot-gate-pip" data-cv-gate-pip="split">Split</span>
        <span class="cv-swot-gate-pip" data-cv-gate-pip="combined">Combined</span>
      </div>
    </div>

    <div class="cv-swot-commit" data-cv-commit hidden>
      <p class="cv-swot-commit-q">
        You've seen both. You're the Garcia sending a cousin $200 —
        <strong>which nav would you ship?</strong>
      </p>
      <div class="cv-swot-commit-opts" role="group" aria-label="Ship a nav model">
        <button type="button" class="cv-swot-commit-btn" data-cv-commit-pick="split">Ship Split</button>
        <button type="button" class="cv-swot-commit-btn" data-cv-commit-pick="combined">Ship Combined</button>
      </div>
    </div>

    <div class="cv-swot-tip" data-cv-gate-reveal hidden>
      <span class="cv-swot-tip-tag">What tipped it</span>
      <p class="cv-swot-tip-lead" data-cv-reveal-lead="combined" hidden>
        You shipped Combined — the call I made too. And <em>not</em> because it saved two taps.
      </p>
      <p class="cv-swot-tip-lead" data-cv-reveal-lead="split" hidden>
        You shipped Split — genuinely cleaner for one user, and the tap-count is on
        your side. I made the other call; here's the trade you took.
      </p>
      <p>
        Both SWOTs are defensible. Split is genuinely cleaner for a single user.
        But splitting the household behind a tab buries the family thesis the whole
        product is built on — the family you were just invited into. The tiebreaker
        isn't the matrix and it isn't the tap-count — it's the identity:
        <em>family-first.</em> That's why Combined shipped, with Move Money as its
        own dedicated action surface inside the combined home.
      </p>
    </div>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>("[data-cv-swot]");
  if (root) {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const SCENARIO_TAPS_MAP: Record<string, string[]> = {
      split: [
        "Open app · 1",
        "Tap Family tab · 2",
        "Tap Garcia Family · 3",
        "Tap Move Money · 4",
        "Tap cousin · 5",
        "Enter $200 · 6",
        "Confirm · 7",
      ],
      combined: [
        "Open app · 1",
        "Tap Move Money · 2",
        "Tap Garcia → cousin · 3",
        "Enter $200 · 4",
        "Confirm · 5",
      ],
    };

    const opts = root.querySelectorAll<HTMLButtonElement>("[data-cv-swot-opt]");
    const panes = root.querySelectorAll<HTMLElement>("[data-cv-swot-pane]");
    const flow = root.querySelector<HTMLOListElement>("[data-cv-swot-flow]");
    const cost = root.querySelector<HTMLElement>("[data-cv-swot-cost]");
    const costCells = root.querySelectorAll<HTMLElement>("[data-cv-cost-cell]");
    const seenBadges = root.querySelectorAll<HTMLElement>("[data-cv-seen-badge]");
    const gate = root.querySelector<HTMLElement>("[data-cv-swot-gate]");
    const gatePips = root.querySelectorAll<HTMLElement>("[data-cv-gate-pip]");
    const commit = root.querySelector<HTMLElement>("[data-cv-commit]");
    const commitBtns = root.querySelectorAll<HTMLButtonElement>("[data-cv-commit-pick]");
    const reveal = root.querySelector<HTMLElement>("[data-cv-gate-reveal]");
    const revealLeads = root.querySelectorAll<HTMLElement>("[data-cv-reveal-lead]");

    // Track which options the reader has actually CLICKED. Nothing is seen on
    // load — the gate genuinely requires viewing both before it opens. (Split
    // is shown on load for orientation, but that is not a choice the reader made.)
    const seen = new Set<string>();

    const markSeen = (id: string) => {
      seen.add(id);
      seenBadges.forEach((b) => {
        if (seen.has(b.dataset.cvSeenBadge || "")) b.classList.add("on");
      });
      gatePips.forEach((p) => {
        if (seen.has(p.dataset.cvGatePip || "")) p.classList.add("on");
      });
      if (seen.has("split") && seen.has("combined")) showCommit();
    };

    // Step 2 — both options seen → ask the reader to commit to one BEFORE the
    // reveal, so they have skin in the call (the RenditionToggle move, silent).
    let committed = false;
    const showCommit = () => {
      if (committed || !gate || !commit) return;
      gate.dataset.state = "commit";
      commit.removeAttribute("hidden");
    };

    // Step 3 — the reader ships one → reveal, branched on their choice.
    let unlocked = false;
    const choose = (pick: string) => {
      if (unlocked || !gate || !reveal) return;
      unlocked = true;
      committed = true;
      gate.dataset.state = "unlocked";
      if (commit) commit.setAttribute("hidden", "");
      revealLeads.forEach((l) => {
        if (l.dataset.cvRevealLead === pick) l.removeAttribute("hidden");
        else l.setAttribute("hidden", "");
      });
      reveal.removeAttribute("hidden");
      if (reduce) {
        reveal.classList.add("in");
      } else {
        // Two rAFs so the [hidden]→visible flip paints before the .in
        // transition starts; setTimeout guarantees the end-state even where
        // a headless/throttled tab never advances rAF.
        requestAnimationFrame(() => requestAnimationFrame(() => reveal.classList.add("in")));
        window.setTimeout(() => reveal.classList.add("in"), 80);
      }
    };

    commitBtns.forEach((b) => {
      b.addEventListener("click", () => choose(b.dataset.cvCommitPick || "combined"));
    });

    // Visual switch only — does NOT mark an option seen (only a real click does).
    const activate = (id: string) => {
      opts.forEach((o) => {
        const on = o.dataset.cvSwotOpt === id;
        o.classList.toggle("active", on);
        o.setAttribute("aria-selected", on ? "true" : "false");
      });
      panes.forEach((p) => p.classList.toggle("active", p.dataset.cvSwotPane === id));
      costCells.forEach((c) => c.classList.toggle("on", c.dataset.cvCostCell === id));
      const steps = SCENARIO_TAPS_MAP[id] || [];
      if (flow) flow.innerHTML = steps.map((s) => `<li>${s}</li>`).join("");
    };

    opts.forEach((o) => {
      o.addEventListener("click", () => {
        const id = o.dataset.cvSwotOpt || "split";
        activate(id);
        markSeen(id);
      });
    });

    // Prime the initial visual state (Split shown on load, but NOT counted seen).
    activate("split");
  }
</script>

<style>
  .cv-swot {
    display: grid;
    gap: 18px;
    max-width: 940px;
    margin: 0 auto;
    padding: clamp(18px, 3vw, 28px);
    border: 1px solid var(--cs-line-strong);
    border-radius: 10px;
    background:
      radial-gradient(120% 80% at 50% -10%, rgba(43, 163, 218, 0.05), transparent 60%),
      linear-gradient(180deg, var(--cs-surface) 0%, var(--cs-surface-2) 100%);
    box-shadow: 0 28px 70px -40px rgba(0, 0, 0, 0.8);
  }
  /* night restores the original half-token fall-off (surface → near-black),
     which --cs-surface-2 alone can't reach */
  :global(html[data-night]) .cv-swot {
    background:
      radial-gradient(120% 80% at 50% -10%, rgba(43, 163, 218, 0.05), transparent 60%),
      linear-gradient(180deg, var(--cs-surface) 0%, #08070d 100%);
  }
  .cv-swot [hidden] { display: none !important; }

  /* Header — an in-flow affordance that replaces the old absolutely-positioned
     "LIVE" badge (which overlapped the module and read as page chrome). */
  .cv-swot-head {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px 16px;
  }
  .cv-swot-live {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    flex: 0 0 auto;
    font-family: var(--cs-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--cs-green-text);
    background: color-mix(in srgb, var(--cs-green-text) 6%, transparent);
    border: 1px solid color-mix(in srgb, var(--cs-green-text) 40%, transparent);
    border-radius: 20px;
    padding: 5px 12px;
  }
  .cv-swot-live-dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--cs-green-text);
    box-shadow: 0 0 6px var(--cs-green-text);
    animation: cv-swot-live-pulse 1.6s ease-in-out infinite;
  }
  @keyframes cv-swot-live-pulse { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.42; transform: scale(0.8); } }
  .cv-swot-head-prompt {
    flex: 1 1 280px;
    margin: 0;
    font-family: var(--cs-mono);
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--cs-text-muted);
  }

  /* Picker */
  .cv-swot-picker {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  @media (max-width: 720px) {
    .cv-swot-picker { grid-template-columns: 1fr; }
  }
  .cv-swot-opt {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 3px;
    text-align: left;
    background: color-mix(in srgb, var(--cs-text) 3.5%, transparent);
    border: 1px solid var(--cs-line);
    border-radius: 6px;
    padding: 11px 14px;
    cursor: pointer;
    transition: border-color 160ms ease, background 160ms ease;
  }
  .cv-swot-opt:hover {
    border-color: var(--cs-line-strong);
    background: color-mix(in srgb, var(--cs-text) 6%, transparent);
  }
  .cv-swot-opt.active {
    border-color: var(--cs-accent);
    /* the warm selection wash reads on both grounds — left untokenised */
    background: rgba(255, 90, 60, 0.06);
  }
  .cv-swot-opt-name {
    font-family: var(--cs-mono);
    font-style: italic;
    font-weight: 700;
    font-size: 15px;
    color: var(--cs-text);
  }
  .cv-swot-opt.active .cv-swot-opt-name { color: var(--cs-accent); }
  .cv-swot-opt-blurb {
    font-size: 12.5px;
    color: var(--cs-text-muted);
    line-height: 1.4;
    padding-right: 52px;
  }
  /* "seen ✓" badge — a quiet receipt that the option's been viewed, feeding
     the gate. Hidden until seen. */
  .cv-swot-opt-seen {
    position: absolute;
    top: 12px;
    right: 14px;
    font-family: var(--cs-mono);
    font-size: 9px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cs-green-text);
    opacity: 0;
    transform: translateY(-2px);
    transition: opacity 240ms ease, transform 240ms ease;
  }
  .cv-swot-opt-seen.on { opacity: 0.85; transform: none; }

  /* Stage */
  .cv-swot-stage { position: relative; }
  .cv-swot-pane {
    display: none;
    grid-template-columns: minmax(200px, 230px) minmax(0, 1fr);
    gap: 22px;
    align-items: start;
  }
  .cv-swot-pane.active { display: grid; }
  @media (max-width: 760px) {
    .cv-swot-pane.active { grid-template-columns: 1fr; }
  }

  /* Phone */
  .cv-swot-phone {
    background: #f5f1e8;
    color: #11283F;
    border-radius: 22px;
    overflow: hidden;
    box-shadow: 0 24px 60px -30px rgba(0,0,0,0.7), 0 0 0 1px rgba(245, 241, 232, 0.10);
    font-family: "Geist Variable", ui-sans-serif, system-ui, sans-serif;
  }
  .cv-swot-phone-head {
    background: #f5f1e8;
    padding: 12px 0 6px;
    display: flex;
    justify-content: center;
  }
  .cv-swot-bar {
    width: 56px;
    height: 4px;
    background: #11283F;
    border-radius: 2px;
    opacity: 0.32;
  }
  .cv-swot-phone-body { padding: 14px 16px 18px; }

  .cv-swot-screen-title {
    font-size: 18px;
    font-weight: 700;
    margin: 0 0 8px;
    color: #11283F;
  }
  .cv-swot-screen-num {
    font-family: var(--cs-mono);
    font-size: 22px;
    font-weight: 700;
    margin: 0 0 12px;
    color: #11283F;
    display: flex;
    align-items: baseline;
    gap: 8px;
  }
  .cv-swot-screen-mask {
    font-size: 11px;
    color: #3F5870;
    font-weight: 500;
  }
  .cv-swot-screen-tx {
    list-style: none;
    padding: 0;
    margin: 0 0 14px;
    display: grid;
    gap: 4px;
    font-size: 12px;
  }
  .cv-swot-screen-tx li {
    display: flex;
    justify-content: space-between;
    padding: 6px 0;
    border-bottom: 1px solid rgba(17, 40, 63, 0.08);
    color: #11283F;
  }
  .cv-swot-screen-tx li.pos { color: #2E7D32; font-weight: 700; }
  .cv-swot-screen-hint {
    font-size: 11px;
    color: #D43F2E;
    margin: 0 0 4px;
    font-style: italic;
    text-align: right;
  }
  .cv-swot-screen-subtitle {
    font-size: 13px;
    font-weight: 700;
    color: #11283F;
    margin: 4px 0 8px;
    border-top: 1px solid rgba(17, 40, 63, 0.10);
    padding-top: 10px;
  }
  .cv-swot-fam {
    display: grid;
    gap: 8px;
  }
  .cv-swot-fam-card {
    background: linear-gradient(135deg, #2563eb 0%, #6366f1 100%);
