---
// Live filter/tag chip strip. Shows how the catalog organizes itself:
// a frequency-sorted strip of the top-N tags present in the current
// view. Click a tag to add it to the active filter. The result count
// updates. The chip strip re-ranks (because counts depend on the
// remaining view). Active tags get a checkmark + pin to the left.
//
// This is the production behavior of /buckets/top-tags + /buckets?tags=
// in the engine. The data here is a snapshot from the real catalog as
// of 2026-05-21.

interface TagRow { tag: string; count: number; }

// Snapshot of /buckets/top-tags?bucket=all on 2026-05-21 evening.
const TOP_TAGS: TagRow[] = [
  { tag: "instrumental", count: 1245 },
  { tag: "music-only", count: 1220 },
  { tag: "gratitude", count: 194 },
  { tag: "repetition", count: 188 },
  { tag: "loop", count: 152 },
  { tag: "songwriting", count: 141 },
  { tag: "sample", count: 97 },
  { tag: "self-doubt", count: 80 },
  { tag: "anxiety", count: 78 },
  { tag: "relationships", count: 52 },
  { tag: "first-person", count: 41 },
  { tag: "imagery", count: 33 },
];

// Co-occurrence map. When tag X is active, this drops/raises other tags
// to approximate what the engine would return for the narrowed query.
// Not exhaustive — just enough to feel real as the user clicks through.
const COOCCUR: Record<string, Partial<Record<string, number>>> = {
  "loop": {
    "instrumental": 134, "music-only": 132, "sample": 88, "songwriting": 12,
    "gratitude": 0, "self-doubt": 0, "anxiety": 0, "relationships": 0,
    "first-person": 0, "imagery": 0, "repetition": 18,
  },
  "songwriting": {
    "first-person": 38, "imagery": 28, "repetition": 71, "gratitude": 22,
    "self-doubt": 44, "anxiety": 39, "relationships": 30,
    "instrumental": 8, "music-only": 6, "loop": 12, "sample": 4,
  },
  "first-person": {
    "songwriting": 38, "self-doubt": 31, "anxiety": 28, "imagery": 24,
    "repetition": 22, "gratitude": 18, "relationships": 17,
    "instrumental": 0, "music-only": 0, "loop": 0, "sample": 0,
  },
  "self-doubt": {
    "anxiety": 36, "first-person": 31, "songwriting": 44, "relationships": 21,
    "repetition": 27, "gratitude": 5, "imagery": 12,
    "instrumental": 0, "music-only": 0, "loop": 0, "sample": 0,
  },
  "anxiety": {
    "self-doubt": 36, "first-person": 28, "songwriting": 39, "relationships": 14,
    "imagery": 11, "repetition": 16,
    "instrumental": 0, "music-only": 0, "loop": 0, "sample": 0,
  },
  "gratitude": {
    "first-person": 18, "songwriting": 22, "relationships": 8, "imagery": 5,
    "repetition": 7,
    "instrumental": 0, "music-only": 0, "loop": 0, "sample": 0,
  },
  "instrumental": {
    "music-only": 1218, "loop": 134, "sample": 89, "repetition": 76,
    "songwriting": 8, "gratitude": 0, "anxiety": 0, "self-doubt": 0,
    "first-person": 0, "imagery": 0, "relationships": 0,
  },
};

// Mock result row shapes for the small result-grid below.
const ROWS = [
  { name: "NOIZU_125_shaker_loop_tight_01", dur: "0:04", bpm: 99, key: "E", tags: ["loop", "sample", "instrumental", "music-only"], type: "loop" },
  { name: "driving_fast_so_i_dont_drown", dur: "1:48", bpm: 87, key: "A", tags: ["songwriting", "first-person", "self-doubt", "anxiety", "repetition"], type: "voice-note" },
  { name: "rainforest_post_karoke", dur: "5:42", bpm: 100, key: "Em", tags: ["instrumental", "music-only", "loop"], type: "jam" },
  { name: "55_Cmaj_0_what_you_know", dur: "0:08", bpm: 55, key: "C", tags: ["loop", "sample"], type: "loop" },
  { name: "VOX_Tolo_0007", dur: "0:30", bpm: null, key: null, tags: ["first-person", "imagery", "songwriting"], type: "voice-note" },
  { name: "monday_morning_thanks", dur: "2:14", bpm: 78, key: "G", tags: ["gratitude", "first-person", "songwriting"], type: "voice-note" },
  { name: "OLIVER_80_perc_loop", dur: "0:06", bpm: 80, key: "C", tags: ["loop", "sample", "instrumental"], type: "loop" },
  { name: "if_i_loved_you_better", dur: "3:22", bpm: 92, key: "D", tags: ["songwriting", "relationships", "first-person"], type: "voice-note" },
];
---

<div class="fc-stage" data-fc-stage>
  <div class="fc-strip-row">
    <span class="fc-strip-lbl">TAGS</span>
    <ul class="fc-strip" data-fc-strip role="list">
      {TOP_TAGS.map((t) => (
        <li class="fc-chip" data-fc-tag={t.tag} data-base-count={String(t.count)}>
          <button type="button" class="fc-chip-btn">
            <span class="fc-chip-name">{t.tag}</span>
            <span class="fc-chip-count" data-fc-count>{t.count.toLocaleString()}</span>
          </button>
        </li>
      ))}
      <li class="fc-clear-wrap" data-fc-clear-wrap hidden>
        <button type="button" class="fc-clear" data-fc-clear>↺ clear</button>
      </li>
    </ul>
  </div>

  <div class="fc-headline" data-fc-headline>
    <span class="fc-headline-num" data-fc-num>3,458</span>
    <span class="fc-headline-of">of <span data-fc-total>3,458</span> items</span>
    <span class="fc-headline-active" data-fc-active aria-live="polite"></span>
  </div>

  <ul class="fc-results" data-fc-results role="list">
    {ROWS.map((r) => (
      <li class="fc-row" data-fc-row data-tags={r.tags.join(",")}>
        <span class="fc-row-name">{r.name}<span class="fc-row-ext">.wav</span></span>
        <span class="fc-row-dur">{r.dur}</span>
        <span class="fc-row-tech">
          {r.bpm ? <span class="fc-row-bpm">{r.bpm} BPM</span> : <span class="fc-row-dim">—</span>}
          <span class="fc-row-sep">·</span>
          {r.key ? <span class="fc-row-key">{r.key}</span> : <span class="fc-row-dim">—</span>}
          <span class="fc-row-sep">·</span>
          <span class="fc-row-type">{r.type}</span>
        </span>
      </li>
    ))}
  </ul>
  <div class="fc-empty" data-fc-empty hidden>
    <span>No rows match this combination.</span>
    <button type="button" data-fc-clear>↺ clear filters</button>
  </div>
</div>

<script>
  type Tag = "instrumental" | "music-only" | "gratitude" | "repetition" | "loop" | "songwriting" | "sample" | "self-doubt" | "anxiety" | "relationships" | "first-person" | "imagery";

  const COOCCUR_MAP: Record<string, Record<string, number>> = {
    "loop": { "instrumental": 134, "music-only": 132, "sample": 88, "songwriting": 12, "gratitude": 0, "self-doubt": 0, "anxiety": 0, "relationships": 0, "first-person": 0, "imagery": 0, "repetition": 18 },
    "songwriting": { "first-person": 38, "imagery": 28, "repetition": 71, "gratitude": 22, "self-doubt": 44, "anxiety": 39, "relationships": 30, "instrumental": 8, "music-only": 6, "loop": 12, "sample": 4 },
    "first-person": { "songwriting": 38, "self-doubt": 31, "anxiety": 28, "imagery": 24, "repetition": 22, "gratitude": 18, "relationships": 17, "instrumental": 0, "music-only": 0, "loop": 0, "sample": 0 },
    "self-doubt": { "anxiety": 36, "first-person": 31, "songwriting": 44, "relationships": 21, "repetition": 27, "gratitude": 5, "imagery": 12, "instrumental": 0, "music-only": 0, "loop": 0, "sample": 0 },
    "anxiety": { "self-doubt": 36, "first-person": 28, "songwriting": 39, "relationships": 14, "imagery": 11, "repetition": 16, "instrumental": 0, "music-only": 0, "loop": 0, "sample": 0 },
    "gratitude": { "first-person": 18, "songwriting": 22, "relationships": 8, "imagery": 5, "repetition": 7, "instrumental": 0, "music-only": 0, "loop": 0, "sample": 0 },
    "instrumental": { "music-only": 1218, "loop": 134, "sample": 89, "repetition": 76, "songwriting": 8, "gratitude": 0, "anxiety": 0, "self-doubt": 0, "first-person": 0, "imagery": 0, "relationships": 0 },
  };

  const stage = document.querySelector<HTMLElement>("[data-fc-stage]");
  if (!stage) throw new Error("fc-stage missing");

  const chips = stage.querySelectorAll<HTMLElement>("[data-fc-tag]");
  const strip = stage.querySelector<HTMLElement>("[data-fc-strip]");
  const clearWrap = stage.querySelector<HTMLElement>("[data-fc-clear-wrap]");
  const numEl = stage.querySelector<HTMLElement>("[data-fc-num]");
  const totalEl = stage.querySelector<HTMLElement>("[data-fc-total]");
  const activeEl = stage.querySelector<HTMLElement>("[data-fc-active]");
  const rows = stage.querySelectorAll<HTMLElement>("[data-fc-row]");
  const emptyEl = stage.querySelector<HTMLElement>("[data-fc-empty]");

  const TOTAL = 3458;
  const active = new Set<string>();

  function computeCount(tag: string): number {
    // Count varies based on what's already active. We use the smallest
    // co-occur count among active tags ∪ {this tag} as a rough estimate
    // — close to how INTERSECT works on tag set membership.
    if (active.size === 0) {
      const li = stage.querySelector<HTMLElement>(`[data-fc-tag="${tag}"]`);
      return Number(li?.dataset.baseCount ?? "0");
    }
    let min = Number.POSITIVE_INFINITY;
    for (const a of active) {
      const cellsFromA = COOCCUR_MAP[a]?.[tag];
      if (typeof cellsFromA === "number") min = Math.min(min, cellsFromA);
      const cellsFromTag = COOCCUR_MAP[tag]?.[a];
      if (typeof cellsFromTag === "number") min = Math.min(min, cellsFromTag);
    }
    if (!Number.isFinite(min)) {
      // No data on this pair — guess by halving the base count for each
      // active filter beyond the first.
      const li = stage.querySelector<HTMLElement>(`[data-fc-tag="${tag}"]`);
      const base = Number(li?.dataset.baseCount ?? "0");
      return Math.max(0, Math.floor(base / (1 << active.size)));
    }
    return min;
  }

  function viewCount(): number {
    if (active.size === 0) return TOTAL;
    // Take the smallest co-occur count among all active pairs as the
    // matching view count.
    if (active.size === 1) {
      const tag = Array.from(active)[0];
      const li = stage.querySelector<HTMLElement>(`[data-fc-tag="${tag}"]`);
      return Number(li?.dataset.baseCount ?? "0");
    }
    const arr = Array.from(active);
    let min = Number.POSITIVE_INFINITY;
    for (let i = 0; i < arr.length; i++) {
      for (let j = i + 1; j < arr.length; j++) {
        const a = COOCCUR_MAP[arr[i]]?.[arr[j]];
        if (typeof a === "number") min = Math.min(min, a);
      }
    }
    return Number.isFinite(min) ? min : 0;
  }

  function render() {
    // Update each chip's count and re-rank the strip by count desc.
    const list: { tag: string; count: number; el: HTMLElement }[] = [];
    chips.forEach((el) => {
      const tag = el.dataset.fcTag!;
      const c = computeCount(tag);
      el.dataset.activeFilter = active.has(tag) ? "true" : "false";
      el.dataset.zero = c === 0 ? "true" : "false";
      const countEl = el.querySelector<HTMLElement>("[data-fc-count]");
      if (countEl) countEl.textContent = c.toLocaleString();
      list.push({ tag, count: c, el });
    });
    // Sort: active first, then by count desc, then alpha.
    list.sort((a, b) => {
      const aActive = active.has(a.tag) ? 1 : 0;
      const bActive = active.has(b.tag) ? 1 : 0;
      if (aActive !== bActive) return bActive - aActive;
      if (b.count !== a.count) return b.count - a.count;
      return a.tag.localeCompare(b.tag);
    });
    list.forEach(({ el }) => strip?.insertBefore(el, clearWrap));

    // Update headline.
    const n = viewCount();
    if (numEl) numEl.textContent = n.toLocaleString();
    if (totalEl) totalEl.textContent = TOTAL.toLocaleString();
    if (activeEl) {
      if (active.size === 0) {
        activeEl.textContent = "";
      } else {
        activeEl.innerHTML = "filtering by " + Array.from(active)
          .map((t) => `<em class="fc-active-tag">${t}</em>`)
          .join(" + ");
      }
    }

    // Show / hide clear.
    if (clearWrap) {
      if (active.size === 0) clearWrap.setAttribute("hidden", "");
      else clearWrap.removeAttribute("hidden");
    }

    // Filter the mock result rows: a row matches if its tags include
    // every active filter.
    let visible = 0;
    rows.forEach((row) => {
      const rowTags = (row.dataset.tags ?? "").split(",");
      const matches = Array.from(active).every((t) => rowTags.includes(t));
      if (matches) {
        row.removeAttribute("hidden");
        visible++;
      } else {
        row.setAttribute("hidden", "");
      }
    });
    if (emptyEl) {
      if (visible === 0 && active.size > 0) emptyEl.removeAttribute("hidden");
      else emptyEl.setAttribute("hidden", "");
    }
  }

  // Wire chip clicks.
  chips.forEach((el) => {
    el.querySelector("button")?.addEventListener("click", () => {
      const tag = el.dataset.fcTag!;
      if (active.has(tag)) active.delete(tag);
      else active.add(tag);
      render();
    });
  });

  // Wire clears.
  stage.querySelectorAll<HTMLElement>("[data-fc-clear]").forEach((b) => {
    b.addEventListener("click", () => {
      active.clear();
      render();
    });
  });

  // Auto-walkthrough on scroll-into-view: nothing → "songwriting" → +"first-person" → clear → "loop" → clear. Aborts on first user touch.
  let touched = false;
  stage.addEventListener("pointerdown", () => { touched = true; }, { once: true });

  const io = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (!e.isIntersecting) continue;
      const tick = (i: number) => {
        if (touched) return;
        const steps = [
          () => { active.add("songwriting"); render(); },
          () => { active.add("first-person"); render(); },
          () => { active.clear(); active.add("loop"); render(); },
          () => { active.clear(); render(); },
        ];
        if (i < steps.length) {
          steps[i]();
          window.setTimeout(() => tick(i + 1), 1600);
        }
      };
      window.setTimeout(() => tick(0), 900);
      io.disconnect();
    }
  }, { threshold: 0.45 });
  io.observe(stage);

  render();
</script>

<style>
  .fc-stage {
    background: rgba(15, 10, 18, 0.94);
    border: 1px solid rgba(245, 241, 232, 0.10);
    border-radius: 8px;
    padding: 22px 24px 24px;
    color: #f5f1e8;
    font-family: "Geist Variable", ui-sans-serif, system-ui, sans-serif;
  }

  .fc-strip-row {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 14px;
    align-items: flex-start;
    margin-bottom: 16px;
    padding-bottom: 16px;
    border-bottom: 1px solid rgba(245, 241, 232, 0.08);
  }
  .fc-strip-lbl {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 10px;
    letter-spacing: 0.22em;
    color: rgba(245, 241, 232, 0.48);
    padding-top: 6px;
  }
  .fc-strip {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .fc-chip {
    transition: transform 320ms cubic-bezier(0.2, 0, 0, 1);
  }
  .fc-chip-btn {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11.5px;
    color: rgba(245, 241, 232, 0.78);
    background: rgba(245, 241, 232, 0.03);
    border: 1px solid rgba(245, 241, 232, 0.18);
    border-radius: 18px;
    padding: 5px 11px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    transition: color 160ms ease, border-color 160ms ease, background 160ms ease, transform 80ms ease;
  }
  .fc-chip-btn:hover {
    color: #f5f1e8;
    border-color: rgba(245, 241, 232, 0.45);
    background: rgba(245, 241, 232, 0.06);
  }
  .fc-chip-btn:active { transform: translateY(1px); }
  .fc-chip-count {
    font-feature-settings: "tnum";
    color: rgba(245, 241, 232, 0.45);
    font-size: 10.5px;
  }
  .fc-chip[data-active-filter="true"] .fc-chip-btn {
    color: #0e0c14;
    background: linear-gradient(90deg, #ff2761 0%, #ff5a3c 100%);
    border-color: transparent;
  }
  .fc-chip[data-active-filter="true"] .fc-chip-count { color: rgba(7, 6, 12, 0.55); }
  .fc-chip[data-active-filter="true"] .fc-chip-name::before {
    content: "✓ ";
    color: rgba(7, 6, 12, 0.78);
  }
  .fc-chip[data-zero="true"] .fc-chip-btn {
    opacity: 0.42;
    text-decoration: line-through;
    text-decoration-color: rgba(245, 241, 232, 0.32);
  }
  .fc-chip[data-zero="true"] .fc-chip-count { color: rgba(245, 241, 232, 0.32); }

  .fc-clear-wrap {
    list-style: none;
    margin-left: auto;
  }
  .fc-clear {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 10.5px;
    color: rgba(245, 241, 232, 0.55);
    background: transparent;
    border: 1px solid rgba(245, 241, 232, 0.18);
    border-radius: 18px;
    padding: 5px 11px;
    cursor: pointer;
  }
  .fc-clear:hover { color: #f5f1e8; border-color: rgba(245, 241, 232, 0.45); }

  .fc-headline {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-bottom: 12px;
  }
  .fc-headline-num {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-style: italic;
    font-weight: 700;
    font-size: 28px;
    color: var(--brand-yellow);
    font-feature-settings: "tnum";
  }
  .fc-headline-of {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 12px;
    color: rgba(245, 241, 232, 0.55);
  }
  .fc-headline-active {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 12px;
    color: rgba(245, 241, 232, 0.55);
    margin-left: 12px;
    padding-left: 12px;
    border-left: 1px solid rgba(245, 241, 232, 0.18);
  }
  .fc-headline-active:empty { display: none; }
  .fc-active-tag {
    color: var(--brand-pink);
    font-style: italic;
    font-weight: 700;
    margin: 0 2px;
  }

  .fc-results {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .fc-row {
    display: grid;
    grid-template-columns: 1fr 60px 1fr;
    gap: 14px;
    align-items: center;
    padding: 9px 12px;
    background: rgba(245, 241, 232, 0.02);
    border: 1px solid rgba(245, 241, 232, 0.08);
    border-radius: 3px;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 12px;
    transition: opacity 200ms ease;
  }
  .fc-row[hidden] { display: none; }
  .fc-row-name {
    color: #00ff4d;
    font-style: italic;
    font-weight: 700;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    min-width: 0;
  }
  .fc-row-ext { opacity: 0.42; font-weight: 500; font-size: 0.7em; color: #f5f1e8; }
  .fc-row-dur {
    color: #ff3b6e;
    font-style: italic;
    font-weight: 700;
    text-align: right;
    text-shadow: 0 0 4px rgba(255, 59, 110, 0.4);
  }
  .fc-row-tech {
    font-style: italic;
    color: rgba(245, 241, 232, 0.82);
    display: flex;
    align-items: baseline;
    gap: 6px;
    flex-wrap: wrap;
  }
  .fc-row-bpm,
  .fc-row-key { color: var(--brand-cyan); font-weight: 700; }
  .fc-row-type { color: rgba(245, 241, 232, 0.55); }
  .fc-row-sep { color: rgba(245, 241, 232, 0.32); }
  .fc-row-dim { color: rgba(245, 241, 232, 0.32); }

  .fc-empty {
    text-align: center;
    padding: 24px;
    color: rgba(245, 241, 232, 0.55);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 12px;
    border: 1px dashed rgba(245, 241, 232, 0.18);
    border-radius: 4px;
  }
  .fc-empty[hidden] { display: none; }
  .fc-empty button {
    margin-left: 10px;
    font-family: inherit;
    font-size: 11px;
    color: var(--brand-orange);
    background: transparent;
    border: 1px solid rgba(255, 90, 60, 0.45);
    border-radius: 2px;
    padding: 4px 10px;
    cursor: pointer;
  }
</style>
