---
// Storytelling BucketCard. Visual + interactions lifted from the actual
// portal/buckets/BucketCard.astro, scoped down to what the case study
// needs to teach. Interactions wired up here are:
//   - waveform fake-play (animated playhead sweeps L→R, click pauses)
//   - J/L/F/T pill toggle (clicking re-assigns the active category)
//   - title click-to-rename (inline contenteditable)
//   - hold-to-archive (0.45s press flips card to "Archived. UNDO" state)
//   - date row expand reveals tags + tech + lineage
//
// Mock data is passed in via props so multiple cards on the page can
// show distinct states (e.g. "in Live", "voice memo", "loop sorted").
import "./bucket-card-shared.css";

interface Props {
  /** Display title (the green italic mono one). */
  title: string;
  /** Extension shown at 60% opacity, e.g. ".wav". Omit to leave off. */
  ext?: string;
  /** Duration label "M:SS". */
  duration: string;
  /** BPM number, omit when unknown. */
  bpm?: number;
  /** Key string, e.g. "A# major" — normalized internally. */
  keyStr?: string;
  /** Relative age + stamp + days. e.g. {rel:"1y", stamp:"06-15-2024", days:"704d"}. */
  date?: { rel: string; stamp: string; days: string };
  /** Silence ratio 0..1 — only shown if > 0.2 in the date row. */
  silenceRatio?: number;
  /** Which category pill is active. */
  bucket?: "inbox" | "jam" | "loops" | "field" | "tracks";
  /** Render the "✓ In Live" badge state in place of the Promote button. */
  inLive?: boolean;
  /** Render a fake (CSS-only) waveform image instead of a placeholder. */
  fakeWaveform?: boolean;
  /** Inline tag chips for the expanded panel. */
  tags?: string[];
  /** Engine-derived content type chip. */
  contentType?: string;
  /** Engine-derived source type chip. */
  sourceType?: string;
  /** Optional lineage breadcrumb. */
  lineage?: { word: string; parent: string };
  /** Initially expanded (default false). */
  expanded?: boolean;
  /** Hide certain expanded rows for cleaner storytelling. */
  hideStems?: boolean;
  /** Visually mark this card as currently "playing" (no scripting). */
  playing?: boolean;
  /** Optional unique id; auto-generated if absent. */
  cardId?: string;
  /**
   * Master switch for the full-fidelity demo card. When true:
   *  - Waveform plays REAL audio (Web Audio synthesised drum loop matching
   *    the card's BPM, looped endlessly until paused).
   *  - Expanded panel adds the Crop tool, Stems, and Send-to-Engineer
   *    affordances with mocked-but-faithful interactions.
   *  - All destructive actions just flash status (nothing actually splits,
   *    promotes, archives, or sends anywhere).
   */
  interactive?: boolean;
}

const {
  title,
  ext,
  duration,
  bpm,
  keyStr,
  date,
  silenceRatio,
  bucket = "inbox",
  inLive = false,
  fakeWaveform = true,
  tags = [],
  contentType,
  sourceType,
  lineage,
  expanded = false,
  hideStems = true,
  playing = false,
  cardId,
  interactive = false,
} = Astro.props;
// Interactive cards always show the full action surface; the hideStems
// prop only applies to the lighter storytelling cards.
const showFullActions = interactive || !hideStems;

const id = cardId ?? `bc-${Math.random().toString(36).slice(2, 10)}`;

const keyInfo = (() => {
  if (!keyStr) return { letter: null as string | null, mode: null as string | null };
  const s = String(keyStr).trim();
  let m = s.match(/^([A-Ga-g][#b]?)\s*(major|minor|maj|min)\b/i);
  if (m) {
    const mode = m[2].toLowerCase().startsWith("min") ? "minor" : "major";
    return { letter: m[1].toUpperCase().replace("B", "b"), mode };
  }
  m = s.match(/^([A-Ga-g][#b]?)m$/);
  if (m) return { letter: m[1].toUpperCase().replace("B", "b"), mode: "minor" };
  m = s.match(/^([A-Ga-g][#b]?)$/);
  if (m) return { letter: m[1].toUpperCase().replace("B", "b"), mode: "major" };
  return { letter: s, mode: null };
})();

const CATEGORIES = [
  { id: "jam", label: "JAM", kbd: "J" },
  { id: "loops", label: "LOOP", kbd: "L" },
  { id: "field", label: "FIELD", kbd: "F" },
  { id: "tracks", label: "TRACK", kbd: "T" },
] as const;
---

<article
  class="bc-card"
  data-bc
  data-id={id}
  data-bucket={bucket}
  data-playing={playing ? "true" : "false"}
  data-expanded={expanded ? "true" : "false"}
  data-interactive={interactive ? "true" : "false"}
  data-bpm={bpm ?? ""}
  tabindex="0"
  aria-label={`${title} — ${bucket}`}
>
  <div class="bc-grid">
    <!-- Main column -->
    <div class="bc-mid">
      <h3 class="bc-title">
        <button
          type="button"
          class="bc-title-edit"
          data-bc-rename
          title="Click to rename"
        ><span class="bc-title-base" data-bc-title-text>{title}</span>{ext && <span class="bc-title-ext">{ext}</span>}</button>
      </h3>

      <div class="bc-wave-row">
        <span class="bc-duration" aria-label="Duration">{duration}</span>
        <div
          class="bc-waveform"
          data-bc-waveform
          title="Click to play"
        >
          {fakeWaveform ? (
            <div class="bc-fake-wave" aria-hidden="true">
              {Array.from({ length: 56 }).map((_, i) => {
                const h = 32 + Math.round(28 * Math.sin(i * 0.42) + 22 * Math.cos(i * 0.83));
                const pct = Math.max(18, Math.min(96, h));
                return <span class="bc-fake-wave-bar" style={`height:${pct}%`}></span>;
              })}
            </div>
          ) : (
            <div class="bc-wave-placeholder">no waveform yet</div>
          )}
          <div class="bc-playhead" data-bc-playhead></div>

          {/* Crop overlay. Hidden by default; revealed when the user taps
              ✂ Crop from the expanded panel. Mirrors the production crop
              tool's visual treatment: cyan frame + draggable handles +
              bar grid + dimmed masks on either side. */}
          {interactive && (
            <div class="bc-crop-overlay" data-bc-crop-overlay hidden>
              <div class="bc-crop-mask bc-crop-mask-left" data-bc-crop-mask="left"></div>
              <div class="bc-crop-mask bc-crop-mask-right" data-bc-crop-mask="right"></div>
              <div class="bc-crop-ticks" aria-hidden="true">
                {Array.from({ length: 9 }).map((_, i) => (
                  <span class="bc-crop-tick" style={`left:${(i / 8) * 100}%`}></span>
                ))}
              </div>
              <div class="bc-crop-frame" data-bc-crop-frame title="Drag to slide">
                <button
                  type="button"
                  class="bc-crop-handle bc-crop-handle-l"
                  data-bc-crop-handle="start"
                  aria-label="Drag to set loop start"
                ></button>
                <span class="bc-crop-readout" data-bc-crop-readout>4 bars</span>
                <button
                  type="button"
                  class="bc-crop-handle bc-crop-handle-r"
                  data-bc-crop-handle="end"
                  aria-label="Drag to set loop end"
                ></button>
              </div>
            </div>
          )}
        </div>
      </div>

      <button
        type="button"
        class="bc-date"
        data-bc-expand
        aria-expanded={expanded ? "true" : "false"}
      >
        {date ? (
          <>
            <span class="bc-date-rel">{date.rel}</span>
            <span class="bc-date-bracket"> [</span><span class="bc-date-stamp">{date.stamp}</span><span class="bc-date-bracket">]</span>
            <span class="bc-date-sep"> · </span>
            <span class="bc-date-days">{date.days}</span>
            {silenceRatio !== undefined && silenceRatio > 0.2 && (
              <>
                <span class="bc-date-sep"> · </span>
                <span class="bc-silence">{Math.round(silenceRatio * 100)}% silent</span>
              </>
            )}
          </>
        ) : (
          <span class="bc-date-rel">date unknown</span>
        )}
        <span class="bc-date-chev" aria-hidden="true">▾</span>
      </button>

      <p class="bc-status" data-bc-status aria-live="polite"></p>
    </div>

    <!-- J/L/F/T pill -->
    <div class="bc-cat" role="group" aria-label="Assign to category">
      {CATEGORIES.map((c) => (
        <button
          type="button"
          class:list={["bc-cat-btn", { active: bucket === c.id }]}
          data-bc-cat={c.id}
          aria-label={`Assign to ${c.label}`}
        >
          <span class="bc-cat-label">{c.label}</span>
        </button>
      ))}
    </div>

    <!-- Archive column -->
    <button
      type="button"
      class="bc-trash"
      data-bc-trash
      title="Hold to archive"
      aria-label="Hold to archive"
    >
      <span class="bc-hold-fill" aria-hidden="true"></span>
      <span class="bc-hold-glyph">✕</span>
    </button>
  </div>

  <!-- Expanded panel -->
  <div class="bc-exp" data-bc-exp hidden={!expanded}>
    <dl class="bc-dl">
      <dt>Tags</dt>
      <dd class="bc-tags">
        <button
          type="button"
          class="bc-chip bc-chip-pub"
          data-bc-pub
          aria-pressed="false"
          title="Mark public on /sounds"
        >○ PUBLIC</button>
        {contentType && <span class="bc-chip bc-chip-derived">{contentType}</span>}
        {sourceType && <span class="bc-chip bc-chip-derived">{sourceType}</span>}
        {tags.map((t) => (
          <span class="bc-chip bc-chip-tag">
            {t}
            <button type="button" class="bc-chip-x" aria-label={`Remove ${t}`}>×</button>
          </span>
        ))}
        <button type="button" class="bc-chip bc-chip-add">+ add</button>
      </dd>

      {(bpm || keyStr) && (
        <>
          <dt>Tech</dt>
          <dd class="bc-tech">
            {bpm && (
              <>
                <span class="bc-bpm">{Math.round(bpm)}</span>
                <span class="bc-bpm-unit">BPM</span>
              </>
            )}
            {bpm && keyStr && <span class="bc-tech-sep">·</span>}
            {keyStr && (
              <>
                <span class="bc-key">{keyInfo.letter || "—"}</span>
                {keyInfo.mode && <span class="bc-key-mode">{keyInfo.mode}</span>}
              </>
            )}
          </dd>
        </>
      )}

      {lineage && (
        <>
          <dt>Lineage</dt>
          <dd class="bc-lineage">
            <span class="bc-lineage-from">from {lineage.word}:</span>
            <span class="bc-lineage-link">{lineage.parent}</span>
          </dd>
        </>
      )}

      {(showFullActions || bucket === "loops") && (
        <>
          <dt>Actions</dt>
          <dd class="bc-actions" data-bc-actions>
            {bucket === "loops" && (
              inLive ? (
                <span class="bc-in-live">✓ In Live</span>
              ) : (
                <button type="button" class="bc-promote" data-bc-promote>→ Promote to Live</button>
              )
            )}
            {showFullActions && (
              <>
                <button
                  type="button"
                  class="bc-crop-btn"
                  data-bc-crop-toggle
                  aria-pressed="false"
                  title="Open the crop tool on the waveform"
                >✂ Crop</button>
                <button
                  type="button"
                  class="bc-stem-btn"
                  data-bc-stem="2"
                  title="Demucs split → vocals + instrumental"
                >2-stem<span class="bc-stem-sub">vox · inst</span></button>
                <button
                  type="button"
                  class="bc-stem-btn"
                  data-bc-stem="4"
                  title="Demucs split → drums + bass + vocals + other"
                >4-stem<span class="bc-stem-sub">drm · bass · vox · oth</span></button>
                <button
                  type="button"
                  class="bc-eng-btn"
                  data-bc-engineer
                  title="Queue for the Engineer · auto-splits stems if needed, renders 6 A/B variants"
                >→ Send to Engineer</button>
              </>
            )}
            <span class="bc-action-status" data-bc-action-status aria-live="polite"></span>
          </dd>
        </>
      )}

      {/* Child stems revealed after split-stems completes. */}
      {showFullActions && (
        <div class="bc-children" data-bc-children hidden>
          <p class="bc-children-head">
            <span class="bc-children-label">Stems</span>
            <span class="bc-children-sub" data-bc-children-sub>4 derived rows · parented to this asset</span>
          </p>
          <ul class="bc-stem-rows" data-bc-stem-rows></ul>
        </div>
      )}
    </dl>
  </div>
</article>

<script>
  // ── Shared audio engine ──────────────────────────────────────────────
  // One AudioContext + one procedurally generated loop buffer shared
  // across all interactive cards on the page. Starting playback on a card
  // stops whatever else is currently playing — the page is a single
  // monitor speaker, not a mixer.
  type CardEl = HTMLElement & { __bcRaf?: number };
  let audioCtx: AudioContext | null = null;
  let loopBuffer: AudioBuffer | null = null;
  let currentSrc: AudioBufferSourceNode | null = null;
  let currentCard: CardEl | null = null;
  let currentRaf: number | null = null;
  let currentStartedAt = 0;

  // Synthesise a 1-bar drum loop at the card's BPM (default 99 to match
  // the case study's NOIZU shaker loop card). Shakers on every 16th note,
  // accented on beats 1 and 3, with a soft kick on the downbeats. Hand-
  // rolled DSP so the demo has zero asset dependencies.
  const generateLoopBuffer = (ctx: AudioContext, bpm: number): AudioBuffer => {
    const beatSec = 60 / bpm;
    const barSec = beatSec * 4;
    const sr = ctx.sampleRate;
    const len = Math.floor(barSec * sr);
    const buf = ctx.createBuffer(2, len, sr);
    const L = buf.getChannelData(0);
    const R = buf.getChannelData(1);

    // Shaker / closed hat: highpass-shaped noise burst, every 16th note.
    const sixteenth = beatSec / 4;
    for (let n = 0; n < 16; n++) {
      const startSamp = Math.floor(n * sixteenth * sr);
      const decayLen = Math.floor(0.07 * sr);
      const accent = n % 4 === 0 ? 1.0 : n % 2 === 0 ? 0.6 : 0.42;
      let prev = 0;
      for (let i = 0; i < decayLen; i++) {
        const s = startSamp + i;
        if (s >= len) break;
        const t = i / decayLen;
        const env = Math.exp(-t * 7) * accent;
        const noise = Math.random() * 2 - 1;
        const hp = noise - prev * 0.92;
        prev = noise;
        L[s] += hp * env * 0.20;
        R[s] += hp * env * 0.18;
      }
    }

    // Kick: 110→50Hz sine sweep on beats 1 and 3.
    const kickDecay = Math.floor(0.20 * sr);
    for (const beat of [0, 2]) {
      const startSamp = Math.floor(beat * beatSec * sr);
      for (let i = 0; i < kickDecay; i++) {
        const s = startSamp + i;
        if (s >= len) break;
        const t = i / sr;
        const env = Math.exp(-t * 13);
        const freq = 110 * Math.exp(-t * 9) + 50;
        const sample = Math.sin(2 * Math.PI * freq * t) * env * 0.42;
        L[s] += sample;
        R[s] += sample;
      }
    }

    // Soft master clip.
    for (let i = 0; i < len; i++) {
      if (L[i] > 0.95) L[i] = 0.95; else if (L[i] < -0.95) L[i] = -0.95;
      if (R[i] > 0.95) R[i] = 0.95; else if (R[i] < -0.95) R[i] = -0.95;
    }
    return buf;
  };

  const stopAudio = () => {
    if (currentSrc) {
      try { currentSrc.stop(); } catch {}
      currentSrc.disconnect();
      currentSrc = null;
    }
    if (currentRaf !== null) {
      cancelAnimationFrame(currentRaf);
      currentRaf = null;
    }
    if (currentCard) {
      currentCard.dataset.playing = "false";
      const h = currentCard.querySelector<HTMLElement>("[data-bc-playhead]");
      if (h) h.style.left = "0%";
      currentCard = null;
    }
  };

  const startAudio = async (card: CardEl, bpm: number) => {
    if (!audioCtx) {
      const Ctor = window.AudioContext || (window as any).webkitAudioContext;
      audioCtx = new Ctor();
    }
    if (!loopBuffer) loopBuffer = generateLoopBuffer(audioCtx, bpm);
    if (audioCtx.state === "suspended") await audioCtx.resume();
    stopAudio();
    const src = audioCtx.createBufferSource();
    src.buffer = loopBuffer;
    src.loop = true;
    src.connect(audioCtx.destination);
    src.start(0);
    currentSrc = src;
    currentCard = card;
    currentStartedAt = audioCtx.currentTime;
    card.dataset.playing = "true";
    const head = card.querySelector<HTMLElement>("[data-bc-playhead]");
    const buf = loopBuffer;
    const tick = () => {
      if (currentCard !== card || !audioCtx || !buf) return;
      const elapsed = audioCtx.currentTime - currentStartedAt;
      const pct = ((elapsed % buf.duration) / buf.duration) * 100;
      if (head) head.style.left = pct + "%";
      currentRaf = requestAnimationFrame(tick);
    };
    currentRaf = requestAnimationFrame(tick);
  };

  // ── Per-card wiring ─────────────────────────────────────────────────
  // Idempotent — safe to inject multiple times via Astro's bundling
  // because we de-dupe via a marker attribute.
  const setup = () => {
    document.querySelectorAll<HTMLElement>(".bc-card[data-bc]").forEach((card) => {
      if (card.dataset.bcWired === "true") return;
      card.dataset.bcWired = "true";

      const interactive = card.dataset.interactive === "true";
      const bpm = Number(card.dataset.bpm) || 99;

      const wave = card.querySelector<HTMLElement>("[data-bc-waveform]");
      const head = card.querySelector<HTMLElement>("[data-bc-playhead]");

      // Fake-play (animated playhead, no audio). Used by non-interactive
      // storytelling cards. Auto-stops at end of sweep.
      let fakeRaf: number | null = null;
      const stopFake = () => {
        if (fakeRaf !== null) {
          cancelAnimationFrame(fakeRaf);
          fakeRaf = null;
        }
        card.dataset.playing = "false";
        if (head) head.style.left = "0%";
      };
      const startFake = () => {
        const startedAt = performance.now();
        const duration = 5500;
        card.dataset.playing = "true";
        const tick = () => {
          const t = (performance.now() - startedAt) / duration;
          if (head) head.style.left = `${Math.min(100, t * 100)}%`;
          if (t >= 1) {
            stopFake();
            return;
          }
          fakeRaf = requestAnimationFrame(tick);
        };
        fakeRaf = requestAnimationFrame(tick);
      };

      wave?.addEventListener("click", (e) => {
        e.preventDefault();
        // In crop mode the waveform is a drag surface, not a play surface.
        if (card.dataset.crop === "true") return;
        if (interactive) {
          if (card.dataset.playing === "true") stopAudio();
          else startAudio(card, bpm);
        } else {
          if (card.dataset.playing === "true") stopFake();
          else startFake();
        }
      });

      // Category toggle.
      card.querySelectorAll<HTMLElement>("[data-bc-cat]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const id = btn.dataset.bcCat!;
          card.dataset.bucket = id;
          card.querySelectorAll<HTMLElement>(".bc-cat-btn").forEach((b) => {
            b.classList.toggle("active", b.dataset.bcCat === id);
          });
          showStatus(card, `bucket → ${id}`);
        });
      });

      // Expand toggle.
      const expandBtn = card.querySelector<HTMLElement>("[data-bc-expand]");
      const exp = card.querySelector<HTMLElement>("[data-bc-exp]");
      expandBtn?.addEventListener("click", () => {
        const open = card.dataset.expanded !== "true";
        card.dataset.expanded = open ? "true" : "false";
        expandBtn.setAttribute("aria-expanded", open ? "true" : "false");
        if (exp) {
          if (open) exp.removeAttribute("hidden");
          else exp.setAttribute("hidden", "");
        }
      });

      // Inline rename.
      card.querySelector<HTMLElement>("[data-bc-rename]")?.addEventListener("click", (e) => {
        e.preventDefault();
        const textEl = card.querySelector<HTMLElement>("[data-bc-title-text]");
        if (!textEl) return;
        textEl.setAttribute("contenteditable", "true");
        textEl.focus();
        const sel = window.getSelection();
        const range = document.createRange();
        range.selectNodeContents(textEl);
        sel?.removeAllRanges();
        sel?.addRange(range);
        const finish = () => {
          textEl.removeAttribute("contenteditable");
          showStatus(card, "renamed (demo)");
          textEl.removeEventListener("blur", finish);
          textEl.removeEventListener("keydown", onKey);
        };
        const onKey = (k: KeyboardEvent) => {
          if (k.key === "Enter" || k.key === "Escape") {
            k.preventDefault();
            textEl.blur();
          }
        };
        textEl.addEventListener("blur", finish);
        textEl.addEventListener("keydown", onKey);
      });

      // PUBLIC chip toggle.
      card.querySelector<HTMLElement>("[data-bc-pub]")?.addEventListener("click", (e) => {
        e.preventDefault();
        const btn = e.currentTarget as HTMLElement;
        const on = btn.classList.toggle("on");
        btn.setAttribute("aria-pressed", on ? "true" : "false");
        btn.textContent = on ? "● PUBLIC" : "○ PUBLIC";
      });

      // Hold-to-archive (0.45s).
      const trash = card.querySelector<HTMLElement>("[data-bc-trash]");
      let holdT: number | null = null;
      let holding = false;
      const startHold = () => {
        if (holding) return;
        holding = true;
        trash?.setAttribute("data-holding", "true");
        holdT = window.setTimeout(() => {
          card.dataset.archiving = "true";
          showStatus(card, "Archived. UNDO →", true);
          window.setTimeout(() => {
            delete card.dataset.archiving;
            showStatus(card, "");
          }, 6000);
          cancelHold();
        }, 450);
      };
      const cancelHold = () => {
        holding = false;
        if (holdT !== null) {
          window.clearTimeout(holdT);
          holdT = null;
        }
        trash?.removeAttribute("data-holding");
      };
      trash?.addEventListener("mousedown", startHold);
      trash?.addEventListener("touchstart", startHold, { passive: true });
      trash?.addEventListener("mouseup", cancelHold);
      trash?.addEventListener("mouseleave", cancelHold);
      trash?.addEventListener("touchend", cancelHold);

      // ── Crop tool toggle + drag ────────────────────────────────────
      const cropBtn = card.querySelector<HTMLButtonElement>("[data-bc-crop-toggle]");
      const cropOverlay = card.querySelector<HTMLElement>("[data-bc-crop-overlay]");
      const cropFrame = card.querySelector<HTMLElement>("[data-bc-crop-frame]");
      const cropReadout = card.querySelector<HTMLElement>("[data-bc-crop-readout]");

      if (cropBtn && cropOverlay && cropFrame && wave) {
        let startPct = 22;
        let endPct = 78;
        const writeCrop = () => {
          // CSS vars live on the .bc-waveform container (parent of the
          // overlay) so both masks and frame read from one source.
          wave.style.setProperty("--bc-crop-start", startPct + "%");
          wave.style.setProperty("--bc-crop-end", endPct + "%");
          if (cropReadout) {
            // Loop spans up to 4 bars at the card's BPM. Pretty-print to
            // 1 decimal but drop the decimal when it's an integer-ish bar.
            const widthPct = endPct - startPct;
            const bars = (widthPct / 100) * 4;
            cropReadout.textContent = `${bars % 1 < 0.05 ? bars.toFixed(0) : bars.toFixed(1)} bars`;
          }
        };

        cropBtn.addEventListener("click", () => {
          const isOpen = card.dataset.crop === "true";
          if (isOpen) {
            card.dataset.crop = "false";
            cropBtn.setAttribute("aria-pressed", "false");
            cropOverlay.setAttribute("hidden", "");
            showStatus(card, "");
          } else {
            // Stop audio when entering crop mode — the waveform is a drag
            // surface, not a play surface, while cropping.
            if (currentCard === card) stopAudio();
            card.dataset.crop = "true";
            cropBtn.setAttribute("aria-pressed", "true");
            cropOverlay.removeAttribute("hidden");
            writeCrop();
            showStatus(card, "drag the handles or frame · click ✂ Crop again to close");
          }
        });

        let dragging: "start" | "end" | "frame" | null = null;
        let dragStartX = 0;
        let dragStartStart = 0;
        let dragStartEnd = 0;
        const onPointerDown = (e: PointerEvent, which: "start" | "end" | "frame") => {
          e.preventDefault();
          dragging = which;
          dragStartX = e.clientX;
          dragStartStart = startPct;
          dragStartEnd = endPct;
          (e.target as HTMLElement)?.setPointerCapture?.(e.pointerId);
        };
        const onPointerMove = (e: PointerEvent) => {
          if (!dragging || !wave) return;
          const r = wave.getBoundingClientRect();
          const deltaPct = ((e.clientX - dragStartX) / r.width) * 100;
          if (dragging === "start") {
            startPct = Math.max(0, Math.min(endPct - 6, dragStartStart + deltaPct));
          } else if (dragging === "end") {
            endPct = Math.max(startPct + 6, Math.min(100, dragStartEnd + deltaPct));
          } else if (dragging === "frame") {
            const len = dragStartEnd - dragStartStart;
            const ns = Math.max(0, Math.min(100 - len, dragStartStart + deltaPct));
            startPct = ns;
            endPct = ns + len;
          }
          writeCrop();
        };
        const onPointerUp = () => { dragging = null; };

        card.querySelectorAll<HTMLElement>("[data-bc-crop-handle]").forEach((h) => {
          h.addEventListener("pointerdown", (e) =>
            onPointerDown(e as PointerEvent, h.dataset.bcCropHandle as "start" | "end")
          );
        });
        cropFrame.addEventListener("pointerdown", (e) => {
          if ((e.target as HTMLElement).closest("[data-bc-crop-handle]")) return;
          onPointerDown(e as PointerEvent, "frame");
        });
        // Document-level move + up so a drag that escapes the frame still
        // gets tracked. Shared listeners across all cards on the page.
        document.addEventListener("pointermove", onPointerMove);
        document.addEventListener("pointerup", onPointerUp);
      }

      // ── Promote to Live ────────────────────────────────────────────
      card.querySelector<HTMLButtonElement>("[data-bc-promote]")?.addEventListener("click", (e) => {
        e.preventDefault();
        const btn = e.currentTarget as HTMLButtonElement;
        if (btn.dataset.state === "running" || btn.dataset.state === "done") return;
        btn.dataset.state = "running";
        const orig = btn.innerHTML;
        btn.innerHTML = "↻ copying + loudnorming...";
        window.setTimeout(() => {
          btn.dataset.state = "done";
          btn.innerHTML = "✓ In Live";
          btn.classList.add("bc-in-live");
          btn.disabled = true;
          showStatus(card, "wrote loop into Ableton's Places");
        }, 900);
      });

      // ── Stem split (2-stem / 4-stem) ───────────────────────────────
      // Fake demucs render. The cyan-pulse CSS animation on
      // [data-state="running"] carries the in-flight feedback; the final
      // state transition happens on a single setTimeout (rather than a
      // ticking interval) so the demo behaves identically in test
      // environments where setInterval/rAF get throttled.
      card.querySelectorAll<HTMLButtonElement>("[data-bc-stem]").forEach((btn) => {
        btn.addEventListener("click", () => {
          if (btn.dataset.state === "running" || btn.dataset.state === "done") return;
          const n = Number(btn.dataset.bcStem);
          btn.dataset.state = "running";
          btn.innerHTML = `splitting<span class="bc-stem-sub">demucs · ~3s</span>`;
          window.setTimeout(() => {
            btn.innerHTML = `${n}-stem · ✓ done`;
            btn.dataset.state = "done";
            revealStemRows(card, n);
            showStatus(card, `demucs · ${n} child rows parented to this asset`);
          }, 1600);
        });
      });

      // ── Send to Engineer ───────────────────────────────────────────
      card.querySelector<HTMLButtonElement>("[data-bc-engineer]")?.addEventListener("click", (e) => {
        const btn = e.currentTarget as HTMLButtonElement;
        if (btn.dataset.state === "running" || btn.dataset.state === "done") return;
        btn.dataset.state = "running";
        btn.innerHTML = "↻ queueing...";
        const status = card.querySelector<HTMLElement>("[data-bc-action-status]");
        window.setTimeout(() => {
          const jobId = 40 + Math.floor(Math.random() * 60);
          btn.dataset.state = "done";
          btn.innerHTML = `✓ queued · job #${jobId}`;
          if (status) status.textContent = "rendering 6 variants across 3 taste axes";
        }, 700);
      });
    });
  };

  // Render the four (or two) child stem rows under the card. Each row
  // shows a stem-coloured pseudo-waveform and a tiny play button. The
  // play buttons are decorative — they just flash an "auditioning" state
  // and disable for 5s so the user can feel the affordance without us
  // wiring per-stem audio synthesis.
  const revealStemRows = (card: HTMLElement, n: number) => {
    const wrap = card.querySelector<HTMLElement>("[data-bc-children]");
    const rows = card.querySelector<HTMLElement>("[data-bc-stem-rows]");
    const sub = card.querySelector<HTMLElement>("[data-bc-children-sub]");
    if (!wrap || !rows) return;
    wrap.removeAttribute("hidden");
    if (sub) sub.textContent = `${n} derived rows · parented to this asset`;
    rows.innerHTML = "";
    const stems = n === 4
      ? ["drums", "bass", "vocals", "other"]
      : ["vocals", "other"];
    for (const stem of stems) {
      const li = document.createElement("li");
      li.className = "bc-stem-row";
      li.dataset.stem = stem;
      // Pseudo-waveform: deterministic-ish bars per stem with a vertical
      // envelope characteristic of that family (drums = peaky, bass =
      // slow rolling, vocals = sustained mid, other = wide).
      const bars: string[] = [];
      for (let i = 0; i < 36; i++) {
        let h: number;
        if (stem === "drums") h = i % 6 === 0 ? 92 : 18 + Math.random() * 28;
        else if (stem === "bass") h = 28 + Math.sin(i * 0.45) * 22 + Math.random() * 10;
        else if (stem === "vocals") h = 38 + Math.sin(i * 0.18) * 18 + Math.random() * 12;
        else h = 35 + Math.sin(i * 0.32) * 14 + Math.random() * 16;
        bars.push(`<span class="bc-stem-row-bar" style="height:${Math.max(8, Math.min(96, h))}%"></span>`);
      }
      li.innerHTML = `
        <span class="bc-stem-row-name">${stem}</span>
        <div class="bc-stem-row-wave" aria-hidden="true">${bars.join("")}</div>
        <button type="button" class="bc-stem-row-play" aria-label="Audition ${stem}">▶ play</button>
      `;
      rows.appendChild(li);
      const pb = li.querySelector<HTMLButtonElement>(".bc-stem-row-play");
      pb?.addEventListener("click", () => {
        const on = li.dataset.playing !== "true";
        li.dataset.playing = on ? "true" : "false";
        pb.textContent = on ? "❚❚ stop" : "▶ play";
        if (on) {
          window.setTimeout(() => {
            if (li.dataset.playing === "true") {
              li.dataset.playing = "false";
              pb.textContent = "▶ play";
            }
          }, 4500);
        }
      });
    }
  };

  const showStatus = (card: HTMLElement, msg: string, persist = false) => {
    const el = card.querySelector<HTMLElement>("[data-bc-status]");
    if (!el) return;
    el.textContent = msg;
    if (!persist && msg) {
      window.setTimeout(() => {
        if (el.textContent === msg) el.textContent = "";
      }, 1800);
    }
  };

  setup();
  // Also wire any cards that render in via client-side fragments later.
  const mo = new MutationObserver(setup);
  mo.observe(document.body, { childList: true, subtree: true });
</script>
