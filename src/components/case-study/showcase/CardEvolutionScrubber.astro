---
// "The card grew up" — capability-evolution scrubber.
//
// This is the spine of the case study. Each era is a real git commit
// where the card gained a capability the previous era couldn't do.
// The visual shifts are real but secondary — the headline is *what the
// row could DO* at each stage. Drag the slider to walk through history.
//
// Sources: lifted markup + the surviving CSS conventions per era from
// these commits on the jt-portfolio repo:
//   E0  6666ed3  2026-05-12  Initial portfolio (no portal, no playback)
//   E1  d79f9b2  2026-05-15  First portal Card: filename + metadata + Listen link
//   E2  d47581f  2026-05-17  BucketCard arrives: waveform image + ▶ Audition btn
//   E3  de712c2  2026-05-18  Waveform doubles as play surface; ▶ btn deleted
//   E4  61b99b3  2026-05-18  Expand panel (tags + tech + lineage); J/L/F/T bucketing
//   E5  c1b81f5  2026-05-21  Crop tool (✂), stem split (2/4), spectrogram, lineage chips
//   E6  d5c8871  2026-05-21  "→ Send to Engineer" button — card opens a pipeline
---

<div class="ce-stage" data-ce-stage>
  <!-- LEFT: real card markup for the current era. -->
  <div class="ce-card-frame">
    <!-- The wrapper carries data-era which scopes the per-era stylesheet
         below. Markup is the union of all eras' DOM; per-era CSS hides
         what doesn't belong. -->
    <article class="ce-card" data-ce-card data-era="6">
      <!-- ───── E0 ───── public portfolio WorkCard (no portal yet) -->
      <div class="ce-e0">
        <div class="ce-e0-num">02</div>
        <h3 class="ce-e0-title">Tolo.Cloud</h3>
        <p class="ce-e0-sub">A creative archive that doesn't try to be creative for me.</p>
        <p class="ce-e0-tags"><span>AI Tooling</span> · <span>Web</span> · <span>Shipped</span></p>
        <a class="ce-e0-link" href="#">Read case study →</a>
      </div>

      <!-- ───── E1 ───── First portal Card.astro -->
      <div class="ce-e1">
        <header class="ce-e1-meta">
          <span class="ce-e1-eyebrow">VOICE MEMO</span>
          <span class="ce-e1-date">Oct 23, 2024</span>
        </header>
        <h3 class="ce-e1-title">VOX_Tolo_0007.wav</h3>
        <p class="ce-e1-summary">A short voice memo, captured between sets. Possible lyric fragment.</p>
        <p class="ce-e1-audio"><span>0:30</span> · <span>VOICE-NOTE</span></p>
        <ul class="ce-e1-tags">
          <li>voice-memo</li><li>idea-fragment</li><li>first-person</li>
        </ul>
        <footer class="ce-e1-actions">
          <button type="button" class="ce-e1-queue">+ Queue</button>
          <a class="ce-e1-listen" href="#">Listen →</a>
        </footer>
      </div>

      <!-- ───── E2 ───── First BucketCard: waveform image + dedicated ▶ -->
      <div class="ce-e2">
        <div class="ce-e2-wave">
          <div class="ce-fake-wave ce-fake-wave-mid" aria-hidden="true">
            {Array.from({ length: 56 }).map((_, i) => {
              const h = 36 + Math.round(30 * Math.sin(i * 0.42) + 18 * Math.cos(i * 0.83));
              return <span class="ce-fake-bar" style={`height:${Math.max(20, Math.min(96, h))}%`}></span>;
            })}
          </div>
        </div>
        <header class="ce-e2-head">
          <h3 class="ce-e2-title">NOIZU_125_shaker_loop_tight_01.wav</h3>
          <button type="button" class="ce-e2-play" aria-label="Audition">▶ <span class="ce-e2-kbd">Space</span></button>
        </header>
        <div class="ce-e2-bucket-row">
          <span class="ce-e2-badge">Loop</span>
          <span class="ce-e2-kbds"><kbd>V</kbd><kbd>L</kbd><kbd>S</kbd><kbd>X</kbd></span>
        </div>
      </div>

      <!-- ───── E3 ───── Waveform IS the play surface -->
      <div class="ce-e3">
        <h3 class="ce-e3-title">NOIZU_125_shaker_loop_tight_01<span class="ce-e3-ext">.wav</span></h3>
        <div class="ce-e3-wave-row">
          <span class="ce-e3-dur">0:04</span>
          <div class="ce-e3-wave">
            <div class="ce-fake-wave" aria-hidden="true">
              {Array.from({ length: 56 }).map((_, i) => {
                const h = 36 + Math.round(30 * Math.sin(i * 0.42) + 18 * Math.cos(i * 0.83));
                return <span class="ce-fake-bar" style={`height:${Math.max(20, Math.min(96, h))}%`}></span>;
              })}
            </div>
            <div class="ce-e3-playhead"></div>
          </div>
        </div>
        <span class="ce-e3-badge">Loop</span>
      </div>

      <!-- ───── E4 ───── J/L/F/T bucketing + expand panel -->
      <div class="ce-e4">
        <div class="ce-e4-main">
          <h3 class="ce-e4-title">NOIZU_125_shaker_loop_tight_01<span class="ce-e4-ext">.wav</span></h3>
          <div class="ce-e4-wave-row">
            <span class="ce-e4-dur">0:04</span>
            <div class="ce-e4-wave">
              <div class="ce-fake-wave" aria-hidden="true">
                {Array.from({ length: 56 }).map((_, i) => {
                  const h = 36 + Math.round(30 * Math.sin(i * 0.42) + 18 * Math.cos(i * 0.83));
                  return <span class="ce-fake-bar" style={`height:${Math.max(20, Math.min(96, h))}%`}></span>;
                })}
              </div>
            </div>
          </div>
          <button type="button" class="ce-e4-date">
            <span>1y</span> <span>[06-15-2024]</span> <span class="ce-e4-chev">▾</span>
          </button>
          <dl class="ce-e4-exp">
            <dt>TAGS</dt><dd><span class="ce-e4-chip">○ PUBLIC</span><span class="ce-e4-chip">loop</span><span class="ce-e4-chip">sample</span></dd>
            <dt>TECH</dt><dd><span class="ce-e4-cy">99</span> BPM · <span class="ce-e4-cy">E</span> major</dd>
            <dt>LINEAGE</dt><dd>from sample: <span class="ce-e4-link">NOIZU pack v3</span></dd>
          </dl>
        </div>
        <div class="ce-e4-cat" role="group">
          <button class="ce-e4-cat-btn"><span>JAM</span></button>
          <button class="ce-e4-cat-btn active"><span>LOOP</span></button>
          <button class="ce-e4-cat-btn"><span>FIELD</span></button>
          <button class="ce-e4-cat-btn"><span>TRACK</span></button>
        </div>
        <button class="ce-e4-x">✕</button>
      </div>

      <!-- ───── E5 ───── Crop ✂, stem split (2/4), spectrogram, Promote -->
      <div class="ce-e5">
        <div class="ce-e5-main">
          <h3 class="ce-e5-title">NOIZU_125_shaker_loop_tight_01<span class="ce-e5-ext">.wav</span></h3>
          <div class="ce-e5-wave-row">
            <span class="ce-e5-dur">0:04</span>
            <div class="ce-e5-wave">
              <div class="ce-fake-wave" aria-hidden="true">
                {Array.from({ length: 56 }).map((_, i) => {
                  const h = 36 + Math.round(30 * Math.sin(i * 0.42) + 18 * Math.cos(i * 0.83));
                  return <span class="ce-fake-bar" style={`height:${Math.max(20, Math.min(96, h))}%`}></span>;
                })}
              </div>
            </div>
            <button type="button" class="ce-e5-crop" title="Crop a loop">✂</button>
          </div>
          <button type="button" class="ce-e5-date">
            <span>1y</span> <span>[06-15-2024]</span> · <span class="ce-e5-days">704d</span>
          </button>
          <dl class="ce-e5-exp">
            <dt>SPECTRO</dt><dd><span class="ce-e5-spec">▸ preview</span></dd>
            <dt>STEMS</dt>
            <dd>
              <button class="ce-e5-stem">2-stem<span>vox · inst</span></button>
              <button class="ce-e5-stem">4-stem<span>drm · bass · vox · oth</span></button>
            </dd>
            <dt>LIVE</dt>
            <dd><button class="ce-e5-promote">→ Promote to Live</button></dd>
          </dl>
        </div>
        <div class="ce-e5-cat" role="group">
          <button class="ce-e5-cat-btn"><span>JAM</span></button>
          <button class="ce-e5-cat-btn active"><span>LOOP</span></button>
          <button class="ce-e5-cat-btn"><span>FIELD</span></button>
          <button class="ce-e5-cat-btn"><span>TRACK</span></button>
        </div>
        <button class="ce-e5-x">✕</button>
      </div>

      <!-- ───── E6 ───── Send-to-Engineer pipeline button arrives -->
      <div class="ce-e6">
        <div class="ce-e6-main">
          <h3 class="ce-e6-title">NOIZU_125_shaker_loop_tight_01<span class="ce-e6-ext">.wav</span></h3>
          <div class="ce-e6-wave-row">
            <span class="ce-e6-dur">0:04</span>
            <div class="ce-e6-wave">
              <div class="ce-fake-wave" aria-hidden="true">
                {Array.from({ length: 56 }).map((_, i) => {
                  const h = 36 + Math.round(30 * Math.sin(i * 0.42) + 18 * Math.cos(i * 0.83));
                  return <span class="ce-fake-bar" style={`height:${Math.max(20, Math.min(96, h))}%`}></span>;
                })}
              </div>
            </div>
            <button type="button" class="ce-e6-crop" title="Crop a loop">✂</button>
          </div>
          <button type="button" class="ce-e6-date">
            <span>1y</span> <span>[06-15-2024]</span> · <span class="ce-e6-days">704d</span>
          </button>
          <dl class="ce-e6-exp">
            <dt>STEMS</dt>
            <dd>
              <button class="ce-e6-stem">2-stem</button>
              <button class="ce-e6-stem">4-stem</button>
            </dd>
            <dt>LIVE</dt><dd><span class="ce-e6-in-live">✓ In Live</span></dd>
            <dt>ENGINEER</dt>
            <dd><button class="ce-e6-eng">→ Send to Engineer</button></dd>
          </dl>
        </div>
        <div class="ce-e6-cat" role="group">
          <button class="ce-e6-cat-btn"><span>JAM</span></button>
          <button class="ce-e6-cat-btn active"><span>LOOP</span></button>
          <button class="ce-e6-cat-btn"><span>FIELD</span></button>
          <button class="ce-e6-cat-btn"><span>TRACK</span></button>
        </div>
        <button class="ce-e6-x">✕</button>
      </div>
    </article>

    <!-- Capability chips strip below the card. Each chip's data-since
         flips to .on at its first appearance era. -->
    <div class="ce-caps">
      <span class="ce-caps-lbl">Card verbs</span>
      <ul class="ce-caps-list">
        <li data-since="1"><span>Queue</span></li>
        <li data-since="1"><span>Listen →</span></li>
        <li data-since="2"><span>Waveform</span></li>
        <li data-since="2"><span>▶ Audition</span></li>
        <li data-since="3"><span>Click waveform = play</span></li>
        <li data-since="4"><span>Bucket J/L/F/T</span></li>
        <li data-since="4"><span>Expand panel</span></li>
        <li data-since="4"><span>Inline rename</span></li>
        <li data-since="4"><span>Hold ✕ to archive</span></li>
        <li data-since="5"><span>✂ Crop loop</span></li>
        <li data-since="5"><span>Split stems</span></li>
        <li data-since="5"><span>Spectrogram</span></li>
        <li data-since="5"><span>→ Promote to Live</span></li>
        <li data-since="6"><span>→ Send to Engineer</span></li>
      </ul>
    </div>
  </div>

  <!-- RIGHT: scrubber + era meta -->
  <div class="ce-controls">
    <ol class="ce-dots" role="listbox" aria-label="Era">
      {Array.from({ length: 7 }).map((_, i) => (
        <li>
          <button
            type="button"
            class={`ce-dot ${i === 6 ? "active" : ""}`}
            data-ce-era={String(i)}
            aria-label={`Era ${i}`}
          >{i}</button>
        </li>
      ))}
    </ol>
    <input
      type="range"
      min="0"
      max="6"
      step="1"
      value="6"
      class="ce-slider"
      data-ce-slider
      aria-label="Capability era"
    />
    <div class="ce-meta">
      <p class="ce-meta-eyebrow" data-ce-eyebrow>E6 · 2026-05-22 · TODAY</p>
      <h4 class="ce-meta-title" data-ce-title>The card opens a pipeline</h4>
      <p class="ce-meta-since" data-ce-since>New this era: <strong>→ Send to Engineer</strong> — one click hands the row to the mix agent. Six variants render across three taste axes for A/B feedback.</p>
      <p class="ce-meta-note" data-ce-note>Fewer pages, more verbs per row. The portal is now three tabs (Buckets / Projects / Engineer / Diary) — five tabs collapsed because the card carries the work.</p>
      <p class="ce-meta-commit" data-ce-commit>d5c8871 · engineer ships to production</p>
    </div>
  </div>
</div>

<script>
  const ERAS = [
    {
      eyebrow: "E0 · 2026-05-12 · DAY ZERO",
      title: "A portfolio that couldn't play audio",
      since: "What this era could DO: open a case study page. That's it. The card was a homepage list item linking to a Notion-rendered article.",
      note: "There was no portal, no catalog, no playback. Just a public site with case studies fetched from a Notion database at build time.",
      commit: "6666ed3 · Initial portfolio with Notion-backed content",
    },
    {
      eyebrow: "E1 · 2026-05-15 · FIRST PORTAL",
      title: "Filename + metadata + a separate Listen page",
      since: "New this era: the row exists. <strong>Queue</strong> for later, <strong>Listen →</strong> opens a dedicated Listen page. Nothing happens inside the card itself.",
      note: "The portal had five tabs: Surprise, Library, Workbench, Projects, Listen. The card was a pointer, not a tool. Lots of pages, almost no functionality per row.",
      commit: "d79f9b2 · publish: portal v1 with Card.astro",
    },
    {
      eyebrow: "E2 · 2026-05-17 · WAVEFORM ARRIVES",
      title: "The row earns a visual fingerprint",
      since: "New this era: <strong>Waveform image</strong> (640×80 PNG from the engine's sweeper). A dedicated <strong>▶ Audition</strong> button. <strong>Bucket badges</strong> (Inbox / Voice Memo / Loop / Song / Trash).",
      note: "First BucketCard. Triage finally has a shape, but the play button still lives in the row toolbar. The waveform is decorative; clicking it does nothing.",
      commit: "d47581f · publish: Buckets surface with BucketCard",
    },
    {
      eyebrow: "E3 · 2026-05-18 · THE WAVEFORM PLAYS",
      title: "The card becomes alive",
      since: "New this era: <strong>Click the waveform</strong> to play from the start. Click again to seek. Spacebar toggles. The dedicated ▶ button got deleted. The visual is the verb.",
      note: "First time the catalog felt like a player, not a database browser. Long voice memos (a 2-hour drive ramble) could be navigated to a specific peak in seconds.",
      commit: "de712c2 · waveform as the play surface",
    },
    {
      eyebrow: "E4 · 2026-05-18 · THE CARD CARRIES META",
      title: "Bucket. Expand. Rename.",
      since: "New this era: <strong>J/L/F/T pill</strong> bucketing in one click. <strong>Expand panel</strong> with tags, tech, lineage. <strong>Inline rename</strong> on the title. <strong>Hold ✕ to archive</strong> (0.45s, soft-delete with undo).",
      note: "Surprise + Library got 307-redirected into Buckets the same evening. Five portal tabs collapsed into three because the card now did what the old tabs were supposed to.",
      commit: "61b99b3 · publish: Buckets unified browse + triage",
    },
    {
      eyebrow: "E5 · 2026-05-21 · THE CARD CARRIES TOOLS",
      title: "Crop. Split. Promote.",
      since: "New this era: <strong>✂ Crop tool</strong> on the waveform — slice a loop out of a 30-min jam. <strong>Stem split</strong> (2-stem vox/inst, 4-stem drm/bass/vox/oth). <strong>Spectrogram</strong> preview. <strong>→ Promote to Live</strong> copies + loudnorms into Ableton's own browser.",
      note: "The card became a workbench. Pages disappeared — Workbench and Promote routes got hidden because every card now offered what those tabs offered. The row is the verb.",
      commit: "c1b81f5 · publish: jam cropper, stem splitter, promote-to-live",
    },
    {
      eyebrow: "E6 · 2026-05-22 · CARD → PIPELINE",
      title: "The card opens a pipeline",
      since: "New this era: <strong>→ Send to Engineer</strong>. One click hands the row to a mix agent that renders six variants across three taste axes. A/B pair-tinder feedback. Cross-axis memory.",
      note: "From a Squarespace-style list of filenames to a row that can play, crop, split, promote, and trigger a downstream rendering pipeline. The portal tab count went from 5 to 4 (and the cards do more than the original 5 did combined).",
      commit: "d5c8871 · Engineer (Build 5) ships to production",
    },
  ];

  const stage = document.querySelector<HTMLElement>("[data-ce-stage]");
  const card = stage?.querySelector<HTMLElement>("[data-ce-card]");
  const slider = stage?.querySelector<HTMLInputElement>("[data-ce-slider]");
  const dots = stage?.querySelectorAll<HTMLElement>(".ce-dot");
  const eyebrow = stage?.querySelector<HTMLElement>("[data-ce-eyebrow]");
  const title = stage?.querySelector<HTMLElement>("[data-ce-title]");
  const since = stage?.querySelector<HTMLElement>("[data-ce-since]");
  const note = stage?.querySelector<HTMLElement>("[data-ce-note]");
  const commit = stage?.querySelector<HTMLElement>("[data-ce-commit]");
  const caps = stage?.querySelectorAll<HTMLElement>(".ce-caps-list li");

  const apply = (idx: number) => {
    if (!card) return;
    const i = Math.max(0, Math.min(6, idx));
    card.dataset.era = String(i);
    if (slider) slider.value = String(i);
    dots?.forEach((d) => d.classList.toggle("active", Number(d.dataset.ceEra) === i));
    const e = ERAS[i];
    if (eyebrow) eyebrow.textContent = e.eyebrow;
    if (title) title.textContent = e.title;
    if (since) since.innerHTML = e.since;
    if (note) note.textContent = e.note;
    if (commit) commit.textContent = e.commit;
    caps?.forEach((li) => {
      const sinceEra = Number(li.dataset.since ?? "999");
      li.classList.toggle("on", i >= sinceEra);
      // Mark the chip(s) that JUST appeared in this era so they get a brief
      // glow as the user enters the era.
      li.classList.toggle("just", i === sinceEra);
    });
  };

  slider?.addEventListener("input", (e) => {
    apply(Number((e.target as HTMLInputElement).value));
  });
  dots?.forEach((d) => {
    d.addEventListener("click", () => apply(Number(d.dataset.ceEra)));
  });

  // Auto-walkthrough — start at E0, walk to E6 with a beat between each
  // step. Aborts on first user interaction.
  let touched = false;
  const onTouch = () => { touched = true; };
  slider?.addEventListener("pointerdown", onTouch, { once: true });
  dots?.forEach((d) => d.addEventListener("click", onTouch, { once: true }));

  const io = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (!e.isIntersecting) continue;
      apply(0);
      let i = 0;
      const step = () => {
        if (touched) return;
        i = Math.min(6, i + 1);
        apply(i);
        if (i < 6) window.setTimeout(step, 1400);
      };
      window.setTimeout(step, 900);
      io.disconnect();
    }
  }, { threshold: 0.4 });
  if (stage) io.observe(stage);
</script>

<style>
  /* Stage */
  .ce-stage {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(300px, 1fr);
    gap: 40px;
    align-items: start;
  }
  @media (max-width: 980px) {
    .ce-stage { grid-template-columns: 1fr; }
  }

  .ce-card-frame {
    background:
      radial-gradient(80% 60% at 50% 0%, rgba(255, 90, 60, 0.10) 0%, transparent 70%),
      #07060c;
    padding: 32px 28px;
    border-radius: 6px;
    border: 1px solid rgba(245, 241, 232, 0.06);
    min-height: 360px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .ce-card {
    position: relative;
    transition: background 280ms ease, border-color 280ms ease;
    color: #f5f1e8;
    font-family: "Geist Variable", ui-sans-serif, system-ui, sans-serif;
  }

  /* Hide ALL era subtrees by default; the data-era selector reveals one. */
  .ce-card > [class^="ce-e"] { display: none; }
  .ce-card[data-era="0"] > .ce-e0 { display: block; }
  .ce-card[data-era="1"] > .ce-e1 { display: block; }
  .ce-card[data-era="2"] > .ce-e2 { display: block; }
  .ce-card[data-era="3"] > .ce-e3 { display: block; }
  .ce-card[data-era="4"] > .ce-e4 { display: grid; }
  .ce-card[data-era="5"] > .ce-e5 { display: grid; }
  .ce-card[data-era="6"] > .ce-e6 { display: grid; }

  /* Shared fake waveform — used by eras 2–6. */
  .ce-fake-wave {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 0 6px;
  }
  .ce-fake-bar {
    flex: 1 1 0;
    background: linear-gradient(180deg, rgba(14, 196, 252, 0.65) 0%, rgba(14, 196, 252, 0.35) 100%);
    border-radius: 1px;
    transition: background 320ms ease;
  }
  .ce-fake-wave-mid .ce-fake-bar {
    background: linear-gradient(180deg, rgba(245, 241, 232, 0.55) 0%, rgba(245, 241, 232, 0.18) 100%);
  }

  /* ─────────── E0 ─────────── public-site WorkCard era */
  .ce-e0 {
    background: #f5f1e8;
    color: #15130f;
    padding: 36px 32px;
    border-radius: 0;
    font-family: "Geist Variable", ui-sans-serif, system-ui, sans-serif;
    border: 1px solid #cdc4b3;
  }
  .ce-e0-num {
    font-family: ui-monospace, monospace;
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #7a746c;
    margin-bottom: 12px;
  }
  .ce-e0-title {
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-size: 36px;
    font-weight: 700;
    line-height: 1;
    color: #15130f;
    margin: 0 0 14px;
  }
  .ce-e0-sub {
    font-size: 16px;
    color: #5a5650;
    margin: 0 0 14px;
    max-width: 30ch;
    line-height: 1.4;
  }
  .ce-e0-tags {
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #7a746c;
    margin: 0 0 22px;
    font-family: ui-monospace, monospace;
  }
  .ce-e0-link {
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #ff5a3c;
    text-decoration: none;
    border-bottom: 1px solid #ff5a3c;
    padding-bottom: 2px;
    font-weight: 700;
  }

  /* ─────────── E1 ─────────── first portal Card.astro */
  .ce-e1 {
    background: rgba(245, 241, 232, 0.04);
    border: 1px solid rgba(245, 241, 232, 0.18);
    padding: 22px 24px;
    display: grid;
    gap: 12px;
    color: #f5f1e8;
  }
  .ce-e1-meta {
