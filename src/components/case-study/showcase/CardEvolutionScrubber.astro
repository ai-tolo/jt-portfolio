---
// "The card grew up" — capability-evolution scrubber.
//
// This is the spine of the case study. Each era is a real git commit
// where the card gained a capability the previous era couldn't do.
// The visual shifts are real but secondary — the headline is *what the
// row could DO* at each stage. Drag the slider to walk through history.
//
// Sources: lifted markup + the surviving CSS conventions per era from
// these commits on the jt-portfolio repo:
//   E0  6666ed3  2026-05-12  Initial portfolio (no portal, no playback)
//   E1  d79f9b2  2026-05-15  First portal Card: filename + metadata + Listen link
//   E2  d47581f  2026-05-17  BucketCard arrives: waveform image + ▶ Audition btn
//   E3  de712c2  2026-05-18  Waveform doubles as play surface; ▶ btn deleted
//   E4  61b99b3  2026-05-18  Expand panel (tags + tech + lineage); J/L/F/T bucketing
//   E5  c1b81f5  2026-05-21  Crop tool (✂), stem split (2/4), spectrogram, lineage chips
//   E6  d5c8871  2026-05-21  "→ Send to Engineer" button — card opens a pipeline
---

<div class="ce-stage" data-ce-stage>
  <!-- LEFT: real card markup for the current era. -->
  <div class="ce-card-frame">
    <!-- The wrapper carries data-era which scopes the per-era stylesheet
         below. Markup is the union of all eras' DOM; per-era CSS hides
         what doesn't belong. -->
    <article class="ce-card" data-ce-card data-era="0">
      <!-- ───── E0 ───── public portfolio WorkCard (no portal yet) -->
      <div class="ce-e0">
        <div class="ce-e0-num">02</div>
        <h3 class="ce-e0-title">Audio Atlas</h3>
        <p class="ce-e0-sub">A creative archive that doesn't try to be creative for me.</p>
        <p class="ce-e0-tags"><span>AI Tooling</span> · <span>Web</span> · <span>Shipped</span></p>
        <p class="ce-e0-meta">An ordinary homepage list item. The entire card was the link. No portal, no playback, no catalog underneath.</p>
      </div>

      <!-- ───── E1 ───── First portal Card.astro -->
      <div class="ce-e1">
        <header class="ce-e1-meta">
          <span class="ce-e1-eyebrow">VOICE MEMO</span>
          <span class="ce-e1-date">Oct 23, 2024</span>
        </header>
        <h3 class="ce-e1-title">VOX_Tolo_0007.wav</h3>
        <p class="ce-e1-summary">A short voice memo, captured between sets. Possible lyric fragment.</p>
        <p class="ce-e1-audio"><span>0:30</span> · <span>VOICE-NOTE</span></p>
        <ul class="ce-e1-tags">
          <li>voice-memo</li><li>idea-fragment</li><li>first-person</li>
        </ul>
        <footer class="ce-e1-actions">
          <button type="button" class="ce-e1-queue">+ Queue</button>
          <a class="ce-e1-listen" href="#">Listen →</a>
        </footer>
      </div>

      <!-- ───── E2 ───── First BucketCard: waveform image + dedicated ▶ -->
      <div class="ce-e2">
        <div class="ce-e2-wave">
          <div class="ce-fake-wave ce-fake-wave-mid" aria-hidden="true">
            {Array.from({ length: 56 }).map((_, i) => {
              const h = 36 + Math.round(30 * Math.sin(i * 0.42) + 18 * Math.cos(i * 0.83));
              return <span class="ce-fake-bar" style={`height:${Math.max(20, Math.min(96, h))}%`}></span>;
            })}
          </div>
        </div>
        <header class="ce-e2-head">
          <h3 class="ce-e2-title">NOIZU_125_shaker_loop_tight_01.wav</h3>
          <button type="button" class="ce-e2-play" aria-label="Audition">▶ <span class="ce-e2-kbd">Space</span></button>
        </header>
        <div class="ce-e2-bucket-row">
          <span class="ce-e2-badge">Loop</span>
          <span class="ce-e2-kbds"><kbd>V</kbd><kbd>L</kbd><kbd>S</kbd><kbd>X</kbd></span>
        </div>
      </div>

      <!-- ───── E3 ───── Waveform IS the play surface -->
      <div class="ce-e3">
        <h3 class="ce-e3-title">NOIZU_125_shaker_loop_tight_01<span class="ce-e3-ext">.wav</span></h3>
        <div class="ce-e3-wave-row">
          <span class="ce-e3-dur">0:04</span>
          <div class="ce-e3-wave">
            <div class="ce-fake-wave" aria-hidden="true">
              {Array.from({ length: 56 }).map((_, i) => {
                const h = 36 + Math.round(30 * Math.sin(i * 0.42) + 18 * Math.cos(i * 0.83));
                return <span class="ce-fake-bar" style={`height:${Math.max(20, Math.min(96, h))}%`}></span>;
              })}
            </div>
            <div class="ce-e3-playhead"></div>
          </div>
        </div>
        <span class="ce-e3-badge">Loop</span>
      </div>

      <!-- ───── E4 ───── J/L/F/T bucketing + expand panel -->
      <div class="ce-e4">
        <div class="ce-e4-main">
          <h3 class="ce-e4-title">NOIZU_125_shaker_loop_tight_01<span class="ce-e4-ext">.wav</span></h3>
          <div class="ce-e4-wave-row">
            <span class="ce-e4-dur">0:04</span>
            <div class="ce-e4-wave">
              <div class="ce-fake-wave" aria-hidden="true">
                {Array.from({ length: 56 }).map((_, i) => {
                  const h = 36 + Math.round(30 * Math.sin(i * 0.42) + 18 * Math.cos(i * 0.83));
                  return <span class="ce-fake-bar" style={`height:${Math.max(20, Math.min(96, h))}%`}></span>;
                })}
              </div>
            </div>
          </div>
          <button type="button" class="ce-e4-date">
            <span>1y</span> <span>[06-15-2024]</span> <span class="ce-e4-chev">▾</span>
          </button>
          <dl class="ce-e4-exp">
            <dt>TAGS</dt><dd><span class="ce-e4-chip">○ PUBLIC</span><span class="ce-e4-chip">loop</span><span class="ce-e4-chip">sample</span></dd>
            <dt>TECH</dt><dd><span class="ce-e4-cy">99</span> BPM · <span class="ce-e4-cy">E</span> major</dd>
            <dt>LINEAGE</dt><dd>from sample: <span class="ce-e4-link">NOIZU pack v3</span></dd>
          </dl>
        </div>
        <div class="ce-e4-cat" role="group">
          <button class="ce-e4-cat-btn"><span>JAM</span></button>
          <button class="ce-e4-cat-btn active"><span>LOOP</span></button>
          <button class="ce-e4-cat-btn"><span>FIELD</span></button>
          <button class="ce-e4-cat-btn"><span>TRACK</span></button>
        </div>
        <button class="ce-e4-x">✕</button>
      </div>

      <!-- ───── E5 ───── ✂ crop tool is ACTIVE on the waveform.
            Visually distinct from E4 because the small waveform got
            replaced by a tall crop surface with frame + handles + bar
            grid. The card is mid-tool. -->
      <div class="ce-e5">
        <div class="ce-e5-shell">
          <header class="ce-e5-shell-head">
            <h3 class="ce-e5-title">rainforest_post_karoke<span class="ce-e5-ext">.als → wav</span></h3>
            <span class="ce-e5-shell-meta">5:42 · 100 BPM · key Em · 142 bars</span>
          </header>
          <!-- Crop surface (active). Frame at bars 32-44 (12-bar chunk). -->
          <div class="ce-e5-crop-wave">
            <div class="ce-fake-wave" aria-hidden="true">
              {Array.from({ length: 110 }).map((_, i) => {
                const t = i / 110;
                const env = (t < 0.1) ? 0.32 : (t < 0.3) ? 0.6 + 0.15 * Math.sin(i * 0.21) : (t < 0.55) ? 0.82 + 0.10 * Math.cos(i * 0.18) : (t < 0.75) ? 0.62 + 0.16 * Math.sin(i * 0.17) : 0.42;
                const h = Math.max(8, Math.min(96, env * 96 + 4 * Math.sin(i * 0.7)));
                return <span class="ce-fake-bar" style={`height:${h}%`}></span>;
              })}
            </div>
            <!-- Bar-grid ticks -->
            <div class="ce-e5-ticks" aria-hidden="true">
              {Array.from({ length: 16 }).map((_, i) => (
                <span class="ce-e5-tick" style={`left:${(i / 16) * 100}%`}></span>
              ))}
            </div>
            <!-- Dimmed masks outside the frame -->
            <div class="ce-e5-mask ce-e5-mask-left"></div>
            <div class="ce-e5-mask ce-e5-mask-right"></div>
            <!-- Crop frame -->
            <div class="ce-e5-frame">
              <span class="ce-e5-handle ce-e5-handle-l"><span class="ce-e5-htime">1:18</span></span>
              <span class="ce-e5-bar-count">12 bars · 28.8s</span>
              <span class="ce-e5-handle ce-e5-handle-r"><span class="ce-e5-htime">1:48</span></span>
            </div>
          </div>
          <div class="ce-e5-toolbar">
            <button class="ce-e5-tbtn ce-e5-play">▶ play loop</button>
            <button class="ce-e5-tbtn ce-e5-snap">⌘ snap bars</button>
            <span class="ce-e5-readout">12 bars · 28.8s · 1:18 → 1:48</span>
            <button class="ce-e5-tbtn ce-e5-export">✂ export</button>
          </div>
          <div class="ce-e5-stem-row">
            <span class="ce-e5-stem-lbl">STEMS</span>
            <button class="ce-e5-stem-btn">2-stem<small>vox · inst</small></button>
            <button class="ce-e5-stem-btn">4-stem<small>drm · bass · vox · oth</small></button>
            <span class="ce-e5-stem-flag">▾ async Demucs · ~30s on M1</span>
          </div>
        </div>
      </div>

      <!-- ───── E6 ───── card opens a pipeline. The source card is at
            the top; downstream you can see six variants rendering with
            a tinder-style A/B pair card emerging from the catalog. -->
      <div class="ce-e6">
        <!-- The compact source card (much smaller, just to anchor) -->
        <article class="ce-e6-source">
          <h3 class="ce-e6-source-title">rainforest_post_karoke (chorus 1)<span class="ce-e6-ext">.wav</span></h3>
          <span class="ce-e6-source-tech">100 BPM · Em · 0:18 · LOOP</span>
          <button class="ce-e6-eng">→ Send to Engineer</button>
        </article>
        <!-- Pipeline arrow -->
        <div class="ce-e6-arrow" aria-hidden="true">
          <span class="ce-e6-arrow-lbl">analyze · plan · render</span>
          <span class="ce-e6-arrow-glyph">▼</span>
        </div>
        <!-- Six variants rendering -->
        <ol class="ce-e6-variants" role="list">
          <li class="ce-e6-var ce-e6-var-done"><span class="ce-e6-var-pole">focal · forward_bright</span><span class="ce-e6-var-state">ready</span></li>
          <li class="ce-e6-var ce-e6-var-done"><span class="ce-e6-var-pole">focal · recessed_warm</span><span class="ce-e6-var-state">ready</span></li>
          <li class="ce-e6-var ce-e6-var-running"><span class="ce-e6-var-pole">space · punchy_dry</span><span class="ce-e6-var-state">rendering 47%</span></li>
          <li class="ce-e6-var ce-e6-var-running"><span class="ce-e6-var-pole">space · spacious_wet</span><span class="ce-e6-var-state">rendering 32%</span></li>
          <li class="ce-e6-var ce-e6-var-queued"><span class="ce-e6-var-pole">dynamics · modern_compressed</span><span class="ce-e6-var-state">queued</span></li>
          <li class="ce-e6-var ce-e6-var-queued"><span class="ce-e6-var-pole">dynamics · vintage_open</span><span class="ce-e6-var-state">queued</span></li>
        </ol>
        <!-- A/B Pair card emerging from the catalog -->
        <article class="ce-e6-pair">
          <header class="ce-e6-pair-head">
            <span class="ce-e6-pair-axis">FOCAL · READY TO JUDGE</span>
          </header>
          <div class="ce-e6-pair-row">
            <div class="ce-e6-pair-side ce-e6-pair-a">
              <span class="ce-e6-pair-key">A</span>
              <span class="ce-e6-pair-label">forward_bright</span>
            </div>
            <div class="ce-e6-pair-side ce-e6-pair-b">
              <span class="ce-e6-pair-key">B</span>
              <span class="ce-e6-pair-label">recessed_warm</span>
            </div>
          </div>
          <p class="ce-e6-pair-cap">audio tinder · cross-axis memory</p>
        </article>
      </div>
    </article>

    <!-- Capability chips strip below the card. Each chip's data-since
         flips to .on at its first appearance era. -->
    <div class="ce-caps">
      <span class="ce-caps-lbl">Card verbs</span>
      <ul class="ce-caps-list">
        <li data-since="1"><span>Queue</span></li>
        <li data-since="1"><span>Listen →</span></li>
        <li data-since="2"><span>Waveform</span></li>
        <li data-since="2"><span>▶ Audition</span></li>
        <li data-since="3"><span>Click waveform = play</span></li>
        <li data-since="4"><span>Bucket J/L/F/T</span></li>
        <li data-since="4"><span>Expand panel</span></li>
        <li data-since="4"><span>Inline rename</span></li>
        <li data-since="4"><span>Hold ✕ to archive</span></li>
        <li data-since="5"><span>✂ Crop loop</span></li>
        <li data-since="5"><span>Split stems</span></li>
        <li data-since="5"><span>Spectrogram</span></li>
        <li data-since="5"><span>→ Promote to Live</span></li>
        <li data-since="6"><span>→ Send to Engineer</span></li>
      </ul>
    </div>
  </div>

  <!-- RIGHT: scrubber + era meta -->
  <div class="ce-controls">
    <div class="ce-track-wrap" role="group" aria-label="Era scrubber">
      <button
        type="button"
        class="ce-track-arrow"
        data-ce-step="-1"
        aria-label="Previous era"
      >←</button>

      <div class="ce-track">
        <div class="ce-track-line" aria-hidden="true"></div>
        <input
          type="range"
          min="0"
          max="6"
          step="1"
          value="0"
          class="ce-slider"
          data-ce-slider
          aria-label="Capability era"
        />
        <ol class="ce-dots" role="tablist" aria-label="Era">
          {Array.from({ length: 7 }).map((_, i) => (
            <li class="ce-dot-slot" style={`--pos: ${(i / 6) * 100}%`}>
              <button
                type="button"
                class={`ce-dot ${i === 0 ? "active" : ""}`}
                data-ce-era={String(i)}
                role="tab"
                aria-selected={i === 0 ? "true" : "false"}
                aria-label={`Era ${i}`}
              >{i}</button>
            </li>
          ))}
        </ol>
      </div>

      <button
        type="button"
        class="ce-track-arrow ce-track-arrow-next"
        data-ce-step="1"
        data-ce-beacon
        aria-label="Next era"
      >→</button>
    </div>
    <div class="ce-meta">
      <p class="ce-meta-eyebrow" data-ce-eyebrow>E0 · 2026-05-12 · DAY ZERO</p>
      <h4 class="ce-meta-title" data-ce-title>A portfolio that couldn't play audio</h4>
      <p class="ce-meta-since" data-ce-since>What this era could DO: open a case study page. That's it. The card was a homepage list item linking to a Notion-rendered article.</p>
      <p class="ce-meta-note" data-ce-note>There was no portal, no catalog, no playback. Just a public site with case studies fetched from a Notion database at build time.</p>
      <p class="ce-meta-commit" data-ce-commit>6666ed3 · Initial portfolio with Notion-backed content</p>
    </div>
  </div>
</div>

<script>
  const ERAS = [
    {
      eyebrow: "E0 · 2026-05-12 · DAY ZERO",
      title: "A portfolio that couldn't play audio",
      since: "What this era could DO: open a case study page. That's it. The card was a homepage list item linking to a Notion-rendered article.",
      note: "There was no portal, no catalog, no playback. Just a public site with case studies fetched from a Notion database at build time.",
      commit: "6666ed3 · Initial portfolio with Notion-backed content",
    },
    {
      eyebrow: "E1 · 2026-05-15 · FIRST PORTAL",
      title: "Filename + metadata + a separate Listen page",
      since: "New this era: the row exists. <strong>Queue</strong> for later, <strong>Listen →</strong> opens a dedicated Listen page. Nothing happens inside the card itself.",
      note: "The portal had five tabs: Surprise, Library, Workbench, Projects, Listen. The card was a pointer, not a tool. Lots of pages, almost no functionality per row.",
      commit: "d79f9b2 · publish: portal v1 with Card.astro",
    },
    {
      eyebrow: "E2 · 2026-05-17 · WAVEFORM ARRIVES",
      title: "The row earns a visual fingerprint",
      since: "New this era: <strong>Waveform image</strong> (640×80 PNG from the engine's sweeper). A dedicated <strong>▶ Audition</strong> button. <strong>Bucket badges</strong> (Inbox / Voice Memo / Loop / Song / Trash).",
      note: "First BucketCard. Triage finally has a shape, but the play button still lives in the row toolbar. The waveform is decorative; clicking it does nothing.",
      commit: "d47581f · publish: Buckets surface with BucketCard",
    },
    {
      eyebrow: "E3 · 2026-05-18 · THE WAVEFORM PLAYS",
      title: "The card becomes alive",
      since: "New this era: <strong>Click the waveform</strong> to play from the start. Click again to seek. Spacebar toggles. The dedicated ▶ button got deleted. The visual is the verb.",
      note: "First time the catalog felt like a player, not a database browser. Long voice memos (a 2-hour drive ramble) could be navigated to a specific peak in seconds.",
      commit: "de712c2 · waveform as the play surface",
    },
    {
      eyebrow: "E4 · 2026-05-18 · THE CARD CARRIES META",
      title: "Bucket. Expand. Rename.",
      since: "New this era: <strong>J/L/F/T pill</strong> bucketing in one click. <strong>Expand panel</strong> with tags, tech, lineage. <strong>Inline rename</strong> on the title. <strong>Hold ✕ to archive</strong> (0.45s, soft-delete with undo).",
      note: "Surprise + Library got 307-redirected into Buckets the same evening. Five portal tabs collapsed into three because the card now did what the old tabs were supposed to.",
      commit: "61b99b3 · publish: Buckets unified browse + triage",
    },
    {
      eyebrow: "E5 · 2026-05-21 · THE CARD CARRIES TOOLS",
      title: "Crop. Split. Promote.",
      since: "New this era: <strong>✂ Crop tool</strong> on the waveform — slice a loop out of a 30-min jam. <strong>Stem split</strong> (2-stem vox/inst, 4-stem drm/bass/vox/oth). <strong>Spectrogram</strong> preview. <strong>→ Promote to Live</strong> copies + loudnorms into Ableton's own browser.",
      note: "The card became a workbench. Pages disappeared — Workbench and Promote routes got hidden because every card now offered what those tabs offered. The row is the verb.",
      commit: "c1b81f5 · publish: jam cropper, stem splitter, promote-to-live",
    },
    {
      eyebrow: "E6 · 2026-05-22 · CARD → PIPELINE",
      title: "The card opens a pipeline",
      since: "New this era: <strong>→ Send to Engineer</strong>. One click hands the row to a mix agent that renders six variants across three taste axes. A/B pair-tinder feedback. Cross-axis memory.",
      note: "From a Squarespace-style list of filenames to a row that can play, crop, split, promote, and trigger a downstream rendering pipeline. The portal tab count went from 5 to 4 (and the cards do more than the original 5 did combined).",
      commit: "d5c8871 · Engineer (Build 5) ships to production",
    },
  ];

  const stage = document.querySelector<HTMLElement>("[data-ce-stage]");
  const card = stage?.querySelector<HTMLElement>("[data-ce-card]");
  const slider = stage?.querySelector<HTMLInputElement>("[data-ce-slider]");
  const dots = stage?.querySelectorAll<HTMLElement>(".ce-dot");
  const eyebrow = stage?.querySelector<HTMLElement>("[data-ce-eyebrow]");
  const title = stage?.querySelector<HTMLElement>("[data-ce-title]");
  const since = stage?.querySelector<HTMLElement>("[data-ce-since]");
  const note = stage?.querySelector<HTMLElement>("[data-ce-note]");
  const commit = stage?.querySelector<HTMLElement>("[data-ce-commit]");
  const caps = stage?.querySelectorAll<HTMLElement>(".ce-caps-list li");

  const apply = (idx: number) => {
    if (!card) return;
    const i = Math.max(0, Math.min(6, idx));
    card.dataset.era = String(i);
    if (slider) slider.value = String(i);
    dots?.forEach((d) => d.classList.toggle("active", Number(d.dataset.ceEra) === i));
    const e = ERAS[i];
    if (eyebrow) eyebrow.textContent = e.eyebrow;
    if (title) title.textContent = e.title;
    if (since) since.innerHTML = e.since;
    if (note) note.textContent = e.note;
    if (commit) commit.textContent = e.commit;
    caps?.forEach((li) => {
      const sinceEra = Number(li.dataset.since ?? "999");
      li.classList.toggle("on", i >= sinceEra);
      // Mark the chip(s) that JUST appeared in this era so they get a brief
      // glow as the user enters the era.
      li.classList.toggle("just", i === sinceEra);
    });
  };

  let currentEra = 0;
  const beaconTargets = stage?.querySelectorAll<HTMLElement>("[data-ce-beacon]") ?? [];
  let beaconStopped = false;
  const stopBeacon = () => {
    if (beaconStopped) return;
    beaconStopped = true;
    beaconTargets.forEach((b) => b.removeAttribute("data-ce-beacon"));
  };

  const applyAndTrack = (i: number) => {
    currentEra = Math.max(0, Math.min(6, i));
    apply(currentEra);
    // Keep aria-selected in sync on dots (apply only swaps "active").
    dots?.forEach((d) => {
      const on = Number(d.dataset.ceEra) === currentEra;
      d.setAttribute("aria-selected", on ? "true" : "false");
    });
  };

  // Any user interaction with the scrubber kills the beacon — the user
  // has shown they know how to drive it.
  slider?.addEventListener("input", (e) => {
    stopBeacon();
    applyAndTrack(Number((e.target as HTMLInputElement).value));
  });
  dots?.forEach((d) => {
    d.addEventListener("click", () => {
      stopBeacon();
      applyAndTrack(Number(d.dataset.ceEra));
    });
  });

  // Prev / next chevrons on either side of the track.
  const arrows = stage?.querySelectorAll<HTMLButtonElement>("[data-ce-step]") ?? [];
  arrows.forEach((a) => {
    a.addEventListener("click", () => {
      stopBeacon();
      applyAndTrack(currentEra + Number(a.dataset.ceStep || 0));
    });
  });

  // Document-level arrow-key navigation when the scrubber is on screen.
  // Skipped inside inputs / contenteditable so we don't interfere with
  // typing elsewhere on the page.
  document.addEventListener("keydown", (e) => {
    if (e.metaKey || e.ctrlKey || e.altKey || e.shiftKey) return;
    if (e.key !== "ArrowLeft" && e.key !== "ArrowRight") return;
    const t = e.target as HTMLElement | null;
    const tag = t?.tagName?.toLowerCase();
    if (tag === "input" || tag === "textarea" || t?.isContentEditable) return;
    if (!stage) return;
    const r = stage.getBoundingClientRect();
    if (r.bottom < 0 || r.top > window.innerHeight) return;
    e.preventDefault();
    stopBeacon();
    applyAndTrack(currentEra + (e.key === "ArrowRight" ? 1 : -1));
  });
</script>

<style>
  /* Stage */
  .ce-stage {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(300px, 1fr);
    gap: 40px;
    align-items: start;
  }
  @media (max-width: 980px) {
    .ce-stage { grid-template-columns: 1fr; }
  }

  .ce-card-frame {
    background:
      radial-gradient(80% 60% at 50% 0%, rgba(255, 90, 60, 0.10) 0%, transparent 70%),
      #07060c;
    padding: 32px 28px;
    border-radius: 6px;
    border: 1px solid rgba(245, 241, 232, 0.06);
    min-height: 360px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .ce-card {
    position: relative;
    transition: background 280ms ease, border-color 280ms ease;
    color: #f5f1e8;
    font-family: "Geist Variable", ui-sans-serif, system-ui, sans-serif;
  }

  /* Hide ALL era subtrees by default; the data-era selector reveals one. */
  .ce-card > [class^="ce-e"] { display: none; }
  .ce-card[data-era="0"] > .ce-e0 { display: block; }
  .ce-card[data-era="1"] > .ce-e1 { display: block; }
  .ce-card[data-era="2"] > .ce-e2 { display: block; }
  .ce-card[data-era="3"] > .ce-e3 { display: block; }
  .ce-card[data-era="4"] > .ce-e4 { display: grid; }
  .ce-card[data-era="5"] > .ce-e5 { display: block; }
  .ce-card[data-era="6"] > .ce-e6 { display: block; }

  /* Shared fake waveform — used by eras 2–6. */
  .ce-fake-wave {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 0 6px;
  }
  .ce-fake-bar {
    flex: 1 1 0;
    background: linear-gradient(180deg, rgba(14, 196, 252, 0.65) 0%, rgba(14, 196, 252, 0.35) 100%);
    border-radius: 1px;
    transition: background 320ms ease;
  }
  .ce-fake-wave-mid .ce-fake-bar {
    background: linear-gradient(180deg, rgba(245, 241, 232, 0.55) 0%, rgba(245, 241, 232, 0.18) 100%);
  }

  /* ─────────── E0 ─────────── public-site WorkCard era */
  .ce-e0 {
    background: #f5f1e8;
    color: #15130f;
    padding: 36px 32px;
    border-radius: 0;
    font-family: "Geist Variable", ui-sans-serif, system-ui, sans-serif;
    border: 1px solid #cdc4b3;
  }
  .ce-e0-num {
    font-family: ui-monospace, monospace;
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #7a746c;
    margin-bottom: 12px;
  }
  .ce-e0-title {
    font-family: ui-sans-serif, system-ui, sans-serif;
    font-size: 36px;
    font-weight: 700;
    line-height: 1;
    color: #15130f;
    margin: 0 0 14px;
  }
  .ce-e0-sub {
    font-size: 16px;
    color: #5a5650;
    margin: 0 0 14px;
    max-width: 30ch;
    line-height: 1.4;
  }
  .ce-e0-tags {
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #7a746c;
    margin: 0 0 22px;
    font-family: ui-monospace, monospace;
  }
  .ce-e0-meta {
    font-family: ui-monospace, monospace;
    font-style: italic;
    font-size: 13px;
    color: rgba(245, 241, 232, 0.45);
    margin: 0;
    line-height: 1.55;
    max-width: 48ch;
  }

  /* ─────────── E1 ─────────── first portal Card.astro */
  .ce-e1 {
    background: rgba(245, 241, 232, 0.04);
    border: 1px solid rgba(245, 241, 232, 0.18);
    padding: 22px 24px;
    display: grid;
    gap: 12px;
    color: #f5f1e8;
  }
  .ce-e1-meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }
  .ce-e1-eyebrow {
    font-family: ui-monospace, monospace;
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(245, 241, 232, 0.48);
  }
  .ce-e1-date {
    font-family: ui-monospace, monospace;
    font-size: 11px;
    color: rgba(245, 241, 232, 0.48);
  }
  .ce-e1-title {
    font-size: 17px;
    font-weight: 600;
    word-break: break-all;
    margin: 0;
    line-height: 1.3;
  }
  .ce-e1-summary {
    font-size: 13px;
    line-height: 1.55;
    color: rgba(245, 241, 232, 0.78);
    margin: 0;
  }
  .ce-e1-audio {
    font-family: ui-monospace, monospace;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #ff5a3c;
    margin: 0;
  }
  .ce-e1-tags {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 6px;
  }
  .ce-e1-tags li {
    font-size: 11px;
    color: rgba(245, 241, 232, 0.62);
    border: 1px solid rgba(245, 241, 232, 0.18);
    padding: 2px 6px;
  }
  .ce-e1-actions {
    display: flex;
    gap: 10px;
    align-items: center;
    border-top: 1px solid rgba(245, 241, 232, 0.10);
    padding-top: 12px;
  }
  .ce-e1-queue,
  .ce-e1-listen {
    font-family: ui-monospace, monospace;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(245, 241, 232, 0.78);
    background: transparent;
    border: 1px solid rgba(245, 241, 232, 0.32);
    padding: 6px 12px;
    text-decoration: none;
    cursor: pointer;
  }
  .ce-e1-listen {
    color: #ff5a3c;
    border-color: rgba(255, 90, 60, 0.55);
  }

  /* ─────────── E2 ─────────── waveform image + dedicated ▶ Audition */
  .ce-e2 {
    background: rgba(245, 241, 232, 0.04);
    border: 1px solid rgba(245, 241, 232, 0.18);
    padding: 18px 20px;
    color: #f5f1e8;
  }
  .ce-e2-wave {
    position: relative;
    height: 80px;
    background: #07060c;
    border-radius: 3px;
    overflow: hidden;
    margin-bottom: 14px;
  }
  .ce-e2-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 10px;
  }
  .ce-e2-title {
    font-size: 15px;
    font-weight: 600;
    margin: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    min-width: 0;
  }
  .ce-e2-play {
    flex: 0 0 auto;
    font-family: ui-monospace, monospace;
    font-size: 12px;
    color: #ff5a3c;
    background: rgba(255, 90, 60, 0.06);
    border: 1px solid rgba(255, 90, 60, 0.45);
    padding: 5px 10px;
    cursor: pointer;
    border-radius: 2px;
  }
  .ce-e2-kbd {
    font-size: 9px;
    color: rgba(245, 241, 232, 0.55);
    margin-left: 6px;
    letter-spacing: 0.1em;
  }
  .ce-e2-bucket-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }
  .ce-e2-badge {
    font-family: ui-monospace, monospace;
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #ff2761;
    background: rgba(255, 39, 97, 0.10);
    border: 1px solid rgba(255, 39, 97, 0.45);
    padding: 3px 8px;
    border-radius: 2px;
  }
  .ce-e2-kbds {
    display: inline-flex;
    gap: 4px;
  }
  .ce-e2-kbds kbd {
    font-family: ui-monospace, monospace;
    font-size: 9px;
    color: rgba(245, 241, 232, 0.48);
    border: 1px solid rgba(245, 241, 232, 0.18);
    padding: 1px 4px;
    border-radius: 1px;
  }

  /* ─────────── E3 ─────────── waveform plays, ▶ button gone */
  .ce-e3 {
    background: rgba(245, 241, 232, 0.04);
    border: 1px solid rgba(245, 241, 232, 0.18);
    padding: 18px 20px;
    color: #f5f1e8;
    position: relative;
  }
  .ce-e3-title {
    font-family: ui-monospace, monospace;
    font-style: italic;
    font-size: 17px;
    font-weight: 700;
    color: #00ff4d;
    background: rgba(0, 255, 77, 0.04);
    border: 1px solid rgba(0, 255, 77, 0.32);
    border-radius: 4px;
    padding: 5px 10px;
    margin: 0 0 14px;
    display: inline-block;
    max-width: 100%;
    box-shadow: 0 0 12px rgba(0, 255, 77, 0.12);
  }
  .ce-e3-ext { color: #f5f1e8; opacity: 0.42; font-weight: 500; font-size: 0.6em; }
  .ce-e3-wave-row {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }
  .ce-e3-dur {
    font-family: ui-monospace, monospace;
    font-style: italic;
    font-size: 16px;
    font-weight: 700;
    color: #ff3b6e;
    min-width: 3.6em;
    text-align: right;
    text-shadow: 0 0 4px rgba(255, 59, 110, 0.65), 0 0 10px rgba(255, 59, 110, 0.35);
  }
  .ce-e3-wave {
    position: relative;
    flex: 1 1 auto;
    height: 48px;
    background: #07060c;
    border-radius: 3px;
    overflow: hidden;
    cursor: pointer;
  }
  .ce-e3-wave:hover {
    box-shadow: inset 0 0 0 1px rgba(14, 196, 252, 0.45);
  }
  .ce-e3-playhead {
    position: absolute;
    top: 0; bottom: 0;
    width: 2px;
    background: #ff3b6e;
    box-shadow: 0 0 6px rgba(255, 59, 110, 0.6);
    animation: ce-e3-play 4500ms linear infinite;
  }
  @keyframes ce-e3-play {
    from { left: 0%; }
    to { left: 100%; }
  }
  .ce-e3-badge {
    font-family: ui-monospace, monospace;
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #ff2761;
    background: rgba(255, 39, 97, 0.10);
    border: 1px solid rgba(255, 39, 97, 0.45);
    padding: 3px 8px;
    border-radius: 2px;
  }

  /* ─────────── E4 ─────────── J/L/F/T + expand panel + hold-to-archive */
  .ce-e4 {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 68px 42px;
    background: rgba(15, 10, 18, 0.94);
    border: 1px solid rgba(245, 241, 232, 0.10);
    border-radius: 8px;
    overflow: hidden;
    color: #f5f1e8;
  }
  .ce-e4-main {
    padding: 18px 22px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
  }
  .ce-e4-title {
    font-family: ui-monospace, monospace;
    font-style: italic;
    font-size: 17px;
    font-weight: 700;
    color: #00ff4d;
    background: rgba(0, 255, 77, 0.04);
    border: 1px solid rgba(0, 255, 77, 0.32);
    border-radius: 4px;
    padding: 5px 10px;
    margin: 0;
    display: inline-block;
    box-shadow: 0 0 12px rgba(0, 255, 77, 0.12);
    align-self: flex-start;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 100%;
  }
  .ce-e4-ext { color: #f5f1e8; opacity: 0.42; font-weight: 500; font-size: 0.6em; }
  .ce-e4-wave-row {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .ce-e4-dur {
    font-family: ui-monospace, monospace;
    font-style: italic;
    font-size: 16px;
    font-weight: 700;
    color: #ff3b6e;
    min-width: 3.6em;
    text-align: right;
    text-shadow: 0 0 4px rgba(255, 59, 110, 0.65);
  }
  .ce-e4-wave {
    position: relative;
    flex: 1;
    height: 48px;
    background: #07060c;
    border-radius: 3px;
    overflow: hidden;
  }
  .ce-e4-date {
    font-family: ui-monospace, monospace;
    font-size: 13px;
    font-weight: 600;
    color: rgba(245, 241, 232, 0.72);
    background: transparent;
    border: 0;
    padding: 5px 0;
    text-align: left;
    cursor: pointer;
  }
  .ce-e4-chev { color: rgba(14, 196, 252, 0.78); margin-left: 8px; }
  .ce-e4-exp {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: 6px 12px;
    margin: 12px 0 0;
    border-top: 1px solid rgba(245, 241, 232, 0.10);
    padding-top: 12px;
    font-size: 12px;
  }
  .ce-e4-exp dt {
    font-family: ui-monospace, monospace;
    font-size: 9px;
    letter-spacing: 0.18em;
    color: rgba(14, 196, 252, 0.78);
  }
  .ce-e4-exp dd { margin: 0; color: rgba(245, 241, 232, 0.82); }
  .ce-e4-chip {
    display: inline-block;
    font-family: ui-monospace, monospace;
    font-size: 10px;
    color: rgba(245, 241, 232, 0.72);
    border: 1px solid rgba(245, 241, 232, 0.18);
    padding: 2px 7px;
    margin-right: 4px;
    border-radius: 3px;
  }
  .ce-e4-cy { color: #0ec4fc; font-weight: 700; font-style: italic; }
  .ce-e4-link { color: #0ec4fc; text-decoration: underline; }
  .ce-e4-cat {
    display: flex;
    flex-direction: column;
    border-left: 1px solid rgba(245, 241, 232, 0.22);
    border-right: 0;
    background: rgba(245, 241, 232, 0.025);
  }
  .ce-e4-cat-btn {
    flex: 1 1 0;
    font-family: ui-monospace, monospace;
    font-style: italic;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: rgba(245, 241, 232, 0.7);
    background: transparent;
    border: 0;
    border-top: 1px solid rgba(245, 241, 232, 0.22);
    cursor: pointer;
    padding: 0 6px;
    min-height: 32px;
  }
  .ce-e4-cat-btn:first-child { border-top: 0; }
  .ce-e4-cat-btn.active {
    color: #ff2761;
    background: rgba(255, 39, 97, 0.14);
  }
  .ce-e4-cat-btn.active + .ce-e4-cat-btn {
    border-top-color: rgba(255, 39, 97, 0.45);
  }
  .ce-e4-x {
    font-family: inherit;
    font-size: 16px;
    font-weight: 700;
    color: rgba(245, 241, 232, 0.45);
    background: linear-gradient(180deg, rgba(47, 7, 18, 0.38) 0%, rgba(47, 7, 18, 0.62) 100%);
    border: 0;
    border-left: 1px solid rgba(255, 39, 97, 0.18);
    cursor: pointer;
  }

  /* ─────────── E5 ─────────── crop tool ACTIVE inside the card. The
        small waveform got replaced by a tall crop surface with bar grid
        + draggable frame + handles. Visually a totally different beat
        from E4. */
  .ce-e5 {
    background: rgba(15, 10, 18, 0.94);
    border: 1px solid rgba(14, 196, 252, 0.45);
    border-radius: 8px;
    box-shadow: 0 0 0 1px rgba(14, 196, 252, 0.18), 0 0 24px -8px rgba(14, 196, 252, 0.32);
    color: #f5f1e8;
  }
  .ce-e5-shell { padding: 18px 22px; }
  .ce-e5-shell-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    margin-bottom: 14px;
    flex-wrap: wrap;
  }
  .ce-e5-title {
    font-family: ui-monospace, monospace;
    font-style: italic;
    font-size: 16px;
    font-weight: 700;
    color: #00ff4d;
    background: rgba(0, 255, 77, 0.04);
    border: 1px solid rgba(0, 255, 77, 0.32);
    border-radius: 4px;
    padding: 4px 10px;
    margin: 0;
    box-shadow: 0 0 12px rgba(0, 255, 77, 0.12);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    min-width: 0;
  }
  .ce-e5-ext { color: #f5f1e8; opacity: 0.42; font-weight: 500; font-size: 0.7em; }
  .ce-e5-shell-meta {
    font-family: ui-monospace, monospace;
    font-size: 11px;
    color: rgba(245, 241, 232, 0.62);
  }

  /* Tall crop wave */
  .ce-e5-crop-wave {
    position: relative;
    height: 120px;
    background: #07060c;
    border-radius: 4px;
    overflow: hidden;
    display: flex;
    align-items: center;
    gap: 1px;
    padding: 0 4px;
    margin-bottom: 14px;
  }
  .ce-e5-crop-wave .ce-fake-wave {
    position: absolute;
    inset: 0;
  }
  .ce-e5-ticks {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;
  }
  .ce-e5-tick {
    position: absolute;
    top: 0; bottom: 0;
    width: 1px;
    background: rgba(245, 241, 232, 0.08);
  }
  .ce-e5-mask {
    position: absolute;
    top: 0; bottom: 0;
    background: rgba(7, 6, 12, 0.72);
    pointer-events: none;
    z-index: 1;
  }
  .ce-e5-mask-left { left: 0; width: 22%; }
  .ce-e5-mask-right { right: 0; width: 25%; }
  .ce-e5-frame {
    position: absolute;
    top: 4px; bottom: 4px;
    left: 22%; width: 53%;
    border: 2px solid var(--brand-cyan);
    background: rgba(14, 196, 252, 0.06);
    border-radius: 3px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    box-shadow: 0 0 0 1px rgba(7, 6, 12, 0.85), 0 0 14px rgba(14, 196, 252, 0.32);
    z-index: 3;
  }
  .ce-e5-handle {
    width: 12px;
    height: 100%;
    background: var(--brand-cyan);
    flex: 0 0 12px;
    position: relative;
  }
  .ce-e5-handle::before {
    content: "";
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 2px; height: 30%;
    background: #0e0c14;
    box-shadow: -3px 0 0 #0e0c14, 3px 0 0 #0e0c14;
  }
  .ce-e5-htime {
    position: absolute;
    font-family: ui-monospace, monospace;
    font-size: 9.5px;
    color: var(--brand-cyan);
    background: rgba(7, 6, 12, 0.85);
    border: 1px solid rgba(14, 196, 252, 0.45);
    padding: 1px 4px;
    border-radius: 2px;
    white-space: nowrap;
    top: -20px;
    left: 50%;
    transform: translateX(-50%);
    font-feature-settings: "tnum";
  }
  .ce-e5-handle-r .ce-e5-htime {
    top: auto;
    bottom: -20px;
  }
  .ce-e5-bar-count {
    flex: 1 1 auto;
    text-align: center;
    font-family: ui-monospace, monospace;
    font-size: 11px;
    color: var(--brand-cyan);
    background: rgba(7, 6, 12, 0.55);
    padding: 2px 6px;
    border-radius: 2px;
    white-space: nowrap;
    text-shadow: 0 0 8px rgba(14, 196, 252, 0.55);
  }

  .ce-e5-toolbar {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
    flex-wrap: wrap;
  }
  .ce-e5-tbtn {
    font-family: ui-monospace, monospace;
    font-style: italic;
    font-size: 11.5px;
    font-weight: 700;
    color: rgba(245, 241, 232, 0.88);
    background: rgba(245, 241, 232, 0.03);
    border: 1px solid rgba(245, 241, 232, 0.22);
    border-radius: 3px;
    padding: 6px 11px;
    cursor: pointer;
  }
  .ce-e5-play {
    color: var(--brand-cyan);
    border-color: rgba(14, 196, 252, 0.45);
  }
  .ce-e5-snap {
    color: var(--brand-yellow);
    border-color: rgba(255, 179, 71, 0.55);
    background: rgba(255, 179, 71, 0.06);
  }
  .ce-e5-export {
    color: #0e0c14;
    background: linear-gradient(90deg, #ff2761 0%, #ff5a3c 50%, #ffb347 100%);
    border-color: transparent;
    margin-left: auto;
  }
  .ce-e5-readout {
    font-family: ui-monospace, monospace;
    font-size: 11px;
    color: rgba(245, 241, 232, 0.78);
    flex: 1 1 auto;
    text-align: center;
    font-feature-settings: "tnum";
  }

  .ce-e5-stem-row {
    display: flex;
    align-items: center;
    gap: 8px;
    padding-top: 12px;
    border-top: 1px solid rgba(245, 241, 232, 0.10);
    flex-wrap: wrap;
  }
  .ce-e5-stem-lbl {
    font-family: ui-monospace, monospace;
    font-size: 9px;
    letter-spacing: 0.22em;
    color: rgba(14, 196, 252, 0.78);
  }
  .ce-e5-stem-btn {
    font-family: ui-monospace, monospace;
    font-style: italic;
    font-size: 11px;
    font-weight: 700;
    color: rgba(245, 241, 232, 0.85);
    background: rgba(14, 196, 252, 0.06);
    border: 1px solid rgba(14, 196, 252, 0.32);
    border-radius: 3px;
    padding: 5px 9px;
    cursor: pointer;
    display: inline-flex;
    flex-direction: column;
    line-height: 1.2;
    gap: 1px;
  }
  .ce-e5-stem-btn small {
    font-size: 9px;
    color: rgba(245, 241, 232, 0.45);
    font-style: normal;
    letter-spacing: 0.04em;
  }
  .ce-e5-stem-flag {
    font-family: ui-monospace, monospace;
    font-style: italic;
    font-size: 10.5px;
    color: rgba(245, 241, 232, 0.55);
    margin-left: auto;
  }

  /* ─────────── E6 ─────────── card opens a pipeline. The source card
        is small at the top; below it, six variants are rendering, and
        below that the A/B pair card emerges. Vertical hierarchy shows
        the FLOW: source → pipeline → judge. */
  .ce-e6 {
    background:
      radial-gradient(80% 60% at 50% 0%, rgba(255, 90, 60, 0.10) 0%, transparent 70%),
      rgba(15, 10, 18, 0.94);
    border: 1px solid rgba(255, 90, 60, 0.45);
