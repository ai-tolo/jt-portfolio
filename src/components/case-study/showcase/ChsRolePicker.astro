---
// Role-aware docs-chat — rebuilt to behave like a real AI assistant.
//
// Pick a role (Sales / GTM / Finance / Ops). The docs-chat panel swaps its
// starter prompts to that role's actual jobs (subtle crossfade). Click a
// starter and it doesn't just *show* a canned answer — it USES the assistant:
//
//   1. The starter echoes up as a sent user message.
//   2. A "thinking" indicator (3 pulsing dots) holds for ~350ms.
//   3. The response body STREAMS in line-by-line over ~600ms.
//   4. The tail metadata fades in last.
//
// All sequencing is setTimeout-driven (NOT rAF — headless preview throttles
// rAF) and every step force-completes so the final text always lands. Honors
// prefers-reduced-motion (instant final state, no thinking/stream).
//
// This mirrors the design pattern the real CHS docs-chat ships with: each
// role lands in a chat whose starters are already in their own language, and
// the chat teaches by being the tool. Mock data is plausible, no internals.

const ROLES = [
  {
    id: "sales",
    name: "Sales",
    blurb: "Account research, follow-ups, deal-review summaries.",
    starters: [
      {
        label: "Build a KB from our last 10 deal-review decks",
        kind: "Knowledge base",
        chip: "TEMPLATE · embedded resource",
        body: "Point the assistant at the /Sales/Deal Reviews SharePoint folder. I'll watch for new decks weekly and re-embed.",
        tail: "indexes 10 decks · ~28k tokens · refresh: weekly Mon 06:00 CST",
      },
      {
        label: "Draft a follow-up email in our sales voice",
        kind: "Voice-trained prompt",
        chip: "PROMPT · sales-voice-v3",
        body: "Thanks for the time on Tuesday, Mike. Two things you flagged that I want to come back to before our next sync...",
        tail: "uses sales-voice-v3 · trained on 412 closed-won emails",
      },
      {
        label: "Summarize the Acme Co. Q2 transcript",
        kind: "Task flow",
        chip: "WORKFLOW · transcript → brief",
        body: "Three takeaways for the deal team:  1) Mike is the budget owner, not Sarah.  2) Renewal cycle moved to Q4.  3) They're evaluating Sunchild for the Q3 pilot.",
        tail: "pulls from Gong · 38 min transcript · 3-bullet brief",
      },
    ],
  },
  {
    id: "gtm",
    name: "GTM",
    blurb: "Launch comms, campaign briefs, customer story reframes.",
    starters: [
      {
        label: "Build a KB from the GTM Drive, refresh weekly",
        kind: "Knowledge base",
        chip: "TEMPLATE · embedded resource",
        body: "Build a KB from our shared GTM Drive folder, tagged by quarter, with weekly auto-refresh.",
        tail: "indexes 184 files across 6 quarters · refresh: Sun 23:00 CST",
      },
      {
        label: "Write a launch blurb for the seed-treatment module",
        kind: "Voice-trained prompt",
        chip: "PROMPT · gtm-voice-v2",
        body: "Headline: a seed-treatment system that talks to your planter.  Sub: row-by-row decisions, made before the row.",
        tail: "uses gtm-voice-v2 · audience: ag retailer · channel: LinkedIn",
      },
      {
        label: "Reframe a customer story for LinkedIn",
        kind: "Task flow",
        chip: "WORKFLOW · case-study → social",
        body: "From a 4-page case study, you get: 1 carousel deck, 1 short post, 1 newsletter pull-quote. Each one routes to the right channel cadence.",
        tail: "outputs 3 channel variants · keeps the customer quote verbatim",
      },
    ],
  },
  {
    id: "finance",
    name: "Finance",
    blurb: "Variance summaries, trend pulls, board narratives.",
    starters: [
      {
        label: "Variance summary on the latest grain-trading PnL",
        kind: "Task flow",
        chip: "WORKFLOW · pnl → variance brief",
        body: "Three movers vs forecast:  · Soybean basis tightened 14¢ in IL  · Rail tender costs +9% MoM  · Hedging gains carried Q2.",
        tail: "reads the Q2 PnL workbook · 3-mover summary by default",
      },
      {
        label: "Pull last quarter's freight cost trend",
        kind: "Knowledge base",
        chip: "DATASET · freight-costs-2026q1",
        body: "Trend: total freight up 6.4% QoQ, driven by Pacific Northwest rail. Truck spot rates flat. Most affected lanes: Tacoma, Portland, Long Beach.",
        tail: "queries the freight-costs view · returns trend + top affected lanes",
      },
      {
        label: "Summarize Q4 board narrative for the FP&A team",
        kind: "Voice-trained prompt",
        chip: "PROMPT · board-voice",
        body: "Q4 delivered against the three commitments tabled at the September board: margin recovery, freight discipline, and seed-treatment ramp.",
        tail: "uses board-voice · 3-paragraph cap · plain language only",
      },
    ],
  },
  {
    id: "ops",
    name: "Ops",
    blurb: "SOP conversion, safety stand-down search, field translation.",
    starters: [
      {
        label: "Convert this SOP into a how-to flow",
        kind: "Task flow",
        chip: "WORKFLOW · sop → checklist",
        body: "Step 1: Verify shutoff. Step 2: Visual inspection of seal. Step 3: Pressure test at 80 PSI. Step 4: Log result to inspection board.",
        tail: "reads PDF SOP · outputs role-tagged checklist + log fields",
      },
      {
        label: "Find every Confluence page on safety stand-down",
        kind: "Knowledge base",
        chip: "DATASET · confluence-safety",
        body: "12 pages found, 4 are policy-of-record. Most recent revision: 2026-04-18 (Topeka site). The others are quarterly drills.",
        tail: "searches Confluence · flags policy vs drill · last-modified ranked",
      },
      {
        label: "Translate this checklist into Spanish for Topeka",
        kind: "Voice-trained prompt",
        chip: "PROMPT · field-spanish",
        body: "Paso 1: Verificar el cierre. Paso 2: Inspección visual del sello. Paso 3: Prueba de presión a 80 PSI. Paso 4: Registrar el resultado.",
        tail: "uses field-spanish · keeps measurement units, line-by-line parity",
      },
    ],
  },
];

// Split each response body into stream "lines" so the assistant can type it
// out a clause at a time. We break on the double-space the copy already uses
// as a soft beat, falling back to sentence boundaries — keeps it deterministic
// at build time (no client-side parsing).
const splitLines = (body: string): string[] => {
  const parts = body.includes("  ")
    ? body.split(/\s{2,}/)
    : body.split(/(?<=[.!?])\s+/);
  return parts.map((p) => p.trim()).filter(Boolean);
};
---

<div class="chs-rp" data-chs-rp>
  <div class="chs-rp-roles" role="tablist" aria-label="Pick a role">
    {ROLES.map((r, i) => (
      <button
        type="button"
        class:list={["chs-rp-role", { active: i === 0 }]}
        role="tab"
        aria-selected={i === 0 ? "true" : "false"}
        data-chs-rp-role={r.id}
      >
        <span class="chs-rp-role-name">{r.name}</span>
        <span class="chs-rp-role-blurb">{r.blurb}</span>
      </button>
    ))}
  </div>

  <div class="chs-rp-chat">
    <div class="chs-rp-chat-head">
      <span class="chs-rp-dot" aria-hidden="true"></span>
      <span class="chs-rp-chat-title">CHS · Docs assistant</span>
      <span class="chs-rp-chat-role" data-chs-rp-chat-role>You · Sales</span>
    </div>

    <div class="chs-rp-panes">
      {ROLES.map((r, i) => (
        <div class:list={["chs-rp-pane", { active: i === 0 }]} data-chs-rp-pane={r.id}>
          <p class="chs-rp-prompt">Hi, I'm new here. Where do I start as someone in <em>{r.name}</em>?</p>
          <p class="chs-rp-reply">Three starting flows match your role. Tap one — I'll run it.</p>
          <ul class="chs-rp-starters">
            {r.starters.map((s, j) => (
              <li>
                <button
                  type="button"
                  class="chs-rp-starter"
                  data-chs-rp-starter={`${r.id}-${j}`}
                >
                  <span class="chs-rp-starter-arrow">→</span>
                  <span class="chs-rp-starter-label">{s.label}</span>
                  <span class="chs-rp-starter-kind">{s.kind}</span>
                </button>
              </li>
            ))}
          </ul>

          {/* The live transcript region. Sent prompt + streamed answer get
              written here on starter click. Empty until the reader acts. */}
          <div class="chs-rp-thread" data-chs-rp-thread aria-live="polite">
            {r.starters.map((s, j) => (
              <template data-chs-rp-tpl={`${r.id}-${j}`}>
                <div class="chs-rp-sent" data-label={s.label}></div>
                <div class="chs-rp-response">
                  <span class="chs-rp-chip">{s.chip}</span>
                  <div class="chs-rp-response-body" data-tail={s.tail}>
                    {splitLines(s.body).map((line) => (
                      <span class="chs-rp-line" data-line>{line}</span>
                    ))}
                  </div>
                  <p class="chs-rp-response-tail">{s.tail}</p>
                </div>
              </template>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-chs-rp]").forEach((root) => {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const roleBtns = root.querySelectorAll<HTMLButtonElement>("[data-chs-rp-role]");
    const panes = root.querySelectorAll<HTMLElement>("[data-chs-rp-pane]");
    const chatRoleLbl = root.querySelector<HTMLElement>("[data-chs-rp-chat-role]");

    // ── role switch (subtle crossfade handled in CSS via .active) ──
    const activateRole = (id: string) => {
      roleBtns.forEach((b) => {
        const on = b.dataset.chsRpRole === id;
        b.classList.toggle("active", on);
        b.setAttribute("aria-selected", on ? "true" : "false");
      });
      panes.forEach((p) => p.classList.toggle("active", p.dataset.chsRpPane === id));
      const label = root.querySelector<HTMLElement>(`[data-chs-rp-role="${id}"] .chs-rp-role-name`);
      if (chatRoleLbl && label) chatRoleLbl.textContent = `You · ${label.textContent}`;
    };
    roleBtns.forEach((b) => {
      b.addEventListener("click", () => activateRole(b.dataset.chsRpRole || ""));
    });

    // ── the assistant run: thinking → stream → tail ──
    const starterBtns = root.querySelectorAll<HTMLButtonElement>("[data-chs-rp-starter]");
    starterBtns.forEach((b) => {
      b.addEventListener("click", () => {
        const id = b.dataset.chsRpStarter || "";
        const pane = b.closest<HTMLElement>("[data-chs-rp-pane]");
        const thread = pane?.querySelector<HTMLElement>("[data-chs-rp-thread]");
        const tpl = pane?.querySelector<HTMLTemplateElement>(`[data-chs-rp-tpl="${id}"]`);
        if (!pane || !thread || !tpl) return;

        // mark the chosen starter
        pane.querySelectorAll<HTMLButtonElement>("[data-chs-rp-starter]").forEach((s) =>
          s.classList.toggle("active", s === b)
        );

        // Cancel any in-flight run from a previous click so its delayed
        // timers don't write into the node we're about to replace.
        const prevTimers: number[] = (thread as any).__timers || [];
        prevTimers.forEach((t) => window.clearTimeout(t));
        const timers: number[] = [];
        (thread as any).__timers = timers;
        const after = (fn: () => void, ms: number) => {
          const t = window.setTimeout(fn, ms);
          timers.push(t);
          return t;
        };

        // Remove only the previously-rendered live transcript (keep the
        // inert <template> sources so re-clicks still work), then mount a
        // fresh clone of this starter's template.
        thread.querySelectorAll<HTMLElement>("[data-chs-rp-live]").forEach((n) => n.remove());
        const live = document.createElement("div");
        live.dataset.chsRpLive = "true";
        live.appendChild(tpl.content.cloneNode(true));
        thread.appendChild(live);

        const sent = live.querySelector<HTMLElement>(".chs-rp-sent");
        const response = live.querySelector<HTMLElement>(".chs-rp-response");
        const bodyEl = live.querySelector<HTMLElement>(".chs-rp-response-body");
        const lines = [...live.querySelectorAll<HTMLElement>("[data-line]")];
        const tail = live.querySelector<HTMLElement>(".chs-rp-response-tail");
        if (!sent || !response || !bodyEl || !tail) return;

        // 1) echo the starter as a sent user bubble. Drive the fade via a
        // tiny setTimeout (not rAF — headless tabs throttle rAF) so the
        // bubble always becomes visible.
        sent.textContent = sent.dataset.label || "";
        after(() => sent.classList.add("in"), 20);

        // reduced motion → everything visible at once, no theatre
        if (reduce) {
          response.classList.add("in");
          bodyEl.dataset.state = "done";
          lines.forEach((l) => l.classList.add("in"));
          tail.classList.add("in");
          return;
        }

        // 2) thinking dots
        response.classList.add("in");
        bodyEl.dataset.state = "thinking";

        const THINK = 350;
        const STREAM = 600;
        const perLine = lines.length ? STREAM / lines.length : STREAM;

        // 3) stream the body line-by-line, then 4) fade the tail
        after(() => {
          bodyEl.dataset.state = "streaming";
          lines.forEach((l, i) => {
            after(() => l.classList.add("in"), i * perLine);
          });
          after(() => {
            bodyEl.dataset.state = "done";
            tail.classList.add("in");
          }, lines.length * perLine + 80);
        }, THINK);

        // belt-and-suspenders: if any timer is dropped (headless tabs),
        // force the final state so the answer always lands fully.
        const finalAt = THINK + lines.length * perLine + 260;
        after(() => {
          sent.classList.add("in");
          bodyEl.dataset.state = "done";
          lines.forEach((l) => l.classList.add("in"));
          tail.classList.add("in");
        }, finalAt);
      });
    });
  });
</script>

<style>
  .chs-rp {
    display: grid;
    grid-template-columns: minmax(220px, 280px) minmax(0, 1fr);
    gap: 28px;
    align-items: start;
  }
  @media (max-width: 880px) {
    .chs-rp { grid-template-columns: 1fr; }
  }

  /* Role rail */
  .chs-rp-roles {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .chs-rp-role {
    display: grid;
    gap: 4px;
    text-align: left;
    background: rgba(245, 241, 232, 0.02);
    border: 1px solid var(--cs-line);
    border-radius: 4px;
    padding: 12px 14px;
    color: var(--cs-text);
    cursor: pointer;
    transition: border-color 160ms ease, background 160ms ease;
  }
  .chs-rp-role:hover {
    border-color: var(--cs-line-strong);
    background: rgba(245, 241, 232, 0.04);
  }
  .chs-rp-role.active {
    border-color: var(--brand-orange);
    background: rgba(255, 90, 60, 0.06);
  }
  .chs-rp-role-name {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-style: italic;
    font-weight: 700;
    font-size: 15px;
    color: var(--cs-text);
  }
  .chs-rp-role.active .chs-rp-role-name {
    color: var(--brand-orange);
  }
  .chs-rp-role-blurb {
    font-size: 12px;
    color: rgba(245, 241, 232, 0.55);
    line-height: 1.4;
  }

  /* Chat surface */
  .chs-rp-chat {
    background: #07060c;
    border: 1px solid var(--cs-line);
    border-radius: 6px;
    overflow: hidden;
  }
  .chs-rp-chat-head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 11px 16px;
    border-bottom: 1px solid var(--cs-line);
    background: rgba(245, 241, 232, 0.025);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11.5px;
    color: rgba(245, 241, 232, 0.62);
  }
  .chs-rp-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--brand-orange);
    box-shadow: 0 0 8px var(--brand-orange);
  }
  .chs-rp-chat-title { flex: 1; }
  .chs-rp-chat-role {
    color: var(--brand-cyan);
    font-style: italic;
  }

  /* Panes crossfade on role switch. Stack them so the swap doesn't jump
     the frame height around. */
  .chs-rp-panes { position: relative; }
  .chs-rp-pane {
    padding: 22px 22px 20px;
    opacity: 0;
    visibility: hidden;
    transition: opacity 220ms ease;
  }
  .chs-rp-pane:not(.active) {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .chs-rp-pane.active {
    position: relative;
    opacity: 1;
    visibility: visible;
  }

  .chs-rp-prompt {
    display: inline-block;
    background: rgba(255, 90, 60, 0.10);
    border: 1px solid rgba(255, 90, 60, 0.32);
    color: var(--cs-text);
    border-radius: 12px 12px 4px 12px;
    padding: 9px 14px;
    font-size: 14px;
    line-height: 1.5;
    margin: 0 0 14px;
    max-width: 80%;
  }
  .chs-rp-prompt em {
    font-style: italic;
    color: var(--brand-orange);
    font-weight: 700;
  }

  .chs-rp-reply {
    font-size: 13.5px;
    color: rgba(245, 241, 232, 0.72);
    margin: 0 0 14px;
    font-style: italic;
  }

  .chs-rp-starters {
    list-style: none;
    padding: 0;
    margin: 0 0 14px;
    display: grid;
    gap: 6px;
  }
  .chs-rp-starter {
    display: grid;
    grid-template-columns: 18px 1fr auto;
    gap: 12px;
    align-items: center;
    width: 100%;
    text-align: left;
    background: rgba(245, 241, 232, 0.02);
    border: 1px solid var(--cs-line);
    border-radius: 4px;
    padding: 10px 14px;
    cursor: pointer;
    transition: border-color 160ms ease, background 160ms ease;
  }
  .chs-rp-starter:hover {
    border-color: var(--cs-line-strong);
    background: rgba(245, 241, 232, 0.04);
  }
  .chs-rp-starter.active {
    border-color: var(--brand-cyan);
    background: rgba(14, 196, 252, 0.05);
  }
  .chs-rp-starter-arrow {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    color: rgba(245, 241, 232, 0.45);
    font-weight: 700;
  }
  .chs-rp-starter.active .chs-rp-starter-arrow { color: var(--brand-cyan); }
  .chs-rp-starter-label {
    font-size: 14px;
    color: var(--cs-text);
    line-height: 1.4;
  }
  .chs-rp-starter-kind {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(245, 241, 232, 0.45);
  }
  /* On phones the auto kind-tag column starves the label to one word per
     line. Drop to two columns and hang the kind under the label as a
     caption, so the starter still reads as a full phrase. */
  @media (max-width: 560px) {
    .chs-rp-starter {
      grid-template-columns: 18px 1fr;
      gap: 3px 12px;
      align-items: start;
    }
    .chs-rp-starter-arrow { line-height: 1.4; }
    .chs-rp-starter-kind { grid-column: 2; }
  }

  /* ── live transcript ── */
  .chs-rp-thread { display: block; }
  .chs-rp-thread:empty { display: none; }

  /* the starter echoed back as a sent user message */
  .chs-rp-sent {
    margin: 4px 0 12px auto;
    max-width: 80%;
    width: fit-content;
    text-align: right;
    background: rgba(255, 90, 60, 0.10);
    border: 1px solid rgba(255, 90, 60, 0.32);
    color: var(--cs-text);
    border-radius: 12px 12px 4px 12px;
    padding: 8px 13px;
    font-size: 13.5px;
    line-height: 1.45;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 220ms ease, transform 220ms ease;
  }
  .chs-rp-sent.in { opacity: 1; transform: none; }

  .chs-rp-response {
    border-top: 1px solid var(--cs-line);
    padding-top: 16px;
    margin-top: 6px;
    opacity: 0;
    transition: opacity 200ms ease;
  }
  .chs-rp-response.in { opacity: 1; }
  .chs-rp-chip {
    display: inline-block;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--brand-cyan);
    background: rgba(14, 196, 252, 0.07);
    border: 1px solid rgba(14, 196, 252, 0.35);
    border-radius: 2px;
    padding: 3px 7px;
    margin-bottom: 10px;
  }

  /* response body: a streamed answer block. Lines reveal one at a time. */
  .chs-rp-response-body {
    position: relative;
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--cs-text);
    margin: 0 0 8px;
    padding: 10px 14px;
    min-height: 40px;
    background: rgba(0, 255, 77, 0.04);
    border-left: 2px solid rgba(0, 255, 77, 0.45);
    border-radius: 2px;
  }
  .chs-rp-line {
    display: inline;
    opacity: 0;
    transition: opacity 180ms ease;
  }
  .chs-rp-line.in { opacity: 1; }
  /* keep clauses on the same visual line where the source used soft beats:
     a hair of trailing space so streamed clauses read as one paragraph */
  .chs-rp-line::after { content: " "; }

  /* thinking dots — shown while data-state="thinking", hidden otherwise */
  .chs-rp-response-body::before {
    content: "";
    position: absolute;
    left: 14px; top: 14px;
    width: 6px; height: 6px;
    border-radius: 50%;
    color: var(--brand-green);
    background: currentColor;
    box-shadow: 12px 0 0 currentColor, 24px 0 0 currentColor;
    opacity: 0;
  }
  .chs-rp-response-body[data-state="thinking"]::before {
    opacity: 0.85;
    animation: chs-rp-think 1s ease-in-out infinite;
  }
  @keyframes chs-rp-think {
    0%, 100% { box-shadow: 12px 0 0 currentColor, 24px 0 0 currentColor; opacity: 0.35; }
    33% { box-shadow: 12px 0 0 currentColor, 24px 0 0 currentColor; opacity: 1; }
  }
  /* a blinking caret at the end of the stream while streaming */
  .chs-rp-response-body[data-state="streaming"]::after {
    content: "▍";
    color: var(--brand-green);
    opacity: 0.7;
    animation: chs-rp-caret 0.8s step-end infinite;
  }
  @keyframes chs-rp-caret { 50% { opacity: 0; } }

  .chs-rp-response-tail {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11.5px;
    color: rgba(245, 241, 232, 0.45);
    margin: 0;
    opacity: 0;
    transform: translateY(3px);
    transition: opacity 240ms ease, transform 240ms ease;
  }
  .chs-rp-response-tail.in { opacity: 1; transform: none; }

  @media (prefers-reduced-motion: reduce) {
    .chs-rp-pane,
    .chs-rp-sent,
    .chs-rp-response,
    .chs-rp-line,
    .chs-rp-response-tail {
      transition: none;
    }
    .chs-rp-response-body[data-state="thinking"]::before { animation: none; opacity: 0; }
    .chs-rp-response-body[data-state="streaming"]::after { content: none; }
  }
</style>
