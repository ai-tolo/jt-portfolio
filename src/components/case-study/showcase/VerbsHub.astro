---

<div class="vh-stage" data-vh-stage>
  <div class="vh-grid">
    <!-- READ column -->
    <ol class="vh-col vh-read" role="list">
      <li class="vh-col-head">
        <span class="vh-col-tag">READ</span>
      </li>
      {READ.map((v) => (
        <li>
          <button
            type="button"
            class="vh-verb"
            data-vh-verb={v.id}
            data-side="read"
          >{v.verb}</button>
        </li>
      ))}
    </ol>

    <!-- Hub -->
    <div class="vh-hub">
      <div class="vh-hub-disc">
        <span class="vh-hub-name">inventory.db</span>
        <span class="vh-hub-sub">com.jont.console-api</span>
        <span class="vh-hub-sub">72 tests passing</span>
      </div>
    </div>

    <!-- WRITE column -->
    <ol class="vh-col vh-write" role="list">
      <li class="vh-col-head">
        <span class="vh-col-tag write">WRITE</span>
      </li>
      {WRITE.map((v) => (
        <li>
          <button
            type="button"
            class="vh-verb write"
            data-vh-verb={v.id}
            data-side="write"
          >{v.verb}</button>
        </li>
      ))}
    </ol>
  </div>

  <!-- Detail panel -->
  <div class="vh-detail" data-vh-detail aria-live="polite">
    <div class="vh-detail-head">
      <span class="vh-detail-eyebrow">Click a verb to see its shape.</span>
    </div>
  </div>

  <!-- All verb data inline as JSON for the client script. -->
  <script type="application/json" id="vh-data" set:html={JSON.stringify({ read: READ, write: WRITE })}></script>
</div>

<script>
  type V = { id: string; verb: string; desc: string; req: string; res: string };
  const dataEl = document.getElementById("vh-data");
  const all: { read: V[]; write: V[] } = dataEl
    ? JSON.parse(dataEl.textContent || "{}")
    : { read: [], write: [] };
  const byId = new Map<string, V & { side: "read" | "write" }>();
  all.read.forEach((v) => byId.set(v.id, { ...v, side: "read" }));
  all.write.forEach((v) => byId.set(v.id, { ...v, side: "write" }));

  const stage = document.querySelector<HTMLElement>("[data-vh-stage]");
  const detail = stage?.querySelector<HTMLElement>("[data-vh-detail]");
  const buttons = stage?.querySelectorAll<HTMLButtonElement>("[data-vh-verb]");

  const show = (id: string) => {
    const v = byId.get(id);
    if (!v || !detail) return;
    buttons?.forEach((b) => b.classList.toggle("active", b.dataset.vhVerb === id));
    const sideClass = v.side === "read" ? "read" : "write";
    detail.innerHTML = `
      <div class="vh-detail-head">
        <span class="vh-detail-tag ${sideClass}">${v.side.toUpperCase()}</span>
        <code class="vh-detail-verb">${escapeHtml(v.verb)}</code>
      </div>
      <p class="vh-detail-desc">${escapeHtml(v.desc)}</p>
      <div class="vh-detail-cols">
        <div>
          <p class="vh-detail-lbl">request</p>
          <pre class="vh-detail-pre">${escapeHtml(v.req)}</pre>
        </div>
        <div>
          <p class="vh-detail-lbl">response</p>
          <pre class="vh-detail-pre">${escapeHtml(v.res)}</pre>
        </div>
      </div>
    `;
  };

  const escapeHtml = (s: string) => s
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;");

  buttons?.forEach((b) => {
    b.addEventListener("click", () => {
      const id = b.dataset.vhVerb!;
      show(id);
    });
  });

  // Default open on the marquee verb (promote-to-live) so the panel is
  // never empty on first view.
  show("promote-to-live");
</script>

<style>
  .vh-stage {
    background: linear-gradient(180deg, var(--cs-surface) 0%, #08070d 100%);
    border: 1px solid var(--cs-line);
    border-radius: 6px;
    padding: 28px 28px 32px;
  }

  .vh-grid {
    display: grid;
    grid-template-columns: 1fr 220px 1fr;
    gap: 28px;
    align-items: start;
  }
  @media (max-width: 880px) {
    .vh-grid {
      grid-template-columns: 1fr;
      gap: 18px;
    }
    .vh-hub { display: none; }
  }

  .vh-col {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .vh-col-head {
    margin-bottom: 6px;
  }
  .vh-col-tag {
    display: inline-block;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--brand-cyan);
    background: rgba(14, 196, 252, 0.06);
    border: 1px solid rgba(14, 196, 252, 0.32);
    border-radius: 2px;
    padding: 4px 9px;
  }
  .vh-col-tag.write {
    color: var(--brand-pink);
    background: rgba(255, 39, 97, 0.06);
    border-color: rgba(255, 39, 97, 0.32);
  }

  .vh-verb {
    width: 100%;
    text-align: left;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-style: italic;
    font-size: 13px;
    font-weight: 600;
    color: rgba(245, 241, 232, 0.88);
    background: transparent;
    border: 1px solid rgba(14, 196, 252, 0.18);
    border-left: 3px solid rgba(14, 196, 252, 0.48);
    border-radius: 3px;
    padding: 8px 12px;
    cursor: pointer;
    transition: color 160ms ease, border-color 160ms ease, background 160ms ease, transform 80ms ease;
  }
  .vh-verb.write {
    border-color: rgba(255, 39, 97, 0.18);
    border-left-color: rgba(255, 39, 97, 0.48);
  }
  .vh-verb:hover,
  .vh-verb:focus-visible {
    color: #fff;
    border-color: rgba(14, 196, 252, 0.45);
    background: rgba(14, 196, 252, 0.04);
    outline: none;
  }
  .vh-verb.write:hover,
  .vh-verb.write:focus-visible {
    border-color: rgba(255, 39, 97, 0.45);
    background: rgba(255, 39, 97, 0.04);
  }
  .vh-verb:active { transform: translateY(1px); }
  .vh-verb.active {
    color: #fff;
    border-color: rgba(255, 90, 60, 0.65);
    border-left-color: rgba(255, 90, 60, 0.65);
    background: rgba(255, 90, 60, 0.06);
    box-shadow: 0 0 0 1px rgba(255, 90, 60, 0.32);
  }

  .vh-hub {
    align-self: stretch;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    min-height: 200px;
  }
  .vh-hub::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 60% at 50% 50%, rgba(255, 90, 60, 0.18) 0%, transparent 100%);
    pointer-events: none;
  }
  .vh-hub-disc {
    width: 180px;
    height: 180px;
    border-radius: 50%;
    background:
      radial-gradient(60% 60% at 50% 30%, rgba(255, 90, 60, 0.04) 0%, transparent 100%),
      #0f0a12;
    border: 1px solid;
    border-image: linear-gradient(180deg, #ff2761 0%, #ff5a3c 50%, #ffb347 100%) 1;
    border-image-slice: 1;
    border-image-source: linear-gradient(180deg, #ff2761 0%, #ff5a3c 50%, #ffb347 100%);
    outline: 1px solid rgba(255, 90, 60, 0.55);
    outline-offset: -1px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 4px;
    position: relative;
    z-index: 1;
    box-shadow:
      0 0 0 2px rgba(7, 6, 12, 1),
      0 0 0 4px rgba(255, 90, 60, 0.18),
      0 24px 60px -28px rgba(0,0,0,0.75);
  }
  .vh-hub-name {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-style: italic;
    font-weight: 700;
    font-size: 18px;
    color: #f5f1e8;
  }
  .vh-hub-sub {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 10.5px;
    color: rgba(245, 241, 232, 0.55);
    letter-spacing: 0.06em;
  }

  /* Detail panel below the grid. */
  .vh-detail {
    margin-top: 26px;
    padding-top: 22px;
    border-top: 1px solid var(--cs-line);
    min-height: 240px;
  }
  .vh-detail-head {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 10px;
  }
  .vh-detail-eyebrow {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(245, 241, 232, 0.48);
  }
  .vh-detail-tag {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 10px;
    letter-spacing: 0.22em;
    color: var(--brand-cyan);
    background: rgba(14, 196, 252, 0.06);
    border: 1px solid rgba(14, 196, 252, 0.32);
    border-radius: 2px;
    padding: 3px 8px;
  }
  .vh-detail-tag.write {
    color: var(--brand-pink);
    background: rgba(255, 39, 97, 0.06);
    border-color: rgba(255, 39, 97, 0.32);
  }
  .vh-detail-verb {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-style: italic;
    font-size: 15px;
    color: #f5f1e8;
    background: rgba(245, 241, 232, 0.04);
    border: 1px solid rgba(245, 241, 232, 0.18);
    border-radius: 3px;
    padding: 4px 9px;
  }
  .vh-detail-desc {
    margin: 0 0 16px;
    color: rgba(245, 241, 232, 0.78);
    font-size: 14px;
    line-height: 1.55;
  }
  .vh-detail-cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }
  @media (max-width: 720px) {
    .vh-detail-cols { grid-template-columns: 1fr; }
  }
  .vh-detail-lbl {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 9px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(245, 241, 232, 0.48);
    margin: 0 0 6px;
  }
  .vh-detail-pre {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 12px;
    line-height: 1.5;
    color: #f5f1e8;
    background: rgba(7, 6, 12, 0.85);
    border: 1px solid var(--cs-line);
    border-radius: 3px;
    padding: 12px 14px;
    margin: 0;
    white-space: pre;
    overflow-x: auto;
  }
</style>
