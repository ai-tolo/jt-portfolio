---
// Live Engineer A/B pair card. Visual + interaction lifted from the
// production portal/engineer.astro pair-card UI.
//
// Interactions wired up here:
//   - A/B side switch (← →, A/B, 1/2, click)
//   - Free-text comment textarea persists locally
//   - Per-stem solo bar: toggles which stem the player is "listening to"
//     on BOTH sides simultaneously (apples-to-apples)
//   - Pick / Skip / Retry-with-feedback buttons commit a fake judgement
//     and roll to a placeholder "next pair"
//
// Mocked audio context: there's no real playback in the demo (we don't
// want to host wavs). The play button toggles a CSS-only loop animation
// on the waveform of the active side so the user feels which side is
// "playing." If/when we host demo wavs, the same script can be promoted
// to play real audio.

interface Variant {
  pole: string;
  reasoning: string[];
  translation: { phone: "ok" | "flag" | "good"; phoneText: string; car: "ok" | "flag" | "good"; carText: string; club: "ok" | "flag" | "good"; clubText: string };
}

interface Pair {
  source: string;
  axis: "focal" | "space" | "dynamics";
  a: Variant;
  b: Variant;
}

const PAIR: Pair = {
  source: "rainforest_post_karoke (chorus 1)",
  axis: "focal",
  a: {
    pole: "forward_bright",
    reasoning: [
      "vocal +1.2 dB · pulled up over the bus",
      "-3 dB low shelf @ 220 Hz · cleared bass mud under the vocal",
      "de-ess @ 6 kHz · 4 dB threshold",
      "drums tight · room verb -2 dB",
      "plate decay 1.2s · short, present",
    ],
    translation: {
      phone: "ok", phoneText: "phone: ok",
      car: "flag", carText: "car: harsh top",
      club: "good", clubText: "club: clean",
    },
  },
  b: {
    pole: "recessed_warm",
    reasoning: [
      "vocal -0.4 dB · sits inside the mix",
      "+1.5 dB low shelf @ 180 Hz · weight under the vocal",
      "low-pass @ 14 kHz · softer top",
      "room verb on snare · ambience added",
      "plate decay 1.8s · longer tail",
    ],
    translation: {
      phone: "flag", phoneText: "phone: vocal lost",
      car: "good", carText: "car: ok",
      club: "flag", clubText: "club: collapses",
    },
  },
};

const STEMS = ["FULL MIX", "drums", "bass", "vocals", "other"];
---

<div class="ep-stage" data-ep-stage data-side="a" data-stem="FULL MIX" data-playing="false">
  <div class="ep-card">
    <header class="ep-head">
      <div class="ep-head-left">
        <span class="ep-source">{PAIR.source}</span>
        <span class="ep-axis ep-axis-{PAIR.axis}">{PAIR.axis.toUpperCase()} AXIS</span>
      </div>
      <div class="ep-keys" aria-hidden="true">
        <kbd>←</kbd><kbd>→</kbd> switch · <kbd>space</kbd> play · <kbd>1</kbd> <kbd>2</kbd> pick
      </div>
    </header>

    <!-- Shared transport -->
    <div class="ep-transport">
      <button type="button" class="ep-play" data-ep-play aria-label="Play / pause">▶</button>
      <span class="ep-time" data-ep-time>0:00 / 0:18</span>

      <div class="ep-ab-switch" role="group" aria-label="Switch side">
        <button type="button" class="ep-ab ep-ab-a" data-ep-side="a" data-side-active="true">
          <span class="ep-ab-key">A</span>
          <span class="ep-ab-label">forward_bright</span>
        </button>
        <button type="button" class="ep-ab ep-ab-b" data-ep-side="b" data-side-active="false">
          <span class="ep-ab-key">B</span>
          <span class="ep-ab-label">recessed_warm</span>
        </button>
      </div>
    </div>

    <!-- Waveform with playhead, recolor by active side -->
    <div class="ep-wave" data-ep-wave>
      {Array.from({ length: 96 }).map((_, i) => {
        const h = 38 + Math.round(34 * Math.sin(i * 0.32) + 22 * Math.cos(i * 0.55) + 14 * Math.sin(i * 1.1));
        return <span class="ep-wave-bar" style={`height:${Math.max(18, Math.min(98, h))}%`}></span>;
      })}
      <div class="ep-playhead" data-ep-playhead></div>
    </div>

    <!-- Per-stem solo bar — toggles which stem we're listening to on BOTH
         sides simultaneously so the comparison stays apples-to-apples. -->
    <div class="ep-solos" role="group" aria-label="Solo">
      {STEMS.map((s) => (
        <button
          type="button"
          class="ep-solo"
          data-ep-stem={s}
          data-active={s === "FULL MIX" ? "true" : "false"}
        >{s}</button>
      ))}
    </div>

    <!-- Side-by-side reasoning + translation -->
    <div class="ep-panels">
      <article class="ep-panel ep-panel-a" data-side-panel="a">
        <header class="ep-panel-head">
          <span class="ep-panel-key">A</span>
          <span class="ep-panel-pole">{PAIR.a.pole}</span>
        </header>
        <div class="ep-panel-body">
          <p class="ep-panel-eyebrow">REASONING</p>
          <ul class="ep-panel-list">
            {PAIR.a.reasoning.map((r) => <li>{r}</li>)}
          </ul>
          <p class="ep-panel-eyebrow">TRANSLATION</p>
          <div class="ep-translation">
            <span class={`ep-pill ep-pill-${PAIR.a.translation.phone}`}>{PAIR.a.translation.phoneText}</span>
            <span class={`ep-pill ep-pill-${PAIR.a.translation.car}`}>{PAIR.a.translation.carText}</span>
            <span class={`ep-pill ep-pill-${PAIR.a.translation.club}`}>{PAIR.a.translation.clubText}</span>
          </div>
        </div>
      </article>

      <article class="ep-panel ep-panel-b" data-side-panel="b">
        <header class="ep-panel-head">
          <span class="ep-panel-key">B</span>
          <span class="ep-panel-pole">{PAIR.b.pole}</span>
        </header>
        <div class="ep-panel-body">
          <p class="ep-panel-eyebrow">REASONING</p>
          <ul class="ep-panel-list">
            {PAIR.b.reasoning.map((r) => <li>{r}</li>)}
          </ul>
          <p class="ep-panel-eyebrow">TRANSLATION</p>
          <div class="ep-translation">
            <span class={`ep-pill ep-pill-${PAIR.b.translation.phone}`}>{PAIR.b.translation.phoneText}</span>
            <span class={`ep-pill ep-pill-${PAIR.b.translation.car}`}>{PAIR.b.translation.carText}</span>
            <span class={`ep-pill ep-pill-${PAIR.b.translation.club}`}>{PAIR.b.translation.clubText}</span>
          </div>
        </div>
      </article>
    </div>

    <!-- Comment textarea + action row -->
    <div class="ep-actions">
      <textarea
        class="ep-comment"
        data-ep-comment
        placeholder="Notes (optional). What worked, what didn't, what you'd change. Carries forward to the next render on the same source."
      ></textarea>
      <div class="ep-actions-row">
        <button type="button" class="ep-action ep-skip" data-ep-skip>S · Skip</button>
        <button type="button" class="ep-action ep-retry" data-ep-retry>↻ Retry with notes</button>
        <button type="button" class="ep-action ep-pick" data-ep-pick>Enter · Pick <span class="ep-pick-side" data-ep-pick-side>A</span></button>
      </div>
    </div>

    <p class="ep-status" data-ep-status aria-live="polite"></p>
  </div>
</div>

<script>
  const stage = document.querySelector<HTMLElement>("[data-ep-stage]");
  if (stage) {
    const playBtn = stage.querySelector<HTMLButtonElement>("[data-ep-play]");
    const playhead = stage.querySelector<HTMLElement>("[data-ep-playhead]");
    const time = stage.querySelector<HTMLElement>("[data-ep-time]");
    const sideButtons = stage.querySelectorAll<HTMLButtonElement>("[data-ep-side]");
    const stemButtons = stage.querySelectorAll<HTMLButtonElement>("[data-ep-stem]");
    const pickBtn = stage.querySelector<HTMLButtonElement>("[data-ep-pick]");
    const pickSide = stage.querySelector<HTMLElement>("[data-ep-pick-side]");
    const skipBtn = stage.querySelector<HTMLButtonElement>("[data-ep-skip]");
    const retryBtn = stage.querySelector<HTMLButtonElement>("[data-ep-retry]");
    const status = stage.querySelector<HTMLElement>("[data-ep-status]");
    const comment = stage.querySelector<HTMLTextAreaElement>("[data-ep-comment]");

    const DUR = 18; // seconds; demo loop duration
    let playing = false;
    let raf: number | null = null;
    let started = 0;

    const fmt = (s: number) => {
      const m = Math.floor(s / 60);
      const r = Math.floor(s % 60);
      return `${m}:${String(r).padStart(2, "0")}`;
    };

    const stopPlay = () => {
      playing = false;
      stage.dataset.playing = "false";
      if (raf !== null) { cancelAnimationFrame(raf); raf = null; }
      if (playBtn) playBtn.textContent = "▶";
      if (playhead) playhead.style.left = "0%";
      if (time) time.textContent = `0:00 / ${fmt(DUR)}`;
    };
    const startPlay = () => {
      playing = true;
      stage.dataset.playing = "true";
      started = performance.now();
      if (playBtn) playBtn.textContent = "❚❚";
      const tick = () => {
        if (!playing) return;
        const elapsed = ((performance.now() - started) / 1000) % DUR;
        if (playhead) playhead.style.left = `${(elapsed / DUR) * 100}%`;
        if (time) time.textContent = `${fmt(elapsed)} / ${fmt(DUR)}`;
        raf = requestAnimationFrame(tick);
      };
      raf = requestAnimationFrame(tick);
    };
    const togglePlay = () => { if (playing) stopPlay(); else startPlay(); };

    const setSide = (side: "a" | "b") => {
      stage.dataset.side = side;
      sideButtons.forEach((b) => {
        const isActive = b.dataset.epSide === side;
        b.dataset.sideActive = isActive ? "true" : "false";
      });
      if (pickSide) pickSide.textContent = side.toUpperCase();
      flash(`switched to ${side.toUpperCase()}`);
    };

    const setStem = (stem: string) => {
      stage.dataset.stem = stem;
      stemButtons.forEach((b) => b.dataset.active = b.dataset.epStem === stem ? "true" : "false");
      flash(`solo: ${stem.toLowerCase()}`);
    };

    const flash = (msg: string) => {
      if (!status) return;
      status.textContent = msg;
      window.setTimeout(() => {
        if (status.textContent === msg) status.textContent = "";
      }, 1600);
    };

    playBtn?.addEventListener("click", togglePlay);
    sideButtons.forEach((b) => b.addEventListener("click", () => setSide(b.dataset.epSide as "a" | "b")));
    stemButtons.forEach((b) => b.addEventListener("click", () => setStem(b.dataset.epStem!)));

    pickBtn?.addEventListener("click", () => {
      const side = stage.dataset.side;
      const note = comment?.value.trim() ?? "";
      const noteFrag = note ? ` · comment: "${note.slice(0, 40)}${note.length > 40 ? "…" : ""}"` : "";
      flash(`picked ${side?.toUpperCase()}${noteFrag} · next pair queued`);
      // Simulate "next pair" by briefly flashing the panels.
      stage.classList.add("ep-just-picked");
      window.setTimeout(() => stage.classList.remove("ep-just-picked"), 700);
    });
    skipBtn?.addEventListener("click", () => flash("skipped · next pair queued"));
    retryBtn?.addEventListener("click", () => {
      const note = comment?.value.trim() ?? "";
      if (!note) {
        flash("write a note first — retry uses your feedback");
        return;
      }
      flash(`retrying ${PAIR.axis} axis with your notes · ~30s on M1`);
    });

    // Keyboard
    stage.tabIndex = 0;
    stage.addEventListener("keydown", (e) => {
      const k = e.key.toLowerCase();
      if (k === " " || k === "spacebar") { e.preventDefault(); togglePlay(); }
      else if (k === "arrowleft" || k === "a" || k === "1") { e.preventDefault(); setSide("a"); }
      else if (k === "arrowright" || k === "b" || k === "2") { e.preventDefault(); setSide("b"); }
      else if (k === "s") { e.preventDefault(); flash("skipped · next pair queued"); }
      else if (k === "enter") { e.preventDefault(); pickBtn?.click(); }
    });
  }
</script>

<style>
  .ep-stage {
    background: rgba(15, 10, 18, 0.94);
    border: 1px solid rgba(245, 241, 232, 0.10);
    border-radius: 8px;
    color: #f5f1e8;
    font-family: "Geist Variable", ui-sans-serif, system-ui, sans-serif;
    overflow: hidden;
    transition: box-shadow 200ms ease, border-color 200ms ease;
  }
  .ep-stage:focus-within {
    border-color: rgba(255, 90, 60, 0.45);
    box-shadow: 0 0 0 1px rgba(255, 90, 60, 0.32);
    outline: none;
  }
  .ep-stage.ep-just-picked {
    box-shadow: 0 0 0 2px rgba(0, 255, 77, 0.45), 0 0 32px -8px rgba(0, 255, 77, 0.45);
    transition: box-shadow 220ms ease;
  }

  .ep-card {
    padding: 22px 24px 18px;
  }

  /* ── Head ── */
  .ep-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    margin-bottom: 14px;
    flex-wrap: wrap;
  }
  .ep-head-left {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
  }
  .ep-source {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-style: italic;
    font-size: 16px;
    font-weight: 700;
    color: #00ff4d;
    background: rgba(0, 255, 77, 0.04);
    border: 1px solid rgba(0, 255, 77, 0.32);
    border-radius: 4px;
    padding: 5px 10px;
    box-shadow: 0 0 12px rgba(0, 255, 77, 0.12);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    min-width: 0;
  }
  .ep-axis {
    flex: 0 0 auto;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    padding: 4px 9px;
    border-radius: 2px;
  }
  .ep-axis-focal {
    color: var(--brand-cyan);
    background: rgba(14, 196, 252, 0.08);
    border: 1px solid rgba(14, 196, 252, 0.45);
  }
  .ep-axis-space {
    color: var(--brand-pink);
    background: rgba(255, 39, 97, 0.08);
    border: 1px solid rgba(255, 39, 97, 0.45);
  }
  .ep-axis-dynamics {
    color: var(--brand-yellow);
    background: rgba(255, 179, 71, 0.08);
    border: 1px solid rgba(255, 179, 71, 0.45);
  }

  .ep-keys {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 10.5px;
    color: rgba(245, 241, 232, 0.48);
    letter-spacing: 0.04em;
  }
  .ep-keys kbd {
    color: rgba(245, 241, 232, 0.78);
    border: 1px solid rgba(245, 241, 232, 0.22);
    background: rgba(245, 241, 232, 0.03);
    border-radius: 2px;
    padding: 1px 5px;
    font-family: inherit;
    font-size: 10px;
    margin: 0 1px;
  }

  /* ── Transport ── */
  .ep-transport {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 12px;
  }
  .ep-play {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid rgba(245, 241, 232, 0.32);
    background: rgba(245, 241, 232, 0.04);
    color: #f5f1e8;
    font-size: 13px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 160ms ease, border-color 160ms ease;
  }
  .ep-stage[data-playing="true"] .ep-play {
    background: rgba(0, 255, 77, 0.08);
    border-color: rgba(0, 255, 77, 0.55);
    color: #00ff4d;
  }
  .ep-time {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 12px;
    color: rgba(245, 241, 232, 0.62);
    font-feature-settings: "tnum";
    flex: 0 0 auto;
  }
  .ep-ab-switch {
    flex: 1 1 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }
  .ep-ab {
    display: flex;
    align-items: center;
    gap: 8px;
    background: rgba(245, 241, 232, 0.03);
    border: 1px solid rgba(245, 241, 232, 0.18);
    border-radius: 4px;
    padding: 8px 12px;
    cursor: pointer;
    transition: border-color 160ms ease, background 160ms ease;
  }
  .ep-ab[data-side-active="true"].ep-ab-a {
    border-color: rgba(14, 196, 252, 0.65);
    background: rgba(14, 196, 252, 0.06);
  }
  .ep-ab[data-side-active="true"].ep-ab-b {
    border-color: rgba(255, 39, 97, 0.65);
    background: rgba(255, 39, 97, 0.06);
  }
  .ep-ab-key {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-style: italic;
    font-weight: 700;
    font-size: 15px;
    color: rgba(245, 241, 232, 0.55);
  }
  .ep-ab-a[data-side-active="true"] .ep-ab-key { color: var(--brand-cyan); }
  .ep-ab-b[data-side-active="true"] .ep-ab-key { color: var(--brand-pink); }
  .ep-ab-label {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11.5px;
    color: rgba(245, 241, 232, 0.78);
  }

  /* ── Waveform ── */
  .ep-wave {
    position: relative;
    height: 60px;
    background: #07060c;
    border-radius: 3px;
    overflow: hidden;
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    gap: 1px;
    padding: 0 6px;
  }
  .ep-wave-bar {
    flex: 1 1 0;
    background: linear-gradient(180deg, rgba(14, 196, 252, 0.6) 0%, rgba(14, 196, 252, 0.28) 100%);
    border-radius: 1px;
    transition: background 240ms ease;
  }
  .ep-stage[data-side="b"] .ep-wave-bar {
    background: linear-gradient(180deg, rgba(255, 39, 97, 0.6) 0%, rgba(255, 39, 97, 0.28) 100%);
  }
  .ep-playhead {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 2px;
    left: 0%;
    background: #f5f1e8;
    box-shadow: 0 0 6px rgba(245, 241, 232, 0.5);
    pointer-events: none;
    z-index: 2;
  }
  .ep-stage[data-playing="false"] .ep-playhead { opacity: 0; }

  /* ── Solo bar ── */
  .ep-solos {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 14px;
  }
  .ep-solo {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-style: italic;
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(245, 241, 232, 0.62);
    background: rgba(245, 241, 232, 0.03);
    border: 1px solid rgba(245, 241, 232, 0.18);
    border-radius: 20px;
    padding: 4px 12px;
    cursor: pointer;
    transition: color 160ms ease, border-color 160ms ease, background 160ms ease;
  }
  .ep-solo:hover {
    color: #f5f1e8;
    border-color: rgba(245, 241, 232, 0.45);
  }
  .ep-solo[data-active="true"] {
    color: #0e0c14;
    background: linear-gradient(90deg, #ff2761 0%, #ff5a3c 100%);
    border-color: transparent;
  }

  /* ── Panels (A / B side-by-side) ── */
  .ep-panels {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    margin-bottom: 14px;
  }
  @media (max-width: 720px) {
    .ep-panels { grid-template-columns: 1fr; }
  }
  .ep-panel {
    background: rgba(245, 241, 232, 0.02);
    border: 1px solid rgba(245, 241, 232, 0.10);
    border-radius: 4px;
    padding: 14px 16px;
    transition: border-color 200ms ease, opacity 200ms ease;
  }
  .ep-stage[data-side="a"] .ep-panel-b,
  .ep-stage[data-side="b"] .ep-panel-a {
    opacity: 0.52;
  }
  .ep-stage[data-side="a"] .ep-panel-a {
    border-color: rgba(14, 196, 252, 0.45);
    background: rgba(14, 196, 252, 0.03);
  }
  .ep-stage[data-side="b"] .ep-panel-b {
    border-color: rgba(255, 39, 97, 0.45);
    background: rgba(255, 39, 97, 0.03);
  }

  .ep-panel-head {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-bottom: 8px;
  }
  .ep-panel-key {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-style: italic;
    font-weight: 700;
    font-size: 16px;
  }
  .ep-panel-a .ep-panel-key { color: var(--brand-cyan); }
  .ep-panel-b .ep-panel-key { color: var(--brand-pink); }
  .ep-panel-pole {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-style: italic;
    font-size: 13.5px;
    color: rgba(245, 241, 232, 0.82);
  }
  .ep-panel-eyebrow {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 9px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(245, 241, 232, 0.48);
    margin: 10px 0 6px;
  }
  .ep-panel-eyebrow:first-child { margin-top: 0; }
  .ep-panel-list {
    list-style: none;
    padding: 0;
    margin: 0 0 4px;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .ep-panel-list li {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11.5px;
    color: rgba(245, 241, 232, 0.82);
    line-height: 1.4;
    padding-left: 10px;
    position: relative;
  }
  .ep-panel-list li::before {
    content: "·";
    position: absolute;
    left: 2px;
    color: rgba(245, 241, 232, 0.45);
  }

  .ep-translation {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
  }
  .ep-pill {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 10px;
    letter-spacing: 0.04em;
    border-radius: 12px;
    padding: 3px 9px;
    border: 1px solid;
  }
  .ep-pill-good {
    color: var(--brand-green);
    border-color: rgba(0, 255, 77, 0.55);
    background: rgba(0, 255, 77, 0.04);
  }
  .ep-pill-ok {
    color: var(--brand-yellow);
    border-color: rgba(255, 179, 71, 0.55);
    background: rgba(255, 179, 71, 0.04);
  }
  .ep-pill-flag {
    color: var(--brand-pink);
    border-color: rgba(255, 39, 97, 0.55);
    background: rgba(255, 39, 97, 0.04);
