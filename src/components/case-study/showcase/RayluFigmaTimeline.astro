---
// ─────────────────────────────────────────────────────────────────────────
// "YOU JUST GOT THE LINK" — the Figma file as alignment artifact.
//
// Not a carousel. This IS the investor opening the Figma link and scrolling
// it top to bottom for the first time. Five sections stack vertically the
// way real Figma pages do — Brand → Competitive analysis → Strategy →
// Wireframes → Hi-fi. As each section crosses into the viewport it EXPANDS
// into being: the date-stamp blinks in first, then the section name, then
// the content (note → chips → frame → caption) cascades up behind it.
//
// Motion is IntersectionObserver-gated and staged via per-element delays.
// A faux Figma chrome (filename tab, share pill, live cursor) sells the
// "this is the actual file" read without claiming to embed it.
//
// prefers-reduced-motion → every section starts fully revealed, no motion.
// Headless preview throttles transitions, so a scroll/timeout fallback
// force-reveals anything still hidden after a beat.
// ─────────────────────────────────────────────────────────────────────────

const SECTIONS = [
  {
    id: "01",
    name: "Brand",
    date: "Apr 2023",
    note: "First palette explorations, the whale mascot, and the headline thesis: \"tools to make ML safe.\"",
    chips: ["palette", "whale", "tone-of-voice"],
    accent: "cyan",
    asset: "/case-studies/raylu/cover.png",
    assetAlt: "Raylu pixel-art whale mascot on teal.",
    assetCaption: "The whale mascot — picked because it reads friendly at any scale.",
  },
  {
    id: "02",
    name: "Competitive analysis",
    date: "Apr 2023",
    note: "Five sibling ML-tooling products mapped on a 2×2 of fidelity vs scope, takeaways pinned per quadrant.",
    chips: ["Snorkel", "Weights & Biases", "Roboflow", "DataRobot", "Galileo"],
    accent: "pink",
    asset: null,
    assetCaption: "Kept the work honest — no surface someone else already shipped.",
  },
  {
    id: "03",
    name: "Strategy / thesis",
    date: "May 2023",
    note: "Goal: provide the tools to make ML safe. Deterministic vs unbounded — we built for the unbounded case.",
    chips: ["observability", "pipelines, not models", "human-rules over"],
    accent: "yellow",
    asset: "/case-studies/raylu/notion-35fed8d4704f80d780aaf0ab65e049a7.png",
    assetAlt: "Strategy slide: Raylu's goal is to provide tools that make ML safe. ML splits into Deterministic and Unbounded; we work in the unbounded case via pipelines.",
    assetCaption: "Pipelines, not single models. Human rules over the chain. That positioning carried into every screen.",
  },
  {
    id: "04",
    name: "Wireframes",
    date: "Jun 2023",
    note: "Founder sketches translated into low-fi frames. Two starting paths: talk to a chat bot, or boot a premade system.",
    chips: ["chat-first", "premade systems", "two-path entry"],
    accent: "white",
    asset: "/case-studies/raylu/notion-35fed8d4704f808d9ca0f53a5b38a89d.png",
    assetAlt: "Founder sketch for the model-prototype starting page. Sidebar icons, a chat-style interface, and an All systems grid of recommendation-system cards. Annotated: 'either talk to chat bot or boot up premade system.'",
    assetCaption: "Founder sketch (mid-Zoom call, then traced in Figma the same afternoon). The annotation became the V0 nav model.",
  },
  {
    id: "05",
    name: "Hi-fi prototype",
    date: "Jul 2023",
    note: "Pipeline builder hi-fi — model-integration nav, label-errors workflow, UMAP slicing. Clickable for investor demos.",
    chips: ["pipeline UI", "UMAP slicing", "label errors"],
    accent: "green",
    asset: "/case-studies/raylu/notion-35fed8d4704f8005968fd121bdbfc1d8.png",
    assetAlt: "Raylu hi-fi UMAP slicing UI. A scatterplot with orange and green clusters, a left rail of sliders (point size, opacity, thumbnail size), and a UMAP reduction-algorithm selector. Model Integration button top right.",
    assetCaption: "The hi-fi pipeline — model nav, label errors, UMAP slicing. The investor didn't just scroll past this screen. In a moment, you'll open it yourself.",
  },
];
---

<div class="ry-fig" data-ry-fig>
  {/* faux Figma chrome — sells "you opened the actual link" */}
  <div class="ry-fig-bar">
    <span class="ry-fig-dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="ry-fig-file">
      <span class="ry-fig-file-icon" aria-hidden="true">◢</span>
      raylu — workspace
      <span class="ry-fig-file-ext">.fig</span>
    </span>
    <span class="ry-fig-presence" aria-label="In the file right now: you and the two founders">
      <span class="ry-fig-cursors" aria-hidden="true"><i class="ry-c3"></i><i class="ry-c1"></i><i class="ry-c2"></i></span>
      <span class="ry-fig-who">you + the two founders</span>
    </span>
    <span class="ry-fig-share" aria-hidden="true">
      <span class="ry-fig-share-cur"></span>
      Anyone with the link
    </span>
  </div>

  {/* scroll progress through the file */}
  <div class="ry-fig-rail" aria-hidden="true">
    <div class="ry-fig-rail-fill" data-ry-fill></div>
  </div>

  <div class="ry-fig-pages">
    {SECTIONS.map((s, i) => (
      <section
        class:list={["ry-pg", `ry-acc-${s.accent}`]}
        data-ry-pg={i}
      >
        {/* the spine number + the connector dot that "draws" the file together */}
        <div class="ry-pg-spine" aria-hidden="true">
          <span class="ry-pg-node"></span>
          {i < SECTIONS.length - 1 && <span class="ry-pg-thread"></span>}
        </div>

        <div class="ry-pg-body">
          <div class="ry-pg-head">
            <span class="ry-pg-stamp" data-ry-el="0">
              <span class="ry-pg-stamp-dot"></span>{s.date} · added by Jon
            </span>
            <h4 class="ry-pg-name" data-ry-el="1">
              <span class="ry-pg-num">{s.id}</span>{s.name}
            </h4>
          </div>

          <p class="ry-pg-note" data-ry-el="2">{s.note}</p>

          <ul class="ry-pg-chips" data-ry-el="3">
            {s.chips.map((c) => <li>{c}</li>)}
          </ul>

          <div
            class:list={["ry-pg-frame", { "ry-pg-frame-empty": !s.asset }]}
            data-ry-el="4"
          >
            {s.asset ? (
              <img src={s.asset} alt={s.assetAlt} loading="lazy" />
            ) : (
              <div class="ry-pg-matrix">
                <span class="ry-pg-axis ry-pg-axis-y">fidelity →</span>
                <span class="ry-pg-axis ry-pg-axis-x">scope →</span>
                <span class="ry-pg-q" style="--qx:0;--qy:0">Snorkel</span>
                <span class="ry-pg-q" style="--qx:1;--qy:0">W&amp;B</span>
                <span class="ry-pg-q" style="--qx:0;--qy:1">Roboflow</span>
                <span class="ry-pg-q" style="--qx:1;--qy:1">DataRobot</span>
                <span class="ry-pg-q ry-pg-q-us" style="--qx:0.5;--qy:0.5">raylu</span>
              </div>
            )}
          </div>

          <p class="ry-pg-cap" data-ry-el="5">{s.assetCaption}</p>
        </div>
      </section>
    ))}
  </div>

  <div class="ry-fig-end" data-ry-el="0" data-ry-pg="end">
    <span class="ry-fig-end-line">end of file — you now know the product</span>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>("[data-ry-fig]");
  if (root) {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const pages = Array.from(
      root.querySelectorAll<HTMLElement>("[data-ry-pg]")
    );
    const fill = root.querySelector<HTMLElement>("[data-ry-fill]");

    const revealAll = () => pages.forEach((p) => p.classList.add("ry-in"));

    if (reduce) {
      revealAll();
    } else {
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              (e.target as HTMLElement).classList.add("ry-in");
              io.unobserve(e.target);
            }
          }
        },
        // fire a touch before fully on-screen so the cascade reads as the
        // section "arriving" rather than already sitting there.
        { threshold: 0.22, rootMargin: "0px 0px -12% 0px" }
      );
      pages.forEach((p) => io.observe(p));

      // Headless/preview tabs throttle IO + transitions; guarantee anything
      // still hidden after a beat gets shown. Real browsers have already
      // revealed on scroll, so this is a no-op there.
      window.setTimeout(() => {
        pages.forEach((p) => {
          const r = p.getBoundingClientRect();
          if (r.top < window.innerHeight && r.bottom > 0)
            p.classList.add("ry-in");
        });
      }, 1400);
    }

    // file-scroll progress on the left rail — purely decorative, cheap.
    if (fill) {
      const pagesWrap =
        root.querySelector<HTMLElement>(".ry-fig-pages") ?? root;
      const onScroll = () => {
        const r = pagesWrap.getBoundingClientRect();
        const total = r.height - window.innerHeight * 0.5;
        const seen = Math.min(
          1,
          Math.max(0, (window.innerHeight * 0.5 - r.top) / Math.max(1, total))
        );
        fill.style.transform = `scaleY(${seen})`;
      };
      window.addEventListener("scroll", onScroll, { passive: true });
      onScroll();
    }
  }
</script>

<style>
  /* ── the file shell ────────────────────────────────────────────────── */
  .ry-fig {
    position: relative;
    border: 1px solid var(--cs-line-strong);
    border-radius: 8px;
    overflow: hidden;
    background:
      radial-gradient(140% 60% at 50% -10%, rgba(14, 196, 252, 0.05), transparent 55%),
      linear-gradient(180deg, #0c0a12 0%, #08070d 100%);
    box-shadow: 0 30px 80px -44px rgba(0, 0, 0, 0.85);
  }

  /* faux Figma title bar */
  .ry-fig-bar {
    position: sticky;
    top: 0;
    z-index: 8;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 10px 16px;
    background: rgba(8, 7, 13, 0.86);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--cs-line);
  }
  .ry-fig-dots { display: inline-flex; gap: 6px; flex: 0 0 auto; }
  .ry-fig-dots i {
    width: 10px; height: 10px; border-radius: 50%;
    background: rgba(245, 241, 232, 0.16);
  }
  .ry-fig-file {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 12px;
    color: rgba(245, 241, 232, 0.86);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .ry-fig-file-icon { color: var(--brand-cyan); font-size: 11px; transform: rotate(0deg); }
  .ry-fig-file-ext { color: rgba(245, 241, 232, 0.4); }
  /* live presence — read as "you + the two founders", not decoration */
  .ry-fig-presence {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    flex: 0 0 auto;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 10.5px;
    letter-spacing: 0.02em;
    color: rgba(245, 241, 232, 0.58);
  }
  .ry-fig-who { white-space: nowrap; }
  .ry-fig-share {
    margin-left: 10px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex: 0 0 auto;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 10.5px;
    letter-spacing: 0.02em;
    color: var(--brand-green);
    background: rgba(0, 255, 77, 0.06);
    border: 1px solid rgba(0, 255, 77, 0.32);
    border-radius: 20px;
    padding: 4px 11px;
  }
  .ry-fig-share-cur {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--brand-green);
    box-shadow: 0 0 6px var(--brand-green);
  }
  /* three live cursors — you (cyan) + the two founders (pink, yellow) */
  .ry-fig-cursors { display: inline-flex; gap: 4px; }
  .ry-fig-cursors i { width: 6px; height: 6px; border-radius: 50%; }
  .ry-c3 { background: var(--brand-cyan); box-shadow: 0 0 6px var(--brand-cyan); animation: ry-blink 2.4s ease-in-out infinite; }
  .ry-c1 { background: var(--brand-pink); animation: ry-blink 2.4s ease-in-out 0.8s infinite; }
  .ry-c2 { background: var(--brand-yellow); animation: ry-blink 2.4s ease-in-out 1.6s infinite; }
  @keyframes ry-blink { 0%, 100% { opacity: 1; } 50% { opacity: 0.25; } }

  /* left scroll-progress rail */
  .ry-fig-rail {
    position: absolute;
    top: 41px; bottom: 0; left: 0;
    width: 2px;
    background: rgba(245, 241, 232, 0.06);
    z-index: 2;
  }
  .ry-fig-rail-fill {
    position: absolute;
    inset: 0;
    background: var(--brand-grad);
    transform: scaleY(0);
    transform-origin: top;
  }

  /* ── pages ─────────────────────────────────────────────────────────── */
  .ry-fig-pages { padding: 8px 0 0; }

  .ry-pg {
    position: relative;
    display: grid;
    grid-template-columns: 44px 1fr;
    padding: 30px 26px 30px 0;
  }
  .ry-pg + .ry-pg { border-top: 1px solid rgba(245, 241, 232, 0.05); }

  /* the spine: a node dot + a thread connecting sections, "drawing" the
     single-file story. The node lights to the section accent on reveal. */
  .ry-pg-spine {
    position: relative;
    display: flex;
    justify-content: center;
  }
  .ry-pg-node {
    position: relative;
    z-index: 2;
    width: 11px; height: 11px;
    margin-top: 4px;
    border-radius: 50%;
    background: #0c0a12;
    border: 2px solid rgba(245, 241, 232, 0.22);
    transition: border-color 460ms ease, box-shadow 460ms ease, transform 460ms ease;
  }
  .ry-pg-thread {
    position: absolute;
    top: 15px; bottom: -30px;
    left: 50%;
    width: 2px;
    transform: translateX(-50%) scaleY(0);
    transform-origin: top;
    background: linear-gradient(180deg, currentColor, transparent);
    transition: transform 700ms ease 120ms;
  }
  /* Per-accent palette. Explicit rgba (no color-mix) to match the house
     style and avoid a no-fallback dependency. --ry-a is the solid accent;
     --ry-soft is a cream-leaning text tint; --ry-08/--ry-28 are translucent
     fills; --ry-ring is the node halo. */
  .ry-acc-cyan {
    color: var(--brand-cyan);
    --ry-a: var(--brand-cyan);
    --ry-soft: #9fe6fd; --ry-08: rgba(14,196,252,0.08);
    --ry-28: rgba(14,196,252,0.32); --ry-ring: rgba(14,196,252,0.16);
  }
  .ry-acc-pink {
    color: var(--brand-pink);
    --ry-a: var(--brand-pink);
    --ry-soft: #ff9bb6; --ry-08: rgba(255,39,97,0.08);
    --ry-28: rgba(255,39,97,0.32); --ry-ring: rgba(255,39,97,0.16);
  }
  .ry-acc-yellow {
    color: var(--brand-yellow);
    --ry-a: var(--brand-yellow);
    --ry-soft: #ffd79c; --ry-08: rgba(255,179,71,0.08);
    --ry-28: rgba(255,179,71,0.34); --ry-ring: rgba(255,179,71,0.18);
  }
  .ry-acc-white {
    color: rgba(245, 241, 232, 0.7);
    --ry-a: rgba(245, 241, 232, 0.7);
    --ry-soft: rgba(245,241,232,0.9); --ry-08: rgba(245,241,232,0.06);
    --ry-28: rgba(245,241,232,0.28); --ry-ring: rgba(245,241,232,0.14);
  }
  .ry-acc-green {
    color: var(--brand-green);
    --ry-a: var(--brand-green);
    --ry-soft: #8dffb0; --ry-08: rgba(0,255,77,0.08);
    --ry-28: rgba(0,255,77,0.32); --ry-ring: rgba(0,255,77,0.16);
  }
  .ry-in .ry-pg-node {
    border-color: var(--ry-a);
    box-shadow: 0 0 0 4px var(--ry-ring);
    transform: scale(1.08);
  }
  .ry-in .ry-pg-thread { transform: translateX(-50%) scaleY(1); }

  .ry-pg-body { min-width: 0; }

  .ry-pg-head { margin-bottom: 12px; }
  .ry-pg-stamp {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ry-soft);
  }
  .ry-pg-stamp-dot {
    width: 5px; height: 5px; border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 7px currentColor;
  }
  .ry-pg-name {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin: 8px 0 0;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-style: italic;
    font-weight: 700;
    font-size: clamp(21px, 3.4vw, 30px);
    letter-spacing: -0.01em;
    line-height: 1.05;
    color: var(--cs-text);
  }
  .ry-pg-num {
    font-style: normal;
    font-size: 11px;
    letter-spacing: 0.22em;
    color: var(--ry-soft);
    opacity: 0.85;
  }
  .ry-pg-note {
    font-size: 14.5px;
    line-height: 1.55;
    color: rgba(245, 241, 232, 0.8);
    margin: 0 0 14px;
    max-width: 56ch;
  }
  .ry-pg-chips {
    list-style: none;
    padding: 0;
    margin: 0 0 16px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .ry-pg-chips li {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 10.5px;
    letter-spacing: 0.04em;
    color: var(--ry-soft);
    padding: 3px 9px;
    background: var(--ry-08);
    border: 1px solid var(--ry-28);
    border-radius: 2px;
  }

  /* the frame: a real Figma frame label sits above the artwork */
  .ry-pg-frame {
    position: relative;
    border: 1px solid var(--cs-line);
    border-top: 2px solid var(--ry-a);
    border-radius: 5px;
    overflow: hidden;
    background: #07060c;
    margin-bottom: 12px;
  }
  .ry-pg-frame::before {
    content: "▸ frame";
    position: absolute;
    top: 7px; left: 9px;
    z-index: 2;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 8.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ry-soft);
    background: rgba(7, 6, 12, 0.7);
    padding: 2px 6px;
    border-radius: 3px;
    pointer-events: none;
  }
  .ry-pg-frame img { display: block; width: 100%; height: auto; }

  /* competitive 2×2 — built, not screenshotted */
  .ry-pg-frame-empty { min-height: 230px; background: #08070d; }
  .ry-pg-matrix {
    position: relative;
    height: 100%;
    min-height: 230px;
    margin: 0;
    background-image:
      linear-gradient(rgba(245, 241, 232, 0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgba(245, 241, 232, 0.07) 1px, transparent 1px);
    background-size: 50% 50%;
    background-position: center;
  }
  .ry-pg-axis {
    position: absolute;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 9px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(245, 241, 232, 0.4);
  }
  .ry-pg-axis-y { top: 12px; left: 12px; transform: rotate(0deg); }
  .ry-pg-axis-x { bottom: 12px; right: 12px; }
  .ry-pg-q {
    position: absolute;
    left: calc(14% + var(--qx) * 60%);
    top: calc(18% + var(--qy) * 56%);
    transform: translate(-50%, -50%);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-style: italic;
    font-size: 12px;
    color: rgba(245, 241, 232, 0.72);
    padding: 5px 11px;
    background: rgba(245, 241, 232, 0.03);
    border: 1px dashed rgba(245, 241, 232, 0.2);
    border-radius: 3px;
    white-space: nowrap;
  }
  .ry-pg-q-us {
    color: var(--brand-pink);
    border-style: solid;
    border-color: rgba(255, 39, 97, 0.5);
    background: rgba(255, 39, 97, 0.06);
  }

  .ry-pg-cap {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-style: italic;
    font-size: 12px;
    line-height: 1.5;
    color: rgba(245, 241, 232, 0.52);
    margin: 0;
    max-width: 70ch;
  }

  /* end-of-file marker */
  .ry-fig-end {
    display: flex;
    justify-content: center;
    padding: 22px 26px 26px 44px;
    border-top: 1px solid rgba(245, 241, 232, 0.05);
  }
  .ry-fig-end-line {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 10.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(245, 241, 232, 0.4);
  }

  /* ── the reveal cascade ────────────────────────────────────────────── */
  /* every staged element starts dropped + faded; .ry-in releases them with
     per-element delays so the section "expands into view" stamp-first. */
  [data-ry-el] {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 560ms cubic-bezier(0.22, 1, 0.36, 1),
                transform 560ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .ry-in [data-ry-el] { opacity: 1; transform: none; }
  .ry-in [data-ry-el="0"] { transition-delay: 40ms; }
  .ry-in [data-ry-el="1"] { transition-delay: 150ms; }
  .ry-in [data-ry-el="2"] { transition-delay: 300ms; }
  .ry-in [data-ry-el="3"] { transition-delay: 400ms; }
  .ry-in [data-ry-el="4"] { transition-delay: 500ms; }
  .ry-in [data-ry-el="5"] { transition-delay: 640ms; }

  /* ── responsive ────────────────────────────────────────────────────── */
  @media (max-width: 720px) {
    .ry-pg { grid-template-columns: 30px 1fr; padding: 24px 16px 24px 0; }
    .ry-pg-node { width: 9px; height: 9px; }
    .ry-fig-rail { top: 39px; }
    .ry-fig-presence { font-size: 9.5px; gap: 6px; }
    .ry-fig-share { font-size: 9.5px; padding: 4px 9px; gap: 6px; }
    .ry-pg-q { font-size: 10.5px; padding: 4px 8px; }
    .ry-fig-end { padding-left: 30px; }
  }
  @media (max-width: 540px) {
    /* drop the word labels first; the blinking cursors are the affordance
       that "you + the two founders" are live in the file. */
    .ry-fig-who { display: none; }
    .ry-fig-share { font-size: 0; gap: 5px; padding: 5px 9px; }
