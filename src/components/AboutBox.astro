---
/**
 * AboutBox — a kraft carton, sealed and scrawled "business analyst" in marker.
 * That's the label. Lean in (hover / focus) and the two flaps fold open, the
 * seal breaks, and the box turns out to be packed with the real work — the
 * things Jon actually does, rising out on a calm stagger. "You can't keep me in
 * one box."
 *
 * Rebuilt as CSS 3D (was a flat SVG): the flaps fold on a real hinge, the
 * interior is a warm recess so the contents read as INSIDE the box, and the
 * spill is curated + eased to match the work index. The accent re-themes; the
 * cardboard is cardboard in every theme. Decorative — the full contents are in
 * the figure's aria-label.
 */
// The spill: a blend of who he is (the big surprise + the identities) and the
// proof (a quieter tier), with one icon — a turtle named Richard, the Console's
// mix engineer — tucked in as an easter egg. Three type tiers, not five colors.
const SPILL = [
  { t: "soundbender", k: "word", cls: "accent big", x: 35, y: 19, r: -3, d: 0 },
  { t: "designer", k: "word", cls: "id", x: 70, y: 15, r: 3, d: 1 },
  { t: "builder", k: "word", cls: "id", x: 17, y: 39, r: -2, d: 2 },
  { t: "engineer", k: "word", cls: "id", x: 79, y: 41, r: 4, d: 2 },
  { t: "design systems", k: "word", cls: "proof", x: 45, y: 37, r: 1, d: 3 },
  { t: "AI tooling", k: "word", cls: "proof", x: 25, y: 59, r: -2, d: 4 },
  { t: "interfaces", k: "word", cls: "proof", x: 65, y: 60, r: 2, d: 3 },
  { t: "prototyping", k: "word", cls: "proof", x: 41, y: 75, r: -1, d: 4 },
  { t: "ships products", k: "word", cls: "proof", x: 72, y: 80, r: 3, d: 5 },
  { t: "🐢", k: "emoji", cls: "", x: 15, y: 80, r: -7, d: 6 },
];
const ARIA =
  "A cardboard box sealed with tape and scrawled “business analyst” in marker. " +
  "Open it and it's packed with who he really is — soundbender, designer, builder, " +
  "engineer — and the proof: design systems, AI tooling, interfaces, prototyping, " +
  "shipped products, and a small turtle named Richard.";
---

<figure class="ab" tabindex="0" aria-label={ARIA}>
  <div class="ab-stage">
    <div class="ab-box">
      <!-- the recessed interior + the spill -->
      <div class="ab-window">
        <ul class="ab-spill">
          {SPILL.map((s) => (
            <li
              class:list={["ab-i", s.k, s.cls]}
              style={`--x:${s.x}%; --y:${s.y}%; --r:${s.r}deg; --d:${s.d}`}
            >{s.t}</li>
          ))}
        </ul>
        <span class="ab-rim" aria-hidden="true"></span>
      </div>

      <!-- two flaps that fold open on a real hinge -->
      <div class="ab-flap ab-flap-top" aria-hidden="true"></div>
      <div class="ab-flap ab-flap-bottom" aria-hidden="true"></div>

      <!-- the seal: tape + sharpie label across the seam (fades as it opens) -->
      <div class="ab-seal" aria-hidden="true">
        <span class="ab-tape"></span>
        <span class="ab-label">business analyst</span>
      </div>
    </div>
  </div>
</figure>

<style>
  .ab { margin: 0; width: 100%; outline: none; }
  .ab-stage { perspective: 1300px; perspective-origin: 50% 42%; }
  .ab-box {
    position: relative;
    width: 100%;
    max-width: 25rem;
    margin: 0 auto;
    aspect-ratio: 5 / 4;
    transform-style: preserve-3d;
    transition: transform 600ms cubic-bezier(0.2, 0, 0, 1);
  }
  /* a soft contact shadow under the carton */
  .ab-box::after {
    content: "";
    position: absolute;
    left: 7%; right: 7%; bottom: -7%;
    height: 14%;
    background: radial-gradient(ellipse at center, rgba(0, 0, 0, 0.55), transparent 72%);
    filter: blur(7px);
    z-index: -1;
  }

  /* ---- interior ---- */
  .ab-window {
    position: absolute;
    inset: 0;
    border-radius: 10px;
    background: radial-gradient(125% 130% at 50% -10%, #2a1d10, #130d07 68%);
    box-shadow: inset 0 8px 30px rgba(0, 0, 0, 0.78), inset 0 0 0 2px #32230f;
    overflow: hidden;
  }
  /* a faint top rim so the opening reads as an edge */
  .ab-rim {
    position: absolute; top: 0; left: 0; right: 0; height: 14px;
    background: linear-gradient(#3a2812, transparent);
    opacity: 0.9;
  }

  .ab-spill { position: absolute; inset: 0; list-style: none; margin: 0; padding: 0; }
  .ab-i {
    position: absolute;
    left: var(--x); top: var(--y);
    transform: translate(-50%, -50%) rotate(var(--r)) translateY(16px) scale(0.92);
    opacity: 0;
    white-space: nowrap;
    transition: opacity 360ms ease, transform 520ms cubic-bezier(0.2, 0, 0, 1);
    transition-delay: 0ms;
  }
  .ab-i.word {
    font-family: "Space Grotesk Variable", "Space Grotesk", ui-sans-serif, system-ui, sans-serif;
    font-weight: 600; font-size: 1.05rem; letter-spacing: -0.01em; color: #efe7d4;
  }
  .ab-i.big { font-size: 1.6rem; }
  .ab-i.accent { color: var(--accent); }
  /* identities — bright cream, the "what you are" tier */
  .ab-i.id { color: #f3ecdb; }
  /* proof — quieter + smaller, the "what you do" tier */
  .ab-i.proof { font-weight: 500; font-size: 0.92rem; color: #a89e8c; }
  .ab-i.emoji {
    font-family: "Apple Color Emoji", "Segoe UI Emoji", "Noto Color Emoji", sans-serif;
    font-size: 1.9rem;
    filter: drop-shadow(0 3px 5px rgba(0, 0, 0, 0.5));
  }

  /* ---- flaps ---- */
  .ab-flap {
    position: absolute;
    left: 0;
    width: 100%;
    height: 50%;
    backface-visibility: hidden;
    transition: transform 620ms cubic-bezier(0.5, 0, 0.12, 1);
    background:
      repeating-linear-gradient(90deg, rgba(0, 0, 0, 0.05) 0 1px, transparent 1px 7px),
      linear-gradient(167deg, #d8b074, #c0915220 0%, #b9894c);
    box-shadow: inset 0 0 0 1px rgba(94, 64, 27, 0.6);
  }
  .ab-flap-top {
    top: 0;
    transform-origin: top center;
    border-radius: 10px 10px 0 0;
    background:
      repeating-linear-gradient(90deg, rgba(0, 0, 0, 0.05) 0 1px, transparent 1px 7px),
      linear-gradient(180deg, #dcb478, #c89a58);
    box-shadow: inset 0 -2px 6px rgba(0, 0, 0, 0.18), inset 0 0 0 1px rgba(94, 64, 27, 0.6);
  }
  .ab-flap-bottom {
    bottom: 0;
    transform-origin: bottom center;
    border-radius: 0 0 10px 10px;
    background:
      repeating-linear-gradient(90deg, rgba(0, 0, 0, 0.05) 0 1px, transparent 1px 7px),
      linear-gradient(0deg, #cda367, #bb934f);
    box-shadow: inset 0 2px 6px rgba(0, 0, 0, 0.22), inset 0 0 0 1px rgba(94, 64, 27, 0.6);
  }

  /* ---- seal ---- */
  .ab-seal {
    position: absolute;
    left: 0; right: 0; top: 50%;
    transform: translateY(-50%);
    height: 23%;
    display: flex; align-items: center; justify-content: center;
    transition: opacity 320ms ease;
  }
  .ab-tape {
    position: absolute; inset: 0;
    background: linear-gradient(180deg, #e3cd97, #d6bd80);
    box-shadow: inset 0 3px 4px rgba(255, 255, 255, 0.18), inset 0 -3px 5px rgba(0, 0, 0, 0.16);
    opacity: 0.94;
  }
  .ab-label {
    position: relative;
    font-family: "Space Grotesk Variable", "Space Grotesk", sans-serif;
    font-weight: 800;
    font-size: clamp(1.2rem, 3.4vw, 1.9rem);
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: #1a120a;
    transform: rotate(-1.2deg);
    text-shadow: 0 1px 0 rgba(255, 255, 255, 0.12);
  }

  /* ---- open: flaps fold back, seal breaks, the spill rises. Triggered by
     hover, keyboard focus, OR a tap-toggled .is-open so touch works too. ---- */
  .ab:hover .ab-flap-top, .ab:focus-within .ab-flap-top, .ab.is-open .ab-flap-top { transform: rotateX(-158deg); }
  .ab:hover .ab-flap-bottom, .ab:focus-within .ab-flap-bottom, .ab.is-open .ab-flap-bottom { transform: rotateX(158deg); }
  .ab:hover .ab-seal, .ab:focus-within .ab-seal, .ab.is-open .ab-seal { opacity: 0; }
  .ab:hover .ab-i, .ab:focus-within .ab-i, .ab.is-open .ab-i {
    opacity: 1;
    transform: translate(-50%, -50%) rotate(var(--r)) translateY(0) scale(1);
  }
  /* stagger the spill as it opens */
  .ab-i { transition-delay: 0ms; }
  .ab:hover .ab-i, .ab:focus-within .ab-i, .ab.is-open .ab-i { transition-delay: calc(var(--d) * 48ms + 140ms); }

  .ab:focus-visible { outline: none; }
  .ab:focus-visible .ab-box { outline: 2px solid var(--accent); outline-offset: 14px; border-radius: 4px; }

  @media (prefers-reduced-motion: reduce) {
    .ab-box, .ab-flap, .ab-i, .ab-seal { transition-duration: 200ms; }
    .ab:hover .ab-flap-top, .ab:focus-within .ab-flap-top, .ab.is-open .ab-flap-top,
    .ab:hover .ab-flap-bottom, .ab:focus-within .ab-flap-bottom, .ab.is-open .ab-flap-bottom { transform: none; opacity: 0; }
    .ab-i { transform: translate(-50%, -50%) rotate(var(--r)); }
    .ab:hover .ab-i, .ab:focus-within .ab-i { transition-delay: 0ms; }
  }
</style>

<script>
  // Tap / click toggles the box open too, so touch devices (which have no
  // hover) can look inside. Hover and keyboard focus still open it via CSS.
  document.querySelectorAll<HTMLElement>(".ab").forEach((el) => {
    el.addEventListener("click", () => el.classList.toggle("is-open"));
  });
</script>
