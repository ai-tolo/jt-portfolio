---
/**
 * AboutBox — a cardboard box, facing you. CLOSED at rest: sealed across the
 * middle with tape, "BUSINESS ANALYST" scrawled on it in thick black Sharpie.
 * That's the label. Lean in (hover / focus) and the two flaps swing open, the
 * seal breaks, and the box turns out to be stuffed past capacity — a loud,
 * colorful jumble of everything Jon actually is: gear, sound, the Console, the
 * turtle, and the words for the work — all erupting up as the lid gives.
 * "You can't keep me in one box."
 *
 * The cardboard + Sharpie are fixed; the contents are a deliberate riot of
 * colour + emoji. Decorative — the full contents live in the aria-label.
 */
const LABEL = "BUSINESS ANALYST";
const fs = 60;
let lx = 500 - (LABEL.length * fs * 0.52) / 2 + fs * 0.26;
const glyphs = [...LABEL].map((ch, i) => {
  const g = { ch, x: lx, rot: ((i * 37) % 7) - 3, dy: ((i * 53) % 5) - 2 };
  lx += fs * 0.52;
  return g;
});

// The riot inside. kind: word | emoji | turtle. Stuffed to bursting — organic
// scatter, big overlapping emoji, words wedged into the gaps.
const STUFF = [
  { k: "emoji", t: "🎧", x: 296, y: 312, s: 54, r: -9 },
  { k: "word", t: "soundbending", x: 360, y: 282, s: 33, c: "acc", r: -3 },
  { k: "emoji", t: "✨", x: 560, y: 292, s: 34, r: 0 },
  { k: "emoji", t: "💿", x: 636, y: 320, s: 46, r: 11 },
  { k: "emoji", t: "🎹", x: 250, y: 408, s: 50, r: 6 },
  { k: "emoji", t: "🎛️", x: 392, y: 366, s: 42, r: -4 },
  { k: "word", t: "jamming", x: 588, y: 374, s: 26, c: "gold", r: 6 },
  { k: "emoji", t: "🎚️", x: 730, y: 356, s: 40, r: -7 },
  { k: "emoji", t: "🧠", x: 408, y: 452, s: 40, r: 5 },
  { k: "word", t: "design systems", x: 250, y: 474, s: 22, c: "cream", r: 3 },
  { k: "emoji", t: "🔊", x: 506, y: 444, s: 44, r: -5 },
  { k: "word", t: "AI tooling", x: 600, y: 454, s: 24, c: "teal", r: -3 },
  { k: "emoji", t: "✏️", x: 728, y: 444, s: 40, r: 13 },
  { k: "emoji", t: "🎨", x: 336, y: 548, s: 48, r: -10 },
  { k: "word", t: "sketching", x: 246, y: 572, s: 24, c: "coral", r: 4 },
  { k: "word", t: "prototyping", x: 458, y: 536, s: 22, c: "cream", r: -2 },
  { k: "turtle", x: 668, y: 524, s: 1.7 },
  { k: "emoji", t: "📼", x: 760, y: 540, s: 40, r: -9 },
  { k: "word", t: "mastering", x: 300, y: 614, s: 23, c: "gold", r: 2 },
  { k: "emoji", t: "🎵", x: 512, y: 612, s: 42, r: 8 },
  { k: "word", t: "sampling", x: 430, y: 624, s: 21, c: "teal", r: 3 },
  { k: "word", t: "doodling", x: 600, y: 606, s: 22, c: "coral", r: -4 },
];
---

<figure
  class="ab"
  tabindex="0"
  aria-label="A cardboard box taped shut and scrawled “business analyst” in marker. Open it and it's stuffed full of the real work — headphones, music, a CD, a screen running the Console, paint, a little turtle, and the words soundbending, jamming, the Console, design systems, AI tooling, sketching, prototyping, mastering and doodling."
>
  <svg class="ab-svg" viewBox="0 0 1000 880" aria-hidden="true">
    <defs>
      <filter id="ab-marker" x="-6%" y="-32%" width="112%" height="164%">
        <feTurbulence type="fractalNoise" baseFrequency="0.014 0.09" numOctaves="2" seed="4" result="n"></feTurbulence>
        <feDisplacementMap in="SourceGraphic" in2="n" scale="4.5"></feDisplacementMap>
      </filter>
    </defs>

    <ellipse class="ab-shadow" cx="500" cy="720" rx="330" ry="22" fill="#000" opacity="0.4"></ellipse>

    <g class="ab-bob">
      <!-- box shell -->
      <polygon points="800,246 830,264 830,656 800,638" fill="#9a6b3a"></polygon>
      <rect x="184" y="234" width="632" height="416" rx="6" fill="#a9763f"></rect>

      <!-- interior + depth shading -->
      <rect x="200" y="246" width="600" height="392" fill="#0d0a07"></rect>
      <polygon points="200,246 800,246 778,270 222,270" fill="#000" opacity="0.5"></polygon>
      <polygon points="200,246 222,270 222,614 200,638" fill="#1c150e" opacity="0.6"></polygon>
      <polygon points="800,246 778,270 778,614 800,638" fill="#000" opacity="0.4"></polygon>

      <!-- THE RIOT — stuffed wall-to-wall, erupts up as the box opens -->
      <g class="ab-contents">
        {STUFF.map((d, i) => (
          <g class="ab-thing" style={`--i:${i}`}>
            {d.k === "turtle" ? (
              <g transform={`translate(${d.x} ${d.y}) scale(${d.s})`}>
                <ellipse class="ab-lna" cx="0" cy="0" rx="19" ry="11"></ellipse>
                <circle class="ab-lna" cx="21" cy="-2" r="5"></circle>
                <line class="ab-lna" x1="-12" y1="9" x2="-16" y2="17"></line>
                <line class="ab-lna" x1="-1" y1="11" x2="-2" y2="20"></line>
                <line class="ab-lna" x1="9" y1="11" x2="10" y2="20"></line>
                <path class="ab-lna" d="M-7,-5 v9 M2,-6 v12 M10,-5 v8"></path>
              </g>
            ) : d.k === "emoji" ? (
              <text class="ab-emoji" x={d.x} y={d.y} font-size={d.s} text-anchor="middle" transform={`rotate(${d.r} ${d.x} ${d.y})`}>{d.t}</text>
            ) : (
              <text class={`ab-word ab-${d.c}`} x={d.x} y={d.y} font-size={d.s} transform={`rotate(${d.r} ${d.x} ${d.y})`}>{d.t}</text>
            )}
          </g>
        ))}
      </g>

      <!-- the two flaps: swing open on hover -->
      <g class="ab-flap ab-flap-bottom">
        <rect x="200" y="442" width="600" height="196" fill="#c19059"></rect>
        <rect x="200" y="442" width="600" height="196" fill="#000" opacity="0.05"></rect>
      </g>
      <g class="ab-flap ab-flap-top">
        <rect x="200" y="246" width="600" height="196" fill="#c89a6b"></rect>
        <rect x="200" y="246" width="600" height="10" fill="#000" opacity="0.05"></rect>
      </g>

      <!-- the seal: tape + sharpie label across the seam (fades as it opens) -->
      <g class="ab-seal">
        <rect x="200" y="412" width="600" height="60" fill="#d9c089" opacity="0.92"></rect>
        <rect x="200" y="412" width="600" height="4" fill="#fff" opacity="0.16"></rect>
        <rect x="200" y="468" width="600" height="4" fill="#000" opacity="0.12"></rect>
        <g class="ab-stamp" filter="url(#ab-marker)" font-family="'Space Grotesk Variable','Space Grotesk',sans-serif" font-weight="800" font-size={fs}>
          {glyphs.map((g) => (
            <text x={g.x.toFixed(1)} y={(461 + g.dy).toFixed(1)} transform={`rotate(${g.rot} ${g.x.toFixed(1)} 461)`}>{g.ch}</text>
          ))}
        </g>
      </g>

      <!-- the only hover target: a focused zone over the label, so you open the
           box by reaching for it, not by brushing past the whole thing -->
      <rect class="ab-hot" x="296" y="372" width="408" height="178" fill="transparent"></rect>
    </g>
  </svg>
</figure>

<style>
  /* The figure isn't the hover target — only the .ab-hot zone is, so you open
     the box by reaching for the label rather than brushing the whole thing.
     pointer-events inherits, so none here + all on .ab-hot isolates the zone.
     Keyboard focus is unaffected (:focus-within still opens it). */
  .ab { margin: 0; width: 100%; outline: none; pointer-events: none; }
  .ab-svg { display: block; width: 100%; height: auto; overflow: visible; }
  .ab-hot { pointer-events: all; cursor: pointer; }

  .ab-lna { fill: none; stroke: var(--accent); stroke-width: 3.2; stroke-linecap: round; stroke-linejoin: round; }
  .ab-word { font-family: "Space Grotesk Variable", "Space Grotesk", ui-sans-serif, system-ui, sans-serif; font-weight: 800; letter-spacing: -0.5px; }
  .ab-acc { fill: var(--accent); }
  .ab-cream { fill: #f5efe2; }
  .ab-gold { fill: #ebc35a; }
  .ab-teal { fill: #5fccc4; }
  .ab-coral { fill: #ff8f6b; }
  .ab-emoji { font-family: "Apple Color Emoji", "Segoe UI Emoji", "Noto Color Emoji", sans-serif; }
  .ab-stamp text { fill: #15100a; stroke: #15100a; stroke-width: 2; stroke-linejoin: round; }

  /* idle: the box breathes a touch, hinting it wants opening */
  .ab-bob { animation: ab-bob 4.5s ease-in-out infinite; transform-box: fill-box; transform-origin: center; }
  @keyframes ab-bob { 0%, 100% { transform: translateY(0) rotate(0deg); } 50% { transform: translateY(-5px) rotate(-0.25deg); } }

  /* flaps swing open about their hinges */
  .ab-flap { transform-box: fill-box; transition: transform 600ms cubic-bezier(0.5, 0, 0.15, 1); }
  .ab-flap-top { transform-origin: top; }
  .ab-flap-bottom { transform-origin: bottom; }
  .ab:hover .ab-flap-top, .ab:focus-within .ab-flap-top { transform: scaleY(-0.42); }
  .ab:hover .ab-flap-bottom, .ab:focus-within .ab-flap-bottom { transform: scaleY(-0.42); }

  .ab-seal { transition: opacity 280ms ease; }
  .ab:hover .ab-seal, .ab:focus-within .ab-seal { opacity: 0; }

  /* the riot erupts: each piece starts low + tiny inside the box, then springs
     up to its place as the lid gives — staggered so it pours out, not pops. */
  .ab-contents .ab-thing {
    opacity: 0;
    transform: translateY(64px) scale(0.35);
    transform-box: fill-box;
    transform-origin: center;
    transition: opacity 320ms ease, transform 560ms cubic-bezier(0.18, 0.9, 0.28, 1.2);
    transition-delay: calc(var(--i) * 26ms + 160ms);
  }
  .ab:hover .ab-thing, .ab:focus-within .ab-thing {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .ab:focus-visible .ab-svg { outline: 2px solid var(--accent); outline-offset: 10px; border-radius: 8px; }

  @media (prefers-reduced-motion: reduce) {
    .ab-bob { animation: none; }
    .ab-flap { transition: opacity 200ms ease; }
    .ab:hover .ab-flap-top, .ab:focus-within .ab-flap-top,
    .ab:hover .ab-flap-bottom, .ab:focus-within .ab-flap-bottom { transform: none; opacity: 0; }
    .ab-contents .ab-thing { transition: opacity 200ms ease; transform: none; transition-delay: 0ms; }
  }
</style>
