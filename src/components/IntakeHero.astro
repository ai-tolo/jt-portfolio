---
// src/components/IntakeHero.astro
// THE WATCH IS A RECORD BUTTON (2026-10-19, late; Jon: "why isn't it just a big record button? A red record button is
// Voice Memos: duh, that's what the watch is doing. It's exemplifying the voice memo workflow, spoken word to
// organized output"; "the vertical lines with the dots next to the watch don't make sense, and a replay button for the
// module above doesn't make sense"). One idea, spoken word → tickets: at rest the face is INTAKE and ONE RED RECORD
// RING. Press: the disc becomes the stop square, the time counts up, the wave moves, the words print at the face's
// foot. Press again: "saved", the runline under the watch while the words are parsed, then the tickets slide out
// BESIDE the watch (under it on a narrow sheet) as Intake cards in the Stream's anatomy. Two seconds later the face is
// the ring again; the cards stay until the next press. Nothing actionable: "nothing to file" for two seconds, no card.
// The run column, its nodes and spine, the fly, the talk pill, Replay and the stages s1–s6 are deleted.
//
// Usage:   <IntakeHero />            (follows the site theme; the host may slot a caption: <p slot="cap">)
//          <IntakeHero theme="dark" /> (force a mode; default 'auto' = html.dark / [data-theme] / html[data-night])
// Needs:   public/intake/watch-blank.png
// LIVE: the speech is the browser's own service; the triage is /api/intake (Claude) with src/lib/intake-local.ts
// behind it, which says so with a chip. Nothing is stored anywhere. A browser without speech types instead.
import { LIVE_COPY } from './studio/objects-copy';

interface Props {
  theme?: 'light' | 'dark' | 'auto';
  class?: string;
}
const { theme = 'auto', class: cls = '' } = Astro.props;
const liveJson = JSON.stringify(LIVE_COPY);
const hasCap = Astro.slots.has('cap');
// the face's wave: 27 bars, the old face's heights and phases (kept: the watch's own drawing)
const BARS = [2.53, 4.43, 6.96, 11.39, 16.46, 22.15, 27.85, 32.91, 30.38, 22.78, 18.35, 25.32, 35.44, 29.11, 20.89, 13.92, 18.99, 26.58, 31.65, 24.05, 15.82, 10.76, 7.59, 5.06, 3.16, 2.53, 1.9];
const MIX = [16, 22, 28, 35, 42, 48, 54, 61, 68, 74, 80, 87, 94, 100, 94, 87, 80, 74, 68, 61, 54, 48, 42, 35, 28, 22, 16];
---
<section class={`intake-hero${theme !== 'auto' ? ' ' + theme : ''}${cls ? ' ' + cls : ''}`} data-intake-hero data-state="rest" aria-label="Intake: say a few things you have to do and watch them become tickets">
  <script type="application/json" data-intake-live set:html={liveJson}></script>
  <div class="grid">
    <div class="watch-col">
      <figure class="watch">
        <div class="screen">
          <div class="brand" aria-hidden="true">INTAKE</div>
          <div class="clock" aria-hidden="true" data-clock>0:00</div>
          <div class="wave" aria-hidden="true">
            {BARS.map((h, i) => <i style={`height:${(h * 0.62).toFixed(2)}cqw;--m:${MIX[i]}%;animation-duration:${(1.98 + (i % 5) * 0.16).toFixed(2)}s;animation-delay:-${((i * 0.395) % 2).toFixed(2)}s`}></i>)}
          </div>
          {/* THE RING: a thin light ring, a red disc inside (Voice Memos' record); the disc becomes the stop square */}
          <button type="button" class="rec" data-rec aria-label={LIVE_COPY.recLabel}><span class="rec-mark"></span></button>
          <p class="said" aria-hidden="true"><span class="typed"></span><span class="interim"></span></p>
          {/* the face's word: "saved" with its check, or "nothing to file" */}
          <div class="note" aria-hidden="true">
            <span class="check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg></span>
            <span class="note-w" data-note>{LIVE_COPY.saved}</span>
          </div>
        </div>
        <img src="/intake/watch-blank.png" alt="" width="521" height="781" loading="lazy" decoding="async" />
      </figure>
      {/* the foot under the watch: the hint (rest, the microphone's states, the privacy line while it listens) and,
          in its place while the words are parsed, the runline; one slot, so nothing below moves */}
      <div class="foot">
        <p class="hint" data-hint>{LIVE_COPY.hintRest}</p>
        <span class="runline" aria-hidden="true" data-runline><i></i></span>
      </div>
      {/* under the foot: the caption, and the typed fallback's field in the same cell (it holds the taller's height) */}
      <div class="under">
        <textarea class="typein" rows="3" maxlength="1500" spellcheck="false" aria-label="Type what you would have said"></textarea>
        {hasCap && <div class="cap"><slot name="cap" /></div>}
      </div>
    </div>
    {/* THE TICKETS: beside the watch on a wide sheet, under it on a narrow one */}
    <div class="out" data-out>
      <div class="deck" data-deck></div>
      <div class="out-foot">
        <p class="out-line">{LIVE_COPY.preview}</p>
        <p class="out-line">{LIVE_COPY.privacy}</p>
      </div>
    </div>
  </div>
  <div class="sr" role="status" aria-live="polite"></div>
</section>

<style>
.intake-hero {
  --accent: #FF6B4A; --glow: #FFB454;
  --rec: #FF3B30; /* Voice Memos' red */
  --sans: 'Instrument Sans', 'Helvetica Neue', Arial, sans-serif;
  --mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
  --ink: var(--sheet-ink, #1A1917); --dim: color-mix(in oklab, var(--ink) 58%, transparent);
  --edge: color-mix(in oklab, var(--ink) 16%, transparent);
  /* the Stream's receipt green (intake_web.py), as the board's cards wear it */
  --rcpt: #79a465;
  /* the hint in the sheet's accent, mixed toward the sheet's ink only as far as 4.5:1 on the white sheet needs
     (#ff6b4a alone is 2.8:1 there; at 74 % it is 4.8:1); at night the accent stands alone (6.0:1 on #1c1c1f) */
  --hint-mix: 74%;
  position: relative;
  container-type: inline-size;
  container-name: hero;
  color: var(--ink);
  font-family: var(--sans);
}
.intake-hero.dark,
:root.dark .intake-hero, :root[data-theme="dark"] .intake-hero, :root[data-mode="dark"] .intake-hero,
:root[data-night] .intake-hero {
  --hint-mix: 100%;
}
/* the watch on the left axis (44cqw), the tickets beside it, one 6cqw gutter; one column under 820px */
.intake-hero .grid {
  display: grid;
  grid-template-columns: minmax(0, 44cqw) minmax(0, 1fr);
  column-gap: 6cqw;
  align-items: stretch;
}
@container hero (width < 820px) {
  .intake-hero .grid { grid-template-columns: minmax(0, 1fr); row-gap: 28px; }
  .intake-hero .watch-col { width: 70cqw; margin-inline: auto; }
}

/* ---- the watch ---- */
.intake-hero .watch-col { display: flex; flex-direction: column; gap: 16px; min-width: 0; }
/* the blank watch PNG (521 × 781) carries transparent margins around the band (70 left, 68 right, 67 top, 61
   bottom): the figure keeps the PNG's frame but is scaled and pulled by those ratios so the VISIBLE watch (383 × 653)
   fills the column. Percent margins resolve against the column's width, hence the /383. The figure takes no pointer
   events (its frame overhangs); the ring does */
.intake-hero .watch {
  position: relative; width: calc(100% * 521 / 383); aspect-ratio: 521 / 781;
  margin: calc(-100% * 67 / 383) 0 calc(-100% * 61 / 383) calc(-100% * 70 / 383);
  container-type: inline-size; pointer-events: none;
}
.intake-hero .watch > img { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 2; pointer-events: none; user-select: none; }
/* the screen is its own query container: the face is drawn in its cqw (100 wide, ≈ 115 tall) */
.intake-hero .screen {
  position: absolute; left: 20.35cqw; top: 40.88cqw; width: 60.65cqw; height: 69.87cqw;
  border-radius: 11.13cqw; overflow: hidden; z-index: 1; container-type: inline-size;
  background: radial-gradient(ellipse 70% 42% at 50% 46%, color-mix(in oklab, var(--rec) 10%, transparent), transparent 70%), #000;
}
.intake-hero .brand { position: absolute; left: 0; top: 7cqw; width: 100%; text-align: center; font: 500 max(9px, 4.6cqw)/1 var(--sans); letter-spacing: 0.24em; color: var(--accent); }
/* the clock and the wave stand above the ring only while a session runs */
.intake-hero .clock { position: absolute; left: 0; top: 15cqw; width: 100%; text-align: center; font: 300 max(14px, 10cqw)/1 var(--sans); font-variant-numeric: tabular-nums; color: #F2F0EA; opacity: 0; transition: opacity .3s; }
.intake-hero .wave { position: absolute; left: 8cqw; top: 29cqw; width: 84cqw; height: 16cqw; display: flex; align-items: center; justify-content: center; gap: 1.27cqw; opacity: 0; transform: scaleY(var(--amp, 0.35)); transition: opacity .3s, transform .35s ease; }
.intake-hero .wave i { display: block; width: 1.9cqw; border-radius: 0.95cqw; background: color-mix(in oklab, var(--accent) var(--m), var(--glow)); animation: ih-bar 2s ease-in-out infinite; }
/* THE RING (Voice Memos' record): a thin light ring, a gap, the red disc. At rest it is the face (56 % of the
   screen's width, centred below INTAKE); while a session runs it steps down and smaller under the clock and the
   wave, and the disc becomes the stop square. Its red light breathes at rest on the touch signal's keyframe
   (touch-breathe, an EXACT COPY of AudioDexDoor's: change both or neither): full and still under the pointer,
   still at 0.75 under reduced motion */
.intake-hero .rec {
  position: absolute; left: 22cqw; top: 36cqw; width: 56cqw; height: 56cqw;
  box-sizing: border-box; margin: 0; padding: 0; border: 0; border-radius: 50%;
  background: transparent; box-shadow: inset 0 0 0 0.9cqw #E9E7E2;
  cursor: pointer; pointer-events: auto; z-index: 3;
  transition: left .36s cubic-bezier(.3, .7, .2, 1), top .36s cubic-bezier(.3, .7, .2, 1), width .36s cubic-bezier(.3, .7, .2, 1), height .36s cubic-bezier(.3, .7, .2, 1), opacity .25s;
}
.intake-hero .rec::before {
  content: ""; position: absolute; inset: -2cqw; border-radius: 50%; pointer-events: none;
  box-shadow: 0 0 7cqw color-mix(in oklab, var(--rec) 55%, transparent);
  animation: touch-breathe 2s ease-in-out infinite; transition: opacity .3s;
}
.intake-hero .rec:hover::before { animation: none; opacity: 1; }
.intake-hero .rec:focus-visible { outline: 2px solid #F2F0EA; outline-offset: 3px; }
.intake-hero .rec-mark {
  position: absolute; inset: 11%; border-radius: 50%; background: var(--rec);
  transition: inset .3s cubic-bezier(.3, .7, .2, 1), border-radius .3s cubic-bezier(.3, .7, .2, 1), transform .12s;
}
.intake-hero .rec:active .rec-mark { transform: scale(0.94); }
.intake-hero:is([data-state="asking"], [data-state="listening"], [data-state="typing"]) .rec { left: 33cqw; top: 50cqw; width: 34cqw; height: 34cqw; }
.intake-hero:is([data-state="asking"], [data-state="listening"], [data-state="typing"]) .rec::before { animation: none; opacity: 0; }
.intake-hero:is([data-state="asking"], [data-state="listening"], [data-state="typing"]) .rec-mark { inset: 31%; border-radius: 14%; }
.intake-hero:is([data-state="asking"], [data-state="listening"], [data-state="typing"]) :is(.clock, .wave) { opacity: 1; }
.intake-hero[data-state="asking"] .rec-mark { background: #5A5955; }
.intake-hero:is([data-state="asking"], [data-state="typing"]) .wave { transform: scaleY(0.25); }
/* the heard words at the face's foot, the newest line kept */
.intake-hero .said {
  position: absolute; left: 9cqw; right: 9cqw; top: 88cqw; bottom: 6cqw; margin: 0;
  display: flex; flex-direction: column; justify-content: flex-end; overflow: hidden;
  font: 400 max(10px, 4.4cqw)/1.3 var(--sans); text-align: center; color: #C4C0B8;
  -webkit-mask-image: linear-gradient(to bottom, transparent, #000 45%); mask-image: linear-gradient(to bottom, transparent, #000 45%);
  opacity: 0; transition: opacity .3s;
}
.intake-hero .said .interim { color: #8C8A84; }
.intake-hero:is([data-state="listening"], [data-state="typing"]) .said { opacity: 1; }
.intake-hero[data-state="typing"] .said { -webkit-mask-image: none; mask-image: none; justify-content: center; color: #8C8A84; }
/* the face's word: "saved" (the check, green), "nothing to file" (no check) */
.intake-hero .note { position: absolute; inset: 0; opacity: 0; transition: opacity .25s; }
.intake-hero .check {
  position: absolute; left: 37.5cqw; top: 30cqw; width: 25cqw; height: 25cqw; box-sizing: border-box; border-radius: 50%;
  border: 0.95cqw solid color-mix(in oklab, #34C759 72%, transparent); color: #34C759;
  display: flex; align-items: center; justify-content: center;
}
.intake-hero .check svg { width: 11cqw; height: 11cqw; }
.intake-hero .note-w { position: absolute; left: 0; top: 64cqw; width: 100%; text-align: center; font: 400 max(13px, 8.6cqw)/1.1 var(--sans); color: #F2F0EA; }
.intake-hero:is([data-state="saved"], [data-state="nothing"]) .note { opacity: 1; }
.intake-hero:is([data-state="saved"], [data-state="nothing"]) .rec { opacity: 0; pointer-events: none; }
.intake-hero[data-state="nothing"] .check { display: none; }
.intake-hero[data-state="nothing"] .note-w { top: 50cqw; color: #C4C0B8; }

/* ---- the foot: the hint, or the runline while the words are parsed (one slot) ---- */
/* reserved to three lines of the hint: the typed, declined and privacy lines run that long beside a desk's narrow
   watch, and a shorter rest hint must not let them push the fold (a typed run moved it 16px) */
.intake-hero .foot { display: grid; min-height: calc(0.6875rem * 1.5 * 3); align-items: start; justify-items: center; }
.intake-hero .foot > * { grid-area: 1 / 1; }
.intake-hero .hint {
  margin: 0; max-width: 36ch; text-align: center; text-wrap: balance;
  font: 600 0.6875rem/1.5 var(--mono); letter-spacing: 0.12em;
  color: color-mix(in oklab, var(--sheet-acc, var(--accent)) var(--hint-mix), var(--sheet-ink, var(--ink)));
  transition: opacity .3s, color 560ms ease;
}
.intake-hero[data-running] .hint { opacity: 0; }
/* "YOU'RE WATCHING" (2026-10-19, Jon: "a super minimalistic progress bar … a casual visual communication that hey,
   you're witnessing something … you don't have to click anything"): one hairline in the foot's slot from the press
   until the run lands, so nothing below moves; the hint's own colour fills it left to right, linearly, over the run's
   planned length (the script's own numbers). In 200 on the press, out 400 at the landing, the Replay on its own delay
   after. Not a control: aria-hidden, no pointer, no label. Reduced motion: none (the run lands at once). EXACT COPY in
   IntakeHero.astro and AudioDexDoor.astro: change both or neither. (The watch runs it from the stop until the parse
   answers: an eased fill toward 90 %, full when the answer lands) */
.runline {
  grid-area: 1 / 1; align-self: center; width: 96px; height: 1.5px;
  background: color-mix(in oklab, var(--sheet-ink) 14%, transparent);
  opacity: 0; pointer-events: none; transition: opacity 400ms ease;
}
.runline > i {
  display: block; height: 100%; transform: scaleX(0); transform-origin: left;
  background: color-mix(in oklab, var(--sheet-acc) var(--hint-mix), var(--sheet-ink));
}
[data-running] .runline { opacity: 1; transition-duration: 200ms; }
@media (max-width: 899px) { .runline { width: 72px; } }
@media (prefers-reduced-motion: reduce) { .runline { display: none; } }

/* ---- under the foot: the caption and the typed field share one cell (it holds the taller's height, so the field's
   arrival moves nothing) ---- */
.intake-hero .under { display: grid; }
.intake-hero .under > * { grid-area: 1 / 1; min-width: 0; }
.intake-hero .typein {
  visibility: hidden; width: 100%; box-sizing: border-box; margin: 0; padding: 8px 10px; resize: none;
  border: 1px solid var(--edge); border-radius: 10px; background: transparent; color: var(--ink);
  font: 400 13px/1.55 var(--mono); outline: none;
}
.intake-hero .typein:focus { border-color: var(--accent); }
.intake-hero[data-state="typing"] .typein { visibility: visible; }
.intake-hero[data-state="typing"] .cap { visibility: hidden; }

/* ---- THE TICKETS: beside the watch (a wide sheet: the column is the watch's height, the cards centred in it and
   capped to what fits, the rest counted), under it on a narrow sheet ---- */
.intake-hero .out { display: flex; flex-direction: column; justify-content: center; gap: 14px; min-width: 0; overflow: hidden; }
.intake-hero .deck { display: flex; flex-direction: column; gap: 10px; }
.intake-hero .out-foot { display: none; flex-direction: column; gap: 6px; }
.intake-hero[data-cards] .out-foot { display: flex; }
.intake-hero .out-line { margin: 0; max-width: 46ch; font: 500 0.6875rem/1.5 var(--mono); letter-spacing: 0.04em; color: var(--dim); }
.intake-hero .out-line:first-child { color: var(--ink); }
@container hero (width < 820px) {
  .intake-hero .out { overflow: visible; }
}
/* a card, as the Stream draws it (intake_web.py, the board's twin): the source spine, age · the check or the kind's
   chip · the X, the title, its lines, the two tiles quiet */
.intake-hero .card {
  width: min(100%, 360px); box-sizing: border-box; padding: 12px 14px;
  border: 1px solid var(--edge); border-left: 3px solid var(--src, #79a9d6); border-radius: 12px;
  display: flex; flex-direction: column; gap: 6px;
  animation: ih-slide .5s cubic-bezier(.2, .8, .2, 1) both; animation-delay: calc(var(--k, 0) * 120ms);
}
.intake-hero .card[hidden] { display: none; }
.intake-hero .c-head { display: flex; align-items: center; gap: 8px; font: 400 11.5px/1 var(--sans); color: var(--dim); }
.intake-hero .c-check { display: inline-flex; width: 14px; height: 14px; color: var(--rcpt); }
.intake-hero .c-check svg { width: 100%; height: 100%; }
.intake-hero .c-chip {
  padding: 2px 7px; border: 1px solid color-mix(in oklab, var(--chip, #8fbf6f) 55%, transparent); border-radius: 5px;
  font: 600 10px/1.2 var(--sans); letter-spacing: 0.07em; text-transform: uppercase;
  color: color-mix(in oklab, var(--chip, #8fbf6f) 62%, var(--ink));
}
:root[data-night] .intake-hero .c-chip { color: var(--chip, #8fbf6f); }
.intake-hero .c-chip.lp { --chip: #8C8A84; border-style: dashed; }
.intake-hero .c-x { width: 14px; height: 14px; margin-left: auto; }
.intake-hero .c-title { margin: 2px 0 0; font: 650 15.5px/1.3 var(--sans); color: var(--ink); text-wrap: pretty; }
.intake-hero .c-line { margin: 0; font: 400 12.5px/1.4 var(--sans); color: var(--dim); }
.intake-hero .c-tiles { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; margin-top: 6px; }
.intake-hero .c-tile { display: flex; align-items: center; justify-content: center; gap: 6px; height: 34px; border: 1px solid var(--edge); border-radius: 9px; font: 500 13px/1 var(--sans); color: var(--dim); }
.intake-hero .c-tile svg { width: 12px; height: 12px; }
.intake-hero .more { margin: 0; font: 500 0.6875rem/1.5 var(--mono); letter-spacing: 0.04em; color: var(--dim); }
.intake-hero .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

@keyframes ih-bar { 0%, 100% { transform: scaleY(.5); } 50% { transform: scaleY(1); } }
/* the cards slide out of the watch's side (a wide sheet) or drop under it (a narrow one) */
@keyframes ih-slide { 0% { opacity: 0; transform: translateX(-18px); } 100% { opacity: 1; transform: none; } }
@keyframes ih-drop { 0% { opacity: 0; transform: translateY(-12px); } 100% { opacity: 1; transform: none; } }
@container hero (width < 820px) {
  .intake-hero .card { animation-name: ih-drop; }
}
/* the touch signal's breath — an EXACT COPY of the phone's (AudioDexDoor.astro): change both or neither */
@keyframes touch-breathe { 0%, 100% { opacity: 0.45; } 50% { opacity: 1; } }
@media (prefers-reduced-motion: reduce) {
  .intake-hero .wave i { animation: none; }
  .intake-hero .rec::before { animation: none; opacity: 0.75; }
  .intake-hero .card { animation: none; }
  .intake-hero .rec, .intake-hero .rec-mark, .intake-hero .note, .intake-hero .clock, .intake-hero .wave, .intake-hero .said { transition: none; }
}
</style>

<script>
import { localParse } from '../lib/intake-local.ts';
// THE STATES (2026-10-19, late): rest (the ring) → asking (the browser asks for the microphone) → listening (the stop
// square, the clock counting up, the wave, the words at the foot) | typing (no speech service, or declined: "type it",
// the field under the watch) → saved (the check; the runline while the words are parsed) → the cards slide out, and
// SAVED_MS later the face is the ring again | nothing (no ticket: "nothing to file" for NOTE_MS, no card). An empty
// session goes back to rest with "nothing heard". The next press clears the cards.
const SAVED_MS = 2000, NOTE_MS = 2000, MAX_S = 90, MAX_CHARS = 1500, SETTLE_MS = 1500;
const KIND = { event: ['calendar', '#d9a845', 'Calendar'], reminder: ['reminder', '#d9a845', 'Reminders'], task: ['task', '#e0a35b', ''], idea: ['idea', '#8fbf6f', ''] };
const SRC = ['#79a9d6', '#bc91d8', '#7fbb93', '#d4a667', '#d78394'];
const CHECK = '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 8.5l3.5 3.5 7.5-8.5"/></svg>';
const X = '<svg class="c-x" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>';
const TILES = '<div class="c-tiles" aria-hidden="true"><span class="c-tile">Claude <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.2 6.6L21 11l-6.8 2.4L12 20l-2.2-6.6L3 11l6.8-2.4z"/></svg></span><span class="c-tile">Zzzz</span></div>';
const esc = (x) => String(x).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
const fmt = (sec) => { const t = Math.max(0, Math.floor(sec)); return Math.floor(t / 60) + ':' + String(t % 60).padStart(2, '0'); };

document.querySelectorAll('[data-intake-hero]').forEach((hero) => {
  const LIVE = JSON.parse(hero.querySelector('script[data-intake-live]').textContent);
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const SR = window.SpeechRecognition || window.webkitSpeechRecognition || null;
  const cid = Array.from(hero.attributes).map((a) => a.name).find((n) => n.startsWith('data-astro-cid-'));
  const scope = (root) => { if (!cid) return; root.querySelectorAll('*').forEach((el) => el.setAttribute(cid, '')); };
  const recBtn = hero.querySelector('[data-rec]');
  const clockEl = hero.querySelector('[data-clock]');
  const noteEl = hero.querySelector('[data-note]');
  const typed = hero.querySelector('.typed');
  const interimEl = hero.querySelector('.interim');
  const hintEl = hero.querySelector('[data-hint]');
  const typein = hero.querySelector('.typein');
  const out = hero.querySelector('[data-out]');
  const deck = hero.querySelector('[data-deck]');
  const status = hero.querySelector('.sr');
  const runFill = hero.querySelector('[data-runline] > i');
  const restHint = hintEl.textContent;

  let mode = 'rest';
  let rec = null, prior = '', session = '', interim = '', t0 = 0, tick = 0, settleT = 0, backT = 0, stopping = false, lastLen = 0, lastAt = 0, forceDown = false;
  const set = (m) => { mode = m; hero.dataset.state = m === 'transcribing' || m === 'parsing' ? 'saved' : m; };
  const hint = (t) => { hintEl.textContent = t; };
  const say = (t) => { status.textContent = t; };
  const text = () => (prior + ' ' + session + ' ' + interim).replace(/\s+/g, ' ').trim().slice(0, MAX_CHARS);
  const amp = () => { hero.style.setProperty('--amp', mode === 'listening' && performance.now() - lastAt < 900 ? '1' : '0.35'); };
  const paint = () => {
    const f = (prior + ' ' + session).replace(/\s+/g, ' ').trim();
    typed.textContent = f + (f && interim ? ' ' : '');
    interimEl.textContent = interim;
    const len = text().length;
    if (len !== lastLen) { lastAt = performance.now(); lastLen = len; }
    amp();
  };
  // the runline: from the stop until the parse answers (the wait is unknown: it eases toward 90 %, full on the answer)
  const waitLine = () => {
    if (reduce || !runFill) return;
    hero.setAttribute('data-running', '');
    runFill.style.transition = 'none'; runFill.style.transform = 'scaleX(0)';
    void runFill.offsetWidth;
    runFill.style.transition = 'transform 6000ms cubic-bezier(.1, .6, .3, 1)'; runFill.style.transform = 'scaleX(0.9)';
  };
  const endLine = () => {
    if (!runFill) return;
    runFill.style.transition = 'transform 200ms ease-out'; runFill.style.transform = 'scaleX(1)';
    hero.removeAttribute('data-running');
  };
  const clearCards = () => { deck.innerHTML = ''; hero.removeAttribute('data-cards'); };
  const stopAll = () => {
    clearInterval(tick); clearTimeout(settleT); clearTimeout(backT);
    if (rec) { try { rec.onend = null; rec.onresult = null; rec.onerror = null; rec.abort(); } catch (_) { /* */ } rec = null; }
    stopping = false;
  };
  const toRest = (h) => {
    stopAll(); endLine();
    set('rest'); hint(h || restHint);
    hero.style.removeProperty('--amp');
    typed.textContent = ''; interimEl.textContent = ''; typein.value = '';
  };

  const start = () => {   // the press is the one opener: never on load, scroll or hover
    stopAll(); clearCards(); endLine();
    prior = session = interim = ''; lastLen = 0; lastAt = 0;
    typed.textContent = ''; interimEl.textContent = ''; clockEl.textContent = '0:00';
    if (!SR) { toTyped(LIVE.noSpeech); return; }
    set('asking'); hint(LIVE.asking);
    rec = new SR();
    rec.continuous = true; rec.interimResults = true; rec.maxAlternatives = 1;
    rec.lang = document.documentElement.lang || navigator.language || 'en-US';
    rec.onstart = () => { if (mode === 'asking') listening(); };
    rec.onaudiostart = rec.onstart;
    rec.onresult = (e) => {
      let f = '', i = '';
      for (let k = 0; k < e.results.length; k++) { const r = e.results[k]; const w = r[0] ? r[0].transcript : ''; if (r.isFinal) f += w + ' '; else i += w; }
      session = f.trim(); interim = i.trim();
      if (mode === 'asking') listening();
      paint();
      if (text().length >= MAX_CHARS) finish();
    };
    rec.onerror = (e) => {
      const err = e && e.error;
      if (err === 'not-allowed' || err === 'service-not-allowed' || err === 'audio-capture') { toTyped(LIVE.denied); return; }
      if (err === 'no-speech' || err === 'aborted') return;   // the service's silence timer: onend restarts it below
      if (!text()) toTyped(LIVE.noSpeech);
    };
    rec.onend = () => {
      if (stopping) { settle(); return; }
      if (mode === 'listening' || mode === 'asking') {   // a session ends on silence: carry its words, keep listening
        prior = (prior + ' ' + session).trim(); session = ''; interim = '';
        try { rec.start(); } catch (_) { settleT = setTimeout(() => { try { rec && rec.start(); } catch (__) { /* */ } }, 300); }
      }
    };
    try { rec.start(); } catch (_) { toTyped(LIVE.noSpeech); }
  };
  const listening = () => {
    set('listening'); hint(LIVE.privacy);
    t0 = performance.now();
    clearInterval(tick);
    tick = setInterval(() => { const s = (performance.now() - t0) / 1000; clockEl.textContent = fmt(s); amp(); if (s >= MAX_S) finish(); }, 200);
    say('Listening.');
  };
  const toTyped = (why) => {
    if (rec) { try { rec.onend = null; rec.abort(); } catch (_) { /* */ } rec = null; }
    clearInterval(tick);
    set('typing'); hint(why);
    typed.textContent = LIVE.typeIt; interimEl.textContent = '';
    t0 = performance.now(); clockEl.textContent = '0:00';
    tick = setInterval(() => { clockEl.textContent = fmt((performance.now() - t0) / 1000); }, 500);
    typein.value = '';
    typein.focus({ preventScroll: true });
  };
  const finish = () => {
    if (mode !== 'listening' && mode !== 'asking' && mode !== 'typing') return;
    clearInterval(tick);
    if (mode === 'typing') { prior = typein.value.trim(); session = interim = ''; typein.blur(); typein.value = ''; }
    stopping = true;
    set('transcribing'); noteEl.textContent = LIVE.saved;
    waitLine();
    say(LIVE.saved + '.');
    if (rec) { try { rec.stop(); } catch (_) { settle(); return; } settleT = setTimeout(settle, SETTLE_MS); }   // the last finals land in onend
    else settle();
  };
  const settle = () => {
    if (mode !== 'transcribing') return;
    clearTimeout(settleT);
    if (rec) { try { rec.onend = null; rec.onresult = null; rec.onerror = null; } catch (_) { /* */ } rec = null; }
    prior = text(); session = interim = '';
    if (!prior) { toRest(LIVE.empty); say(LIVE.empty); return; }
    parse(prior);
  };
  const parse = async (src) => {
    set('parsing');
    let result = null;
    const ac = new AbortController();
    const tt = setTimeout(() => ac.abort(), 10000);
    try {
      if (forceDown) throw new Error('down');
      const r = await fetch('/api/intake', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ text: src }), signal: ac.signal });
      const j = await r.json();
      if (r.ok && j && Array.isArray(j.tickets) && Array.isArray(j.verdicts) && !j.fallback) result = j;
    } catch (_) { /* the local parse */ }
    clearTimeout(tt);
    if (mode !== 'parsing') return;   // left meanwhile
    land(result || localParse(src));
  };
  // a ticket as the Stream draws it: an executed one is a receipt (the check, where it went and when), the rest wait
  // on a person (the kind's chip, its points); a local parse wears its chip
  const card = (t, k, local) => {
    const [label, chip, dest] = KIND[t.kind] || [t.kind, '#9ca294', ''];
    const head = t.execute
      ? '<span class="c-check">' + CHECK + '</span>'
      : '<span class="c-chip" style="--chip:' + chip + '">' + esc(label) + '</span>';
    const lp = local ? '<span class="c-chip lp">' + esc(LIVE.local) + '</span>' : '';
    const lines = t.execute
      ? '<p class="c-line">' + esc([dest || label, t.when].filter(Boolean).join(' · ')) + '</p>'
      : (t.items || []).filter((i) => i.trim().toLowerCase() !== String(t.title).trim().toLowerCase()).slice(0, 2).map((i) => '<p class="c-line">' + esc(i) + '</p>').join('');   // a point that only repeats the title is dropped
    return '<article class="card" style="--k:' + k + ';--src:' + SRC[k % SRC.length] + '"><div class="c-head"><span>now</span>' + head + lp + X + '</div><h4 class="c-title">' + esc(t.title) + '</h4>' + lines + TILES + '</article>';
  };
  const land = (r) => {
    endLine();
    const n = r.tickets.length;
    if (!n) {   // the third fate: nothing actionable
      set('nothing'); noteEl.textContent = LIVE.nothing; say(LIVE.nothing + '.');
      backT = setTimeout(() => toRest(), NOTE_MS);
      return;
    }
    const local = r.source === 'local';
    deck.innerHTML = r.tickets.map((t, k) => card(t, k, local)).join('');
    scope(deck);
    hero.setAttribute('data-cards', '');
    fit();
    say((n === 1 ? '1 ticket' : n + ' tickets') + '. ' + LIVE.preview);
    backT = setTimeout(() => toRest(), SAVED_MS);
  };
  // beside the watch the column is the watch's height: the cards that fit stand, the rest are counted
  const fit = () => {
    const cards = Array.from(deck.querySelectorAll('.card'));
    const old = deck.querySelector('.more'); if (old) old.remove();
    cards.forEach((c) => { c.hidden = false; });
    if (getComputedStyle(out).overflow !== 'hidden') return;
    let hidden = 0;
    for (let i = cards.length - 1; i > 0 && out.scrollHeight > out.clientHeight + 1; i--) { cards[i].hidden = true; hidden++; }
    if (hidden) { const p = document.createElement('p'); p.className = 'more'; p.textContent = '+ ' + hidden + ' more'; deck.appendChild(p); scope(deck); }
  };
  new ResizeObserver(() => { if (hero.hasAttribute('data-cards')) fit(); }).observe(out);

  recBtn.addEventListener('click', () => {
    if (mode === 'rest' || mode === 'nothing') start();
    else if (mode === 'listening' || mode === 'asking' || mode === 'typing') finish();
  });
  typein.addEventListener('keydown', (e) => { if ((e.metaKey || e.ctrlKey) && e.key === 'Enter') { e.preventDefault(); finish(); } });
  hero.addEventListener('hero:reset', () => { toRest(); clearCards(); });

  // ── the dev switch (?state=…; ships disabled: this block is dropped from the production bundle) ──
  if (import.meta.env.DEV) {
    const SAMPLE = "I need to call the plumber about the kitchen tap, it's dripping again. Remind me Friday morning to pick up the dry cleaning. And what if we painted the hallway, like a warm grey, I keep thinking about it.";
    const asIf = (t) => { stopAll(); clearCards(); set('listening'); prior = t; session = interim = ''; paint(); t0 = performance.now() - 12000; clockEl.textContent = '0:12'; };
    const show = (name) => {
      forceDown = false;
      switch (name) {
        case 'asking': stopAll(); clearCards(); set('asking'); hint(LIVE.asking); break;
        case 'denied': stopAll(); clearCards(); toTyped(LIVE.denied); break;
        case 'unsupported': case 'typed': stopAll(); clearCards(); toTyped(LIVE.noSpeech); break;
        case 'listening': asIf("I need to call the plumber about the kitchen tap, it's dripping"); interim = 'again'; lastAt = performance.now() + 1e9; paint(); break;
        case 'parsing': asIf(SAMPLE); set('parsing'); waitLine(); break;
        case 'result': asIf(SAMPLE); finish(); break;
        case 'local': case 'down': forceDown = true; asIf(SAMPLE); finish(); break;
        case 'nothing': asIf('this is just a test, ignore this'); finish(); break;
        case 'empty': asIf(''); finish(); break;
        default: toRest(); clearCards(); break;
      }
    };
    window.__intakeLive = { show, run: (t) => { asIf(t); finish(); }, down: (v) => { forceDown = !!v; }, mode: () => mode, text };
    const want = new URLSearchParams(location.search).get('state');
    if (want) setTimeout(() => show(want), 400);
  }
});
</script>
