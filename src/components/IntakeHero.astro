---
// src/components/IntakeHero.astro
// The Intake case-study hero: watch at rest mid-recording; tapping stop plays the real run
// (saved face → transcript prints verbatim → verdict → ticket stubs → cards drop into the deck).
//
// Usage:   <IntakeHero />            (data from src/data/intake-run.json; follows the site theme)
//          <IntakeHero step={20} />  (ms per transcript word; default 15)
//          <IntakeHero theme="dark" /> (force a mode; default 'auto' = html.dark / [data-theme] / prefers-color-scheme)
// Needs:   public/intake/watch-blank.png
//          fonts loaded once in the base layout:
//          <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Outfit:wght@300;400;500&display=swap" rel="stylesheet">
import run from '../data/intake-run.json';

interface Props {
  step?: number;
  theme?: 'light' | 'dark' | 'auto';
  class?: string;
}
const { step = 15, theme = 'auto', class: cls = '' } = Astro.props;
const runJson = JSON.stringify(run);
// the host may seat the room's words in the module's own columns (2026-09-24):
// a `head` slot above the watch (left axis), a `cap` slot at the run's foot
const hasHead = Astro.slots.has('head');
const hasCap = Astro.slots.has('cap');
---
<section class={`intake-hero${theme !== 'auto' ? ' ' + theme : ''}${cls ? ' ' + cls : ''}${hasHead ? ' has-head' : ''}`} data-intake-hero data-step={step} aria-label="Intake: one voice memo becoming tickets">
  <script type="application/json" data-intake-run set:html={runJson}></script>
  <div class="grid">
    {hasHead && <div class="hook"><slot name="head" /></div>}
    <div class="watch-col">
      <figure class="watch" aria-hidden="true">
        <div class="screen">
          <div class="face face-rec">
            <div class="brand">INTAKE</div>
            <div class="wave">
          <i style="height:2.53cqw;--m:16%;animation-duration:1.98s;animation-delay:0.00s"></i>
          <i style="height:4.43cqw;--m:22%;animation-duration:2.30s;animation-delay:-0.40s"></i>
          <i style="height:6.96cqw;--m:28%;animation-duration:2.63s;animation-delay:-0.79s"></i>
          <i style="height:11.39cqw;--m:35%;animation-duration:2.14s;animation-delay:-1.19s"></i>
          <i style="height:16.46cqw;--m:42%;animation-duration:2.47s;animation-delay:-1.58s"></i>
          <i style="height:22.15cqw;--m:48%;animation-duration:1.98s;animation-delay:-1.98s"></i>
          <i style="height:27.85cqw;--m:54%;animation-duration:2.30s;animation-delay:-0.20s"></i>
          <i style="height:32.91cqw;--m:61%;animation-duration:2.63s;animation-delay:-0.59s"></i>
          <i style="height:30.38cqw;--m:68%;animation-duration:2.14s;animation-delay:-0.99s"></i>
          <i style="height:22.78cqw;--m:74%;animation-duration:2.47s;animation-delay:-1.39s"></i>
          <i style="height:18.35cqw;--m:80%;animation-duration:1.98s;animation-delay:-1.78s"></i>
          <i style="height:25.32cqw;--m:87%;animation-duration:2.30s;animation-delay:0.00s"></i>
          <i style="height:35.44cqw;--m:94%;animation-duration:2.63s;animation-delay:-0.40s"></i>
          <i style="height:29.11cqw;--m:100%;animation-duration:2.14s;animation-delay:-0.79s"></i>
          <i style="height:20.89cqw;--m:94%;animation-duration:2.47s;animation-delay:-1.19s"></i>
          <i style="height:13.92cqw;--m:87%;animation-duration:1.98s;animation-delay:-1.58s"></i>
          <i style="height:18.99cqw;--m:80%;animation-duration:2.30s;animation-delay:-1.98s"></i>
          <i style="height:26.58cqw;--m:74%;animation-duration:2.63s;animation-delay:-0.20s"></i>
          <i style="height:31.65cqw;--m:68%;animation-duration:2.14s;animation-delay:-0.59s"></i>
          <i style="height:24.05cqw;--m:61%;animation-duration:2.47s;animation-delay:-0.99s"></i>
          <i style="height:15.82cqw;--m:54%;animation-duration:1.98s;animation-delay:-1.39s"></i>
          <i style="height:10.76cqw;--m:48%;animation-duration:2.30s;animation-delay:-1.78s"></i>
          <i style="height:7.59cqw;--m:42%;animation-duration:2.63s;animation-delay:0.00s"></i>
          <i style="height:5.06cqw;--m:35%;animation-duration:2.14s;animation-delay:-0.40s"></i>
          <i style="height:3.16cqw;--m:28%;animation-duration:2.47s;animation-delay:-0.79s"></i>
          <i style="height:2.53cqw;--m:22%;animation-duration:1.98s;animation-delay:-1.19s"></i>
          <i style="height:1.90cqw;--m:16%;animation-duration:2.30s;animation-delay:-1.58s"></i>
            </div>
            <div class="time">{run.memo.duration}</div>
            <button type="button" class="stop" aria-label="Stop recording and run the pipeline"><span></span></button>
          </div>
          <div class="face face-saved">
            <div class="brand">INTAKE</div>
            <div class="flat"></div>
            <div class="check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg></div>
            <div class="saved">Saved</div>
            <div class="meta">{run.memo.id} · {run.memo.duration}</div>
          </div>
          <button type="button" class="replay" aria-label="Replay the run">
            <svg viewBox="0 0 20 20" class="ico" aria-hidden="true"><path d="M4 10a6 6 0 1 0 1.8-4.3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M4 3v3.5h3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Replay
          </button>
        </div>
        <img src="/intake/watch-blank.png" alt="" width="521" height="781" loading="lazy" decoding="async" />
      </figure>
      <div class="hint">tap stop</div>
    </div>
    <div class="run">
      <div class="row">
        <i class="node node-transcript"></i>
        <div class="body">
          <div class="label">transcript</div>
          <div class="stream"><div><span class="typed"></span><span class="caret"></span></div></div>
        </div>
      </div>
      <div class="row">
        <i class="node node-verdict"></i>
        <div class="body">
          <div class="label">verdict</div>
          <div class="verdict">
            {['execute', 'surface', 'store'].map((v) => (
              <span data-on={run.verdict === v ? '' : undefined}>{v}</span>
            ))}
          </div>
        </div>
      </div>
      <div class="row">
        <i class="node node-ticket"></i>
        <div class="body">
          <div class="label">ticket</div>
          <div class="tickets">
            {run.tickets.map((t) => (
              <div class="stub"><span class="p">{'{ '}</span><span class="k">kind</span><span class="p">: </span><span class="v">"{t.kind}"</span><span class="p">, </span><span class="k">items</span><span class="p">: </span><span class="v">{t.items.length}</span><span class="p">, </span><span class="k">title</span><span class="p">: </span><span class="v">"{t.title}"</span><span class="p">{' }'}</span></div>
            ))}
            {run.stored && (
              <div class="stub stored"><span class="p">{'{ '}</span><span class="k">store</span><span class="p">: </span><span class="v">"{run.stored}"</span><span class="p">{' }'}</span></div>
            )}
          </div>
        </div>
      </div>
      <div class="row">
        <i class="node node-deck"></i>
        <div class="body">
          <div class="label">deck</div>
          <div class="deck">
            {run.tickets.map((t) => (
              <article class="card">
                <div class="card-top">
                  <span class="when">{run.when ?? 'today'}</span>
                  <span class="chip">{t.kind.toUpperCase()}</span>
                  <span class="card-x" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M3 3l8 8M11 3l-8 8"></path></svg></span>
                </div>
                <h3 class="card-title">{t.title}</h3>
                <ul class="card-items">{t.items.map((it) => <li>{it}</li>)}</ul>
                <div class="card-actions">
                  <button type="button" class="act primary">Claude <svg width="11" height="11" viewBox="0 0 12 12" aria-hidden="true"><path d="M6 0.5 L7.3 4.7 L11.5 6 L7.3 7.3 L6 11.5 L4.7 7.3 L0.5 6 L4.7 4.7 Z" fill="currentColor"></path></svg></button>
                  <button type="button" class="act">Zzzz</button>
                  <button type="button" class="act">Add to…</button>
                </div>
                <div class="card-src">source memo · {run.memo.id}</div>
              </article>
            ))}
          </div>
        </div>
      </div>
      {hasCap && <div class="cap"><slot name="cap" /></div>}
    </div>
  </div>
    <div class="fly"></div>
    <div class="sr" role="status" aria-live="polite"></div>
</section>

<style>
.intake-hero {
  /* shared */
  --accent: #FF6B4A; --glow: #FFB454; --purple: #B4A0F5;
  /* the stop button's ring: intense bright blue to purple (Jon, 2026-09-22) */
  --ring-a: #47B6FF; --ring-b: #8A5CF6;
  --sans: 'Instrument Sans', 'Helvetica Neue', Arial, sans-serif;
  --mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
  /* light mode (default) */
  --ink: #1A1917; --ink-2: #2A2926; --grey: #6B6963; --dim: #9A9891; --line: #D2D0CA;
  --amber: #FF9F1C; --pink: #F0568F; --rail: #8B72E8;
  --card: #FFFFFF; --card-line: #E1DFD9; --btn: #F3F1EC; --btn-line: #E1DFD9;
  --glow-card: rgba(139, 114, 232, 0.28);
}
.intake-hero.dark,
:root.dark .intake-hero, :root[data-theme="dark"] .intake-hero, :root[data-mode="dark"] .intake-hero,
:root[data-night] .intake-hero {
  --ink: #F2F0EA; --ink-2: #E4E2DC; --grey: #8C8A84; --dim: #5A5955; --line: #26262A;
  --amber: #FF9F1C; --pink: #F0568F; --rail: #B4A0F5;
  --card: #1C1C1F; --card-line: #2A2A2E; --btn: #232326; --btn-line: #2E2E33;
  --glow-card: rgba(180, 160, 245, 0.35);
}
/* (the OS prefers-color-scheme rule is dropped on uxjon.com: the site is day
   until its own switch, html[data-night], which is wired above) */
.intake-hero {
  position: relative;
  /* the module is its own query container: the object is sized in cqw of
     the module's width, never in fixed pixels (presentation pass, 2026-09-21) */
  container-type: inline-size;
  container-name: hero;
  padding: 0;
  background: transparent;
  color: var(--ink);
  font-family: 'Outfit', 'Avenir Next', 'Segoe UI', sans-serif;
  overflow: hidden;
}
/* the same grid as the Archive: the object column (44cqw) on the left axis,
   the run on the right axis, one 6cqw gutter between; 48px rows when stacked */
.intake-hero .grid {
  display: grid;
  grid-template-columns: minmax(0, 44cqw) minmax(0, 1fr);
  /* the gutter less half a node: the node's CENTRE lands on 50cqw, the
     module's centre line, where the Archive's dots land too (Jon, 2026-09-22) */
  column-gap: calc(6cqw - 5px);
  row-gap: 48px;
  align-items: start;
}
/* the room's words seated in the module (Jon's mockup, 2026-09-24): the hook
   above the watch on the left axis, the run beside BOTH from the top — its
   first node level with the hook's first line — and the caption at the run's
   foot. One arrangement with the Archive. */
.intake-hero.has-head .grid {
  grid-template-rows: auto 1fr;
  grid-template-areas: 'hook run' 'watch run';
  row-gap: 44px; /* the title → the watch (Jon, 2026-09-24: more air) */
}
.intake-hero .hook { grid-area: hook; min-width: 0; }
.intake-hero.has-head .watch-col { grid-area: watch; }
.intake-hero.has-head .run { grid-area: run; }
.intake-hero .cap { min-width: 0; margin-top: 48px; } /* the deck's shadow → the caption: 72px in all (Jon, 2026-09-24) */
@container hero (width < 820px) {
  .intake-hero.has-head .grid { grid-template-rows: auto; grid-template-areas: 'hook' 'watch' 'run'; row-gap: 48px; }
  .intake-hero .hook { margin-bottom: -4px; }
}
/* one column under 820px of module width: the watch fills ~70% of it, centred */
@container hero (width < 820px) {
  .intake-hero .grid { grid-template-columns: minmax(0, 1fr); }
  .intake-hero .watch-col { width: 70cqw; margin-inline: auto; }
}

/* ---- watch ---- */
.intake-hero .watch-col { display: flex; flex-direction: column; gap: 16px; }
/* the blank watch PNG (521 × 781) carries transparent margins around the band —
   70 left, 68 right, 67 top, 61 bottom — so the VISIBLE watch is 383 × 653. The
   figure keeps the PNG's frame (the screen is placed in cqw of it) but is scaled
   and pulled by those ratios so the visible watch fills the column and sits on
   the module's rhythm and left axis exactly as the phone does. Percent margins
   resolve against the column's width, hence the /383. The figure itself takes
   no pointer events (its transparent frame overhangs the run); the stop does. */
.intake-hero .watch {
  position: relative;
  width: calc(100% * 521 / 383);
  aspect-ratio: 521 / 781;
  margin: calc(-100% * 67 / 383) 0 calc(-100% * 61 / 383) calc(-100% * 70 / 383);
  container-type: inline-size;
  pointer-events: none;
}
.intake-hero .watch > img { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 2; pointer-events: none; user-select: none; }
.intake-hero .screen {
  position: absolute; left: 20.35cqw; top: 40.88cqw; width: 60.65cqw; height: 69.87cqw;
  border-radius: 11.13cqw; overflow: hidden; z-index: 1; container-type: inline-size;
  background: radial-gradient(ellipse 70% 42% at 50% 38%, color-mix(in oklab, var(--accent) 12%, transparent), transparent 70%), #000;
}
.intake-hero .face { position: absolute; inset: 0; }
.intake-hero .face-saved { display: none; }
.intake-hero.s1 .face-rec { display: none; }
.intake-hero.s1 .face-saved { display: block; }
.intake-hero .brand { position: absolute; left: 0; top: 6.96cqw; width: 100%; text-align: center; font-size: 3.48cqw; font-weight: 500; letter-spacing: 0.24em; color: var(--accent); }
.intake-hero .wave { position: absolute; left: 7.91cqw; top: 24.68cqw; width: 84.18cqw; height: 39.24cqw; display: flex; align-items: center; justify-content: center; gap: 1.27cqw; }
.intake-hero .wave i { display: block; width: 1.90cqw; border-radius: 0.95cqw; background: color-mix(in oklab, var(--accent) var(--m), var(--glow)); transform-origin: 50% 50%; animation: ih-bar 2s ease-in-out infinite; }
.intake-hero .time { position: absolute; left: 0; top: 67.72cqw; width: 100%; text-align: center; font-size: 8.86cqw; font-weight: 300; letter-spacing: 0.02em; line-height: 1; font-variant-numeric: tabular-nums; color: #F2F0EA; }
/* the whole face is the button (Jon, 2026-09-21: the ring alone felt
   ambiguous; the Archive's tap covers its screen the same way). The ring is
   drawn by ::before where the stop sat, and breathes a halo while recording
   (motion-gated below); the inner square stays where it was. */
.intake-hero .stop {
  position: absolute; inset: 0; box-sizing: border-box; padding: 0; margin: 0;
  border: 0; border-radius: 11.13cqw; background: transparent; cursor: pointer;
  pointer-events: auto;
}
/* THE TOUCH SIGNAL — one vocabulary with the Archive's phone (2026-09-22):
   ::after is the ring itself (the blue→purple gradient under a ring-shaped
   mask) and ::before its light, blue from the top-left, purple from the
   bottom-right — the gradient's direction, thrown onto the face (the phone's
   rim throws the same light inward onto its screen). Both breathe together:
   2s ease-in-out, 0.45↔1; full and still under the pointer; out once the run
   starts; still at 0.75 under reduced motion. The keyframe is an EXACT COPY of
   the phone's (touch-breathe in ArchiveHero.astro): change both or neither. */
.intake-hero .stop::before, .intake-hero .stop::after {
  content: ""; position: absolute; left: 39.87cqw; top: 87.97cqw; width: 20.25cqw; height: 20.25cqw; box-sizing: border-box;
  border-radius: 50%; pointer-events: none;
  animation: touch-breathe 2s ease-in-out infinite;
  transition: opacity .35s;
}
.intake-hero .stop::after {
  padding: 0.79cqw;
  background: linear-gradient(135deg, var(--ring-a), var(--ring-b));
  -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
  -webkit-mask-composite: xor;
  mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
  mask-composite: exclude;
}
.intake-hero .stop::before {
  box-shadow: -1.4cqw -1.4cqw 4cqw color-mix(in oklab, var(--ring-a) 55%, transparent),
              1.4cqw 1.4cqw 4cqw color-mix(in oklab, var(--ring-b) 55%, transparent);
}
.intake-hero .stop:hover::before, .intake-hero .stop:hover::after { animation: none; opacity: 1; }
.intake-hero.s1 .stop::before, .intake-hero.s1 .stop::after { animation: none; opacity: 0; }
.intake-hero .stop:focus-visible { outline: 2px solid #F2F0EA; outline-offset: -3px; }
.intake-hero .stop span { position: absolute; left: 45.88cqw; top: 93.98cqw; display: block; width: 8.23cqw; height: 8.23cqw; border-radius: 2.22cqw; background: var(--accent); transition: transform 120ms ease-out; }
/* the object presses itself (the host's first settle, 2026-09-22): the square dips as a finger would */
.intake-hero[data-ghost] .stop span { transform: scale(0.86); }
.intake-hero .flat { position: absolute; left: 7.91cqw; top: 43.99cqw; width: 84.18cqw; height: 0.63cqw; border-radius: 1px; background: color-mix(in oklab, var(--accent) 40%, transparent); animation: ih-in .5s ease-out both; clip-path: inset(0 0 0 0); transition: clip-path 1.6s cubic-bezier(.6, 0, .2, 1) 1.4s, background .5s; }
/* THE COMMIT (Jon, 2026-09-24): once the last card has landed the face turns
   green and its line retracts inward; the room's caption reads the same beat */
.intake-hero.s6 .check { border-color: color-mix(in oklab, #34C759 72%, transparent); color: #34C759; }
.intake-hero.s6 .flat { background: color-mix(in oklab, #34C759 55%, transparent); clip-path: inset(0 50% 0 50%); }
/* the computer making the cards: the deck's node breathes until they land */
.intake-hero.s4:not(.s5) .node-deck { opacity: 1; transform: none; animation: ih-breathe 1.1s ease-in-out infinite; }
@keyframes ih-breathe { 0%, 100% { opacity: .18; } 50% { opacity: .9; } }
.intake-hero .check { position: absolute; left: 39.87cqw; top: 34.18cqw; width: 20.25cqw; height: 20.25cqw; box-sizing: border-box; border-radius: 50%; border: 0.79cqw solid color-mix(in oklab, var(--glow) 55%, transparent); background: #000; color: var(--glow); transition: border-color .5s, color .5s; display: flex; align-items: center; justify-content: center; animation: ih-pop .5s ease-out .15s both; }
.intake-hero .check svg { width: 8.86cqw; height: 8.86cqw; }
.intake-hero .saved { position: absolute; left: 0; top: 63.29cqw; width: 100%; text-align: center; font-size: 7.59cqw; font-weight: 400; letter-spacing: 0.01em; line-height: 1; color: #F2F0EA; animation: ih-in .5s ease-out .3s both; }
.intake-hero .meta { position: absolute; left: 0; top: 75.32cqw; width: 100%; text-align: center; font-family: var(--mono); font-size: 3.48cqw; letter-spacing: 0.08em; color: #8C8A84; animation: ih-in .5s ease-out .4s both; }
.intake-hero .hint { text-align: center; font: 500 0.6875rem/1.5 var(--mono); letter-spacing: 0.12em; color: var(--dim); }
.intake-hero.s1 .hint { visibility: hidden; }
.intake-hero .fly { display: none; position: absolute; width: 12px; height: 12px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 18px var(--accent); z-index: 3; pointer-events: none; }
.intake-hero.s1:not(.s3) .fly { display: block; animation: ih-fly 1s cubic-bezier(.4, 0, .2, 1) both; }

/* ---- run column ---- */
.intake-hero .run { position: relative; display: flex; flex-direction: column; gap: 24px; padding-top: 8px; box-sizing: border-box; }
/* beside the watch the run holds its FINAL height from the start (Jon,
   2026-09-22: the tickets and the deck must not move the words under the
   module — "have that text appear where it currently lands at the end"):
   the script measures the run at stage six and writes --run-final */
@container hero (min-width: 820px) {
  .intake-hero .run { min-height: var(--run-final); }
}
.intake-hero.measuring, .intake-hero.measuring * { transition: none !important; animation: none !important; }
/* a row = a 10px node on the line at the left, its text 32px in (the Archive's rail draws the same) */
.intake-hero .row { position: relative; padding-left: 32px; }
.intake-hero .row::before { content: ""; position: absolute; left: 4.5px; top: 16px; bottom: -24px; width: 1px; background: var(--line); transform-origin: top; transition: transform .55s ease-out; }
.intake-hero .row:last-of-type::before { bottom: 0; background: linear-gradient(to bottom, var(--line), transparent); }
.intake-hero .node { position: absolute; left: 0; top: 3px; width: 10px; height: 10px; border-radius: 50%; background: var(--line); transition: background .4s, opacity .3s, transform .35s cubic-bezier(.2, .9, .3, 1.4); }
/* THE DOTS' SEQUENCE (Jon, 2026-09-24, one choreography with the Archive's
   rail): at rest the grey layout stands where the run will end; the press
   clears it; then each node pops in its turn and draws the line to the next */
.intake-hero.s1 .node { opacity: 0; transform: scale(.5); }
.intake-hero.s1 .row::before { transform: scaleY(0); transition: none; }
.intake-hero.s2 .node-transcript, .intake-hero.s3 .node-verdict, .intake-hero.s4 .node-ticket, .intake-hero.s5 .node-deck { opacity: 1; transform: none; }
.intake-hero.s2 .run > .row:nth-of-type(1)::before, .intake-hero.s3 .run > .row:nth-of-type(2)::before,
.intake-hero.s4 .run > .row:nth-of-type(3)::before, .intake-hero.s5 .run > .row:nth-of-type(4)::before { transform: none; transition: transform .55s ease-out .2s; }
.intake-hero .body { min-width: 0; display: flex; flex-direction: column; gap: 8px; }
.intake-hero .label { font: 500 0.6875rem/1.5 var(--mono); letter-spacing: 0.12em; color: var(--dim); }
/* at rest the run shows only its nodes (Jon, 2026-09-22): a row's words arrive with its node */
.intake-hero .row .label, .intake-hero .verdict { opacity: 0; transition: opacity .4s; }
.intake-hero.s2 .run > .row:nth-of-type(1) .label,
.intake-hero.s3 .run > .row:nth-of-type(2) .label, .intake-hero.s3 .verdict,
.intake-hero.s4 .run > .row:nth-of-type(3) .label,
.intake-hero.s5 .run > .row:nth-of-type(4) .label { opacity: 1; }

.intake-hero .stream { display: flex; visibility: hidden; height: 156px; overflow: hidden; flex-direction: column; justify-content: flex-end; font-family: var(--mono); font-size: 13px; line-height: 1.65; color: var(--ink-2); transition: opacity .6s; -webkit-mask-image: linear-gradient(to bottom, transparent, #000 36px); mask-image: linear-gradient(to bottom, transparent, #000 36px); }
.intake-hero.s2 .stream { visibility: visible; animation: ih-in .4s ease-out both; }
.intake-hero.s2 .node-transcript { background: var(--accent); }
.intake-hero.s3 .stream { opacity: .45; }
.intake-hero .caret { display: inline-block; width: 8px; height: 14px; margin-left: 4px; vertical-align: -2px; background: var(--accent); animation: ih-blink 1s steps(1) infinite; }
.intake-hero .caret[hidden] { display: none; }

.intake-hero .verdict { display: flex; gap: 18px; font-family: var(--mono); font-size: 13px; letter-spacing: 0.12em; line-height: 24px; color: var(--dim); }
.intake-hero .verdict span { transition: color .4s; }
.intake-hero.s3 .verdict span[data-on] { color: var(--amber); }
.intake-hero.s3 .node-verdict { background: var(--amber); }

.intake-hero .tickets { display: flex; visibility: hidden; flex-direction: column; font-family: var(--mono); font-size: 12px; line-height: 1.7; }
.intake-hero.s4 .tickets { visibility: visible; animation: ih-in .45s ease-out both; }
.intake-hero.s4 .node-ticket { background: var(--pink); }
.intake-hero .stub { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.intake-hero .stub.stored { opacity: .55; }
.intake-hero .k { color: var(--amber); } .intake-hero .p { color: var(--dim); } .intake-hero .v { color: var(--ink-2); }

.intake-hero .deck { display: flex; visibility: hidden; flex-direction: column; gap: 10px; }
.intake-hero.s5 .deck { visibility: visible; }
.intake-hero.s5 .node-deck { background: var(--rail); }
.intake-hero .card {
  position: relative; background: var(--card); border: 1px solid var(--card-line); border-left: 3px solid var(--rail); border-radius: 16px;
  padding: 16px 18px 14px; box-sizing: border-box; font-family: var(--sans); display: flex; flex-direction: column; gap: 10px; margin: 0;
  box-shadow: 0 18px 48px -18px var(--glow-card);
}
.intake-hero.s5 .card { animation: ih-drop .55s cubic-bezier(.2, .8, .2, 1) both; }
.intake-hero.s5 .card:nth-child(2) { animation-delay: .35s; }
.intake-hero .card-top { display: flex; align-items: center; gap: 10px; }
.intake-hero .when { font-size: 11px; color: var(--grey); }
.intake-hero .chip { font-family: var(--mono); font-size: 9px; font-weight: 600; letter-spacing: 0.14em; color: var(--accent); border: 1px solid color-mix(in oklab, var(--accent) 55%, transparent); border-radius: 4px; padding: 3px 6px; }
.intake-hero .card-x { margin-left: auto; width: 24px; height: 24px; border: 0; background: transparent; color: var(--grey); display: flex; align-items: center; justify-content: center; padding: 0; }
.intake-hero .card-title { margin: 0; font-size: 15px; font-weight: 600; line-height: 1.3; color: var(--ink); }
.intake-hero .card-items { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 4px; }
.intake-hero .card-items li { display: flex; gap: 8px; font-size: 12.5px; line-height: 1.45; color: var(--grey); }
.intake-hero .card-items li::before { content: "–"; color: var(--dim); }
.intake-hero .card-actions { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; margin-top: 2px; }
.intake-hero .act { height: 32px; border: 1px solid var(--btn-line); border-radius: 8px; background: var(--btn); color: var(--ink); font-family: inherit; font-size: 11.5px; font-weight: 500; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 6px; }
.intake-hero .act.primary { color: var(--accent); font-weight: 600; border-color: color-mix(in oklab, var(--accent) 55%, transparent); }
.intake-hero .card-src { font-size: 11px; color: var(--dim); }

/* the replay is the phone's pill, at the foot of the screen (Jon, 2026-09-22); the
   screen is the query container, so its cqw match the phone's */
.intake-hero .replay { display: none; position: absolute; left: 0; right: 0; bottom: 6.5cqw; z-index: 3; width: max-content; margin-inline: auto; align-items: center; gap: 1.4cqw; padding: 2.4cqw 4.6cqw; border: 0; border-radius: 999px; background: #ECE9E2; color: #1A1917; font: 500 3.5cqw/1 var(--sans); cursor: pointer; pointer-events: auto; } /* the page's paper on the screen (Jon, 2026-09-24): plainly not the device's own UI */
.intake-hero .replay .ico { width: 1.1em; height: 1.1em; }
.intake-hero .replay:hover { background: #DDD9CF; }
.intake-hero .replay:focus-visible { outline: 2px solid #F2F0EA; outline-offset: 2px; }
.intake-hero.s6 .replay { display: inline-flex; animation: ih-in .4s ease-out .5s both; }
.intake-hero .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

@keyframes ih-bar { 0%, 100% { transform: scaleY(.5); } 50% { transform: scaleY(1); } }
@keyframes ih-blink { 0%, 49% { opacity: 1; } 50%, 100% { opacity: 0; } }
@keyframes ih-in { 0% { opacity: 0; transform: translateY(10px); } 100% { opacity: 1; transform: translateY(0); } }
@keyframes ih-drop { 0% { opacity: 0; transform: translateY(-28px); } 70% { transform: translateY(4px); } 100% { opacity: 1; transform: translateY(0); } }
@keyframes ih-pop { 0% { transform: scale(.6); opacity: 0; } 100% { transform: scale(1); opacity: 1; } }
@keyframes ih-fly { 0% { transform: translate(0, 0); opacity: 0; } 12% { opacity: 1; } 100% { transform: translate(var(--fx, 300px), var(--fy, -400px)); opacity: 0; } }
/* the touch signal's breath — an EXACT COPY of the phone's (ArchiveHero.astro) */
@keyframes touch-breathe { 0%, 100% { opacity: 0.45; } 50% { opacity: 1; } }
@media (prefers-reduced-motion: reduce) {
  .intake-hero .wave i, .intake-hero .caret, .intake-hero .fly, .intake-hero.s4:not(.s5) .node-deck { animation: none; }
  .intake-hero .stop::before, .intake-hero .stop::after { animation: none; opacity: 0.75; }
  .intake-hero .card, .intake-hero .stream, .intake-hero .tickets, .intake-hero .replay, .intake-hero .flat, .intake-hero .check, .intake-hero .saved, .intake-hero .meta { animation-duration: .01s !important; animation-delay: 0s !important; }
}
</style>

<script>
document.querySelectorAll('[data-intake-hero]').forEach((hero) => {
  const run = JSON.parse(hero.querySelector('script[data-intake-run]').textContent);
  const words = run.transcript.trim().split(/\s+/);
  const STEP = Number(hero.dataset.step || 15);
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const typed = hero.querySelector('.typed');
  const caret = hero.querySelector('.caret');
  const status = hero.querySelector('.sr');
  const stopBtn = hero.querySelector('.stop');
  const fly = hero.querySelector('.fly');
  let timers = [];
  const at = (ms, fn) => timers.push(setTimeout(fn, reduce ? Math.round(ms * 0.15) : ms));
  const stage = (n) => { for (let i = 1; i <= 6; i++) hero.classList.toggle('s' + i, i <= n); };

  function play() {
    if (hero.classList.contains('s1')) return;
    // the fly leaves from the stop's square, not the whole face the button now covers
    const a = (stopBtn.querySelector('span') || stopBtn).getBoundingClientRect();
    const b = hero.querySelector('.node-transcript').getBoundingClientRect();
    const box = hero.getBoundingClientRect();
    fly.style.left = (a.left + a.width / 2 - box.left - 6) + 'px';
    fly.style.top = (a.top + a.height / 2 - box.top - 6) + 'px';
    fly.style.setProperty('--fx', (b.left + b.width / 2 - a.left - a.width / 2) + 'px');
    fly.style.setProperty('--fy', (b.top + b.height / 2 - a.top - a.height / 2) + 'px');
    typed.textContent = '';
    caret.hidden = false;
    stage(1);
    status.textContent = 'Memo saved.';
    // THE PACE (Jon, 2026-09-24): the first three land one at a time with
    // room to take each in; then a pause while the computer makes the cards
    // (the deck's node breathes); the cards; then, once the last has landed,
    // the face turns green — and only after that green has had its breath
    // does its line retract (see .flat's delay)
    const t0 = 1000;
    at(t0, () => stage(2));
    const tType = t0 + 250;
    if (reduce) {
      at(tType, () => { typed.textContent = words.join(' '); caret.hidden = true; });
    } else {
      words.forEach((w, i) => at(tType + (i + 1) * STEP, () => {
        typed.textContent = words.slice(0, i + 1).join(' ');
        if (i === words.length - 1) caret.hidden = true;
      }));
    }
    const t1 = tType + (reduce ? 300 : words.length * STEP) + 700;
    at(t1, () => { stage(3); status.textContent = 'Verdict: ' + run.verdict + '.'; });
    const t2 = t1 + 1400;
    at(t2, () => stage(4));
    const t3 = t2 + 2400;
    at(t3, () => { stage(5); status.textContent = run.tickets.length + ' tickets in the deck.'; });
    at(t3 + 1150, () => stage(6));
  }
  function reset() {
    timers.forEach(clearTimeout); timers = [];
    stage(0); typed.textContent = ''; caret.hidden = false; status.textContent = '';
  }
  stopBtn.addEventListener('click', play);
  hero.querySelector('.replay').addEventListener('click', reset);
  // the host (StudioOne's first settle) may FINISH a run it started — the
  // visitor pressed during it, so it lands on its end frame at once — or
  // REWIND one the visitor scrolled away from before it said anything
  hero.addEventListener('hero:finish', () => {
    if (!hero.classList.contains('s1') || hero.classList.contains('s6')) return;
    timers.forEach(clearTimeout); timers = [];
    typed.textContent = words.join(' '); caret.hidden = true;
    stage(6); status.textContent = run.tickets.length + ' tickets in the deck.';
  });
  hero.addEventListener('hero:reset', reset);

  // the run's final height, measured with every stage on and no motion, so
  // the column can reserve it beside the watch (see --run-final in the styles);
  // re-measured when fonts land and when the module's width changes
  const runEl = hero.querySelector('.run');
  const reserve = () => {
    const had = Array.from(hero.classList).filter((c) => /^s[1-6]$/.test(c));
    hero.classList.add('measuring', 's1', 's2', 's3', 's4', 's5', 's6');
    runEl.style.removeProperty('--run-final');
    const h = runEl.getBoundingClientRect().height;
    hero.classList.remove('s1', 's2', 's3', 's4', 's5', 's6');
    had.forEach((c) => hero.classList.add(c));
    void runEl.offsetHeight; // settle the stage styles before motion returns
    hero.classList.remove('measuring');
    runEl.style.setProperty('--run-final', Math.ceil(h) + 'px');
  };
  reserve();
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(reserve);
  let rt = 0;
  new ResizeObserver(() => { clearTimeout(rt); rt = setTimeout(reserve, 80); }).observe(hero);
});
</script>
