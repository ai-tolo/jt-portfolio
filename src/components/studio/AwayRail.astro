---
// AwayRail — the site's nav column on AWAY pages (/resume, the case
// studies, /signal, 404). ONE INSTRUMENT with the homepage rail since
// 2026-10-15 (Jon: the chips/glyphs "no longer feel fitting"): the same
// 148px paper a step lighter than the ground with a firmer edge, a column
// of plain words right-aligned on one x in the rail's face, the night
// switch at the foot. No chips, no borders, no house glyph, no arrows,
// no ember button (the home rail's ember pill exists as the recruiter's
// shortcut TO the résumé; inside the résumé room that reason is spent —
// the PDF action stays on the sheet).
//
// THE ROOM MODEL: /resume and the studies were one room (2026-10-15); since
// 2026-10-23 the studies step back the Momence way (Jon: "I'd rather just
// cut the case studies for now"): live at their URLs, reached by nothing,
// so the column is the JT mark and résumé alone, lit exactly like a home
// rail row when it is the current page. A study opened directly still
// takes its `current` and simply lights nothing.
//
// THE JT MARK at the head is the way home: the favicon's letterforms in
// the rail's ink (the one pictogram left sitewide — logo-goes-home is
// the convention every visitor knows); its gradient wakes on hover.
//
// Below 900px it is still the bottom bar (JT · résumé pill · moon) —
// the away phone bar's dedicated round is still owed (Jon, 2026-10-15).
// Screen-only throughout: the bar and rail must never print.
import NightSwitch from "./NightSwitch.astro";

interface Props {
  /** The lit row: "resume" on /resume; anything else (a study's slug, or
   *  omitted on /signal, 404) lights nothing. */
  current?: string;
}
const { current } = Astro.props;
// THE ARROW HOME (2026-10-23, Jon: "the red pill 'résumé' shouldn't be in the sidebar on the résumé page, it's
// redundant now … have an arrow icon underneath the JT logo"): on /resume the rail is the mark, ONE arrow row under
// it and the switch at the foot; the phone bar is the mark, the arrow and the moon. Any other away page (a study
// opened directly, 404) keeps résumé as its way out
const onResume = current === "resume";

// the room's one place: the sheet (the studies' block left 2026-10-23, and the 60px beat with it)
const SHEET = [{ slug: "resume", word: "résumé", href: "/resume" }];
---

<nav class="awayrail" aria-label="Site">
  {/* the JT mark — the favicon's two letterforms, inked for the rail;
      the brand gradient wakes on hover (the one wink) */}
  <a class="aw-jt" href="/" aria-label="Home — Jonathan Tollefson">
    <svg viewBox="3.5 6.5 76.5 29" aria-hidden="true">
      <defs>
        <linearGradient id="awjt-grad" x1="3.5" y1="21" x2="80" y2="21" gradientUnits="userSpaceOnUse">
          <stop offset="0" stop-color="#BC56B0" />
          <stop offset="0.47" stop-color="#F71A8F" />
          <stop offset="0.77" stop-color="#F77C59" />
          <stop offset="1" stop-color="#FC9755" />
        </linearGradient>
      </defs>
      <path d="M41.692 7.30743L41.692 20.058C41.692 29.3223 34.655 35.0036 23.1957 35.0036C14.2219 35.0036 7.02344 31.13 4.27965 24.7708L10.316 22.9632C12.2851 27.1273 17.1916 29.7097 23.1957 29.7097C30.8137 29.7097 35.4943 26.0298 35.4943 20.058L35.4943 7.30743L41.692 7.30743Z" />
      <path d="M79.0212 12.6336L60.3635 12.6336L60.3635 34.0352L54.1658 34.0352L54.1658 12.6336L35.508 12.6336L35.508 7.30743L79.0212 7.30743L79.0212 12.6336Z" />
    </svg>
  </a>
  {onResume && (
    <a class="aw-home" href="/" aria-label="Home"><span aria-hidden="true">←</span></a>
  )}
  {/* the room's place — the homepage rail's exact row (134×44, the word
      flush right), lit in the ember when it is the current page; not on
      /resume itself since 2026-10-23 (the arrow above is its way out) */}
  {!onResume && <div class="aw-col">
    <ul class="aw-list" role="list">
      {SHEET.map((p) => (
        <li>
          <a
            class:list={["aw-item", { "aw-res": p.slug === "resume" }]}
            href={p.href}
            aria-current={current === p.slug ? "page" : undefined}
          >
            <span class="aw-word">{p.word}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>}
  {/* phone bar only: the résumé shortcut in the home bar's ember pill (not on /resume: the arrow home stands there) */}
  {!onResume && <a class="aw-cv" href="/resume"
    >résumé<span class="aw-cv-glyph" aria-hidden="true">↗</span></a>}
  <div class="aw-foot">
    <NightSwitch />
  </div>
</nav>

<style>
  .awayrail {
    /* the homepage rail's ember (StudioOne's .one); tokens.css has no
       global for it yet */
    --ember: #ff5432;
    display: none;
    transition: background 560ms ease, border-color 560ms ease;
  }

  /* ── the bottom bar (<900px): JT · résumé pill · moon ─────────────── */
  @media screen and (max-width: 899px) {
    .awayrail {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 70;
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      padding: 8px 18px calc(8px + env(safe-area-inset-bottom));
      border-top: 1px solid rgba(20, 18, 16, 0.26);
    }
    /* the pages themselves must clear the bar */
    :global(body) {
      padding-bottom: calc(62px + env(safe-area-inset-bottom));
    }
    .aw-col {
      display: none;
    }
    .aw-cv {
      display: inline-flex;
    }
    .aw-foot {
      display: flex;
      align-items: center;
    }
  }

  /* ── the rail (≥900px): the homepage rail's physical object ───────── */
  @media screen and (min-width: 900px) {
    .awayrail {
      position: fixed;
      left: 0;
      top: 0;
      bottom: 0;
      z-index: 70;
      width: var(--railw, 148px);
      display: flex;
      flex-direction: column;
      align-items: center;
      border-top: 0;
      padding: 22px 6px 14px 8px;
    }
    .aw-cv {
      display: none;
    }
    .aw-foot {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
    }
    /* hairline parting the foot from the column, as over the homepage
       rail's switch */
    .aw-foot::before {
      content: "";
      width: 26px;
      border-top: 1px solid rgba(20, 18, 16, 0.2);
      margin-bottom: 6px;
    }
    :global(html[data-night]) .aw-foot::before {
      border-top-color: rgba(232, 236, 244, 0.2);
    }
  }

  /* the paper: a step lighter than the ground, a firmer edge (the
     homepage rail's values, round eight) */
  .awayrail {
    background: #fbfaf7;
  }
  @media (min-width: 900px) {
    .awayrail {
      border-right: 1px solid rgba(20, 18, 16, 0.26);
    }
  }
  :global(html[data-night]) .awayrail {
    background: #161b24;
    border-top-color: rgba(160, 190, 230, 0.22);
  }
  @media (min-width: 900px) {
    :global(html[data-night]) .awayrail {
      border-right-color: rgba(160, 190, 230, 0.22);
    }
  }

  /* ── the JT mark ──────────────────────────────────────────────────── */
  .aw-jt {
    display: inline-flex;
    padding: 8px 10px;
    color: #26241f;
    transition: color 560ms ease;
  }
  .aw-jt svg {
    width: 46px;
    height: auto;
    display: block;
  }
  .aw-jt path {
    fill: currentColor;
  }
  .aw-jt:hover path,
  .aw-jt:focus-visible path {
    fill: url(#awjt-grad);
  }
  .aw-jt:focus-visible {
    outline: 2px solid var(--ink, #141210);
    outline-offset: 3px;
    border-radius: 6px;
  }
  :global(html[data-night]) .aw-jt {
    color: #b4bdcb;
  }
  @media screen and (max-width: 899px) {
    .aw-jt {
      padding: 10px 6px; /* 44px tap target on the bar */
    }
    .aw-jt svg {
      width: 40px;
    }
  }

  /* ── THE ARROW HOME (2026-10-23, /resume only): the words' 44px row, the glyph centred under the mark in the rail's
     ink and mono face; its hover is the mark's own (the brand gradient through the glyph). On the desk it stands
     directly under the mark and the foot keeps the rail's bottom; on the bar it sits between the mark and the moon */
  .aw-home {
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    width: 134px;
    height: 44px;
    margin-top: 6px;
    border-radius: 11px;
    text-decoration: none;
    font: 600 1.25rem/1 "IBM Plex Mono", ui-monospace, monospace;
    color: #26241f;
    transition: color 560ms ease;
  }
  .aw-home span {
    display: block;
    padding: 0 2px; /* the clipped gradient needs the glyph's whole box */
  }
  .aw-home:hover span,
  .aw-home:focus-visible span {
    background: linear-gradient(90deg, #BC56B0 0%, #F71A8F 47%, #F77C59 77%, #FC9755 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .aw-home:focus-visible {
    outline: 2px solid var(--ink, #141210);
    outline-offset: 2px;
  }
  :global(html[data-night]) .aw-home {
    color: #b4bdcb;
  }
  :global(html[data-night]) .aw-home:focus-visible {
    outline-color: #e8ecf4;
  }
  @media screen and (min-width: 900px) {
    .aw-home + .aw-foot {
      margin-top: auto;
    }
  }
  @media screen and (max-width: 899px) {
    .aw-home {
      width: 44px;
      margin-top: 0;
    }
  }

  /* ── the words (the homepage rail's row, value for value) ─────────── */
  .aw-col {
    flex-direction: column;
    width: 134px;
  }
  .aw-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* display is owned HERE, after the base reset, so the phone block's
     none and the auto margins survive the cascade: the column is a desk
     object, centred between the mark and the foot */
  @media screen and (min-width: 900px) {
    .aw-col {
      display: flex;
      margin-block: auto;
    }
  }
  .aw-item {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    box-sizing: border-box;
    width: 134px;
    height: 44px;
    padding: 0 11px;
    border-radius: 11px;
    text-decoration: none;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    color: #26241f;
    transition: background 160ms ease, color 160ms ease;
  }
  .aw-item:hover {
    background: rgba(20, 18, 16, 0.07);
  }
  /* the current page: lit exactly like a home rail row (tokens.css's
     --ink flips at night, unlike the homepage's shadowed one) */
  .aw-item[aria-current="page"] {
    background: #141210;
    color: #f5f2ea;
  }
  .aw-item:focus-visible {
    outline: 2px solid var(--ink, #141210);
    outline-offset: 2px;
  }
  .aw-word {
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.06em;
    /* the tracking's trailing space would push every word 0.06em off the
       shared right edge: take it back (the homepage rail's rule) */
    margin-right: -0.06em;
    white-space: nowrap;
  }
  :global(html[data-night]) .aw-item {
    color: #b4bdcb;
  }
  :global(html[data-night]) .aw-item:hover {
    background: rgba(232, 236, 244, 0.07);
  }
  :global(html[data-night]) .aw-item[aria-current="page"] {
    background: #e8ecf4;
    color: #101216;
  }
  /* résumé's highlight is the homepage's ember (Jon, 2026-10-15: "the
     highlight color of resume … should match the color from the homepage
     for continuity"): the lit row wears the rail pill's clothes, both
     temperatures; the studies keep the ink pill */
  .aw-res[aria-current="page"],
  :global(html[data-night]) .aw-res[aria-current="page"] {
    background: var(--ember);
    color: #fff;
  }
  :global(html[data-night]) .aw-item:focus-visible,
  :global(html[data-night]) .aw-jt:focus-visible {
    outline-color: #e8ecf4;
  }

  /* ── the phone bar's résumé pill (the home bar's ember pill) ────────
     display is owned by the breakpoints above (none by default and ≥900;
     the bar turns it on) — this block is appearance only */
  .aw-cv {
    align-items: center;
    gap: 4px;
    padding: 8px 12px;
    border: 1px solid var(--ember);
    border-radius: 999px;
    background: var(--ember);
    color: #fff;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.7rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.06em;
    white-space: nowrap;
    text-decoration: none;
  }
  .aw-cv-glyph {
    font-size: 0.85em;
    letter-spacing: 0;
  }
  /* (the pill's lit "you are here" ring on /resume left with the pill there, 2026-10-23) */
  .aw-cv:focus-visible {
    outline: 2px solid var(--ink, #141210);
    outline-offset: 2px;
  }
</style>
