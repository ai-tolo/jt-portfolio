---
// AwayRail — the site's nav column on AWAY pages (case studies, résumé).
// Same 92px column as the homepage sidebar, reduced to: 🏠 home in the
// middle, résumé at the bottom (optional). Dark variant matches the
// case-study canvas; light matches the studio ground. Desktop only —
// below 900px the pages keep their own full-width flow.
interface Props {
  variant?: "dark" | "light";
  /** Show the résumé link at the column's foot (omit on /resume itself). */
  resume?: boolean;
}
const { variant = "dark", resume = true } = Astro.props;
---

<nav class={`awayrail ${variant}`} aria-label="Site">
  <a class="ar-home" href="/" aria-label="Home — the studio">
    <span class="ar-chip" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
        stroke-linecap="round" stroke-linejoin="round">
        <path d="M19 12H6" /><path d="M11.5 6.5 6 12l5.5 5.5" />
      </svg>
    </span>
    <span class="ar-word" aria-hidden="true">home</span>
  </a>
  {resume && <a class="ar-resume" href="/resume">résumé</a>}
</nav>

<style>
  /* below 900px the column becomes a BOTTOM BAR (2026-08-24 mobile pass) —
     phones kept losing the way home until the very last line of a page.
     Screen-only throughout: letter paper is narrower than 900px, and the
     bar must never print. */
  .awayrail {
    display: none;
  }
  @media screen and (max-width: 899px) {
    .awayrail {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 70;
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      padding: 8px 18px calc(8px + env(safe-area-inset-bottom));
      border-top: 1px solid rgba(20, 18, 16, 0.14);
    }
    /* the pages themselves must clear the bar */
    :global(body) {
      padding-bottom: calc(62px + env(safe-area-inset-bottom));
    }
  }
  @media screen and (min-width: 900px) {
    .awayrail {
      position: fixed;
      left: 0;
      top: 0;
      bottom: 0;
      z-index: 70;
      width: 92px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-start;
      border-top: 0;
      padding: 20px 8px 18px;
    }
  }
  .awayrail.dark {
    background: #101216;
    border-top-color: rgba(160, 190, 230, 0.12);
  }
  .awayrail.light {
    background: #f4f3f0;
  }
  @media (min-width: 900px) {
    .awayrail.dark {
      border-right: 1px solid rgba(160, 190, 230, 0.12);
    }
    .awayrail.light {
      border-right: 1px solid rgba(20, 18, 16, 0.14);
    }
  }

  .ar-home {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 9px;
    text-decoration: none;
  }
  @media (min-width: 900px) {
    .ar-home {
      flex-direction: column;
      gap: 5px;
    }
  }
  .ar-chip {
    display: grid;
    place-items: center;
    width: 48px;
    height: 44px;
    border-radius: 11px;
    transition: border-color 160ms ease, background 160ms ease;
  }
  .ar-chip svg {
    width: 21px;
    height: 21px;
    transition: transform 160ms ease;
  }
  .dark .ar-chip {
    border: 1px solid rgba(232, 236, 244, 0.28);
    background: rgba(232, 236, 244, 0.06);
    color: #e8ecf4;
  }
  .light .ar-chip {
    border: 1px solid rgba(20, 18, 16, 0.3);
    background: rgba(20, 18, 16, 0.04);
    color: #141210;
  }
  .ar-word {
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.7rem;
    letter-spacing: 0.06em;
  }
  @media screen and (min-width: 900px) {
    .ar-word {
      font-size: 0.56rem;
    }
  }
  .dark .ar-word { color: #8f98a8; }
  .light .ar-word { color: #6a6660; }
  .ar-home:hover .ar-chip,
  .ar-home:focus-visible .ar-chip {
    border-color: currentColor;
  }
  .dark .ar-home:hover .ar-chip { background: rgba(232, 236, 244, 0.12); }
  .light .ar-home:hover .ar-chip { background: rgba(20, 18, 16, 0.08); }
  .ar-home:hover .ar-chip svg,
  .ar-home:focus-visible .ar-chip svg {
    transform: translateX(-2.5px);
  }
  .ar-home:hover .ar-word { color: currentColor; }
  .ar-home:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
    border-radius: 12px;
  }

  .ar-resume {
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-decoration: underline;
    text-underline-offset: 4px;
    white-space: nowrap;
    padding: 10px 4px;
  }
  @media (min-width: 900px) {
    .ar-resume {
      position: absolute;
      bottom: 22px;
      left: 50%;
      transform: translateX(-50%);
      font-size: 0.66rem;
      padding: 0;
    }
  }
  .dark .ar-resume {
    color: #8f98a8;
  }
  .dark .ar-resume:hover,
  .dark .ar-resume:focus-visible {
    color: #e8ecf4;
  }
  .light .ar-resume {
    color: #6a6660;
  }
  .light .ar-resume:hover,
  .light .ar-resume:focus-visible {
    color: #141210;
  }
</style>
