---
// AwayRail — the site's nav column on AWAY pages (case studies, résumé,
// writing). One rail sitewide since 2026-08-28: same 110px width as the
// homepage rail (var(--railw) in tokens.css), day/night via the sitewide
// axis instead of the old per-page variant prop. Desktop: 🡐 home at the
// top, résumé + the night switch at the foot. Below 900px it becomes the
// bottom bar (home · résumé · moon). Screen-only throughout: letter
// paper is narrower than 900px, and the bar must never print.
import NightSwitch from "./NightSwitch.astro";

interface Props {
  /** Show the résumé link (omit on /resume itself). */
  resume?: boolean;
}
const { resume = true } = Astro.props;
---

<nav class="awayrail" aria-label="Site">
  <a class="ar-home" href="/" aria-label="Home — the studio">
    <span class="ar-chip" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
        stroke-linecap="round" stroke-linejoin="round">
        <path d="M19 12H6" /><path d="M11.5 6.5 6 12l5.5 5.5" />
      </svg>
    </span>
    <span class="ar-word" aria-hidden="true">home</span>
  </a>
  {/* the two exits cluster at the top; accent so it reads (Jon, 2026-08-28) */}
  {resume && <a class="ar-resume" href="/resume">résumé</a>}
  <div class="ar-foot">
    <NightSwitch />
  </div>
</nav>

<style>
  .awayrail {
    display: none;
    transition: background 560ms ease, border-color 560ms ease;
  }
  @media screen and (max-width: 899px) {
    .awayrail {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 70;
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      padding: 8px 18px calc(8px + env(safe-area-inset-bottom));
      border-top: 1px solid rgba(20, 18, 16, 0.14);
    }
    /* the pages themselves must clear the bar */
    :global(body) {
      padding-bottom: calc(62px + env(safe-area-inset-bottom));
    }
    .ar-foot {
      display: flex;
      flex-direction: row;
      align-items: center;
      gap: 12px;
    }
  }
  @media screen and (min-width: 900px) {
    .awayrail {
      position: fixed;
      left: 0;
      top: 0;
      bottom: 0;
      z-index: 70;
      width: var(--railw, 110px);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-start;
      border-top: 0;
      padding: 20px 8px 14px;
    }
    .ar-foot {
      margin-top: auto;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
    }
    /* hairline quarantining the foot from the column, same language as
       the homepage switch's divider */
    .ar-foot::before {
      content: "";
      width: 26px;
      border-top: 1px solid rgba(20, 18, 16, 0.2);
      margin-bottom: 6px;
    }
    :global(html[data-night]) .ar-foot::before {
      border-top-color: rgba(232, 236, 244, 0.2);
    }
  }
  .awayrail {
    background: #f4f3f0;
  }
  @media (min-width: 900px) {
    .awayrail {
      border-right: 1px solid rgba(20, 18, 16, 0.14);
    }
  }
  :global(html[data-night]) .awayrail {
    background: #101216;
    border-top-color: rgba(160, 190, 230, 0.12);
  }
  @media (min-width: 900px) {
    :global(html[data-night]) .awayrail {
      border-right-color: rgba(160, 190, 230, 0.12);
    }
  }

  .ar-home {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 9px;
    text-decoration: none;
  }
  @media (min-width: 900px) {
    .ar-home {
      flex-direction: column;
      gap: 5px;
    }
  }
  .ar-chip {
    display: grid;
    place-items: center;
    width: 48px;
    height: 44px;
    border-radius: 11px;
    border: 1px solid rgba(20, 18, 16, 0.3);
    background: rgba(20, 18, 16, 0.04);
    color: #141210;
    transition: border-color 160ms ease, background 560ms ease, color 560ms ease;
  }
  .ar-chip svg {
    width: 21px;
    height: 21px;
    transition: transform 160ms ease;
  }
  :global(html[data-night]) .ar-chip {
    border-color: rgba(232, 236, 244, 0.28);
    background: rgba(232, 236, 244, 0.06);
    color: #e8ecf4;
  }
  .ar-word {
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    color: #6a6660;
    transition: color 560ms ease;
  }
  @media screen and (min-width: 900px) {
    .ar-word {
      font-size: 0.56rem;
    }
  }
  :global(html[data-night]) .ar-word {
    color: #8f98a8;
  }
  .ar-home:hover .ar-chip,
  .ar-home:focus-visible .ar-chip {
    border-color: currentColor;
  }
  .ar-home:hover .ar-chip {
    background: rgba(20, 18, 16, 0.08);
  }
  :global(html[data-night]) .ar-home:hover .ar-chip {
    background: rgba(232, 236, 244, 0.12);
  }
  .ar-home:hover .ar-chip svg,
  .ar-home:focus-visible .ar-chip svg {
    transform: translateX(-2.5px);
  }
  .ar-home:hover .ar-word {
    color: currentColor;
  }
  .ar-home:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
    border-radius: 12px;
  }

  /* résumé — visible at every width, clustered under home, in the red
     accent so it actually pops on the light rail (Jon, 2026-08-28; the
     muted foot word never read). var(--accent) flips flame at night. */
  .ar-resume {
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-decoration: underline;
    text-underline-offset: 4px;
    white-space: nowrap;
    /* 44px tap target on the phone bar */
    padding: 13px 6px;
    color: var(--accent);
    transition: color 560ms ease;
  }
  @media (min-width: 900px) {
    .ar-resume {
      font-size: 0.72rem;
      padding: 6px 4px;
      margin-top: 14px;
    }
  }
  .ar-resume:hover,
  .ar-resume:focus-visible {
    color: var(--text);
  }
</style>
