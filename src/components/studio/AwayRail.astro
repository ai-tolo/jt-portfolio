---
// AwayRail — the site's nav column on AWAY pages (case studies, résumé).
// Same 92px column as the homepage sidebar, reduced to: 🏠 home in the
// middle, résumé at the bottom (optional). Dark variant matches the
// case-study canvas; light matches the studio ground. Desktop only —
// below 900px the pages keep their own full-width flow.
interface Props {
  variant?: "dark" | "light";
  /** Show the résumé link at the column's foot (omit on /resume itself). */
  resume?: boolean;
}
const { variant = "dark", resume = true } = Astro.props;
---

<nav class={`awayrail ${variant}`} aria-label="Site">
  <a class="ar-home" href="/" aria-label="Home — the studio">
    <span aria-hidden="true">🏠</span>
  </a>
  {resume && <a class="ar-resume" href="/resume">résumé</a>}
</nav>

<style>
  .awayrail {
    display: none;
  }
  @media (min-width: 900px) {
    .awayrail {
      position: fixed;
      left: 0;
      top: 0;
      bottom: 0;
      z-index: 70;
      width: 92px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 18px 8px;
    }
  }
  .awayrail.dark {
    background: #101216;
    border-right: 1px solid rgba(160, 190, 230, 0.12);
  }
  .awayrail.light {
    background: #f4f3f0;
    border-right: 1px solid rgba(20, 18, 16, 0.14);
  }

  .ar-home {
    display: grid;
    place-items: center;
    width: 54px;
    height: 54px;
    border-radius: 13px;
    font-size: 24px;
    text-decoration: none;
    transition: background 160ms ease, transform 160ms ease;
  }
  .dark .ar-home:hover,
  .dark .ar-home:focus-visible {
    background: rgba(240, 244, 252, 0.08);
  }
  .light .ar-home:hover,
  .light .ar-home:focus-visible {
    background: rgba(20, 18, 16, 0.07);
  }
  .ar-home:hover {
    transform: translateY(-2px);
  }
  .ar-home:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  .ar-resume {
    position: absolute;
    bottom: 22px;
    left: 50%;
    transform: translateX(-50%);
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    text-decoration: underline;
    text-underline-offset: 4px;
    white-space: nowrap;
  }
  .dark .ar-resume {
    color: #8f98a8;
  }
  .dark .ar-resume:hover,
  .dark .ar-resume:focus-visible {
    color: #e8ecf4;
  }
  .light .ar-resume {
    color: #6a6660;
  }
  .light .ar-resume:hover,
  .light .ar-resume:focus-visible {
    color: #141210;
  }
</style>
