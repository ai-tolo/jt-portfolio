---
// StudioOne — the one-page skeleton (direction locked with Jon, 2026-08-12).
//
// One page, consistent wood ground. The hero IS the sitemap: autograph,
// one quiet sentence, and the five marks in a small centered row (emoji
// placeholders now — Jon's art lands at public/studio/mark-<id>.webp and
// takes over per mark, same swap-contract pattern as ever). Click = smooth
// anchor scroll. Once the hero row leaves the viewport, the row's five marks
// reappear as a FLOATING PILL (top-center capsule, scroll-spy active state,
// identical on phone). Sound sections are night sheets on the same wood
// (two temperatures, row-local; the page itself never dims).
//
// Supersedes the desk composition (StudioDesk.astro stays in git history;
// /signal, case studies, /resume untouched). Skeleton only: Jon owns the
// section surface treatment after this lands.
import fs from "node:fs";
import path from "node:path";
import soundlab from "./rooms/soundlab-manifest.json";
import writing from "./rooms/writing-manifest.json";
import illustrations from "./rooms/illustrations-manifest.json";
import SignalMachine from "../SignalMachine.astro";
import Transport from "../Transport.astro";
import Carousel from "../Carousel.astro";
import type { WorkItem } from "./StudioDesk.astro";

interface Props {
  works: WorkItem[];
}
const { works } = Astro.props;

// The one-liner. Jon rewrites this string at will (his voice: plain,
// human-centered function; explicitly NOT music-dramatic).
const ONE_LINER = "I design tools around how people actually use them.";

const pub = (f: string) => path.join(process.cwd(), "public", "studio", f);
const exists = (f: string) => fs.existsSync(pub(f));
const etchAsset = ["etch.svg", "etch.webp", "etch.png"].filter(exists).map((f) => `/studio/${f}`)[0];

interface Track { src: string | null; title: string; note?: string; year?: number; duration?: string; peaks?: string | null; cover?: string | null; }
const tracks: Track[] = ((soundlab as any).tracks ?? []).filter((t: Track) => t.src);

// Generated cover: the track's OWN waveform, radial, on the night ground —
// honest per-track art until Jon's covers land in the manifest (cover field).
const peaksFor = (t: Track): number[] => {
  try {
    const base = (t.peaks ?? "").replace(/\.[a-z0-9]+$/i, "");
    return JSON.parse(fs.readFileSync(path.join(process.cwd(), "public", "peaks", `${base}.json`), "utf8")).peaks;
  } catch { return Array.from({ length: 120 }, (_, i) => 0.25 + 0.2 * Math.sin(i / 5)); }
};
const coverSvg = (t: Track, seed: number): string => {
  const pk = peaksFor(t);
  const N = Math.min(pk.length, 144);
  const cx = 120, cy = 120, r0 = 52;
  let bars = "";
  for (let i = 0; i < N; i++) {
    const a = (i / N) * Math.PI * 2 - Math.PI / 2 + seed * 0.13;
    const len = 10 + pk[Math.floor((i / N) * pk.length)] * 46;
    const x1 = cx + Math.cos(a) * r0, y1 = cy + Math.sin(a) * r0;
    const x2 = cx + Math.cos(a) * (r0 + len), y2 = cy + Math.sin(a) * (r0 + len);
    bars += `<line x1="${x1.toFixed(1)}" y1="${y1.toFixed(1)}" x2="${x2.toFixed(1)}" y2="${y2.toFixed(1)}"/>`;
  }
  return `<svg viewBox="0 0 240 240" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="">
    <rect width="240" height="240" fill="#0b0e14"/>
    <circle cx="120" cy="120" r="46" fill="none" stroke="rgba(232,236,244,0.1)" stroke-width="1"/>
    <g stroke="rgba(14,196,252,0.75)" stroke-width="1.6" stroke-linecap="round">${bars}</g>
    <circle cx="120" cy="120" r="3" fill="rgba(255,84,50,0.9)"/>
  </svg>`;
};
interface Illo { src: string; alt: string; title?: string; year?: number; }
const illos: Illo[] = (illustrations as any).items ?? [];
interface Post { slug: string; title: string; date: string; subtitle?: string; cover?: string | null; paragraphs: string[]; }
const posts: Post[] = (writing as any).posts ?? [];

// Recruiter-facing WORK ledes: the one-to-two-sentence summary IS the title
// (Jon, 2026-08-16 — project names demote to metadata). Hand-authored
// presentation copy; <strong> spans carry the scan path. Fallback = subtitle.
const LEDES: Record<string, string> = {
  "the-console":
    "Eight years of music was dying on my hard drive. I built three tools to stop it: a catalog that knows what I have, a studio that plays it back like a band, and <strong>a listening test I can't cheat</strong>.",
  "chs":
    "CHS has 10,000 employees and, suddenly, AI. I taught it — from a 250-person beta to the whole company, until <strong>non-technical teams were building their own models</strong>.",
  "crediverso":
    "Most banking apps treat family like a liability. We shipped one in two languages where <strong>family is the point</strong> — and the front door stopped losing people: bounce fell 40% to 25%.",
  "raylu":
    "Raylu had a product in their heads and pitch meetings on the calendar. I built the brand and the prototypes <strong>they carried into the rooms that closed $4M</strong>.",
  "momence":
    "One take-home, 48 hours: rebuild Momence's customer profile so a yoga studio and a B2B coach both recognize themselves. I sent back <strong>four categories that bend per tenant</strong>.",
};

// The words — type-only (Jon, 2026-08-19: no emoji; tasteful mono). Order
// mirrors the page: the instrument is the handshake, right under the hero.
// A word renders ONLY when its room has something in it.
const MARKS = [
  { id: "signal", word: "play", ethereal: true, has: true },
  { id: "work", word: "work", ethereal: false, has: works.length > 0 },
  { id: "soundlab", word: "listen", ethereal: false, has: tracks.length > 0 },
  { id: "illustrations", word: "look", ethereal: false, has: illos.length > 0 },
  { id: "writing", word: "read", ethereal: false, has: true },
].filter((m) => m.has);
const SHOW = new Set(MARKS.map((m) => m.id));
---

<a class="skip" href="#work">Skip to the work</a>

{/* The wood: one fixed layer; everything scrolls over it. */}
<div class="ground" aria-hidden="true"></div>

<div class="one" data-one>
  {/* ── HERO — the sitemap ─────────────────────────────────────────────── */}
  <section class="hero" aria-label="Jonathan Tollefson — site index">
    <p class="corner">
      <span>minneapolis, mn</span>
      <i class="dot" aria-hidden="true"></i>
      <a href="/resume">résumé</a>
    </p>

    <header class="hero-name">
      <div class="etch-slot">
        {etchAsset ? (
          <>
            <h1 class="sr-only">Jonathan Tollefson</h1>
            <img class="etch-img" src={etchAsset} alt="" draggable="false" />
          </>
        ) : (
          <h1 class="etch-text">Jonathan Tollefson</h1>
        )}
      </div>
      <p class="liner">{ONE_LINER}</p>
    </header>

  </section>

  {/* ── THE SIDEBAR — persistent left column, nav only (Jon, 2026-08-16:
      always present from load; flat light panel; mobile deferred) ───────── */}
  <nav class="rail" data-rail aria-label="Sections">
    {MARKS.map((m) => (
      <a class="rail-item" href={`#${m.id}`} data-for={m.id} data-ethereal={m.ethereal ? "" : undefined}>
        <span class="rail-word">{m.word}</span>
      </a>
    ))}
    <span class="comet" data-comet aria-hidden="true">
      <i class="comet-track"></i>
      <i class="comet-fill"></i>
      <i class="comet-bead"></i>
    </span>
  </nav>

  {/* ── SECTIONS ───────────────────────────────────────────────────────── */}
  {/* ── SIGNAL — the instrument itself, live, the site's finale.
      Power-on takes the whole site dark; scrolling away powers it off and
      the light returns. The component is SACRED — observed, never edited. */}
  {/* No id here — SignalMachine's own root is <section id="signal">, which
      serves as the anchor + spy target; this host only frames and observes. */}
  <section class="live-signal" aria-label="Signal — a playable instrument" data-signal-host>
    <div class="sig-desktop">
      <SignalMachine />
    </div>
    <div class="sig-mobile">
      <iframe class="sig-mobile-frame" data-src="/more/index.html" title="Interactive audio exhibit" loading="lazy" allow="autoplay"></iframe>
    </div>
  </section>

  {SHOW.has("work") && <section class="sheet paper" id="work" aria-labelledby="work-t">
    <h2 id="work-t">Selected Work</h2>
    <ul class="works">
      {works.map((w, i) => (
        <li>
          <a class="wrow" href={`/case-studies/${w.slug}`} data-flagship={i === 0 ? "" : undefined}>
            {w.cover && <span class="wrow-cover"><img src={w.cover} alt="" loading={i === 0 ? "eager" : "lazy"} /></span>}
            <span class="wrow-body">
              <span class="wrow-lede" set:html={LEDES[w.slug] ?? w.subtitle}></span>
              <span class="wrow-meta">
                <b>{w.name}</b>
                {i === 0 && <em class="flag">flagship</em>}
                {w.tags?.length > 0 && <span class="wrow-tags">{w.tags.slice(0, 4).join(" · ")}</span>}
              </span>
              {w.outcome && !LEDES[w.slug] && <span class="wrow-outcome">{w.outcome}</span>}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>}


  {/* the about-that-isn't-a-section: three sentences of human before the
      personal half begins. DRAFT — Jon rewrites at will. */}
  <p class="bio">
    I'm Jon Tollefson. Days I design and build tools at the seam of interface,
    code, and AI; nights I'm in the studio, bending found sound into songs.
    Everything below is both of those at once — made in Minneapolis.
  </p>

  {SHOW.has("soundlab") && <section class="sheet night" id="soundlab" aria-labelledby="soundlab-t">
    <h2 id="soundlab-t">Listen</h2>
    <Carousel count={tracks.length} label="Music" accent="var(--sapphire)">
      {tracks.map((t, i) => (
        <article class="ls">
          <div class="ls-cover" aria-hidden="true">
            {t.cover ? <img src={t.cover} alt="" loading={i === 0 ? "eager" : "lazy"} /> : <Fragment set:html={coverSvg(t, i)} />}
          </div>
          <div class="ls-body">
            <span class="ls-no">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="ls-title">{t.title}</h3>
            {t.note && <p class="ls-note">{t.note}</p>}
            <p class="ls-meta">{[t.year, t.duration].filter(Boolean).join(" · ")}</p>
            <div class="ls-tp"><Transport src={t.src!} peaks={t.peaks ?? undefined} title={t.title} accent="var(--sapphire)" compact /></div>
          </div>
        </article>
      ))}
    </Carousel>
  </section>}

  <section class="sheet paper" id="writing" aria-labelledby="writing-t">
    <h2 id="writing-t">Read</h2>
    {posts.length > 0 ? (
      <ul class="tiles">
        {posts.map((post) => (
          <li>
            <a class="tile" href={`/writing/${post.slug}`}>
              {post.cover && <span class="tile-cover"><img src={post.cover} alt="" loading="lazy" /></span>}
              <span class="tile-title">{post.title}</span>
              {post.subtitle && <span class="tile-sub">{post.subtitle}</span>}
              <span class="tile-date">{post.date}</span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="paper-line">Writing lands here.</p>
    )}
  </section>

  {SHOW.has("illustrations") && <section class="look-band" id="illustrations" aria-labelledby="illustrations-t">
    <h2 id="illustrations-t" class="sr-only">Look</h2>
    <Carousel count={illos.length} label="Visual work" accent="var(--brand-yellow, #ffc94d)">
      {illos.map((it) => (
        <figure class="lk">
          <img class="lk-img" src={it.src} alt={it.alt} loading="lazy" />
          {(it.title || it.year) && <figcaption class="lk-cap">{[it.title, it.year].filter(Boolean).join(" · ")}</figcaption>}
        </figure>
      ))}
    </Carousel>
  </section>}

  {/* the floor: reachable + placeable — email with the city beneath it */}
  <footer class="floor">
    <span class="floor-lines">
      <a href="mailto:jtollefson123@gmail.com">jtollefson123@gmail.com</a>
      <span class="floor-city">Minneapolis, MN</span>
    </span>
    <a class="floor-resume" href="/resume">résumé</a>
  </footer>

  {/* end sentinel: at document bottom the last section takes the active
      state even though it is too short to reach the spy band */}
  <div data-end aria-hidden="true"></div>
</div>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .skip {
    position: fixed;
    left: 20px;
    top: -60px;
    z-index: 90;
    padding: 10px 16px;
    background: #1c160d;
    color: #f5efe2;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.8rem;
    border-radius: 6px;
    transition: top 160ms ease;
  }
  .skip:focus {
    top: 20px;
  }

  /* ── the ground — neutral for now (Jon, 2026-08-16: wood out while the
     skeleton settles; surface treatment comes back later as his call) ──── */
  .ground {
    position: fixed;
    inset: 0;
    z-index: -1;
    background: #e9e8e5;
  }

  .one {
    /* the ground breathes after the last sheet — and the tail gives the final
       sections room to reach the scroll-spy band */
    padding-bottom: clamp(140px, 32vh, 360px);
    --railw: 0px;
    --ink: #141210;
    --dim: #6a5940;
    --paper: rgba(248, 244, 234, 0.96);
    --paper-line: rgba(90, 74, 50, 0.28);
    --night: #0b0e14;
    --night-line: #1c222e;
    --night-ink: #e8ecf4;
    --night-dim: #7d8798;
    --sapphire: #0ec4fc;
    --ember: #ff5432;
    color: var(--ink);
    font-family: "IBM Plex Sans", ui-sans-serif, system-ui, sans-serif;
  }

  /* ── hero ────────────────────────────────────────────────────────────── */
  .hero {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(40px, 7vh, 72px);
    padding: 24px;
    position: relative;
  }
  .corner {
    position: absolute;
    top: 22px;
    right: 26px;
    margin: 0;
    display: flex;
    gap: 12px;
    align-items: center;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--dim);
  }
  .corner .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ember);
    flex: none;
  }
  .corner a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .hero-name {
    width: min(720px, 88%);
  }
  .etch-slot {
    text-align: left;
  }
  .etch-text {
    margin: 0;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-weight: 600;
    font-size: clamp(1.3rem, 3vw, 2rem);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .etch-img {
    display: block;
    width: clamp(260px, 30vw, 420px);
    height: auto;
  }
  .liner {
    margin: 26px 0 0 auto;
    font-size: clamp(0.95rem, 1.4vw, 1.05rem);
    color: var(--dim);
    max-width: 34ch;
    line-height: 1.5;
    text-align: right;
  }

  /* ── the sidebar (persistent left column; desktop only) ──────────────── */
  .rail {
    display: none;
  }
  @media (min-width: 900px) {
    .rail {
      display: flex;
    }
  }
  .rail {
    position: fixed;
    left: 0;
    top: 0;
    bottom: 0;
    z-index: 50;
    width: 92px;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    padding: 16px 8px;
    background: #f4f3f0;
    border-right: 1px solid rgba(20, 18, 16, 0.14);
  }
  .rail-item {
    display: grid;
    place-items: center;
    width: 76px;
    padding: 11px 4px;
    border-radius: 11px;
    text-decoration: none;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    color: #45423c;
    transition: background 160ms ease, color 160ms ease;
  }
  .rail-item:hover {
    background: rgba(20, 18, 16, 0.07);
  }
  .rail-item[data-on] {
    background: var(--ink);
    color: #f5f2ea;
  }
  .rail-item:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }
  .rail-art {
    font-size: 19px;
    line-height: 1;
    display: grid;
    place-items: center;
  }
  .rail-art img {
    width: 20px;
    height: 20px;
    object-fit: contain;
  }
  .rail-word {
    font-size: 0.74rem;
    font-weight: 500;
    letter-spacing: 0.07em;
    white-space: nowrap;
  }

  /* SCROLL-MAP mode (Jon, 2026-08-18): each item sits at the comet-track
     position of its section, so the bead passes an icon exactly while the
     reader is in that section. JS measures + pins; no-JS keeps the flex
     column. The comet spans 18px insets — items map to the same span. */
  .rail[data-mapped] {
    justify-content: flex-start;
  }
  .rail[data-mapped] .rail-item {
    position: absolute;
    left: 50%;
    transform: translate(-50%, -50%);
    top: calc(18px + var(--fy, 0) * (100% - 36px));
  }

  /* the signal mark: a breathing aurora RING around the whole chip + a
     gentle float — quiet, but unmistakably not like the others. It is the
     one lure toward the bottom of the page. */
  .rail-item[data-ethereal] {
    position: relative;
    isolation: isolate;
  }
  .rail-item[data-ethereal]::before {
    content: "";
    position: absolute;
    inset: 1px;
    border-radius: 11px;
    border: 1.5px solid rgba(14, 196, 252, 0.55);
    box-shadow:
      0 0 10px rgba(14, 196, 252, 0.35),
      inset 0 0 8px rgba(14, 196, 252, 0.12);
    pointer-events: none;
    z-index: -1;
  }
  @media (prefers-reduced-motion: no-preference) {
    .rail-item[data-ethereal]::before {
      animation: ea-ring 5.4s ease-in-out infinite;
    }
    @keyframes ea-ring {
      0%, 100% {
        border-color: rgba(14, 196, 252, 0.55);
        box-shadow: 0 0 10px rgba(14, 196, 252, 0.35), inset 0 0 8px rgba(14, 196, 252, 0.12);
      }
      38% {
        border-color: rgba(155, 108, 255, 0.6);
        box-shadow: 0 0 14px rgba(155, 108, 255, 0.45), inset 0 0 9px rgba(155, 108, 255, 0.14);
      }
      70% {
        border-color: rgba(255, 180, 77, 0.55);
        box-shadow: 0 0 12px rgba(255, 180, 77, 0.4), inset 0 0 8px rgba(255, 180, 77, 0.12);
      }
    }
    @keyframes ea-float {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-2.5px); }
    }
  }
  /* the ring stays legible when the item inverts (active) or the site is night */
  .rail-item[data-ethereal][data-on]::before {
    inset: -2px;
    border-radius: 14px;
  }

  /* ── the comet: reading progress riding the rail's right edge ────────── */
  .comet {
    position: absolute;
    top: 18px;
    bottom: 18px;
    right: -7px;
    width: 12px;
    pointer-events: none;
    opacity: 0;
    transition: opacity 400ms ease;
  }
  .comet[data-scrollable] {
    opacity: 1;
  }
  .comet-track,
  .comet-fill {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 2px;
    transform: translateX(-50%);
    border-radius: 2px;
  }
  .comet-track {
    background: rgba(20, 18, 16, 0.1);
  }
  .comet-fill {
    background: linear-gradient(180deg, var(--brand-pink, #ff5c8a) 0%, var(--brand-orange, #ff8a3d) 50%, var(--brand-yellow, #ffc94d) 100%);
    clip-path: inset(0 0 calc((1 - var(--p, 0)) * 100%) 0);
    filter: drop-shadow(0 0 5px color-mix(in srgb, var(--brand-orange, #ff8a3d) 40%, transparent));
  }
  .comet-bead {
    position: absolute;
    left: 50%;
    top: calc(var(--p, 0) * 100%);
    width: 10px;
    height: 10px;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle at 50% 38%, #fff 0%, var(--brand-orange, #ff8a3d) 55%, color-mix(in srgb, var(--brand-orange, #ff8a3d) 55%, #000) 100%);
    box-shadow: 0 0 12px 2px color-mix(in srgb, var(--brand-orange, #ff8a3d) 50%, transparent);
  }
  .comet-bead::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: 50%;
    width: 6px;
    height: 22px;
    transform: translateX(-50%);
    background: linear-gradient(to top, var(--brand-orange, #ff8a3d), transparent);
    border-radius: 6px;
    filter: blur(2px);
  }

  /* ── NIGHT — the instrument's power owns the site's light ────────────── */
  .ground,
  .rail {
    transition: background 560ms ease, border-color 560ms ease;
  }
  :global(html[data-night]) .ground {
    background: #0b0e14;
  }
  :global(html[data-night]) .rail {
    background: #101216;
    border-right-color: rgba(160, 190, 230, 0.12);
  }
  :global(html[data-night]) .rail-item {
    color: #8f98a8;
  }
  :global(html[data-night]) .rail-item[data-on] {
    background: #e8ecf4;
    color: #101216;
  }
  :global(html[data-night]) .comet-track {
    background: rgba(232, 236, 244, 0.12);
  }
  :global(html[data-night]) .floor,
  :global(html[data-night]) .floor a,
  :global(html[data-night]) .floor-city {
    color: #8f98a8;
  }

  /* ── sections ────────────────────────────────────────────────────────── */
  .sheet {
    max-width: 1080px;
    margin: 0 auto clamp(72px, 12vh, 140px);
    padding: clamp(26px, 4vw, 46px);
    border-radius: 8px;
    scroll-margin-top: 76px;
    box-shadow: 0 18px 44px -24px rgba(20, 12, 4, 0.5);
  }
  .paper {
    background: var(--paper);
    border: 1px solid var(--paper-line);
  }
  .night {
    background: var(--night);
    border: 1px solid var(--night-line);
    color: var(--night-ink);
  }
  .sheet h2 {
    margin: 0 0 22px;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-weight: 600;
    font-size: clamp(1.05rem, 1.8vw, 1.3rem);
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  .night h2 {
    color: var(--night-ink);
  }

  .works {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .works li + li {
    border-top: 1px solid var(--paper-line);
