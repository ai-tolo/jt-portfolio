  .lk-title {
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    color: var(--ink);
  }
  /* the dot row sits ABOVE the painted picture, centred (Jon, 2026-09-09:
     the placard goes adjacent to the picture, the dots above it); ink
     through the section-local pair so night flips (.one shadows --ink) */
  .look-band :global(.car-dots) {
    position: absolute;
    max-width: 100%; /* an absolute flex row shrink-wraps its dots and would never let them shrink (15 dots, 2026-09-22) */
    box-sizing: border-box;
    left: 50%;
    top: calc(var(--lk-top) - 8px - 24px);
    transform: translateX(-50%);
    z-index: 2;
    color: var(--kc-ink);
    --car-dot-on: var(--ember); /* the lit dot is the lamp, not ink (Jon) */
  }
  /* thirteen dots and counting: on a phone the row keeps every 24px target
     but closes the gap, and the dots may shrink a little before they ever
     overflow the viewport (Jon, 2026-09-22: van + i c u made thirteen) */
  .look-band :global(.car-dot) {
    flex: 0 1 24px;
    min-width: 20px;
  }
  @media (max-width: 480px) {
    .look-band :global(.car-dots) {
      gap: 2px;
    }
  }
  .lk-meta {
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    color: var(--dim);
  }
  .lk-note {
    font-size: 0.66rem;
    letter-spacing: 0.02em;
    color: var(--dim);
    max-width: 44ch;
    text-wrap: pretty;
  }
  /* the rights line: the placard's quiet voice, once, under the room */

  /* the content column clears the persistent sidebar; below 900px there is
     no sidebar — sheets run full width with gutters */
  @media (min-width: 900px) {
    .one {
      --railw: 148px; /* the rail's width (160 in rounds six and seven, 128 until round six, 110 until the builds were named, 2026-10-13) */
      padding-left: var(--railw);
    }
  }

  /* ── THE LINE (2026-10-22, night): a full viewport like the end room, the sentence alone on the page's center line
     in the end room's title face (Outfit 500) at 40px (28 on phones), 22ch, balanced, the ink. Nothing else: no
     cue, no hairline; the one room gap above and below (.one > .room) */
  .line {
    min-height: 100svh;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 0 24px;
