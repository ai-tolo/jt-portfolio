<script>
  // The sidebar is always present; scroll-spy highlights the section in
  // view (none while the hero owns the viewport). IO-triggered recompute —
  // no rAF, no per-frame scroll work.
  const rail = document.querySelector<HTMLElement>("[data-rail]");
  if (rail) {

    // Scroll-spy: IO events are only the TRIGGER; the active section is
    // recomputed deterministically each time — the lowest section whose top
    // has passed the 35% line, or the last section at hard bottom (short
    // final sheets can never reach the line). No scroll handlers, no rAF.
    const items = new Map(
      Array.from(rail.querySelectorAll<HTMLElement>("[data-for]")).map((el) => [el.dataset.for as string, el])
    );
    const ids = Array.from(items.keys());
    // A nav click LOCKS its target as the active section (the two bottom
    // sections share one max-scroll position, so position alone can't tell
    // them apart); any user-initiated scroll releases the lock.
    let lock: string | null = null;
    const recompute = () => {
      const doc = document.documentElement;
      const atBottom = window.innerHeight + window.scrollY >= doc.scrollHeight - 8;
      let active: string | null = null;
      if (lock) {
        active = lock;
      } else if (atBottom) {
        active = ids[ids.length - 1];
      } else {
        const line = window.innerHeight * 0.35;
        for (const id of ids) {
          const s = document.getElementById(id);
          if (s && s.getBoundingClientRect().top <= line) active = id;
        }
      }
      items.forEach((el, id) => {
        if (id === active) el.setAttribute("data-on", "");
        else el.removeAttribute("data-on");
      });
    };
    document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((a) =>
      a.addEventListener("click", () => {
        const id = (a.getAttribute("href") || "").slice(1);
        if (items.has(id)) {
          lock = id;
          recompute();
        }
      })
    );
    (["wheel", "touchstart", "keydown", "pointerdown"] as const).forEach((evt) =>
      window.addEventListener(evt, () => { lock = null; }, { passive: true })
    );
    const spy = new IntersectionObserver(recompute, { threshold: [0, 0.25, 0.5, 0.75, 1] });
    ids.forEach((id) => {
      const s = document.getElementById(id);
      if (s) spy.observe(s);
    });
    const end = document.querySelector("[data-end]");
    if (end) spy.observe(end);
    // IO crossings can all fire before a smooth scroll settles; recompute
    // once more when scrolling ends (scrollend where supported, else a
    // debounced passive listener — no per-frame work either way).
    if ("onscrollend" in window) {
      window.addEventListener("scrollend", recompute, { passive: true });
    } else {
      let t = 0;
      window.addEventListener(
        "scroll",
        () => {
          window.clearTimeout(t);
          t = window.setTimeout(recompute, 120);
        },
        { passive: true }
      );
    }
    recompute();
  }
</script>
