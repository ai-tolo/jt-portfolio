<script>
  // The sidebar is always present; scroll-spy highlights the section in
  // view (none while the hero owns the viewport). IO-triggered recompute —
  // no rAF, no per-frame scroll work.
  const rail = document.querySelector<HTMLElement>("[data-rail]");
  if (rail) {

    // Scroll-spy: IO events are only the TRIGGER; the active section is
    // recomputed deterministically each time — the lowest section whose top
    // has passed the 35% line, or the last section at hard bottom (short
    // final sheets can never reach the line). No scroll handlers, no rAF.
    const items = new Map(
      Array.from(rail.querySelectorAll<HTMLElement>("[data-for]")).map((el) => [el.dataset.for as string, el])
    );
    const ids = Array.from(items.keys());
    // A nav click LOCKS its target as the active section (the two bottom
    // sections share one max-scroll position, so position alone can't tell
    // them apart); any user-initiated scroll releases the lock.
    let lock: string | null = null;
    const recompute = () => {
      const doc = document.documentElement;
      const atBottom = window.innerHeight + window.scrollY >= doc.scrollHeight - 8;
      let active: string | null = null;
      if (lock) {
        active = lock;
      } else if (atBottom) {
        active = ids[ids.length - 1];
      } else {
        const line = window.innerHeight * 0.35;
        for (const id of ids) {
          const s = document.getElementById(id);
          if (s && s.getBoundingClientRect().top <= line) active = id;
        }
      }
      items.forEach((el, id) => {
        if (id === active) el.setAttribute("data-on", "");
        else el.removeAttribute("data-on");
      });
    };
    document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((a) =>
      a.addEventListener("click", () => {
        const id = (a.getAttribute("href") || "").slice(1);
        if (items.has(id)) {
          lock = id;
          recompute();
        }
      })
    );
    (["wheel", "touchstart", "keydown", "pointerdown"] as const).forEach((evt) =>
      window.addEventListener(evt, () => { lock = null; }, { passive: true })
    );
    const spy = new IntersectionObserver(recompute, { threshold: [0, 0.25, 0.5, 0.75, 1] });
    ids.forEach((id) => {
      const s = document.getElementById(id);
      if (s) spy.observe(s);
    });
    const end = document.querySelector("[data-end]");
    if (end) spy.observe(end);
    // IO crossings can all fire before a smooth scroll settles; recompute
    // once more when scrolling ends (scrollend where supported, else a
    // debounced passive listener — no per-frame work either way).
    if ("onscrollend" in window) {
      window.addEventListener("scrollend", recompute, { passive: true });
    } else {
      let t = 0;
      window.addEventListener(
        "scroll",
        () => {
          window.clearTimeout(t);
          t = window.setTimeout(recompute, 120);
        },
        { passive: true }
      );
    }
    recompute();
  }

  // ── the scroll map: pin each rail item at its section's position along
  // the comet track (measured, not evenly spaced). Re-measured on load and
  // resize — layout reads happen only then, never per-frame.
  if (rail) {
    const mapItems = () => {
      const doc = document.documentElement;
      const span = doc.scrollHeight - window.innerHeight;
      if (span <= 4) return;
      let ok = 0;
      rail.querySelectorAll<HTMLElement>("[data-for]").forEach((el) => {
        const s = document.getElementById(el.dataset.for || "");
        if (!s) return;
        const frac = Math.min(1, Math.max(0, (s.offsetTop - 40) / span));
        el.style.setProperty("--fy", frac.toFixed(4));
        ok++;
      });
      if (ok > 0) rail.setAttribute("data-mapped", "");
    };
    mapItems();
    window.addEventListener("load", mapItems);
    window.addEventListener("resize", () => window.setTimeout(mapItems, 120), { passive: true });
  }

  // ── the comet: reading progress on the rail's right edge. rAF-throttled
  // passive scroll — motion only while scrolling, nothing at rest.
  const comet = document.querySelector<HTMLElement>("[data-comet]");
  if (comet) {
    let ticking = false;
    const measure = () => {
      const doc = document.documentElement;
      const span = doc.scrollHeight - window.innerHeight;
      if (span > 4) comet.setAttribute("data-scrollable", "");
      else comet.removeAttribute("data-scrollable");
      const pv = span > 4 ? Math.min(1, Math.max(0, window.scrollY / span)) : 0;
      comet.style.setProperty("--p", pv.toFixed(4));
    };
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => { ticking = false; measure(); });
    };
    measure();
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll, { passive: true });
    window.addEventListener("load", measure);
  }

  // ── the instrument owns the light. The SignalMachine is SACRED — we only
  // OBSERVE its data-state: boot → the site goes night; powerdown/standby →
  // light returns. Scrolling the instrument out of view powers it off.
  const sgm = document.getElementById("sgm");
  const host = document.querySelector("[data-signal-host]");
  if (sgm && host) {
    const night = (on: boolean) => {
      if (on) document.documentElement.setAttribute("data-night", "");
      else document.documentElement.removeAttribute("data-night");
    };
    const powered = () => {
      const st = sgm.getAttribute("data-state");
      return st === "boot" || st === "on" || st === "live";
    };
    new MutationObserver(() => night(powered())).observe(sgm, {
      attributes: true,
      attributeFilter: ["data-state"],
    });
    // "Scrolled away" = most of the machine has left the viewport (adjacent
    // sections keep a sliver visible, so threshold 0 would never fire).
    new IntersectionObserver(([e]) => {
      if (e.intersectionRatio < 0.35 && powered()) {
        const pwr = document.getElementById("pwr");
        pwr?.click(); // the machine's own powerdown path
        night(false);
      }
    }, { threshold: [0, 0.35] }).observe(host);
  }

  // touch devices: load the /more exhibit into the fallback frame
  if (!window.matchMedia("(pointer: fine)").matches) {
    const f = document.querySelector<HTMLIFrameElement>(".sig-mobile-frame");
    if (f && !f.src) f.src = f.getAttribute("data-src") || "";
  }
</script>
