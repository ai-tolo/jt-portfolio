---
// StudioOne — the one-page skeleton (direction locked with Jon, 2026-08-12).
//
// One page, consistent wood ground. The hero IS the sitemap: autograph,
// one quiet sentence, and the five marks in a small centered row (emoji
// placeholders now — Jon's art lands at public/studio/mark-<id>.webp and
// takes over per mark, same swap-contract pattern as ever). Click = smooth
// anchor scroll. Once the hero row leaves the viewport, the row's five marks
// reappear as a FLOATING PILL (top-center capsule, scroll-spy active state,
// identical on phone). Sound sections are night sheets on the same wood
// (two temperatures, row-local; the page itself never dims).
//
// Supersedes the desk composition (StudioDesk.astro stays in git history;
// /signal, case studies, /resume untouched). Skeleton only: Jon owns the
// section surface treatment after this lands.
import fs from "node:fs";
import path from "node:path";
import soundlab from "./rooms/soundlab-manifest.json";
import illustrations from "./rooms/illustrations-manifest.json";
import type { WorkItem } from "./StudioDesk.astro";

interface Props {
  works: WorkItem[];
}
const { works } = Astro.props;

// The one-liner. Jon rewrites this string at will (his voice: plain,
// human-centered function; explicitly NOT music-dramatic).
const ONE_LINER = "I design tools around how people actually use them.";

const pub = (f: string) => path.join(process.cwd(), "public", "studio", f);
const exists = (f: string) => fs.existsSync(pub(f));
const etchAsset = ["etch.svg", "etch.webp", "etch.png"].filter(exists).map((f) => `/studio/${f}`)[0];

interface Track { src: string; title: string; year?: number; duration?: string; }
const tracks: Track[] = (soundlab as any).tracks ?? [];
interface Illo { src: string; alt: string; title?: string; year?: number; }
const illos: Illo[] = (illustrations as any).items ?? [];

// The five marks (art: public/studio/mark-<id>.webp swap slots; emoji only as
// last-resort fallback). A mark renders ONLY when its room has something in
// it — the nav can never advertise an empty room.
const MARKS = [
  { id: "work", word: "work", emoji: "📁", temp: "warm", has: works.length > 0 },
  { id: "signal", word: "signal", emoji: "🎹", temp: "cool", has: true },
  { id: "soundlab", word: "sound lab", emoji: "🎧", temp: "cool", has: tracks.length > 0 },
  { id: "writing", word: "writing", emoji: "✍️", temp: "warm", has: true },
  { id: "illustrations", word: "illustrations", emoji: "✏️", temp: "warm", has: illos.length > 0 },
].filter((m) => m.has).map((m) => ({
  ...m,
  art: ["webp", "svg", "png"].map((e) => `mark-${m.id}.${e}`).filter(exists).map((f) => `/studio/${f}`)[0],
}));
const SHOW = new Set(MARKS.map((m) => m.id));
---

<a class="skip" href="#work">Skip to the work</a>

{/* The wood: one fixed layer; everything scrolls over it. */}
<div class="ground" aria-hidden="true"></div>

<div class="one" data-one>
  {/* ── HERO — the sitemap ─────────────────────────────────────────────── */}
  <section class="hero" aria-label="Jonathan Tollefson — site index">
    <p class="corner">
      <span class="avail">design engineer · minneapolis, mn · remote-US</span>
      <a href="/resume">résumé</a>
    </p>

    <header class="hero-name">
      {etchAsset ? (
        <>
          <h1 class="sr-only">Jonathan Tollefson</h1>
          <img class="etch-img" src={etchAsset} alt="" draggable="false" />
        </>
      ) : (
        <h1 class="etch-text">Jonathan Tollefson</h1>
      )}
      <p class="liner">{ONE_LINER}</p>
    </header>

    <nav class="marks" data-hero-marks aria-label="Sections">
      {MARKS.map((m) => (
        <a class="mark" href={`#${m.id}`} data-temp={m.temp} aria-label={m.word}>
          <span class="mark-art" aria-hidden="true">
            {m.art ? <img src={m.art} alt="" draggable="false" /> : <span class="mark-emoji">{m.emoji}</span>}
          </span>
          <span class="mark-word">{m.word}</span>
        </a>
      ))}
    </nav>
  </section>

  {/* ── THE SIDEBAR — persistent left column, nav only (Jon, 2026-08-16:
      always present from load; flat light panel; mobile deferred) ───────── */}
  <nav class="rail" data-rail aria-label="Sections">
    {MARKS.map((m) => (
      <a class="rail-item" href={`#${m.id}`} data-for={m.id} data-temp={m.temp} aria-label={m.word}>
        <span class="rail-art" aria-hidden="true">
          {m.art ? <img src={m.art} alt="" draggable="false" /> : m.emoji}
        </span>
        <span class="rail-word">{m.word}</span>
      </a>
    ))}
  </nav>

  {/* ── SECTIONS ───────────────────────────────────────────────────────── */}
  {SHOW.has("work") && <section class="sheet paper" id="work" aria-labelledby="work-t">
    <h2 id="work-t">Work</h2>
    <ul class="covers">
      {works.map((w, i) => (
        <li>
          <a class="cover" href={`/case-studies/${w.slug}`}>
            {w.cover && <img src={w.cover} alt="" loading="lazy" />}
            <span class="cover-name">{w.name}{i === 0 && <em class="flag">flagship</em>}</span>
            <span class="cover-sub">{w.subtitle}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>}

  <section class="sheet night" id="signal" aria-labelledby="signal-t">
    <h2 id="signal-t">Signal</h2>
    <p class="night-line">A playable instrument, built for this site. Press power, type to play.</p>
    <a class="night-cta" href="/signal">open the instrument →</a>
  </section>

  {SHOW.has("soundlab") && <section class="sheet night" id="soundlab" aria-labelledby="soundlab-t">
    <h2 id="soundlab-t">Sound Lab</h2>
    {tracks.length > 0 ? (
      <ol class="tracks">
        {tracks.map((t, i) => (
          <li class="track">
            <span class="tno">{String(i + 1).padStart(2, "0")}</span>
            <span class="tname">{t.title}</span>
            <span class="tmeta">{[t.year, t.duration].filter(Boolean).join(" · ")}</span>
            <audio controls preload="metadata" src={t.src}></audio>
          </li>
        ))}
      </ol>
    ) : (
      <p class="night-line">Finished tracks land here.</p>
    )}
  </section>}

  <section class="sheet paper" id="writing" aria-labelledby="writing-t">
    <h2 id="writing-t">Writing</h2>
    <p class="paper-line">
      Diary of a Soundbender — weekly, on making music with tools you built yourself.
      <a href="https://substack.com/@diaryofasoundbender" target="_blank" rel="noopener noreferrer">read on Substack ↗</a>
    </p>
  </section>

  {SHOW.has("illustrations") && <section class="sheet paper" id="illustrations" aria-labelledby="illustrations-t">
    <h2 id="illustrations-t">Illustrations</h2>
    {illos.length > 0 ? (
      <ul class="illos">
        {illos.map((it) => (
          <li><img src={it.src} alt={it.alt} loading="lazy" />{it.title && <span>{it.title}</span>}</li>
        ))}
      </ul>
    ) : (
      <p class="paper-line">Nothing hung yet.</p>
    )}
  </section>}

  {/* the floor: one quiet line on the wood — reachable, placeable, dated */}
  <footer class="floor">
    <a href="mailto:jtollefson123@gmail.com">jtollefson123@gmail.com</a>
    <span>·</span><span>Minneapolis, MN</span>
    <span>·</span><a href="https://substack.com/@diaryofasoundbender" target="_blank" rel="noopener noreferrer">substack</a>
    <span>·</span><a href="/resume">résumé</a>
  </footer>

  {/* end sentinel: at document bottom the last section takes the active
      state even though it is too short to reach the spy band */}
  <div data-end aria-hidden="true"></div>
</div>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .skip {
    position: fixed;
    left: 20px;
    top: -60px;
    z-index: 90;
    padding: 10px 16px;
    background: #1c160d;
    color: #f5efe2;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.8rem;
    border-radius: 6px;
    transition: top 160ms ease;
  }
  .skip:focus {
    top: 20px;
  }

  /* ── the ground — neutral for now (Jon, 2026-08-16: wood out while the
     skeleton settles; surface treatment comes back later as his call) ──── */
  .ground {
    position: fixed;
    inset: 0;
    z-index: -1;
    background: #e9e8e5;
  }

  .one {
    /* the ground breathes after the last sheet — and the tail gives the final
       sections room to reach the scroll-spy band */
    padding-bottom: clamp(140px, 32vh, 360px);
    --railw: 0px;
    --ink: #141210;
    --dim: #6a5940;
    --paper: rgba(248, 244, 234, 0.96);
    --paper-line: rgba(90, 74, 50, 0.28);
    --night: #0b0e14;
    --night-line: #1c222e;
    --night-ink: #e8ecf4;
    --night-dim: #7d8798;
    --sapphire: #0ec4fc;
    --ember: #ff5432;
    color: var(--ink);
    font-family: "IBM Plex Sans", ui-sans-serif, system-ui, sans-serif;
  }

  /* ── hero ────────────────────────────────────────────────────────────── */
  .hero {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(40px, 7vh, 72px);
    padding: 24px;
    position: relative;
  }
  .corner {
    position: absolute;
    top: 22px;
    right: 26px;
    margin: 0;
    display: flex;
    gap: 20px;
    align-items: baseline;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--dim);
  }
  .avail::before {
    content: "";
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ember);
    margin-right: 7px;
  }
  .corner a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .hero-name {
    text-align: center;
  }
  .etch-text {
    margin: 0;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-weight: 600;
    font-size: clamp(1.3rem, 3vw, 2rem);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .etch-img {
    display: block;
    width: clamp(260px, 30vw, 420px);
    height: auto;
    margin: 0 auto;
  }
  .liner {
    margin: 18px 0 0;
    font-size: clamp(0.95rem, 1.4vw, 1.05rem);
    color: var(--dim);
    max-width: 44ch;
    line-height: 1.5;
  }

  /* the row: five small marks, word under each */
  .marks {
    display: flex;
    gap: clamp(18px, 3.4vw, 44px);
    align-items: flex-start;
  }
  .mark {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--ink);
    transition: transform 200ms cubic-bezier(0.2, 0.7, 0.3, 1);
  }
  .mark-art {
    display: grid;
    place-items: center;
    width: clamp(52px, 6vw, 64px);
    height: clamp(52px, 6vw, 64px);
    border-radius: 14px;
    background: var(--paper);
    border: 1px solid var(--paper-line);
    box-shadow: -3px 5px 10px -4px rgba(22, 13, 4, 0.35);
    transition: transform 200ms cubic-bezier(0.2, 0.7, 0.3, 1), box-shadow 200ms ease;
  }
  .mark[data-temp="cool"] .mark-art {
    background: var(--night);
    border-color: var(--night-line);
  }
  .mark-emoji {
    font-size: clamp(24px, 2.8vw, 30px);
    line-height: 1;
  }
  .mark-art img {
    width: 72%;
    height: 72%;
    object-fit: contain;
  }
  .mark-word {
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    color: var(--dim);
    white-space: nowrap;
  }
  .mark:hover .mark-art,
  .mark:focus-visible .mark-art {
    transform: translateY(-4px);
    box-shadow: -4px 9px 16px -5px rgba(22, 13, 4, 0.4);
  }
  .mark:hover .mark-word,
  .mark:focus-visible .mark-word {
    color: var(--ink);
  }
  .mark:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 6px;
    border-radius: 10px;
  }

  /* ── the sidebar (persistent left column; desktop only) ──────────────── */
  .rail {
    display: none;
  }
  @media (min-width: 900px) {
    .rail {
      display: flex;
    }
  }
  .rail {
    position: fixed;
    left: 0;
    top: 0;
    bottom: 0;
    z-index: 50;
    width: 92px;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    padding: 16px 8px;
    background: #f4f3f0;
    border-right: 1px solid rgba(20, 18, 16, 0.14);
  }
  .rail-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    width: 76px;
    padding: 9px 4px 7px;
    border-radius: 11px;
    text-decoration: none;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    color: #45423c;
    transition: background 160ms ease, color 160ms ease;
  }
  .rail-item:hover {
    background: rgba(20, 18, 16, 0.07);
  }
  .rail-item[data-on] {
    background: var(--ink);
    color: #f5f2ea;
  }
  .rail-item:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }
  .rail-art {
    font-size: 19px;
    line-height: 1;
    display: grid;
    place-items: center;
  }
  .rail-art img {
    width: 20px;
    height: 20px;
    object-fit: contain;
  }
  .rail-word {
    font-size: 0.56rem;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  /* ── sections ────────────────────────────────────────────────────────── */
  .sheet {
    max-width: 1080px;
    margin: 0 auto clamp(40px, 7vh, 80px);
    padding: clamp(26px, 4vw, 46px);
    border-radius: 8px;
    scroll-margin-top: 76px;
    box-shadow: 0 18px 44px -24px rgba(20, 12, 4, 0.5);
  }
  .paper {
    background: var(--paper);
    border: 1px solid var(--paper-line);
  }
  .night {
    background: var(--night);
    border: 1px solid var(--night-line);
    color: var(--night-ink);
  }
  .sheet h2 {
    margin: 0 0 22px;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-weight: 600;
    font-size: clamp(1.05rem, 1.8vw, 1.3rem);
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  .night h2 {
    color: var(--night-ink);
  }

  .covers {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 18px;
  }
  .cover {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .cover img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: 4px;
    border: 1px solid var(--paper-line);
    display: block;
    transition: transform 200ms cubic-bezier(0.2, 0.7, 0.3, 1);
  }
  .cover:hover img,
  .cover:focus-visible img {
    transform: translateY(-3px);
  }
  .cover-name {
    display: block;
    margin-top: 9px;
    font-weight: 600;
    font-size: 0.92rem;
  }
  .flag {
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-style: normal;
    font-size: 0.56rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border: 1px solid var(--paper-line);
    border-radius: 99px;
    padding: 2px 7px;
    margin-left: 8px;
    vertical-align: 2px;
    color: var(--dim);
  }
  .cover-sub {
    display: block;
    margin-top: 3px;
    font-size: 0.8rem;
    color: var(--dim);
  }

  .night-line {
    margin: 0;
    color: var(--night-dim);
    font-size: 0.95rem;
    line-height: 1.55;
  }
  .night-cta {
    display: inline-block;
    margin-top: 18px;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    color: var(--sapphire);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: color-mix(in srgb, var(--sapphire) 45%, transparent);
  }
  .night-cta:hover,
  .night-cta:focus-visible {
    text-decoration-color: var(--sapphire);
  }

  .tracks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .track {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 8px 14px;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
  }
  .tno {
    font-size: 0.7rem;
    color: var(--sapphire);
  }
  .tname {
    font-size: 0.92rem;
    font-weight: 600;
  }
  .tmeta {
    font-size: 0.72rem;
    color: var(--night-dim);
  }
  .track audio {
    grid-column: 1 / -1;
    width: 100%;
    height: 36px;
  }

  .paper-line {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--dim);
  }
  .paper-line a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 4px;
    margin-left: 8px;
  }

  .illos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
    gap: 16px;
  }
  .illos img {
    width: 100%;
    border-radius: 4px;
    border: 1px solid var(--paper-line);
    display: block;
  }

  /* the content column clears the persistent sidebar; below 900px there is
     no sidebar — sheets run full width with gutters */
  @media (min-width: 900px) {
    .one {
      --railw: 92px;
      padding-left: var(--railw);
    }
  }
  @media (min-width: 900px) and (max-width: 1320px) {
    .sheet {
      margin-left: 24px;
      margin-right: 24px;
    }
  }
  @media (max-width: 899px) {
    .sheet {
      margin-left: 14px;
      margin-right: 14px;
    }
  }

  .floor {
    max-width: 1080px;
    margin: 0 auto;
    padding: 4px clamp(26px, 4vw, 46px) 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.74rem;
    letter-spacing: 0.04em;
    color: var(--dim);
  }
  .floor a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  /* smooth anchor travel, motion-gated */
  @media (prefers-reduced-motion: no-preference) {
    :global(html) {
      scroll-behavior: smooth;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pill,
    .mark,
    .mark-art,
    .cover img {
      transition: none;
    }
  }
</style>

<script>
  // The sidebar is always present; scroll-spy highlights the section in
  // view (none while the hero owns the viewport). IO-triggered recompute —
  // no rAF, no per-frame scroll work.
  const rail = document.querySelector<HTMLElement>("[data-rail]");
  if (rail) {

    // Scroll-spy: IO events are only the TRIGGER; the active section is
    // recomputed deterministically each time — the lowest section whose top
    // has passed the 35% line, or the last section at hard bottom (short
    // final sheets can never reach the line). No scroll handlers, no rAF.
    const items = new Map(
      Array.from(rail.querySelectorAll<HTMLElement>("[data-for]")).map((el) => [el.dataset.for as string, el])
    );
    const ids = Array.from(items.keys());
    // A nav click LOCKS its target as the active section (the two bottom
    // sections share one max-scroll position, so position alone can't tell
    // them apart); any user-initiated scroll releases the lock.
    let lock: string | null = null;
    const recompute = () => {
      const doc = document.documentElement;
      const atBottom = window.innerHeight + window.scrollY >= doc.scrollHeight - 8;
      let active: string | null = null;
      if (lock) {
        active = lock;
      } else if (atBottom) {
        active = ids[ids.length - 1];
      } else {
        const line = window.innerHeight * 0.35;
        for (const id of ids) {
          const s = document.getElementById(id);
          if (s && s.getBoundingClientRect().top <= line) active = id;
        }
      }
      items.forEach((el, id) => {
        if (id === active) el.setAttribute("data-on", "");
        else el.removeAttribute("data-on");
      });
    };
    document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((a) =>
      a.addEventListener("click", () => {
        const id = (a.getAttribute("href") || "").slice(1);
        if (items.has(id)) {
          lock = id;
          recompute();
        }
      })
    );
    (["wheel", "touchstart", "keydown", "pointerdown"] as const).forEach((evt) =>
      window.addEventListener(evt, () => { lock = null; }, { passive: true })
    );
    const spy = new IntersectionObserver(recompute, { threshold: [0, 0.25, 0.5, 0.75, 1] });
    ids.forEach((id) => {
      const s = document.getElementById(id);
      if (s) spy.observe(s);
    });
    const end = document.querySelector("[data-end]");
    if (end) spy.observe(end);
    // IO crossings can all fire before a smooth scroll settles; recompute
    // once more when scrolling ends (scrollend where supported, else a
    // debounced passive listener — no per-frame work either way).
    if ("onscrollend" in window) {
      window.addEventListener("scrollend", recompute, { passive: true });
    } else {
      let t = 0;
      window.addEventListener(
        "scroll",
        () => {
          window.clearTimeout(t);
          t = window.setTimeout(recompute, 120);
        },
        { passive: true }
      );
    }
    recompute();
  }
</script>
