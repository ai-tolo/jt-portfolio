---
// StudioOne — the one-page skeleton (direction locked with Jon, 2026-08-12).
//
// One page, consistent wood ground. The hero IS the sitemap: autograph,
// one quiet sentence, and the five marks in a small centered row (emoji
// placeholders now — Jon's art lands at public/studio/mark-<id>.webp and
// takes over per mark, same swap-contract pattern as ever). Click = smooth
// anchor scroll. Once the hero row leaves the viewport, the row's five marks
// reappear as a FLOATING PILL (top-center capsule, scroll-spy active state,
// identical on phone). Sound sections are night sheets on the same wood
// (two temperatures, row-local; the page itself never dims).
//
// Supersedes the desk composition (StudioDesk.astro stays in git history;
// /signal, case studies, /resume untouched). Skeleton only: Jon owns the
// section surface treatment after this lands.
import fs from "node:fs";
import path from "node:path";
import soundlab from "./rooms/soundlab-manifest.json";
import illustrations from "./rooms/illustrations-manifest.json";
import SignalMachine from "../SignalMachine.astro";
import Transport from "../Transport.astro";
import Carousel from "../Carousel.astro";
import { BUILDS } from "./builds-copy";
import IntakeHero from "../IntakeHero.astro";
import ArchiveHero from "../ArchiveHero.astro";
import { WATCH_COPY, ARCHIVE_COPY } from "./objects-copy";
import SiteFloor from "./SiteFloor.astro";

// The one-liner. Jon rewrites this string at will (his voice: plain,
// human-centered function; explicitly NOT music-dramatic).
const ONE_LINER = "I design tools around how people actually use them.";

const pub = (f: string) => path.join(process.cwd(), "public", "studio", f);
const exists = (f: string) => fs.existsSync(pub(f));
const etchAsset = ["etch.svg", "etch.webp", "etch.png"].filter(exists).map((f) => `/studio/${f}`)[0];

interface Track { src: string | null; title: string; note?: string; year?: number; duration?: string; peaks?: string | null; cover?: string | null; tint?: string | null; }
const tracks: Track[] = ((soundlab as any).tracks ?? []).filter((t: Track) => t.src);

// The wallet holds exactly the manifest's tapes in every environment. The
// dev-only dummy-tape fill of 2026-09-10 was removed 2026-09-22 once the real
// tapes landed (Jon: "get rid of the stand in cassettes so it's only the
// selected tracks").

// ── TAPE TINT (2026-09-09, Jon: "the fill should automatically populate
// with different colors, to add identity to each tape"). Every cassette's
// label gets its own colour at build time. IDENTITY = the title: FNV-1a of
// the (NFC, trimmed) title → a hue, +190 so the first tape lands on the
// mock's coral (oklch hue 22 ≈ #ff8888). LEGIBILITY = spacing: all the
// tapes' hues are then relaxed around the colour circle together — sorted
// by hue and pushed apart until neighbours sit ≥ GAP apart, with GAP =
// min(24°, ~(360 − 16) / n) so twelve tapes still get 24° — around two
// kinds of fixed anchor that never move: the ember lamp's hue (33, kept 8°
// clear) and any tape pinned by a manifest `tint` (its hue is read when it
// is an oklch() colour; any other CSS colour is honoured as-is, outside
// the spacing). The relaxation depends only on the SET of titles, so the
// manifest's order is irrelevant, appending a tape moves at most its
// hue-neighbours, and no two tapes can share a colour. One register for
// the shelf: L .76 / C .145 by day (the chroma clips a little on the
// cyan–violet arc in sRGB; accepted, the coral is what is calibrated), the
// same hue at L .66 / C .13 by night for the near-black ground.
const hueOf = (str: string) => {
  let h = 2166136261;
  for (const ch of str.normalize("NFC").trim()) {
    h ^= ch.codePointAt(0)!;
    h = Math.imul(h, 16777619) >>> 0;
  }
  return h % 360;
};
const HUE_SHIFT = 190; // calibrated: "Head to Toe — Side A" → 22, the mock's coral
const EMBER_HUE = 33; // oklch hue of --ember (#ff5432, set on .one below) — move this if --ember ever moves
const EMBER_GAP = 8;
const wrap = (h: number) => ((h % 360) + 360) % 360;
const oklchHue = (css: string) => {
  const m = /^oklch\(\s*[\d.]+%?\s+[\d.]+%?\s+(-?[\d.]+)(deg)?\s*[)/]/i.exec(css.trim());
  return m ? wrap(Number(m[1])) : null;
};
interface HueNode { h: number; fixed: boolean; ember: boolean; i: number }
const GAP = Math.min(24, (0.98 * (360 - 2 * EMBER_GAP)) / Math.max(1, tracks.length)); // 2% slack so a full shelf converges
const hueNodes: HueNode[] = [{ h: EMBER_HUE, fixed: true, ember: true, i: -1 }];
tracks.forEach((t, i) => {
  const pinned = t.tint ? oklchHue(t.tint) : null;
  if (t.tint && pinned === null) return; // an opaque colour: honoured as-is, outside the spacing
  hueNodes.push(
    pinned !== null
      ? { h: pinned, fixed: true, ember: false, i }
      : { h: wrap(hueOf(t.title) + HUE_SHIFT), fixed: false, ember: false, i }
  );
});
const hueNeed = (a: HueNode, b: HueNode) => (a.fixed && b.fixed ? 0 : a.ember || b.ember ? EMBER_GAP : GAP);
for (let pass = 0; pass < 400; pass++) {
  hueNodes.sort((a, b) => a.h - b.h || a.i - b.i);
  let moved = false;
  for (let k = 0; k < hueNodes.length; k++) {
    const a = hueNodes[k];
    const b = hueNodes[(k + 1) % hueNodes.length];
    if (a === b) break;
    const gap = k === hueNodes.length - 1 ? b.h + 360 - a.h : b.h - a.h;
    const short = hueNeed(a, b) - gap;
    if (short <= 0.01) continue;
    moved = true;
    if (!a.fixed && !b.fixed) {
      a.h = wrap(a.h - short / 2);
      b.h = wrap(b.h + short / 2);
    } else if (!a.fixed) a.h = wrap(a.h - short);
    else b.h = wrap(b.h + short);
  }
  if (!moved) break;
}
const tapeTint = (t: Track, i: number): { day: string; night: string } => {
  const node = hueNodes.find((n) => n.i === i);
  if (t.tint && (!node || node.fixed)) return { day: t.tint, night: t.tint };
  const hue = node!.h.toFixed(1);
  return { day: `oklch(0.76 0.145 ${hue})`, night: `oklch(0.66 0.13 ${hue})` };
};
const tapes = tracks.map((t, i) => ({ t, fill: tapeTint(t, i) }));

interface Illo { src: string; alt: string; title?: string; year?: number; medium?: string; note?: string; }
const illos: Illo[] = (illustrations as any).items ?? [];
// The five-row case-study shelf DISSOLVED here 2026-08-31 (direction file:
// homepage = Builds only). Its ledes' disposition: chs / crediverso / raylu
// moved to src/lib/case-links.ts and surface on /resume; momence keeps its
// URL but leaves the site's surfaces; the-console page + doors stay live
// as quarry for the Builds pieces. Story copy = builds-copy.ts (words
// LOCKED 2026-08-31 — Jon-owned, never edit there).
// The writing section left the homepage the same day ("for now" — Jon's
// round-2 call): manifests + /writing/<slug> pages stay live at their URLs.

// The nav (Jon, 2026-09-18): four verbs in page order — play · look ·
// listen · learn — each with its emoji; the builds' mark is a pencil now.
// 2026-09-18 evening (Jon): "learn" is WORK, and it comes first: work · play · look · listen.
// `word: ""` = wordless chip (aria carries the name). A word renders ONLY
// when its room has something in it. Section ids are stable internals
// (work/soundlab/illustrations) so deep links and the spy survive renames.
// The rail reads DOCUMENT order (getDocIds), so this order is also the
// order the rooms sit in below.
// The rail's glyphs (2026-09-21): Lucide paths copied inline (ISC; no icon
// package, no dependency) — hammer for the builds, the keyboard for the
// instrument, an eye, headphones. Desktop rail only; the phone bar stays words.
const ICONS = {
  hammer:
    '<path d="m15 12-9.373 9.373a1 1 0 0 1-3.001-3L12 9"/><path d="m18 15 4-4"/><path d="m21.5 11.5-1.914-1.914A2 2 0 0 1 19 8.172v-.344a2 2 0 0 0-.586-1.414l-1.657-1.657A6 6 0 0 0 12.516 3H9l1.243 1.243A6 6 0 0 1 12 8.485V10l2 2h1.172a2 2 0 0 1 1.414.586L18.5 14.5"/>',
  keys:
    '<rect width="20" height="16" x="2" y="4" rx="2"/><path d="M6 8h4"/><path d="M14 8h.01"/><path d="M18 8h.01"/><path d="M2 12h20"/><path d="M6 12v4"/><path d="M10 12v4"/><path d="M14 12v4"/><path d="M18 12v4"/>',
  eye:
    '<path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"/><circle cx="12" cy="12" r="3"/>',
  headphones:
    '<path d="M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3"/>',
};
const MARKS = [
  // id "play" = the .live-signal HOST (has a box at every width); the
  // machine's own #signal root is display:none on coarse pointers, which
  // made the chip a dead link on phones (review, 2026-08-25)
  { id: "work", word: "work", aria: "work", icon: ICONS.hammer, has: BUILDS.length > 0 },
  { id: "play", word: "play", aria: "play", icon: ICONS.keys, has: true },
  { id: "illustrations", word: "look", aria: "look", icon: ICONS.eye, has: illos.length > 0 },
  { id: "soundlab", word: "listen", aria: "listen", icon: ICONS.headphones, has: tracks.length > 0 },
].filter((m) => m.has);
const SHOW = new Set(MARKS.map((m) => m.id));
// the watch piece's locked words (headline + paragraphs) frame its object
const WATCH = BUILDS.find((b) => b.id === "watch")!;
const ARCHIVE = BUILDS.find((b) => b.id === "archive")!;
---

<a class="skip" href="#work">Skip to the work</a>

{/* The wood: one fixed layer; everything scrolls over it. */}
<div class="ground" aria-hidden="true"></div>

<div class="one" data-one>
  {/* ── HERO — the sitemap ─────────────────────────────────────────────── */}
  <section class="hero" aria-label="Jonathan Tollefson — site index">
    {/* the corner is the résumé alone (Jon, 2026-09-21: the city is gone
        from the top right; the ember bead stays) */}
    <p class="corner">
      <i class="dot" aria-hidden="true"></i>
      <a href="/resume">résumé</a>
    </p>

    <header class="hero-name">
      <div class="etch-slot">
        {etchAsset ? (
          <>
            <h1 class="sr-only">Jonathan Tollefson</h1>
            <img class="etch-img" src={etchAsset} alt="" draggable="false" />
          </>
        ) : (
          <h1 class="etch-text">Jonathan Tollefson</h1>
        )}
        <p class="role-line">design engineer · audio &amp; real-time web</p>
      </div>
      <p class="liner">{ONE_LINER}</p>
    </header>

  </section>

  {/* ── THE SIDEBAR — persistent left column, nav only (Jon, 2026-08-16:
      always present from load; flat light panel; mobile deferred) ───────── */}
  <nav class="rail" data-rail aria-label="Sections">
    {MARKS.map((m) => (
      <a
        class="rail-item"
        href={`#${m.id}`}
        data-for={m.id}
      >
        <span class="rail-word">{m.word}</span>
        <svg class="rail-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
          stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true" focusable="false" set:html={m.icon} />
      </a>
    ))}
    <span class="comet" data-comet aria-hidden="true">
      <i class="comet-track"></i>
      <i class="comet-fill"></i>
      <i class="comet-bead"></i>
    </span>
    <button class="rail-night" type="button" data-night-toggle aria-pressed="false" aria-label="Night mode" data-rail-night>
      <svg class="rn-glyph rn-sun" viewBox="0 0 12 12" fill="none" stroke="currentColor"
        stroke-width="1.3" stroke-linecap="round" aria-hidden="true">
        <circle cx="6" cy="6" r="2.6" />
        <path d="M6 0.6v1.6M6 9.8v1.6M0.6 6h1.6M9.8 6h1.6" />
      </svg>
      <span class="rn-slot" aria-hidden="true"><i class="rn-thumb"></i></span>
      <svg class="rn-glyph rn-moon" viewBox="0 0 12 12" fill="none" stroke="currentColor"
        stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M9.8 7.6A4.4 4.4 0 0 1 4.4 2.2a4.4 4.4 0 1 0 5.4 5.4Z" />
      </svg>
    </button>
  </nav>

  {/* ── the MOBILE bar — the rail's phone form (2026-08-24): the five words
      at the thumb, night switch at the end. Same spy lights both. */}
  <nav class="mbar" data-mbar aria-label="Sections">
    {MARKS.map((m) => (
      <a
        class="mbar-item"
        href={`#${m.id}`}
        data-for={m.id}
      >
        <span class="mbar-word">{m.word}</span>
      </a>
    ))}
    <a class="mbar-item mbar-resume" href="/resume"><span class="mbar-word">résumé</span></a>
    <button class="mbar-night" type="button" data-night-toggle aria-pressed="false" aria-label="Night mode">
      <svg class="mn-moon" viewBox="0 0 12 12" fill="none" stroke="currentColor"
        stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M9.8 7.6A4.4 4.4 0 0 1 4.4 2.2a4.4 4.4 0 1 0 5.4 5.4Z" />
      </svg>
      <svg class="mn-sun" viewBox="0 0 12 12" fill="none" stroke="currentColor"
        stroke-width="1.3" stroke-linecap="round" aria-hidden="true">
        <circle cx="6" cy="6" r="2.6" />
        <path d="M6 0.6v1.6M6 9.8v1.6M0.6 6h1.6M9.8 6h1.6" />
      </svg>
    </button>
  </nav>

  {/* ── SECTIONS ───────────────────────────────────────────────────────── */}
  {/* ── WORK — the story told through OBJECTS (2026-09-18, Jon: the matrix
      is scrapped). Object one: the Intake hero (Jon's Claude Design module,
      IntakeHero.astro + src/data/intake-run.json + public/intake/
      watch-blank.png): the watch mid-recording at the room's left edge;
      tap stop and the real run plays to its right (saved → transcript →
      verdict → ticket → the deck). The story words stay locked in
      builds-copy.ts; where they print under the run is the next round. */}
  {SHOW.has("work") && <section class="work room" id="work" aria-labelledby="work-t">
    <h2 id="work-t" class="sr-only">Work</h2>
    <div class="objects">
      {/* hook (locked) → dek (draft) → the object → caption (draft) → the
          read (locked): the story around the thing, in Jon's voice */}
      <article class="wk" id="build-watch">
        <header class="wk-head">
          <h3 class="wk-hook">{WATCH.headline}</h3>
        </header>
        <IntakeHero class="obj obj-intake" />
        <p class="wk-cap">{WATCH_COPY.caption}</p>
        <div class="wk-read">
          {WATCH.blocks.map((blk) => blk.type === "p" && <p class="wk-p" set:html={blk.html} />)}
        </div>
      </article>
      {/* object two: THE ARCHIVE (Jon's Claude Design module, 2026-09-18) —
          the phone at rest is the stock Voice Memos list; a tap searches
          the real library. The words around it are the locked archive
          piece; the module's own story is off (story={false}) */}
      <article class="wk" id="build-archive">
        <header class="wk-head">
          <h3 class="wk-hook">{ARCHIVE.headline}</h3>
        </header>
        <ArchiveHero story={false} />
        <p class="wk-cap">{ARCHIVE_COPY.caption}</p>
        <div class="wk-read">
          {ARCHIVE.blocks.map((blk) => blk.type === "p" && <p class="wk-p" set:html={blk.html} />)}
        </div>
      </article>
    </div>
  </section>}

  {/* ── SIGNAL — the instrument itself, live, the site's finale.
      Power-on takes the whole site dark; scrolling away powers it off and
      the light returns. The component is SACRED — observed, never edited. */}
  {/* No id here — SignalMachine's own root is <section id="signal">, which
      serves as the anchor + spy target; this host only frames and observes. */}
  <section class="live-signal room" id="play" aria-label="Signal — a playable instrument" data-signal-host>
    <div class="sig-desktop">
      <SignalMachine />
    </div>
    <div class="sig-mobile">
      <p class="sig-mobile-note">a blind listening test, pocket-sized — the instrument itself plays on the desktop site</p>
      <iframe class="sig-mobile-frame" data-src="/more/index.html" title="Interactive audio exhibit" loading="lazy" allow="autoplay"></iframe>
    </div>
  </section>

  {/* the writing section left the homepage 2026-08-31 ("for now" — Jon's
      round-2 call). The tiles, manifests, and /writing/<slug> pages all
      stay in the tree, live at their URLs; only this room is unrouted. */}

  {SHOW.has("illustrations") && <section class="look-band room" id="illustrations" aria-labelledby="illustrations-t">
    <h2 id="illustrations-t" class="sr-only">Look</h2>
    <Carousel count={illos.length} label="Visual work" accent="var(--brand-yellow, #ffc94d)" mode="dissolve" dots loop titles={illos.map((it) => it.title)}>
      {illos.map((it, i) => (
        <figure class="lk">
          <img class="lk-img" src={it.src} alt={it.alt} loading="lazy" />
          {/* the placard: title carries the weight; medium, year, and the
              piece's place in the set share one quiet line beneath it
              (Jon, 2026-08-23 — hierarchy without competing with the art) */}
          <figcaption class="lk-cap">
            <span class="lk-title">{it.title}</span>
            <span class="lk-meta">
              {/* the dots carry the position now (Jon, 2026-09-09) */}
              {[it.medium, it.year].filter(Boolean).join(" · ")}
            </span>
            {/* an optional third line, the piece's own sentence (Jon, 2026-09-22: "i c u") */}
            {it.note && <span class="lk-note">{it.note}</span>}
          </figcaption>
        </figure>
      ))}
    </Carousel>
    {/* the room's one line of chrome: the pictures are his (Jon, 2026-09-22) */}
    <p class="lk-rights">© 2021–2026 Jonathan Tollefson · all rights reserved</p>
  </section>}

  {/* ── AUDIO — THE CASSETTE (2026-09-09: Jon's mock + his blank tape;
      the field recorder's cover window is retired — the cassette IS the
      art object). The placard sits ABOVE — mono title, the note — then
      the tape, centred, its label filled with the tape's own colour (see
      tapeTint), then the seek rule and the recessed counter. No keys: the
      cassette is the play switch — tap it and the hubs turn; prev/next
      keys appear only once there are two tapes. Transport + Carousel
      mechanics are untouched: the tape's button clicks the Transport's
      own (hidden) toggle, and the deck's keys drive the chassis buttons.
      A manifest `cover` now prints ON the label. 2026-09-18 (Jon): the deck
      is EMPTY by default (slide 0, a blank tape); the dropdown is a
      MINIATURE TAPE at the placard's left — press it and the tapes drop
      down under it as a vertical strip of sleeves, a wallet's photo
      insert; hovering a sleeve prints that tape's title and note into the
      placard; pressing one loads it into the deck, where the tape itself
      is the play switch. */}
  {SHOW.has("soundlab") && <section class="room" id="soundlab" aria-labelledby="soundlab-t"><div class="au">
    <h2 id="soundlab-t" class="sr-only">Listen</h2>
    <Carousel count={tracks.length + 1} label="Music" accent="var(--ember)" mode="dissolve">
      {/* slide 0: the EMPTY DECK — the shell with its label unprinted, its
          window dark, hubs still; an empty placard behind a blank mini; a
          dead rail; the tape button inert (Jon, 2026-09-18: blank by default) */}
      <article class="ls ls-blank" data-ls-blank>
        <div class="ls-head" data-ls-placard data-wl>
          <button class="wl-pick" type="button" aria-haspopup="listbox" aria-expanded="false" aria-controls="wl-strip-0" aria-label="Tapes" data-wl-pick>
            <span class="mini" aria-hidden="true">
              <span class="mini-label"></span>
              <img class="mini-shell" src="/studio/tape-shell-800.webp" width="1600" height="979" alt="" loading="eager" decoding="async" />
            </span>
          </button>
          <ul class="wl-strip" id="wl-strip-0" role="listbox" aria-label="Tapes" hidden data-wl-strip>
              {tapes.map(({ t: u, fill: f }, k) => (
                <li class="wl-sleeve" role="option" aria-selected={k + 1 === 0 ? "true" : "false"} tabindex="-1" data-wl-option={String(k)} data-wl-length={u.duration ?? ""}
                  style={`--mini-tint:${f.day};--mini-tint-night:${f.night};--k:${k}`}>
                  <span class="mini" aria-hidden="true">
                    <span class="mini-label">{u.cover && <img src={u.cover} alt="" loading="lazy" decoding="async" />}</span>
                    <img class="mini-shell" src="/studio/tape-shell-800.webp" width="1600" height="979" alt="" loading="lazy" decoding="async" />
                  </span>
                  <span class="sr-only">{u.title}</span>
                </li>
              ))}
          </ul>
          <div class="ls-words">
            <h3 class="ls-title" data-ls-title aria-hidden="true"></h3>
            <p class="ls-note" data-ls-note></p>
          </div>
        </div>
        <button class="cs" type="button" disabled aria-label="Empty deck">
          <span class="cs-label" aria-hidden="true"></span>
          <img class="cs-hub cs-hub-l" src="/studio/tape-hub-l.webp" width="300" height="300" alt="" loading="eager" decoding="async" />
          <img class="cs-hub cs-hub-r" src="/studio/tape-hub-r.webp" width="300" height="300" alt="" loading="eager" decoding="async" />
          <img class="cs-reel cs-reel-l" src="/studio/tape-core-l.webp" width="194" height="194" alt="" loading="eager" decoding="async" />
          <img class="cs-reel cs-reel-r" src="/studio/tape-core-r.webp" width="194" height="194" alt="" loading="eager" decoding="async" />
          <span class="cs-screen" aria-hidden="true"><span class="cs-len" data-cs-len></span></span>
          <img class="cs-shell" src="/studio/tape-shell-800.webp"
            srcset="/studio/tape-shell-800.webp 800w, /studio/tape-shell-1600.webp 1600w"
            sizes="(max-width: 720px) calc(100vw - 28px), 760px"
            width="1600" height="979" alt="" loading="eager" decoding="async" />
        </button>
        <div class="ls-deck ls-deck-dead" aria-hidden="true"><i class="ls-rail"></i></div>
      </article>
      {tapes.map(({ t, fill }, i) => (
        <article class="ls" style={`--cs-tint:${fill.day};--cs-tint-night:${fill.night}`}>
          {/* the placard: the wallet's mini (this tape, small) at the left,
              the title and the note beside it; a sleeve's hover or focus
              previews another tape's words here (data-preview) */}
          <div class="ls-head" data-ls-placard data-wl>
            <button class="wl-pick" type="button" aria-haspopup="listbox" aria-expanded="false" aria-controls={`wl-strip-${i + 1}`} aria-label="Tapes" data-wl-pick
              style={`--mini-tint:${fill.day};--mini-tint-night:${fill.night}`}>
              <span class="mini" aria-hidden="true">
                <span class="mini-label">{t.cover && <img src={t.cover} alt="" loading="lazy" decoding="async" />}</span>
                <img class="mini-shell" src="/studio/tape-shell-800.webp" width="1600" height="979" alt="" loading="lazy" decoding="async" />
              </span>
            </button>
            <ul class="wl-strip" id={`wl-strip-${i + 1}`} role="listbox" aria-label="Tapes" hidden data-wl-strip>
              {tapes.map(({ t: u, fill: f }, k) => (
                <li class="wl-sleeve" role="option" aria-selected={k + 1 === i + 1 ? "true" : "false"} tabindex="-1" data-wl-option={String(k)} data-wl-length={u.duration ?? ""}
                  style={`--mini-tint:${f.day};--mini-tint-night:${f.night};--k:${k}`}>
                  <span class="mini" aria-hidden="true">
                    <span class="mini-label">{u.cover && <img src={u.cover} alt="" loading="lazy" decoding="async" />}</span>
                    <img class="mini-shell" src="/studio/tape-shell-800.webp" width="1600" height="979" alt="" loading="lazy" decoding="async" />
                  </span>
                  <span class="sr-only">{u.title}</span>
                </li>
              ))}
            </ul>
            <div class="ls-words">
              <h3 class="ls-title" data-ls-title>{t.title}</h3>
              <p class="ls-note" data-ls-note>{t.note}</p>
            </div>
          </div>
          <button class="cs" type="button" data-cs-tape aria-label={`Play ${t.title}`}>
            <span class="cs-label" aria-hidden="true">
              {t.cover && <img src={t.cover} alt="" loading="lazy" decoding="async" />}
            </span>
            {/* under the shell's cut-outs: the two hubs (a still base, a turning core) and the display */}
            <img class="cs-hub cs-hub-l" src="/studio/tape-hub-l.webp" width="300" height="300" alt="" loading="lazy" decoding="async" />
            <img class="cs-hub cs-hub-r" src="/studio/tape-hub-r.webp" width="300" height="300" alt="" loading="lazy" decoding="async" />
            <img class="cs-reel cs-reel-l" src="/studio/tape-core-l.webp" width="194" height="194" alt="" loading="lazy" decoding="async" />
            <img class="cs-reel cs-reel-r" src="/studio/tape-core-r.webp" width="194" height="194" alt="" loading="lazy" decoding="async" />
            <span class="cs-screen" aria-hidden="true">
              <svg class="cs-go" viewBox="0 0 32 32"><path d="M9 5.5v21l17.5-10.5z" /></svg>
              <span class="cs-time" data-cs-time></span>
              <span class="cs-len" data-cs-len></span>
            </span>
            <img class="cs-shell" src="/studio/tape-shell-800.webp"
              srcset="/studio/tape-shell-800.webp 800w, /studio/tape-shell-1600.webp 1600w"
              sizes="(max-width: 720px) calc(100vw - 28px), 760px"
              width="1600" height="979" alt="" loading="lazy" decoding="async" />
          </button>
          <div class="ls-deck">
            <Transport src={t.src!} peaks={t.peaks ?? undefined} title={t.title} accent="var(--ember)" compact />
          </div>
        </article>
      ))}
    </Carousel>
  </div></section>}



  {/* the floor: the sitewide object (SiteFloor.astro, email + LinkedIn);
      this page owns only its breathing room above it and its inks */}
  <SiteFloor />

  {/* end sentinel: at document bottom the last section takes the active
      state even though it is too short to reach the spy band */}
  <div data-end aria-hidden="true"></div>
</div>

