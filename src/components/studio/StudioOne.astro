// the sentence printed once in the fold, SHORT since round six (2026-10-22; src/data/intake-run.json → proof, DRAFT)
import WATCH_RUN from "../../data/intake-run.json";
// the memo the two phones search for (src/data/audiodex-scene.json): the tape it became comes out of the phone
import ADX from "../../data/audiodex-scene.json";
import { WATCH_COPY, ARCHIVE_COPY, STUDIO_COPY } from "./objects-copy";
import SiteFloor from "./SiteFloor.astro";
// THE GLOSS (2026-10-23): the niche words on the sheets carry their own line (src/lib/gloss.ts)
import Glossed from "../Glossed.astro";
import type { GlossWord } from "../../lib/gloss";
// THE SHEET (2026-10-13): the anatomy the builds share (src/styles/sheet.css).
// Round two (Jon): no numbers on the sheets; the kind word stands over each name.
import "../../styles/sheet.css";

// the hero liner ("I design tools around how people actually use them.") was DROPPED 2026-10-15 (Jon: "never really liked it")

const pub = (f: string) => path.join(process.cwd(), "public", "studio", f);
const exists = (f: string) => fs.existsSync(pub(f));
const etchAsset = ["etch.svg", "etch.webp", "etch.png"].filter(exists).map((f) => `/studio/${f}`)[0];
// a file under public/ if it is there at build time, else null: a slot whose recording has not landed renders the
// honest empty frame, never a broken video. Dropping the file in and rebuilding is the whole upload.
const inPublic = (url?: string | null) =>
  url && fs.existsSync(path.join(process.cwd(), "public", url.replace(/^\//, ""))) ? url : null;
// THE FLIP CLIP (2026-10-23, the thesis): the Studio sheet's one object, a clip of the show WITH SOUND, played from
// its key only. Jon drops a favorite in at public/builds/studio/flip.mp4 when he has one (no dependency on the show
// being current); until then the slot is the honest empty frame.
const FLIP = inPublic("/builds/studio/flip.mp4");
// THE HIGHLIGHTS' FRAMES (2026-10-23): five of the six moment crops (the engines' is unused: SIGNAL's job), their
// pixels the capture's (2× of a 1106×622 or 760×428 CSS crop)
// THE GLOSS on the rows (2026-10-23): the words each row marks, named here so a rewrite that drops one fails the
// build. The hands row's "take" is the verb ("take it anywhere"), not the take, so it stays plain
const HL_GLOSS: Record<string, { line?: GlossWord[]; caption?: GlossWord[] }> = {
  hands: { caption: ["MIDI"] },
  chips: { line: ["chip"] },
  effects: { line: ["Ableton"] },
  take: { line: ["stems"] },
};
const HIGHLIGHTS = STUDIO_COPY.highlights.map((h) => {
  const wide = ["effects", "hands", "take"].includes(h.frame);
  return { ...h, src: `/builds/studio/moment-${h.frame}.webp`, width: wide ? 2212 : 1520, height: wide ? 1244 : 856, gloss: HL_GLOSS[h.frame] ?? {} };
});

interface Track { src: string | null; title: string; note?: string; year?: number; duration?: string; peaks?: string | null; cover?: string | null; tint?: string | null; }
const tracks: Track[] = ((soundlab as any).tracks ?? []).filter((t: Track) => t.src);

// The wallet holds exactly the manifest's tapes in every environment. The
// dev-only dummy-tape fill of 2026-09-10 was removed 2026-09-22 once the real
// tapes landed (Jon: "get rid of the stand in cassettes so it's only the
// selected tracks").

// ── TAPE TINT (2026-09-09, Jon: "the fill should automatically populate
// with different colors, to add identity to each tape"). Every cassette's
// label gets its own colour at build time. IDENTITY = the title: FNV-1a of
// the (NFC, trimmed) title → a hue, +190 so the first tape lands on the
// mock's coral (oklch hue 22 ≈ #ff8888). LEGIBILITY = spacing: all the
// tapes' hues are then relaxed around the colour circle together — sorted
// by hue and pushed apart until neighbours sit ≥ GAP apart, with GAP =
// min(24°, ~(360 − 16) / n) so twelve tapes still get 24° — around two
// kinds of fixed anchor that never move: the ember lamp's hue (33, kept 8°
// clear) and any tape pinned by a manifest `tint` (its hue is read when it
// is an oklch() colour; any other CSS colour is honoured as-is, outside
// the spacing). The relaxation depends only on the SET of titles, so the
// manifest's order is irrelevant, appending a tape moves at most its
// hue-neighbours, and no two tapes can share a colour. One register for
// the shelf: L .76 / C .145 by day (the chroma clips a little on the
// cyan–violet arc in sRGB; accepted, the coral is what is calibrated), the
// same hue at L .66 / C .13 by night for the near-black ground.
const hueOf = (str: string) => {
  let h = 2166136261;
  for (const ch of str.normalize("NFC").trim()) {
    h ^= ch.codePointAt(0)!;
    h = Math.imul(h, 16777619) >>> 0;
  }
  return h % 360;
};
const HUE_SHIFT = 190; // calibrated: "Head to Toe — Side A" → 22, the mock's coral
const EMBER_HUE = 33; // oklch hue of --ember (#ff5432, set on .one below) — move this if --ember ever moves
const EMBER_GAP = 8;
const wrap = (h: number) => ((h % 360) + 360) % 360;
const oklchHue = (css: string) => {
  const m = /^oklch\(\s*[\d.]+%?\s+[\d.]+%?\s+(-?[\d.]+)(deg)?\s*[)/]/i.exec(css.trim());
  return m ? wrap(Number(m[1])) : null;
};
interface HueNode { h: number; fixed: boolean; ember: boolean; i: number }
const GAP = Math.min(24, (0.98 * (360 - 2 * EMBER_GAP)) / Math.max(1, tracks.length)); // 2% slack so a full shelf converges
const hueNodes: HueNode[] = [{ h: EMBER_HUE, fixed: true, ember: true, i: -1 }];
tracks.forEach((t, i) => {
  const pinned = t.tint ? oklchHue(t.tint) : null;
  if (t.tint && pinned === null) return; // an opaque colour: honoured as-is, outside the spacing
  hueNodes.push(
    pinned !== null
      ? { h: pinned, fixed: true, ember: false, i }
      : { h: wrap(hueOf(t.title) + HUE_SHIFT), fixed: false, ember: false, i }
  );
});
const hueNeed = (a: HueNode, b: HueNode) => (a.fixed && b.fixed ? 0 : a.ember || b.ember ? EMBER_GAP : GAP);
for (let pass = 0; pass < 400; pass++) {
  hueNodes.sort((a, b) => a.h - b.h || a.i - b.i);
  let moved = false;
  for (let k = 0; k < hueNodes.length; k++) {
    const a = hueNodes[k];
    const b = hueNodes[(k + 1) % hueNodes.length];
    if (a === b) break;
    const gap = k === hueNodes.length - 1 ? b.h + 360 - a.h : b.h - a.h;
    const short = hueNeed(a, b) - gap;
    if (short <= 0.01) continue;
    moved = true;
    if (!a.fixed && !b.fixed) {
      a.h = wrap(a.h - short / 2);
      b.h = wrap(b.h + short / 2);
    } else if (!a.fixed) a.h = wrap(a.h - short);
    else b.h = wrap(b.h + short);
  }
  if (!moved) break;
}
const tapeTint = (t: Track, i: number): { day: string; night: string } => {
  const node = hueNodes.find((n) => n.i === i);
  if (t.tint && (!node || node.fixed)) return { day: t.tint, night: t.tint };
  const hue = node!.h.toFixed(1);
  return { day: `oklch(0.76 0.145 ${hue})`, night: `oklch(0.66 0.13 ${hue})` };
};
const tapes = tracks.map((t, i) => ({ t, fill: tapeTint(t, i) }));
// the tape the AudioDex memo became (audiodex-scene.json names it by its manifest title)
const adxTape = tapes.find(({ t }) => t.title === ADX.moment.tape);

interface Illo { src: string; alt: string; title?: string; year?: number; medium?: string; note?: string; }
const illos: Illo[] = (illustrations as any).items ?? [];
// The five-row case-study shelf DISSOLVED here 2026-08-31 (direction file:
// homepage = Builds only). Its ledes' disposition: chs / crediverso / raylu
// moved to src/lib/case-links.ts and surface on /resume; momence keeps its
// URL but leaves the site's surfaces; the-console page + doors stay live
// as quarry for the Builds pieces. Story copy = builds-copy.ts (words
// LOCKED 2026-08-31 — Jon-owned, never edit there).
// The writing section left the homepage the same day ("for now" — Jon's
// round-2 call); 2026-09-22 the posts went to junkyard/ (URLs redirect home).

// The nav (Jon, 2026-09-18): four verbs in page order, work · play · look ·
// listen. 2026-10-13 round one: two labelled groups with numbered builds.
// 2026-10-13 round two (Jon: "the numbering … looks super ugly", "remove the
// eye and headphones"): the rail is WORDS ALONE, one face, one rhythm, one
// right edge: the four builds by name, a short hairline, then the two art
// rooms named for what they hold (illustrations · music; "audio" would
// collide with AudioDex and the role line). No numerals, no group words, no
// glyphs. Section ids are stable internals (work/play/illustrations/soundlab)
// so deep links and the spy survive renames. The rail reads DOCUMENT order
// (getDocIds), and this order is also the order the targets sit in below.
// THE ROOMS: a room renders ONLY when it has something in it (SHOW).
const MARKS = [
  // id "play" = the .live-signal HOST (has a box at every width); the
  // machine's own #signal root is display:none on coarse pointers, which
  // made the chip a dead link on phones (review, 2026-08-25)
  { id: "work", has: BUILDS.length > 0 },
  { id: "play", has: true },
  // the Signal Studio sheet's room (#studio, holding #build-studio), placed
  // after #play and before #illustrations (its section landed 2026-10-13)
  { id: "studio", has: true },
  { id: "illustrations", has: illos.length > 0 },
  { id: "soundlab", has: tracks.length > 0 },
].filter((m) => m.has);
const SHOW = new Set(MARKS.map((m) => m.id));
// THE NAV, generated from the rooms: an entry whose room is absent drops out
// at build time, and the script hides any row whose target is missing from
// the page at runtime (so a nav row is never a dead link). `id` is the spy
// and scroll target (a build's sheet, or a room), `room` the section that
// must render. The rail, the phone bar and the script (through the rendered
// data-for attributes) all read these entries: one list, never two.
type NavEntry = { id: string; room: string; word: string };
type NavBlock = { key: "builds" | "rooms"; entries: NavEntry[] };
const NAV: NavBlock[] = (
  [
    {
      key: "builds",
      entries: [
        { id: "build-watch", room: "work", word: "intake" },
        { id: "build-archive", room: "work", word: "audiodex" },
        { id: "play", room: "play", word: "signal" },
        { id: "build-studio", room: "studio", word: "studio" },
      ],
    },
    {
      key: "rooms",
      entries: [
        { id: "illustrations", room: "illustrations", word: "illustrations" },
        { id: "soundlab", room: "soundlab", word: "music" },
      ],
    },
  ] as NavBlock[]
)
  .map((g) => ({ ...g, entries: g.entries.filter((e) => SHOW.has(e.room)) }))
  .filter((g) => g.entries.length > 0);
// the phone bar cannot hold every build: the builds collapse to ONE word that
// opens the work room (signal never reaches phones: its room is display:none
// there; the studio sheet does, under the same word), the rooms keep theirs
const BAR = NAV.flatMap((g) =>
  g.key === "builds"
    ? SHOW.has("work") ? [{ id: "work", word: "builds", holds: g.entries.map((e) => e.id).join(" ") }] : []
    : g.entries.map((e) => ({ id: e.id, word: e.word, holds: undefined }))
);
// the watch piece's locked words (headline + paragraphs) frame its object
// the Signal Studio sheet carries Jon's LOCKED studio story ("Making music was
// never the hard part.", 2026-08-31): his words, not a draft (2026-10-13; a
// draft piece was written and then withdrawn once his was found)
const STUDIO = BUILDS.find((b) => b.id === "studio")!;
// THE WHOLE STORY is printed on no sheet since 2026-10-22 (Intake round seven, AudioDex THE GROUND, the Studio THE
// CUT): the column splitter and its CSS (.wk-story-body, .wk-p.hinge, .wk-list, .wk-whole-lead) are deleted; the
// locked paragraphs stay in builds-copy.ts
