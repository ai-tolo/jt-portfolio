    top: -60px;
    z-index: 90;
    padding: 10px 16px;
    background: #1c160d;
    color: #f5efe2;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.8rem;
    border-radius: 6px;
    transition: top 160ms ease;
  }
  .skip:focus {
    top: 20px;
  }

  /* ── the ground — neutral for now (Jon, 2026-08-16: wood out while the
     skeleton settles; surface treatment comes back later as his call) ──── */
  .ground {
    position: fixed;
    inset: 0;
    z-index: -1;
    background: #e9e8e5;
  }
  /* the canvas behind the ground must match it, or rubber-band overscroll
     and the mobile bar's padding band show the dark Layout through
     (sibling of Jon's /resume black-band bug, 2026-08-28). Screen-only:
     html[data-night] out-specifies print white-page rules even across
     !important, so night must never reach print. */
  @media screen {
    :global(html),
    :global(body) {
      background: #e9e8e5 !important;
    }
    :global(html[data-night]),
    :global(html[data-night] body) {
      background: #0b0e14 !important;
    }
  }

  .one {
    /* no tail: the page ends on #end, a full viewport (2026-10-13 round six;
       a 28px tail stood under the floor until then) */
    padding-bottom: 0;
    --railw: 0px;
    /* ONE GAP (Jon, 2026-10-13: "across every component of the homepage, the
       spacing should be consistent"): the ground between any two objects on
       the page (hero → sheet, sheet → sheet, room → room, the last room →
       the floor) is this one value. Rooms read it on .one > .room, the
       sheets on .wk + .wk, the floor on its margin; the play room's own
       inner gaps read it too (with this value as their fallback) */
    --room-gap: clamp(124px, 23vh, 258px); /* +15% (Jon, 2026-10-14 round eight; was 108/20vh/224, +12% in round five from 96/18vh/200) */
    /* THE FOOT LINE (round seven): the rail's résumé pill centres this far
       above the screen's foot, the comet's track ends there, and on desks
       the end room's floor row stands on it, so the pill and the floor read
       as one line across the page at its end. One value; they cannot drift */
    --cv-foot: 102px;
    --ink: #141210;
    --dim: #6a5940;
    --paper: rgba(248, 244, 234, 0.96);
    --paper-line: rgba(90, 74, 50, 0.28);
    --night: #0b0e14;
    --night-line: #1c222e;
    --night-ink: #e8ecf4;
    --night-dim: #7d8798;
    --sapphire: #0ec4fc;
    --ember: #ff5432;
    color: var(--ink);
    font-family: "IBM Plex Sans", ui-sans-serif, system-ui, sans-serif;
  }

  /* ── hero ────────────────────────────────────────────────────────────── */
  /* the hero owns the whole first viewport (the round-one peek is gone,
     Jon 2026-10-13: "I don't like that I can see the AudioDex sheet on
     landing"); the cue at its foot is the only "there's more" */
  .hero {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(40px, 7vh, 72px);
    padding: 24px;
    position: relative;
  }
  /* THE NAME IS CENTRED (2026-10-15, Jon: "centered intuitively with the builds arrow, i.e. the centre of the page
     excluding the side nav"): the hero's column is the page right of the rail, the cue hangs on its centre line,
     and the name now stands on the same line, wide and alone; the role line leaves the name and sits just above
     the cue, a shade bolder */
  .hero-name {
    width: 100%;
  }
  .etch-slot {
    text-align: center;
  }
  .etch-text {
    margin: 0;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-weight: 600;
    font-size: clamp(1.3rem, 3vw, 2rem);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  /* THE NAME (2026-10-15): Jon's own hand, cut from a journal page he doodled (IMG_1476, the big one at the foot
     of the page) as black ink on transparency; a high-res scan replaces the file later, same name. Wider than the
     old script, so the clamp grew a step; the role line starts on the J's left edge. */
  .etch-img {
    display: block;
    width: clamp(320px, 46vw, 720px);
    height: auto;
    margin: 0 auto;
  }
  .role-line {
    position: absolute;
    left: 50%;
    bottom: 96px; /* the cue's words end ~57px up; the line stands 40px above them */
    transform: translateX(-50%);
    margin: 0;
    white-space: nowrap;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: color-mix(in oklab, var(--ink) 72%, var(--dim));
  }
  :global(html[data-night]) .role-line {
    color: #aeb7c6;
  }
  /* the cue: one quiet word at the hero's foot, its words 44px above the
     bottom edge (the 12px padding is its hit area; round four, 2026-10-13,
     Jon: "a bit bigger, maybe slightly higher": 0.6875rem → 0.8125rem, the
     arrow scaling with it, 28 → 44px) */
  .cue {
    position: absolute;
    left: 50%;
    bottom: 32px;
    transform: translateX(-50%);
    padding: 12px 10px;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.8125rem;
    line-height: 1;
    letter-spacing: 0.12em;
    text-transform: lowercase;
    white-space: nowrap;
    text-decoration: none;
    color: var(--dim);
    transition: color 160ms ease;
  }
  .cue:hover,
  .cue:focus-visible {
    color: var(--ink);
  }
  /* 2026-10-15 (Jon: "I dislike the moving arrow, and the lack of symmetry"): an arrow on EACH side of the word,
     small and still */
  .cue-arrow {
    display: inline-block;
    margin: 0 0.45em;
    font-size: 1em;
    font-weight: 500;
    line-height: 1;
    vertical-align: 0;
  }
  :global(html[data-night]) .cue {
    color: #7d8798;
  }
  :global(html[data-night]) .cue:hover,
  :global(html[data-night]) .cue:focus-visible {
    color: #e8ecf4;
  }

  /* ── the sidebar (persistent left column; desktop only) ──────────────── */
  .rail {
    display: none;
  }
  @media (min-width: 900px) {
    .rail {
      display: flex;
    }
  }
  .rail {
    position: fixed;
    left: 0;
    top: 0;
    bottom: 0;
    z-index: 50;
    /* 160 since round six (Jon, 2026-10-13: "make the nav bar a bit wider and
       make the words bolder and larger"; 128 since the builds were named);
       the column's --railw follows it. The widest word, "illustrations",
       sits in its 143px row with ~12px either side of it in the lit pill */
    width: 148px; /* round eight: 160 → 148 (~7% smaller, Jon) */
    flex-direction: column;
    justify-content: center;
    /* the foot is the résumé pill's and the light switch's own zone (Jon,
       2026-08-20 / round six): the column centres in the height above them.
       The rows run x 10..153: the comet's bead (x 155..165) stands 2px
       clear of a lit pill */
    padding: 16px 6px 140px 8px;
    /* round eight (Jon: "contrast the rest of the page a bit more … it's the
       outline of the page"): the rail is a lighter paper than the ground
       with a firmer edge, day and night */
    background: #fbfaf7;
    border-right: 1px solid rgba(20, 18, 16, 0.26);
  }
  /* WORDS ALONE (Jon, 2026-10-13, round two): one column, one face, one row
     height, every word ending on one x. Round three (Jon: "too condensed"):
     40px rows, 12px apart in a block; a 28px hairline with 28px above and
     below between the two blocks (was 36 · 4 · 18: a list; now a column) */
  /* round seven (Jon, 2026-10-13: "I'm considering removing the horizontal
     line … keep the vertical spacing it has now, but redistribute"): the
     hairline is gone and the column keeps its height (449: six 48px rows,
     four 20px gaps and the rule's 40 + 1 + 40), now six rows with FIVE equal
     gaps of 32 (448). The blocks part by nothing; the reader figures it out. */
  .rail-col {
    display: flex;
    flex-direction: column;
    gap: 30px;
    width: 134px;
  }
  .rail-list {
    display: flex;
    flex-direction: column;
    gap: 30px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .rail-item {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    box-sizing: border-box;
    width: 134px;
    height: 44px; /* round eight: 48 → 44 (the rail ~7% smaller) */
    padding: 0 11px;
    border-radius: 11px;
    text-decoration: none;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.8125rem;
    color: #26241f; /* round eight: darker ink for contrast (was #45423c) */
    transition: background 160ms ease, color 160ms ease;
  }
  .rail-item:hover {
    background: rgba(20, 18, 16, 0.07);
  }
  .rail-item[data-on] {
    background: var(--ink);
    color: #f5f2ea;
  }
  .rail-item:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }
  .rail-word {
    /* round six (Jon: "bolder and larger"): 0.74rem/500/0.07em → 0.875rem/600/0.06em */
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.06em;
    /* the tracking's trailing space would push every word 0.06em off the
       shared right edge (and unbalance the widest pill): take it back */
    margin-right: -0.06em;
    white-space: nowrap;
  }
  /* the JT mark at the rail's head (2026-10-15): the rail's ink, the
     gradient on hover; absolute so the column and the comet never move */
  .rail-jt {
    position: absolute;
    top: 22px;
    left: 50%;
    transform: translateX(-50%);
    display: inline-flex;
    padding: 8px 10px;
    color: #26241f;
    transition: color 560ms ease;
  }
  .rail-jt svg {
    width: 46px;
    height: auto;
    display: block;
  }
  .rail-jt path {
    fill: currentColor;
  }
  .rail-jt:hover path,
  .rail-jt:focus-visible path {
    fill: url(#railjt-grad);
  }
  .rail-jt:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
    border-radius: 6px;
  }
  :global(html[data-night]) .rail-jt {
    color: #b4bdcb;
  }
  :global(html[data-night]) .rail-jt:focus-visible {
    outline-color: #e8ecf4;
  }
  /* RÉSUMÉ, the rail's one button (Jon, 2026-10-13 round six): an outlined
     pill in the rail's face and size, centred at the foot above the switch;
     the hairline over the switch parts the two. Filled on hover. */
  .rail-cv {
    position: absolute;
    /* its centre on --cv-foot (102 above the screen's foot, as in round six:
       84 + half its 36px box), the line the end room's floor stands on */
    bottom: calc(var(--cv-foot) - 17px);
    /* centred at the rail's foot (round ten: Jon reverted round nine's
       right-aligned rectangle: "I liked everything about the previous
       version more"); the corners halfway between the pill and the rectangle */
    left: 50%;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    box-sizing: border-box;
    height: 34px;
    padding: 0 14px;
    /* round eight (Jon: "orangey red … from our theme"): the ember, solid,
       day and night; the one coloured control on the rail */
    border: 1px solid var(--ember);
    border-radius: 12px;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.06em;
    white-space: nowrap;
    text-decoration: none;
    background: var(--ember);
    color: #fff;
    transition: background 160ms ease, color 160ms ease, border-color 160ms ease, box-shadow 160ms ease;
  }
  .rail-cv-glyph {
    font-size: 0.85em;
    letter-spacing: 0;
  }
  /* hover, and LIT (round seven: the end room is the comet's last target
     and the pill its knot): filled ink on paper */
  .rail-cv:hover {
    background: #e8472a;
    border-color: #e8472a;
  }
  /* LIT (the end room is the comet's last target and the pill its knot): a
     ring of the rail's paper and the ember around the ember pill */
  .rail-cv[data-on] {
    box-shadow: 0 0 0 2px #fbfaf7, 0 0 0 3.5px var(--ember);
  }
  .rail-cv:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }
  :global(html[data-night]) .rail-cv[data-on] {
    box-shadow: 0 0 0 2px #161b24, 0 0 0 3.5px var(--ember);
  }
  :global(html[data-night]) .rail-cv:focus-visible {
    outline-color: #e8ecf4;
  }
  :global(html[data-night]) .rail-item:hover {
    background: rgba(232, 236, 244, 0.07);
  }
  /* the comet's knots sit beside the rows themselves: the script reads each
     row's centre on the track (fyOf), so the bead on a row = that target
     framed. The rows are a plain column; nothing is pinned. */
  /* a build's row frames its SHEET: the sheet's top 24px under the
     viewport's (the rail's targets, not the sheets' own styling) */
  @media (min-width: 900px) {
    #build-archive,
    #build-watch,
    #build-studio {
      scroll-margin-top: 24px;
    }
  }
  /* ── the comet: reading progress riding the rail's right edge ────────── */
  /* the track runs from the hero's knot (its top, p = 0) down to the résumé
     pill's centre (p = 1, the end room's knot): round seven */
  .comet {
    position: absolute;
    /* the FULL rail, edge to edge (round eleven, Jon: "the gradient isn't
       filling to the top and bottom"): the track starts at the screen's top
       and ends at its foot, behind the button and the switch; the knots are
       measured against it (measure(): the rows' and the button's centres as
       fractions of this track), so the last knot sits on the button and the
       fill runs on to the edge at the end */
    top: 0;
    bottom: 0;
    right: -7px;
    width: 12px;
    pointer-events: none;
    opacity: 0;
    transition: opacity 400ms ease;
  }
  .comet[data-scrollable] {
    opacity: 1;
  }
  .comet-track,
  .comet-fill {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 2px;
    transform: translateX(-50%);
    border-radius: 2px;
  }
  .comet-track {
    background: rgba(20, 18, 16, 0.1);
  }
  /* THE END (round ten, Jon: the comet "exists upon loading" at the track's
     top and moves with the scroll from the start; at the end "the full
     length shows the gradient and the comet has shot off the screen"): the
     fill reaches the track's foot (p = 1) and the bead keeps going, down past
     the track and out, fading as it leaves; it returns the moment the page
     scrolls back up. Nothing hides at the top. */
  .comet-bead { transition: opacity 300ms ease; }
  /* the shot is the only time the bead's travel is eased: on the way it must
     track the scroll frame for frame (an eased `top` made it trail) */
  .rail[data-comet="end"] .comet-bead {
    top: calc(100% + 72px);
    opacity: 0;
    transition: top 460ms cubic-bezier(0.4, 0, 0.9, 0.6), opacity 300ms ease 160ms;
  }
  /* at the end the fill runs past the last knot to the track's foot, the
     screen's edge: "the full length shows the gradient" */
  .rail[data-comet="end"] .comet-fill {
    clip-path: inset(0 0 0 0);
    transition: clip-path 460ms cubic-bezier(0.4, 0, 0.9, 0.6);
  }
  @media (prefers-reduced-motion: reduce) {
    .rail[data-comet="end"] .comet-bead,
    .rail[data-comet="end"] .comet-fill { transition: none; }
  }
  .comet-fill {
    background: linear-gradient(180deg, var(--brand-pink, #ff5c8a) 0%, var(--brand-orange, #ff8a3d) 50%, var(--brand-yellow, #ffc94d) 100%);
    clip-path: inset(0 0 calc((1 - var(--p, 0)) * 100%) 0);
    filter: drop-shadow(0 0 5px color-mix(in srgb, var(--brand-orange, #ff8a3d) 40%, transparent));
  }
  .comet-bead {
    position: absolute;
    left: 50%;
    top: calc(var(--p, 0) * 100%);
    width: 10px;
    height: 10px;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle at 50% 38%, #fff 0%, var(--brand-orange, #ff8a3d) 55%, color-mix(in srgb, var(--brand-orange, #ff8a3d) 55%, #000) 100%);
    box-shadow: 0 0 12px 2px color-mix(in srgb, var(--brand-orange, #ff8a3d) 50%, transparent);
  }
  .comet-bead::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: 50%;
    width: 6px;
    height: 22px;
    transform: translateX(-50%);
    background: linear-gradient(to top, var(--brand-orange, #ff8a3d), transparent);
    border-radius: 6px;
    filter: blur(2px);
  }

  /* ── NIGHT — the instrument's power owns the site's light ────────────── */
  .ground,
  .rail {
    transition: background 560ms ease, border-color 560ms ease;
  }
  :global(html[data-night]) .ground {
    background: #0b0e14;
  }
  :global(html[data-night]) .rail {
    background: #161b24; /* round eight: a step lighter than the night ground for contrast */
    border-right-color: rgba(160, 190, 230, 0.22);
  }
  :global(html[data-night]) .rail-item {
    color: #b4bdcb; /* round eight: lighter words for contrast (was #8f98a8) */
  }
  :global(html[data-night]) .rail-item[data-on] {
    background: #e8ecf4;
    color: #101216;
  }
  :global(html[data-night]) .comet-track {
    background: rgba(232, 236, 244, 0.12);
  }
  :global(html[data-night] .floor) {
    --floor-ink: #8f98a8;
    --floor-dim: #8f98a8;
  }
  /* night reaches everything that sits directly on the ground AND the
     paper sheets (Jon, 2026-08-28: no lit paper in a dark room) */
  :global(html[data-night]) .etch-img {
    filter: invert(1);
  }
  :global(html[data-night]) .etch-text {
    color: #e8ecf4;
  }
  :global(html[data-night]) .lk-title {
    color: #cfd6e2;
  }
  :global(html[data-night]) .lk-meta,
  :global(html[data-night]) .lk-note {
    color: #7d8798;
  }
  :global(html[data-night]) .look-band :global(.car-counter) {
    color: #7d8798;
  }
  /* the Visuals keys at night: carbon — the same recipe, the ink now
     light so the steps invert; the contact shadow is the night ground */
  :global(html[data-night]) .look-band {
    --kc-ink: var(--night-ink);
    --kc-face-hi: color-mix(in srgb, var(--kc-ink) 15%, var(--bg));
    --kc-face: color-mix(in srgb, var(--kc-ink) 10%, var(--bg));
    --kc-face-hover-hi: color-mix(in srgb, var(--kc-ink) 22%, var(--bg));
    --kc-face-hover: color-mix(in srgb, var(--kc-ink) 15%, var(--bg));
    --kc-face-down: color-mix(in srgb, var(--kc-ink) 8%, var(--bg));
    --kc-bevel-hi: color-mix(in srgb, var(--kc-ink) 26%, var(--bg));
    --kc-bevel-lo: color-mix(in srgb, var(--kc-ink) 5%, var(--bg));
    --kc-seam: color-mix(in srgb, var(--kc-ink) 30%, transparent);
    --kc-skirt-c: color-mix(in srgb, var(--kc-ink) 6.5%, var(--bg));
    --kc-lip: color-mix(in srgb, var(--kc-ink) 17%, var(--bg));
    --kc-contact: rgb(0 0 0 / 0.7);
    --kc-ghost: color-mix(in srgb, var(--kc-ink) 30%, transparent);
  }
  /* (round 3: the ledger and the recorder carry their own section-local
     ink pairs — --mx-* and --au-* — which are the only night flips they
     need) */

  /* ── the light switch: a brutalist console toggle at the rail's foot
     (Jon, 2026-08-20 — a different KIND of object from the nav chips:
     hard edges, recessed slot, a chunky thumb that SNAPS). The thumb's
     position is the switch's own state; the room's fade is the payoff.
     Quarantined from the words by whitespace and a hairline. */
  .rail-night {
    position: absolute;
    bottom: 16px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 12px 8px;
    border: 0;
    background: transparent;
    cursor: pointer;
    color: #45423c;
  }
  .rail-night::before {
    content: "";
    position: absolute;
    top: -6px;
    left: 50%;
    transform: translateX(-50%);
    width: 26px;
    height: 1px;
    background: rgba(20, 18, 16, 0.22);
  }
  .rn-glyph {
    width: 11px;
    height: 11px;
    flex: none;
    opacity: 0.4;
    transition: opacity 200ms ease, filter 200ms ease;
  }
  .rail-night[aria-pressed="false"] .rn-sun {
    opacity: 1;
  }
  .rail-night[aria-pressed="true"] .rn-moon {
    opacity: 1;
  }
  .rn-slot {
    position: relative;
    width: 46px;
    height: 21px;
    flex: none;
    border: 1px solid rgba(20, 18, 16, 0.55);
    border-radius: 2px;
    background: rgba(20, 18, 16, 0.08);
    box-shadow: inset 0 2px 3px rgba(20, 18, 16, 0.3);
  }
  .rn-thumb {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 19px;
    height: 15px;
    border-radius: 1px;
    background: #141210;
    transition: left 130ms cubic-bezier(0.7, 0, 0.3, 1);
  }
  /* machined grip ridges */
  .rn-thumb::before {
    content: "";
    position: absolute;
    inset: 3px 6px;
    border-left: 1.5px solid rgba(245, 242, 234, 0.4);
    border-right: 1.5px solid rgba(245, 242, 234, 0.4);
  }
  .rail-night[aria-pressed="true"] .rn-thumb {
    left: calc(100% - 21px);
  }
  .rail-night:hover .rn-slot {
    border-color: var(--ink);
  }
  .rail-night:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
    border-radius: 4px;
  }
  @media (prefers-reduced-motion: reduce) {
    .rn-thumb {
      transition: none;
    }
  }
  /* night clothes: the moon runs its lamp; the thumb is the lit part */
  :global(html[data-night]) .rail-night {
    color: #8f98a8;
  }
  :global(html[data-night]) .rail-night::before {
    background: rgba(232, 236, 244, 0.18);
  }
  :global(html[data-night]) .rn-slot {
    border-color: rgba(232, 236, 244, 0.4);
    background: rgba(232, 236, 244, 0.07);
    box-shadow: inset 0 2px 3px rgba(0, 0, 0, 0.5);
  }
  :global(html[data-night]) .rn-thumb {
    background: #e8ecf4;
  }
  :global(html[data-night]) .rn-thumb::before {
    border-left-color: rgba(16, 18, 22, 0.45);
    border-right-color: rgba(16, 18, 22, 0.45);
  }
  :global(html[data-night]) .rail-night[aria-pressed="true"] .rn-moon {
    filter: drop-shadow(0 0 3px rgba(14, 196, 252, 0.9));
    color: #0ec4fc;
  }
  :global(html[data-night]) .rail-night:hover .rn-slot {
    border-color: #e8ecf4;
  }
  :global(html[data-night]) .rail-night:focus-visible {
    outline-color: #e8ecf4;
  }
  /* the rail links need the same night ring: .one shadows --ink with a day
     value, so `outline: 2px solid var(--ink)` is invisible on the night rail */
  :global(html[data-night]) .rail-item:focus-visible {
    outline-color: #e8ecf4;
  }

  /* ── the MOBILE bar (2026-08-24): five words at the thumb + the moon.
     Screen-only; the desktop rail owns >=900px. */
  .mbar {
    display: none;
  }
  @media screen and (max-width: 899px) {
    .mbar {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 60;
      display: flex;
      align-items: stretch;
      gap: 2px;
      padding: 6px 6px calc(6px + env(safe-area-inset-bottom));
      /* one pinned height, shared with the rooms (--mbar-h) so a room's
         foot meets the bar's top exactly — measured 58.8px unpinned */
      box-sizing: border-box;
      height: calc(var(--mbar-h) + env(safe-area-inset-bottom, 0px));
      background: #f4f3f0;
      border-top: 1px solid rgba(20, 18, 16, 0.14);
      transition: background 560ms ease, border-color 560ms ease;
    }
    .mbar-item {
      /* sized by its word, the bar's spare width shared EQUALLY (2026-10-13,
         round two): "illustrations" is twice "music", so equal cells would
         crowd it; equal shares keep the space between every two words even */
      flex: 1 1 auto;
      min-width: 0;
      min-height: 44px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 2px;
      padding: 6px 2px;
      border-radius: 9px;
      text-decoration: none;
      font-family: "IBM Plex Mono", ui-monospace, monospace;
      color: #45423c;
    }
    /* builds · illustrations · music, then résumé and the moon (2026-10-13).
       Round six: résumé wears the rail's pill at the bar's size (the cell
       stays the 44px hit area; the outline is drawn on the word) */
    .mbar-resume {
      order: 7;
      flex: 0 0 auto;
      padding-inline: 4px;
    }
    .mbar-word.mbar-pill {
      display: inline-flex;
      align-items: center;
      gap: 3px;
      margin-right: 0;
      padding: 6px 8px;
      border: 1px solid var(--ember);
      border-radius: 999px;
      line-height: 1;
      background: var(--ember); /* round eight: the ember, like the rail's pill */
      color: #fff;
    }
    .mbar-cv-glyph {
      font-size: 0.9em;
      letter-spacing: 0;
    }
    /* lit at the end (round seven): the PILL fills, not the cell */
    .mbar-item.mbar-resume[data-on] {
      background: transparent;
      color: #45423c;
    }
    .mbar-resume[data-on] .mbar-pill {
      box-shadow: 0 0 0 2px var(--bg, #e9e8e5), 0 0 0 3px var(--ember);
    }
    :global(html[data-night]) .mbar-item.mbar-resume[data-on] {
      background: transparent;
      color: #8f98a8;
    }
    :global(html[data-night]) .mbar-resume[data-on] .mbar-pill {
      box-shadow: 0 0 0 2px #0b0e14, 0 0 0 3px var(--ember);
    }
    .mbar-night {
      order: 8;
    }
    .mbar-item:focus-visible,
    .mbar-night:focus-visible {
      outline: 2px solid var(--ink);
      outline-offset: -2px;
    }
    :global(html[data-night]) .mbar-item:focus-visible,
    :global(html[data-night]) .mbar-night:focus-visible {
      outline-color: #e8ecf4;
    }
    .mbar-word {
      font-size: 0.7rem; /* builds · illustrations · music · résumé (2026-10-13) */
      letter-spacing: 0.05em;
      margin-right: -0.05em; /* the tracking's trailing space, so each word centres */
      white-space: nowrap;
    }
    /* the narrowest phones (320): the words keep their size, the tracking
       gives back a little so the gaps stay comfortable */
    @media (max-width: 359px) {
      .mbar-word {
        letter-spacing: 0.02em;
        margin-right: -0.02em;
      }
    }
    .mbar-item[data-on] {
      background: var(--ink);
      color: #f5f2ea;
    }
    .mbar-night {
      flex: 0 0 46px;
      display: grid;
      place-items: center;
      border: 0;
      border-left: 1px solid rgba(20, 18, 16, 0.14);
      border-radius: 0;
      background: transparent;
      color: #45423c;
      cursor: pointer;
    }
    .mn-moon,
    .mn-sun {
      width: 16px;
      height: 16px;
    }
    .mn-sun {
      display: none;
    }
    :global(html[data-night]) .mn-moon {
      display: none;
    }
    :global(html[data-night]) .mn-sun {
      display: block;
    }
    :global(html[data-night]) .mbar {
      background: #101216;
      border-top-color: rgba(160, 190, 230, 0.12);
    }
    :global(html[data-night]) .mbar-item {
      color: #8f98a8;
    }
    :global(html[data-night]) .mbar-item[data-on] {
      background: #e8ecf4;
      color: #101216;
    }
    :global(html[data-night]) .mbar-night {
      border-left-color: rgba(160, 190, 230, 0.12);
      color: #8f98a8;
    }

    /* the phone page ends where it ends (Jon, 2026-09-21: "you can scroll
       too far", then "the bar still lifts"): iOS ignores overscroll-behavior
       on the root, so under 900px the DOCUMENT is frozen and <main> is the
       scroller — the block lives in src/pages/index.astro. The bar (fixed, a
       descendant of the scroller) stays on the viewport as long as main,
       .one and body never carry a transform / filter / backdrop-filter /
       perspective / contain / will-change. Desks keep the document scroll. */
    /* triage order: the page leads with proof; the exhibit closes the show.
       Visual order only — the spy and the map read layout, not source. */
    .one {
      display: flex;
      flex-direction: column;
      /* the bar's own height and no more: the end room fills the screen
         above it (round six; a 28px tail until then) */
      padding-bottom: calc(var(--mbar-h) + env(safe-area-inset-bottom));
    }
    /* flex items default to min-width:auto — wide children (the machine)
       must scroll inside their own box, never stretch the page */
    .one > * {
      min-width: 0;
      max-width: 100%;
    }
    /* the art sizes to its own aspect on phones — an 88svh letterbox read
       as an empty screen; and the band keeps clearance so an anchored tap
       never parks the placard under the bar (review, 2026-08-25) */
    .lk-img {
      height: auto;
      max-height: 68svh;
    }
    .look-band {
      scroll-margin-bottom: calc(64px + env(safe-area-inset-bottom));
    }
    .one > .hero { order: 0; }
    .one > #line { order: 0; } /* after the hero by document order (2026-10-22) */
    .one > #work { order: 1; }
    /* the Signal Studio sheet shares the work room's slot and follows it by
       document order: after Intake, before illustrations (2026-10-13) */
    .one > #studio { order: 1; }
    .one > .look-band { order: 2; }
    .one > #soundlab { order: 3; }
    .one > .live-signal { order: 5; }
    .one > #end { order: 7; }
    /* the hero is a full 100svh on a phone too, and the pinned bar covers
       its foot: the cue stands 28px above the bar instead (its words 40px;
       round four, 2026-10-13: was 16px) */
    .cue {
      bottom: calc(28px + var(--mbar-h) + env(safe-area-inset-bottom, 0px));
    }
    /* THE HERO ON A PHONE (round 3, 2026-09-22): one left-aligned stack on
       the rooms' 14px gutter — the name, the role line, the liner — so the
       first screen reads on one axis; the role line balances its two lines
       instead of dropping its last word alone */
    .hero {
      padding: 24px 14px;
    }
    .hero-name {
      width: 100%;
    }
    /* the role line keeps its place above the cue, which stands above the bar; it may take two lines */
    .role-line {
      bottom: calc(28px + var(--mbar-h) + env(safe-area-inset-bottom, 0px) + 60px);
      width: calc(100% - 28px);
      white-space: normal;
      text-align: center;
      text-wrap: balance;
      line-height: 1.5;
    }
  }

  /* ── ROOMS: every room is CONTENT-SIZED (Jon, 2026-10-13: "The spacing
     between the cassette tape and the illustrations seems more than every
     other spacing. I asked for the spacings to look and feel consistent.
     Get it done properly"). The 2026-09-02 law (a room is at least one
     viewport tall with its object centred, so no neighbour shows when it
     is framed) is retired for every room: a room is its object's own box,
     and the ground between the ink of one object and the ink of the next is
     --room-gap and nothing else, hero to floor. An anchor still lands a
     room's top at the top of the viewport (scroll-margin 0, also the
     comet's framed knot); the next room may show beneath it. */
  :global(:root) {
    --mbar-h: 60px; /* the phone bar's pinned height; rooms subtract it */
    /* --sheet-pad (a sheet's inner gutter, 56 / 20 under 900) lives in src/styles/sheet.css since 2026-10-13 */
  }
  .room {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    scroll-margin-top: 0;
  }
  /* the ONE gap between rooms (air between the modules since 2026-09-18).
     Declared on the column's child so a room's own margin shorthand (.work,
     .live-signal, .look-band) cannot zero it. No room pads itself to centre
     anything: the sheets' edges are their rooms' edges, the look room keeps
     only the dot row's own reach above the picture (see .look-band), the
     music room's edges are the placard's top and the rail */
  .one > .room {
    margin-top: var(--room-gap);
  }

  /* ── WORK: objects on the room ground (2026-09-18; the nav word was "learn" until that evening). The room's left
     edge = the 1080 column's left edge (flush with the other rooms); the
     watch sits there, sized by the room's height so it reads as one object
     under the lamp, never centred. Nothing here has a background. */
  /* the Signal Studio room (.studio, 2026-10-13) is a work room of one sheet:
     the same inks, faces, scale and column as #work */
  .work,
  .studio {
    --mx-ink: var(--ink);
    --mx-dim: var(--dim);
    /* (the sheets' fill, --wk-card, is --sheet-card in src/styles/sheet.css since 2026-10-13) */
    /* one type system for the room = the modules' own three faces
       (presentation pass, 2026-09-21): Instrument Sans body, JetBrains Mono
       labels + captions, Outfit display. No fourth face here. */
    --wk-sans: "Instrument Sans", "Helvetica Neue", Arial, sans-serif;
    --wk-mono: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    --wk-display: "Outfit", var(--wk-sans);
    --wk-measure: 36rem; /* ~64ch of the body face: the 60–70ch measure */
    /* the spacing scale (4/8 base): every gap in the room is one of these */
    --sp-3: 12px;
    --sp-4: 16px;
    --sp-6: 24px;
    --sp-8: 32px;
    --sp-12: 48px;
    /* the phone's width as the host sizes it (38cqw of the module, height-capped):
       the stage's cap AND the Archive title's right edge read the same number */
    max-width: none;
    /* the room is CENTRED in the column beside the rail — the same gutter both
       sides — so the modules' centre line (where both objects' dots stand,
       Jon 2026-09-22) is the centre of the viewport less the rail */
    /* min gutter 20 since round six (24 until then): the 160px rail leaves a
       1120 column at 1280, where the 1080 sheets keep their width */
    margin: 0 max(20px, calc((100% - 1080px) / 2));
    padding-inline: 0;
    color: var(--mx-ink);
    font-family: var(--wk-sans);
  }
  :global(html[data-night]) .work,
  :global(html[data-night]) .studio {
    --mx-ink: var(--night-ink);
    --mx-dim: var(--night-dim);
  }
  .objects {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
  }
  /* the same air between two objects as between two rooms (.one > .room) */
  /* two sheets, one stack (2026-10-10: the sheets carry their own edges,
     so the ground between them only has to part them) */
  .wk + .wk {
    margin-top: var(--room-gap); /* 48–80 until 2026-10-13 (Jon: "a bit more") */
  }
  /* one frame for every object: hook → dek → the object → caption → the
     read, on one rhythm (hook→dek 12 · dek→object 32 · object→caption 24 ·
     caption→read 48 · ¶ 16); the words sit on the room's ink pair so night
     flips them */
  /* THE SHEET (2026-10-10): the build's whole surface — band, object, run,
     caption and the fold — in the material the story card had (the card's
     white, its hairline, its 28px corner), so one build reads as one thing.
     2026-10-13 (ONE ANATOMY): the material (fill, hairline, corner, inks,
     night, the container), the readout line, the hood's section, label and
     steps are `.sheet` in src/styles/sheet.css, shared with SIGNAL's card;
     here stays what is the work sheets' own: the gutter with the handle as
     its foot, and each build's one hue */
  .wk {
    padding: var(--sheet-pad) var(--sheet-pad) 0;
  }
  #build-watch { --sheet-acc: #ff6b4a; } /* the watch's red (the hinge line's) */
  #build-archive { --sheet-acc: #b9701a; } /* the phone's amber (its rail) */
  /* THE BAND (2026-10-10): the build's name, then one line saying what it
     is — the same over both sheets, CENTRED on the sheet's centre line (Jon:
     "signal is centered, the others are to the left"), the axis the run's
     dots already stand on (Jon, 2026-09-22) */
  .band {
    --bd-ink: var(--ink);
    --bd-dim: var(--dim);
    margin: 0 0 56px; /* the title block → the object */
    text-align: center;
  }
  :global(html[data-night]) .band {
    --bd-ink: var(--night-ink);
    --bd-dim: var(--night-dim);
  }
  /* the build's name carries the sheet (Jon, 2026-10-10: "not big enough") */
  .band-name {
    margin: 0;
    font: 500 3.25rem/1.05 "Outfit", "Instrument Sans", "Helvetica Neue", sans-serif;
    letter-spacing: -0.02em;
    color: var(--bd-ink);
    transition: color 560ms ease;
  }
  .band-what {
    margin: 14px auto 0;
    max-width: 34rem;
    font: 400 1.125rem/1.5 "Instrument Sans", "Helvetica Neue", Arial, sans-serif;
    color: color-mix(in oklab, var(--bd-ink) 72%, transparent);
    text-wrap: balance;
    transition: color 560ms ease;
  }
  @media (max-width: 899px) {
    .band { margin-bottom: 20px; } /* was 36: the kind word over the name takes the other 16 (2026-10-13) */
    .band-name { font-size: 2.5rem; }
    .band-what { margin-top: 10px; font-size: 1rem; }
  }
  /* the locked hook opens the story (2026-10-10: the band names the build
     above the object; the hook is the first thing the fold says). Since
     2026-10-13 (Jon: "I'd rather the subtitle be visible … with the arrow
     allowing the expansion") it stands OUTSIDE the clip: always read, the
     chevron under it, the story beneath folded to nothing. Fold top 48
     (32 on a narrow sheet); 12 to the handle, whose own 18px of air above
     the chevron finishes the gap */
  .wk-lede {
    max-width: 30ch;
    margin: var(--sp-8) auto var(--sp-3);
    text-align: center;
    font-family: var(--wk-display);
    font-size: 1.75rem;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.01em;
    text-wrap: balance;
    color: var(--mx-ink);
    transition: color 560ms ease;
  }
  /* the mono caption: small, lightly tracked, clearly under the body */
  .wk-cap {
    margin: 0; /* seated at the run's foot by the module's own column gap */
    padding-left: 32px; /* on the run's text axis, with the rail's words (Jon, 2026-09-24) */
    max-width: var(--wk-measure);
    font-family: var(--wk-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    line-height: 1.5;
    color: var(--mx-ink);
    /* the caption is CONTEXT for the object, not the object (Jon,
       2026-09-24). Since 2026-10-13 (Jon: "the 'A real memo, 3:52…'
       shouldn't be visible at default state") the two builds' captions are
       HIDDEN AT REST and arrive with the object's COMMIT — the watch's
       "Saved", the phone's "Kept" — in that signal's colour, then settle
       back to ink over three seconds (it showed at rest 2026-10-06..13) */
    --cap-signal: var(--mx-ink);
    transition: color 560ms ease;
  }
  /* the watch: the face goes green once the last card has landed (its s6) —
     the caption appears in that green as the green happens, and settles to
     ink over the beat the face's line takes to retract (1.6s from +0.4s) */
  /* the beat: appear in the signal's colour (0.4s), hold it while the
     object breathes (to 1.4s), then settle to ink over the line's retraction
     (to 3.5s). The phone's caption waits until the phone is fully still —
     its second half has landed — before it arrives. */
  /* (the watch's caption is gone since round five of the catch-all, 2026-10-22: the watch's one line at rest is
     IntakeHero's hint) */
  /* at rest (and while a run plays) the builds' captions hold their place unseen, so nothing beneath moves when
     they arrive; the Studio sheet's caption is not a run's and always shows */
  /* 2026-10-19, late (the watch is a record button): the caption always stands; the watch hides it only under its
     own typed field (IntakeHero's .under). The arrival below is the phones' and has no watch rule left */
  /* arrive (fade in over the first beat) in the signal's colour, hold it, settle to ink */
  @keyframes wk-cap-in {
    0% { opacity: 0; color: var(--cap-signal); }
    12% { opacity: 1; }
    34% { color: var(--cap-signal); }
    100% { opacity: 1; color: var(--mx-ink); }
  }
  @media (prefers-reduced-motion: reduce) {
    .wk-cap { transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .wk-cap {
      transition: color 560ms ease;
    }
  }
  /* ── THE STORY: a card under the object (Jon's mockup, 2026-09-24).
     Closed (2026-10-13), the fold shows only the hook; the story and under
     the hood are folded to nothing (height 0, no fade) and only the handle
     opens them: nothing opens by itself any more. Two columns on desks, one
     on phones; one type system with the room. */
  /* UNDER THE HOOD (2026-09-30, Jon: one expandable box): the system's
     stages INSIDE the story's card, under the story — a spine of steps in
     the object's ink (the phone's rail, in the page), the tool beside each
     stage, one sentence each. Two columns with the story's break.
     2026-10-13: its section, label, columns and steps are the shared sheet's
     (.sheet-sec · .sheet-t · .sheet-cols · .sheet-step*, src/styles/sheet.css),
     the same parts SIGNAL's card uses; the hue is each sheet's --sheet-acc. */
  /* the fold: the sheet's lower part, under one hairline that runs edge to
     edge of the sheet (the sections' 12 %); the sheet's own lower edge is
     the handle */
  .wk-story {
    position: relative;
    margin: 56px calc(-1 * var(--sheet-pad)) 0; /* the object → the fold, as the title → the object */
    padding: 0 var(--sheet-pad);
    border-top: 1px solid color-mix(in oklab, var(--sheet-ink) 12%, transparent);
    transition: border-color 560ms ease;
  }
  /* closed = 0 tall (in CSS, so the first paint never shows the story);
     open = auto. The fold script only drives the height between the two */
  .wk-story-clip {
    height: 0;
    overflow: hidden;
    transition: height 0.55s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .wk-story[data-open] .wk-story-clip {
    height: auto;
  }
  /* ONE RHYTHM IN EVERY FOLD (2026-10-19, Jon: "I need cohesion across the
     modules"): hook → said → [the evidence] → the floor line → the whole
     story, the same numbers on all three sheets, set HERE and never per
     sheet. The said line stands 12 over the chevron's handle while closed;
     the clip's first block stands 24 under it (32 on a wide sheet), so
     open the said line → the evidence is 36 / 44 as before. Every hairline
     inside the fold stands the same 24 / 32 under the block above it (a
     section's own bottom padding steps aside); the floor line stands 36
     under its evidence. */
  .wk-story-clip > :first-child { margin-top: var(--sp-6); }
  .wk-story-clip > .sheet-sec { margin-top: var(--sp-6); }
  .wk-story-clip > .sheet-sec:not(:last-child) { padding-bottom: 0; }
  /* the Intake fold (round five, 2026-10-22): the wedding sentence is the clip's first block; the figures stand the
     same distance under it. The Studio's since THE CUT (2026-10-22): one rule for every sheet that folds */
  .wk-story-clip > .wk-said { margin: var(--sp-6) auto var(--sp-6); }
  @container (min-width: 820px) {
    .wk-lede {
      margin-top: var(--sp-12);
    }
    .wk-story-clip > :first-child,
    .wk-story-clip > .sheet-sec { margin-top: var(--sp-8); }
    .wk-story-clip > .wk-said { margin-top: var(--sp-8); margin-bottom: var(--sp-8); }
  }
  /* ── THE WEDDING FOLD (2026-10-15): the sentence once, then the same sentence to two machines. The sentence is set
     in the hook's face a step smaller, centred, with its quote marks hung; the two sides are figures on the sheet,
     label above, the phone crops with a hairline and the sheet's corner radius, a one-line note beneath in the mono
     caption face. Side by side on a wide sheet, stacked under 820. */
  .wk-said {
    position: relative;
    max-width: 44ch;
    margin: 28px auto var(--sp-3); /* 12 over the handle; the clip's first block keeps the open distance (above) */
    text-align: center;
    font-family: var(--wk-display);
    font-size: 1.25rem;
    font-weight: 400;
    line-height: 1.35;
    letter-spacing: -0.005em;
    text-wrap: pretty;
    color: var(--mx-ink);
    transition: color 560ms ease;
  }
  .wk-said-q { color: var(--sheet-acc); font-weight: 500; }
  /* round six (2026-10-22): the two drawn answers (IntakeProof) stand the clip's block distance under the sentence
     (the `0:31 · from the wrist` fact of round six left in round seven). The screenshot figures (.vs) are gone */
  /* THE FLOOR LINE: the last line before the whole story on all three
     sheets (Intake's one-match rule, AudioDex's floor, the Studio's keep
     line since 2026-10-19) */
  .wk-rule {
    max-width: 62ch;
    margin: 36px auto 0;
    text-align: center;
    font-size: 0.9375rem;
    line-height: 1.6;
    text-wrap: pretty;
    color: var(--mx-ink);
    transition: color 560ms ease;
  }
  @container (min-width: 820px) {
    .wk-said { font-size: 1.5rem; margin-top: 36px; }
    .wk-rule { font-size: 1rem; }
  }
  /* THE GROUND'S FLOOR LINE (2026-10-22): the sheet ends on one line, .wk-rule's size, centred, the object → it 56
     (the object → the fold it replaces), the sheet's own pad beneath (the work sheets' bottom is their handle; this
     one has none). Since 2026-10-22, night the two names are plain words in the line's own face (the links, their
     label face, amber and underline are gone) */
  #build-archive { padding-bottom: var(--sheet-pad); }
  .adx-floor {
    max-width: 62ch;
    margin: 56px auto 0;
    text-align: center;
    font-size: 0.9375rem;
    line-height: 1.6;
    text-wrap: balance;
    color: var(--mx-ink);
    transition: color 560ms ease;
  }
  @container (min-width: 820px) {
    .adx-floor { font-size: 1rem; }
  }
  /* THE TAPE out of the AudioDex phone: the wallet's mini at the slot's width, the touch signal's breath around it
     (the site's "press me": the phones' rim, the same keyframe), and one line in the hint face under it */
  .adx-tape {
    --mini-w: 100%;
    display: grid; justify-items: center; gap: 10px; width: 100%;
    margin: 0; padding: 0; border: 0; background: none; cursor: pointer;
    color: color-mix(in oklab, var(--sheet-acc) 85%, var(--mx-ink));
    -webkit-tap-highlight-color: transparent;
  }
  .adx-tape .mini {
    box-shadow: 0 10px 22px rgba(20, 16, 10, 0.28), 0 2px 5px rgba(20, 16, 10, 0.2);
    transition: transform 220ms ease, box-shadow 220ms ease;
  }
  .adx-tape .mini::after {
    content: ""; position: absolute; inset: 0; border-radius: inherit; padding: 2px; pointer-events: none;
    background: linear-gradient(135deg, #47b6ff, #8a5cf6);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor;
    mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); mask-composite: exclude;
    animation: touch-breathe 2s ease-in-out infinite;
  }
  .adx-tape:hover .mini { transform: translateY(-4px); box-shadow: 0 16px 28px rgba(20, 16, 10, 0.3), 0 3px 6px rgba(20, 16, 10, 0.2); }
  .adx-tape:hover .mini::after { animation: none; opacity: 1; }
  .adx-tape:focus-visible { outline: none; }
  .adx-tape:focus-visible .mini { outline: 2px solid var(--mx-ink); outline-offset: 3px; }
  /* beside the phone the words hang from the tape's right edge, clear of the phone; under it (stacked) centred */
  .adx-tape { justify-items: end; }
  /* beside the phone: two short lines under the tape's visible half, so no word hides behind the phone */
  .adx-tape-w { margin-right: -6px; text-align: right; font: 600 0.75rem/1.35 var(--wk-mono); letter-spacing: 0.04em; white-space: nowrap; transition: color 560ms ease; }
  .adx-tape-w > span { display: block; }
  @container adx (min-width: 620px) and (max-width: 860px) { .adx-tape-w { font-size: 0.625rem; margin-right: -2px; } }
  @container adx (max-width: 619px) {
    .adx-tape { justify-items: center; }
    .adx-tape-w { margin-right: 0; text-align: center; font-size: 0.8125rem; letter-spacing: 0.06em; }
    .adx-tape-w > span { display: inline; }
  }
  .adx-tape-arrow { display: inline-block; animation: adx-bob 2.2s ease-in-out infinite; }
  @keyframes adx-bob { 0%, 100% { transform: none; } 50% { transform: translateY(3px); } }
  @media (prefers-reduced-motion: reduce) {
    .adx-tape .mini::after { animation: none; opacity: 0.75; }
    .adx-tape-arrow { animation: none; }
  }
  /* the handle: the card's whole lower edge; the chevron breathes while the
     story is folded (the touch signal's vocabulary) and turns when it opens */
  .wk-more {
    display: flex;
    align-items: center;
    justify-content: center;
    width: calc(100% + 2 * var(--sheet-pad));
    height: 56px;
    margin: 0 calc(-1 * var(--sheet-pad));
    padding: 0;
    border: 0;
    border-radius: 0 0 28px 28px;
    background: transparent;
    color: var(--mx-dim);
    cursor: pointer;
    transition: color 0.3s;
  }
  .wk-more:hover { color: var(--mx-ink); }
  .wk-more:focus-visible { outline: 2px solid var(--mx-ink); outline-offset: -6px; }
  .wk-chev {
    width: 20px;
    height: 20px;
    transition: transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1);
    animation: wk-breathe 2s ease-in-out infinite;
  }
  .wk-story[data-open] .wk-chev { transform: rotate(180deg); animation: none; }
  .wk-more:hover .wk-chev { animation: none; }
  @keyframes wk-breathe { 0%, 100% { opacity: 0.45; } 50% { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) {
    .wk-story-clip { transition: none; }
    .wk-chev { animation: none; }
  }
  /* host fit only (the module's own language is Jon's): each module is the
     1080 column wide and sizes its object in cqw of itself; the room's
     height caps BOTH devices the same way (76svh) so the two stand the same
     height under the lamp on laptop screens. The 820px collapse, the 70%
     watch and the 80% phone live in the modules (container queries) */
  .work :global(.obj-intake),
  .work :global(.adx) {
    width: min(100%, 1080px);
  }
  /* the catch-all → the watch (2026-10-19, round two): 56 of air above the hairline and 56 under it on desks (the
     sheet's object rhythm, band → object 56), 40 / 40 on phones; the section ends at the watch's caption, the fold's
     own top follows. The catch-all's three columns (2026-10-21, intake-v4): the phone 32cqw of the sheet, 70svh tall
     at most (at 1440 × 900 its 630 is the row: Intake's six reserved cards stand in it and the three feet align;
     a shorter screen lets the row grow to the list and the phone stand shorter); Intake's cards in the phone's twin
     outline (round two, 2026-10-21: the module sizes it from --ica-w); the month takes the rest; 24px gutters (the
     photographed body's buttons overlapped at 20) */
  .work :global(.ica) { margin-bottom: 56px; --ica-w: min(32cqw, calc(70svh * 864 / 1760)); --ica-gap: 24px; }
  .wk-watch-sec { padding: 56px 0 0; }
  @media (max-width: 899px) {
    .work :global(.ica) { margin-bottom: 40px; }
    .wk-watch-sec { padding-top: 40px; }
  }
  /* AudioDex's two phones (2026-10-15, round two): each the old phone's height cap less a step (two objects share
     the screen now), never wider than a third of the sheet; stacked on a narrow sheet the module sizes them itself */
  .work :global(.adx) { --adx-w: min(34cqw, calc(66svh * 864 / 1760)); }
  .work :global(.obj-intake .watch-col) {
    max-width: calc(68.4svh * 383 / 653); /* the VISIBLE watch's ratio (the PNG's frame is trimmed in the module); 0.9 × the phone's 76svh (Jon, 2026-09-22: ten percent smaller) */
  }
  /* smaller on desks: 90% of its 44cqw column (Jon, 2026-09-22), then a
     quarter smaller again (Jon, 2026-10-07: "a bit too in your face, the
     screen is totally full") = 67.5%, its height cap 51.3svh (was 68.4); the
     column itself stays, so the run's nodes keep the centre line. The phone
     below took a cut too (63svh), and the stacked 70cqw watch is
     untouched. The OBJECTS got smaller, never the words (Jon, the same
     day: "the cards and stuff on the side look too small"): the run beside
     the watch is full size, and the words ON the face, which are cqw of the
     screen and shrank with it, are set back up here; "Cinder 32 · 3:52"
     (the memo's name on the saved face) the most, and bolder.
     Never `zoom` or scale the run: zoomed, its reserve re-rounded every frame
     and walked the whole page a pixel up and down. */
  @container hero (min-width: 820px) {
    .work :global(.obj-intake .watch-col) {
      width: 67.5%;
      max-width: calc(51.3svh * 383 / 653);
      margin-inline: auto; /* centred in its column, as the phone (2026-10-10) */
    }
    /* (the face's words are sized in the module since 2026-10-19, late: the record ring's face floors its own type) */
  }
  @media (max-width: 899px) {
    .work,
    .studio {
      margin-left: 14px; /* = the room's phone gutter, both sides */
      margin-right: 0; /* the desk's centring margin steps aside; the padding is the gutter */
      padding-right: 14px;
    }
  }
  @media (max-width: 720px) {
    .wk-lede {
      font-size: 1.5rem;
    }
  }

  /* ── SIGNAL STUDIO's sheet (2026-10-13): what is its own; the rest is the
     work sheets' (.wk, .band, .wk-cap, the fold) and the shared .sheet.
     Its hue: a deeper sapphire than SIGNAL's #4fd1ff, the same family, one
     step toward ink, so the instrument and the studio read as kin and apart */
  #build-studio { --sheet-acc: #2a5bd7; }
  /* THE CLIP'S SLOT (2026-10-13; the chassis, the six moments and the circumstances' row are in junkyard/ since the
     thesis, 2026-10-23, so these rules are the sheet's own again, not :global) */
  .st-slot {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    margin: 0;
  }
  .st-frame {
    box-sizing: border-box;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    display: grid;
    place-items: center;
  }
  .st-video {
    grid-area: 1 / 1;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: #0b0c10;
  }
  /* a frame with its file: the sheet's inner corner, a hairline; the key sits on the picture */
  .st-slot:not([data-pending]) .st-frame {
    border-radius: 14px;
    border: 1px solid color-mix(in oklab, var(--sheet-ink) 14%, transparent);
    background: #0b0c10;
  }
  /* THE PLAY KEY: a 64px ring on the frame's centre, the play mark inside; on the dark picture it is white, on the
     honest empty frame it is the dim ink at a third, inert. Playing, the mark becomes the stop bars and the key
     stands back (a press on it pauses). */
  .st-play {
    grid-area: 1 / 1;
    z-index: 1;
    width: 64px;
    height: 64px;
    margin: 0;
    padding: 0;
    display: grid;
    place-items: center;
    border: 1.5px solid currentColor;
    border-radius: 50%;
    background: color-mix(in oklab, #0b0c10 55%, transparent);
    color: #fff;
    cursor: pointer;
    appearance: none;
    transition: opacity 260ms ease, color 560ms ease, transform 120ms ease;
  }
  .st-play svg { width: 28px; height: 28px; fill: currentColor; }
  .st-play-stop { display: none; }
  .st-play[aria-pressed="true"] { opacity: 0.45; }
  .st-play[aria-pressed="true"]:hover,
  .st-play[aria-pressed="true"]:focus-visible { opacity: 1; }
  .st-play[aria-pressed="true"] .st-play-go { display: none; }
  .st-play[aria-pressed="true"] .st-play-stop { display: block; }
  .st-play:not(:disabled):active { transform: scale(0.96); }
  .st-play:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
  .st-slot[data-pending] .st-play {
    color: color-mix(in oklab, var(--sheet-dim) 34%, transparent);
    background: transparent;
    cursor: default;
  }
  .st-slot[data-pending] .st-play svg { opacity: 0.8; }
  /* THE HONEST EMPTY FRAME (no file at build time): a hairline in the sheet's dim ink at 18 %, square, no fill, no
     shadow, the drawn key dimmed and inert at its centre. Nothing that pretends to be a frame. */
  .st-slot[data-pending] .st-frame {
    border: 1px solid color-mix(in oklab, var(--sheet-dim) 18%, transparent);
    transition: border-color 560ms ease;
  }
  /* ── THE THESIS (2026-10-23): the clip → the five highlights → the door; no fold, so the sheet pads its own foot
     (AudioDex's rule: no handle) */
  #build-studio { padding-bottom: var(--sheet-pad); }
  /* THE CLIP: the content's whole width, 16:9, the band's 56 above it; the frame, the key and the honest empty frame
     are the chassis's rules above (.st-frame, .st-play, [data-pending]) */
  .st-clip .st-frame { width: 100%; }
  /* THE HIGHLIGHTS: a list with no marks; every row a section (the 12 % hairline above it, 24 / 32 of air), the first
     hairline the band→object beat under the clip. A wide sheet: the frame left (11 parts), the sentence right (9),
     48 apart, centred on each other; under 820 of the sheet, the frame then the sentence */
  .st-hl {
    list-style: none;
    margin: 56px 0 0;
    padding: 0;
  }
  .st-hl-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
    align-items: center;
  }
  .st-hl-row:last-child { padding-bottom: 0; }
  .st-hl-fig { margin: 0; }
  /* a real frame: the sheet's inner corner and its hairline, the capture's own dark under it while it loads */
  .st-hl-frame {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 14px;
    border: 1px solid color-mix(in oklab, var(--sheet-ink) 14%, transparent);
    background: #0b0c10;
    transition: border-color 560ms ease;
  }
  .st-hl-frame img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* the hands' caption: the mono caption face, dim, 10 under the frame */
  .st-hl-cap {
    margin: 10px 0 0;
    font: 400 0.75rem/1.4 var(--wk-mono);
    letter-spacing: 0.04em;
    color: var(--sheet-dim);
    transition: color 560ms ease;
  }
  /* the sentence: the said line's face and size (Outfit 400, 1.25rem; 1.5rem on a wide sheet), flush left */
  .st-hl-line {
    margin: 0;
    font-family: var(--wk-display);
    font-size: 1.25rem;
    font-weight: 400;
    line-height: 1.35;
    letter-spacing: -0.005em;
    text-wrap: pretty;
    color: var(--mx-ink);
    transition: color 560ms ease;
  }
  @container sheet (min-width: 820px) {
    .st-hl-row {
      grid-template-columns: minmax(0, 11fr) minmax(0, 9fr);
      gap: 48px;
    }
    .st-hl-line { font-size: 1.5rem; }
  }
  /* THE DOOR: one line at the foot in the label face, centred, 56 under the last row; the handle is the sheet's only
     link, the house link (the accent mixed toward the ink, a 1px underline) */
  .st-door {
    margin: 56px 0 0;
    text-align: center;
    font: 500 0.6875rem/1.6 var(--wk-mono);
    letter-spacing: 0.12em;
    color: var(--sheet-dim);
    transition: color 560ms ease;
  }
  .st-door a {
    color: color-mix(in oklab, var(--sheet-acc) 80%, var(--sheet-ink));
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    transition: color 560ms ease;
  }
  .st-door a:hover { color: var(--sheet-ink); }
  .st-door a:focus-visible { outline: 2px solid var(--sheet-ink); outline-offset: 3px; border-radius: 2px; }
  :global(html[data-night]) .st-door a { color: color-mix(in oklab, var(--sheet-acc) 50%, var(--sheet-ink)); }
  /* (the writing tiles left with their section, 2026-08-31 — the
     /writing/<slug> pages keep their own styles) */

  /* ── the live instrument (the finale) ────────────────────────────────── */
  .live-signal {
    /* R3 (2026-09-24): the device is 1280 wide (src/signal/types.ts
       DEVICE_W) and stands at 97–99 % of the column it gets, so the room
       is as wide as the site's content column allows: the device plus a
       small gutter a side (was 1248 for the 1120 device). */
    max-width: 1360px;
    margin: 0 auto;
  }
  /* the room is its sheet's own edges (round four, 2026-10-13: like #work and
     #studio): content-sized, no padding of its own, so the one gap
     (.one > .room) is the only ground above and below it. Its rail row frames
     the sheet 24px under the viewport's top, as the build rows frame theirs */
  .one > .live-signal {
    min-height: 0;
    padding-block: 0;
  }
  @media (min-width: 900px) {
    #play { scroll-margin-top: 24px; }
  }
  .sig-desktop {
    display: none;
    /* THE FIT'S MEASURE: this box's CONTENT width (the width .sig-stage had
       when it stood outside a sheet, round three); its gutter is the 1–3 %
       margin the powered device keeps from the rail and the viewport edge */
    /* round six: the 160 rail narrows the column by 32px, so the gutter
       gives it back where the fit is width-bound: 24 from 1600 up (where the
       room's 1360 max binds, as before), 14.4 at 1440, 8 at 1280, and the
       powered device keeps its round-five size (1224.6 at 1440×900; was
       clamp(12px, 1.5vw, 24px)) */
    padding-inline: clamp(8px, calc(6vw - 72px), 24px);
    flex-direction: column;
    /* nothing in the room clips: the powered device overhangs the sheet */
    overflow: visible;
  }
  /* ONE SHEET (round four): the sheet's own max width (1080), centred on the
     column's axis, where the device stands; never a clip (the sheet's
     container query is inline-size only: it neither clips nor traps) */
  .sig-desktop > :global(.sc) {
    margin-inline: auto;
    overflow: visible;
  }
  /* AT REST, 70 % (Jon, 2026-10-13: "very in your face … desired to be this
     large during use, but outside of use it could be scaled down. Powering
     it up scales it up"). The fit's zoom (--sig-zoom, below) lays the device
     out at its FULL fit in every state, so powered it is exactly today's
     device; at rest (standby, and the power-down on its way there) the
     host's own box scales it by 0.7 from its top centre, and a negative
     margin of the same 30 % of its laid-out height (--sig-h, written by the
     fit on resize only) gives the room back, so the tail sheet stands under
     the drawn device. Both ride ONE 400 ms ease (a transform and a margin:
     reliably animatable everywhere, unlike `zoom`), both linear in the same
     scale, so the device's drawn foot and the page beneath move together:
     no step, no jump, no script per frame. Powered, the transform is `none`
     (no containing block, no layer left behind). Keyed on the instrument's
     own #sgm[data-state] (observed, never edited). */
  /* ON THE PAPER (round four): the stage sits in the sheet's content box,
     the sheet's own rhythm around it: the story's last line → the device 56
     (band→object), the device's foot → how to play's hairline 56
     (object→fold), at rest and powered alike (the 56 rides in the same
     margin as the rest scale's give-back). The device is centred by flex, so
     when it is wider than the paper (powered, from about 1366 wide) it
     overhangs both edges equally (an auto margin would push it out on the
     right only). */
  .live-signal :global(.sig-stage) {
    --sig-rest: 0.7;
    --sig-air: 56px;
    display: flex;
    justify-content: center;
    margin-top: var(--sig-air);
    transform: none;
    transform-origin: 50% 0;
    margin-bottom: var(--sig-air);
    transition:
      transform 400ms cubic-bezier(0.33, 0, 0.2, 1),
      margin-bottom 400ms cubic-bezier(0.33, 0, 0.2, 1);
  }
  .live-signal :global(.sig-stage:has(> .sgm:is([data-state="standby"], [data-state="powerdown"]))) {
    transform: scale(var(--sig-rest));
    margin-bottom: calc(var(--sig-air) + var(--sig-h, 0px) * (var(--sig-rest) - 1));
  }
  @media (prefers-reduced-motion: reduce) {
    .live-signal :global(.sig-stage) { transition: none; }
  }
  /* THE ARROWS' box = their viewBox in device pixels × the fit (the device's
     top-left is at 50% − 640·z, 0 of the stage): device x 1180..1280, y
     −122..80. The box stops at the device's right edge on purpose: the
     strokes run on to device x 1386 as SVG overflow (ink, never scrollable
     overflow), so when the device powers up to its full fit the faded
     arrows' box stays inside the viewport (a box out to x 1392 widened the
     document to 1503 at 1440). Every stroke stays left of device x 1392,
     on the paper at the fit's cap (z 1.0045: the sheet's edge at device
     1408; at 1440×900 it is 1446), and below device y −122, under the
     story's first line (−158 at the cap) */
  .live-signal :global(.sig-stage) { position: relative; }
  .sig-point {
    position: absolute;
    left: calc(50% + 540px * var(--sig-zoom, 1));
    top: calc(-122px * var(--sig-zoom, 1));
    width: calc(100px * var(--sig-zoom, 1));
    height: calc(202px * var(--sig-zoom, 1));
    overflow: visible;
    stroke: var(--ember);
    pointer-events: none;
    opacity: 1;
    transition: opacity 400ms ease;
  }
  .live-signal :global(.sig-stage:has(> .sgm:not([data-state="standby"]))) .sig-point { opacity: 0; }
  /* FIT (2026-09-02, Jon: "the drums module hangs off the side"). The
     sacred file pins the device to its 1120px reference and zooms it
     uniformly only at ≥1200px; below that it let the device go fluid, and
     the rhythm zone (fixed columns) overflowed the casing at 1024–1100.
     Styled from OUTSIDE only: pin the reference at EVERY width and let the
     host set a continuous `--sig-zoom` (JS below: min(the file's own
     height caps, column ÷ 1120)). The device now always fits its column,
     so the old horizontal scroller is gone — nothing clips the soft shadow
     at any width (Jon's rule, 2026-08-27/09-01). */
  .live-signal :global(.sgm) {
    flex: none; /* never shrunk by the paper: the fit alone sizes it */
    width: max-content; /* the zoomed device's own width (fit-content would clamp it to the paper: its grid track is minmax(0, auto)) */
    margin-inline: 0; /* the stage centres it (an auto margin would not overhang both sides) */
  }
  .live-signal :global(.sgm .device) {
    width: 1280px; /* = src/signal/types.ts DEVICE_W (R3) */
    zoom: var(--sig-zoom, 1);
  }
  /* the site's dot cursor is redundant over the instrument: its material
     restores the system cursor there (the /signal page's own rule) */
  :global(body:has(.live-signal .sig:hover) .cursor-dot) {
    visibility: hidden !important;
  }
  /* the POWER SWITCH reads from across the room (Jon, 2026-09-21: "much
     more noticeable — bigger, brighter, or both"; R4, 2026-09-24: the disc
     became a red rocker you flick, in the device's top-right corner). From
     OUTSIDE the sacred file: no scale (the switch is 68 × 30 of the
     device's own px and zooms with it), and in standby the rocker's lamp
     glows plainly red, its ⏻ brighter, the breathe halo wider and stronger
     (still inside the chassis's rim). Boot and live (.lit: the lamp lit
     steady, no halo) keep the file's own rules — every override is gated
     on .device:not(.live) and .pwr:not(.lit). */
  .live-signal :global(.sgm .pwr) {
    transform: none;
  }
  /* ON THE METAL (Jon, 2026-10-07): the switch's inset and its dark
     collar now live in the device itself (Signal.astro, power.css), so
     the homepage and /signal read the same */
  .live-signal :global(.sgm .device:not(.live) .pwr:not(.lit) .pwr-lamp) {
    opacity: 0.55;
  }
  .live-signal :global(.sgm .device:not(.live) .pwr:not(.lit) .pwr-rocker path) {
    stroke: rgba(255, 238, 232, 0.94);
  }
  .live-signal :global(.sgm .device:not(.live) .pwr:not(.lit)::after) {
    box-shadow: 0 0 14px 3px rgba(255, 80, 64, 0.78);
  }
  @media (pointer: fine) {
    .sig-desktop {
      display: flex;
    }
  }
  /* the play room exists only where the instrument can play (Jon,
     2026-09-22: the phone exhibit is deleted): on phones — the bar's width —
     and on any screen without a fine pointer the room is gone, and "play"
     leaves the bar and the rail with it (the nav trio reads only the rooms
     that are laid out — getDocIds). Desks keep everything. */
  @media (max-width: 899px), not all and (pointer: fine) {
    .live-signal {
      display: none;
    }
    /* the whole row goes, so the list keeps no empty gap (the phone bar
       never carries signal: its builds word is the work room) */
    .rail-list > li[data-room="play"] {
      display: none;
    }
  }

  /* ── AUDIO: THE CASSETTE (2026-09-09; Jon's mock + his blank tape; the
     field recorder's cover window is retired). The placard first — mono
     title, the note, both on the column's left edge — then the tape
     itself, centred and as wide as the room allows, then ONE machine row:
     the hairline rule with a 1px playhead tick as the seek (no fill) and
     the counter in a recessed pane hard-right. The tape IS the switch: the
     whole cassette is a button that clicks the Transport's own (hidden)
     toggle; while playing the two hubs turn — the same discs cut from the
     PNG and rotated in place — the counter runs, and the one ember lamp
     lights in the counter pane. The label is the tape's identity: a colour
     rect (--cs-tint per tape, from tapeTint above) sits behind the PNG's
     transparent label area and the shell prints over it; a manifest cover
     prints on the label instead. Materials otherwise as the recorder's:
     value steps of the room's ink over --bg via color-mix, every seam 1px;
     the section-local --au-ink/--au-dim pair is the only place that flips
     (the ledger's law). Transport's own styles are overridden from here
     with the room id for specificity; its mechanics are untouched. */
  .au {
    --au-ink: var(--ink);
    --au-dim: var(--dim);
    --au-pane: color-mix(in srgb, var(--au-ink) 10%, var(--bg));
    --au-seam: color-mix(in srgb, var(--au-ink) 26%, transparent);
    --au-hair: color-mix(in srgb, var(--au-ink) 50%, transparent); /* 3.35:1 on the day ground (WCAG 1.4.11 wants 3:1 for the slider's only boundary) */
    box-sizing: border-box;
    width: min(860px, calc(100% - 28px));
    margin: 0 auto;
    color: var(--au-ink);
  }
  :global(html[data-night]) .au {
    --au-ink: var(--night-ink);
    --au-dim: var(--night-dim);
    --au-pane: color-mix(in srgb, var(--au-ink) 12%, var(--bg));
    --au-seam: color-mix(in srgb, var(--au-ink) 30%, transparent);
    --au-hair: color-mix(in srgb, var(--au-ink) 42%, transparent);
  }
  /* the chassis arrows are replaced by the deck's own keys */
  .au :global(.car-nav) {
    display: none;
  }
  /* the wallet's strip drops over the deck: the chassis must not clip it
     (dissolve mode never translates the track, so nothing else escapes) */
  .au :global(.car-view) {
    overflow: visible;
  }
  /* the slide: placard rows, then the tape's row, then the machine. The
     carousel stretches every slide to the track, and the machine row
     sits at the BOTTOM of that box (the tape closes up against it). The
     loaded tapes share the tallest tape's height, so the rule, the counter
     and the tape hold one y across tapes whose placards differ in height —
     only the space under the placard varies. The blank deck is not a tape:
     at rest it is its own height, the tape right under the mini (2026-10-13;
     THE DECK'S HEIGHT in the script) */
  .ls {
    /* the tape's width, read by the tape AND the rail under it (Jon: the
       rail in line with the cassette): 760 at most, about half the
       viewport on a desk (Jon: it should scale down), full width on a
       phone, and never taller than the room leaves for it — the reserve
       is the placard (a note of up to four lines), the rail and the room's
       own padding on a laptop screen (measured 336px at 1366 × 768 with a
       two-line note; 380 keeps the rooms abutting with a longer one), plus
       the phone bar under 900px wide;
       1.634 is the PNG's aspect */
    --cs-reserve: 380px; /* room for a four-line note */
    --cs-vw: 100%;
    --cs-w: min(760px, 100%, var(--cs-vw), calc((100svh - var(--cs-reserve)) * 1.634));
    display: grid;
    grid-template-rows: auto 1fr auto;
    padding: 0;
  }
  @media (max-width: 899px) {
    .ls {
      --cs-reserve: 440px; /* + the pinned phone bar (--mbar-h) */
    }
    /* on a phone the wallet's mini is the room's only control: a thumb-sized
       object (80 × 49, the strip drops under it), not a title-line chip
       (round 3, 2026-09-22) */
    .au .ls-head {
      --mini-w: 80px; /* .au for weight: the base .ls-head rule sits later in the sheet */
    }
  }
  @media (min-width: 900px) {
    .ls {
      --cs-vw: 52vw;
    }
  }

  /* the placard: above the tape, on the column's left edge (Jon's mock) —
     THE WALLET's mini at the left (this tape, small: the shell render over
     dark plastic over its tint at the label geometry; blank paper on the
     empty deck), the title and the note beside it. The mini is exactly one
     title line tall. Press it and the STRIP drops under it: the tapes as
     sleeves in a recessed pocket, one mini each, seams between (a wallet's
     photo insert), unfolding top-down. Hover / focus on a sleeve previews
     that tape's words in the placard in the dim ink (data-preview) */
  .ls-head {
    --mini-w: calc(1.2 * clamp(1.5rem, 2.4vw, 2rem) * 1.634);
    --mini-h: calc(var(--mini-w) / 1.634);
    position: relative;
    min-width: 0;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: 16px;
    align-items: start;
  }
  .ls-words {
    min-width: 0;
  }
  .ls-title {
    margin: 0;
    min-width: 0;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--au-ink);
    overflow-wrap: anywhere;
  }
  .ls-head[data-preview] .ls-title,
  .ls-head[data-preview] .ls-note {
    color: var(--au-dim);
  }
  /* the mini: the cassette, small — plastic, label, shell */
  .mini {
    position: relative;
    display: block;
    width: var(--mini-w);
    aspect-ratio: 1600 / 979;
    border-radius: calc(var(--mini-w) * 0.0375); /* the shell's own corner */
    background: var(--night); /* the plastic: a photographed object's own dark, never flips */
    overflow: hidden;
  }
  .mini-label {
    position: absolute;
    left: 5.95%;
    top: 8.65%;
    width: 87.95%;
    height: 59.85%;
    /* the tape's tint; unprinted paper when no tape is in (the empty deck) */
    background: var(--mini-tint, color-mix(in srgb, var(--au-ink) 14%, var(--bg)));
    overflow: hidden;
  }
  :global(html[data-night]) .mini-label {
    background: var(--mini-tint-night, color-mix(in srgb, var(--au-ink) 14%, var(--bg)));
  }
  .mini-label img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .mini-shell {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
    pointer-events: none;
  }
  /* the pick: the mini as a button; hover lifts, a press seats */
  .wl-pick {
    display: block;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
    border-radius: calc(var(--mini-w) * 0.0375);
    -webkit-tap-highlight-color: transparent;
    transition: transform 70ms cubic-bezier(0.2, 0.7, 0.3, 1);
  }
  .wl-pick:hover,
  .wl-pick[aria-expanded="true"] {
    transform: translateY(-2px);
  }
  .wl-pick:active {
    transform: translateY(1px);
  }
  .wl-pick:focus-visible {
    outline: 1px solid var(--au-ink);
    outline-offset: 4px;
  }
  /* the strip: a recessed pocket under the mini, the sleeves stacked with
     a seam between each, dropping over the deck */
  .wl-strip {
    position: absolute;
    z-index: 6;
    top: calc(var(--mini-h) + 10px);
    left: 0;
    margin: 0;
    padding: 4px;
    list-style: none;
    display: flex;
    flex-direction: column;
    max-height: calc(100svh - var(--mini-h) - 180px);
    overflow-y: auto;
    background: var(--au-pane);
    border: 1px solid var(--au-seam);
    border-radius: 2px;
    box-shadow:
      inset 0 1px 0 var(--au-seam),
      0 14px 28px -14px color-mix(in srgb, var(--au-ink) 40%, transparent);
  }
  .wl-strip[hidden] {
    display: none; /* the author display above would beat the attribute */
  }
  /* on a desk the strip hangs to the LEFT of the mini, top-aligned with it,
     in the empty ground beside the column — never over the tape (Jon,
     2026-09-18); the column's left margin has the room from ~1160px up,
     below that it drops under the mini */
  @media (min-width: 1160px) {
    .wl-strip {
      top: 0;
      left: auto;
      right: calc(100% + 12px);
      max-height: calc(100svh - 120px);
    }
  }
  /* the chosen sleeve's mini flies into the slot (a clone, then gone) */
  .wl-fly {
    position: absolute;
    z-index: 7;
    pointer-events: none;
    transition: transform 260ms cubic-bezier(0.2, 0.7, 0.3, 1);
  }
  .wl-sleeve {
    padding: 5px;
    border-top: 1px solid var(--au-seam);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .wl-sleeve:first-child {
    border-top: 0;
  }
  .wl-sleeve:hover,
  .wl-sleeve:focus-visible {
    background: color-mix(in srgb, var(--au-ink) 6%, var(--bg));
    outline: none;
  }
  .wl-sleeve:focus-visible .mini {
    outline: 1px solid var(--au-ink);
    outline-offset: 1px;
  }
  /* the tape already in the deck: a ghost in its sleeve */
  .wl-sleeve[aria-selected="true"] .mini {
    opacity: 0.4;
  }
  @media (prefers-reduced-motion: no-preference) {
    .wl-strip:not([hidden]) {
      transform-origin: 50% 0;
      animation: wl-open 160ms cubic-bezier(0.2, 0.7, 0.3, 1) both;
    }
    .wl-strip:not([hidden]) .wl-sleeve {
      animation: wl-drop 220ms cubic-bezier(0.2, 0.7, 0.3, 1) both;
      animation-delay: calc(var(--k, 0) * 28ms);
    }
  }
  /* a peek folds back the way it opened (the first settle on phones and
     narrow desks, where the open strip would cover the tape) */
  @media (prefers-reduced-motion: no-preference) {
    .wl-strip[data-fold]:not([hidden]) {
      animation: wl-fold 160ms cubic-bezier(0.4, 0, 0.8, 0.3) both;
    }
  }
  @keyframes wl-fold {
    from { opacity: 1; transform: none; }
    to { opacity: 0; transform: scaleY(0.94); }
  }
  @keyframes wl-open {
    from { opacity: 0; transform: scaleY(0.94); }
    to { opacity: 1; transform: none; }
  }
  @keyframes wl-drop {
    from { opacity: 0; transform: translateY(-6px); }
    to { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .wl-pick {
      transition: none;
    }
  }
  /* the empty deck: its label is UNPRINTED — the faintest value step of the
     room's ink over the ground (the tint arrives with a tape) — and its rail
     is DEAD: the same 44px band and hairline, no tick, so the blank tape
     holds the loaded tapes' y. Its tape is no longer inert (2026-09-22): a
     press opens the wallet, with the tape's own seat, and on a desk the
     pointer on it wakes the mini (the mini's own hover lift) */
  .ls-blank:has(> .cs:hover) .wl-pick {
    /* a clear lift, read from across the room (Jon, 2026-09-23: the 2px
       blip "doesn't move quite enough"): up 8px over a beat you can see,
       its shadow opening under it on the ground */
    transform: translateY(-8px);
    box-shadow: 0 10px 14px -8px color-mix(in srgb, var(--au-ink) 45%, transparent);
    transition: transform 220ms cubic-bezier(0.2, 0.7, 0.3, 1), box-shadow 220ms ease;
  }
  @media (prefers-reduced-motion: reduce) {
    .ls-blank:has(> .cs:hover) .wl-pick {
      transition: none;
    }
  }
  /* the wallet's first settle: the mini seats as if pressed, then opens */
  .wl-pick[data-seat] {
    transform: translateY(1px);
  }
  .ls-blank .cs-label,
  :global(html[data-night]) .ls-blank .cs-label {
    background: color-mix(in srgb, var(--au-ink) 6%, var(--bg));
  }
  .ls-deck-dead {
    height: 44px;
    display: flex;
    align-items: center;
  }
  /* the music room's foot is the rail's HAIRLINE, not its seek band
     (2026-10-13, one gap): the band (the dead one above, the Transport's
     .tp-wave on a loaded tape) is a 44px hit area with the 1px line centred
     in it, so the room gives back the band's lower half and the ground
     from the line to the floor is --room-gap like every other gap */
  .one > #soundlab {
    margin-bottom: calc((1px - 44px) / 2);
  }
  .ls-rail {
    display: block;
    width: 100%;
    height: 1px;
    background: var(--au-hair);
  }
  .ls-note {
    margin: 10px 0 0;
    min-width: 0;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: clamp(0.92rem, 1.2vw, 1.08rem); /* smaller: Jon's notes will run longer */
    line-height: 1.5;
    color: var(--au-ink);
    text-wrap: pretty;
  }

  /* the tape: centred; a size container so the display's type scales
     with it */
  .cs {
    container-type: inline-size;
    position: relative;
    display: block;
    box-sizing: border-box;
    width: var(--cs-w);
    margin: clamp(28px, 6vh, 64px) auto 0;
    align-self: end;
    padding: 0;
    border: 0;
    border-radius: 12px;
    background: none;
    color: inherit;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition: transform 70ms cubic-bezier(0.2, 0.7, 0.3, 1);
  }
  /* the click: a hard press on tap; while the tape runs it sits seated,
     2px lower, and lifts again on pause */
  .cs:active {
    transform: translateY(3px);
  }
  .ls[data-playing] .cs {
    transform: translateY(2px);
  }
  .cs:focus-visible {
    outline: 1px solid var(--au-ink);
    outline-offset: 8px;
  }
  /* the shell is Jon's V3 render: the label area, the two hub circles and
     the display rectangle are cut to alpha, so it paints LAST, over the
     colour rect, the hubs and the display, and its cut edges frame them */
  .cs-shell {
    position: relative;
    z-index: 3;
    display: block;
    width: 100%;
    height: auto;
    pointer-events: none;
  }
  /* the label: the PNG's label area is transparent; this rect sits under
     it, a hair larger than the cut-out so the shell's inner edge covers
     the seam — the tape's colour, or its cover when the manifest has one.
     Both tints ride inline on .ls (a stylesheet rule can't override an
     inline custom property on that element), so night doesn't re-declare
     --cs-tint: it swaps which token this rule reads */
  .cs-label {
    position: absolute;
    z-index: 0;
    left: 5.95%;
    top: 8.65%;
    width: 87.95%;
    height: 59.85%;
    background: var(--cs-tint);
    overflow: hidden;
  }
  :global(html[data-night]) .cs-label {
    background: var(--cs-tint-night);
  }
  .cs-label img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* THE TAPE'S SCREEN (2026-10-07): while a tape plays, tape-crt.ts lays a
     CRT canvas over its label (the label only: the shell's cut-out frames
     it). It fades in on play and out on pause; the <img> under it is the
     fallback and what every tape shows at rest */
  .cs-label :global(.cs-crt) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 600ms ease;
    pointer-events: none;
  }
  .cs-label :global(.cs-crt[data-on]) {
    opacity: 1;
  }
  /* the hubs, under the shell's two circular cut-outs (centres 630.5,570
     and 1507,570 of 2132 × 1305, radius 133): a still BASE disc (the
     original render's hub — ring, highlight and all, radius 150 so it
     overfills the hole) and, over it, the toothed CORE (radius 97 — the
     whole teeth, which reach the ring's inner edge at r 96) that turns.
     Both are cut about the hub's TRUE centre (628.0,568.3 / 1501.5,568.7,
     a circle fit to the ring's inner edge; a crop about a guessed centre
     made the teeth orbit) and placed at the hole's centre, so ring, core
     and hole are concentric. The light stays put; only the teeth move;
     the hole's edge is the shell's own */
  .cs-hub {
    position: absolute;
    z-index: 1;
    left: 22.537%;
    top: 32.184%;
    width: 14.071%;
    height: 22.989%;
    pointer-events: none;
  }
  .cs-hub-r {
    left: 63.649%;
  }
  .cs-reel {
    position: absolute;
    z-index: 2;
    left: 25.023%;
    top: 36.245%;
    width: 9.099%;
    height: 14.866%;
    pointer-events: none;
    /* the turn runs always and is PAUSED at rest, so a pause holds the
       hubs where they are and play resumes from there (dropping the
       animation snapped them back to 0°) */
    animation: cs-turn 4.4s linear infinite; /* half the first cut's speed (Jon) */
    animation-play-state: paused;
  }
  .cs-reel-r {
    left: 66.135%;
  }
  /* the display, under the shell's rectangular cut-out (814..1318 ×
     437..703 of 2132 × 1305; the pane overfills it a hair): the recessed
     pane material, and on it the tape's readout — the outlined play
     mark at rest, the running counter while the tape plays (Jon's
     Game-Boy / Etch-a-Sketch window, 2026-09-09). Type scales with the
     tape through container units */
  .cs-screen {
    position: absolute;
    z-index: 1;
    left: 37.9%;
    top: 33.1%;
    width: 24.2%;
    height: 21.2%;
    display: grid;
    place-items: center;
    background: var(--au-pane);
    color: var(--au-ink);
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 2.7cqw;
    letter-spacing: 0.06em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    pointer-events: none;
  }
  .cs-go {
    width: 8.2cqw;
    height: 8.2cqw;
    fill: none;
    stroke: var(--au-dim);
    stroke-width: 1.05;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .cs-time {
    display: none;
  }
  /* a sleeve's hover / focus prints the hovered tape's LENGTH in the
     window at the play mark's scale (Jon, 2026-09-22); while the tape
     plays the running counter keeps the window */
  .cs-len {
    display: none;
    font-size: 7.4cqw;
    letter-spacing: 0.02em;
    color: var(--au-dim);
  }
  .ls[data-len]:not([data-playing]) .cs-go {
    display: none;
  }
  .ls[data-len]:not([data-playing]) .cs-len {
    display: block;
  }
  .ls[data-playing] .cs-go {
    display: none;
  }
  .ls[data-playing] .cs-time {
    display: block;
  }
  /* playing: both hubs turn counter-clockwise (the tape runs left to right
     across the head) at one speed (Jon: the take-up turning faster read
     as wrong) */
  .ls[data-playing] .cs-reel {
    animation-play-state: running;
  }
  @keyframes cs-turn {
    to {
      transform: rotate(-360deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cs-reel {
      animation: none;
    }
    .cs {
      transition: none;
    }
  }

  /* the machine: the rail alone under the tape, exactly the tape's width
     (Jon: in line with the cassette) — the Transport dissolves into it;
     its own play key is hidden (the tape is the switch) and its counter
     is hidden too (the display in the window is the readout) */
  .ls-deck {
    width: var(--cs-w);
    margin: clamp(20px, 3.5vh, 36px) auto 0; /* clamp(24px, 7vh, 72px) until 2026-10-07: the rail closer to the tape (Jon's mock) */
  }
  /* THE VOLUME (2026-10-07, Jon: "a traditional standard vertical slider bar
     … perpendicular to the timeline and right of the tape"; a first cut ran
     the tape's whole height: "wayyyy too long"): a short standard fader,
     120px, standing on the rail's line (22px above the slide's foot), ~62px
     right of the tape. A 3px rounded track, ink below the round thumb, the
     hairline above; the band is 44px wide (the rail's own seek band). Desks
     only, and only where the browser lets a page set a level (iOS does not:
     the script marks the room data-novol). No wheel: it never takes the
     page's scroll. */
  .ls {
    position: relative;
  }
  /* the deck's height is the SHOWN slide's (the script sets the track: the
     blank deck's own at rest, the tapes' shared height otherwise), eased
     like the look stage (2026-10-13) */
  @media (prefers-reduced-motion: no-preference) {
    #soundlab :global(.car[data-mode="dissolve"] .car-track) {
      transition: height 260ms ease;
    }
  }
  .ls-vol {
    --vol: 1;
    position: absolute;
    left: calc(50% + var(--cs-w) / 2 + 40px); /* the track ~62px right of the tape (Jon's mock, 2026-10-07) */
    bottom: 22px;
    width: 44px;
    height: 120px;
    cursor: ns-resize;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    outline: none;
  }
  .ls-vol i {
    position: absolute;
    left: 50%;
    display: block;
    pointer-events: none;
  }
  .ls-vol-track {
    top: 0;
    bottom: 0;
    width: 3px;
    margin-left: -1.5px;
    border-radius: 2px;
    background: var(--au-seam);
  }
  .ls-vol-fill {
    bottom: 0;
    width: 3px;
    margin-left: -1.5px;
    border-radius: 2px;
    height: calc(var(--vol) * 100%);
    background: var(--au-ink);
  }
  .ls-vol-thumb {
    bottom: calc(var(--vol) * 100%);
    width: 13px;
    height: 13px;
    margin: 0 0 -6.5px -6.5px;
    border-radius: 50%;
    background: var(--au-ink);
    transition: transform 120ms ease;
  }
  .ls-vol:hover .ls-vol-thumb,
  .ls-vol[data-dragging] .ls-vol-thumb {
    transform: scale(1.25);
  }
  .ls-vol:focus-visible .ls-vol-thumb {
    box-shadow: 0 0 0 3px var(--bg), 0 0 0 4px var(--au-ink);
  }
  .au[data-novol] .ls-vol {
    display: none;
  }
  @media (max-width: 899px) {
    .ls-vol {
      display: none;
    }
  }
  #soundlab .ls-deck :global(.tp) {
    display: contents;
  }
  #soundlab .ls-deck :global(.tp-btn),
  #soundlab .ls-deck :global(.tp-time) {
    display: none;
  }
  #soundlab .ls-deck :global(.tp-wave:focus-visible) {
    outline: 1px solid var(--au-ink);
    outline-offset: 2px;
  }
  /* the rule: a 44px seek band, one hairline centred in it, a 1px tick at
     the playhead, no fill — the bars are the Transport's, flattened */
  #soundlab .ls-deck :global(.tp-wave) {
    grid-area: wave;
    width: auto;
    min-width: 0;
    height: 44px;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0;
    border-radius: 0;
    cursor: pointer;
    overflow: hidden;
  }
  #soundlab .ls-deck :global(.tp-wave i) {
    position: relative;
    flex: 1;
    min-width: 1px;
    height: 1px;
    border-radius: 0;
    background: var(--au-hair);
    transition: none;
  }
  #soundlab .ls-deck :global(.tp-wave i[data-played]) {
    background: var(--au-hair);
  }
  #soundlab .ls-deck :global(.tp-wave i)::before {
    content: none;
    position: absolute;
    top: -7px;
    left: 0;
    width: 1px;
    height: 15px;
    background: var(--au-ink);
  }
  /* the tick = the first unplayed bar's left edge (the origin at rest) */
  #soundlab .ls-deck :global(.tp-wave i:first-child:not([data-played]))::before,
  #soundlab .ls-deck :global(.tp-wave i[data-played] + i:not([data-played]))::before {
    content: "";
  }
  #soundlab .ls-deck :global(.tp-wave i:last-child[data-played])::before {
    content: "";
    left: auto;
    right: 0;
  }

  /* look: just the artwork on the site's own ground — no frame, no dark
     band; arrows flank the image at the sides (Jon, 2026-08-19) */
  .look-band {
    width: 100%;
    margin: 0;
    /* the room's only padding (2026-10-13, every room content-sized): the
       dot row stands 8 + 24px above the painted picture, outside the
       chassis box, and its lit mark (6px × 1.45, centred in the 24px
       target) is the room's first ink. This is exactly that reach, so the
       gap above the dots is --room-gap like every other gap */
    padding-top: calc(8px + 12px + 6px * 1.45 / 2);
  }
  .look-band :global(.car) {
    position: relative;
  }
  /* the stage follows the SHOWN picture (2026-10-13, one gap): dissolve
     stacks every slide in one flex row, which would stand as tall as the
     tallest piece and leave dead ground under a shorter one (94px under a
     4:3 piece on a phone, where the art sizes to its own aspect). The slides
     sit at the top and the measurer below sets the track to the shown
     slide's own height, eased with the fade; on desks every slide is the
     same 4:3 box, so nothing changes there */
  #illustrations :global(.car[data-mode="dissolve"] .car-track) {
    align-items: flex-start;
  }
  @media (prefers-reduced-motion: no-preference) {
    #illustrations :global(.car[data-mode="dissolve"] .car-track) {
      transition: height 260ms ease;
    }
  }
  .look-band :global(.car-nav) {
    position: static;
    margin: 0;
  }
  /* the placard's meta line carries the position; the chassis counter
     would say it twice from a far corner */
  .look-band :global(.car-counter) {
    display: none;
  }
  /* ── VISUALS KEYS (2026-09-09, Jon's pick from three rendered
     directions: B's cap, A's arrow): the recorder's key material given
     depth. Value steps of the room's ink over --bg via color-mix, every
     seam 1px, a 9px stacked body + a soft contact shadow; press collapses
     the body to 2px and the face drops the difference. Day = paper, night
     = carbon through the section-local --kc-ink (.one shadows --ink, so
     night resolves here — the ledger's law). The pair stands 20px outside
     the PAINTED picture, bodies 24px above its bottom: --lk-half and
     --lk-bottom are measured per slide by the script below (the 4:3 @
     80svh default holds until it runs). Desk only; phones swipe + pinch. */
  .look-band {
    /* 2026-09-09, Jon: the whole build 20% smaller; arrow centred
       vertically and nudged toward the picture (--kc-inset). */
    --kc: 61px;
    /* oblique body (Jon's mock, 2026-09-09): the block sits down AND to the
       right of the face, so a side and a bottom show, not just a lip */
    --kc-sx: 7px;
    --kc-sy: 9px;
    --kc-r: 6px;
    --kc-gap: 20px;
    --kc-rise: 24px;
    --kc-glyph: 29px;
    --kc-inset: 4px;
    /* the room one key needs outside the picture: its gap, its body, its
       cap, and the same gap again to the column's edge (the rail on the
       left, the viewport on the right). Below ~1286px at 900 tall the 4:3
       picture at 80svh no longer leaves it, so the picture is FIT to the
       column minus two of these (.lk-img's max-width) and the keys keep
       every relationship Jon tuned; where they already fit, nothing moves.
       The pre-measure default carries the same cap (2026-09-09: the
       Next key ran off the page from 900 to 1240). */
    --lk-room: calc(var(--kc-gap) + var(--kc-sx) + var(--kc) + var(--kc-gap));
    --lk-half: min(53.333svh, 50% - var(--lk-room));
    --lk-top: 0px;
    --lk-bottom: 80svh;
    --kc-ink: var(--ink);
    --kc-face-hi: color-mix(in srgb, var(--kc-ink) 2%, var(--bg));
    --kc-face: color-mix(in srgb, var(--kc-ink) 5%, var(--bg));
    --kc-face-hover-hi: var(--bg);
    --kc-face-hover: color-mix(in srgb, var(--kc-ink) 1.5%, var(--bg));
    --kc-face-down: color-mix(in srgb, var(--kc-ink) 8%, var(--bg));
    --kc-bevel-hi: color-mix(in srgb, var(--kc-ink) 0%, var(--bg));
    --kc-bevel-lo: color-mix(in srgb, var(--kc-ink) 14%, var(--bg));
    --kc-seam: color-mix(in srgb, var(--kc-ink) 26%, transparent);
    --kc-skirt-c: color-mix(in srgb, var(--kc-ink) 15%, var(--bg));
    --kc-lip: color-mix(in srgb, var(--kc-ink) 26%, var(--bg));
    --kc-contact: color-mix(in srgb, var(--kc-ink) 22%, transparent);
    --kc-ghost: color-mix(in srgb, var(--kc-ink) 34%, transparent);
  }
  /* phones: the picture is width-bound (4:3 first slide, 14px gutters), so
     the dot row has a sane place before the lazy image loads and the script
     measures the real bottom */
  @media (max-width: 899px) {
    .look-band {
      --lk-bottom: calc((100vw - 28px) * 0.75);
    }
  }
  @media (min-width: 900px) {
    .look-band :global(.car-btn) {
      position: absolute;
      z-index: 2;
      box-sizing: border-box;
      width: var(--kc);
      height: var(--kc);
      margin: 0;
      padding: 0;
      top: calc(var(--lk-bottom) - var(--kc-rise) - var(--kc-sy) - var(--kc));
      transform: none;
      display: grid;
      place-items: center;
      appearance: none;
      border: 1px solid var(--kc-seam);
      border-radius: var(--kc-r);
      color: var(--kc-ink);
      background: linear-gradient(180deg, var(--kc-face-hi), var(--kc-face));
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      opacity: 1;
      cursor: pointer;
      box-shadow:
        inset 1px 1px 0 var(--kc-bevel-hi),
        inset -1px -1px 0 var(--kc-bevel-lo),
        1px 1px 0 var(--kc-skirt-c),
        2px 2px 0 var(--kc-skirt-c),
        2px 3px 0 var(--kc-skirt-c),
        3px 4px 0 var(--kc-skirt-c),
        4px 5px 0 var(--kc-skirt-c),
        5px 6px 0 var(--kc-skirt-c),
        5px 7px 0 var(--kc-skirt-c),
        6px 8px 0 var(--kc-skirt-c),
        7px 9px 0 var(--kc-lip),
        9px 12px 6px -3px var(--kc-contact);
      transition: transform 70ms cubic-bezier(0.2, 0.7, 0.3, 1), box-shadow 70ms cubic-bezier(0.2, 0.7, 0.3, 1), background 120ms ease;
    }
    .look-band :global([data-car-prev]) {
      left: auto;
      /* the body extends toward the picture on this side; keep the 20px
         from the body's edge, not the face's */
      right: calc(50% + var(--lk-half) + var(--kc-gap) + var(--kc-sx));
    }
    .look-band :global([data-car-next]) {
      right: auto;
      /* mirrored: this body extends LEFT, toward the picture (Jon) */
      left: calc(50% + var(--lk-half) + var(--kc-gap) + var(--kc-sx));
      box-shadow:
        inset -1px 1px 0 var(--kc-bevel-hi),
        inset 1px -1px 0 var(--kc-bevel-lo),
        -1px 1px 0 var(--kc-skirt-c),
        -2px 2px 0 var(--kc-skirt-c),
        -2px 3px 0 var(--kc-skirt-c),
        -3px 4px 0 var(--kc-skirt-c),
        -4px 5px 0 var(--kc-skirt-c),
        -5px 6px 0 var(--kc-skirt-c),
        -5px 7px 0 var(--kc-skirt-c),
        -6px 8px 0 var(--kc-skirt-c),
        -7px 9px 0 var(--kc-lip),
        -9px 12px 6px -3px var(--kc-contact);
    }
    /* the chassis chevron goes; the glyph is the photo's arrow — a stem
       with a filled triangle head, drawn as a mask in the key's ink, set
       high on the face the way the photo's arrow sits on its key */
    .look-band :global(.car-btn > svg) {
      display: none;
    }
    .look-band :global(.car-btn)::before {
      content: "";
      position: absolute;
      inset: -4px;
    }
    .look-band :global(.car-btn)::after {
      content: "";
      position: relative;
      top: 0;
      left: calc(-1 * var(--kc-inset)); /* next: toward the picture */
      width: var(--kc-glyph);
      height: var(--kc-glyph);
      background: currentColor;
      -webkit-mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect x='3.5' y='14.4' width='15' height='3.2' rx='1.6'/><path d='M16.5 6.4 29 16 16.5 25.6z'/></svg>") center / contain no-repeat;
      mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect x='3.5' y='14.4' width='15' height='3.2' rx='1.6'/><path d='M16.5 6.4 29 16 16.5 25.6z'/></svg>") center / contain no-repeat;
      transition: opacity 120ms ease;
    }
    .look-band :global([data-car-prev])::after {
      left: var(--kc-inset); /* prev: toward the picture */
      transform: scaleX(-1);
    }
    .look-band :global(.car-btn:hover:not(:disabled)) {
      border-color: var(--kc-seam);
      background: linear-gradient(180deg, var(--kc-face-hover-hi), var(--kc-face-hover));
    }
    .look-band :global(.car-btn:active:not(:disabled)),
    .look-band :global(.car-btn[data-pressed]) {
      transform: translate(calc(var(--kc-sx) - 1px), calc(var(--kc-sy) - 2px));
      background: linear-gradient(180deg, var(--kc-face), var(--kc-face-down));
      box-shadow:
        inset 1px 1px 0 var(--kc-bevel-hi),
        inset -1px -1px 0 var(--kc-bevel-lo),
        1px 1px 0 var(--kc-skirt-c),
        1px 2px 0 var(--kc-lip),
        2px 3px 2px -1px var(--kc-contact);
    }
    .look-band :global([data-car-next]:active:not(:disabled)),
    .look-band :global([data-car-next][data-pressed]) {
      transform: translate(calc(1px - var(--kc-sx)), calc(var(--kc-sy) - 2px));
      box-shadow:
        inset -1px 1px 0 var(--kc-bevel-hi),
        inset 1px -1px 0 var(--kc-bevel-lo),
        -1px 1px 0 var(--kc-skirt-c),
        -1px 2px 0 var(--kc-lip),
        -2px 3px 2px -1px var(--kc-contact);
    }
    .look-band :global(.car-btn:focus-visible) {
      border-color: var(--kc-seam);
      background: linear-gradient(180deg, var(--kc-face-hi), var(--kc-face));
      outline: 2px solid var(--kc-ink);
      outline-offset: 3px;
    }
    .look-band :global(.car-btn:disabled) {
      opacity: 1;
      cursor: default;
      background: linear-gradient(180deg, var(--kc-face-hi), var(--kc-face));
    }
    .look-band :global(.car-btn:disabled)::after {
      background: var(--kc-ghost);
    }
  }
  /* phones: no keys — the picture swipes (the chassis's own touch) and
     pinches; while a pinch is live the zoomed picture lifts over the
     placard, the view opens, and the section clips sideways so nothing
     widens the page */
  @media (max-width: 899px) {
    .look-band :global(.car-nav) {
      display: none;
    }
  }
  @media (pointer: coarse) {
    .lk-img {
      touch-action: pan-y;
    }
  }
  .lk-img[data-zoom] {
    position: relative;
    z-index: 3;
    transform-origin: 0 0;
  }
  .lk-img[data-ease] {
    transition: transform 220ms ease;
  }
  .look-band[data-pinch] {
    overflow-x: clip;
  }
  .look-band[data-pinch] :global(.car-view) {
    overflow: visible;
  }
  @media (prefers-reduced-motion: reduce) {
    .look-band :global(.car-btn),
    .look-band :global(.car-btn)::after,
    .lk-img[data-ease] {
