</style>

<script>
  import { tapeCrt } from "./tape-crt";
  import { setNight } from "../../lib/night-reveal";
  // The sidebar is always present; the spy lights the row of the object on
  // the screen's centre line and the comet's bead sits on that row's knot
  // (THE COMET LAW, below: one rAF-coalesced update per scrolled frame).
  const rail = document.querySelector<HTMLElement>("[data-rail]");
  // ONE source of truth shared by the spy, the rows, and the comet: the
  // rail's targets in layout order, and each row's place on the comet's
  // track. The bead and the highlight both derive from these; they cannot
  // disagree. The targets (2026-10-13) are the builds' SHEETS
  // (#build-archive, #build-watch, #build-studio once it exists), the play
  // room, illustrations and music (#soundlab); the phone bar's "builds"
  // (#work) is lit by containment and data-holds, never by a second list.
  // Computed FRESH each call: the mobile flex order makes layout position
  // width-dependent, so a one-time snapshot goes stale when the viewport
  // crosses 900px (tablet rotation; review, 2026-08-25). Sorted by the
  // box's top on screen (the sheets' offsetTop is relative to their room).
  // Only targets that are laid out count: the play room is display:none where
  // the instrument cannot play (phones, coarse pointers — 2026-09-22), and a
  // hidden room would sort first at 0 and take a knot and a row.
  // A row whose target is not on the page is no row at all (2026-10-13: the
  // studio sheet's entry is in the nav data before its section exists; the
  // build-time SHOW filter is the first guard, this is the second). A list
  // left empty goes too.
  document.querySelectorAll<HTMLElement>("[data-rail] [data-for], [data-mbar] [data-for]").forEach((el) => {
    if (!document.getElementById(el.dataset.for as string)) (el.closest("li") ?? el).style.display = "none";
  });
  rail?.querySelectorAll<HTMLElement>(".rail-list").forEach((ul) => {
    if (Array.from(ul.children).every((li) => (li as HTMLElement).style.display === "none")) {
      ul.style.display = "none";
    }
  });
  const topOf = (id: string) => document.getElementById(id)?.getBoundingClientRect().top ?? 0;
  const getDocIds = () =>
    rail
      ? Array.from(rail.querySelectorAll<HTMLElement>("[data-for]"))
          .map((el) => el.dataset.for as string)
          .filter((id) => document.getElementById(id)?.offsetParent != null)
          .sort((a, b) => topOf(a) - topOf(b))
      : [];
  // A row's knot: its centre as a fraction of the comet's track (the rows
  // are a plain centred column since 2026-10-13, so the knot is read off the
  // row itself, never computed beside it). 0.5 where the rail is not laid out.
  const fyOf = (id: string) => {
    const t = rail?.querySelector<HTMLElement>("[data-comet]")?.getBoundingClientRect();
    const r = rail?.querySelector<HTMLElement>(`[data-for="${id}"]`)?.getBoundingClientRect();
    if (!t || !r || t.height <= 0 || r.height <= 0) return 0.5;
    return Math.min(1, Math.max(0, (r.top + r.height / 2 - t.top) / t.height));
  };
  if (rail) {
    // THE COMET LAW (Jon, 2026-10-13 round six: "ohhhh I like that and it
    // makes things so much more simple"). The bead sits EXACTLY on a row's
    // knot the whole time that row is lit, and travels only across the ground
    // between two objects. For the targets T1..Tn of getDocIds() (sheets and
    // rooms by on-screen top, and since round seven #end, whose "row" is the
    // résumé pill) and one REFERENCE LINE, the screen's centre (phones: the
    // centre of <main>, the scroller there):
    //   · Ti is ACTIVE while its box spans the line (top ≤ line ≤ bottom):
    //     its row is lit, the bead on its knot (fyOf);
    //   · in the ground between Ti and Ti+1, p = (line − bottom_i) /
    //     (top_i+1 − bottom_i): the bead rides fy_i → fy_i+1 by p, and the lit
    //     row is Ti while p < 0.5, Ti+1 from 0.5 on (the bead is always nearer
    //     the lit row than the other);
    //   · ROUND SEVEN (Jon, 2026-10-13: "the comet scroll needs to be at the
    //     top when at the top of the page" / "at the bottom … go down to
    //     résumé"): the hero is a virtual T0 whose knot is the track's TOP
    //     and which lights nothing, so the bead rides from the top to
    //     audiodex through the first ground; the end room is Tn, its knot the
    //     pill at the track's foot, the pill lit while it spans the line;
    //   · THE HICCUP (round seven, Jon: "flashing back to the previous
    //     section's highlight state, and back to the current one"): the state
    //     is ONE number s (= i on Ti, i + p in the ground after it) and it
    //     only moves the way the page is scrolling: within a scroll, a frame
    //     whose geometry says otherwise (a box that moved under the line: a
    //     picture landing, an eased height, an engine without scroll
    //     anchoring) holds the last state, and the true state settles once
    //     the scroll rests (160ms without a scroll event). The
    //     lit item flips with a little hysteresis: at p = 0.55 going down and
    //     0.45 going up, so a line resting at a gap's midpoint (sub-pixel
    //     offsets, a momentum tail) cannot flicker between two rows;
    //   · a target FRAMED (its top within a pixel of its scroll-margin-top,
    //     where its row's click lands it) counts as active even when it is too
    //     short to reach the line (a guard: at every size measured each target
    //     spans the line when framed, so it never fires there).
    // Containment and data-holds still light the phone bar's "builds" (#work)
    // for the sheets it holds. Every scroll (document or <main>) schedules ONE
    // update per frame; it reads boxes, then writes the bead's --p and the lit
    // rows only when they changed. The knots, the framed offsets and the
    // scroller are measured on load, resize and any change to the page's
    // height (ResizeObserver), never per frame.
    const items = Array.from(
      document.querySelectorAll<HTMLElement>("[data-rail] [data-for], [data-mbar] [data-for]")
    ).map((el) => ({ id: el.dataset.for as string, holds: (el.dataset.holds ?? "").split(" "), el }));
    const comet = rail.querySelector<HTMLElement>("[data-comet]");
    const main = document.querySelector<HTMLElement>("main");
    // the work room itself (the skip link, the cue, the phone bar's "builds")
    // frames the FIRST build's object centred on screen (Jon, 2026-09-24;
    // AudioDex since 2026-10-10): its scroll-margin-top is set live
    const frameWork = () => {
      const work = document.getElementById("work");
      const obj = document.querySelector<HTMLElement>("#build-archive .adx-pair");
      if (!work || !obj) return;
      const centre = obj.getBoundingClientRect().top - work.getBoundingClientRect().top + obj.offsetHeight / 2;
      work.style.scrollMarginTop = Math.max(0, Math.round(window.innerHeight / 2 - centre)) + "px";
    };
    let fy = new Map<string, number>(); // each row's knot (fyOf)
    let smt = new Map<string, number>(); // each target's framed top (scroll-margin-top)
    let inMain = false; // phones: <main> scrolls, the document is frozen
    const measure = () => {
      frameWork();
      const ids = getDocIds();
      fy = new Map(ids.map((id) => [id, fyOf(id)]));
      smt = new Map(ids.map((id) => [id, parseFloat(getComputedStyle(document.getElementById(id)!).scrollMarginTop) || 0]));
      inMain = !!main && main.scrollHeight > main.clientHeight + 1 && /auto|scroll/.test(getComputedStyle(main).overflowY);
      const span = document.documentElement.scrollHeight - window.innerHeight;
      if (comet) {
        if (span > 4) comet.setAttribute("data-scrollable", "");
        else comet.removeAttribute("data-scrollable");
      }
    };
    // the law itself, as one number s along the targets (round seven):
    // T0 = the hero (knot 0, the track's top, lights nothing), then the
    // sheets and rooms of getDocIds(), the last being #end (its knot is the
    // résumé pill's, fyOf("end")). s = i while Ti spans the line (or is
    // framed); in the ground between Ti and Ti+1, s = i + p.
    const hero = document.querySelector<HTMLElement>(".hero");
    type Stop = { id: string | null; k: number };
    const scrollPos = () => (inMain && main ? main.scrollTop : window.scrollY);
    const locate = (): { stops: Stop[]; s: number } | null => {
      const ids = getDocIds();
      if (ids.length === 0) return null;
      const line = inMain && main
        ? main.getBoundingClientRect().top + main.clientHeight / 2
        : window.innerHeight / 2;
      const bx: (Stop & { top: number; bottom: number; framed: boolean })[] = [];
      if (hero && hero.offsetParent != null) {
        const r = hero.getBoundingClientRect();
        bx.push({ id: null, k: 0, top: r.top, bottom: r.bottom, framed: false });
      }
      for (const id of ids) {
        const r = document.getElementById(id)!.getBoundingClientRect();
        bx.push({ id, k: fy.get(id) ?? fyOf(id), top: r.top, bottom: r.bottom, framed: Math.abs(r.top - (smt.get(id) ?? 0)) <= 1 });
      }
      const stops = bx.map(({ id, k }) => ({ id, k }));
      // THE START (round ten, Jon: the comet "exists upon loading … and
      // moves down in correlation to the scroll until you get to audiodex"):
      // from the first pixel of scroll the bead travels from the track's top
      // toward the first knot, arriving exactly as the first target reaches
      // the line; nothing is lit on the way
      if (bx.length > 1 && bx[0].id === null && line < bx[1].top) {
        const pos = scrollPos();
        const rest = bx[1].top - line;
        return { stops, s: Math.max(0, Math.min(1, pos / (pos + rest))) };
      }
      for (let i = 0; i < bx.length; i++) {
        const b = bx[i];
        if ((b.top <= line && line <= b.bottom) || (b.framed && b.bottom < line)) return { stops, s: i };
      }
      if (line < bx[0].top) return { stops, s: 0 };
      for (let i = 0; i < bx.length - 1; i++) {
        const a = bx[i], b = bx[i + 1];
        if (a.bottom < line && line < b.top) return { stops, s: i + (line - a.bottom) / (b.top - a.bottom) };
      }
      return { stops, s: bx.length - 1 };
    };
    const HYS = 0.05; // the flip's band: 0.55 going down, 0.45 going up
    let litNow: string | null | undefined;
    let pNow = "";
    let sNow: number | null = null;
    let posNow = 0;
    let lastScrollAt = -1e9;
    const update = (settle = false) => {
      const L = locate();
      if (!L) return;
      const { stops } = L;
      let s = L.s;
      const pos = scrollPos();
      const dir = Math.sign(pos - posNow);
      posNow = pos;
      // within a scroll the state only moves the way the page moves; a frame
      // that says otherwise (or a geometry change mid-gesture) holds, and
      // the settle (scrollend / the timer) applies the true state
      if (!settle && sNow !== null && sNow <= stops.length - 1) {
        if ((dir > 0 && s < sNow) || (dir < 0 && s > sNow)) s = sNow;
        else if (dir === 0 && performance.now() - lastScrollAt < 200) s = sNow;
      }
      sNow = s;
      const i = Math.min(Math.floor(s), stops.length - 1);
      const t = s - i;
      const p = t > 0 && i + 1 < stops.length ? stops[i].k + t * (stops[i + 1].k - stops[i].k) : stops[i].k;
      if (comet) {
        const v = p.toFixed(5);
        if (v !== pNow) { pNow = v; comet.style.setProperty("--p", v); }
        // the ends: "top" while the bead waits at the track's top (the hero),
        // "end" once it has reached the last knot (the résumé button)
        const stage = s <= 0 ? "top" : s >= stops.length - 1 ? "end" : "mid";
        const rail = comet.closest(".rail");
        if (rail && rail.getAttribute("data-comet") !== stage) rail.setAttribute("data-comet", stage);
      }
      // the lit stop: the nearer of the two, with the band around 0.5
      let j = i;
      if (t > 0 && i + 1 < stops.length) {
        const cur = litNow === undefined ? -1 : stops.findIndex((x) => x.id === litNow);
        j = t >= 0.5 ? i + 1 : i;
        if (cur === i + 1 && t >= 0.5 - HYS) j = i + 1;
        if (cur === i && t < 0.5 + HYS) j = i;
        if (i === 0 && stops[0].id === null) j = 0; // the hero's span lights nothing until the first target takes the line
      }
      const lit = stops[j].id;
      if (lit === litNow) return;
      litNow = lit;
      // a row is lit when its target IS the active one or HOLDS it: the
      // phone bar's "builds" (#work) holds the work room's two sheets, and
      // names every build in data-holds (the studio sheet has its own room);
      // the pills (rail and bar, data-for="end") light for the end room
      const hot = lit ? document.getElementById(lit) : null;
      items.forEach(({ id, holds, el }) => {
        if (hot && (id === lit || holds.includes(lit as string) || document.getElementById(id)?.contains(hot))) {
          el.setAttribute("data-on", "");
          el.setAttribute("aria-current", "true");
        } else {
          el.removeAttribute("data-on");
          el.removeAttribute("aria-current");
        }
      });
    };
    let ticking = false;
    let settleT = 0;
    const settle = () => { window.clearTimeout(settleT); update(true); };
    const onScroll = () => {
      lastScrollAt = performance.now();
      window.clearTimeout(settleT);
      settleT = window.setTimeout(settle, 160);
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => { ticking = false; update(); });
    };
    // a geometry change: at rest it applies at once; mid-scroll the settle
    // picks it up when the scroll rests
    const remeasure = () => {
      measure();
      if (performance.now() - lastScrollAt > 200) requestAnimationFrame(settle);
    };
    // Capture phase on the document: scroll/scrollend do not bubble, and on
    // phones the scroller is <main>, not the document (2026-09-21) — capture
    // hears the inner scroller and, at target, the desk's document alike.
    // the state settles when the scroll RESTS: 160ms without a scroll event,
    // in every engine. Not on scrollend: Chrome fires it after each
    // programmatic step and each wheel notch, mid-gesture, and a settle there
    // re-opened the flash-back (round seven, the qa stress trace)
    document.addEventListener("scroll", onScroll, { capture: true, passive: true });
    window.addEventListener("resize", remeasure, { passive: true });
    window.addEventListener("load", () => { measure(); settle(); });
    // the page's height moves while the reader is on it: the modules grow as
    // they run, the folds open, lazy media lands, the instrument re-fits. Any
    // change to the column's height re-measures (the body on desks; on phones
    // the body is frozen to the screen and the column inside <main> moves)
    const ro = new ResizeObserver(remeasure);
    ro.observe(document.body);
    const col = document.querySelector<HTMLElement>("[data-one]");
    if (col) ro.observe(col);
    measure();
    settle();
  }

  // ── NIGHT has ONE source (2026-10-13, Jon: "maybe we don't 'turn off the
  // lights' for power up and allow the user to control that"): the switch at
  // the rail's foot and the bar's moon (persisted — dark-room reading). The
  // instrument's power no longer touches the page's lighting (its own dark
  // standby skin is the device's, power.css).
  const nightRoot = document.documentElement;
  let nightManual = false;
  try { nightManual = localStorage.getItem("studio-night") === "1"; } catch {}
  const applyNight = () => {
    const on = nightManual;
    // THE LIGHTS (2026-10-07): a change a hand made spreads from that hand
    // (night-reveal.ts); a key press spreads from the switch it acted on
    const act = document.activeElement;
    const from = act?.matches?.("[data-night-toggle]")
      ? act
      : Array.from(document.querySelectorAll<HTMLElement>("[data-night-toggle]")).find((b) => b.offsetParent) ?? null;
    setNight(on, () => {
      if (on) nightRoot.setAttribute("data-night", "");
      else nightRoot.removeAttribute("data-night");
      // browser chrome follows the room (same contract as NightBoot/NightSwitch)
      document
        .querySelector('meta[name="theme-color"]')
        ?.setAttribute("content", on ? "#0b0e14" : "#e9e8e5");
    }, from);
  };
  // two switches, one state: the rail's console toggle and the mobile
  // bar's moon both carry data-night-toggle
  const nightBtns = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-night-toggle]"));
  const syncNightBtn = () =>
    nightBtns.forEach((b) => b.setAttribute("aria-pressed", nightManual ? "true" : "false"));
  nightBtns.forEach((b) =>
    b.addEventListener("click", () => {
      nightManual = !nightManual;
      try { localStorage.setItem("studio-night", nightManual ? "1" : "0"); } catch {}
      syncNightBtn();
      applyNight();
    })
  );
  syncNightBtn();
  applyNight();

  // The instrument is observed, never edited — we only read its data-state
  // (its rest scale follows that state in CSS: .sig-stage). Scrolling the
  // instrument out of view powers it off, and so it settles back to 70 %.
  const sgm = document.getElementById("sgm");
  const host = document.querySelector("[data-signal-host]");
  if (sgm && host) {
    const powered = () => {
      const st = sgm.getAttribute("data-state");
      return st === "boot" || st === "on" || st === "live";
    };
    // "Scrolled away" = SIGNAL's WHOLE SHEET has left the viewport. THE LAW LOOSENED (2026-10-22, Jon: "the music
    // should stop when a user leaves the viewport of the instrument, I still think that's true, but given we have
    // directions beneath it, loosen it so they can see the directions and not have to restart it"; the outside read
    // scrolled to how to play and the instrument went dark under the 35 %-of-the-screen rule of 2026-10-07): the
    // measure is the sheet's own (.sc: the device AND how to play) intersection ratio; under 0.08 for 160 ms it
    // powers down (a bounce at the edge never fires), anywhere inside the sheet it never does.
    const sheet = host.querySelector<HTMLElement>("[data-signal-card]") ?? host;
    const steps = Array.from({ length: 101 }, (_, i) => i / 100);
    let ratio = 1;
    let away: ReturnType<typeof setTimeout> | null = null;
    new IntersectionObserver(([e]) => {
      ratio = e.intersectionRatio;
      if (ratio >= 0.08) { if (away) { clearTimeout(away); away = null; } return; }
      if (away || !powered()) return;
      away = setTimeout(() => {
        away = null;
        if (ratio < 0.08 && powered()) document.getElementById("pwr")?.click(); // the machine's own powerdown path
      }, 160);
    }, { threshold: steps }).observe(sheet);
  }

  // ── the instrument's FIT zoom (styled from outside the sacred file; R3,
  // the /signal page's own law, mirrored): zoom = min(0.98 · available ÷
  // 1280, (the viewport's height − the room's padding) ÷ the device's own
  // height), where `available` is the CONTENT box of .sig-desktop (round
  // four: the stage now stands inside the sheet, narrower than the device it
  // carries powered; the desktop box is the width the stage itself had when
  // it stood outside the sheet, so the full fit is unchanged and the powered
  // device overhangs the paper). The device stands at 97–99 % of the column
  // wherever the height allows; on a short screen the height binds and
  // the whole device still shows in its room. The old height-cap table is
  // retired. Re-fires resize when the zoom changes so the comet's knots and
  // the rail map re-measure the new page height. It also hands the stage its
  // laid-out height (--sig-h, the full fit's: the rest scale's margin reads
  // it), on a fit only, never per frame.
  const sigHost = document.querySelector<HTMLElement>(".live-signal");
  const sigBox = sigHost?.querySelector<HTMLElement>(".sig-desktop");
  const sigWrap = sigBox?.querySelector<HTMLElement>(".sgm")?.parentElement ?? null;
  const sigDev = sigBox?.querySelector<HTMLElement>(".sgm > .device") ?? null;
  if (sigHost && sigBox && sigWrap && sigDev) {
    const REF = 1280; // = src/signal/types.ts DEVICE_W
    const WIDTH_SHARE = 0.98;
    let last = "";
    let lastH = "";
    const fit = () => {
      const cs = getComputedStyle(sigBox);
      const w = sigBox.clientWidth - (parseFloat(cs.paddingLeft) || 0) - (parseFloat(cs.paddingRight) || 0);
      if (w <= 0) return; // hidden (touch layout) — nothing to fit
      const reserve = 60; // the room's ground above and below the device (it may stand into the room's padding)
      const h = sigDev.offsetHeight || 878; // unzoomed (offsetHeight ignores zoom); 878 = types.ts DEVICE_H (THE BOW)
      const z = Math.max(0.25, Math.min((WIDTH_SHARE * w) / REF, Math.max(120, window.innerHeight - reserve) / h)).toFixed(4);
      const zoomed = z !== last;
      if (zoomed) {
        last = z;
        sigHost.style.setProperty("--sig-zoom", z);
      }
      // the stage's layout height at the full fit (a transform never moves it)
      const sh = `${sigWrap.offsetHeight}px`;
      if (sh !== lastH) {
        lastH = sh;
        sigWrap.style.setProperty("--sig-h", sh);
      }
      if (zoomed) window.dispatchEvent(new Event("resize"));
    };
    // deferred to the next frame: a fit written inside an observation re-sizes the observed device in the same
    // frame (WebKit: "ResizeObserver loop completed with undelivered notifications")
    let sigQueued = 0;
    const sigLater = () => { if (!sigQueued) sigQueued = requestAnimationFrame(() => { sigQueued = 0; fit(); }); };
    fit();
    // the measure's WIDTH only (its height moves with the 400 ms rest-scale ease: no fit per frame)
    let boxW = -1;
    new ResizeObserver(([e]) => {
      const bw = Math.round(e.contentRect.width * 10);
      if (bw !== boxW) { boxW = bw; sigLater(); }
    }).observe(sigBox);
    new ResizeObserver(sigLater).observe(sigWrap);
    new ResizeObserver(sigLater).observe(sigDev);
    window.addEventListener("resize", sigLater, { passive: true });
  }

  // ── FIRST SETTLE (2026-09-22, Jon: "guarantee the exhibits' info is seen
  // … what if someone doesn't understand step one"). When an object settles
  // in view — mostly on screen, the scroll at rest, a beat of stillness — it
  // takes its own first step, ONCE per page load, and any touch hands it
  // back. No words, no loops; reduced motion takes each module's own reduced
  // path. A pointer MOVING over an object is reaching for it: the beat WAITS
  // until the pointer is still or gone, then goes (it never gives up while
  // the object is on screen). (2026-09-23: once per load, not per tab —
  // sessionStorage kept a reload from ever showing it again.)
  // Since 2026-10-13 only the listen room's wallet uses it (Jon: "the auto
  // initiation of the watch/phone and their sheets should all be removed"):
  // the watch and the phone run only when a visitor presses them.
  const settleMem = new Set<string>();
  const wasShown = (k: string) => settleMem.has(k);
  const markShown = (k: string) => { settleMem.add(k); };
  let lastScroll = 0;
  document.addEventListener("scroll", () => { lastScroll = performance.now(); }, { capture: true, passive: true });
  const reachAt = new WeakMap<Element, number>();
  const watchReach = (el: Element) =>
    el.addEventListener("pointermove", (e) => {
      const p = e as PointerEvent;
      if (p.pointerType === "mouse" && (p.movementX || p.movementY)) reachAt.set(el, performance.now());
    }, { passive: true });
  const reaching = (el: Element) => el.matches(":hover") && performance.now() - (reachAt.get(el) ?? -1e9) < 1000;
  const settleReduce = window.matchMedia("(prefers-reduced-motion: reduce)");
  const firstSettle = (target: Element, o: {
    ratio: number; grace: number;
    ok: () => boolean; wait?: () => boolean; fire: () => void; leave?: () => void;
  }) => {
    let timer = 0;
    let inView = false;
    const arm = () => {
      window.clearTimeout(timer);
      if (!inView) return;
      const idle = performance.now() - lastScroll;
      if (idle < 160) { timer = window.setTimeout(arm, 170 - idle); return; }
      const t0 = performance.now();
      timer = window.setTimeout(() => {
        if (!inView) return;
        if (lastScroll > t0) return arm(); // they moved again: start the beat over
        if (!o.ok()) return;
        // hidden tab or a hand on its way: hold the beat and look again
        if (document.visibilityState !== "visible" || o.wait?.()) { timer = window.setTimeout(arm, 300); return; }
        o.fire();
      }, o.grace);
    };
    new IntersectionObserver((entries) => {
      const r = entries[entries.length - 1].intersectionRatio;
      inView = r >= o.ratio;
      if (inView) arm();
      else window.clearTimeout(timer);
      if (r < 0.3) o.leave?.();
    }, { threshold: [0, 0.01, 0.3, o.ratio] }).observe(target);
  };

  // ── AUDIO: the cassette is the switch. Each tape's button clicks the
  // Transport's own (hidden) toggle inside the same slide, so the tap
  // keeps its activation for audio.play(); the slide mirrors the audio's
  // play/pause as data-playing (the hubs turn on it, the lamp lights) and
  // the button's name flips. The deck's prev/next keys (two tapes or
  // more) drive the carousel's own chassis buttons; mechanics untouched.
  const auRoom = document.getElementById("soundlab");
  if (auRoom) {
    // ── THE VOLUME (2026-10-07): one level for every tape, kept per viewer.
    // The fader's position is the level; the audio hears its square (a
    // level feels even along the travel). Drag or click the band, or the
    // arrows / Page / Home / End once focused; a mouse never leaves focus on
    // it (the page's keys stay the page's), and there is no wheel. Where a
    // page cannot set a level (iOS fixes media volume at 1) it never shows.
    const faders = Array.from(auRoom.querySelectorAll<HTMLElement>("[data-au-vol]"));
    const tapesAudio = () => Array.from(auRoom.querySelectorAll<HTMLAudioElement>("[data-tp-audio]"));
    const VOL_KEY = "uxj-tape-vol";
    const probe = document.createElement("audio");
    probe.volume = 0.5;
    if (probe.volume !== 0.5) auRoom.querySelector(".au")?.toggleAttribute("data-novol", true);
    let vol = 1;
    try { const v = parseFloat(localStorage.getItem(VOL_KEY) ?? ""); if (v >= 0 && v <= 1) vol = v; } catch {}
    const setVol = (v: number, save = true) => {
      vol = Math.round(Math.min(1, Math.max(0, v)) * 100) / 100;
      tapesAudio().forEach((a) => { a.volume = vol * vol; });
      const pct = String(Math.round(vol * 100));
      faders.forEach((f) => {
        f.style.setProperty("--vol", String(vol));
        f.setAttribute("aria-valuenow", pct);
        f.setAttribute("aria-valuetext", vol === 0 ? "muted" : `${pct}%`);
      });
      if (save) { try { localStorage.setItem(VOL_KEY, String(vol)); } catch {} }
    };
    // a tape that loads later starts at the room's level
    tapesAudio().forEach((a) => a.addEventListener("loadedmetadata", () => { a.volume = vol * vol; }));
    faders.forEach((f) => {
      const at = (y: number) => { const r = f.getBoundingClientRect(); return (r.bottom - y) / r.height; };
      f.addEventListener("pointerdown", (e) => {
        if (e.button !== 0) return;
        // (no preventDefault: it would also swallow the mousemoves the site's cursor dot follows; the
        // pointer's focus is dropped on release instead, and the band selects no text)
        f.setPointerCapture(e.pointerId);
        f.toggleAttribute("data-dragging", true);
        setVol(at(e.clientY));
      });
      f.addEventListener("pointermove", (e) => { if (f.hasPointerCapture(e.pointerId)) setVol(at(e.clientY)); });
      const end = (e: PointerEvent) => {
        if (f.hasPointerCapture(e.pointerId)) f.releasePointerCapture(e.pointerId);
        f.removeAttribute("data-dragging");
        f.blur(); // a pointer never leaves focus here: the page's keys stay the page's
      };
      f.addEventListener("pointerup", end);
      f.addEventListener("pointercancel", end);
      f.addEventListener("keydown", (e) => {
        const step = ({ ArrowUp: 0.05, ArrowRight: 0.05, ArrowDown: -0.05, ArrowLeft: -0.05, PageUp: 0.2, PageDown: -0.2 } as Record<string, number>)[e.key];
        if (step !== undefined) setVol(vol + step);
        else if (e.key === "Home") setVol(0);
        else if (e.key === "End") setVol(1);
        else return;
        e.preventDefault();
      });
    });
    setVol(vol, false);

    auRoom.querySelectorAll<HTMLElement>(".ls").forEach((ls) => {
      const tape = ls.querySelector<HTMLButtonElement>("[data-cs-tape]");
      const toggle = ls.querySelector<HTMLButtonElement>("[data-tp-toggle]");
      const audio = ls.querySelector<HTMLAudioElement>("[data-tp-audio]");
      if (!tape || !toggle || !audio) return;
      const title = tape.getAttribute("aria-label")?.replace(/^Play /, "") ?? "";
      tape.addEventListener("click", () => toggle.click());
      const live = (on: boolean) => {
        ls.toggleAttribute("data-playing", on);
        tape.setAttribute("aria-label", `${on ? "Pause" : "Play"} ${title}`);
        tapeCrt(ls, on); // the label runs through a CRT while the tape plays
      };
      audio.addEventListener("play", () => live(true));
      audio.addEventListener("pause", () => live(false));
      audio.addEventListener("ended", () => live(false));
      // the display in the window shows the Transport's (hidden) counter,
      // and the seek slider announces the same ("0:10 of 3:30") rather
      // than a bare second count (Transport untouched: mirrored from here)
      const wave = ls.querySelector<HTMLElement>("[data-tp-wave]");
      const time = ls.querySelector<HTMLElement>("[data-tp-time]");
      const screen = ls.querySelector<HTMLElement>("[data-cs-time]");
      if (wave && time) {
        const say = () => {
          const now = time.textContent!.trim();
          if (screen) screen.textContent = now;
          wave.setAttribute("aria-valuetext", now.replace(/\s*\/\s*/, " of "));
        };
        say();
        audio.addEventListener("timeupdate", say);
        audio.addEventListener("ended", say);
      }
    });
    // ── THE WALLET (2026-09-18, Jon): the dropdown is a miniature tape at
    // the placard's left; press it and the tapes drop down under it as a
    // vertical strip of sleeves. Hover / focus on a sleeve prints that
    // tape's title and note into the placard (data-preview → the dim ink);
    // choosing one loads it into the deck (car:show k + 1 — slide 0 is the
    // empty deck), where the tape itself is the play switch. Every slide
    // carries its own wallet; car:change keeps them in step. A mouse press
    // opens without moving focus (a hover is the preview); the keyboard
    // opens INTO the strip. Esc / outside / Tab close.
    const auCar = auRoom.querySelector<HTMLElement>("[data-carousel]");
    const auSlides = Array.from(auRoom.querySelectorAll<HTMLElement>(".ls"));
    const wallets = auSlides.map((ls) => ({
      ls,
      len: ls.querySelector<HTMLElement>("[data-cs-len]"),
      head: ls.querySelector<HTMLElement>("[data-ls-placard]"),
      title: ls.querySelector<HTMLElement>("[data-ls-title]"),
      note: ls.querySelector<HTMLElement>("[data-ls-note]"),
      pick: ls.querySelector<HTMLButtonElement>("[data-wl-pick]"),
      strip: ls.querySelector<HTMLElement>("[data-wl-strip]"),
      options: Array.from(ls.querySelectorAll<HTMLElement>("[data-wl-option]")),
      open: null as null | ((into: boolean) => void),
    }));
    const WL_KEY = "uxj-wl-shown";
    // every control of a strip (the mini; on the empty deck the blank tape
    // too) reports the same state
    const expanded = (w: (typeof wallets)[number], on: boolean) => {
      if (!w.strip) return;
      w.ls.querySelectorAll(`[aria-controls="${w.strip.id}"]`).forEach((b) => b.setAttribute("aria-expanded", on ? "true" : "false"));
    };
    // a hand that lands on the wallet while it is peeking takes it over
    // (the press that follows must not toggle it shut)
    let tookOver = 0;
    const tookIt = () => performance.now() - tookOver < 700;
    // each slide's own words, kept so a preview can be undone
    const own = wallets.map((w) => ({ title: w.title?.textContent ?? "", note: w.note?.textContent ?? "" }));
    let active = 0;
    const print = (slide: number, words: number, preview: boolean) => {
      const w = wallets[slide];
      const o = own[words];
      if (!w || !o) return;
      if (w.title) w.title.textContent = o.title;
      if (w.note) w.note.textContent = o.note;
      w.head?.toggleAttribute("data-preview", preview);
    };
    // the window reads the hovered tape's length at the play mark's scale
    // (Jon, 2026-09-22); null clears it back to the mark (or the counter)
    const lengths = (wallets[0]?.options ?? []).map((o) => o.getAttribute("data-wl-length") ?? "");
    const showLen = (slide: number, k: number | null) => {
      const w = wallets[slide];
      if (!w) return;
      const len = k === null ? "" : lengths[k] ?? "";
      if (w.len) w.len.textContent = len;
      w.ls.toggleAttribute("data-len", len !== "");
    };
    const restore = () => { print(active, active, false); showLen(active, null); };
    // sleeve k holds tape k, which lives in slide k + 1; the tape already
    // in the deck is no preview — the words are the slide's own — but the
    // window still reads its length
    const preview = (k: number) => { print(active, k + 1 === active ? active : k + 1, k + 1 !== active); showLen(active, k); };
    const closeAll = (focusPick = false) =>
      wallets.forEach((w) => {
        if (!w.pick || !w.strip || w.strip.hidden) return;
        w.strip.hidden = true;
        w.strip.removeAttribute("data-fold");
        expanded(w, false);
        if (focusPick) w.pick.focus();
      });
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    // the chosen sleeve's mini takes the slot: a clone slides from the
    // sleeve to the pick while the deck prints (it rides the departing
    // slide, so the crossfade retires it as the new slide's mini arrives)
    const fly = (k: number) => {
      const w = wallets[active];
      const from = w?.options[k]?.querySelector<HTMLElement>(".mini");
      const to = w?.pick?.querySelector<HTMLElement>(".mini");
      if (reduce || !w?.head || !from || !to) return;
      const hb = w.head.getBoundingClientRect();
      const fb = from.getBoundingClientRect();
      const tb = to.getBoundingClientRect();
      const ghost = from.cloneNode(true) as HTMLElement;
      ghost.classList.add("wl-fly");
      ghost.style.left = `${fb.left - hb.left}px`;
      ghost.style.top = `${fb.top - hb.top}px`;
      const opt = w.options[k];
      ghost.style.setProperty("--mini-tint", opt.style.getPropertyValue("--mini-tint"));
      ghost.style.setProperty("--mini-tint-night", opt.style.getPropertyValue("--mini-tint-night"));
      w.head.appendChild(ghost);
      requestAnimationFrame(() => (ghost.style.transform = `translate(${tb.left - fb.left}px, ${tb.top - fb.top}px)`));
      ghost.addEventListener("transitionend", () => ghost.remove(), { once: true });
      window.setTimeout(() => ghost.remove(), 700);
    };
    const choose = (k: number) => {
      if (k + 1 !== active) fly(k);
      closeAll();
      if (k + 1 !== active) auCar?.dispatchEvent(new CustomEvent("car:show", { detail: { index: k + 1 } }));
      requestAnimationFrame(() => wallets[k + 1]?.pick?.focus());
    };
    const isTouch = (e: PointerEvent) => e.pointerType === "touch";
    wallets.forEach((w) => {
      const { pick, strip, options } = w;
      if (!pick || !strip) return;
      const open = (into: boolean) => {
        closeAll();
        strip.hidden = false;
        expanded(w, true);
        markShown(WL_KEY); // opened (by a hand or by its own settle): never peeks again this visit
        if (into) (options.find((o) => o.getAttribute("aria-selected") === "true") ?? options[0])?.focus();
      };
      w.open = open;
      // a keyboard "click" (Enter / Space) arrives with detail 0
      pick.addEventListener("click", (e) => {
        if (!strip.hidden && tookIt()) return;
        if (strip.hidden) open(e.detail === 0);
        else closeAll(true);
      });
      pick.addEventListener("keydown", (e) => {
        if (e.key === "ArrowDown" || e.key === "ArrowUp") { e.preventDefault(); open(true); }
      });
      options.forEach((o, k) => {
        o.addEventListener("click", () => choose(k));
        o.addEventListener("pointerenter", (e) => { if (!isTouch(e)) preview(k); });
        o.addEventListener("pointerleave", (e) => { if (!isTouch(e)) restore(); });
        o.addEventListener("focus", () => preview(k));
        o.addEventListener("blur", restore);
        o.addEventListener("keydown", (e) => {
          const n = options.length;
          if (e.key === "ArrowDown") { e.preventDefault(); options[(k + 1) % n].focus(); }
          else if (e.key === "ArrowUp") { e.preventDefault(); options[(k - 1 + n) % n].focus(); }
          else if (e.key === "Home") { e.preventDefault(); options[0].focus(); }
          else if (e.key === "End") { e.preventDefault(); options[n - 1].focus(); }
          else if (e.key === "Enter" || e.key === " ") { e.preventDefault(); choose(k); }
          else if (e.key === "Escape") { e.preventDefault(); closeAll(true); }
          else if (e.key === "Tab") closeAll();
        });
      });
    });
    document.addEventListener("pointerdown", (e) => {
      if (!(e.target as Element | null)?.closest?.("[data-wl]")) closeAll();
    });

    // THE WALLET SHOWS ITSELF ONCE (first settle, 2026-09-22): when the empty
    // deck settles in view, the mini seats as if pressed and the strip drops
    // open with its own animation. Where it would cover the tape (phones,
    // desks under 1160px) it folds back after a moment; on wide desks it
    // hangs open in the empty ground beside the column until an outside
    // press, Esc, or the room leaves. Any hand ends the peek: on the wallet
    // it becomes theirs, anywhere else it closes. No words change.
    let peeking = false;
    let peekTimers: number[] = [];
    const endPeek = () => {
      peekTimers.forEach((t) => window.clearTimeout(t));
      peekTimers = [];
      peeking = false;
      wallets[0]?.pick?.removeAttribute("data-seat");
    };
    const fold = () => {
      const w = wallets[0];
      if (!w?.strip || w.strip.hidden || settleReduce.matches) { closeAll(); return endPeek(); }
      w.strip.setAttribute("data-fold", "");
      peekTimers.push(window.setTimeout(() => { closeAll(); endPeek(); }, 170));
    };
    ["pointerdown", "keydown"].forEach((t) =>
      document.addEventListener(t, (e) => {
        if (!peeking) return;
        const inside = (e.target as Element | null)?.closest?.("[data-wl]");
        endPeek();
        if (inside && !wallets[0]?.strip?.hidden) tookOver = performance.now();
        else closeAll();
      }, { capture: true })
    );
    // the empty tape is the wallet's second door: a press opens (or closes)
    // the same strip the mini does; a mouse press opens without moving focus,
    // a keyboard press (detail 0) opens into the strip
    const blankTape = auRoom.querySelector<HTMLButtonElement>("[data-blank-tape]");
    blankTape?.addEventListener("click", (e) => {
      const w = wallets[0];
      if (!w?.strip || !w.open) return;
      if (!w.strip.hidden && tookIt()) return;
      if (w.strip.hidden) w.open(e.detail === 0);
      else closeAll();
    });
    // the sleeves' covers are lazy inside a hidden strip: warm them when the
    // room first shows, so the peek never opens on blank labels
    let warmed = false;
    new IntersectionObserver((es, obs) => {
      if (warmed || !es.some((e) => e.isIntersecting)) return;
      warmed = true;
      obs.disconnect();
      wallets[0]?.strip?.querySelectorAll<HTMLImageElement>("img[loading=lazy]").forEach((i) => (i.loading = "eager"));
    }, { threshold: 0.1 }).observe(auRoom);
    if (blankTape) {
      watchReach(blankTape);
      firstSettle(blankTape, {
        ratio: 0.6, grace: 600,
        ok: () => active === 0 && !!wallets[0]?.strip?.hidden && !wasShown(WL_KEY),
        wait: () => reaching(blankTape),
        fire: () => {
          const w = wallets[0];
          if (!w?.pick || !w.open) return;
          peeking = true;
          const go = () => {
            w.pick!.removeAttribute("data-seat");
            w.open!(false);
            if (window.innerWidth < 1160) peekTimers.push(window.setTimeout(fold, 2400));
          };
          if (settleReduce.matches) return go();
          w.pick.setAttribute("data-seat", "");
          peekTimers.push(window.setTimeout(go, 120));
        },
        leave: () => { if (peeking) { closeAll(); endPeek(); } },
      });
    }
    // THE TAPE JUMP (2026-10-15): the AudioDex phone's moment ends on "this dinner became a tape ↓"
    // ([data-tape-jump] = the tape's manifest title). A press lands the music room first (its own scroller:
    // main on phones, the document on desks), waits for the scroll to come to rest, then loads that tape into
    // the deck the way a sleeve does (car:show k + 1; slide 0 is the empty deck). The wallet never peeks after.
    document.querySelectorAll<HTMLAnchorElement>("[data-tape-jump]").forEach((a) => {
      a.addEventListener("click", (e) => {
        const k = (wallets[0]?.options ?? []).findIndex((o) => o.textContent?.trim() === a.dataset.tapeJump);
        if (k < 0) return; // no such tape in the wallet: the plain anchor still lands the room
        e.preventDefault();
        markShown(WL_KEY);
        closeAll();
        // the deck framed with air above its placard (the loaded deck stands ~90px taller than the blank one)
        const phone = window.matchMedia("(max-width: 899px)").matches;
        const sc = (phone ? document.querySelector<HTMLElement>("main") : null) ?? (document.scrollingElement as HTMLElement);
        const r = auRoom.getBoundingClientRect();
        const air = phone ? 24 : Math.max(24, Math.round((window.innerHeight - r.height - 90) / 2));
        sc.scrollTo({ top: r.top + sc.scrollTop - air, behavior: reduce ? "auto" : "smooth" });
        // at rest = the room's top unmoved for 8 frames; images loading on the way can leave it short, so one
        // more scroll closes the gap before the tape is picked
        let last = NaN, still = 0, fixes = 0;
        let t0 = performance.now();
        const settle = () => {
          const top = Math.round(auRoom.getBoundingClientRect().top);
          still = top === last ? still + 1 : 0;
          last = top;
          if (still < 8 && performance.now() - t0 < 3000) return void requestAnimationFrame(settle);
          if (Math.abs(top - air) > 4 && fixes++ < 2) {
            sc.scrollBy({ top: top - air, behavior: reduce ? "auto" : "smooth" });
            still = 0; last = NaN; t0 = performance.now();
            return void requestAnimationFrame(settle);
          }
          if (k + 1 !== active) auCar?.dispatchEvent(new CustomEvent("car:show", { detail: { index: k + 1 } }));
          // "hear what it became": the press asked to hear it, so the tape plays once it is in the deck (the
          // tape is the play switch; a browser that refuses leaves it loaded and waiting)
          // it starts at data-tape-at (Jon: the tail of the memo just heard, then the door, then the song); a tape
          // with no metadata yet takes the time as its start position, and gets it again once it knows its length
          if (a.hasAttribute("data-tape-play")) window.setTimeout(() => {
            const tape = auSlides[k + 1]?.querySelector<HTMLButtonElement>("[data-cs-tape]");
            const media = auSlides[k + 1]?.querySelector<HTMLAudioElement>("[data-tp-audio]");
            const at = Number(a.dataset.tapeAt) || 0;
            if (media && at) {
              try { media.currentTime = at; } catch {}
              media.addEventListener("loadedmetadata", () => { if (media.currentTime < at - 1) media.currentTime = at; }, { once: true });
            }
            if (tape && !auSlides[k + 1].hasAttribute("data-playing")) tape.click();
          }, reduce ? 0 : 520);
        };
        document.querySelectorAll<HTMLAudioElement>("[data-adx] audio").forEach((m) => m.pause());
        requestAnimationFrame(settle);
      });
    });
    auCar?.addEventListener("car:change", (e) => {
      active = Number((e as CustomEvent).detail?.index ?? 0);
      closeAll();
      wallets.forEach((w) => w.options.forEach((o, j) => o.setAttribute("aria-selected", j + 1 === active ? "true" : "false")));
      // every placard back to its own words (a departing slide may still
      // carry a preview)
      wallets.forEach((_, i) => { print(i, i, false); showLen(i, null); });
    });

    // THE DECK'S HEIGHT (2026-10-13, Jon: "the spacings should look and feel
    // consistent"): the blank deck is not a tape, so at rest it reserves no
    // placard: the mini, the tape's own margin, the tape, the rail, and the
    // room's first ink is the mini with the tape right under it. The loaded
    // tapes share ONE height (the longest placard's), so between tapes the
    // tape and the rail hold one y. The blank deck takes the tapes' height
    // too while its placard prints a tape's words (a preview) or a hand has
    // its wallet open, so the words never push the tape and a chosen tape
    // arrives exactly where the blank one stood; the first settle's peek
    // alone moves nothing (it seats the mini and opens the strip, as ever). The
    // track carries the height (eased in CSS); the slides stretch to it, the
    // tape riding the bottom of its 1fr row. Measured from the parts' own
    // sizes (the placard, the tape and its margin, the rail and its margin)
    const auTrack = auCar?.querySelector<HTMLElement>("[data-car-track]") ?? null;
    if (auTrack) {
      const auSlidesAll = Array.from(auTrack.children) as HTMLElement[];
      const auBlank = auSlidesAll.find((el) => el.hasAttribute("data-ls-blank")) ?? null;
      const ownH = (el: HTMLElement) => {
        const head = el.querySelector<HTMLElement>(".ls-head");
        const cs = el.querySelector<HTMLElement>(".cs");
        const deck = el.querySelector<HTMLElement>(".ls-deck");
        if (!head || !cs || !deck) return 0;
        // fractional sizes only, none of them moved by the stretch (rounded
        // offsets flip a pixel as the tape rides its row) or by a translate
        return head.getBoundingClientRect().height + parseFloat(getComputedStyle(cs).marginTop) + cs.getBoundingClientRect().height
          + parseFloat(getComputedStyle(deck).marginTop) + deck.getBoundingClientRect().height;
      };
      const auFit = () => {
        const tapesH = Math.max(0, ...auSlidesAll.filter((el) => el !== auBlank).map(ownH));
        const shown = auSlidesAll[active] ?? auSlidesAll[0];
        const strip0 = wallets[0]?.strip;
        const roomy = shown !== auBlank
          || !!wallets[0]?.head?.hasAttribute("data-preview")
          || (!!strip0 && !strip0.hidden && !peeking);
        const h = roomy && tapesH > 0 ? tapesH : ownH(shown);
        if (!h) return;
        if (Math.abs(parseFloat(auTrack.style.height || "0") - h) > 0.5) auTrack.style.height = `${h.toFixed(2)}px`;
      };
      auFit();
      auCar?.addEventListener("car:change", auFit); // after the listener above has set `active`
      const auStrip = wallets[0]?.strip;
      if (auStrip) new MutationObserver(auFit).observe(auStrip, { attributes: true, attributeFilter: ["hidden"] });
      const auHead = wallets[0]?.head;
      if (auHead) new MutationObserver(auFit).observe(auHead, { attributes: true, attributeFilter: ["data-preview"] });
      // a hand ends the peek (the capture listeners above run first): the
      // open strip becomes theirs, and the deck makes room
      ["pointerdown", "keydown"].forEach((t) => document.addEventListener(t, auFit, { capture: true }));
      const auRO = new ResizeObserver(auFit);
      auSlidesAll.forEach((el) => el.querySelectorAll(".ls-head, .cs, .ls-deck").forEach((c) => auRO.observe(c)));
    }
  }

  // ── VISUALS: the keys stand off the PAINTED picture, not its box (the
  // box is the column's width with object-fit: contain; 4:3 and square
  // pieces paint different widths). Measure the active slide's painted
  // width + bottom and hand them to the chassis as --lk-half/--lk-bottom;
  // re-measure on image load, on the box resizing, and on every slide
  // change (the chassis writes track.style.transform in show()).
  const lkRoom = document.getElementById("illustrations");
  const lkCar = lkRoom?.querySelector<HTMLElement>("[data-carousel]") ?? null;
  const lkTrack = lkCar?.querySelector<HTMLElement>("[data-car-track]") ?? null;
  if (lkRoom && lkCar && lkTrack) {
    const lkImgs = Array.from(lkRoom.querySelectorAll<HTMLImageElement>(".lk-img"));
    const lkActive = () => {
      const slide = Array.from(lkTrack.children).find((s) => !s.hasAttribute("aria-hidden")) ?? lkTrack.children[0];
      return slide?.querySelector<HTMLImageElement>(".lk-img") ?? null;
    };
    // Jon (2026-09-09): the keys must NOT move between slides. They stand
    // off the WIDEST picture the set paints (4:3 here; grows if a wider
    // piece loads), so square pieces get a larger gap instead of pulling
    // the keys in. --lk-bottom still follows the active picture (the dots).
    let lkWidest = 4 / 3;
    const lkMeasure = () => {
      const img = lkActive();
      if (!img || !img.naturalWidth || !img.naturalHeight) return;
      const bw = img.clientWidth;
      const bh = img.clientHeight;
      if (!bw || !bh) return;
      lkImgs.forEach((im) => {
        if (im.naturalWidth && im.naturalHeight) lkWidest = Math.max(lkWidest, im.naturalWidth / im.naturalHeight);
      });
      const pwMax = Math.min(bw, bh * lkWidest);
      const ph = Math.min(bh, (bw * img.naturalHeight) / img.naturalWidth);
      const top = img.getBoundingClientRect().top - lkCar.getBoundingClientRect().top;
      lkCar.style.setProperty("--lk-half", `${(pwMax / 2).toFixed(2)}px`);
      lkCar.style.setProperty("--lk-top", `${(top + (bh - ph) / 2).toFixed(2)}px`);
      lkCar.style.setProperty("--lk-bottom", `${(top + (bh + ph) / 2).toFixed(2)}px`);
    };
    lkMeasure();
    lkImgs.forEach((im) => im.addEventListener("load", lkMeasure));
    const lkRO = new ResizeObserver(lkMeasure);
    lkImgs.forEach((im) => lkRO.observe(im));
    new MutationObserver(lkMeasure).observe(lkTrack, { attributes: true, attributeFilter: ["style"] });
    lkCar.addEventListener("car:change", lkMeasure); // dissolve mode writes no transform

    // the stage is the SHOWN slide's height, not the tallest (2026-10-13,
    // one gap from the placard to the music room): the slides sit at the
    // top of the track (CSS above) and keep their own heights, so the active
    // one's box is its picture + placard. Re-fit on every slide change and
    // whenever a slide's own box changes (a picture loading, a resize)
    const lkFit = () => {
      const slide = Array.from(lkTrack.children).find((el) => !el.hasAttribute("aria-hidden")) as HTMLElement | undefined;
      const h = slide ? slide.getBoundingClientRect().height : 0;
      if (!h) return;
      if (Math.abs(parseFloat(lkTrack.style.height || "0") - h) > 0.5) lkTrack.style.height = `${h.toFixed(2)}px`;
    };
    lkFit();
    const lkFitRO = new ResizeObserver(lkFit);
    Array.from(lkTrack.children).forEach((el) => lkFitRO.observe(el));
    lkCar.addEventListener("car:change", lkFit);

    // phones: pinch the picture (the photo app's grammar — two fingers
    // scale it about the pinch point, 1×–3×, it lifts over the placard,
    // and it eases home on release). Captured at the room so the pinch
    // never reaches the chassis's swipe; one-finger swipes still do.
    if (window.matchMedia("(pointer: coarse)").matches) {
      const still = window.matchMedia("(prefers-reduced-motion: reduce)");
      let pImg: HTMLImageElement | null = null;
      let pinched = false;
      let d0 = 1, px = 0, py = 0, rx = 0, ry = 0;
      let settle = 0;
      const span = (t: TouchList) => Math.hypot(t[0].clientX - t[1].clientX, t[0].clientY - t[1].clientY);
      const mid = (t: TouchList) => [(t[0].clientX + t[1].clientX) / 2, (t[0].clientY + t[1].clientY) / 2];
      const release = () => {
        const img = pImg;
        if (!img) return;
        pImg = null;
        img.style.transform = "";
        if (still.matches) {
          img.removeAttribute("data-zoom");
          lkRoom.removeAttribute("data-pinch");
          return;
        }
        img.setAttribute("data-ease", "");
        settle = window.setTimeout(() => {
          img.removeAttribute("data-ease");
          img.removeAttribute("data-zoom");
          lkRoom.removeAttribute("data-pinch");
        }, 240);
      };
      lkRoom.addEventListener("touchstart", (e) => {
        if (e.touches.length !== 2) return;
        const img = (e.target as Element | null)?.closest?.(".lk") ? lkActive() : null;
        if (!img) return;
        e.stopPropagation();
        window.clearTimeout(settle);
        pinched = true;
        pImg = img;
        img.removeAttribute("data-ease");
        img.style.transform = "";
        img.setAttribute("data-zoom", "");
        lkRoom.setAttribute("data-pinch", "");
        const r = img.getBoundingClientRect();
        rx = r.left;
        ry = r.top;
        [px, py] = mid(e.touches);
        d0 = span(e.touches) || 1;
      }, { capture: true, passive: true });
      lkRoom.addEventListener("touchmove", (e) => {
        const img = pImg;
        if (!img || e.touches.length < 2) return;
        e.preventDefault();
        const s = Math.min(3, Math.max(1, span(e.touches) / d0));
        const [mx, my] = mid(e.touches);
        // the point that was under the fingers stays under them
        const tx = mx - rx - (px - rx) * s;
        const ty = my - ry - (py - ry) * s;
        img.style.transform = `translate(${tx.toFixed(1)}px, ${ty.toFixed(1)}px) scale(${s.toFixed(3)})`;
      }, { capture: true, passive: false });
      const lkEnd = (e: TouchEvent) => {
        if (!pinched) return;
        e.stopPropagation();
        if (e.touches.length < 2) release();
        if (e.touches.length === 0) pinched = false;
      };
      lkRoom.addEventListener("touchend", lkEnd, { capture: true });
      lkRoom.addEventListener("touchcancel", lkEnd, { capture: true });
    }
  }
</script>

<script>
  // THE FLIP CLIP (2026-10-23, the thesis): the Studio sheet's one clip plays WITH SOUND on a press of its key only;
  // pressed again it pauses; it never plays off-screen (the frame leaving the viewport pauses it). Nothing autoplays,
  // nothing is muted by default. Nothing to do while the slot is the honest empty frame.
  {
    const slot = document.querySelector<HTMLElement>("#build-studio [data-flip]");
    const v = slot?.querySelector<HTMLVideoElement>(".st-video");
    const k = slot?.querySelector<HTMLButtonElement>(".st-play");
    if (slot && v && k) {
      v.muted = false;
      v.volume = 1;
      const paint = () => { const on = !v.paused && !v.ended; k.setAttribute("aria-pressed", on ? "true" : "false"); k.setAttribute("aria-label", on ? "Pause" : "Play, with sound"); slot.toggleAttribute("data-playing", on); };
      v.addEventListener("play", paint);
      v.addEventListener("pause", paint);
      v.addEventListener("ended", () => { v.currentTime = 0; paint(); });
      k.addEventListener("click", () => { if (v.paused || v.ended) void v.play().catch(() => {}); else v.pause(); });
      const scroller = document.querySelector("main");
      new IntersectionObserver((es) => es.forEach((e) => { if (!e.isIntersecting && !v.paused) v.pause(); }), { root: scroller && getComputedStyle(scroller).overflowY === "auto" ? scroller : null, threshold: 0.2 }).observe(slot);
    }
  }
</script>

<script>
  // THE FOLD (2026-09-24; 2026-10-13, Jon: the hook stays visible, "with the
  // arrow allowing the expansion"). The hook stands outside the clip; the
  // clip is 0 tall and inert while closed (CSS), auto while open, and only
  // the handle moves it: nothing opens by itself. The script animates the
  // height between the two and hands it back to CSS when the move ends. The
  // comet re-measures its knots on any change to the body's height (its own
  // ResizeObserver), so the bead's map follows the fold every frame.
  document.querySelectorAll<HTMLElement>("[data-story]").forEach((card) => {
    const clip = card.querySelector<HTMLElement>(".wk-story-clip");
    const btn = card.querySelector<HTMLButtonElement>(".wk-more");
    if (!clip || !btn) return;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
    const isOpen = () => card.hasAttribute("data-open");
    // the move has ended: the inline height steps aside for the CSS state
    clip.addEventListener("transitionend", (e) => {
      if (e.target === clip && e.propertyName === "height") clip.style.height = "";
    });
    const open = () => {
      const from = clip.getBoundingClientRect().height;
      card.setAttribute("data-open", "");
      clip.inert = false;
      btn.setAttribute("aria-expanded", "true");
      btn.setAttribute("aria-label", "Fold the story");
      if (reduce.matches) { clip.style.height = ""; return; }
      clip.style.height = from + "px";
      const to = clip.scrollHeight;
      requestAnimationFrame(() => { clip.style.height = to + "px"; });
    };
    const close = () => {
      clip.style.height = clip.getBoundingClientRect().height + "px";
      void clip.offsetHeight;
      card.removeAttribute("data-open");
      clip.inert = true;
      btn.setAttribute("aria-expanded", "false");
      btn.setAttribute("aria-label", "Read the whole story");
      if (reduce.matches) clip.style.height = "";
      else requestAnimationFrame(() => { clip.style.height = "0px"; });
      if (card.getBoundingClientRect().top < 0) card.scrollIntoView({ block: "start", behavior: reduce.matches ? "auto" : "smooth" });
    };
    btn.addEventListener("click", () => { if (isOpen()) close(); else open(); });
  });
  // (THE WHOLE STORY's own label-button is retired since 2026-10-19,
  // Jon: "if they are going to be expandable, it should just be one click":
  // the chevron opens the evidence and the locked script together)
</script>
