---
// StudioOne — the one-page skeleton (direction locked with Jon, 2026-08-12).
//
// One page, consistent wood ground. The hero IS the sitemap: autograph,
// one quiet sentence, and the five marks in a small centered row (emoji
// placeholders now — Jon's art lands at public/studio/mark-<id>.webp and
// takes over per mark, same swap-contract pattern as ever). Click = smooth
// anchor scroll. Once the hero row leaves the viewport, the row's five marks
// reappear as a FLOATING PILL (top-center capsule, scroll-spy active state,
// identical on phone). Sound sections are night sheets on the same wood
// (two temperatures, row-local; the page itself never dims).
//
// Supersedes the desk composition (StudioDesk.astro stays in git history;
// /signal, case studies, /resume untouched). Skeleton only: Jon owns the
// section surface treatment after this lands.
import fs from "node:fs";
import path from "node:path";
import soundlab from "./rooms/soundlab-manifest.json";
import writing from "./rooms/writing-manifest.json";
import illustrations from "./rooms/illustrations-manifest.json";
import SignalMachine from "../SignalMachine.astro";
import type { WorkItem } from "./StudioDesk.astro";

interface Props {
  works: WorkItem[];
}
const { works } = Astro.props;

// The one-liner. Jon rewrites this string at will (his voice: plain,
// human-centered function; explicitly NOT music-dramatic).
const ONE_LINER = "I design tools around how people actually use them.";

const pub = (f: string) => path.join(process.cwd(), "public", "studio", f);
const exists = (f: string) => fs.existsSync(pub(f));
const etchAsset = ["etch.svg", "etch.webp", "etch.png"].filter(exists).map((f) => `/studio/${f}`)[0];

interface Track { src: string; title: string; year?: number; duration?: string; }
const tracks: Track[] = (soundlab as any).tracks ?? [];
interface Illo { src: string; alt: string; title?: string; year?: number; }
const illos: Illo[] = (illustrations as any).items ?? [];
interface Post { slug: string; title: string; date: string; subtitle?: string; cover?: string | null; paragraphs: string[]; }
const posts: Post[] = (writing as any).posts ?? [];

// Recruiter-facing WORK ledes: the one-to-two-sentence summary IS the title
// (Jon, 2026-08-16 — project names demote to metadata). Hand-authored
// presentation copy; <strong> spans carry the scan path. Fallback = subtitle.
const LEDES: Record<string, string> = {
  "the-console":
    "The gear was never the problem; finishing was. I built <strong>three tools</strong> for where songs die: file <strong>20,000+ recordings</strong>, play one back as a band, judge it blind.",
  "chs":
    "Taught AI to <strong>10,000 employees</strong> at CHS, from a 250-user GPT Enterprise beta to company-wide. Non-technical teams now <strong>build their own models</strong> on internal data.",
  "crediverso":
    "Shipped <strong>bilingual mobile banking</strong> on iOS where family is a feature, not a footnote: <strong>15% drop in primary-flow bounce</strong>, 125% pre-launch follower growth.",
  "raylu":
    "Built the brand and the <strong>clickable Figma prototypes</strong> that helped Raylu close a <strong>$4M seed</strong> from Conversion Capital, Unusual Ventures, and angels.",
  "momence":
    "Redesigned Momence's customer profile in a <strong>48-hour take-home</strong>: <strong>four categories</strong>, modular by tenant, paired desktop and mobile, so it bends to each business.",
};

// The marks — Apple emoji by Jon's call (2026-08-16), one per room; a mark
// renders ONLY when its room has something in it. SIGNAL is LAST: the
// instrument is the site's finale, and its 🎹 gets the ethereal treatment.
const MARKS = [
  { id: "work", word: "work", emoji: "💼", ethereal: false, has: works.length > 0 },
  { id: "soundlab", word: "music", emoji: "🎧", ethereal: false, has: tracks.length > 0 },
  { id: "writing", word: "writing", emoji: "✏️", ethereal: false, has: true },
  { id: "illustrations", word: "illustrations", emoji: "🖼️", ethereal: false, has: illos.length > 0 },
  { id: "signal", word: "signal", emoji: "🎹", ethereal: true, has: true },
].filter((m) => m.has);
const SHOW = new Set(MARKS.map((m) => m.id));
---

<a class="skip" href="#work">Skip to the work</a>

{/* The wood: one fixed layer; everything scrolls over it. */}
<div class="ground" aria-hidden="true"></div>

<div class="one" data-one>
  {/* ── HERO — the sitemap ─────────────────────────────────────────────── */}
  <section class="hero" aria-label="Jonathan Tollefson — site index">
    <p class="corner">
      <span>minneapolis, mn</span>
      <i class="dot" aria-hidden="true"></i>
      <a href="/resume">résumé</a>
    </p>

    <header class="hero-name">
      <div class="etch-slot">
        {etchAsset ? (
          <>
            <h1 class="sr-only">Jonathan Tollefson</h1>
            <img class="etch-img" src={etchAsset} alt="" draggable="false" />
          </>
        ) : (
          <h1 class="etch-text">Jonathan Tollefson</h1>
        )}
      </div>
      <p class="liner">{ONE_LINER}</p>
    </header>

  </section>

  {/* ── THE SIDEBAR — persistent left column, nav only (Jon, 2026-08-16:
      always present from load; flat light panel; mobile deferred) ───────── */}
  <nav class="rail" data-rail aria-label="Sections">
    {MARKS.map((m) => (
      <a class="rail-item" href={`#${m.id}`} data-for={m.id} data-ethereal={m.ethereal ? "" : undefined} aria-label={m.word}>
        <span class="rail-art" aria-hidden="true">{m.emoji}</span>
        <span class="rail-word">{m.word}</span>
      </a>
    ))}
    <span class="comet" data-comet aria-hidden="true">
      <i class="comet-track"></i>
      <i class="comet-fill"></i>
      <i class="comet-bead"></i>
    </span>
  </nav>

  {/* ── SECTIONS ───────────────────────────────────────────────────────── */}
  {SHOW.has("work") && <section class="sheet paper" id="work" aria-labelledby="work-t">
    <h2 id="work-t">Work</h2>
    <ul class="works">
      {works.map((w, i) => (
        <li>
          <a class="wrow" href={`/case-studies/${w.slug}`} data-flagship={i === 0 ? "" : undefined}>
            {w.cover && <span class="wrow-cover"><img src={w.cover} alt="" loading={i === 0 ? "eager" : "lazy"} /></span>}
            <span class="wrow-body">
              <span class="wrow-lede" set:html={LEDES[w.slug] ?? w.subtitle}></span>
              <span class="wrow-meta">
                <b>{w.name}</b>
                {i === 0 && <em class="flag">flagship</em>}
                {w.tags?.length > 0 && <span class="wrow-tags">{w.tags.slice(0, 4).join(" · ")}</span>}
              </span>
              {w.outcome && !LEDES[w.slug] && <span class="wrow-outcome">{w.outcome}</span>}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>}


  {SHOW.has("soundlab") && <section class="sheet night" id="soundlab" aria-labelledby="soundlab-t">
    <h2 id="soundlab-t">Music I've Made</h2>
    {tracks.length > 0 ? (
      <ol class="tracks">
        {tracks.map((t, i) => (
          <li class="track">
            <span class="tno">{String(i + 1).padStart(2, "0")}</span>
            <span class="tname">{t.title}</span>
            <span class="tmeta">{[t.year, t.duration].filter(Boolean).join(" · ")}</span>
            <audio controls preload="metadata" src={t.src}></audio>
          </li>
        ))}
      </ol>
    ) : (
      <p class="night-line">Finished tracks land here.</p>
    )}
  </section>}

  <section class="sheet paper" id="writing" aria-labelledby="writing-t">
    <h2 id="writing-t">Writing</h2>
    {posts.length > 0 ? (
      <ul class="tiles">
        {posts.map((post) => (
          <li>
            <a class="tile" href={`/writing/${post.slug}`}>
              {post.cover && <span class="tile-cover"><img src={post.cover} alt="" loading="lazy" /></span>}
              <span class="tile-title">{post.title}</span>
              {post.subtitle && <span class="tile-sub">{post.subtitle}</span>}
              <span class="tile-date">{post.date}</span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="paper-line">Writing lands here.</p>
    )}
  </section>

  {SHOW.has("illustrations") && <section class="sheet paper" id="illustrations" aria-labelledby="illustrations-t">
    <h2 id="illustrations-t">Illustrations</h2>
    {illos.length > 0 ? (
      <ul class="illos">
        {illos.map((it) => (
          <li><img src={it.src} alt={it.alt} loading="lazy" />{it.title && <span>{it.title}</span>}</li>
        ))}
      </ul>
    ) : (
      <p class="paper-line">Nothing hung yet.</p>
    )}
  </section>}

  {/* ── SIGNAL — the instrument itself, live, the site's finale.
      Power-on takes the whole site dark; scrolling away powers it off and
      the light returns. The component is SACRED — observed, never edited. */}
  {/* No id here — SignalMachine's own root is <section id="signal">, which
      serves as the anchor + spy target; this host only frames and observes. */}
  <section class="live-signal" aria-label="Signal — a playable instrument" data-signal-host>
    <div class="sig-desktop">
      <SignalMachine />
    </div>
    <div class="sig-mobile">
      <iframe class="sig-mobile-frame" data-src="/more/index.html" title="Interactive audio exhibit" loading="lazy" allow="autoplay"></iframe>
    </div>
  </section>

  {/* the floor: reachable + placeable — email with the city beneath it */}
  <footer class="floor">
    <span class="floor-lines">
      <a href="mailto:jtollefson123@gmail.com">jtollefson123@gmail.com</a>
      <span class="floor-city">Minneapolis, MN</span>
    </span>
    <a class="floor-resume" href="/resume">résumé</a>
  </footer>

  {/* end sentinel: at document bottom the last section takes the active
      state even though it is too short to reach the spy band */}
  <div data-end aria-hidden="true"></div>
</div>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .skip {
    position: fixed;
    left: 20px;
    top: -60px;
    z-index: 90;
    padding: 10px 16px;
    background: #1c160d;
    color: #f5efe2;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.8rem;
    border-radius: 6px;
    transition: top 160ms ease;
  }
  .skip:focus {
    top: 20px;
  }

  /* ── the ground — neutral for now (Jon, 2026-08-16: wood out while the
     skeleton settles; surface treatment comes back later as his call) ──── */
  .ground {
    position: fixed;
    inset: 0;
    z-index: -1;
    background: #e9e8e5;
  }

  .one {
    /* the ground breathes after the last sheet — and the tail gives the final
       sections room to reach the scroll-spy band */
    padding-bottom: clamp(140px, 32vh, 360px);
    --railw: 0px;
    --ink: #141210;
    --dim: #6a5940;
    --paper: rgba(248, 244, 234, 0.96);
    --paper-line: rgba(90, 74, 50, 0.28);
    --night: #0b0e14;
    --night-line: #1c222e;
    --night-ink: #e8ecf4;
    --night-dim: #7d8798;
    --sapphire: #0ec4fc;
    --ember: #ff5432;
    color: var(--ink);
    font-family: "IBM Plex Sans", ui-sans-serif, system-ui, sans-serif;
  }

  /* ── hero ────────────────────────────────────────────────────────────── */
  .hero {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(40px, 7vh, 72px);
    padding: 24px;
    position: relative;
  }
  .corner {
    position: absolute;
    top: 22px;
    right: 26px;
    margin: 0;
    display: flex;
    gap: 12px;
    align-items: center;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--dim);
  }
  .corner .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ember);
    flex: none;
  }
  .corner a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .hero-name {
    width: min(720px, 88%);
  }
  .etch-slot {
    text-align: left;
  }
  .etch-text {
    margin: 0;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-weight: 600;
    font-size: clamp(1.3rem, 3vw, 2rem);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .etch-img {
    display: block;
    width: clamp(260px, 30vw, 420px);
    height: auto;
  }
  .liner {
    margin: 26px 0 0 auto;
    font-size: clamp(0.95rem, 1.4vw, 1.05rem);
    color: var(--dim);
    max-width: 34ch;
    line-height: 1.5;
    text-align: right;
  }

  /* ── the sidebar (persistent left column; desktop only) ──────────────── */
  .rail {
    display: none;
  }
  @media (min-width: 900px) {
    .rail {
      display: flex;
    }
  }
  .rail {
    position: fixed;
    left: 0;
    top: 0;
    bottom: 0;
    z-index: 50;
    width: 92px;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    padding: 16px 8px;
    background: #f4f3f0;
    border-right: 1px solid rgba(20, 18, 16, 0.14);
  }
  .rail-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    width: 76px;
    padding: 9px 4px 7px;
    border-radius: 11px;
    text-decoration: none;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    color: #45423c;
    transition: background 160ms ease, color 160ms ease;
  }
  .rail-item:hover {
    background: rgba(20, 18, 16, 0.07);
  }
  .rail-item[data-on] {
    background: var(--ink);
    color: #f5f2ea;
  }
  .rail-item:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }
  .rail-art {
    font-size: 19px;
    line-height: 1;
    display: grid;
    place-items: center;
  }
  .rail-art img {
    width: 20px;
    height: 20px;
    object-fit: contain;
  }
  .rail-word {
    font-size: 0.56rem;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  /* the signal mark: a breathing aurora RING around the whole chip + a
     gentle float — quiet, but unmistakably not like the others. It is the
     one lure toward the bottom of the page. */
  .rail-item[data-ethereal] {
    position: relative;
    isolation: isolate;
  }
  .rail-item[data-ethereal]::before {
    content: "";
    position: absolute;
    inset: 1px;
    border-radius: 11px;
    border: 1.5px solid rgba(14, 196, 252, 0.55);
    box-shadow:
      0 0 10px rgba(14, 196, 252, 0.35),
      inset 0 0 8px rgba(14, 196, 252, 0.12);
    pointer-events: none;
    z-index: -1;
  }
  .rail-item[data-ethereal] .rail-art {
    filter: drop-shadow(0 0 5px rgba(14, 196, 252, 0.35));
  }
  @media (prefers-reduced-motion: no-preference) {
    .rail-item[data-ethereal]::before {
      animation: ea-ring 5.4s ease-in-out infinite;
    }
    .rail-item[data-ethereal] .rail-art {
      animation: ea-float 5.4s ease-in-out infinite;
    }
    @keyframes ea-ring {
      0%, 100% {
        border-color: rgba(14, 196, 252, 0.55);
        box-shadow: 0 0 10px rgba(14, 196, 252, 0.35), inset 0 0 8px rgba(14, 196, 252, 0.12);
      }
      38% {
        border-color: rgba(155, 108, 255, 0.6);
        box-shadow: 0 0 14px rgba(155, 108, 255, 0.45), inset 0 0 9px rgba(155, 108, 255, 0.14);
      }
      70% {
        border-color: rgba(255, 180, 77, 0.55);
        box-shadow: 0 0 12px rgba(255, 180, 77, 0.4), inset 0 0 8px rgba(255, 180, 77, 0.12);
      }
    }
    @keyframes ea-float {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-2.5px); }
    }
  }
  /* the ring stays legible when the item inverts (active) or the site is night */
  .rail-item[data-ethereal][data-on]::before {
    inset: -2px;
    border-radius: 14px;
  }

  /* ── the comet: reading progress riding the rail's right edge ────────── */
  .comet {
    position: absolute;
    top: 18px;
    bottom: 18px;
    right: -7px;
    width: 12px;
    pointer-events: none;
    opacity: 0;
    transition: opacity 400ms ease;
  }
  .comet[data-scrollable] {
    opacity: 1;
  }
  .comet-track,
  .comet-fill {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 2px;
    transform: translateX(-50%);
    border-radius: 2px;
  }
  .comet-track {
    background: rgba(20, 18, 16, 0.1);
  }
  .comet-fill {
    background: linear-gradient(180deg, var(--brand-pink, #ff5c8a) 0%, var(--brand-orange, #ff8a3d) 50%, var(--brand-yellow, #ffc94d) 100%);
    clip-path: inset(0 0 calc((1 - var(--p, 0)) * 100%) 0);
    filter: drop-shadow(0 0 5px color-mix(in srgb, var(--brand-orange, #ff8a3d) 40%, transparent));
  }
  .comet-bead {
    position: absolute;
    left: 50%;
    top: calc(var(--p, 0) * 100%);
    width: 10px;
    height: 10px;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle at 50% 38%, #fff 0%, var(--brand-orange, #ff8a3d) 55%, color-mix(in srgb, var(--brand-orange, #ff8a3d) 55%, #000) 100%);
    box-shadow: 0 0 12px 2px color-mix(in srgb, var(--brand-orange, #ff8a3d) 50%, transparent);
  }
  .comet-bead::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: 50%;
    width: 6px;
    height: 22px;
    transform: translateX(-50%);
    background: linear-gradient(to top, var(--brand-orange, #ff8a3d), transparent);
    border-radius: 6px;
    filter: blur(2px);
  }

  /* ── NIGHT — the instrument's power owns the site's light ────────────── */
  .ground,
  .rail {
    transition: background 560ms ease, border-color 560ms ease;
  }
  :global(html[data-night]) .ground {
    background: #0b0e14;
  }
  :global(html[data-night]) .rail {
    background: #101216;
    border-right-color: rgba(160, 190, 230, 0.12);
  }
  :global(html[data-night]) .rail-item {
    color: #8f98a8;
  }
  :global(html[data-night]) .rail-item[data-on] {
    background: #e8ecf4;
    color: #101216;
  }
  :global(html[data-night]) .comet-track {
    background: rgba(232, 236, 244, 0.12);
  }
  :global(html[data-night]) .floor,
  :global(html[data-night]) .floor a,
  :global(html[data-night]) .floor-city {
    color: #8f98a8;
  }

  /* ── sections ────────────────────────────────────────────────────────── */
  .sheet {
    max-width: 1080px;
    margin: 0 auto clamp(40px, 7vh, 80px);
    padding: clamp(26px, 4vw, 46px);
    border-radius: 8px;
    scroll-margin-top: 76px;
    box-shadow: 0 18px 44px -24px rgba(20, 12, 4, 0.5);
  }
  .paper {
    background: var(--paper);
    border: 1px solid var(--paper-line);
  }
  .night {
    background: var(--night);
    border: 1px solid var(--night-line);
    color: var(--night-ink);
  }
  .sheet h2 {
    margin: 0 0 22px;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-weight: 600;
    font-size: clamp(1.05rem, 1.8vw, 1.3rem);
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  .night h2 {
    color: var(--night-ink);
  }

  .works {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .works li + li {
    border-top: 1px solid var(--paper-line);
  }
  .wrow {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 12px 26px;
    align-items: start;
    padding: 24px 6px;
    text-decoration: none;
    color: inherit;
    border-radius: 6px;
  }
  .wrow:hover,
  .wrow:focus-visible {
    background: rgba(20, 18, 16, 0.035);
  }
  .wrow:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: -2px;
  }
  .wrow-cover img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: 4px;
    border: 1px solid var(--paper-line);
    display: block;
    transition: transform 200ms cubic-bezier(0.2, 0.7, 0.3, 1);
  }
  .wrow:hover .wrow-cover img {
    transform: translateY(-2px);
  }
  .wrow-body {
    display: flex;
    flex-direction: column;
    gap: 9px;
    min-width: 0;
  }
  .wrow-lede {
    font-size: 1.02rem;
    line-height: 1.5;
    max-width: 58ch;
    color: color-mix(in srgb, var(--ink) 82%, var(--dim));
  }
  .wrow-lede strong {
    font-weight: 600;
    color: var(--ink);
  }
  .wrow-meta {
    display: flex;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
  }
  .wrow-meta b {
    font-weight: 600;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .wrow-tags {
    font-size: 0.66rem;
    letter-spacing: 0.04em;
    color: var(--dim);
  }
  .wrow-outcome {
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.72rem;
    line-height: 1.55;
    letter-spacing: 0.02em;
    color: var(--dim);
    max-width: 70ch;
  }
  .flag {
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-style: normal;
    font-size: 0.56rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border: 1px solid var(--paper-line);
    border-radius: 99px;
    padding: 2px 7px;
    color: var(--dim);
  }

  .night-line {
    margin: 0;
    color: var(--night-dim);
    font-size: 0.95rem;
    line-height: 1.55;
  }
  .night-cta {
    display: inline-block;
    margin-top: 18px;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    color: var(--sapphire);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: color-mix(in srgb, var(--sapphire) 45%, transparent);
  }
  .night-cta:hover,
  .night-cta:focus-visible {
    text-decoration-color: var(--sapphire);
  }

  /* ── SIGNAL: the instrument face ─────────────────────────────────────── */
  .machine {
    display: block;
    text-decoration: none;
    background:
      linear-gradient(160deg, #1c1f25, #14161b 55%, #0e1014);
    border: 1px solid #262b34;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.06),
      0 18px 44px -24px rgba(10, 8, 4, 0.6);
    cursor: pointer;
  }
  .machine {
    padding: clamp(34px, 4.6vw, 56px);
  }
  .m-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }
  .m-powerwrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    flex: none;
  }
  .m-open {
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    color: #7d8798;
    transition: color 200ms ease;
  }
  .m-open i {
    font-style: normal;
    display: inline-block;
    transition: transform 200ms ease;
  }
  .machine:hover .m-open,
  .machine:focus-visible .m-open {
    color: #ffb44d;
  }
  .machine:hover .m-open i,
  .machine:focus-visible .m-open i {
    transform: translateX(4px);
  }
  .m-ghost {
    display: grid;
    place-items: center;
    height: 100%;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.78rem;
    letter-spacing: 0.5em;
    color: rgba(125, 135, 152, 0.35);
    transition: color 260ms ease;
  }
  .machine:hover .m-ghost {
    color: rgba(14, 196, 252, 0.55);
  }
  .m-name {
    margin: 0;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-weight: 600;
    font-size: clamp(1.3rem, 2.4vw, 1.8rem);
    letter-spacing: 0.32em;
    color: #e8ecf4;
    /* engraved silkscreen: never lit */
    text-shadow: 0 1px 0 rgba(0, 0, 0, 0.6), 0 -1px 0 rgba(255, 255, 255, 0.06);
  }
  .m-sub {
    display: block;
    margin-top: 6px;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: #7d8798;
  }
  /* the power button — the door */
  .m-power {
    position: relative;
    width: 92px;
    height: 92px;
    flex: none;
    border-radius: 50%;
    background: radial-gradient(circle at 38% 32%, #23262d, #101216 70%);
    border: 1px solid #2b303a;
    box-shadow: inset 0 2px 6px rgba(0, 0, 0, 0.7), 0 1px 0 rgba(255, 255, 255, 0.05);
  }
  .m-ring {
    position: absolute;
    inset: 19px;
    border-radius: 50%;
    border: 2.5px solid rgba(255, 84, 50, 0.45);
    box-shadow: 0 0 12px rgba(255, 84, 50, 0.25);
    transition: border-color 220ms ease, box-shadow 220ms ease;
  }
  .m-core {
    position: absolute;
    left: 50%;
    top: 25%;
    width: 3px;
    height: 19px;
    margin-left: -1.5px;
    background: rgba(255, 84, 50, 0.6);
    border-radius: 2px;
    transition: background 220ms ease, box-shadow 220ms ease;
  }
  @media (prefers-reduced-motion: no-preference) {
    .m-ring {
      animation: m-breathe 3.2s ease-in-out infinite;
    }
    @keyframes m-breathe {
      0%, 100% { opacity: 0.75; }
      50% { opacity: 1; }
    }
  }
  .machine:hover .m-ring,
  .machine:focus-visible .m-ring {
    border-color: rgba(255, 96, 60, 0.95);
    box-shadow: 0 0 22px rgba(255, 84, 50, 0.55);
    animation: none;
  }
  .machine:hover .m-core,
  .machine:focus-visible .m-core {
    background: #ff6a48;
    box-shadow: 0 0 10px rgba(255, 84, 50, 0.8);
  }
  .machine:focus-visible {
    outline: 2px solid var(--sapphire);
    outline-offset: 4px;
  }
  .m-glass {
    display: block;
    margin-top: 34px;
    height: 96px;
    border-radius: 6px;
    background: linear-gradient(165deg, rgba(170, 196, 232, 0.10), rgba(170, 196, 232, 0.02) 40%, transparent), #05070c;
    border: 1px solid #232833;
  }
  .m-caps {
    display: flex;
    gap: 5px;
    margin-top: 14px;
  }
  .m-caps i {
    flex: 1;
    height: 40px;
    border-radius: 4px;
    background: linear-gradient(180deg, #262b34, #1a1f27);
    border: 1px solid rgba(0, 0, 0, 0.65);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.07);
  }

  /* ── writing: preview tiles → /writing/<slug> ────────────────────────── */
  .tiles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 20px;
  }
  .tile {
    display: flex;
    flex-direction: column;
    gap: 9px;
    text-decoration: none;
    color: inherit;
    border-radius: 6px;
  }
  .tile-cover img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: 4px;
    border: 1px solid var(--paper-line);
    display: block;
    transition: transform 200ms cubic-bezier(0.2, 0.7, 0.3, 1);
  }
  .tile:hover .tile-cover img {
    transform: translateY(-3px);
  }
  .tile-title {
    font-weight: 600;
    font-size: 0.98rem;
    line-height: 1.3;
  }
  .tile:hover .tile-title {
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: color-mix(in srgb, currentColor 35%, transparent);
  }
  .tile-sub {
    font-size: 0.84rem;
    line-height: 1.45;
    color: var(--dim);
  }
  .tile-date {
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.66rem;
    letter-spacing: 0.05em;
    color: var(--dim);
  }
  .tile:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 4px;
  }

  /* ── the live instrument (the finale) ────────────────────────────────── */
  .live-signal {
    max-width: 1180px;
    margin: 0 auto clamp(40px, 7vh, 80px);
    scroll-margin-top: 24px;
  }
  .sig-desktop {
    display: none;
  }
  .sig-mobile {
    display: block;
    padding: 0 14px;
  }
  .sig-mobile-frame {
    width: 100%;
    height: 78svh;
    border: 1px solid var(--night-line);
    border-radius: 10px;
    background: var(--night);
  }
  @media (pointer: fine) {
    .sig-desktop {
      display: block;
    }
    .sig-mobile {
      display: none;
    }
  }

  .paper-line {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--dim);
  }
  .paper-line a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 4px;
    margin-left: 8px;
  }

  .illos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
    gap: 16px;
  }
  .illos img {
    width: 100%;
    border-radius: 4px;
    border: 1px solid var(--paper-line);
    display: block;
  }

  /* the content column clears the persistent sidebar; below 900px there is
     no sidebar — sheets run full width with gutters */
  @media (min-width: 900px) {
    .one {
      --railw: 92px;
      padding-left: var(--railw);
    }
  }
  @media (min-width: 900px) and (max-width: 1320px) {
    .sheet {
      margin-left: 24px;
      margin-right: 24px;
    }
  }
  @media (max-width: 899px) {
    .sheet {
      margin-left: 14px;
      margin-right: 14px;
    }
  }

  .floor {
    max-width: 1080px;
    margin: 0 auto;
    padding: 4px clamp(26px, 4vw, 46px) 0;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 10px;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.74rem;
    letter-spacing: 0.04em;
    color: var(--dim);
  }
  .floor-lines {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  .floor-city {
    color: var(--dim);
  }
  .floor a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  /* smooth anchor travel, motion-gated */
  @media (prefers-reduced-motion: no-preference) {
    :global(html) {
      scroll-behavior: smooth;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pill,
    .mark,
    .mark-art,
    .cover img {
      transition: none;
    }
  }
</style>

<script>
  // The sidebar is always present; scroll-spy highlights the section in
  // view (none while the hero owns the viewport). IO-triggered recompute —
  // no rAF, no per-frame scroll work.
  const rail = document.querySelector<HTMLElement>("[data-rail]");
  if (rail) {

    // Scroll-spy: IO events are only the TRIGGER; the active section is
    // recomputed deterministically each time — the lowest section whose top
    // has passed the 35% line, or the last section at hard bottom (short
    // final sheets can never reach the line). No scroll handlers, no rAF.
    const items = new Map(
      Array.from(rail.querySelectorAll<HTMLElement>("[data-for]")).map((el) => [el.dataset.for as string, el])
    );
    const ids = Array.from(items.keys());
    // A nav click LOCKS its target as the active section (the two bottom
    // sections share one max-scroll position, so position alone can't tell
    // them apart); any user-initiated scroll releases the lock.
    let lock: string | null = null;
    const recompute = () => {
      const doc = document.documentElement;
      const atBottom = window.innerHeight + window.scrollY >= doc.scrollHeight - 8;
      let active: string | null = null;
      if (lock) {
        active = lock;
      } else if (atBottom) {
        active = ids[ids.length - 1];
      } else {
        const line = window.innerHeight * 0.35;
        for (const id of ids) {
          const s = document.getElementById(id);
          if (s && s.getBoundingClientRect().top <= line) active = id;
        }
      }
      items.forEach((el, id) => {
        if (id === active) el.setAttribute("data-on", "");
        else el.removeAttribute("data-on");
      });
    };
    document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((a) =>
      a.addEventListener("click", () => {
        const id = (a.getAttribute("href") || "").slice(1);
        if (items.has(id)) {
          lock = id;
          recompute();
        }
      })
    );
    (["wheel", "touchstart", "keydown", "pointerdown"] as const).forEach((evt) =>
      window.addEventListener(evt, () => { lock = null; }, { passive: true })
    );
    const spy = new IntersectionObserver(recompute, { threshold: [0, 0.25, 0.5, 0.75, 1] });
    ids.forEach((id) => {
      const s = document.getElementById(id);
      if (s) spy.observe(s);
    });
    const end = document.querySelector("[data-end]");
    if (end) spy.observe(end);
    // IO crossings can all fire before a smooth scroll settles; recompute
    // once more when scrolling ends (scrollend where supported, else a
    // debounced passive listener — no per-frame work either way).
    if ("onscrollend" in window) {
      window.addEventListener("scrollend", recompute, { passive: true });
    } else {
      let t = 0;
      window.addEventListener(
        "scroll",
        () => {
          window.clearTimeout(t);
          t = window.setTimeout(recompute, 120);
        },
        { passive: true }
      );
    }
    recompute();
  }

  // ── the comet: reading progress on the rail's right edge. rAF-throttled
  // passive scroll — motion only while scrolling, nothing at rest.
  const comet = document.querySelector<HTMLElement>("[data-comet]");
  if (comet) {
    let ticking = false;
    const measure = () => {
      const doc = document.documentElement;
      const span = doc.scrollHeight - window.innerHeight;
      if (span > 4) comet.setAttribute("data-scrollable", "");
      else comet.removeAttribute("data-scrollable");
      const pv = span > 4 ? Math.min(1, Math.max(0, window.scrollY / span)) : 0;
      comet.style.setProperty("--p", pv.toFixed(4));
    };
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => { ticking = false; measure(); });
    };
    measure();
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll, { passive: true });
    window.addEventListener("load", measure);
  }

  // ── the instrument owns the light. The SignalMachine is SACRED — we only
  // OBSERVE its data-state: boot → the site goes night; powerdown/standby →
  // light returns. Scrolling the instrument out of view powers it off.
  const sgm = document.getElementById("sgm");
  const host = document.querySelector("[data-signal-host]");
  if (sgm && host) {
    const night = (on: boolean) => {
      if (on) document.documentElement.setAttribute("data-night", "");
      else document.documentElement.removeAttribute("data-night");
    };
    const powered = () => {
      const st = sgm.getAttribute("data-state");
      return st === "boot" || st === "on" || st === "live";
    };
    new MutationObserver(() => night(powered())).observe(sgm, {
      attributes: true,
      attributeFilter: ["data-state"],
    });
    new IntersectionObserver(([e]) => {
      if (!e.isIntersecting && powered()) {
        const pwr = document.getElementById("pwr");
        pwr?.click(); // the machine's own powerdown path
        night(false);
      }
    }, { threshold: 0 }).observe(host);
  }

  // touch devices: load the /more exhibit into the fallback frame
  if (!window.matchMedia("(pointer: fine)").matches) {
    const f = document.querySelector<HTMLIFrameElement>(".sig-mobile-frame");
    if (f && !f.src) f.src = f.getAttribute("data-src") || "";
  }
</script>
