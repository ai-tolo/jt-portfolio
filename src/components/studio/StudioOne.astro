  .lk {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    /* the placard sits right under the picture; the dot row moved above
       it (Jon, 2026-09-09) */
    gap: 14px;
  }
  .lk-img {
    width: 100%;
    object-fit: contain;
    display: block;
  }
  /* desktop: tall gallery box; phones size to the art (the mobile rule
     was being overridden by this base — QA 2026-08-28) */
  @media (min-width: 900px) {
    .lk-img {
      /* the gallery box: 4:3 at 80svh tall, or narrower where the keys
         need their room (see --lk-room). The box follows the picture so
         the dots and the placard stay with it instead of a void */
      max-width: calc(100% - 2 * var(--lk-room));
      aspect-ratio: 4 / 3;
      max-height: 80svh;
    }
  }
  .lk-cap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
