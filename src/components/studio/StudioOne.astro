  @media (max-width: 899px) {
    .line {
      min-height: calc(100svh - var(--mbar-h) - env(safe-area-inset-bottom, 0px));
      padding: 0 14px;
    }
    .line-say {
      font-size: 28px;
    }
  }

  /* ── THE END (2026-10-13 round six): the footer is the last room, a full
     viewport with its words centred: résumé in the bands' name face, 24px,
     then the sitewide floor (SiteFloor.astro is the object; this page owns
     only its placement and inks). The one gap (.one > .room) stands above. */
  .end {
    min-height: 100svh;
    align-items: center;
    justify-content: center;
    text-align: center;
  }
  .end-cv {
    font: 500 3.25rem/1.05 "Outfit", "Instrument Sans", "Helvetica Neue", sans-serif;
    letter-spacing: -0.02em;
