---
// StudioOne — the one-page skeleton (direction locked with Jon, 2026-08-12).
//
// One page, consistent wood ground. The hero IS the sitemap: autograph,
// one quiet sentence, and the five marks in a small centered row (emoji
// placeholders now — Jon's art lands at public/studio/mark-<id>.webp and
// takes over per mark, same swap-contract pattern as ever). Click = smooth
// anchor scroll. Once the hero row leaves the viewport, the row's five marks
// reappear as a FLOATING PILL (top-center capsule, scroll-spy active state,
// identical on phone). Sound sections are night sheets on the same wood
// (two temperatures, row-local; the page itself never dims).
//
// Supersedes the desk composition (StudioDesk.astro stays in git history;
// /signal, case studies, /resume untouched). Skeleton only: Jon owns the
// section surface treatment after this lands.
import fs from "node:fs";
import path from "node:path";
import soundlab from "./rooms/soundlab-manifest.json";
import writing from "./rooms/writing-manifest.json";
import illustrations from "./rooms/illustrations-manifest.json";
import type { WorkItem } from "./StudioDesk.astro";

interface Props {
  works: WorkItem[];
}
const { works } = Astro.props;

// The one-liner. Jon rewrites this string at will (his voice: plain,
// human-centered function; explicitly NOT music-dramatic).
const ONE_LINER = "I design tools around how people actually use them.";

const pub = (f: string) => path.join(process.cwd(), "public", "studio", f);
const exists = (f: string) => fs.existsSync(pub(f));
const etchAsset = ["etch.svg", "etch.webp", "etch.png"].filter(exists).map((f) => `/studio/${f}`)[0];

interface Track { src: string; title: string; year?: number; duration?: string; }
const tracks: Track[] = (soundlab as any).tracks ?? [];
interface Illo { src: string; alt: string; title?: string; year?: number; }
const illos: Illo[] = (illustrations as any).items ?? [];
interface Post { slug: string; title: string; date: string; subtitle?: string; cover?: string | null; paragraphs: string[]; }
const posts: Post[] = (writing as any).posts ?? [];

// Recruiter-facing WORK ledes: the one-to-two-sentence summary IS the title
// (Jon, 2026-08-16 — project names demote to metadata). Hand-authored
// presentation copy; <strong> spans carry the scan path. Fallback = subtitle.
const LEDES: Record<string, string> = {
  "the-console":
    "Songs kept dying in my hard drive, so I built <strong>three audio tools</strong> where they die — a catalog that reads 20k recordings, a studio that turns one loop into a band, and a <strong>blind listening test</strong> that keeps my own ears honest.",
  "chs":
    "Taught <strong>AI to 10,000 employees</strong> — from 250 GPT Enterprise beta users to company-wide rollout, with non-technical teams building custom models on internal data.",
  "crediverso":
    "Shipped V1 of <strong>bilingual mobile banking</strong> where family is a feature, not a footnote — <strong>15% drop</strong> in primary-flow bounce before launch.",
  "raylu":
    "Brand and clickable prototypes that helped <strong>close $4M in seed funding</strong> — Conversion Capital, Unusual Ventures, and angels.",
  "momence":
    "A customer profile that <strong>bends to fit each business</strong> — four-category schema, modular by tenant, designed in a 48-hour take-home.",
};

// The five marks (art: public/studio/mark-<id>.webp swap slots; emoji only as
// last-resort fallback). A mark renders ONLY when its room has something in
// it — the nav can never advertise an empty room.
const MARKS = [
  { id: "work", word: "work", emoji: "📁", temp: "warm", has: works.length > 0 },
  { id: "signal", word: "signal", emoji: "🎹", temp: "cool", has: true },
  { id: "soundlab", word: "sound lab", emoji: "🎧", temp: "cool", has: tracks.length > 0 },
  { id: "writing", word: "writing", emoji: "✍️", temp: "warm", has: true },
  { id: "illustrations", word: "illustrations", emoji: "✏️", temp: "warm", has: illos.length > 0 },
].filter((m) => m.has).map((m) => ({
  ...m,
  art: ["webp", "svg", "png"].map((e) => `mark-${m.id}.${e}`).filter(exists).map((f) => `/studio/${f}`)[0],
}));
const SHOW = new Set(MARKS.map((m) => m.id));
---

<a class="skip" href="#work">Skip to the work</a>

{/* The wood: one fixed layer; everything scrolls over it. */}
<div class="ground" aria-hidden="true"></div>

<div class="one" data-one>
  {/* ── HERO — the sitemap ─────────────────────────────────────────────── */}
  <section class="hero" aria-label="Jonathan Tollefson — site index">
    <p class="corner">
      <span>minneapolis, mn</span>
      <i class="dot" aria-hidden="true"></i>
      <a href="/resume">résumé</a>
    </p>

    <header class="hero-name">
      <div class="etch-slot">
        {etchAsset ? (
          <>
            <h1 class="sr-only">Jonathan Tollefson</h1>
            <img class="etch-img" src={etchAsset} alt="" draggable="false" />
          </>
        ) : (
          <h1 class="etch-text">Jonathan Tollefson</h1>
        )}
      </div>
      <p class="liner">{ONE_LINER}</p>
    </header>

  </section>

  {/* ── THE SIDEBAR — persistent left column, nav only (Jon, 2026-08-16:
      always present from load; flat light panel; mobile deferred) ───────── */}
  <nav class="rail" data-rail aria-label="Sections">
    {MARKS.map((m) => (
      <a class="rail-item" href={`#${m.id}`} data-for={m.id} data-temp={m.temp} aria-label={m.word}>
        <span class="rail-art" aria-hidden="true">
          {m.art ? <img src={m.art} alt="" draggable="false" /> : m.emoji}
        </span>
        <span class="rail-word">{m.word}</span>
      </a>
    ))}
  </nav>

  {/* ── SECTIONS ───────────────────────────────────────────────────────── */}
  {SHOW.has("work") && <section class="sheet paper" id="work" aria-labelledby="work-t">
    <h2 id="work-t">Work</h2>
    <ul class="works">
      {works.map((w, i) => (
        <li>
          <a class="wrow" href={`/case-studies/${w.slug}`} data-flagship={i === 0 ? "" : undefined}>
            {w.cover && <span class="wrow-cover"><img src={w.cover} alt="" loading={i === 0 ? "eager" : "lazy"} /></span>}
            <span class="wrow-body">
              <span class="wrow-lede" set:html={LEDES[w.slug] ?? w.subtitle}></span>
              <span class="wrow-meta">
                <b>{w.name}</b>
                {i === 0 && <em class="flag">flagship</em>}
                {w.tags?.length > 0 && <span class="wrow-tags">{w.tags.slice(0, 4).join(" · ")}</span>}
              </span>
              {w.outcome && !LEDES[w.slug] && <span class="wrow-outcome">{w.outcome}</span>}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>}

  {/* SIGNAL — the sheet IS the instrument's face; the power button is the
      door. The whole panel is one link to /signal. */}
  <a class="sheet machine" id="signal" href="/signal" aria-label="Signal — a playable instrument. Press power to open it.">
    <span class="m-head" aria-hidden="true">
      <span class="m-id">
        <h2 class="m-name" id="signal-t">SIGNAL</h2>
        <span class="m-sub">a playable instrument · built for this site</span>
      </span>
      <span class="m-powerwrap">
        <span class="m-power">
          <i class="m-ring"></i>
          <i class="m-core"></i>
        </span>
        <span class="m-open">press power <i>→</i></span>
      </span>
    </span>
    <span class="m-glass" aria-hidden="true"><span class="m-ghost">A · W · S · E · D · F · T · G</span></span>
    <span class="m-caps" aria-hidden="true">
      {Array.from({ length: 14 }).map(() => <i></i>)}
    </span>
  </a>

  {SHOW.has("soundlab") && <section class="sheet night" id="soundlab" aria-labelledby="soundlab-t">
    <h2 id="soundlab-t">Sound Lab</h2>
    {tracks.length > 0 ? (
      <ol class="tracks">
        {tracks.map((t, i) => (
          <li class="track">
            <span class="tno">{String(i + 1).padStart(2, "0")}</span>
            <span class="tname">{t.title}</span>
            <span class="tmeta">{[t.year, t.duration].filter(Boolean).join(" · ")}</span>
            <audio controls preload="metadata" src={t.src}></audio>
          </li>
        ))}
      </ol>
    ) : (
      <p class="night-line">Finished tracks land here.</p>
    )}
  </section>}

  <section class="sheet paper" id="writing" aria-labelledby="writing-t">
    <h2 id="writing-t">Writing</h2>
    {posts.length > 0 ? (
      <ul class="tiles">
        {posts.map((post) => (
          <li>
            <a class="tile" href={`/writing/${post.slug}`}>
              {post.cover && <span class="tile-cover"><img src={post.cover} alt="" loading="lazy" /></span>}
              <span class="tile-title">{post.title}</span>
              {post.subtitle && <span class="tile-sub">{post.subtitle}</span>}
              <span class="tile-date">{post.date}</span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="paper-line">Writing lands here.</p>
    )}
  </section>

  {SHOW.has("illustrations") && <section class="sheet paper" id="illustrations" aria-labelledby="illustrations-t">
    <h2 id="illustrations-t">Illustrations</h2>
    {illos.length > 0 ? (
      <ul class="illos">
        {illos.map((it) => (
          <li><img src={it.src} alt={it.alt} loading="lazy" />{it.title && <span>{it.title}</span>}</li>
        ))}
      </ul>
    ) : (
      <p class="paper-line">Nothing hung yet.</p>
    )}
  </section>}

  {/* the floor: one quiet line on the wood — reachable, placeable, dated */}
  <footer class="floor">
    <a href="mailto:jtollefson123@gmail.com">jtollefson123@gmail.com</a>
    <span>·</span><span>Minneapolis, MN</span>
    <span>·</span><a href="https://substack.com/@diaryofasoundbender" target="_blank" rel="noopener noreferrer">substack</a>
    <span>·</span><a href="/resume">résumé</a>
  </footer>

  {/* end sentinel: at document bottom the last section takes the active
      state even though it is too short to reach the spy band */}
  <div data-end aria-hidden="true"></div>
</div>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .skip {
    position: fixed;
    left: 20px;
    top: -60px;
    z-index: 90;
    padding: 10px 16px;
    background: #1c160d;
    color: #f5efe2;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.8rem;
    border-radius: 6px;
    transition: top 160ms ease;
  }
  .skip:focus {
    top: 20px;
  }

  /* ── the ground — neutral for now (Jon, 2026-08-16: wood out while the
     skeleton settles; surface treatment comes back later as his call) ──── */
  .ground {
    position: fixed;
    inset: 0;
    z-index: -1;
    background: #e9e8e5;
  }

  .one {
    /* the ground breathes after the last sheet — and the tail gives the final
       sections room to reach the scroll-spy band */
    padding-bottom: clamp(140px, 32vh, 360px);
    --railw: 0px;
    --ink: #141210;
    --dim: #6a5940;
    --paper: rgba(248, 244, 234, 0.96);
    --paper-line: rgba(90, 74, 50, 0.28);
    --night: #0b0e14;
    --night-line: #1c222e;
    --night-ink: #e8ecf4;
    --night-dim: #7d8798;
    --sapphire: #0ec4fc;
    --ember: #ff5432;
    color: var(--ink);
    font-family: "IBM Plex Sans", ui-sans-serif, system-ui, sans-serif;
  }

  /* ── hero ────────────────────────────────────────────────────────────── */
  .hero {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(40px, 7vh, 72px);
    padding: 24px;
    position: relative;
  }
  .corner {
    position: absolute;
    top: 22px;
    right: 26px;
    margin: 0;
    display: flex;
    gap: 12px;
    align-items: center;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--dim);
  }
  .corner .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ember);
    flex: none;
  }
  .corner a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .hero-name {
    width: min(720px, 88%);
  }
  .etch-slot {
    text-align: left;
  }
  .etch-text {
    margin: 0;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-weight: 600;
    font-size: clamp(1.3rem, 3vw, 2rem);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .etch-img {
    display: block;
    width: clamp(260px, 30vw, 420px);
    height: auto;
  }
  .liner {
    margin: 26px 0 0 auto;
    font-size: clamp(0.95rem, 1.4vw, 1.05rem);
    color: var(--dim);
    max-width: 34ch;
    line-height: 1.5;
    text-align: right;
  }

  /* ── the sidebar (persistent left column; desktop only) ──────────────── */
  .rail {
    display: none;
  }
  @media (min-width: 900px) {
    .rail {
      display: flex;
    }
  }
  .rail {
    position: fixed;
    left: 0;
    top: 0;
    bottom: 0;
    z-index: 50;
    width: 92px;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    padding: 16px 8px;
    background: #f4f3f0;
    border-right: 1px solid rgba(20, 18, 16, 0.14);
  }
  .rail-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    width: 76px;
    padding: 9px 4px 7px;
    border-radius: 11px;
    text-decoration: none;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    color: #45423c;
    transition: background 160ms ease, color 160ms ease;
  }
  .rail-item:hover {
    background: rgba(20, 18, 16, 0.07);
  }
  .rail-item[data-on] {
    background: var(--ink);
    color: #f5f2ea;
  }
  .rail-item:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }
  .rail-art {
    font-size: 19px;
    line-height: 1;
    display: grid;
    place-items: center;
  }
  .rail-art img {
    width: 20px;
    height: 20px;
    object-fit: contain;
  }
  .rail-word {
    font-size: 0.56rem;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  /* ── sections ────────────────────────────────────────────────────────── */
  .sheet {
    max-width: 1080px;
    margin: 0 auto clamp(40px, 7vh, 80px);
    padding: clamp(26px, 4vw, 46px);
    border-radius: 8px;
    scroll-margin-top: 76px;
    box-shadow: 0 18px 44px -24px rgba(20, 12, 4, 0.5);
  }
  .paper {
    background: var(--paper);
    border: 1px solid var(--paper-line);
  }
  .night {
    background: var(--night);
    border: 1px solid var(--night-line);
    color: var(--night-ink);
  }
  .sheet h2 {
    margin: 0 0 22px;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-weight: 600;
    font-size: clamp(1.05rem, 1.8vw, 1.3rem);
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  .night h2 {
    color: var(--night-ink);
  }

  .works {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .works li + li {
    border-top: 1px solid var(--paper-line);
  }
  .wrow {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 12px 26px;
    align-items: start;
    padding: 24px 6px;
    text-decoration: none;
    color: inherit;
    border-radius: 6px;
  }
  .wrow[data-flagship] {
    grid-template-columns: 280px 1fr;
  }
  .wrow:hover,
  .wrow:focus-visible {
    background: rgba(20, 18, 16, 0.035);
  }
  .wrow:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: -2px;
  }
  .wrow-cover img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: 4px;
    border: 1px solid var(--paper-line);
    display: block;
    transition: transform 200ms cubic-bezier(0.2, 0.7, 0.3, 1);
  }
  .wrow:hover .wrow-cover img {
    transform: translateY(-2px);
  }
  .wrow-body {
    display: flex;
    flex-direction: column;
    gap: 9px;
    min-width: 0;
  }
  .wrow-lede {
    font-size: 1.02rem;
    line-height: 1.5;
    max-width: 58ch;
    color: color-mix(in srgb, var(--ink) 82%, var(--dim));
  }
  .wrow[data-flagship] .wrow-lede {
    font-size: 1.14rem;
  }
  .wrow-lede strong {
    font-weight: 600;
    color: var(--ink);
  }
  .wrow-meta {
    display: flex;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
  }
  .wrow-meta b {
    font-weight: 600;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .wrow-tags {
    font-size: 0.66rem;
    letter-spacing: 0.04em;
    color: var(--dim);
  }
  .wrow-outcome {
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.72rem;
    line-height: 1.55;
    letter-spacing: 0.02em;
    color: var(--dim);
    max-width: 70ch;
  }
  .flag {
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-style: normal;
    font-size: 0.56rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border: 1px solid var(--paper-line);
    border-radius: 99px;
    padding: 2px 7px;
    color: var(--dim);
  }

  .night-line {
    margin: 0;
    color: var(--night-dim);
    font-size: 0.95rem;
    line-height: 1.55;
  }
  .night-cta {
    display: inline-block;
    margin-top: 18px;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    color: var(--sapphire);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: color-mix(in srgb, var(--sapphire) 45%, transparent);
  }
  .night-cta:hover,
  .night-cta:focus-visible {
    text-decoration-color: var(--sapphire);
  }

  /* ── SIGNAL: the instrument face ─────────────────────────────────────── */
  .machine {
    display: block;
    text-decoration: none;
    background:
      linear-gradient(160deg, #1c1f25, #14161b 55%, #0e1014);
    border: 1px solid #262b34;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.06),
      0 18px 44px -24px rgba(10, 8, 4, 0.6);
    cursor: pointer;
  }
  .machine {
    padding: clamp(34px, 4.6vw, 56px);
  }
  .m-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }
  .m-powerwrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    flex: none;
  }
  .m-open {
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    color: #7d8798;
    transition: color 200ms ease;
  }
  .m-open i {
    font-style: normal;
    display: inline-block;
    transition: transform 200ms ease;
  }
  .machine:hover .m-open,
  .machine:focus-visible .m-open {
    color: #ffb44d;
  }
  .machine:hover .m-open i,
  .machine:focus-visible .m-open i {
    transform: translateX(4px);
  }
  .m-ghost {
    display: grid;
    place-items: center;
    height: 100%;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.78rem;
    letter-spacing: 0.5em;
    color: rgba(125, 135, 152, 0.35);
    transition: color 260ms ease;
  }
  .machine:hover .m-ghost {
    color: rgba(14, 196, 252, 0.55);
  }
  .m-name {
    margin: 0;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-weight: 600;
    font-size: clamp(1.3rem, 2.4vw, 1.8rem);
    letter-spacing: 0.32em;
    color: #e8ecf4;
    /* engraved silkscreen: never lit */
    text-shadow: 0 1px 0 rgba(0, 0, 0, 0.6), 0 -1px 0 rgba(255, 255, 255, 0.06);
  }
  .m-sub {
    display: block;
    margin-top: 6px;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: #7d8798;
  }
  /* the power button — the door */
  .m-power {
    position: relative;
    width: 92px;
    height: 92px;
    flex: none;
    border-radius: 50%;
    background: radial-gradient(circle at 38% 32%, #23262d, #101216 70%);
    border: 1px solid #2b303a;
    box-shadow: inset 0 2px 6px rgba(0, 0, 0, 0.7), 0 1px 0 rgba(255, 255, 255, 0.05);
  }
  .m-ring {
    position: absolute;
    inset: 19px;
    border-radius: 50%;
    border: 2.5px solid rgba(255, 84, 50, 0.45);
    box-shadow: 0 0 12px rgba(255, 84, 50, 0.25);
    transition: border-color 220ms ease, box-shadow 220ms ease;
  }
  .m-core {
    position: absolute;
    left: 50%;
    top: 25%;
    width: 3px;
    height: 19px;
    margin-left: -1.5px;
    background: rgba(255, 84, 50, 0.6);
    border-radius: 2px;
    transition: background 220ms ease, box-shadow 220ms ease;
  }
  @media (prefers-reduced-motion: no-preference) {
    .m-ring {
      animation: m-breathe 3.2s ease-in-out infinite;
    }
    @keyframes m-breathe {
      0%, 100% { opacity: 0.75; }
      50% { opacity: 1; }
    }
  }
  .machine:hover .m-ring,
  .machine:focus-visible .m-ring {
    border-color: rgba(255, 96, 60, 0.95);
    box-shadow: 0 0 22px rgba(255, 84, 50, 0.55);
    animation: none;
  }
  .machine:hover .m-core,
