---
// ObjectArt — the D3 swap point for one desk object's art.
//
// Contract (see src/components/studio/assets/README.md + the full spec sheet at
// ~/career-strategy/studio-asset-spec.md): Jon drops a finished asset at
// public/studio/obj-<id>.webp (an .svg or .png sibling with the same basename is
// also accepted). If the file exists at build time it renders here; otherwise the
// dimensioned NEUTRAL placeholder silhouette below renders instead. Same slot,
// same footprint — the swap needs ZERO markup changes.
//
// Placeholder rules (spec: ASSET PROTOCOL): correct real-world footprint, flat
// neutral fills, no invented art style. Each silhouette leans entirely on the
// object's real-world affordance — a synth reads as playable, headphones read as
// listen — with two tones only: --ph-fill (the body) and --ph-line (the hints).
// Both are set per-temperature by StudioDesk (warm paper for design objects,
// dark slate for sound gear), so the silhouettes carry the two-temperature read
// without any color of their own. Every viewBox matches its asset canvas @2x, so
// the placeholder occupies exactly the box Jon's art will.
import fs from "node:fs";
import path from "node:path";

interface Props {
  /** Object id: work | signal | soundlab | writing | illustrations */
  id: string;
}

const { id } = Astro.props;

// Look for Jon's real asset (webp preferred; svg/png siblings accepted).
const candidates = [`obj-${id}.webp`, `obj-${id}.svg`, `obj-${id}.png`];
const asset = candidates.find((f) =>
  fs.existsSync(path.join(process.cwd(), "public", "studio", f))
);
---

{asset ? (
  <img class="oa-img" src={`/studio/${asset}`} alt="" draggable="false" />
) : id === "work" ? (
  // WORK — a portfolio folio (closed), one print corner peeking out. 600×440.
  <svg class="oa-ph" viewBox="0 0 600 440" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <rect x="446" y="66" width="118" height="150" rx="4" transform="rotate(7 505 141)" fill="var(--ph-line)" opacity="0.55" />
    <rect x="40" y="40" width="510" height="360" rx="16" fill="var(--ph-fill)" />
    <path d="M40 168 H550" stroke="var(--ph-line)" stroke-width="3" opacity="0.7" />
    <circle cx="295" cy="262" r="22" fill="none" stroke="var(--ph-line)" stroke-width="3" />
    <circle cx="295" cy="262" r="8" fill="var(--ph-line)" />
    <path d="M295 284 q 34 26 62 14" fill="none" stroke="var(--ph-line)" stroke-width="3" stroke-linecap="round" />
  </svg>
) : id === "signal" ? (
  // SIGNAL — a small desktop synth, top-down: key strip, knobs, a dark screen. 680×400.
  <svg class="oa-ph" viewBox="0 0 680 400" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <rect x="46" y="42" width="588" height="318" rx="16" fill="var(--ph-fill)" />
    {Array.from({ length: 13 }).map((_, i) => (
      <rect x={78 + i * 41} y="242" width="33" height="92" rx="4" fill="var(--ph-line)" opacity="0.85" />
    ))}
    <circle cx="112" cy="120" r="19" fill="var(--ph-line)" />
    <circle cx="178" cy="120" r="19" fill="var(--ph-line)" />
    <circle cx="244" cy="120" r="19" fill="var(--ph-line)" />
    <circle cx="310" cy="120" r="19" fill="var(--ph-line)" />
    <rect x="452" y="82" width="152" height="76" rx="7" fill="var(--ph-line)" opacity="0.6" />
    <rect x="452" y="186" width="72" height="14" rx="7" fill="var(--ph-line)" opacity="0.5" />
  </svg>
) : id === "soundlab" ? (
  // SOUND LAB — headphones, top-down: the band arc + two earcups. 440×440.
  <svg class="oa-ph" viewBox="0 0 440 440" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <path d="M96 262 A 128 128 0 0 1 344 262" fill="none" stroke="var(--ph-fill)" stroke-width="30" stroke-linecap="round" />
    <ellipse cx="92" cy="296" rx="56" ry="70" fill="var(--ph-fill)" />
    <ellipse cx="348" cy="296" rx="56" ry="70" fill="var(--ph-fill)" />
    <ellipse cx="92" cy="296" rx="30" ry="42" fill="var(--ph-line)" opacity="0.7" />
    <ellipse cx="348" cy="296" rx="30" ry="42" fill="var(--ph-line)" opacity="0.7" />
  </svg>
) : id === "writing" ? (
  // WRITING — a spiral notebook with an elastic band. 400×320.
  <svg class="oa-ph" viewBox="0 0 400 320" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <rect x="56" y="28" width="292" height="262" rx="10" fill="var(--ph-fill)" />
    {Array.from({ length: 10 }).map((_, i) => (
      <circle cx="56" cy={52 + i * 24} r="7" fill="none" stroke="var(--ph-line)" stroke-width="3.5" />
    ))}
    <rect x="296" y="28" width="11" height="262" fill="var(--ph-line)" opacity="0.75" />
  </svg>
) : (
  // ILLUSTRATIONS — a pinned sketch over a second loose sheet. 440×340.
  <svg class="oa-ph" viewBox="0 0 440 340" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <rect x="74" y="66" width="278" height="216" rx="4" transform="rotate(-4 213 174)" fill="var(--ph-line)" opacity="0.5" />
    <rect x="88" y="46" width="278" height="226" rx="4" transform="rotate(2 227 159)" fill="var(--ph-fill)" />
    <path d="M150 210 q 40 -66 82 -22 q 34 36 76 -30" fill="none" stroke="var(--ph-line)" stroke-width="4" stroke-linecap="round" opacity="0.8" />
    <circle cx="232" cy="66" r="12" fill="var(--ph-line)" />
  </svg>
)}

<style>
  /* Both the placeholder and the real asset fill the object's footprint box,
     which StudioDesk sizes (width + aspect-ratio from the asset canvas). */
  .oa-img,
  .oa-ph {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    user-select: none;
    -webkit-user-drag: none;
  }
</style>
