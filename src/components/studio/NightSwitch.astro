---
// NightSwitch — the sitewide day/night control for AWAY pages (rendered
// by AwayRail). Two forms, breakpoint-picked by CSS: the brutalist
// console switch (≥900px, the rail's foot) and the single-glyph moon
// cell (<900px, the bottom bar). Both carry [data-night-toggle].
//
// LOCKSTEP NOTE: the homepage has its OWN switch inside StudioOne.astro
// (.rail-night / .mbar-night) because it is coupled to the instrument's
// power source. The two implementations share the storage contract
// (localStorage "studio-night", html[data-night]) and the visual
// language; change one, mirror the other. Mirrored 2026-09-21 (Jon saw
// the drift on /resume): outlined sun + crescent at stroke 1.3, the
// bordered slot, the #45423c ink, SVG glyphs on the phone bar (no emoji).
//
// Never renders in print (both forms live under @media screen).
---

<button class="ns-rail" type="button" data-night-toggle aria-pressed="false" aria-label="Night mode">
  <svg class="ns-glyph ns-sun" viewBox="0 0 12 12" fill="none" stroke="currentColor"
    stroke-width="1.3" stroke-linecap="round" aria-hidden="true">
    <circle cx="6" cy="6" r="2.6" />
    <path d="M6 0.6v1.6M6 9.8v1.6M0.6 6h1.6M9.8 6h1.6" />
  </svg>
  <span class="ns-slot" aria-hidden="true"><i class="ns-thumb"></i></span>
  <svg class="ns-glyph ns-moon" viewBox="0 0 12 12" fill="none" stroke="currentColor"
    stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M9.8 7.6A4.4 4.4 0 0 1 4.4 2.2a4.4 4.4 0 1 0 5.4 5.4Z" />
  </svg>
</button>
<button class="ns-bar" type="button" data-night-toggle aria-pressed="false" aria-label="Night mode">
  <svg class="ns-b-moon" viewBox="0 0 12 12" fill="none" stroke="currentColor"
    stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M9.8 7.6A4.4 4.4 0 0 1 4.4 2.2a4.4 4.4 0 1 0 5.4 5.4Z" />
  </svg>
  <svg class="ns-b-sun" viewBox="0 0 12 12" fill="none" stroke="currentColor"
    stroke-width="1.3" stroke-linecap="round" aria-hidden="true">
    <circle cx="6" cy="6" r="2.6" />
    <path d="M6 0.6v1.6M6 9.8v1.6M0.6 6h1.6M9.8 6h1.6" />
  </svg>
</button>

<style>
  .ns-rail,
  .ns-bar {
    display: none;
  }

  /* ── the console switch (desktop rail foot) — same object as the
     homepage's .rail-night: recessed hard-edge slot, chunky thumb that
     SNAPS, geometric sun/crescent flanks, no emoji ─────────────────── */
  @media screen and (min-width: 900px) {
    .ns-rail {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 12px 8px;
      border: 0;
      background: none;
      color: #45423c;
      cursor: pointer;
    }
  }
  .ns-glyph {
    width: 11px;
    height: 11px;
    flex: none;
    opacity: 0.4;
    transition: opacity 200ms ease, filter 200ms ease;
  }
  .ns-rail[aria-pressed="false"] .ns-sun {
    opacity: 1;
  }
  .ns-rail[aria-pressed="true"] .ns-moon {
    opacity: 1;
  }
  .ns-slot {
    position: relative;
    display: inline-block;
    width: 46px;
    height: 21px;
    flex: none;
    border: 1px solid rgba(20, 18, 16, 0.55);
    border-radius: 2px;
    background: rgba(20, 18, 16, 0.08);
    box-shadow: inset 0 2px 3px rgba(20, 18, 16, 0.3);
  }
  .ns-thumb {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 19px;
    height: 15px;
    border-radius: 1px;
    background: #141210;
    transition: left 130ms cubic-bezier(0.7, 0, 0.3, 1);
  }
  /* machined grip ridges */
  .ns-thumb::before {
    content: "";
    position: absolute;
    inset: 3px 6px;
    border-left: 1.5px solid rgba(245, 242, 234, 0.4);
    border-right: 1.5px solid rgba(245, 242, 234, 0.4);
  }
  .ns-rail[aria-pressed="true"] .ns-thumb {
    left: calc(100% - 21px);
  }
  .ns-rail:hover .ns-slot {
    border-color: #141210;
  }
  .ns-rail:focus-visible {
    outline: 2px solid #141210;
    outline-offset: 2px;
    border-radius: 4px;
  }
  @media (prefers-reduced-motion: reduce) {
    .ns-thumb {
      transition: none;
    }
  }
  /* night clothes: the moon runs its lamp; the thumb is the lit part */
  :global(html[data-night]) .ns-rail {
    color: #8f98a8;
  }
  :global(html[data-night]) .ns-slot {
    border-color: rgba(232, 236, 244, 0.4);
    background: rgba(232, 236, 244, 0.07);
    box-shadow: inset 0 2px 3px rgba(0, 0, 0, 0.5);
  }
  :global(html[data-night]) .ns-thumb {
    background: #e8ecf4;
  }
  :global(html[data-night]) .ns-thumb::before {
    border-left-color: rgba(16, 18, 22, 0.45);
    border-right-color: rgba(16, 18, 22, 0.45);
  }
  :global(html[data-night]) .ns-rail[aria-pressed="true"] .ns-moon {
    filter: drop-shadow(0 0 3px rgba(14, 196, 252, 0.9));
    color: #0ec4fc;
  }
  :global(html[data-night]) .ns-rail:hover .ns-slot {
    border-color: #e8ecf4;
  }
  :global(html[data-night]) .ns-rail:focus-visible {
    outline-color: #e8ecf4;
  }

  /* ── the moon cell (phone bottom bar) — same object as the homepage's
     .mbar-night ─────────────────────────────────────────────────────── */
  @media screen and (max-width: 899px) {
    .ns-bar {
      display: grid;
      place-items: center;
      min-width: 44px;
      min-height: 44px;
      padding: 0 4px;
      border: 0;
      background: none;
      color: #45423c;
      cursor: pointer;
    }
  }
  .ns-b-moon,
  .ns-b-sun {
    width: 16px;
    height: 16px;
  }
  .ns-b-sun {
    display: none;
  }
  :global(html[data-night]) .ns-bar {
    color: #8f98a8;
  }
  :global(html[data-night]) .ns-b-moon {
    display: none;
  }
  :global(html[data-night]) .ns-b-sun {
    display: block;
  }
  .ns-bar:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
    border-radius: 8px;
  }
</style>

<script>
  // Same contract as the homepage switch (minus the instrument power
  // source, which only exists there). NightBoot already applied the
  // attribute pre-paint; this is the interactive layer.
  const root = document.documentElement;
  let manual = false;
  try {
    manual = localStorage.getItem("studio-night") === "1";
  } catch {}
  const apply = () => {
    if (manual) root.setAttribute("data-night", "");
    else root.removeAttribute("data-night");
    const meta = document.querySelector('meta[name="theme-color"]');
    if (meta) meta.setAttribute("content", manual ? "#0b0e14" : "#e9e8e5");
  };
  const btns = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-night-toggle]")
  );
  const sync = () =>
    btns.forEach((b) => b.setAttribute("aria-pressed", manual ? "true" : "false"));
  btns.forEach((b) =>
    b.addEventListener("click", () => {
      manual = !manual;
      try {
        localStorage.setItem("studio-night", manual ? "1" : "0");
      } catch {}
      sync();
      apply();
    })
  );
  sync();
  apply();
</script>
