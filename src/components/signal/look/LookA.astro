  .la-st.la-v1 { background: linear-gradient(180deg, color-mix(in srgb, var(--acc) 34%, #252c36), color-mix(in srgb, var(--acc) 14%, #131820)); box-shadow: inset 0 1px 0 rgba(255, 255, 255, .10); }
  .la-st.la-v2 { background: linear-gradient(180deg, color-mix(in srgb, var(--acc) 92%, #fff), color-mix(in srgb, var(--acc) 58%, #000)); box-shadow: 0 0 12px -2px var(--acc), inset 0 1px 0 rgba(255, 255, 255, .35); }
  .la-st.la-v3 { background: linear-gradient(180deg, color-mix(in srgb, var(--acc) 55%, #fff), color-mix(in srgb, var(--acc) 78%, #000)); box-shadow: 0 0 16px 0 var(--acc), inset 0 1px 0 rgba(255, 255, 255, .5); }
  .la-st.la-hit { filter: brightness(1.45); }
  .la-bt { align-self: start; height: 2px; border-radius: 1px; }
  .la-bt.la-beat { background: color-mix(in srgb, var(--acc) 28%, transparent); }
  /* the step playhead: the sanctioned mover, snapped to the 16th, a column tint + the lit beat rail */
  .la-phd { --cw: calc((100% - 62px) / 16); position: absolute; top: -2px; bottom: 0; z-index: 0; width: var(--cw); left: calc(32px + var(--s) * (var(--cw) + 2px)); border-radius: 3px; background: color-mix(in srgb, var(--acc) 14%, transparent); }
  .la-phd::after { content: ""; position: absolute; left: 0; right: 0; bottom: 2px; height: 2px; border-radius: 1px; background: var(--acc); box-shadow: 0 0 7px -1px var(--acc); }
  .la-dsplit { flex: none; height: 150px; display: flex; align-items: stretch; }
  .la-dmain { flex: 1; min-width: 0; display: flex; flex-direction: column; justify-content: space-between; }
  .la-dknobs { height: 50px; display: flex; justify-content: space-around; align-items: flex-start; padding: 0 12px; }
  .la-dknobs .la-dial { --d: 38px; }
  .la-kl.la-etch, .la-etch .la-kl { color: #8593a2; }
  .la-pat { flex: none; height: 30px; }
  .la-pat > b { flex-direction: column; gap: 3px; padding: 0; }
  .la-pat > b::after { content: none; }
  .la-dots { display: flex; gap: .5px; }
  .la-dots i { width: 2px; height: 2px; border-radius: 50%; background: rgba(200, 215, 235, .14); }
  .la-dots i.la-k { background: rgba(200, 215, 235, .32); }
  .la-pat > b.la-on .la-dots i.la-k { background: var(--la-drums); box-shadow: 0 0 4px var(--la-drums); }
  .la-pate { font-style: normal; font-size: .4rem; letter-spacing: .14em; color: rgba(200, 215, 235, .56); text-shadow: 0 -1px 0 rgba(0, 0, 0, .8), 0 1px 0 rgba(255, 255, 255, .06); }
  .la-pat > b.la-on .la-pate { color: rgba(236, 244, 248, .9); }
  .la-tw-d .la-seg { --acc: var(--la-drums); }
  .la-tex { flex: none; display: flex; align-items: center; gap: 8px; padding: 3px 10px; border-radius: 9px; background: linear-gradient(180deg, #1b212b, #10141b); border: 1px solid rgba(0, 0, 0, .55); box-shadow: inset 0 1px 0 rgba(255, 255, 255, .05); }
  .la-tex .la-dial { --d: 34px; }
  .la-tex .la-kl { font-size: .44rem; }
  .la-texseg { flex: 1; min-width: 0; height: 22px; }
  .la-texseg > b { padding: 0; font-size: .5rem; letter-spacing: .04em; }
  .la-ddiv { flex: none; align-self: stretch; width: 1px; margin: 2px 3px; background: linear-gradient(180deg, transparent, rgba(255, 255, 255, .12) 14%, rgba(255, 255, 255, .12) 86%, transparent); }
  .la-dly { flex: none; width: 80px; display: flex; flex-direction: column; gap: 4px; }
  .la-dlycap { text-align: center; font: 500 .5rem/1 var(--la-mono); letter-spacing: .22em; padding-top: 2px; color: color-mix(in srgb, var(--la-drums) 55%, #8a94a4); }
  .la-dlyk { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: space-evenly; gap: 2px; }
  .la-dlyk .la-knob { gap: 2px; }
  .la-dlyk .la-dial { --d: 30px; }
  .la-dlyk .la-kl { font-size: .44rem; letter-spacing: .12em; }
  .la-scrow { flex: 1; display: flex; justify-content: center; align-items: center; }
  .la-sc .la-dial { --d: 46px; }

  /* ── keys ── */
  .la-voice { --acc: var(--la-keys); flex: 1; min-width: 0; height: 32px; }
  .la-voice > b { padding: 0; letter-spacing: .08em; }
  .la-kf { flex: none; height: 72px; border-radius: 7px; border-color: color-mix(in srgb, var(--la-keys) 26%, rgba(155, 167, 187, .16));
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--la-keys) 24%, transparent), inset 0 3px 12px rgba(0, 0, 0, .72), inset 0 0 44px 10px rgba(0, 0, 0, .5); }
  .la-kf .la-gl.la-maj { stroke: rgba(120, 170, 210, .13); }
  .la-kf .la-gz { stroke: rgba(120, 170, 210, .16); stroke-dasharray: 3 4; }
  .la-kpath { fill: none; stroke: var(--la-curve); stroke-width: 2; stroke-linejoin: round; vector-effect: non-scaling-stroke; filter: drop-shadow(0 0 5px color-mix(in srgb, var(--la-curve) 70%, transparent)); }
  .la-kfill { fill: color-mix(in srgb, var(--la-curve) 10%, transparent); }
  .la-kghost { fill: none; stroke: var(--la-keys); stroke-width: 1.6; opacity: .3; vector-effect: non-scaling-stroke; filter: drop-shadow(0 0 4px color-mix(in srgb, var(--la-keys) 50%, transparent)); }
  .la-flab { position: absolute; bottom: 3px; z-index: 2; transform: translateX(3px); font: 400 9px/1 var(--la-mono); letter-spacing: .02em; color: #4f6f8c; }
  .la-afnode { position: absolute; z-index: 5; width: 20px; height: 20px; border-radius: 50%; transform: translate(-50%, -50%); border: 2.5px solid var(--la-keys);
    background: radial-gradient(circle at 50% 25%, color-mix(in srgb, var(--la-keys) 50%, transparent), rgba(4, 14, 14, .4) 70%); box-shadow: 0 0 14px -1px var(--la-keys); }
  .la-band { flex: 1; min-height: 0; display: grid; grid-template-columns: 150px minmax(0, 1fr); gap: 8px; }
  .la-lfo { display: flex; flex-direction: column; align-items: center; gap: 5px; padding: 8px 6px 6px; border-radius: 8px; background: linear-gradient(180deg, rgba(0, 0, 0, .26), rgba(0, 0, 0, .1)); border: 1px solid rgba(255, 255, 255, .03); box-shadow: inset 0 1px 4px rgba(0, 0, 0, .5); }
  .la-lfod { flex: 1; min-height: 0; align-self: stretch; display: flex; flex-direction: column; align-items: center; justify-content: space-evenly; }
  .la-kg { position: relative; display: grid; grid-template-columns: auto auto; grid-template-areas: "d d" "l n"; justify-items: center; align-items: center; column-gap: 5px; row-gap: 6px; }
  .la-kg .la-dial { grid-area: d; } .la-kg .la-kl { grid-area: l; font-size: .48rem; } .la-kg .la-lcd { grid-area: n; }
  .la-motion .la-dial { --d: 56px; }
  .la-rate .la-dial { --d: 38px; background: radial-gradient(circle at 50% 38%, #12161e, #0a0d12 80%); }
  .la-waves { flex: none; align-self: stretch; display: grid; grid-template-columns: 1fr 1fr; gap: 7px 5px; padding: 0 4px 4px; }
  .la-waves .la-cap { height: 22px; }
  .la-waves .la-on { --acc: var(--la-amber); }
  .la-fx { min-width: 0; display: flex; gap: 8px; }
  .la-fxcol { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6px; }
  /* the LCD FX tower: a monochrome keys-ink meter; the fader IS the readout */
  .la-fxcard { position: relative; flex: 1 1 auto; min-height: 96px; border-radius: 6px; overflow: hidden;
    background: linear-gradient(180deg, color-mix(in srgb, var(--la-keys) 9%, #0b0e0e), color-mix(in srgb, var(--la-keys) 4%, #0b0e0e)); box-shadow: inset 0 0 0 1px rgba(0, 0, 0, .8), inset 0 2px 6px rgba(0, 0, 0, .6); }
  .la-fxcard::before { content: ""; position: absolute; inset: 0; z-index: 3; pointer-events: none; background: repeating-linear-gradient(0deg, rgba(0, 0, 0, .16) 0 1px, transparent 1px 3px), repeating-linear-gradient(90deg, rgba(0, 0, 0, .1) 0 1px, transparent 1px 3px); }
  .la-fill { position: absolute; left: 4px; right: 4px; bottom: 4px; z-index: 1; height: calc(var(--v) * 100%); max-height: calc(100% - 30px); border-radius: 1px;
    background: repeating-linear-gradient(0deg, var(--la-keys) 0 3px, color-mix(in srgb, var(--la-keys) 12%, transparent) 3px 5px); box-shadow: 0 0 8px color-mix(in srgb, var(--la-keys) 45%, transparent); }
  .la-fill::before { content: ""; position: absolute; left: 0; right: 0; top: 0; height: 2px; background: color-mix(in srgb, var(--la-keys) 55%, #fff); box-shadow: 0 0 6px color-mix(in srgb, var(--la-keys) 70%, transparent); }
  .la-fxdel .la-fill { background-image: repeating-linear-gradient(0deg, var(--la-keys) 0 8px, color-mix(in srgb, var(--la-keys) 12%, transparent) 8px 10px); }
  .la-fl { position: absolute; left: 0; right: 0; top: 7px; z-index: 2; text-align: center; font: 500 .52rem/1 var(--la-mono); letter-spacing: .14em; color: color-mix(in srgb, var(--la-keys) 72%, #fff); text-shadow: 0 0 6px color-mix(in srgb, var(--la-keys) 70%, transparent); }
  .la-seg.la-col { flex-direction: column; gap: 3px; }
  .la-sub { flex: none; min-height: 114px; }
  .la-sub > b { flex: none; height: 18px; padding: 0; font-size: .46rem; letter-spacing: .03em; }
  .la-glyphs > b svg { fill: currentColor; opacity: .7; }
  .la-glyphs > b.la-on svg { opacity: 1; filter: drop-shadow(0 0 3px var(--acc)); }
  .la-modrate { flex: none; display: flex; flex-direction: column; gap: 2px; margin-top: 4px; }
  .la-mrtrack { position: relative; height: 9px; border-radius: 5px; background: linear-gradient(180deg, #0a0f14, #070b10); box-shadow: inset 0 1px 3px rgba(0, 0, 0, .7), inset 0 0 0 1px rgba(0, 0, 0, .5); }
  .la-mrfill { position: absolute; left: 2px; top: 2px; bottom: 2px; width: 58%; z-index: 1; border-radius: 4px 1px 1px 4px; background: repeating-linear-gradient(90deg, var(--la-mod) 0 3px, color-mix(in srgb, var(--la-mod) 12%, transparent) 3px 5px); box-shadow: 0 0 8px -1px var(--la-mod); }
  .la-mrdet { position: absolute; left: 50%; top: 2px; bottom: 2px; width: 1px; margin-left: -.5px; z-index: 2; background: rgba(255, 255, 255, .22); box-shadow: 0 0 0 .5px rgba(0, 0, 0, .6); }
  .la-mrcap { text-align: center; font: 500 .42rem/1 var(--la-mono); letter-spacing: .16em; color: color-mix(in srgb, var(--la-mod) 52%, #8d99a6); }

  /* ── bass ── */
  .la-cmd { --acc: var(--la-bass); flex: 1; min-height: 0; display: flex; flex-direction: column; gap: 6px; padding: 0 12px 9px; border-radius: 11px;
    background: radial-gradient(130% 120% at 50% 0%, #0c141e, #05080e 84%); border: 1px solid color-mix(in srgb, var(--la-bass) 58%, #000);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, .06), inset 0 0 0 1px color-mix(in srgb, var(--la-bass) 44%, #000), inset 0 2px 9px rgba(0, 0, 0, .5), inset 0 0 22px -6px var(--la-bass); }
  .la-bmrow { flex: none; height: 36px; display: flex; align-items: center; gap: 8px; }
  .la-bmode { flex: 1; }
  .la-bmode > b { letter-spacing: .1em; }
  .la-lock { flex: none; width: 36px; height: 32px; padding: 0; }
  .la-lock svg { width: 15px; height: 15px; }
  .la-lock svg path { stroke-width: 1.4; }
  .la-lock svg rect { fill: #9aa6b4; }
  .la-lock.la-on svg rect { fill: #eafaff; filter: drop-shadow(0 0 3px var(--acc)); }
  .la-bnote { flex: none; min-width: 30px; text-align: center; font: 500 .62rem/1 var(--la-mono); letter-spacing: .05em; color: color-mix(in srgb, var(--la-bass) 72%, #fff); text-shadow: 0 0 8px color-mix(in srgb, var(--la-bass) 50%, transparent); }
  .la-bpat { flex: 1; min-height: 64px; display: flex; flex-direction: column; justify-content: center; gap: 14px; padding: 8px 8px 2px; }
  .la-bbars { flex: none; height: 72px; display: flex; align-items: flex-end; gap: 3px; }
  .la-bar { position: relative; flex: 1; height: var(--h); border-radius: 3px 3px 2px 2px; background: linear-gradient(180deg, #161a23, #0d0f16); box-shadow: inset 0 1px 2px rgba(0, 0, 0, .7); }
  .la-bar.la-on { background: linear-gradient(180deg, color-mix(in srgb, var(--acc) 92%, #fff), color-mix(in srgb, var(--acc) 58%, #000)); box-shadow: 0 0 12px -2px var(--acc), inset 0 1px 0 rgba(255, 255, 255, .35); }
  .la-bar.la-acc { background: linear-gradient(180deg, color-mix(in srgb, var(--acc) 55%, #fff), color-mix(in srgb, var(--acc) 78%, #000)); box-shadow: 0 0 16px 0 var(--acc), inset 0 1px 0 rgba(255, 255, 255, .5); }
  .la-bar.la-beat::after { content: ""; position: absolute; left: 0; right: 0; bottom: -5px; height: 2px; border-radius: 1px; background: color-mix(in srgb, var(--acc) 28%, transparent); }
  .la-bar.la-slide::before { content: "→"; position: absolute; top: -12px; left: 50%; transform: translateX(-50%); font: 8px/1 var(--la-mono); color: color-mix(in srgb, var(--acc) 65%, #cfd4e2); }
  .la-bprow { flex: none; display: flex; justify-content: space-around; align-items: flex-start; }
  .la-bkrow { flex: none; height: 58px; display: flex; align-items: center; justify-content: space-around; padding: 0 4px; }
  .la-cmd .la-dial { --d: 38px; }
  .la-cmd .la-kl { color: #ece6ff; text-shadow: 0 0 8px color-mix(in srgb, var(--la-bass) 60%, transparent); }
  .la-cmd .la-seg { --acc: var(--la-bass); }

  /* ── 3 · hands row (the pianohead) ── */
  .la-ph { margin-top: 10px; height: 44px; display: flex; align-items: center; gap: 12px; padding: 0 12px; border-radius: 11px;
    font: 400 .5rem/1 var(--la-mono); letter-spacing: .16em; text-transform: uppercase; color: #7d8a99;
    background: radial-gradient(130% 130% at 50% 0%, #121a26, #080c12 86%); border: 1px solid rgba(255, 255, 255, .05);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, .05), inset 0 0 0 1px rgba(0, 0, 0, .6), inset 0 3px 11px rgba(0, 0, 0, .56); }
  .la-phsec { display: flex; align-items: center; gap: 8px; }
  .la-oct { width: 28px; height: 28px; border-radius: 8px; box-shadow: inset 0 1.2px .5px rgba(255, 255, 255, .22), inset 0 -4px 6px rgba(0, 0, 0, .5), 0 4px 0 var(--la-wall), 0 5px 7px rgba(0, 0, 0, .55); }
  .la-oct:active { transform: translateY(3px); }
  .la-oct svg { width: 8px; height: 8px; }
  .la-oct svg path { fill: #bcc7d3; stroke: none; }
  .la-oh { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; line-height: 1; min-width: 48px; height: 34px; padding: 0 9px; border-radius: 2px;
    background: radial-gradient(130% 130% at 50% 0%, #080e16, #04060b 80%); border: 1px solid rgba(255, 255, 255, .05); box-shadow: inset 0 0 0 1px rgba(0, 0, 0, .82), inset 0 2px 8px rgba(0, 0, 0, .7), inset 0 -1px 0 rgba(255, 255, 255, .03); }
  .la-oh > b { font: 400 1rem/1 var(--la-mono); letter-spacing: .04em; color: #ffcf8f; text-shadow: 0 0 7px color-mix(in srgb, var(--la-amber) 70%, transparent); }
  .la-oh > small { margin-top: 3px; font: 400 .4rem/1 var(--la-mono); letter-spacing: .2em; color: #52606f; text-shadow: 0 -1px 0 rgba(0, 0, 0, .8), 0 1px 0 rgba(255, 255, 255, .05); }
  .la-keyscr { min-width: 70px; }
  .la-keyscr > b { font-size: .78rem; letter-spacing: .06em; }
  .la-phmid { flex: 1; min-width: 0; display: flex; align-items: center; justify-content: center; }
  .la-chord { --acc: var(--la-sapph); flex: none; width: 220px; height: 36px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3px; text-transform: none; }
  .la-cl { font: 400 1.08rem/1 var(--la-mono); letter-spacing: .02em; color: #cfefff; text-shadow: 0 0 7px color-mix(in srgb, var(--la-sapph) 68%, transparent); }
  .la-cd { font: 400 .56rem/1 var(--la-mono); letter-spacing: .13em; color: color-mix(in srgb, var(--la-sapph) 60%, #93b8ca); text-shadow: 0 0 5px color-mix(in srgb, var(--la-sapph) 38%, transparent); }
  .la-tog { --acc: var(--la-sapph); height: 28px; padding: 0 14px; font-size: .55rem; letter-spacing: .06em; text-transform: uppercase; }
  .la-tog.la-on { transform: none; }
  .la-divh { flex: none; width: 1px; height: 24px; background: linear-gradient(180deg, transparent, rgba(255, 255, 255, .16) 22%, rgba(255, 255, 255, .16) 78%, transparent); }
  .la-arp { display: flex; align-items: center; gap: 12px; }
  .la-arpk { --acc: var(--la-sapph); gap: 2px; }
  .la-arpk .la-dial { --d: 28px; box-shadow: 0 0 8px -2px var(--la-sapph), inset 0 0 0 1px rgba(0, 0, 0, .6), 0 1px 2px rgba(0, 0, 0, .5); }
  .la-arpk .la-kl { font-size: .4rem; text-shadow: 0 -1px 0 rgba(0, 0, 0, .8), 0 1px 0 rgba(255, 255, 255, .06); }
  .la-arpk .la-stick { inset: -4px; }

  /* ── 4 · the chord rack: recessed wells; a stamped pad stands proud, sapphire-lit ── */
  .la-rack { margin-top: 8px; height: 36px; display: flex; gap: 5px; padding: 0 8px; }
  .la-pad { position: relative; flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3px; border: 1px solid rgba(0, 0, 0, .6); border-radius: 8px;
    background-image: var(--la-noise), radial-gradient(120% 120% at 50% 0%, #10151d, #090c11); background-blend-mode: soft-light, normal; background-size: 80px 80px, auto;
    box-shadow: inset 0 2px 6px rgba(0, 0, 0, .66), inset 0 0 0 1px rgba(0, 0, 0, .5), inset 0 -1px 0 rgba(255, 255, 255, .02); transition: transform .09s cubic-bezier(.2, .7, .3, 1); }
  .la-crk { position: absolute; top: 3px; left: 6px; font: 500 .72rem/1 var(--la-mono); letter-spacing: .02em; color: rgba(150, 167, 187, .5); text-shadow: 0 -1px 0 rgba(0, 0, 0, .85), 0 1px 0 rgba(255, 255, 255, .05); }
  .la-pad.la-full { background-image: var(--la-noise), linear-gradient(180deg, #333c49 0%, #252c37 47%, #1b212b 100%); border-top: 1px solid rgba(255, 255, 255, .1);
    box-shadow: inset 0 1.4px .5px rgba(255, 255, 255, .18), inset 0 -4px 6px rgba(0, 0, 0, .46), 0 3px 0 #0a0d12, 0 5px 7px rgba(0, 0, 0, .5); }
  .la-pad.la-full:active { transform: translateY(2px); }
  .la-pad.la-sel { border-color: color-mix(in srgb, var(--la-sapph) 55%, rgba(0, 0, 0, .6));
    box-shadow: inset 0 1.4px .5px rgba(255, 255, 255, .18), inset 0 -4px 6px rgba(0, 0, 0, .46), 0 0 0 1px color-mix(in srgb, var(--la-sapph) 45%, transparent), 0 3px 0 #0a0d12, 0 5px 7px rgba(0, 0, 0, .5); }
  .la-crl { font: 400 .66rem/1 var(--la-mono); letter-spacing: .01em; color: #cfefff; text-shadow: 0 0 6px color-mix(in srgb, var(--la-sapph) 62%, transparent); }
  .la-crd { font: 400 .44rem/1 var(--la-mono); letter-spacing: .1em; color: color-mix(in srgb, var(--la-sapph) 58%, #93b8ca); }

  /* ── 5 · the keybed: graphite naturals, one sapphire lamp where state calls for it ── */
  .la-kb { margin-top: 8px; height: 100px; }
  .la-piano { position: relative; height: 84px; padding-top: 6px; border-radius: 12px 12px 0 0;
    background: linear-gradient(180deg, color-mix(in srgb, var(--la-sapph) 14%, #0a0d12), #05070a); border: 1px solid rgba(0, 0, 0, .65);
    box-shadow: inset 0 3px 12px rgba(0, 0, 0, .7), inset 0 0 0 1px color-mix(in srgb, var(--la-sapph) 55%, transparent); }
  .la-wk { position: absolute; top: 6px; bottom: 0; left: calc(var(--i) * 100% / 29); width: calc(100% / 29); display: flex; flex-direction: column; justify-content: flex-end; align-items: center; padding-bottom: 8px; border-radius: 0 0 7px 7px;
    background: linear-gradient(180deg, #3b444f 0%, #2b333d 55%, #222932 100%); border: 1px solid rgba(255, 255, 255, .2); border-top: none;
    box-shadow: inset 0 7px 11px -7px rgba(255, 255, 255, .13), inset 0 -7px 11px -6px rgba(0, 0, 0, .4), 0 2px 4px rgba(0, 0, 0, .5); }
  .la-bk { position: absolute; top: 6px; z-index: 3; height: 52px; width: calc(100% / 29 * .62); left: calc((var(--i) + 1) * 100% / 29 - 100% / 29 * .31); opacity: .8; border-radius: 0 0 5px 5px;
    background: linear-gradient(180deg, #12171f, #080b10 82%); border: 1px solid rgba(255, 255, 255, .14); box-shadow: inset 0 1px 0 rgba(255, 255, 255, .08), inset 0 -8px 9px rgba(0, 0, 0, .7), 0 4px 6px rgba(0, 0, 0, .7); }
  .la-ql { position: absolute; top: 5px; left: 0; right: 0; text-align: center; font: 500 .46rem/1 var(--la-mono); letter-spacing: .06em; color: rgba(214, 226, 240, .62); }
  .la-bk .la-ql { top: 4px; font-size: .4rem; letter-spacing: .04em; }
  .la-nl { font: 500 .82rem/1 var(--la-mono); letter-spacing: .02em; color: #f2fdff; text-shadow: 0 0 9px color-mix(in srgb, var(--la-sapph) 75%, transparent); }
