---
// SIGNAL · THE INSTRUMENT'S MARKUP (R1 the integrator's; R2 lane B: the host-compatible root, the power, the words).
// THE HOST CONTRACT (src/components/studio/StudioOne.astro relies on these; CLAUDE.md "Sacred / hazard files"):
//   #sgm[data-state]   standby → boot → live → powerdown → standby, written by src/signal/view/power.ts only (the host
//                      watches it: boot/live = the site goes night; it clicks #pwr when the room is < 35 % visible)
//   svg.sgm-trace      the power's perimeter line, laid over the DEVICE's grid cell only (power.css)
//   .sgm > .device     the 1120 px box the host zooms with --sig-zoom; .sgm's parent is the fit's measure
//   #pwr               the power disc: power.ts mounts it in the top strip's middle (hands-view.ts's .sgh-power slot)
// The device is the material's root `.sig` (the tokens + base; data-live="1" only while live) around the empty strata
// the views fill:
//   [data-strata]   the device's column (gap 8): hands-view.ts PREPENDS the top strip and APPENDS the keybed block
//     .sig-towers   330 · 566 · 330 with 13 px gaps = the 1252 the 14 px chassis padding leaves of DEVICE_W 1280, 540 tall
//       [data-slot=drums|keys|bass]   mountDrumsView / mountKeysView / mountBassView: each tower fills its cell
// R3: the device is 1280 wide (types.ts DEVICE_W); the host zooms it by BOTH axes (this page's script, StudioOne). Nothing
// prints beneath the device this round (the legend + the brief are unmounted; ./signal-copy.ts stays on disk for Jon).
// The recipes are src/styles/signal/material.css (@layer sg-material); each stratum's layout is its view lane's sheet;
// the power's states and the dark are power.css. The boot (src/signal/main.ts) runs once the DOM is parsed, and never
// where the device is not shown (a phone, a coarse pointer, a window under 900 px: the page shows the still instead;
// widening the window boots it then). The key door goes on BEFORE the boot (its listener must precede the keymap's),
// the power AFTER it (the disc needs the top strip).
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "@fontsource/ibm-plex-sans/400.css";
import "@fontsource/orbitron/500.css";
import "../../styles/signal/material.css";
import "../../styles/signal/keycap.css";
import "../../styles/signal/drums.css";
import "../../styles/signal/keys.css";
import "../../styles/signal/bass.css";
import "../../styles/signal/hands.css";
import "../../styles/signal/power.css";
import { DEVICE_W } from "../../signal/types.ts";
---

<div class="sgm" id="sgm" data-state="standby">
  <svg class="sgm-trace" aria-hidden="true"><path class="tr-l"></path><path class="tr-r"></path></svg>
  <div class="device sig sig-device" id="sig-device">
    <div class="sig-strata" data-strata>
      <div class="sig-towers">
        <div class="sig-slot" data-slot="drums"></div>
        <div class="sig-slot" data-slot="keys"></div>
        <div class="sig-slot" data-slot="bass"></div>
      </div>
    </div>
  </div>
</div>

<style is:global>
  /* ── the root: one grid column as wide as the (zoomed) device; the trace svg shares the device's cell (power.css),
     so .sgm is exactly the device's box wide and the host's fit-content centring holds ── */
  .sgm {
    position: relative; display: grid; grid-template-columns: minmax(0, auto); width: fit-content; margin-inline: auto;
    --sgm-ink: #141210; --sgm-dim: #6a6660; --sgm-line: rgba(20, 18, 16, 0.2);
  }
  @media screen {
    html[data-night] .sgm { --sgm-ink: #e8ecf4; --sgm-dim: #7d8798; --sgm-line: rgba(232, 236, 244, 0.2); }
  }
  .sgm > .device { width: 1280px; }   /* = types.ts DEVICE_W; the hosts pin the same number */

  /* the strata the views fill (unlayered: the material's @layer never fights it): top strip 48 · towers 540 · keybed */
  .sig .sig-strata { position: relative; z-index: 1; display: flex; flex-direction: column; gap: 8px; }
  .sig .sig-towers {
    flex: none; display: grid; column-gap: 13px; height: 540px;
    grid-template-columns: 330px 566px 330px;
  }
  .sig .sig-slot { position: relative; min-width: 0; min-height: 0; display: flex; }

</style>

<script>
  import { boot } from "../../signal/main.ts";
  import { guardKeys, mountPower } from "../../signal/view/power.ts";

  const sgm = document.getElementById("sgm");
  const device = document.getElementById("sig-device");
  const hidden = window.matchMedia("(max-width: 899px), (pointer: coarse)");
  let started = false;
  const go = (): void => {
    if (started || !sgm || !device || hidden.matches) return;
    started = true;
    hidden.removeEventListener("change", go);
    guardKeys(sgm);   // the key door first: its capture listener must run before the keymap's (attached inside boot)
    boot(device)
      .then((b) => { if (b) mountPower(sgm, b.instrument); })
      .catch((e) => console.error("[signal] boot failed", e));
  };
  const start = (): void => {
    go();
    if (!started) hidden.addEventListener("change", go);
  };
  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", start, { once: true });
  else start();
</script>
