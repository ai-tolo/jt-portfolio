---
// SIGNAL · THE INSTRUMENT'S MARKUP (the integrator's, R1). One root `.sig` (the material's tokens + base, data-live="1"
// so every lit recipe may light), the carbon chassis `.sig-device`, and the empty strata the views fill:
//   [data-strata]   the device's column (gap 8): hands-view.ts PREPENDS the top strip and APPENDS the hands block
//     .sig-towers   290 · 494 · 290 (the side columns take what the 14 px chassis padding leaves), 520 tall
//       [data-slot=drums|keys|bass]   mountDrumsView / mountKeysView / mountBassView: each tower fills its cell
// The recipes are src/styles/signal/material.css (@layer sg-material); each stratum's layout is its view lane's sheet.
// The boot (src/signal/main.ts) runs once the DOM is parsed, and never where the device is not shown (a phone, a
// coarse pointer, a window under 900 px: the page shows the still instead; widening the window boots it then).
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "@fontsource/orbitron/500.css";
import "../../styles/signal/material.css";
import "../../styles/signal/drums.css";
import "../../styles/signal/keys.css";
import "../../styles/signal/bass.css";
import "../../styles/signal/hands.css";
---

<div class="sig" data-live="1" id="sig">
  <div class="sig-device" id="sig-device">
    <div class="sig-strata" data-strata>
      <div class="sig-towers">
        <div class="sig-slot" data-slot="drums"></div>
        <div class="sig-slot" data-slot="keys"></div>
        <div class="sig-slot" data-slot="bass"></div>
      </div>
    </div>
  </div>
</div>

<style is:global>
  /* the strata the views fill (unlayered: the material's @layer never fights it) */
  .sig .sig-strata { position: relative; z-index: 1; display: flex; flex-direction: column; gap: 8px; min-height: 841px; }
  .sig .sig-towers {
    flex: none; display: grid; gap: 12px; height: 520px;
    grid-template-columns: minmax(0, 1fr) var(--sgh-mid, 494px) minmax(0, 1fr);
  }
  .sig .sig-slot { position: relative; min-width: 0; min-height: 0; display: flex; }
</style>

<script>
  import { boot } from "../../signal/main.ts";

  const device = document.getElementById("sig-device");
  const hidden = window.matchMedia("(max-width: 899px), (pointer: coarse)");
  let started = false;
  const go = (): void => {
    if (started || !device || hidden.matches) return;
    started = true;
    hidden.removeEventListener("change", go);
    boot(device).catch((e) => console.error("[signal] boot failed", e));
  };
  const start = (): void => {
    go();
    if (!started) hidden.addEventListener("change", go);
  };
  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", start, { once: true });
  else start();
</script>
