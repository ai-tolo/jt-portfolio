---
/**
 * SignalCard — the card under the instrument (2026-09-30, the export round): the work room's card, for SIGNAL. Always
 * open (Jon, 2026-10-07: the same law as the case studies). The "?" key in the instrument's head lands on its TOP
 * ([data-write-up]): the title and the words in view, the diagram beneath them. 96 px under the device: air, still SIGNAL's (a room gap would detach it). Inside: the
 * write-up (signal-card-copy.ts, Jon's to rewrite) · HOW TO PLAY (./HowToPlay.astro: one keyboard diagram drawn from
 * signal-copy.ts LEGEND, 2026-10-06) · UNDER THE HOOD (the engine, a spine of steps) · WHERE IT CAME FROM. Mounted by StudioOne's play room (inside .sig-desktop, so
 * it exists only where the instrument plays) and by /signal.
 * 2026-10-13 (ONE ANATOMY): the card is a `.sheet` (src/styles/sheet.css), the material, rhythm and parts the
 * work-room sheets share: the kind word over its title (round two: the numbered readout line is gone), a hairline and
 * a label opening each section, the steps' spine. That file is its only dependency outside this folder; what stays
 * here is its own: the title, the 96 px under the device, the sapphire, and the names HowToPlay reads.
 * 2026-10-13 round four (Jon: "I want the white sheet to go underneath the signal instrument to make it feel like
 * it's one thing"): `part="around"` is the homepage's play room: ONE sheet that carries the kind word, the title and
 * the story, then the device (the host's slot: its own stage, scaled and fitted from StudioOne), then how to play,
 * under the hood and where it came from. The paper runs on behind the device; powered, the device is wider than the
 * sheet and overhangs both its edges (the host keeps every box overflow-visible). Inside it the sheet's own rhythm:
 * story → device 56, device → how to play's hairline 56 (the host's stage margins). The "?" key's landing,
 * [data-write-up], is the HOW TO PLAY section there (its hairline and label in view at the top); on "all" (the
 * default: the whole card, 96 px beneath the device, as /signal mounts it) it is still the whole card.
 * (Round three's "head" / "tail" halves, two sheets around the device, are retired with it.)
 */
import "../../styles/sheet.css";
import { CARD, type CardRow } from "./signal-card-copy.ts";
import HowToPlay from "./HowToPlay.astro";

interface Props { part?: "all" | "around" }
const { part = "all" } = Astro.props;
const around = part === "around";

const halves = (rows: ReadonlyArray<CardRow>): CardRow[][] => {
  const cut = Math.ceil(rows.length / 2);
  return [rows.slice(0, cut), rows.slice(cut)];
};
const cols = (ps: ReadonlyArray<string>): string[][] => {
  const cut = Math.ceil(ps.length / 2);
  return [ps.slice(0, cut), ps.slice(cut)];
};
---

<div class="sc sheet" data-signal-card data-part={part} data-write-up={around ? undefined : ""}>
  <p class="sheet-kind">{CARD.kind}</p>
  <h4 class="sc-title">{CARD.title}</h4>
  <div class="sc-story sheet-cols">
    {cols(CARD.story).map((col) => (
      <div class="sheet-col">{col.map((p) => <p class="sheet-p" set:html={p} />)}</div>
    ))}
  </div>

  {around && <slot />}

  <div class="sheet-sec sc-how" data-write-up={around ? "" : undefined}>
    <p class="sheet-t" id="how-to-play">{CARD.howTitle}</p>
    <HowToPlay />
  </div>

  <div class="sheet-sec">
    <p class="sheet-t">{CARD.hoodTitle}</p>
    <div class="sheet-cols">
      {halves(CARD.rows).map((col) => (
        <ol class="sheet-steps">
          {col.map((r) => (
            <li class="sheet-step">
              <div class="sheet-step-head"><span class="sheet-step-k">{r.k}</span><span class="sheet-step-tool">{r.tool}</span></div>
              <p class="sheet-step-p" set:html={r.html} />
            </li>
          ))}
        </ol>
      ))}
    </div>
  </div>

  <div class="sheet-sec">
    <p class="sheet-t">{CARD.fromTitle}</p>
    <div class="sheet-cols">
      {cols(CARD.from).map((col) => (
        <div class="sheet-col">{col.map((p) => <p class="sheet-p" set:html={p} />)}</div>
      ))}
    </div>
  </div>
</div>

<style>
  /* the card's own; the sheet (material, inks, night, the kind word, sections, steps) is src/styles/sheet.css */
  .sc {
    --sheet-acc: #4fd1ff; /* the instrument's own light: the keys' sapphire */
    /* HowToPlay's diagram reads these two names; they follow the sheet's ink (day and night) and mono */
    --sc-ink: var(--sheet-ink);
    --sc-mono: var(--sheet-mono);
    position: relative;
    margin: 0 auto; /* "around": the host's room spaces it like the other sheets */
    padding: var(--sheet-pad); /* the bottom: the last section's 16 + the gutter = the work sheets' 16 + their handle */
  }
  /* the "?" key's landing: the whole card from its top (/signal), or how to play's hairline + label (the homepage) */
  [data-write-up] { scroll-margin-top: 32px; }
  .sc[data-part="all"] { margin-top: 96px; } /* the whole card, 96 px under the device (/signal) */
  .sc-title {
    margin: 0 0 40px;
    text-align: center;
    font-family: var(--sheet-display);
    font-size: 2.125rem;
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: 0.06em;
  }
  .sc-story { margin-bottom: 32px; } /* the story → the first hairline, as the work sheets' story → their hood */
  .sc[data-part="around"] .sc-story { margin-bottom: 0; } /* the story ends on its last line: the device's stage
     carries the 56 beneath it and the 56 to how to play's hairline (StudioOne) */
</style>
