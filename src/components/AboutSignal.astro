</style>

<script>
  /* The staged about. Native scroll → a 0→1 progress `--p`, split into three
     acts. The dot rides the line's exact curve; the gradient trace fills to the
     dot; the waypoint nodes ignite in sync with the descriptors. The name lifts
     away first. Touch / reduced-motion / narrow get the calm static base. */
  (() => {
    const als = document.querySelector<HTMLElement>(".als");
    if (!als) return;
    const track = als.querySelector<HTMLElement>(".als-track");
    const stage = als.querySelector<HTMLElement>(".als-stage");
    const dot = als.querySelector<HTMLElement>(".als-dot");
    const beats = als.querySelector<HTMLElement>(".als-beats");
    const link = als.querySelector<HTMLElement>(".als-link");
    const nodes = Array.from(als.querySelectorAll<HTMLElement>(".als-node"));
    const work = document.querySelector<HTMLElement>(".work");
    const warp = als.querySelector<HTMLElement>(".als-warp");
    const glow = als.querySelector<HTMLElement>(".als-glow");
    const streaks = Array.from(als.querySelectorAll<HTMLElement>(".als-streak"));
    const blips = Array.from(als.querySelectorAll<HTMLElement>(".als-blip"));
    const glints = Array.from(als.querySelectorAll<HTMLElement>(".als-glint"));
    // cache each glint's twinkle phase + rate once (avoid a per-frame dataset parse ×N)
    const glintPh = glints.map((el) => +(el.dataset.ph || 0));
    const glintF = glints.map((el) => +(el.dataset.f || 80));
    const cradle = als.querySelector<HTMLElement>(".als-cradle");
    const cradleArcs = Array.from(als.querySelectorAll<SVGElement>(".als-cradle-arc")) as unknown as HTMLElement[];
    const cradleLock = als.querySelector<SVGElement>(".als-cradle-lock") as unknown as HTMLElement;
    const setArcs = (v: string) => { for (const a of cradleArcs) a.style.strokeDasharray = v; };
    if (!track || !stage || !dot || !beats) return;

    // ── the wave's curve (matches the build-time path), for the ball to ride ──
    const harm = (t: number) =>
      Math.sin(t * 9) * 0.55 + Math.sin(t * 22 + 1) * 0.3 + Math.sin(t * 41 + 2) * 0.18;
    const VH = 160, MID = 80, AMP = 56;
    const lineY = (t: number) => MID - harm(t) * AMP;
    const NX = [0.12, 0.46, 0.8];
    // the wave's point at parameter t in SCREEN space, given its live offset (wy) +
    // amplitude (wamp). Mirrors the CSS (.als-wave: top 8svh, height clamp(150,23vh,
    // 230), translateY(wy) scaleY(wamp) about centre). The ball is a stage child, so
    // it sits on the curve without inheriting the wave's scale (stays round).
    const waveH = () => Math.min(230, Math.max(150, 0.23 * window.innerHeight));
    const waveY = (t: number, wy: number, wamp: number) => {
      const vh = window.innerHeight, H = waveH();
      return 0.08 * vh + wy + H / 2 + (lineY(t) / VH - 0.5) * H * wamp;
    };

    // ── easing ──
    const clamp = (v: number, a: number, b: number) => Math.min(b, Math.max(a, v));
    const seg = (v: number, a: number, b: number) => clamp((v - a) / (b - a), 0, 1); // sub-progress
    const ease = (t: number) => t * t * (3 - 2 * t);                 // smoothstep
    const ease2 = (t: number) => 0.6 * ease(t) + 0.4 * t;            // softened — uniform, fluid
    const easeOut = (t: number) => 1 - (1 - t) * (1 - t);            // decelerate (into the groove)

    // ── the ONE timeline, in scroll progress p over the track. Each phase flows
    // into the next; the comet fall is the long, dominant stretch. ──
    const ENTER = 0.09;     // the ball starts sliding in from off the left
    const LIFT = 0.15;      // by here: name fully off-screen + wave docked + ball settled
    const FALL = 0.42;      // the ride ends, the ball begins its (long) comet fall
    const ARRIVE = 0.90;    // the comet reaches the cradle; the scroll CATCHES here (locks down)
    const WORK_RISE = 0.90; // the work stays tucked below until the catch; the capture DELIVERS it
    const WORK_LAND = 1.0;  // the work fully landed at the track end (the capture auto-scrolls ARRIVE→here)
    const CAP_MS = 2000;    // capture duration (cool → arcs close → lock → SEAL → held beat → transfer + delivery)
    const CATCH_BEAT = 450; // ignore down-intent this long after catching (let flick-momentum settle)
    const OFFV = 0.10;      // the work rests this far (× viewport) below the top (was 0.18 → 55%)
    const BALL_OFF = 0.1;   // the ball's start x, fully off the left edge
    const BALL_REST = 0.06; // its resting x — fully visible, just inside the edge
    // warp streak depths: speed (× fall travel) + tile height (px) for the seamless
    // modulo loop. MUST match the .als-streak background-size heights in the CSS.
    const STREAK_SP = [1, 0.78, 0.6, 0.46, 0.34];
    const STREAK_TH = [290, 420, 560, 700, 860];
    const STREAK_OP = [0.95, 0.8, 0.72, 0.62, 0.52];  // per-layer base brightness (near→far); JS shimmers it by scroll
    const GROWTH = 1.0;     // the comet's size growth over the fall (1 → 1+GROWTH at the park) — more dramatic
    const DOCK_Y = 40;      // the cradle/catch sits this many px above the bottom (bottom-right corner)

    // ride x as [ride-progress, x] keyframes. Flat (x===x) spans are gravity wells
    // where the ball dwells on a node; the opening hold is the friction (it resists,
    // then breaks free); the final span eases it to a STOP at the right edge so it
    // rounds smoothly into the fall. ride ∈ [0,1] over p ∈ [LIFT, FALL].
    const KX = [[0, BALL_REST], [0.1, BALL_REST], [0.22, 0.12], [0.29, 0.12], [0.45, 0.46], [0.52, 0.46], [0.7, 0.8], [0.77, 0.8], [1, 0.965]];
    const ballX = (rp: number) => {
      for (let i = 1; i < KX.length; i++) {
        if (rp <= KX[i][0] + 1e-9) {
          const q0 = KX[i - 1][0], x0 = KX[i - 1][1], q1 = KX[i][0], x1 = KX[i][1];
          const t = q1 > q0 ? (rp - q0) / (q1 - q0) : 1;
          return { x: x0 + (x1 - x0) * ease2(t), settled: x0 === x1 };
        }
      }
      return { x: 1, settled: false };
    };

    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
    const coarse = window.matchMedia("(max-width: 55.99rem)");

    let p = -1, active = -2, ticking = false, on = false, warpActive = false, workShown = false, bgScroll = false, glowActive = false, blipsActive = false, glintsActive = false, cradleShown = false, dnDir = true;
    // the "catch & deliver" gate: none → caught (scroll locked) → capturing → done
    let gate = "none", catchT = 0, catchY = 0, capStart = 0, capRAF = 0, twFrom = 0, twTo = 0;
    let io: IntersectionObserver | null = null;
    let scrollBound = false;

    // bridge the live node to its descriptor (read rects only on a beat change, so
    // it's jank-free; discount the +10px entrance offset to land on the settled top).
    const positionLink = (i: number) => {
      const beatEl = beats.children[i] as HTMLElement | undefined;
      if (!link || i < 0 || !nodes[i] || !beatEl) return;
      const ar = nodes[i].getBoundingClientRect();
      const br = beatEl.getBoundingClientRect();
      const sr = stage.getBoundingClientRect();
      const top = ar.bottom - sr.top;
      link.style.left = (ar.left + ar.width / 2 - sr.left).toFixed(1) + "px";
      link.style.top = top.toFixed(1) + "px";
      link.style.height = Math.max(0, br.top - 10 - sr.top - top).toFixed(1) + "px";
    };
    const setBeat = (i: number) => {
      if (i === active) return;
      active = i;
      beats.setAttribute("data-active", String(i));
      if (i >= 0) { positionLink(i); link?.classList.add("on"); }
      else link?.classList.remove("on");
    };

    // ── "catch & deliver" finale ───────────────────────────────────────────────
    const catchPX = () => 0.965 * window.innerWidth;       // the catch point in the
    const catchPY = () => window.innerHeight - DOCK_Y;     // viewport corner (resize-safe)

    // pin the cooled-blue ball (fixed) in the cradle at the catch point
    const placeCaught = () => {
      const px = catchPX(), py = catchPY();
      dot.style.position = "fixed"; dot.style.transition = "none";
      dot.style.left = px.toFixed(1) + "px"; dot.style.top = py.toFixed(1) + "px";
      dot.style.transform = "translate(-50%,-50%) scale(1)"; dot.style.opacity = "1";
      dot.style.setProperty("--bs", "1"); dot.style.setProperty("--cg", "0.45");
      dot.style.setProperty("--cool-p", "0%"); dot.style.setProperty("--tail", "0px");   // stays RED while caught — cools only at capture
      dot.style.setProperty("--chg-o", "0");
      if (cradle) {
        cradle.style.opacity = "1";
        cradle.style.transform = "translate3d(" + px.toFixed(1) + "px," + py.toFixed(1) + "px,0) scale(1)";
        cradle.classList.add("emitting");          // gravity/sonic pulses — catching + holding it
        cradle.style.setProperty("--cradle-lock", "0");
      }
      setArcs("50 50");   // open cup
    };

    // CAPTURE: ring closes around the ball (aperture) + lock flash, capsule transfers
    // out, and the WORK is DELIVERED (a scroll tween glides ARRIVE→WORK_LAND so it
    // rises in). One time clock — a fast scroll can't rush or skip it.
    const captureTick = () => {
      if (gate !== "capturing") return;
      const px = catchPX(), py = catchPY();
      const t = clamp((performance.now() - capStart) / CAP_MS, 0, 1);
      // stages: COOL (red → blue/white) → arcs CLOSE (meet at top-centre) → LOCK flash →
      // SEAL (ball goes SOLID, comet hidden) → held BEAT → TRANSFER out (capsule leaves,
      // work rises). The cool-to-blue lives HERE (the capture opening), not the descent.
      const cool = ease(seg(t, 0, 0.26));                       // red → blue/white, at the very start
      const close = seg(t, 0, 0.45), transfer = seg(t, 0.74, 1);   // seal at close=1 (t≈.45); hold; then transfer
      const lockPulse = Math.sin(seg(t, 0.44, 0.6) * Math.PI);   // a single "locks in" flash
      setArcs((50 + 50 * easeOut(close)).toFixed(1) + " " + (50 - 50 * easeOut(close)).toFixed(1));  // close from L+R, meet at top
      if (cradle) {
        cradle.classList.remove("emitting");   // stop the catching pulses; we're closing now
        cradle.style.opacity = (1 - ease(transfer)).toFixed(3);
        const cs = (1 + 0.08 * lockPulse) * (1 - 0.9 * transfer);   // small lock swell, then shrink away
        cradle.style.transform = "translate3d(" + px.toFixed(1) + "px," + (py + transfer * 30).toFixed(1) + "px,0) scale(" + Math.max(0, cs).toFixed(3) + ")";
        cradle.style.setProperty("--cradle-lock", lockPulse.toFixed(3));
      }
      dot.style.setProperty("--cool-p", (cool * 100).toFixed(1) + "%");   // fade red → blue/white as the arcs close
      // SEAL: once the arcs have met, the ball reads SOLID (the comet/glow inside is gone)
      if (close >= 1 && !dot.classList.contains("sealed")) dot.classList.add("sealed");
      const bs = (1 + 0.08 * lockPulse) * (1 - transfer);
      dot.style.left = px.toFixed(1) + "px"; dot.style.top = py.toFixed(1) + "px";
      dot.style.transform = "translate(-50%,-50%) translateY(" + (transfer * 30).toFixed(1) + "px) scale(" + Math.max(0, bs).toFixed(3) + ")";
      dot.style.opacity = (1 - ease(transfer)).toFixed(3);
      dot.style.setProperty("--cg", ((1 - close) * 0.4 * (1 - transfer)).toFixed(3));   // comet glow fades to nothing by the seal
      window.scrollTo(0, Math.round(twFrom + (twTo - twFrom) * ease(transfer)));   // deliver the work as the capsule leaves
      if (t < 1) { capRAF = requestAnimationFrame(captureTick); }
      else { gate = "done"; dot.style.opacity = "0"; if (cradle) cradle.style.opacity = "0"; }
    };
    const startCapture = () => {
      if (gate !== "caught") return;
      gate = "capturing"; capStart = performance.now();
      dot.classList.remove("caught");
      dot.removeAttribute("role"); dot.removeAttribute("tabindex"); dot.removeAttribute("aria-label");
      twFrom = window.scrollY;
      const r = track.getBoundingClientRect();
      twTo = Math.round(r.top + window.scrollY + (r.height - window.innerHeight));   // p = WORK_LAND
      capRAF = requestAnimationFrame(captureTick);
    };
    const doCatch = (sy: number) => {
      gate = "caught"; catchT = performance.now(); catchY = sy;
      placeCaught();
      dot.classList.add("caught");
      dot.setAttribute("role", "button"); dot.setAttribute("tabindex", "0");
      dot.setAttribute("aria-label", "Open selected work");
      try { dot.focus({ preventScroll: true } as any); } catch {}
    };
    const unCatch = () => {
      if (gate === "none") return;
      gate = "none";
      if (capRAF) { cancelAnimationFrame(capRAF); capRAF = 0; }
      dot.classList.remove("caught"); dot.classList.remove("sealed");
      dot.removeAttribute("role"); dot.removeAttribute("tabindex"); dot.removeAttribute("aria-label");
      dot.style.removeProperty("position"); dot.style.removeProperty("transition");
      dot.style.removeProperty("transform"); dot.style.removeProperty("--cool-p");
      if (cradle) { cradle.style.opacity = "0"; cradle.classList.remove("emitting"); cradle.style.setProperty("--cradle-lock", "0"); cradleShown = false; }
      setArcs("50 50");
    };

    // the scroll-LOCK while caught/capturing. Never a dead wall: a DOWN gesture (after
    // a beat) proceeds → capture; an UP gesture passes → render un-catches; click /
    // Enter / Space proceed. Listeners are non-passive so they can block the scroll.
    const proceedOnDown = () => { if (gate === "caught" && performance.now() - catchT > CATCH_BEAT) startCapture(); };
    const onWheel = (e: WheelEvent) => {
      if (gate === "caught") { if (e.deltaY > 0) { e.preventDefault(); proceedOnDown(); } }
      else if (gate === "capturing") e.preventDefault();
    };
    let touchY = 0;
    const onTouchStart = (e: TouchEvent) => { touchY = e.touches[0] ? e.touches[0].clientY : 0; };
    const onTouchMove = (e: TouchEvent) => {
      if (gate === "capturing") { e.preventDefault(); return; }
      if (gate === "caught") {
        const y = e.touches[0] ? e.touches[0].clientY : 0;
        if (y < touchY) { e.preventDefault(); proceedOnDown(); }   // finger up = scroll down
      }
    };
    const DOWN_KEYS = [" ", "Spacebar", "PageDown", "ArrowDown", "End"];
    const onKey = (e: KeyboardEvent) => {
      if (gate === "caught") {
        if (e.key === "Enter") { e.preventDefault(); startCapture(); return; }
        if (DOWN_KEYS.indexOf(e.key) !== -1) { e.preventDefault(); proceedOnDown(); }
      } else if (gate === "capturing") {
        if (DOWN_KEYS.indexOf(e.key) !== -1 || e.key === "ArrowUp" || e.key === "PageUp" || e.key === "Home") e.preventDefault();
      }
    };
    const onDotClick = () => { if (gate === "caught") startCapture(); };
    let lockBound = false;
    const bindLock = () => {
      if (lockBound) return; lockBound = true;
      window.addEventListener("wheel", onWheel, { passive: false });
      window.addEventListener("touchstart", onTouchStart, { passive: true });
      window.addEventListener("touchmove", onTouchMove, { passive: false });
      window.addEventListener("keydown", onKey);
      dot.addEventListener("click", onDotClick);
    };
    const unbindLock = () => {
      if (!lockBound) return; lockBound = false;
      window.removeEventListener("wheel", onWheel);
      window.removeEventListener("touchstart", onTouchStart);
      window.removeEventListener("touchmove", onTouchMove);
      window.removeEventListener("keydown", onKey);
      dot.removeEventListener("click", onDotClick);
    };

    const render = () => {
      ticking = false;
      if (!on) return;
      const r = track.getBoundingClientRect();
      const span = r.height - window.innerHeight;
      const rawP = span > 0 ? -r.top / span : 0;   // unclamped — lets us detect the rivet exit
      const np = clamp(rawP, 0, 1);
      // the speckle PAPER is viewport-FIXED (still) through the whole pinned about,
      // with NO per-frame writes (so the scroll stays solid). It switches to normal
      // scroll only once we exit the rivet into the work browse — a single, phase-
      // matched toggle, not a per-frame drive.
      const wantScroll = rawP > 1;
      if (wantScroll !== bgScroll) {
        bgScroll = wantScroll;
        document.body.style.backgroundAttachment = wantScroll ? "scroll" : "fixed";
        document.body.style.backgroundPositionY = wantScroll ? (window.scrollY % 800) + "px" : "0px";
      }
      if (Math.abs(np - p) < 0.0001) return;    // fine threshold → smooth on the long track
      p = np;
      const vh = window.innerHeight, vw = window.innerWidth;

      // ── phase progresses (all in scroll space, all fluid) ──
      const le = ease2(seg(p, 0, LIFT));         // name lift-off + wave dock
      const enter = seg(p, ENTER, LIFT);         // ball slides in
      const ride = seg(p, LIFT, FALL);           // ball glides the wave
      const fall = seg(p, FALL, ARRIVE);         // the long comet fall (ends as the work parks)
      const wfade = seg(fall, 0, 0.4);           // the wave clears early in the fall
      const wy = (1 - le) * vh * 0.5 - wfade * vh * 0.7; // wave rises to dock; then drifts up + off
      const wamp = 0.5 + 0.5 * le;

      // ── masthead: slides up the whole lift; fades only once the ball appears ──
      stage.style.setProperty("--name-o", (1 - ease(enter)).toFixed(3));
      stage.style.setProperty("--name-y", (-le * 80).toFixed(2) + "vh");
      stage.style.setProperty("--cue-o", (1 - seg(p, 0, LIFT * 0.6)).toFixed(3));

      // ── wave ──
      stage.style.setProperty("--wy", wy.toFixed(1) + "px");
      stage.style.setProperty("--wamp", wamp.toFixed(3));
      stage.style.setProperty("--wlife", ((0.4 + 0.6 * le) * (1 - wfade)).toFixed(3));
      stage.style.setProperty("--wo", (1 - wfade).toFixed(3));
      stage.style.setProperty("--sig-o", (seg(p, LIFT, LIFT + 0.03) * (1 - seg(fall, 0, 0.08))).toFixed(3));

      // ── the playhead ──
      let bx: number, by: number, bs: number, bop: number, settled = false, chgO = 0, chgS = 1, comet = 0, charge = 0, tail = 0, coolP = 0;
      if (p < LIFT) {
        // ENTRANCE: in from off the left → full view (big), then scale down + nudge
        // slightly right to offset the shrink illusion; settles just inside the edge.
        const slideP = seg(enter, 0, 0.62), scaleP = seg(enter, 0.5, 1), arrive = 0.05;
        bx = -BALL_OFF + (arrive + BALL_OFF) * ease2(slideP) + (BALL_REST - arrive) * ease2(scaleP);
        bs = 1 + 5 * (1 - ease2(scaleP));
        bop = enter > 0 ? 1 : 0;
        by = waveY(Math.max(bx, 0), wy, wamp);
      } else if (p < FALL) {
        // RIDE: friction hold (charge → burst), then a gravity-weighted glide that
        // eases to a stop at the right edge.
        const ds = ballX(ride);
        bx = ds.x;
        settled = ds.settled && ds.x > BALL_REST + 0.01;
        bs = settled ? 1.35 : 1;
        bop = 1;
        by = waveY(bx, wy, wamp);
        const chg = seg(ride, 0, 0.1), burst = seg(ride, 0.1, 0.17);
        chgO = burst > 0 ? 0.85 * (1 - burst) : 0.85 * chg;
        chgS = burst > 0 ? 1 + burst * 4 : 1 + chg * 0.7;
      } else {
        // COMET → CRADLE. Falls STRAIGHT DOWN the right edge, DECELERATING into the
        // bottom-right corner. As it nears the cradle the tail COLLAPSES + the ball
        // settles to size + an electric charge ring vibrates (all scroll-coupled) — but
        // it stays RED/warm. The scroll then CATCHES; the cool-to-blue + SEAL happen only
        // at capture (doCatch / captureTick are the gate).
        const yTop = waveY(0.965, 0, 1);
        const parkY = vh - DOCK_Y;   // the cradle (bottom-right corner)
        const fallPos = fall * fall * (3 - 2 * fall);   // ease-in then OUT — decelerates into the cradle
        const settle = seg(fall, 0.72, 1);   // late fall: COOLS to blue, tail COLLAPSES, ball settles to size
        bx = 0.965;                  // STRAIGHT DOWN, just inside the right edge (fully visible)
        by = yTop + (parkY - yTop) * fallPos;
        bs = (1 + GROWTH * fall) * (1 - 0.5 * settle);   // grows, then settles to ~1 in the cradle
        bop = 1;
        comet = fall;
        tail = comet * vh * 0.46 * (1 - settle);   // tail grows, then COLLAPSES to 0 at the cradle
        // coolP holds at 0 here — the comet stays RED through the descent + catch; the
        // cool-to-blue moved to the capture opening (captureTick).
        charge = seg(fall, 0.55, 1);
        const buzz = Math.sin(fall * 42);          // scroll-coupled oscillation (electrical charge)
        chgO = charge * (0.32 + 0.4 * (0.5 + 0.5 * buzz)) * (1 - settle);  // charge pulses, then fades as it cools
        chgS = 1 + 0.26 * charge * buzz;           // ring tightens / expands — vibrates
      }
      // the dot is scroll-driven EXCEPT once caught/capturing — then the catch &
      // capture functions own it.
      if (gate === "none") {
        dot.style.left = (bx * vw).toFixed(1) + "px";
        dot.style.top = by.toFixed(1) + "px";
        dot.style.setProperty("--bs", bs.toFixed(3));
        dot.style.setProperty("--chg-o", chgO.toFixed(3));
        dot.style.setProperty("--chg-s", chgS.toFixed(3));
        dot.style.setProperty("--cg", comet.toFixed(3));
        dot.style.setProperty("--tail", tail.toFixed(0) + "px");
        dot.style.setProperty("--cool-p", coolP.toFixed(1) + "%");
        dot.style.opacity = bop.toFixed(3);
        dot.classList.toggle("settled", settled);
      }

      // CATCH: reaching the cradle going DOWN locks the scroll (the wheel/touch/key
      // listeners); scroll back up into the descent to un-catch / re-arm.
      if (gate === "none" && dnDir && rawP >= ARRIVE) {
        if (glow) { glow.style.opacity = "0"; glowActive = false; }
        // lock WHERE it caught — no backward snap (that was the awkward scroll gap).
        // The per-frame render catches within a frame or two of crossing ARRIVE, so the
        // overshoot is tiny; cap it only against a pathological one-frame jump.
        const cap = Math.round(r.top + window.scrollY + (ARRIVE + 0.02) * span);
        const cy = Math.min(window.scrollY, cap);
        if (cy < window.scrollY) window.scrollTo(0, cy);
        doCatch(cy);
      } else if ((gate === "caught" || gate === "done") && rawP < ARRIVE - 0.05) {
        unCatch();
      } else if (gate === "caught" && window.scrollY > catchY + 1) {
        window.scrollTo(0, catchY);   // backstop: hold the catch position (scrollbar / momentum slip)
      }

      // the trace is ALWAYS the ball's trail — clip it to the ball's x
      stage.style.setProperty("--q", Math.max(0, bx).toFixed(4));

      // nodes + descriptors engage only during the ride
      if (p >= LIFT && p < FALL) {
        for (let i = 0; i < nodes.length; i++) nodes[i].classList.toggle("lit", bx >= NX[i] - 0.005);
        setBeat(bx >= NX[2] - 0.005 ? 2 : bx >= NX[1] - 0.005 ? 1 : bx >= NX[0] - 0.005 ? 0 : -1);
      } else if (p < LIFT) {
        for (let i = 0; i < nodes.length; i++) nodes[i].classList.remove("lit");
        setBeat(-1);
      }
      if (fall > 0) link?.classList.remove("on");

      // ── hyperspace: the streak layers RUSH upward — transform only, so each is a
      // cached layer the compositor just moves (no per-frame repaint). Each depth
      // travels at its own speed (mod its tile height for a seamless loop). The field
      // holds a fast velocity, then DECELERATES into the arrival — a visible drop out
      // of lightspeed. Fades in over the fall, out as the work lands. ──
      // fade in over the start of the fall; hold LATE (so the deceleration is visible
      // at full brightness — the field coasts to a stop), then dissolve as the dot parks.
      const warpO = seg(p, FALL, FALL + 0.1) * (1 - seg(p, 0.78, 0.9));   // fully cleared by the catch
      if (warpO > 0) {
        if (warp) {
          warp.classList.add("warping");
          warp.style.opacity = (warpO * 0.95).toFixed(3);
          // fast lightspeed, then a LINEAR decel to a stop over the last stretch (C1
          // at the junction, so the velocity eases down with no jump).
          let warpF;
          if (fall < 0.55) warpF = fall * 1.15;
          else { const u = (fall - 0.55) / 0.45; warpF = 0.6325 + 0.5175 * (u - 0.5 * u * u); }
          const travel = warpF * vh * 38;
          for (let i = 0; i < streaks.length; i++) {
            const t = (travel * STREAK_SP[i]) % STREAK_TH[i];
            // decelerate (warpF) + fade (the container opacity) → a clean "drop out of
            // warp." No scaleY shrink (it read as stubby/awkward at the end).
            streaks[i].style.transform = "translate3d(0," + (-t).toFixed(1) + "px,0)";
            // scroll-coupled shimmer — glimmers as you scrub, a composed still when paused
            streaks[i].style.opacity = (STREAK_OP[i] * (0.7 + 0.3 * Math.sin(p * 55 + i * 2.1))).toFixed(3);
          }
        }
        warpActive = true;
      } else if (warpActive) {
        if (warp) { warp.style.opacity = "0"; warp.classList.remove("warping"); }
        warpActive = false;
      }

      // ── the core bloom RIDES the comet (centred on it) — a soft halo travelling
      // down the right edge with the comet, replacing the old fixed screen-centre
      // glow. Transform + opacity only. ──
      // the multi-hue bloom RIDES the comet during the fall (scroll-driven), growing
      // with it; at the park it's handed off to the cooling ember (faded above), so
      // skip it once cooling.
      if (glow && gate === "none") {
        if (comet > 0 && bop > 0) {
          glow.style.transform =
            "translate3d(" + (bx * vw).toFixed(1) + "px," + by.toFixed(1) + "px,0) scale(" + (0.7 + 0.85 * fall).toFixed(3) + ")";
          // grows with the fall, plus a charge pulse near the dock (scroll-coupled)
          glow.style.opacity = (0.5 * (0.5 + 0.5 * fall) * bop + 0.18 * charge * (0.5 + 0.5 * Math.sin(fall * 42))).toFixed(3);
          glowActive = true;
        } else if (glowActive) { glow.style.opacity = "0"; glowActive = false; }
      }

      // ── light BLIPS: a handful of coloured streaks rush up at varied x / size /
      // hue / timing — a spectral flicker through the plunge. Each flashes once as it
      // passes; transform + opacity only. ──
      if (fall > 0 && p < 1) {
        for (let i = 0; i < blips.length; i++) {
          const el = blips[i], d = el.dataset;
          const bt = seg(fall, +(d.t0 || 0), +(d.t1 || 1));
          if (bt > 0 && bt < 1) {
            const yb = vh * (1 - (1 + (+(d.sp || 1)) * 0.5) * bt);  // rush up through the viewport
            el.style.transform = "translate3d(0," + yb.toFixed(1) + "px,0)";
            el.style.opacity = (Math.sin(bt * Math.PI) * (+(d.o || 0.4))).toFixed(3);
          } else if (el.style.opacity !== "0") { el.style.opacity = "0"; }
        }
        blipsActive = true;
      } else if (blipsActive) {
        for (const el of blips) el.style.opacity = "0";
        blipsActive = false;
      }

      // ── tiny GLINTS: a curated scatter of micro-sparkles in the field — they drift
      // up slightly with the motion and TWINKLE (scroll-coupled, brief sparse peaks),
      // like flecks of mica catching light. Texture, not pops; a pause is a frozen
      // shimmer. transform + opacity only. ──
      if (fall > 0 && gate === "none") {
        const gv = seg(p, FALL, FALL + 0.08) * (1 - seg(p, 0.82, 0.95));   // present through the lightspeed
        const drift = (-fall * 26).toFixed(1);
        for (let i = 0; i < glints.length; i++) {
          const el = glints[i];
          // each glint twinkles at its OWN rate + phase (scroll-coupled) → a sparse,
          // irregular catch-the-light scatter; mostly dim, with sharp brief glints.
          const tw = Math.pow(0.5 + 0.5 * Math.sin(p * glintF[i] + glintPh[i]), 4);
          el.style.opacity = (gv * (0.08 + 0.92 * tw)).toFixed(3);
          el.style.transform = "translate(-50%,-50%) translateY(" + drift + "px) scale(" + (0.45 + 0.6 * tw).toFixed(2) + ")";
        }
        glintsActive = true;
      } else if (glintsActive) {
        for (const el of glints) el.style.opacity = "0";
        glintsActive = false;
      }

      // ── the CRADLE fades in EARLY (scroll-coupled) so the landing pad is legible as
      // the comet descends toward it; the catch/capture then take it over. ──
      if (cradle && gate === "none") {
        const cradleO = seg(fall, 0.5, 0.78);
        if (cradleO > 0) {
          cradle.style.opacity = (cradleO * 0.9).toFixed(3);
          cradle.style.transform = "translate3d(" + catchPX().toFixed(1) + "px," + catchPY().toFixed(1) + "px,0) scale(1)";
          setArcs("50 50");
          cradle.classList.add("emitting");   // gravity/sonic pulses as the comet approaches
          cradleShown = true;
        } else if (cradleShown) { cradle.style.opacity = "0"; cradle.classList.remove("emitting"); cradleShown = false; }
      }

      // ── the work LANDS in the groove: it rises (decelerating) over the END of the
      // comet fall, settling AS the comet clears the bottom, then HOLDS in view (the
      // rivet) until the work browse scrolls. The -(1-OFFV)×100svh margin releases
      // it flush (no jump). ──
      if (work) {
        const off = OFFV * vh;
        const naturalTop = r.top + r.height - vh + off;
        if (p >= WORK_RISE) {
          const desired = off + (vh - off) * (1 - easeOut(seg(p, WORK_RISE, WORK_LAND)));
          // land on a WHOLE pixel so the held work is rock-solid (no sub-pixel shimmer)
          work.style.transform = "translateY(" + (Math.round(desired) - naturalTop).toFixed(2) + "px)";
          work.style.willChange = "transform";
          workShown = true;
        } else if (naturalTop < vh) {
          work.style.transform = "translateY(" + (Math.round(vh) - naturalTop).toFixed(2) + "px)";  // hidden below
          workShown = true;
        } else if (workShown) {
          work.style.transform = "";
          work.style.willChange = "";
          workShown = false;
        }
      }
    };
    // track scroll DIRECTION — the cool-off only triggers when we reach the park going
    // DOWN (so scrolling back up doesn't re-fire it). The old settle-on-pause mandate is
    // gone: the cool-off is now a time-based animation, which a fast scroll can't skip.
    let lastY = 0;
    const onScroll = () => {
      if (!ticking) { ticking = true; requestAnimationFrame(render); }
      const y = window.scrollY; dnDir = y >= lastY; lastY = y;
    };

    const startLive = () => {
      als.classList.add("als-live");
      document.body.style.backgroundAttachment = "fixed";   // paper still through the about (no per-frame writes)
      lastY = window.scrollY;
      bindLock();   // the catch/capture scroll-lock listeners (no-op until caught)
      if (work) work.style.marginTop = "-90svh";   // = -(1 - OFFV) × 100svh — releases flush at the offset
      if (!io) {
        io = new IntersectionObserver((recs) => {
          for (const r of recs) {
            on = r.isIntersecting;
            if (on) {
              if (!scrollBound) { window.addEventListener("scroll", onScroll, { passive: true }); scrollBound = true; }
              p = -1; render();
            } else if (scrollBound) {
              window.removeEventListener("scroll", onScroll); scrollBound = false;
            }
          }
        }, { rootMargin: "60% 0px 60% 0px" });
      }
      io.observe(als);
      p = -1; render();
    };
    const stopLive = () => {
      als.classList.remove("als-live");
      io?.disconnect();
      if (scrollBound) { window.removeEventListener("scroll", onScroll); scrollBound = false; }
      on = false;
      // clear the per-frame vars so the static base reads cleanly
      for (const v of ["--name-o", "--name-y", "--cue-o", "--wy", "--wamp", "--wlife", "--wo", "--q", "--sig-o"]) {
        stage.style.removeProperty(v);
      }
      dot.classList.remove("settled"); dot.classList.remove("caught"); dot.classList.remove("sealed");
      dot.removeAttribute("role"); dot.removeAttribute("tabindex"); dot.removeAttribute("aria-label");
      unbindLock(); gate = "none"; if (capRAF) { cancelAnimationFrame(capRAF); capRAF = 0; }
      dot.style.removeProperty("position"); dot.style.removeProperty("transition"); dot.style.removeProperty("transform");
      dot.style.opacity = "0";
      for (const v of ["--bs", "--chg-o", "--chg-s", "--cg", "--tail", "--cool-p"]) dot.style.removeProperty(v);
      link?.classList.remove("on");
      nodes.forEach((n) => n.classList.remove("lit"));
      beats.setAttribute("data-active", "-1");
      active = -2;
      document.body.style.removeProperty("background-position-y");
      document.body.style.removeProperty("background-attachment");
      bgScroll = false;
      warpActive = false; glowActive = false; blipsActive = false; glintsActive = false; cradleShown = false;
      if (warp) warp.style.opacity = "0";
      streaks.forEach((s) => { s.style.removeProperty("transform"); s.style.removeProperty("opacity"); });
      if (glow) { glow.style.opacity = "0"; glow.style.removeProperty("transform"); }
      if (cradle) { cradle.style.opacity = "0"; cradle.style.removeProperty("transform"); cradle.classList.remove("emitting"); cradle.style.removeProperty("--cradle-lock"); }
      cradleArcs.forEach((a) => a.style.removeProperty("stroke-dasharray"));
      blips.forEach((b) => { b.style.opacity = "0"; b.style.removeProperty("transform"); });
      glints.forEach((g) => { g.style.opacity = "0"; g.style.removeProperty("transform"); });
      if (work) { work.style.transform = ""; work.style.willChange = ""; work.style.marginTop = ""; }
      workShown = false;
    };

    const setup = () => {
      if (!reduce.matches && !coarse.matches) startLive();
      else stopLive();
    };
    setup();
    reduce.addEventListener?.("change", setup);
    coarse.addEventListener?.("change", setup);
    window.addEventListener("resize", () => {
      if (on) { p = -1; render(); if (active >= 0) positionLink(active); }
    }, { passive: true });
  })();
</script>
