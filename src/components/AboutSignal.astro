---
/**
 * AboutSignal — the landing + about as ONE continuous, native-scroll sequence
 * (no wheel-jacking). One timeline in scroll progress p, flowing through phases:
 *
 *   LIFT   the masthead slides up and off; the signal wakes (colour + body) and
 *          docks to the top. The ball slides in from off the left, scales down.
 *   RIDE   the ball glides the docked wave with gravity-weighted wells; at each
 *          node a descriptor surfaces beneath it, tied by a connector thread, and
 *          the brand-gradient trace fills behind it.
 *   FALL   the ball rounds the right edge into a long COMET fall — growing,
 *          brightening, a lengthening tail — through a hyperspace streak field.
 *   LAND   the streaks drop out; the work section rises and settles into a groove,
 *          held in view before the work browse scrolls.
 *
 * The un-lit wave is alive on its own (accent-tinted line on a soft aura with
 * resting nodes), so it's compelling before the trace reaches it.
 *
 * Accessibility: the name is a real <h1>; the descriptors are real text (the wave
 * is aria-hidden). The choreography is OPT-IN — JS adds `.als-live` only on a
 * fine-pointer, motion-OK, wide viewport. Without JS, under prefers-reduced-
 * motion, or on touch / narrow screens, the base layout is a calm, complete
 * about (masthead, settled lit wave, stacked descriptors). Fully tokenised; the
 * lit gradient is the one brand pop, theme-robust across the four themes.
 */
import HeroName from "./HeroName.astro";

// ── one smooth signal line (build-time). Three detuned harmonics so it reads as
// sound, not a sine. Full-bleed; non-scaling stroke keeps it crisp at any width.
const VW = 1000, VH = 160, MID = 80, AMP = 56, N = 360;
const harm = (t: number) =>
  Math.sin(t * 9) * 0.55 + Math.sin(t * 22 + 1) * 0.3 + Math.sin(t * 41 + 2) * 0.18;
const lineY = (t: number) => MID - harm(t) * AMP;
let WAVE = "";
for (let i = 0; i <= N; i++) {
  const t = i / N, x = (t * VW).toFixed(1), y = lineY(t).toFixed(2);
  WAVE += (i ? " L" : "M") + x + "," + y;
}

// ── waypoints — one per descriptor, at the x where that descriptor activates.
// The node sits ON the curve; the dot rides to it and it ignites in sync. Must
// match NX in the client script below.
const NX = [0.12, 0.46, 0.8];
const nodes = NX.map((x) => ({
  left: (x * 100).toFixed(3),
  top: ((lineY(x) / VH) * 100).toFixed(3),
}));

// ── the three honest beats. One accent key-phrase each (the brand pop) gives
// each descriptor its own identity, distinct from the masthead's uppercase
// stack. `side` = which waypoint it hangs from (l / c / r) so it sits under its
// node; the connector thread (not a number) ties node → words. Copy is approved.
const BEATS = [
  { side: "l", html: "A designer who <b>builds</b>." },
  { side: "c", html: "Business analyst by title — <b>designer, builder, engineer</b> by practice." },
  { side: "r", html: "Off the clock, bending <b>raw sound</b> into songs." },
];

// ── light "blips": a handful of quick coloured streaks that rush up the screen
// through the plunge — varied x, width, height, hue + timing for a spectral
// flicker. The warm trio is the brand gradient; two cool pops + white add range.
// `t0/t1` = the fall window each rushes through; `sp` = rush speed; `o` = peak.
const BLIPS = [
  { x: 0.14, w: 3,   h: 46, c: "#ffffff", t0: 0.05, t1: 0.50, sp: 1.0,  o: 0.5  },
  { x: 0.30, w: 2,   h: 30, c: "#ff2761", t0: 0.16, t1: 0.40, sp: 1.35, o: 0.42 },
  { x: 0.62, w: 2.4, h: 38, c: "#ffb347", t0: 0.28, t1: 0.56, sp: 1.15, o: 0.40 },
  { x: 0.45, w: 1.6, h: 24, c: "#bfe8ff", t0: 0.40, t1: 0.62, sp: 1.5,  o: 0.36 },
  { x: 0.70, w: 2,   h: 34, c: "#ff5a3c", t0: 0.10, t1: 0.34, sp: 1.25, o: 0.40 },
  { x: 0.22, w: 1.4, h: 20, c: "#c9b8ff", t0: 0.52, t1: 0.74, sp: 1.55, o: 0.34 },
];

// ── tiny "glints": a scattered field of micro-sparkles (flecks of mica/quartz
// catching the light) — NOT firework pops, NOT a uniform texture. A SEEDED PRNG places
// them so the scatter is irregular (random position, size, twinkle rate + phase) yet
// STABLE across builds. The script drifts them with the rushing field + TWINKLES each
// at its OWN rate (scroll-coupled), so a pause is a frozen, glinty shimmer. Tiny
// (≈1–3.4px), pale, low-saturation, widely + sparsely spread. x/y %, `f`/`ph` = rate/phase.
const GLINT_HUES = ["#ffffff", "#cfe6ff", "#ffe9c8", "#e0d4ff", "#ffd9e6", "#d8fff0"];
let gseed = 0x1a2b3c;
const grnd = () => { gseed = (gseed * 1103515245 + 12345) & 0x7fffffff; return gseed / 0x7fffffff; };
const GLINTS = Array.from({ length: 40 }, () => ({
  x: +(grnd() * 100).toFixed(2),                      // spread across the whole field
  y: +(grnd() * 100).toFixed(2),
  s: +(1 + Math.pow(grnd(), 2.3) * 2.4).toFixed(2),   // px core, skewed SMALL (~1–3.4)
  c: GLINT_HUES[Math.floor(grnd() * GLINT_HUES.length)],
  ph: +(grnd() * 6.283).toFixed(2),                   // random twinkle phase
  f: +(52 + grnd() * 74).toFixed(1),                  // random twinkle RATE (per glint)
}));

// ── the PORTAL — a gateway / black-hole the comet drops STRAIGHT INTO at the end of
// the fall. Viewed side-on, so the (circular) mouth foreshortens to a flat ELLIPSE;
// it's centred on the comet's column, so the comet falls straight into the throat with
// no lateral move (the tail stays vertical). Concentric accretion rings + a bright
// event-horizon rim + a dark throat; the script grows it on approach (distant point →
// grand gateway) and fires a cool core-glint as the comet is consumed. Mostly off-screen
// (over half) by design. Drawn in markup (ellipses) — no build-time geometry needed.
---

<section class="als" id="about" aria-label="About Jonathan Tollefson">
  <div class="als-track">
    <div class="als-stage">

      {/* the signal — full-bleed; wakes + docks to the top, lit by scroll */}
      <div class="als-wave" aria-hidden="true">
        <svg class="als-svg" viewBox={`0 0 ${VW} ${VH}`} preserveAspectRatio="none">
          <defs>
            <linearGradient id="alsGrad" x1="0" y1="0" x2={VW} y2="0" gradientUnits="userSpaceOnUse">
              <stop offset="0" stop-color="#ff2761"></stop>
              <stop offset="0.5" stop-color="#ff5a3c"></stop>
              <stop offset="1" stop-color="#ffb347"></stop>
            </linearGradient>
          </defs>
          <path class="als-aura" d={WAVE}></path>
          <path class="als-base" d={WAVE}></path>
          <path class="als-trace" d={WAVE}></path>
        </svg>
        {nodes.map((n, i) => (
          <span class="als-node" data-n={i} style={`left:${n.left}%;top:${n.top}%`}></span>
        ))}
      </div>

      {/* the hyperspace warp — three streak layers (light stretched into streaks)
          that RUSH past during the comet's fall, then drop out as the work lands.
          Each is moved by transform only (composited — no per-frame repaint); three
          depths give parallax. Quick coloured BLIPS flicker up at varied x/size/hue;
          the core bloom RIDES the comet (all positioned by the client script). */}
      <div class="als-warp" aria-hidden="true">
        <i class="als-streak" data-s="0"></i>
        <i class="als-streak" data-s="1"></i>
        <i class="als-streak" data-s="2"></i>
        <i class="als-streak" data-s="3"></i>
        <i class="als-streak" data-s="4"></i>
        {GLINTS.map((g) => (
          <i class="als-glint" aria-hidden="true"
             style={`left:${g.x}%;top:${g.y}%;width:${g.s}px;height:${g.s}px;--gc:${g.c}`}
             data-ph={g.ph} data-f={g.f}></i>
        ))}
      </div>
      {BLIPS.map((b) => (
        <i class="als-blip" aria-hidden="true"
           style={`left:${(b.x * 100).toFixed(2)}%;width:${b.w}px;height:${b.h}vh;--bc:${b.c}`}
           data-t0={b.t0} data-t1={b.t1} data-sp={b.sp} data-o={b.o}></i>
      ))}
      <div class="als-glow" aria-hidden="true"></div>

      {/* the playhead — a STAGE child (not a wave child) so it stays round while
          the wave scales up during the wake; positioned in screen space by JS */}
      <span class="als-dot" aria-hidden="true"></span>

      {/* the ANTENNA — a single straight sapphire rod from the booting device's
          top-right corner up to a receiver BEAD on the comet's column. The comet
          lands on the bead; a CHARGE drains down the rod into the chassis exactly
          as the boot begins (the visible cause); then the rod retracts. A STAGE
          child; every coordinate is written per frame by the client script. */}
      <svg class="als-ant" aria-hidden="true">
        <defs>
          <linearGradient id="alsRod" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="#3a4250"></stop>
            <stop offset="0.5" stop-color="#0ec4fc"></stop>
            <stop offset="1" stop-color="#7a8492"></stop>
          </linearGradient>
        </defs>
        <line class="als-rod"></line>
        <line class="als-rodhi"></line>
        <circle class="als-charge" r="3.2"></circle>
      </svg>
      <i class="als-mount" aria-hidden="true"></i>
      <i class="als-bead" aria-hidden="true"></i>
      <i class="als-flash" aria-hidden="true"></i>

      {/* the masthead — its own moment; lifts away as you scroll */}
      <div class="als-name">
        <div class="inner"><HeroName /></div>
      </div>

      {/* the connector — a thread from the live waypoint down to its descriptor;
          positioned by the client script so it bridges wave → words exactly */}
      <span class="als-link" aria-hidden="true"></span>

      {/* the descriptors — their own clean space below the docked signal */}
      <div class="als-signal">
        <div class="als-beats" data-active="-1">
          {BEATS.map((b, i) => (
            <div class="beat" data-i={i} data-side={b.side} style={`--nx:${nodes[i].left}%`}>
              <p class="beat-line" set:html={b.html}></p>
            </div>
          ))}
        </div>
      </div>

      <p class="als-cue" aria-hidden="true"><span class="als-cue-key">scroll</span><span class="als-cue-line"></span></p>

    </div>
  </div>
</section>

<style>
  /* ═══════════════════════════════════════════════════════════════════════
     BASE = the calm, complete about (no-JS / reduced-motion / touch fallback).
     Everything in normal flow, all visible, the wave settled + lit. The live
     choreography is layered on top under `.als-live`.
     ═══════════════════════════════════════════════════════════════════════ */
  .als { position: relative; }
  /* static flow leads with the name, then the wave, then the descriptors. The
     DOM keeps the wave first (so it paints behind everything when live), so we
     reorder visually here with flex order. */
  .als-stage {
    display: flex; flex-direction: column;
    padding: clamp(2.5rem, 8vh, 5.5rem) 0 clamp(2rem, 6vh, 4rem);
  }
  .als-name { order: 0; }
  .als-wave { order: 1; }
  .als-signal { order: 2; }
  .als-link { display: none; }

  /* the signal line */
  .als-wave {
    position: relative; width: 100%;
    height: clamp(120px, 24vw, 200px);
    margin: clamp(2rem, 6vh, 3.5rem) 0;
  }
  .als-svg { width: 100%; height: 100%; display: block; overflow: visible; }
  .als-aura {
    fill: none; stroke: var(--accent); stroke-width: 11; opacity: 0.16;
    stroke-linecap: round; stroke-linejoin: round;
    filter: blur(7px);
  }
  .als-base {
    fill: none; stroke: color-mix(in srgb, var(--accent) 62%, var(--text));
    stroke-width: 2.4; opacity: 0.78; vector-effect: non-scaling-stroke;
    stroke-linecap: round; stroke-linejoin: round;
  }
  .als-trace {
    fill: none; stroke: url(#alsGrad); stroke-width: 3.4; vector-effect: non-scaling-stroke;
    stroke-linecap: round; stroke-linejoin: round;
    filter: drop-shadow(0 0 7px color-mix(in srgb, var(--accent) 55%, transparent));
    /* settled = fully lit in the base layout; live clips it to the dot */
  }
  .als-node {
    position: absolute; width: 11px; height: 11px; border-radius: 50%;
    transform: translate(-50%, -50%);
    background: var(--bg);
    border: 2px solid var(--accent);
    box-shadow: 0 0 12px 1px color-mix(in srgb, var(--accent) 60%, transparent);
  }
  .als-dot { display: none; }
  .als-warp, .als-glow, .als-blip, .als-glint { display: none; }
  .als-ant, .als-mount, .als-bead, .als-flash { display: none; }

  /* the descriptors — stacked, each with its own identity */
  .als-beats {
    max-width: var(--content-max); margin-inline: auto;
    padding-inline: var(--content-pad);
    display: grid; gap: clamp(1.4rem, 4vh, 2.4rem);
  }
  .beat { position: relative; }
  .beat-line {
    margin: 0; max-width: 40rem;
    font-family: "Space Grotesk Variable", "Space Grotesk", ui-sans-serif, system-ui, sans-serif;
    font-weight: 500; font-size: clamp(1.5rem, 3.6vw, 2.9rem); line-height: 1.12;
    letter-spacing: -0.022em; color: var(--text); text-wrap: balance;
  }
  .beat-line :global(b) { font-weight: 600; color: var(--accent); }

  .als-cue { display: none; }

  /* ═══════════════════════════════════════════════════════════════════════
     LIVE = the staged scroll choreography. Added by JS only on a fine-pointer,
     motion-OK, wide viewport. Vars (--name-o/-y, --wy, --wamp, --wlife, --q,
     --sig-o) are written per frame by the client script.
     ═══════════════════════════════════════════════════════════════════════ */
  /* z-index so the about (and the falling ball) paint ABOVE the work section as it
     rises during the fall; the work shows through the transparent stage. The
     about has no interactive elements, so it's transparent to pointer events —
     otherwise its empty lower track (pulled over the work by the -82svh margin)
     would swallow clicks on the first work rows (e.g. The Lathe). */
  .als-live { z-index: 1; pointer-events: none; }
  .als-live .als-track { height: 880vh; }
  .als-live .als-stage {
    position: sticky; top: 0; height: 100svh; overflow: clip; isolation: isolate;
    padding: 0;
  }

  /* the masthead — vertically centred, left-aligned in the content column
     (matches the approved lockup + the rest of the site); lifts + fades */
  .als-live .als-name {
    position: absolute; inset: 0; display: flex; align-items: center;
    pointer-events: none;
    opacity: var(--name-o, 1); transform: translateY(var(--name-y, 0));
  }
  .als-live .als-name > .inner { width: 100%; }

  /* the wave — docks near the top; rises + wakes from a low sleeping line */
  .als-live .als-wave {
    position: absolute; left: 0; right: 0; top: 8svh; margin: 0;
    height: clamp(150px, 23vh, 230px);
    transform-origin: 50% 50%;
    transform: translateY(var(--wy, 0)) scaleY(var(--wamp, 1));
    opacity: var(--wo, 1);
  }
  /* the resting wave is alive — present (not faint) and gently breathing — then
     the trace lights it as the dot rides */
  .als-live .als-aura {
    opacity: calc(0.1 + 0.18 * var(--wlife, 1));
    transform-box: fill-box; transform-origin: center;
    animation: als-breathe 4.6s ease-in-out infinite;
  }
  .als-live .als-base { opacity: calc(0.3 + 0.5 * var(--wlife, 1)); }
  .als-live .als-trace { clip-path: inset(0 calc((1 - var(--q, 0)) * 100%) 0 0); }
  @keyframes als-breathe { 0%, 100% { transform: scaleY(0.88); } 50% { transform: scaleY(1.14); } }

  .als-live .als-node {
    opacity: calc(0.3 + 0.4 * var(--wlife, 0));
    box-shadow: none;
    transition: opacity 0.4s ease, background 0.45s ease, box-shadow 0.45s ease, border-color 0.45s ease;
  }
  /* the node 'catches' the dot as it arrives — a small gravity thunk */
  .als-live .als-node.lit {
    opacity: 1; background: var(--accent); border-color: var(--accent);
    box-shadow: 0 0 16px 2px color-mix(in srgb, var(--accent) 65%, transparent);
    animation: als-node-catch 0.6s cubic-bezier(0.2, 0, 0, 1);
  }
  @keyframes als-node-catch {
    0% { transform: translate(-50%, -50%) scale(1); }
    40% { transform: translate(-50%, -50%) scale(2.1); }
    100% { transform: translate(-50%, -50%) scale(1); }
  }

  .als-live .als-dot {
    display: block; position: absolute; left: 0; top: 0; z-index: 3;
    width: 15px; height: 15px; border-radius: 50%;
    background: radial-gradient(circle at 50% 38%,
      #fff 0%, var(--accent) 55%, color-mix(in srgb, var(--accent) 55%, #000) 100%);
    box-shadow: 0 0 calc(20px + var(--cg, 0) * 60px) calc(5px + var(--cg, 0) * 16px)
      color-mix(in srgb, var(--accent) 60%, transparent);
    transform: translate(-50%, -50%) scale(var(--bs, 1)); opacity: 0;
    transition: transform 0.16s ease-out, box-shadow 0.2s ease;
    will-change: left, top, transform;
  }
  /* the comet tail — a streak trailing UP behind the ball as it falls; the script
     grows its length (--tail) through the fall. Scales with the ball (--bs). */
  .als-live .als-dot::after {
    content: ""; position: absolute; left: 50%; bottom: 50%;
    width: 9px; height: var(--tail, 0px); transform: translateX(-50%);
    background: linear-gradient(to top, var(--accent), transparent);
    border-radius: 6px; filter: blur(2.5px); pointer-events: none;
  }
  /* settling into a gravity well — extra glow (the swell itself is the --bs scale) */
  .als-live .als-dot.settled {
    box-shadow: 0 0 30px 8px color-mix(in srgb, var(--accent) 70%, transparent);
  }
  /* the charge ring — builds while the ball is held by friction, then bursts
     outward + evaporates as it breaks free (opacity/scale driven by JS). */
  .als-live .als-dot::before {
    content: ""; position: absolute; inset: -3px; border-radius: 50%;
    border: 2px solid var(--accent); pointer-events: none;
    opacity: var(--chg-o, 0); transform: scale(var(--chg-s, 1));
  }

  /* the ANTENNA — a single sapphire rod (device corner → receiver bead on the
     comet column), drawn + positioned per frame by the client script. z-index 3
     = level with the comet, above the warp (z2). Sapphire #0ec4fc is the device's
     resting hardware glow; it never couples to a project accent. The rod retracts
     once it has drained the charge into the chassis (--ant-o → 0). */
  .als-live .als-ant {
    display: block; position: absolute; inset: 0; z-index: 3; pointer-events: none;
    overflow: visible; opacity: var(--ant-o, 0);
  }
  .als-live .als-rod { stroke: url(#alsRod); stroke-width: 4; stroke-linecap: round; }
  .als-live .als-rodhi { stroke: #e7eef6; stroke-width: 1; stroke-linecap: round; opacity: 0.5; }
  .als-live .als-charge { fill: #fff; filter: drop-shadow(0 0 6px #0ec4fc); }
  .als-live .als-mount {
    display: block; position: absolute; left: 0; top: 0; z-index: 3;
    width: 12px; height: 12px; border-radius: 3px; pointer-events: none;
    transform: translate(-50%, -50%); opacity: 0;
    background: linear-gradient(180deg, #39414d, #11151c);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.12), 0 1px 2px rgba(0, 0, 0, 0.6);
  }
  .als-live .als-mount.lit {
    box-shadow: 0 0 calc(6px + var(--mount-hot, 0) * 20px) #0ec4fc, inset 0 1px 0 rgba(255, 255, 255, 0.22);
  }
  .als-live .als-bead {
    display: block; position: absolute; left: 0; top: 0; z-index: 3;
    width: 13px; height: 13px; border-radius: 50%; pointer-events: none;
    transform: translate(-50%, -50%) scale(var(--bead-s, 1)); opacity: 0;
    background: radial-gradient(circle at 50% 38%, #fff, #0ec4fc 56%, color-mix(in srgb, #0ec4fc 45%, #000));
    box-shadow: 0 0 calc(5px + var(--hot, 0) * 26px) #0ec4fc;
  }
  /* the impact FLASH — a quick bright burst the moment the comet hits the bead
     (scrubbable: it's a pure function of p, peaking at ARRIVE, NOT a time animation). */
  .als-live .als-flash {
    display: block; position: absolute; left: 0; top: 0; z-index: 4; pointer-events: none;
    width: 26px; height: 26px; border-radius: 50%;
    transform: translate(-50%, -50%) scale(var(--flash-s, 0.4)); opacity: var(--flash-o, 0);
    background: radial-gradient(circle at 50% 50%, #fff 0%, #fff 24%, #0ec4fc 50%, transparent 72%);
  }
  /* the hyperspace warp — a stack of streak layers. Each is the speckle texture
     stretched tall (background-size) into vertical light streaks, MOVED BY
     TRANSFORM ONLY (the script translates each at its own speed, modulo its tile
     height for a seamless loop). Because only the transform changes, each layer is
     painted once + composited — NO per-frame repaint. (The old drive animated
     background-position on a full-screen, scaleY-stretched, filtered, 4×-tiled
     element every frame, repainting + re-running the filter each tick — that's
     what made the lightspeed feel laggy.) The brightening filter is baked into the
     one-time paint, so it costs nothing to animate. */
  .als-live .als-warp {
    display: block; position: absolute; inset: 0; z-index: 2; pointer-events: none;
    opacity: 0; overflow: clip; will-change: opacity;
  }
  .als-live .als-streak {
    position: absolute; left: 0; right: 0; top: 0;
    background-repeat: repeat; will-change: transform, opacity;
  }
  /* FINITE vertical light-streaks across a spread of HUES — a glimmery, dreamy field.
     Each layer is a colour + a white-hot core, moved by transform (composited) and
     OPACITY-twinkled at its own irregular rate (randomised intensity). Five depths /
     speeds; tile heights match the script's STREAK_TH modulo for a seamless loop. */
  .als-live .als-streak[data-s="0"] {     /* near — white */
    height: calc(100% + 290px); background-size: 60px 290px, 60px 290px;
    background-image:
      radial-gradient(1.5px 80px at 50% 45%, #fff, transparent 72%),
      radial-gradient(1.0px 56px at 50% 50%, color-mix(in srgb, #fff 70%, transparent), transparent 74%);
    background-position: 0 0, 31px 150px;
    --tw-dur: 1.5s; --tw-del: 0s; --tw-lo: 0.45; --tw-hi: 1;
  }
  .als-live .als-streak[data-s="1"] {     /* amber */
    height: calc(100% + 420px); background-size: 92px 420px, 92px 420px;
    background-image:
      radial-gradient(1.8px 110px at 50% 50%, #ffd9a0, transparent 70%),
      radial-gradient(1.2px 80px at 50% 50%, #ffb347, transparent 72%);
    background-position: 0 0, 48px 210px;
    --tw-dur: 2.3s; --tw-del: -0.6s; --tw-lo: 0.28; --tw-hi: 0.82;
  }
  .als-live .als-streak[data-s="2"] {     /* cyan */
    height: calc(100% + 560px); background-size: 130px 560px, 130px 560px;
    background-image:
      radial-gradient(1.7px 130px at 50% 50%, #e6f6ff, transparent 70%),
      radial-gradient(1.1px 96px at 50% 50%, #bfe8ff, transparent 72%);
    background-position: 0 0, 66px 280px;
    --tw-dur: 1.9s; --tw-del: -1.1s; --tw-lo: 0.22; --tw-hi: 0.72;
  }
  .als-live .als-streak[data-s="3"] {     /* pink */
    height: calc(100% + 700px); background-size: 170px 700px, 170px 700px;
    background-image:
      radial-gradient(2.2px 150px at 50% 50%, #ffd0dd, transparent 68%),
      radial-gradient(1.4px 110px at 50% 50%, #ff5a7e, transparent 70%);
    background-position: 0 0, 88px 350px;
    --tw-dur: 2.7s; --tw-del: -0.3s; --tw-lo: 0.18; --tw-hi: 0.62;
  }
  .als-live .als-streak[data-s="4"] {     /* violet — far */
    height: calc(100% + 860px); background-size: 220px 860px, 220px 860px;
    background-image:
      radial-gradient(2.6px 180px at 50% 50%, #e7deff, transparent 68%),
      radial-gradient(1.6px 130px at 50% 50%, #c9b8ff, transparent 70%);
    background-position: 0 0, 112px 430px;
    --tw-dur: 3.2s; --tw-del: -1.6s; --tw-lo: 0.15; --tw-hi: 0.52;
  }

  /* tiny GLINTS — micro-sparkles (like mica flecks catching light). The script
     drifts them with the field + TWINKLES them (scroll-coupled). Tiny + a tight
     glow; texture, not pops. Colour/size per element. */
  .als-live .als-glint {
    display: block; position: absolute; border-radius: 50%; pointer-events: none;
    transform: translate(-50%, -50%) scale(0); opacity: 0; will-change: transform, opacity;
    /* the glow is in the gradient (a tiny bright core + soft falloff) — NO box-shadow,
       which is a blur the compositor would re-run for all ~30 glints every frame. */
    background: radial-gradient(circle at 50% 50%, #fff 0%, #fff 14%, var(--gc) 38%, transparent 70%);
  }

  /* the core bloom — a multi-hue ENERGY halo that RIDES THE COMET (the script
     translates it to the comet's position + scales it with the fall). Orange / pink /
     blue layers join in as the comet grows. Transform + opacity only. */
  .als-live .als-glow {
    display: block; position: absolute; left: 0; top: 0; z-index: 2; pointer-events: none; opacity: 0;
    width: 66vmin; height: 66vmin; margin: -33vmin 0 0 -33vmin;
    background:
      radial-gradient(circle at 50% 50%, rgba(255, 150, 70, 0.26), transparent 52%),
      radial-gradient(circle at 50% 50%, rgba(255, 90, 160, 0.20), transparent 62%),
      radial-gradient(circle at 50% 50%, rgba(90, 165, 255, 0.17), transparent 72%);
    will-change: transform, opacity;
  }

  /* quick coloured light-blips that rush up during the plunge — varied x, size +
     hue (set per element), each flashing once. transform + opacity only. */
  .als-live .als-blip {
    display: block; position: absolute; top: 0; z-index: 2; pointer-events: none;
    border-radius: 3px; opacity: 0;
    background: linear-gradient(to top, transparent, var(--bc) 38%, #fff 60%, var(--bc) 80%, transparent);
    filter: blur(1.2px); will-change: transform, opacity;
  }

  /* the descriptor zone — its own clean space below the docked signal */
  .als-live .als-signal {
    position: absolute; left: 0; right: 0; top: 30svh; bottom: 6svh;
    opacity: var(--sig-o, 0);
  }
  .als-live .als-beats {
    position: absolute; inset: 0; max-width: none; margin: 0; padding: 0; display: block;
  }
  /* each descriptor is vertically centred in the clean space and anchored
     horizontally under its waypoint node (--nx); only one shows at a time */
  .als-live .beat {
    position: absolute; top: 50%; max-width: min(40rem, 62vw);
    opacity: 0; transition: opacity 0.6s ease, transform 0.6s cubic-bezier(0.2, 0, 0, 1);
  }
  .als-live .beat[data-side="l"] { left: var(--nx); text-align: left; transform: translate(0, calc(-50% + 10px)); }
  .als-live .beat[data-side="c"] { left: var(--nx); text-align: center; transform: translate(-50%, calc(-50% + 10px)); }
  .als-live .beat[data-side="c"] .beat-line { margin-inline: auto; }
  .als-live .beat[data-side="r"] { right: calc(100% - var(--nx)); left: auto; text-align: right; transform: translate(0, calc(-50% + 10px)); }
  .als-live .beat[data-side="r"] .beat-line { margin-left: auto; }

  /* the live descriptor surfaces */
  .als-live .als-beats[data-active="0"] .beat[data-i="0"],
  .als-live .als-beats[data-active="2"] .beat[data-i="2"] { opacity: 1; transform: translate(0, -50%); }
  .als-live .als-beats[data-active="1"] .beat[data-i="1"] { opacity: 1; transform: translate(-50%, -50%); }

  /* the connector thread — JS positions it from the live node down to the
     descriptor, so wave and words read as one intentional waypoint */
  .als-live .als-link {
    display: block; position: absolute; width: 1.5px; transform: translateX(-50%); z-index: 1;
    background: linear-gradient(to bottom, var(--accent), color-mix(in srgb, var(--accent) 22%, transparent));
    opacity: 0; transition: opacity 0.6s ease; pointer-events: none;
  }
  .als-live .als-link.on { opacity: 0.5; }

  /* the scroll cue — invites exploration during the name act, fades as it lifts */
  .als-live .als-cue {
    display: flex; flex-direction: column; align-items: center; gap: 0.55rem;
    position: absolute; left: 50%; bottom: clamp(1.5rem, 4vh, 2.75rem);
    transform: translateX(-50%); margin: 0;
    opacity: calc(var(--cue-o, 1) * 0.9);
  }
  .als-live .als-cue-key {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.62rem; letter-spacing: 0.28em; text-transform: uppercase; color: var(--muted);
  }
  .als-live .als-cue-line {
    width: 1.5px; height: clamp(1.6rem, 4vh, 2.6rem);
    background: linear-gradient(to bottom, var(--accent), transparent);
    animation: als-cue-fall 1.9s ease-in-out infinite;
  }
  @keyframes als-cue-fall {
    0%, 100% { transform: scaleY(0.6); transform-origin: top; opacity: 0.5; }
    50% { transform: scaleY(1); transform-origin: top; opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .beat { transition: none; }
    .als-cue-line, .als-aura, .als-node.lit { animation: none; }
    .als-dot { transition: none; }
  }
</style>

<script>
  /* The staged about. Native scroll → a 0→1 progress `--p`, split into three
     acts. The dot rides the line's exact curve; the gradient trace fills to the
     dot; the waypoint nodes ignite in sync with the descriptors. The name lifts
     away first. Touch / reduced-motion / narrow get the calm static base. */
  (() => {
    const als = document.querySelector<HTMLElement>(".als");
    if (!als) return;
    const track = als.querySelector<HTMLElement>(".als-track");
    const stage = als.querySelector<HTMLElement>(".als-stage");
    const dot = als.querySelector<HTMLElement>(".als-dot");
    const beats = als.querySelector<HTMLElement>(".als-beats");
    const link = als.querySelector<HTMLElement>(".als-link");
    const nodes = Array.from(als.querySelectorAll<HTMLElement>(".als-node"));
    const work = document.querySelector<HTMLElement>(".work");
    const warp = als.querySelector<HTMLElement>(".als-warp");
    const glow = als.querySelector<HTMLElement>(".als-glow");
    const streaks = Array.from(als.querySelectorAll<HTMLElement>(".als-streak"));
    const blips = Array.from(als.querySelectorAll<HTMLElement>(".als-blip"));
    const glints = Array.from(als.querySelectorAll<HTMLElement>(".als-glint"));
    // the antenna catcher (a child of the sticky stage) + the device it mounts to
    const ant = als.querySelector<SVGSVGElement>(".als-ant");
    const rod = als.querySelector<SVGLineElement>(".als-rod");
    const rodhi = als.querySelector<SVGLineElement>(".als-rodhi");
    const chargeEl = als.querySelector<SVGCircleElement>(".als-charge");
    const mount = als.querySelector<HTMLElement>(".als-mount");
    const bead = als.querySelector<HTMLElement>(".als-bead");
    const flash = als.querySelector<HTMLElement>(".als-flash");
    const deck = work?.querySelector<HTMLElement>(".deck") ?? null;
    // cache each glint's twinkle phase + rate once (avoid a per-frame dataset parse ×N)
    const glintPh = glints.map((el) => +(el.dataset.ph || 0));
    const glintF = glints.map((el) => +(el.dataset.f || 80));
    if (!track || !stage || !dot || !beats) return;

    // ── the wave's curve (matches the build-time path), for the ball to ride ──
    const harm = (t: number) =>
      Math.sin(t * 9) * 0.55 + Math.sin(t * 22 + 1) * 0.3 + Math.sin(t * 41 + 2) * 0.18;
    const VH = 160, MID = 80, AMP = 56;
    const lineY = (t: number) => MID - harm(t) * AMP;
    const NX = [0.12, 0.46, 0.8];
    // the wave's point at parameter t in SCREEN space, given its live offset (wy) +
    // amplitude (wamp). Mirrors the CSS (.als-wave: top 8svh, height clamp(150,23vh,
    // 230), translateY(wy) scaleY(wamp) about centre). The ball is a stage child, so
    // it sits on the curve without inheriting the wave's scale (stays round).
    const waveH = () => Math.min(230, Math.max(150, 0.23 * window.innerHeight));
    const waveY = (t: number, wy: number, wamp: number) => {
      const vh = window.innerHeight, H = waveH();
      return 0.08 * vh + wy + H / 2 + (lineY(t) / VH - 0.5) * H * wamp;
    };

    // ── easing ──
    const clamp = (v: number, a: number, b: number) => Math.min(b, Math.max(a, v));
    const seg = (v: number, a: number, b: number) => clamp((v - a) / (b - a), 0, 1); // sub-progress
    const ease = (t: number) => t * t * (3 - 2 * t);                 // smoothstep
    const ease2 = (t: number) => 0.6 * ease(t) + 0.4 * t;            // softened — uniform, fluid
    const easeOut = (t: number) => 1 - (1 - t) * (1 - t);            // decelerate (into the groove)
    // the device's rise is BACK-LOADED: it stays low through the comet's fall (so the
    // comet rides the full right column down + the antenna can reach up to catch it),
    // then sweeps up into its resting frame as it boots.
    const riseE = (t: number) => t * t;

    // ── the ONE timeline, in scroll progress p over the track. Each phase flows
    // into the next; the comet fall is the long, dominant stretch. ──
    const ENTER = 0.09;     // the ball starts sliding in from off the left
    const LIFT = 0.15;      // by here: name fully off-screen + wave docked + ball settled
    const FALL = 0.42;      // the ride ends, the ball begins its (long) comet fall
    const ARRIVE = 0.88;    // the comet reaches the (rising, dark) device + is absorbed; the BOOT begins
    const WORK_RISE = 0.78; // the device starts rising (dark, powered-off) BEFORE the comet arrives,
                            // so it's risen into place to receive the signal
    const WORK_LAND = 0.96; // the device finishes booting + the catalog is framed/live
    const OFFV = 0.12;      // the work rests this far (× viewport) below the top — frames "Selected
                            // work" in the upper third (with headroom below the nav), the whole
                            // catalog composing in one arrival frame
    const BALL_OFF = 0.1;   // the ball's start x, fully off the left edge
    const BALL_REST = 0.06; // its resting x — fully visible, just inside the edge
    const FALL_COLX = 0.965; // the far-right column the comet falls down + the antenna bead sits on
    // warp streak depths: speed (× fall travel) + tile height (px) for the seamless
    // modulo loop. MUST match the .als-streak background-size heights in the CSS.
    const STREAK_SP = [1, 0.78, 0.6, 0.46, 0.34];
    const STREAK_TH = [290, 420, 560, 700, 860];
    const STREAK_OP = [0.95, 0.8, 0.72, 0.62, 0.52];  // per-layer base brightness (near→far); JS shimmers it by scroll
    const GROWTH = 1.0;     // the comet's size growth over the fall (1 → 1+GROWTH at the park) — more dramatic

    // ride x as [ride-progress, x] keyframes. Flat (x===x) spans are gravity wells
    // where the ball dwells on a node; the opening hold is the friction (it resists,
    // then breaks free); the final span eases it to a STOP at the right edge so it
    // rounds smoothly into the fall. ride ∈ [0,1] over p ∈ [LIFT, FALL].
    const KX = [[0, BALL_REST], [0.1, BALL_REST], [0.22, 0.12], [0.29, 0.12], [0.45, 0.46], [0.52, 0.46], [0.7, 0.8], [0.77, 0.8], [1, 0.965]];
    const ballX = (rp: number) => {
      for (let i = 1; i < KX.length; i++) {
        if (rp <= KX[i][0] + 1e-9) {
          const q0 = KX[i - 1][0], x0 = KX[i - 1][1], q1 = KX[i][0], x1 = KX[i][1];
          const t = q1 > q0 ? (rp - q0) / (q1 - q0) : 1;
          return { x: x0 + (x1 - x0) * ease2(t), settled: x0 === x1 };
        }
      }
      return { x: 1, settled: false };
    };

    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
    const coarse = window.matchMedia("(max-width: 55.99rem)");

    let p = -1, active = -2, ticking = false, on = false, warpActive = false, workShown = false, bgScroll = false, glowActive = false, blipsActive = false, glintsActive = false, booted = -1, antActive = false, deckTopOff = -1;
    let io: IntersectionObserver | null = null;
    let scrollBound = false;

    // bridge the live node to its descriptor (read rects only on a beat change, so
    // it's jank-free; discount the +10px entrance offset to land on the settled top).
    const positionLink = (i: number) => {
      const beatEl = beats.children[i] as HTMLElement | undefined;
      if (!link || i < 0 || !nodes[i] || !beatEl) return;
      const ar = nodes[i].getBoundingClientRect();
      const br = beatEl.getBoundingClientRect();
      const sr = stage.getBoundingClientRect();
      const top = ar.bottom - sr.top;
      link.style.left = (ar.left + ar.width / 2 - sr.left).toFixed(1) + "px";
      link.style.top = top.toFixed(1) + "px";
      link.style.height = Math.max(0, br.top - 10 - sr.top - top).toFixed(1) + "px";
    };
    const setBeat = (i: number) => {
      if (i === active) return;
      active = i;
      beats.setAttribute("data-active", String(i));
      if (i >= 0) { positionLink(i); link?.classList.add("on"); }
      else link?.classList.remove("on");
    };

    // where the comet lands — straight down the right edge, near the bottom, where the
    // rising device meets it. Resize-safe (recomputed each frame). Screen px.
    const dockY = () => window.innerHeight - Math.min(64, window.innerHeight * 0.085);

    const render = () => {
      ticking = false;
      if (!on) return;
      const r = track.getBoundingClientRect();
      const span = r.height - window.innerHeight;
      const rawP = span > 0 ? -r.top / span : 0;   // unclamped — lets us detect the rivet exit
      const np = clamp(rawP, 0, 1);
      // the speckle PAPER is viewport-FIXED (still) through the whole pinned about,
      // with NO per-frame writes (so the scroll stays solid). It switches to normal
      // scroll only once we exit the rivet into the work browse — a single, phase-
      // matched toggle, not a per-frame drive.
      const wantScroll = rawP > 1;
      if (wantScroll !== bgScroll) {
        bgScroll = wantScroll;
        document.body.style.backgroundAttachment = wantScroll ? "scroll" : "fixed";
        document.body.style.backgroundPositionY = wantScroll ? (window.scrollY % 800) + "px" : "0px";
      }
      if (Math.abs(np - p) < 0.0001) return;    // fine threshold → smooth on the long track
      p = np;
      const vh = window.innerHeight, vw = window.innerWidth;
      // cache the deck's top offset within .work ONCE (transform-independent: deck
      // and work move together, so their delta is the pure layout offset). Used to
      // derive where the receiver bead rests above the rising device.
      if (deck && work && deckTopOff < 0) {
        deckTopOff = deck.getBoundingClientRect().top - work.getBoundingClientRect().top;
      }

      // ── phase progresses (all in scroll space, all fluid) ──
      const le = ease2(seg(p, 0, LIFT));         // name lift-off + wave dock
      const enter = seg(p, ENTER, LIFT);         // ball slides in
      const ride = seg(p, LIFT, FALL);           // ball glides the wave
      const fall = seg(p, FALL, ARRIVE);         // the long comet fall (ends as the work parks)
      const wfade = seg(fall, 0, 0.4);           // the wave clears early in the fall
      const wy = (1 - le) * vh * 0.5 - wfade * vh * 0.7; // wave rises to dock; then drifts up + off
      const wamp = 0.5 + 0.5 * le;

      // ── masthead: slides up the whole lift; fades only once the ball appears ──
      stage.style.setProperty("--name-o", (1 - ease(enter)).toFixed(3));
      stage.style.setProperty("--name-y", (-le * 80).toFixed(2) + "vh");
      stage.style.setProperty("--cue-o", (1 - seg(p, 0, LIFT * 0.6)).toFixed(3));

      // ── wave ──
      stage.style.setProperty("--wy", wy.toFixed(1) + "px");
      stage.style.setProperty("--wamp", wamp.toFixed(3));
      stage.style.setProperty("--wlife", ((0.4 + 0.6 * le) * (1 - wfade)).toFixed(3));
      stage.style.setProperty("--wo", (1 - wfade).toFixed(3));
      stage.style.setProperty("--sig-o", (seg(p, LIFT, LIFT + 0.03) * (1 - seg(fall, 0, 0.08))).toFixed(3));

      // ── the playhead ──
      let bx: number, by: number, bs: number, bop: number, settled = false, chgO = 0, chgS = 1, comet = 0, charge = 0, tail = 0;
      if (p < LIFT) {
        // ENTRANCE: a rightward TRANSLATION at constant size — the signal slides in
        // from off the left and settles just inside the edge, flowing seamlessly into
        // the ride (bx at LIFT == ballX(0) == BALL_REST, so there's no seam). No more
        // big-then-shrink: scroll always maps to position, never scale.
        const enterP = seg(enter, 0, 1);
        bx = -BALL_OFF + (BALL_OFF + BALL_REST) * ease2(enterP);
        bs = 1;
        bop = ease(seg(enter, 0, 0.45));   // fades up as it slides into view
        by = waveY(Math.max(bx, 0), wy, wamp);
      } else if (p < FALL) {
        // RIDE: friction hold (charge → burst), then a gravity-weighted glide that
        // eases to a stop at the right edge.
        const ds = ballX(ride);
        bx = ds.x;
        settled = ds.settled && ds.x > BALL_REST + 0.01;
        bs = settled ? 1.35 : 1;
        bop = 1;
        by = waveY(bx, wy, wamp);
        const chg = seg(ride, 0, 0.1), burst = seg(ride, 0.1, 0.17);
        chgO = burst > 0 ? 0.85 * (1 - burst) : 0.85 * chg;
        chgS = burst > 0 ? 1 + burst * 4 : 1 + chg * 0.7;
      } else {
        // COMET → DEVICE. Falls STRAIGHT DOWN the right edge, DECELERATING to a near-hover
        // just above the device, then SHOOTS in fast — the signal fired into the machine. It's
        // gone inside before the device wakes (the boot starts a beat later). Scrubbable.
        const yTop = waveY(FALL_COLX, 0, 1);
        // the comet's rest is the antenna BEAD above the (rising) device — not a fixed
        // bottom dock. parkY = the bead's position AT the catch (a stable target, from
        // constants, so the long fall is smooth); beadYLive = the bead's CURRENT y (the
        // device is still rising), which the final dart lands on exactly.
        const off = OFFV * vh;
        const LIFT_PX = Math.min(0.16 * vh, 120);
        const haveDeck = !!deck && deckTopOff >= 0;
        const catchCornerY = off + (vh - off) * (1 - riseE(seg(ARRIVE, WORK_RISE, WORK_LAND))) + deckTopOff;
        const liveWorkTop = p >= WORK_RISE ? off + (vh - off) * (1 - riseE(seg(p, WORK_RISE, WORK_LAND))) : vh;
        const parkY = haveDeck ? catchCornerY - LIFT_PX : dockY();
        const beadYLive = haveDeck ? liveWorkTop + deckTopOff - LIFT_PX : parkY;
        const hoverY = parkY - Math.min(70, vh * 0.09);    // decelerates to here, then darts onto the bead
        const approach = easeOut(seg(fall, 0, 0.9));       // decelerate to the hover (anticipation)
        const shootE = Math.pow(seg(fall, 0.9, 1), 3);     // then ACCELERATE the final dart onto the bead
        const settle = seg(fall, 0.72, 0.9);   // tail collapses + ball settles BEFORE the dart
        bx = FALL_COLX;              // STRAIGHT DOWN, no lateral move — the tail stays vertical
        by = yTop + (hoverY - yTop) * approach + (beadYLive - hoverY) * shootE;
        bs = (1 + GROWTH * Math.min(fall, 0.9)) * (1 - 0.62 * settle);   // grows, settles, holds into the dart
        bop = 1 - ease(seg(fall, 0.965, 1));   // VISIBLE shooting in, then gone inside the device
        comet = Math.min(fall, 0.9);
        tail = comet * vh * 0.46 * (1 - settle) + shootE * vh * 0.34;   // streaks LONG as it darts in
        charge = seg(fall, 0.55, 0.9);
        const buzz = Math.sin(fall * 42);          // scroll-coupled oscillation (electrical charge)
        chgO = charge * (0.32 + 0.4 * (0.5 + 0.5 * buzz)) * (1 - settle);  // charge pulses, then fades
        chgS = 1 + 0.26 * charge * buzz;           // ring tightens / expands — vibrates
      }
      // the dot is fully scroll-driven now — nothing catches or captures it.
      dot.style.left = (bx * vw).toFixed(1) + "px";
      dot.style.top = by.toFixed(1) + "px";
      dot.style.setProperty("--bs", bs.toFixed(3));
      dot.style.setProperty("--chg-o", chgO.toFixed(3));
      dot.style.setProperty("--chg-s", chgS.toFixed(3));
      dot.style.setProperty("--cg", comet.toFixed(3));
      dot.style.setProperty("--tail", tail.toFixed(0) + "px");
      dot.style.opacity = bop.toFixed(3);
      dot.classList.toggle("settled", settled);

      // the trace is ALWAYS the ball's trail — clip it to the ball's x
      stage.style.setProperty("--q", Math.max(0, bx).toFixed(4));

      // nodes + descriptors engage only during the ride
      if (p >= LIFT && p < FALL) {
        for (let i = 0; i < nodes.length; i++) nodes[i].classList.toggle("lit", bx >= NX[i] - 0.005);
        setBeat(bx >= NX[2] - 0.005 ? 2 : bx >= NX[1] - 0.005 ? 1 : bx >= NX[0] - 0.005 ? 0 : -1);
      } else if (p < LIFT) {
        for (let i = 0; i < nodes.length; i++) nodes[i].classList.remove("lit");
        setBeat(-1);
      }
      if (fall > 0) link?.classList.remove("on");

      // ── hyperspace: the streak layers RUSH upward — transform only, so each is a
      // cached layer the compositor just moves (no per-frame repaint). Each depth
      // travels at its own speed (mod its tile height for a seamless loop). The field
      // holds a fast velocity, then DECELERATES into the arrival — a visible drop out
      // of lightspeed. Fades in over the fall, out as the work lands. ──
      // fade in over the start of the fall; hold LATE (so the deceleration is visible
      // at full brightness — the field coasts to a stop), then dissolve as the dot parks.
      const warpO = seg(p, FALL, FALL + 0.1) * (1 - seg(p, 0.72, 0.84));   // cleared before the catalog frames
      if (warpO > 0) {
        if (warp) {
          warp.classList.add("warping");
          warp.style.opacity = (warpO * 0.95).toFixed(3);
          // fast lightspeed, then a LINEAR decel to a stop over the last stretch (C1
          // at the junction, so the velocity eases down with no jump).
          let warpF;
          if (fall < 0.55) warpF = fall * 1.15;
          else { const u = (fall - 0.55) / 0.45; warpF = 0.6325 + 0.5175 * (u - 0.5 * u * u); }
          const travel = warpF * vh * 38;
          for (let i = 0; i < streaks.length; i++) {
            const t = (travel * STREAK_SP[i]) % STREAK_TH[i];
            // decelerate (warpF) + fade (the container opacity) → a clean "drop out of
            // warp." No scaleY shrink (it read as stubby/awkward at the end).
            streaks[i].style.transform = "translate3d(0," + (-t).toFixed(1) + "px,0)";
            // scroll-coupled shimmer — glimmers as you scrub, a composed still when paused
            streaks[i].style.opacity = (STREAK_OP[i] * (0.7 + 0.3 * Math.sin(p * 55 + i * 2.1))).toFixed(3);
          }
        }
        warpActive = true;
      } else if (warpActive) {
        if (warp) { warp.style.opacity = "0"; warp.classList.remove("warping"); }
        warpActive = false;
      }

      // ── the core bloom RIDES the comet (centred on it) — a soft halo travelling
      // down the right edge with the comet, replacing the old fixed screen-centre
      // glow. Transform + opacity only. ──
      // the multi-hue bloom RIDES the comet during the fall (scroll-driven), growing
      // with it; at the park it's handed off to the cooling ember (faded above), so
      // skip it once cooling.
      if (glow) {
        if (comet > 0 && bop > 0) {
          glow.style.transform =
            "translate3d(" + (bx * vw).toFixed(1) + "px," + by.toFixed(1) + "px,0) scale(" + (0.7 + 0.85 * fall).toFixed(3) + ")";
          // grows with the fall, plus a charge pulse near the dock (scroll-coupled)
          glow.style.opacity = (0.5 * (0.5 + 0.5 * fall) * bop + 0.18 * charge * (0.5 + 0.5 * Math.sin(fall * 42))).toFixed(3);
          glowActive = true;
        } else if (glowActive) { glow.style.opacity = "0"; glowActive = false; }
      }

      // ── light BLIPS: a handful of coloured streaks rush up at varied x / size /
      // hue / timing — a spectral flicker through the plunge. Each flashes once as it
      // passes; transform + opacity only. ──
      if (fall > 0 && p < 1) {
        for (let i = 0; i < blips.length; i++) {
          const el = blips[i], d = el.dataset;
          const bt = seg(fall, +(d.t0 || 0), +(d.t1 || 1));
          if (bt > 0 && bt < 1) {
            const yb = vh * (1 - (1 + (+(d.sp || 1)) * 0.5) * bt);  // rush up through the viewport
            el.style.transform = "translate3d(0," + yb.toFixed(1) + "px,0)";
            el.style.opacity = (Math.sin(bt * Math.PI) * (+(d.o || 0.4))).toFixed(3);
          } else if (el.style.opacity !== "0") { el.style.opacity = "0"; }
        }
        blipsActive = true;
      } else if (blipsActive) {
        for (const el of blips) el.style.opacity = "0";
        blipsActive = false;
      }

      // ── tiny GLINTS: a curated scatter of micro-sparkles in the field — they drift
      // up slightly with the motion and TWINKLE (scroll-coupled, brief sparse peaks),
      // like flecks of mica catching light. Texture, not pops; a pause is a frozen
      // shimmer. transform + opacity only. ──
      if (fall > 0) {
        const gv = seg(p, FALL, FALL + 0.08) * (1 - seg(p, 0.76, 0.86));   // cleared before the catalog frames
        const drift = (-fall * 26).toFixed(1);
        for (let i = 0; i < glints.length; i++) {
          const el = glints[i];
          // each glint twinkles at its OWN rate + phase (scroll-coupled) → a sparse,
          // irregular catch-the-light scatter; mostly dim, with sharp brief glints.
          const tw = Math.pow(0.5 + 0.5 * Math.sin(p * glintF[i] + glintPh[i]), 4);
          el.style.opacity = (gv * (0.08 + 0.92 * tw)).toFixed(3);
          el.style.transform = "translate(-50%,-50%) translateY(" + drift + "px) scale(" + (0.45 + 0.6 * tw).toFixed(2) + ")";
        }
        glintsActive = true;
      } else if (glintsActive) {
        for (const el of glints) el.style.opacity = "0";
        glintsActive = false;
      }

      // ── the DEVICE rises over the end of the fall — DARK (powered-off) — then, as the
      // comet is absorbed (≥ARRIVE), it BOOTS: --boot (0→1 over ARRIVE→WORK_LAND, scroll-
      // coupled) drives the module's CSS to lift its power-veil, fade the screen up, and
      // bring the colour glow online. Before ARRIVE the device is dark; at rest --boot=1.
      // The -(1-OFFV)×100svh margin releases the device flush; it then HOLDS framed. ──
      if (work) {
        const off = OFFV * vh;
        const naturalTop = r.top + r.height - vh + off;
        const boot = seg(p, ARRIVE + 0.012, WORK_LAND);   // a BEAT after the comet shoots in, the device wakes
        if (boot !== booted) { work.style.setProperty("--boot", boot.toFixed(3)); booted = boot; }
        if (p >= WORK_RISE) {
          const desired = off + (vh - off) * (1 - riseE(seg(p, WORK_RISE, WORK_LAND)));
          // land on a WHOLE pixel so the held device is rock-solid (no sub-pixel shimmer)
          work.style.transform = "translateY(" + (Math.round(desired) - naturalTop).toFixed(2) + "px)";
          work.style.willChange = "transform";
          workShown = true;
        } else if (naturalTop < vh) {
          work.style.transform = "translateY(" + (Math.round(vh) - naturalTop).toFixed(2) + "px)";  // hidden below
          workShown = true;
        } else if (workShown) {
          work.style.transform = "";
          work.style.willChange = "";
          workShown = false;
        }
      }

      // ── the ANTENNA catcher: a single sapphire rod from the device's top-right
      // corner up to a receiver bead on the comet's column. Drawn only in the late
      // window (one rect read on .deck, AFTER the work transform is applied above so
      // it's current). The comet lands on the bead (they share FALL_COLX); a charge
      // drains down the rod into the chassis exactly as the boot ramp begins; then
      // the rod retracts. All coords in viewport px = stage-local (the stage is
      // pinned at top:0 full-width through this whole window, like the comet). ──
      if (ant && rod && rodhi && chargeEl && mount && bead && flash && deck && deckTopOff >= 0) {
        if (p >= WORK_RISE - 0.04) {
          const dr = deck.getBoundingClientRect();
          const cornerX = dr.right, cornerY = dr.top;
          const LIFT_PX = Math.min(0.16 * vh, 120);
          const colX = FALL_COLX * vw, beadY = cornerY - LIFT_PX;
          const antIn = easeOut(seg(p, WORK_RISE, WORK_RISE + 0.06));
          // the rod stays FULL (corner → bead) until the comet HITS the bead at ARRIVE;
          // only then does it begin to retract.
          const antOut = easeOut(seg(p, ARRIVE + 0.02, ARRIVE + 0.07));
          const antO = antIn * (1 - antOut);
          ant.style.setProperty("--ant-o", antO.toFixed(3));
          // the charge drains bead→corner — but ONLY after the hit (starts at ARRIVE).
          // the rod shrinks behind it (the drained length vanishes into the chassis).
          const ch = seg(p, ARRIVE, ARRIVE + 0.03);
          const che = ease(ch);
          const chX = colX + (cornerX - colX) * che, chY = beadY + (cornerY - beadY) * che;
          const rx2 = ch > 0 ? chX : colX, ry2 = ch > 0 ? chY : beadY;
          rod.setAttribute("x1", cornerX.toFixed(1)); rod.setAttribute("y1", cornerY.toFixed(1));
          rod.setAttribute("x2", rx2.toFixed(1)); rod.setAttribute("y2", ry2.toFixed(1));
          rodhi.setAttribute("x1", cornerX.toFixed(1)); rodhi.setAttribute("y1", cornerY.toFixed(1));
          rodhi.setAttribute("x2", rx2.toFixed(1)); rodhi.setAttribute("y2", ry2.toFixed(1));
          chargeEl.setAttribute("cx", chX.toFixed(1)); chargeEl.setAttribute("cy", chY.toFixed(1));
          chargeEl.setAttribute("opacity", ch > 0 && ch < 1 ? "1" : "0");
          mount.style.left = cornerX.toFixed(1) + "px"; mount.style.top = cornerY.toFixed(1) + "px";
          mount.style.opacity = antO.toFixed(3);
          mount.classList.toggle("lit", ch >= 0.9);
          mount.style.setProperty("--mount-hot", (seg(p, ARRIVE + 0.02, ARRIVE + 0.045) * (1 - antOut)).toFixed(3));
          bead.style.left = colX.toFixed(1) + "px"; bead.style.top = beadY.toFixed(1) + "px";
          bead.style.opacity = (antO * (1 - seg(p, ARRIVE, ARRIVE + 0.022))).toFixed(3);  // releases just after the hit
          const catchE = seg(p, ARRIVE - 0.05, ARRIVE), preGlow = ease(seg(p, WORK_RISE + 0.04, ARRIVE - 0.05)) * 0.3;
          bead.style.setProperty("--hot", Math.max(catchE, preGlow).toFixed(3));   // pre-glow → impact "thunk", scrubbable
          bead.style.setProperty("--bead-s", (1 + 0.5 * catchE).toFixed(3));
          // the impact FLASH — a quick bright burst at the bead the instant the comet
          // lands (peaks just past ARRIVE, expands + fades). Pure function of p.
          const flashP = seg(p, ARRIVE - 0.012, ARRIVE + 0.03);
          flash.style.left = colX.toFixed(1) + "px"; flash.style.top = beadY.toFixed(1) + "px";
          flash.style.setProperty("--flash-o", Math.sin(flashP * Math.PI).toFixed(3));
          flash.style.setProperty("--flash-s", (0.4 + flashP * 2.4).toFixed(3));
          antActive = true;
        } else if (antActive) {
          ant.style.setProperty("--ant-o", "0");
          bead.style.opacity = "0"; mount.style.opacity = "0";
          flash.style.setProperty("--flash-o", "0");
          chargeEl.setAttribute("opacity", "0"); mount.classList.remove("lit");
          antActive = false;
        }
      }
    };
    const onScroll = () => {
      if (!ticking) { ticking = true; requestAnimationFrame(render); }
    };

    const startLive = () => {
      als.classList.add("als-live");
      document.body.style.backgroundAttachment = "fixed";   // paper still through the about (no per-frame writes)
      if (work) work.style.marginTop = "-88svh";   // = -(1 - OFFV) × 100svh — releases flush at the offset
      if (!io) {
        io = new IntersectionObserver((recs) => {
          for (const r of recs) {
            on = r.isIntersecting;
            if (on) {
              if (!scrollBound) { window.addEventListener("scroll", onScroll, { passive: true }); scrollBound = true; }
              p = -1; render();
            } else if (scrollBound) {
              window.removeEventListener("scroll", onScroll); scrollBound = false;
            }
          }
        }, { rootMargin: "60% 0px 60% 0px" });
      }
      io.observe(als);
      p = -1; render();
    };
    const stopLive = () => {
      als.classList.remove("als-live");
      io?.disconnect();
      if (scrollBound) { window.removeEventListener("scroll", onScroll); scrollBound = false; }
      on = false;
      // clear the per-frame vars so the static base reads cleanly
      for (const v of ["--name-o", "--name-y", "--cue-o", "--wy", "--wamp", "--wlife", "--wo", "--q", "--sig-o"]) {
        stage.style.removeProperty(v);
      }
      dot.classList.remove("settled");
      dot.style.removeProperty("transform");
      dot.style.opacity = "0";
      for (const v of ["--bs", "--chg-o", "--chg-s", "--cg", "--tail"]) dot.style.removeProperty(v);
      link?.classList.remove("on");
      nodes.forEach((n) => n.classList.remove("lit"));
      beats.setAttribute("data-active", "-1");
      active = -2;
      document.body.style.removeProperty("background-position-y");
      document.body.style.removeProperty("background-attachment");
      bgScroll = false;
      warpActive = false; glowActive = false; blipsActive = false; glintsActive = false;
      if (warp) warp.style.opacity = "0";
      streaks.forEach((s) => { s.style.removeProperty("transform"); s.style.removeProperty("opacity"); });
      if (glow) { glow.style.opacity = "0"; glow.style.removeProperty("transform"); }
      blips.forEach((b) => { b.style.opacity = "0"; b.style.removeProperty("transform"); });
      glints.forEach((g) => { g.style.opacity = "0"; g.style.removeProperty("transform"); });
      if (work) { work.style.transform = ""; work.style.willChange = ""; work.style.marginTop = ""; work.style.removeProperty("--boot"); }
      if (ant) ant.style.removeProperty("--ant-o");
      if (bead) { bead.style.opacity = "0"; bead.style.removeProperty("left"); bead.style.removeProperty("top"); bead.style.removeProperty("--hot"); bead.style.removeProperty("--bead-s"); }
      if (mount) { mount.style.opacity = "0"; mount.classList.remove("lit"); mount.style.removeProperty("--mount-hot"); }
      if (flash) { flash.style.removeProperty("--flash-o"); flash.style.removeProperty("--flash-s"); }
      chargeEl?.setAttribute("opacity", "0");
      antActive = false;
      deckTopOff = -1;
      booted = -1;
      workShown = false;
    };

    // the live choreography needs a minimally tall viewport. The arrival is now a
    // now-spinning record (compact tracklist + a hero cover that SCALES to the viewport),
    // so it composes in one frame at essentially any desktop height — only genuinely tiny
    // windows fall through to the calm static about.
    const short = window.matchMedia("(max-height: 36.99rem)");
    const setup = () => {
      if (!reduce.matches && !coarse.matches && !short.matches) startLive();
      else stopLive();
    };
    setup();
    reduce.addEventListener?.("change", setup);
    coarse.addEventListener?.("change", setup);
    short.addEventListener?.("change", setup);
    window.addEventListener("resize", () => {
      deckTopOff = -1;   // re-measure the device offset so the antenna re-aims
      if (on) { p = -1; render(); if (active >= 0) positionLink(active); }
    }, { passive: true });
  })();
</script>
