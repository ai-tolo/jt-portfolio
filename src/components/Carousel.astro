---
// Carousel — the shared one-piece-at-a-time chassis (2026-08-19: Jon's
// Bandcamp-gravity direction for listen + look). Slides come through the
// default slot; this owns arrows, the counter, keyboard, and the slide
// transform. Transform/opacity only, no rAF, reduced-motion snaps.
interface Props {
  /** Total slide count (server-known so the counter renders true). */
  count: number;
  label: string;
  /** Accent for controls. */
  accent?: string;
}
const { count, label, accent = "var(--brand-cyan, #6ee0ff)" } = Astro.props;
---

<div class="car" data-carousel data-count={String(count)} style={`--car-accent:${accent}`}
  role="group" aria-roledescription="carousel" aria-label={label}>
  <div class="car-view">
    <div class="car-track" data-car-track>
      <slot />
    </div>
  </div>
  {count > 1 && (
    <div class="car-nav">
      <button class="car-btn" type="button" data-car-prev aria-label="Previous">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
          stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 6 9 12l5.5 6" /></svg>
      </button>
      <span class="car-counter" data-car-counter>01&nbsp;/&nbsp;{String(count).padStart(2, "0")}</span>
      <button class="car-btn" type="button" data-car-next aria-label="Next">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
          stroke-linecap="round" stroke-linejoin="round"><path d="M9.5 6 15 12l-5.5 6" /></svg>
      </button>
    </div>
  )}
</div>

<style>
  .car {
    width: 100%;
  }
  .car-view {
    overflow: hidden;
  }
  .car-track {
    display: flex;
    align-items: stretch;
    transition: transform 340ms cubic-bezier(0.2, 0.7, 0.3, 1);
  }
  .car-track > :global(*) {
    flex: 0 0 100%;
    min-width: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .car-track {
      transition: none;
    }
  }
  .car-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    margin-top: 18px;
  }
  .car-btn {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid rgba(245, 241, 232, 0.25);
    background: rgba(245, 241, 232, 0.05);
    color: rgba(245, 241, 232, 0.85);
    display: grid;
    place-items: center;
    cursor: pointer;
    transition: border-color 160ms ease, background 160ms ease, opacity 160ms ease;
  }
  .car-btn svg {
    width: 17px;
    height: 17px;
  }
  .car-btn:hover:not(:disabled),
  .car-btn:focus-visible {
    border-color: var(--car-accent);
    background: rgba(245, 241, 232, 0.1);
  }
  .car-btn:focus-visible {
    outline: 2px solid var(--car-accent);
    outline-offset: 2px;
  }
  .car-btn:disabled {
    opacity: 0.3;
    cursor: default;
  }
  .car-counter {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: rgba(245, 241, 232, 0.55);
    font-feature-settings: "tnum";
  }
</style>

<script>
  const pad = (n: number) => String(n).padStart(2, "0");
  // Carousels that dominate the viewport also answer the keyboard without
  // needing focus first (Jon, 2026-08-20 — the look band fills the screen,
  // so ←/→ should just work). Focused carousels keep their own handler.
  const registry: { car: HTMLElement; go: (d: number) => void }[] = [];
  for (const car of document.querySelectorAll<HTMLElement>("[data-carousel]")) {
    const track = car.querySelector<HTMLElement>("[data-car-track]")!;
    const slides = Array.from(track.children) as HTMLElement[];
    const prev = car.querySelector<HTMLButtonElement>("[data-car-prev]");
    const next = car.querySelector<HTMLButtonElement>("[data-car-next]");
    const counter = car.querySelector<HTMLElement>("[data-car-counter]");
    let i = 0;

    const show = (n: number) => {
      i = Math.max(0, Math.min(slides.length - 1, n));
      track.style.transform = `translateX(-${i * 100}%)`;
      slides.forEach((s, k) => {
        if (k === i) s.removeAttribute("aria-hidden");
        else s.setAttribute("aria-hidden", "true");
        // keep focus + tab order inside the visible slide only
        s.querySelectorAll<HTMLElement>("a, button, [tabindex]").forEach((el) => {
          if (k === i) el.removeAttribute("tabindex");
          else el.setAttribute("tabindex", "-1");
        });
        // pause any playing transport that slides away
        if (k !== i) s.querySelectorAll<HTMLAudioElement>("audio").forEach((a) => a.pause());
      });
      if (counter) counter.textContent = `${pad(i + 1)} / ${pad(slides.length)}`;
      if (prev) prev.disabled = i === 0;
      if (next) next.disabled = i === slides.length - 1;
    };

    prev?.addEventListener("click", () => show(i - 1));
    next?.addEventListener("click", () => show(i + 1));
    car.addEventListener("keydown", (e) => {
      // the transport's wave owns ←/→ for seeking when focused
      const el = document.activeElement as HTMLElement | null;
      if (el?.hasAttribute?.("data-tp-wave")) return;
      if (e.key === "ArrowRight") show(i + 1);
      if (e.key === "ArrowLeft") show(i - 1);
    });
    registry.push({ car, go: (d) => show(i + d) });
    show(0);
  }

  if (registry.length > 0) {
    window.addEventListener("keydown", (e) => {
      if (e.key !== "ArrowLeft" && e.key !== "ArrowRight") return;
      if (e.metaKey || e.ctrlKey || e.altKey || e.shiftKey) return;
      const el = document.activeElement as HTMLElement | null;
      // anything that owns its own arrow keys keeps them
      if (el && (el.tagName === "INPUT" || el.tagName === "TEXTAREA" || el.tagName === "SELECT" || el.isContentEditable)) return;
      if (el?.hasAttribute?.("data-tp-wave")) return;
      if (el?.closest?.("[data-carousel]")) return;
      // route to the carousel covering most of the screen — only when one
      // genuinely dominates (the full-viewport look band case)
      let best: (typeof registry)[number] | null = null;
      let bestVis = window.innerHeight * 0.55;
      for (const c of registry) {
        const r = c.car.getBoundingClientRect();
        const vis = Math.min(r.bottom, window.innerHeight) - Math.max(r.top, 0);
        if (vis >= bestVis) { bestVis = vis; best = c; }
      }
      if (!best) return;
      e.preventDefault();
      best.go(e.key === "ArrowRight" ? 1 : -1);
    });
  }
</script>
