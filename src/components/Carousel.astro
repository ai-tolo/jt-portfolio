---
// Carousel — the shared one-piece-at-a-time chassis (2026-08-19: Jon's
// Bandcamp-gravity direction for listen + look). Slides come through the
// default slot; this owns arrows, the counter, keyboard, and the slide
// transform. Transform/opacity only, no rAF, reduced-motion snaps.
interface Props {
  /** Total slide count (server-known so the counter renders true). */
  count: number;
  label: string;
  /** Accent for controls. */
  accent?: string;
  /** Render a dot per slide (progress + count), 2026-09-09 (Jon). */
  dots?: boolean;
  /** Accessible names for the dots, one per slide. */
  titles?: string[];
  /** "slide" translates the track; "dissolve" stacks the slides and
   *  crossfades, the incoming one rendering in top-down (Jon, 2026-09-09:
   *  the slide pushed pictures under the keycaps and broke the physical
   *  feel). */
  mode?: "slide" | "dissolve";
}
const { count, label, accent = "var(--brand-cyan, #6ee0ff)", dots = false, titles = [], mode = "slide" } = Astro.props;
---

<div class="car" data-carousel data-count={String(count)} data-mode={mode} style={`--car-accent:${accent}`}
  role="group" aria-roledescription="carousel" aria-label={label}>
  <div class="car-view">
    <div class="car-track" data-car-track>
      <slot />
    </div>
  </div>
  {count > 1 && (
    <div class="car-nav">
      <button class="car-btn" type="button" data-car-prev aria-label="Previous">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
          stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 6 9 12l5.5 6" /></svg>
      </button>
      <span class="car-counter" data-car-counter>01&nbsp;/&nbsp;{String(count).padStart(2, "0")}</span>
      <button class="car-btn" type="button" data-car-next aria-label="Next">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
          stroke-linecap="round" stroke-linejoin="round"><path d="M9.5 6 15 12l-5.5 6" /></svg>
      </button>
    </div>
  )}
  {dots && count > 1 && (
    <div class="car-dots" role="tablist" data-car-dots>
      {Array.from({ length: count }, (_, k) => (
        <button class="car-dot" type="button" role="tab" data-car-dot={String(k)}
          aria-label={titles[k] ?? `${k + 1} of ${count}`} aria-selected={k === 0 ? "true" : "false"}
          tabindex={k === 0 ? "0" : "-1"}></button>
      ))}
    </div>
  )}
</div>

<style>
  .car {
    width: 100%;
  }
  .car-view {
    overflow: hidden;
  }
  /* dots: one per slide, the current one lit; the host positions the row
     and sets its ink. 24px hit box around a 6px mark. */
  .car-dots {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 6px;
  }
  .car-dot {
    width: 24px;
    height: 24px;
    padding: 0;
    margin: 0;
    border: 0;
    background: none;
    display: grid;
    place-items: center;
    cursor: pointer;
    color: inherit;
    border-radius: 50%;
  }
  .car-dot::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.28;
    transition: opacity 160ms ease, transform 160ms ease;
  }
  .car-dot:hover::before {
    opacity: 0.6;
  }
  .car-dot[data-on]::before {
    opacity: 1;
    transform: scale(1.45);
    background: var(--car-dot-on, currentColor);
  }
  .car-dot:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 1px;
  }
  @media (prefers-reduced-motion: reduce) {
    .car-dot::before {
      transition: none;
    }
  }
  .car-track {
    display: flex;
    align-items: stretch;
    transition: transform 340ms cubic-bezier(0.2, 0.7, 0.3, 1);
  }
  .car-track > :global(*) {
    flex: 0 0 100%;
    min-width: 0;
  }
  /* dissolve: the slides keep the slide mode's exact widths (each 100% of
     the track, flex) but overlap — every slide after the first pulls back
     by one track width — so they stack in one place; the leaving one
     fades, the arriving one renders in from the top (~300ms) and fades
     up. Nothing moves, so nothing slides under the room's keys, and the
     pictures measure exactly as they did (a grid stack shrank them at
     mid widths) */
  .car[data-mode="dissolve"] .car-track {
    transition: none;
  }
  .car[data-mode="dissolve"] .car-track > :global(*) {
    position: relative;
    opacity: 0;
    visibility: hidden;
    transition: opacity 260ms ease, visibility 0s linear 260ms;
  }
  .car[data-mode="dissolve"] .car-track > :global(* + *) {
    margin-left: -100%;
  }
  .car[data-mode="dissolve"] .car-track > :global([data-on]) {
    opacity: 1;
    visibility: visible;
    transition: opacity 200ms ease, visibility 0s;
  }
  /* the render: the arriving slide wipes in from the top through a
     scanline mask (its own pixels only — the picture materialises, the
     ground around it never flickers), then the mask lifts */
  .car[data-mode="dissolve"][data-live] .car-track > :global([data-on]) {
    animation: car-render 320ms linear;
  }
  @keyframes car-render {
    0% {
      clip-path: inset(0 0 100% 0);
      -webkit-mask-image: repeating-linear-gradient(0deg, #000 0 2px, transparent 2px 3px);
      mask-image: repeating-linear-gradient(0deg, #000 0 2px, transparent 2px 3px);
    }
    85% {
      clip-path: inset(0 0 0 0);
      -webkit-mask-image: repeating-linear-gradient(0deg, #000 0 2px, transparent 2px 3px);
      mask-image: repeating-linear-gradient(0deg, #000 0 2px, transparent 2px 3px);
    }
    100% {
      clip-path: inset(0 0 0 0);
      -webkit-mask-image: none;
      mask-image: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .car-track {
      transition: none;
    }
    .car[data-mode="dissolve"] .car-track > :global(*) {
      transition: none;
    }
    .car[data-mode="dissolve"][data-live] .car-track > :global([data-on]) {
      animation: none;
    }
  }
  .car-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    margin-top: 18px;
  }
  .car-btn {
    position: relative;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid rgba(245, 241, 232, 0.25);
    background: rgba(245, 241, 232, 0.05);
    color: rgba(245, 241, 232, 0.85);
    display: grid;
    place-items: center;
    cursor: pointer;
    transition: border-color 160ms ease, background 160ms ease, opacity 160ms ease;
  }
  .car-btn svg {
    width: 17px;
    height: 17px;
  }
  /* invisible hit expansion to a 46px tap box */
  .car-btn::before {
    content: "";
    position: absolute;
    inset: -4px;
  }
  /* on touch, a disabled ghost arrow over artwork reads as broken — give
     disabled the same backing so the state reads as a state */
  @media (pointer: coarse) {
    .car-btn:disabled {
      opacity: 0.45;
      background: rgba(5, 7, 12, 0.45);
    }
  }
  .car-btn:hover:not(:disabled),
  .car-btn:focus-visible {
    border-color: var(--car-accent);
    background: rgba(245, 241, 232, 0.1);
  }
  .car-btn:focus-visible {
    outline: 2px solid var(--car-accent);
    outline-offset: 2px;
  }
  .car-btn:disabled {
    opacity: 0.3;
    cursor: default;
  }
  .car-counter {
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: rgba(245, 241, 232, 0.55);
    font-feature-settings: "tnum";
  }
</style>

<script>
  const pad = (n: number) => String(n).padStart(2, "0");
  // Carousels that dominate the viewport also answer the keyboard without
  // needing focus first (Jon, 2026-08-20 — the look band fills the screen,
  // so ←/→ should just work). Focused carousels keep their own handler.
  const registry: { car: HTMLElement; go: (d: number) => void }[] = [];
  for (const car of document.querySelectorAll<HTMLElement>("[data-carousel]")) {
    const track = car.querySelector<HTMLElement>("[data-car-track]")!;
    const slides = Array.from(track.children) as HTMLElement[];
    const prev = car.querySelector<HTMLButtonElement>("[data-car-prev]");
    const next = car.querySelector<HTMLButtonElement>("[data-car-next]");
    const counter = car.querySelector<HTMLElement>("[data-car-counter]");
    const dots = Array.from(car.querySelectorAll<HTMLButtonElement>("[data-car-dot]"));
    let i = 0;

    const dissolve = car.dataset.mode === "dissolve";
    const show = (n: number) => {
      i = Math.max(0, Math.min(slides.length - 1, n));
      if (!dissolve) track.style.transform = `translateX(-${i * 100}%)`;
      slides.forEach((s, k) => {
        if (k === i) {
          s.removeAttribute("aria-hidden");
          s.setAttribute("data-on", "");
        } else {
          s.setAttribute("aria-hidden", "true");
          s.removeAttribute("data-on");
        }
        // keep focus + tab order inside the visible slide only — RESTORE
        // each element's authored tabindex (removeAttribute broke the
        // transport's role=slider wave, which needs tabindex=0 — QA)
        s.querySelectorAll<HTMLElement>("a, button, [tabindex]").forEach((el) => {
          if (el.dataset.origTabindex === undefined) {
            el.dataset.origTabindex = el.getAttribute("tabindex") ?? "";
          }
          if (k === i) {
            if (el.dataset.origTabindex === "") el.removeAttribute("tabindex");
            else el.setAttribute("tabindex", el.dataset.origTabindex);
          } else {
            el.setAttribute("tabindex", "-1");
          }
        });
        // pause any playing transport that slides away
        if (k !== i) s.querySelectorAll<HTMLAudioElement>("audio").forEach((a) => a.pause());
      });
      if (counter) counter.textContent = `${pad(i + 1)} / ${pad(slides.length)}`;
      dots.forEach((d, k) => {
        d.setAttribute("aria-selected", k === i ? "true" : "false");
        d.tabIndex = k === i ? 0 : -1;
        if (k === i) d.setAttribute("data-on", "");
        else d.removeAttribute("data-on");
      });
      if (prev) prev.disabled = i === 0;
      if (next) next.disabled = i === slides.length - 1;
      car.dispatchEvent(new CustomEvent("car:change", { detail: { index: i } }));
    };

    prev?.addEventListener("click", () => show(i - 1));
    next?.addEventListener("click", () => show(i + 1));
    dots.forEach((d, k) => d.addEventListener("click", () => show(k)));
    car.addEventListener("keydown", (e) => {
      // the transport's wave owns ←/→ for seeking when focused
      const el = document.activeElement as HTMLElement | null;
      if (el?.hasAttribute?.("data-tp-wave")) return;
      if (e.key === "ArrowRight") show(i + 1);
      if (e.key === "ArrowLeft") show(i - 1);
    });
    registry.push({ car, go: (d) => show(i + d) });
    // a host may ask for a slide by index (the audio room's title menu)
    car.addEventListener("car:show", (e) => show(Number((e as CustomEvent).detail?.index ?? i)));

    // touch: swipe the track (2026-08-24 mobile pass). Horizontal drags of
    // more than 48px commit a slide; vertical motion stays the page's.
    let tx = 0, ty = 0, tracking = false;
    car.addEventListener("touchstart", (e) => {
      tx = e.touches[0].clientX;
      ty = e.touches[0].clientY;
      tracking = true;
    }, { passive: true });
    car.addEventListener("touchend", (e) => {
      if (!tracking) return;
      tracking = false;
      const dx = e.changedTouches[0].clientX - tx;
      const dy = e.changedTouches[0].clientY - ty;
      if (Math.abs(dx) > 48 && Math.abs(dx) > Math.abs(dy) * 1.4) show(i + (dx < 0 ? 1 : -1));
    }, { passive: true });
    show(0);
    // the render-in plays on changes, not on the first paint
    requestAnimationFrame(() => car.setAttribute("data-live", ""));
  }

  if (registry.length > 0) {
    window.addEventListener("keydown", (e) => {
      if (e.key !== "ArrowLeft" && e.key !== "ArrowRight") return;
      if (e.metaKey || e.ctrlKey || e.altKey || e.shiftKey) return;
      const el = document.activeElement as HTMLElement | null;
      // anything that owns its own arrow keys keeps them
      if (el && (el.tagName === "INPUT" || el.tagName === "TEXTAREA" || el.tagName === "SELECT" || el.isContentEditable)) return;
      if (el?.hasAttribute?.("data-tp-wave")) return;
      if (el?.closest?.("[data-carousel]")) return;
      // route to the carousel covering most of the screen — only when one
      // genuinely dominates (the full-viewport look band case)
      let best: (typeof registry)[number] | null = null;
      let bestVis = window.innerHeight * 0.55;
      for (const c of registry) {
        const r = c.car.getBoundingClientRect();
        const vis = Math.min(r.bottom, window.innerHeight) - Math.max(r.top, 0);
        if (vis >= bestVis) { bestVis = vis; best = c; }
      }
      if (!best) return;
      e.preventDefault();
      best.go(e.key === "ArrowRight" ? 1 : -1);
    });
  }
</script>
