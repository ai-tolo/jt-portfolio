---
// PROOF. The Crediverso bullet: "Usability testing with 50+ participants
// reduced primary-flow bounce rate by 15%." Instead of asserting it, this shows
// it: the primary onboarding flow (Open, Onboard, Verify, Complete) runs as a
// funnel. On play it animates from the BEFORE state to the AFTER state, where
// fewer people drop and the bounce segment shrinks by 15 points (40% to 25%).
// The 50+ participants who drove the change fill in as a row of dots, and a
// delta readout calls out the result. Theme-aware, reduced-motion-safe,
// vertical flow so it never overflows on mobile.

// Illustrative primary-flow funnel. Bounce = the share who drop before
// finishing. The before/after differ by 15 points on the final step, which is
// the honest read of "reduced bounce by 15%" for this flow.
const STEPS = [
  { id: "open", label: "Open", before: 100, after: 100 },
  { id: "onboard", label: "Onboard", before: 84, after: 91 },
  { id: "verify", label: "Verify", before: 71, after: 84 },
  { id: "complete", label: "Complete", before: 60, after: 75 },
];
const BOUNCE_BEFORE = 40; // 100 - 60
const BOUNCE_AFTER = 25; //  100 - 75
const DOTS = 52; // "50+" tested participants, shown as the sample
---

<div class="pf pf-usability" data-proof="usability">
  <div class="pf-head">
    <span class="pf-kicker">live · the research result</span>
    <h4 class="pf-title">Watch the primary-flow bounce drop 15 points</h4>
    <button type="button" class="pf-replay" data-replay aria-label="Replay the before and after">
      <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true"><path d="M13 8a5 5 0 1 1-1.46-3.54M13 2.5V5h-2.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <span data-run-label>Replay</span>
    </button>
  </div>

  <div class="pf-flow">
    <!-- 1 · the funnel: each step's reach, with a bounce cap that shrinks -->
    <figure class="pf-card pf-funnel">
      <figcaption class="pf-card-cap">
        <span class="pf-dot"></span>primary onboarding flow
        <em data-phase>· before</em>
      </figcaption>
      <div class="pf-steps" data-steps>
        {STEPS.map((s) => (
          <div class="pf-step">
            <span class="pf-step-name">{s.label}</span>
            <div class="pf-track">
              <span
                class="pf-reach"
                data-reach
                data-before={String(s.before)}
                data-after={String(s.after)}
                style={`--w:${s.before}%`}
              ></span>
              {s.id === "complete" && (
                <span class="pf-bounce" data-bounce style={`--b:${BOUNCE_BEFORE}%`}>
                  <em data-bounce-label>{BOUNCE_BEFORE}% bounce</em>
                </span>
              )}
            </div>
            <span class="pf-step-pct" data-pct data-before={String(s.before)} data-after={String(s.after)}>{s.before}%</span>
          </div>
        ))}
      </div>
    </figure>

    <!-- 2 · the sample that drove it: 50+ participants -->
    <div class="pf-card pf-sample">
      <div class="pf-sample-head">
        <span class="pf-sample-n"><b data-c="people">0</b>+ participants tested</span>
        <span class="pf-sample-note" data-sample-note>recruiting…</span>
      </div>
      <div class="pf-dots" data-dots aria-hidden="true">
        {Array.from({ length: DOTS }).map(() => <span class="pf-pip"></span>)}
      </div>
    </div>

    <!-- 3 · the delta readout -->
    <div class="pf-delta" data-delta>
      <span class="pf-delta-big"><b data-c="drop">0</b><i>pt drop</i></span>
      <span class="pf-delta-arrow" aria-hidden="true">
        <b data-from-bounce>{BOUNCE_BEFORE}%</b>
        <svg viewBox="0 0 24 12" width="22" height="11" aria-hidden="true"><path d="M1 6h19m0 0-4-4m4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <b class="pf-delta-after" data-to-bounce>{BOUNCE_AFTER}%</b>
      </span>
      <span class="pf-delta-tag">bounce on the primary flow</span>
    </div>
  </div>

  <div class="pf-meter" data-meter>
    <span><b data-c="people2">0</b>+ tested</span>
    <span class="pf-meter-sep">·</span>
    <span>bounce <b data-c="b1">0</b>% to <b data-c="b2">0</b>%</span>
    <span class="pf-meter-sep">·</span>
    <span><b data-c="drop2">0</b> points fewer drop</span>
  </div>
</div>

<script>
  import { onPlay, countUp, prefersReduced } from "./lib/motion";

  document.querySelectorAll<HTMLElement>('[data-proof="usability"]').forEach((root) => {
    const phase = root.querySelector<HTMLElement>("[data-phase]");
    const runLabel = root.querySelector<HTMLElement>("[data-run-label]");
    const sampleNote = root.querySelector<HTMLElement>("[data-sample-note]");
    const bounceLabel = root.querySelector<HTMLElement>("[data-bounce-label]");
    const reaches = Array.from(root.querySelectorAll<HTMLElement>("[data-reach]"));
    const pcts = Array.from(root.querySelectorAll<HTMLElement>("[data-pct]"));
    const bounce = root.querySelector<HTMLElement>("[data-bounce]");
    const pips = Array.from(root.querySelectorAll<HTMLElement>(".pf-pip"));
    const meter = {
      people: root.querySelector<HTMLElement>('[data-c="people"]'),
      people2: root.querySelector<HTMLElement>('[data-c="people2"]'),
      drop: root.querySelector<HTMLElement>('[data-c="drop"]'),
      drop2: root.querySelector<HTMLElement>('[data-c="drop2"]'),
      b1: root.querySelector<HTMLElement>('[data-c="b1"]'),
      b2: root.querySelector<HTMLElement>('[data-c="b2"]'),
    };

    const PEOPLE = 52;
    const BOUNCE_BEFORE = 40;
    const BOUNCE_AFTER = 25;
    const DROP = BOUNCE_BEFORE - BOUNCE_AFTER; // 15

    let timers: number[] = [];
    const clearTimers = () => { timers.forEach(clearTimeout); timers = []; };
    const after = (ms: number, fn: () => void) => { timers.push(window.setTimeout(fn, ms)); };

    // Snap every bar to its "before" or "after" target without easing.
    const setState = (key: "before" | "after") => {
      reaches.forEach((r) => { r.style.setProperty("--w", `${r.dataset[key]}%`); });
      pcts.forEach((p) => { p.textContent = `${p.dataset[key]}%`; });
      if (bounce) bounce.style.setProperty("--b", `${key === "before" ? BOUNCE_BEFORE : BOUNCE_AFTER}%`);
      if (bounceLabel) bounceLabel.textContent = `${key === "before" ? BOUNCE_BEFORE : BOUNCE_AFTER}% bounce`;
    };

    const fillDots = (n: number) => {
      pips.forEach((p, i) => p.classList.toggle("is-on", i < n));
    };

    const finalState = () => {
      setState("after");
      fillDots(pips.length);
      if (phase) phase.textContent = "· after";
      if (sampleNote) sampleNote.textContent = "drove the redesign";
      if (runLabel) runLabel.textContent = "Replay";
      root.classList.remove("is-running");
      root.classList.add("is-done");
      if (meter.people) countUp(meter.people, PEOPLE, { dur: 900 });
      if (meter.people2) countUp(meter.people2, PEOPLE, { dur: 900 });
      if (meter.drop) countUp(meter.drop, DROP, { dur: 900 });
      if (meter.drop2) countUp(meter.drop2, DROP, { dur: 900 });
      if (meter.b1) countUp(meter.b1, BOUNCE_BEFORE, { dur: 700 });
      if (meter.b2) countUp(meter.b2, BOUNCE_AFTER, { dur: 1000 });
    };

    const run = () => {
      clearTimers();
      root.classList.remove("is-done");

      if (prefersReduced()) {
        finalState();
        return;
      }

      // Reset to the BEFORE state, then transition to AFTER so the drop is felt.
      root.classList.add("is-running");
      setState("before");
      fillDots(0);
      if (phase) phase.textContent = "· before";
      if (sampleNote) sampleNote.textContent = "recruiting…";
      if (runLabel) runLabel.textContent = "Running";

      // Roll the 50+ participant dots in.
      pips.forEach((p, i) => {
        after(120 + i * 11, () => p.classList.add("is-on"));
      });

      // Settle, then flip to the after state (CSS transitions on --w/--b ride it).
      after(900, () => {
        if (phase) phase.textContent = "· after";
        if (sampleNote) sampleNote.textContent = "drove the redesign";
        setState("after");
      });

      after(1750, finalState);
    };

    // Headless / backgrounded-tab backstop: guarantee the final state lands.
    onPlay(root, () => {
      run();
      after(prefersReduced() ? 0 : 2100, finalState);
    }, { threshold: 0.3 });

    root.querySelector<HTMLButtonElement>("[data-replay]")?.addEventListener("click", () => {
      run();
      after(prefersReduced() ? 0 : 2100, finalState);
    });
  });
</script>

<style>
  .pf {
    --pf-radius: 8px;
    --pf-bg: color-mix(in srgb, var(--surface-1) 60%, var(--bg));
    margin-top: var(--space-4);
    /* gradient "selected" border, matching the portal bucket cards */
    border: 1.5px solid transparent;
    border-radius: var(--pf-radius);
    background:
      linear-gradient(var(--pf-bg), var(--pf-bg)) padding-box,
      linear-gradient(135deg, #ff3b6e 0%, #ff6e21 50%, #eeff00 100%) border-box;
    box-shadow: 0 0 22px rgba(255, 59, 110, 0.15), 0 10px 26px -12px rgba(0, 0, 0, 0.5);
    padding: var(--space-4);
    font-weight: var(--fw-regular);
  }
  .pf-head {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
    flex-wrap: wrap;
  }
  .pf-kicker {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .pf-title {
    font-size: 0.9375rem;
    font-weight: var(--fw-semibold);
    letter-spacing: -0.01em;
    color: var(--text);
    flex: 1 1 auto;
  }
  .pf-replay {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    appearance: none;
    border: 1px solid var(--line);
    background: var(--bg);
    color: var(--text);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    padding: 5px 11px;
    border-radius: 999px;
    cursor: pointer;
    transition: border-color 160ms ease, color 160ms ease;
  }
  .pf-replay:hover { border-color: var(--accent); color: var(--accent); }

  .pf-flow { display: flex; flex-direction: column; align-items: stretch; gap: var(--space-2); }

  .pf-card {
    margin: 0;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--bg);
    padding: var(--space-3);
  }
  .pf-card-cap {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.6875rem;
    color: var(--muted);
    margin-bottom: var(--space-3);
  }
  .pf-card-cap em { color: var(--accent); font-style: normal; transition: color 200ms ease; }
  .pf-usability.is-done .pf-card-cap em { color: var(--accent); }
  .pf-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); }

  /* ── funnel ── */
  .pf-steps { display: flex; flex-direction: column; gap: 7px; }
  .pf-step {
    display: grid;
    grid-template-columns: 4.5rem 1fr 2.6rem;
    align-items: center;
    gap: var(--space-2);
  }
  .pf-step-name {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.6875rem;
    color: var(--text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .pf-track {
    position: relative;
    height: 14px;
    border-radius: 3px;
    background: var(--surface-1);
    overflow: hidden;
  }
  .pf-reach {
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--w);
    background: color-mix(in srgb, var(--accent) 28%, var(--text));
    border-radius: 3px;
    transition: width 0.85s cubic-bezier(0.22, 1, 0.36, 1);
  }
  /* the bounce cap sits at the right edge of the final track and shrinks */
  .pf-bounce {
    position: absolute;
    top: 0; bottom: 0; right: 0;
    width: var(--b);
    background: color-mix(in srgb, var(--accent) 80%, var(--bg));
    border-left: 1px solid color-mix(in srgb, var(--bg) 50%, transparent);
    border-radius: 0 3px 3px 0;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding-right: 5px;
    transition: width 0.85s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .pf-bounce em {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.5rem;
    font-style: normal;
    color: #fff;
    white-space: nowrap;
    letter-spacing: 0.02em;
  }
  .pf-step-pct {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.6875rem;
    color: var(--muted);
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .pf-step:last-child .pf-step-pct { color: var(--text); font-weight: var(--fw-semibold); }

  /* ── sample ── */
  .pf-sample-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
    flex-wrap: wrap;
  }
  .pf-sample-n {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.6875rem;
    color: var(--text);
  }
  .pf-sample-n b { color: var(--accent); font-variant-numeric: tabular-nums; font-size: 0.8125rem; }
  .pf-sample-note {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.625rem;
    color: var(--muted);
  }
  .pf-usability.is-done .pf-sample-note { color: var(--accent); }
  .pf-dots {
    display: grid;
    grid-template-columns: repeat(26, 1fr);
    gap: 4px;
  }
  .pf-pip {
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--surface-1);
    border: 1px solid var(--line);
    transition: background 220ms ease, border-color 220ms ease, transform 220ms ease;
  }
  .pf-pip.is-on {
    background: var(--accent);
    border-color: var(--accent);
    transform: scale(1.08);
  }

  /* ── delta readout ── */
  .pf-delta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--line);
    border-radius: 6px;
    background: color-mix(in srgb, var(--accent) 8%, var(--bg));
  }
  .pf-delta-big {
    display: inline-flex;
    align-items: baseline;
    gap: 4px;
  }
  .pf-delta-big b {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 1.5rem;
    font-weight: var(--fw-bold);
    line-height: 1;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  .pf-delta-big i {
    font-style: normal;
    font-size: 0.6875rem;
    color: var(--muted);
  }
  .pf-delta-arrow {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .pf-delta-arrow svg { color: var(--accent); }
  .pf-delta-after { color: var(--accent); font-weight: var(--fw-semibold); }
  .pf-delta-tag {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.625rem;
    color: var(--muted);
    margin-left: auto;
  }

  /* ── meter ── */
  .pf-meter {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 10px;
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid var(--line);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.6875rem;
    color: var(--muted);
  }
  .pf-meter b { color: var(--accent); font-variant-numeric: tabular-nums; font-size: 0.8125rem; }
  .pf-meter-sep { color: var(--line); }

  @media (max-width: 34rem) {
    .pf-step { grid-template-columns: 3.6rem 1fr 2.4rem; gap: 6px; }
    .pf-dots { grid-template-columns: repeat(18, 1fr); }
    .pf-delta-tag { margin-left: 0; width: 100%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .pf-reach, .pf-bounce, .pf-pip, .pf-card-cap em, .pf-delta-arrow svg { transition: none !important; }
  }
</style>
