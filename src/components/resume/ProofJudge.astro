---
// PROOF for the mastering agent's evidence bullet: every candidate is
// loudness-matched and judged blind against the untouched original.
//
// This module is the CHECKABLE ARTIFACT, the blind test's ledger. Every date,
// axis, LUFS value, winner and count below is read from
// src/lib/judge-ledger.json, a dated snapshot of the real harness database
// (mix_judgements / mix_jobs / mix_variants on the M1). Nothing is typed by
// hand (even the counts that print as words, the caption's "Ten" and the
// foot's "nine", are spelled from the rows), and nothing animates a number
// into existence. The listening notes stay in the JSON; the module no longer
// shows them.
//
// Clothes (2026-10-06): the room's material, no dark panel. The module draws
// no ground of its own: it reads the .proof-panel tokens (--pf-*, each with its
// day value as the fallback; night flips them on the panel) and sets its one
// object, the ledger, as paper on that ground: a card, 1px hairlines, a firmer
// rule where the session changes. Three faces (JetBrains Mono for labels and
// cells, Instrument Sans for the lead, Outfit for the one big number), the 4/8
// spacing scale, and ONE accent, green, kept for the original's wins: the
// filled dot and the word in the ledger, and the bar's fill.
//
// It is built for a cold glance: the numbers are static in the HTML, only the
// ledger rows and the one bar have a reveal, and any reduced-motion or no-JS
// reader gets the settled state immediately.
import ledger from "../../lib/judge-ledger.json";

type Row = { d: string; axis: string; lufs: number; orig: boolean; note?: string };

const rows = ledger.rows as Row[];
const b = ledger.blind;

// the share of blind votes the untouched original won: the one bar's length
const share = (b.chose_original / b.votes) * 100;

// counts that print as words are spelled from the rows themselves, so a new
// snapshot can never leave a stale "nine" under the table
const SPELLED = ["zero", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine", "ten", "eleven", "twelve"];
const spell = (n: number) => SPELLED[n] ?? String(n);
const shown = spell(rows.length);
const shownCap = shown.charAt(0).toUpperCase() + shown.slice(1);
const leading = spell(rows.length - 1);

// a date prints only when the session changes (as the log reads), and the row
// that closes a session carries the firmer rule beneath it
const lines = rows.map((row, i) => ({
  d: row.d,
  axis: row.axis,
  lufs: row.lufs.toFixed(2),
  orig: row.orig,
  newDay: i === 0 || rows[i - 1].d !== row.d,
  endDay: i < rows.length - 1 && rows[i + 1].d !== row.d,
}));
---

<div class="pf pf-judge" data-proof="judge">
  <header class="pf-head">
    <p class="pf-kicker">the blind test's ledger · snapshot <span class="jg-date">{ledger.snapshot}</span></p>
    <p class="jg-lead">
      Each round plays two takes at the same loudness, unlabeled, judged on one axis; the untouched original is always one of them.
    </p>
  </header>

  <div class="jg-body">
    <section class="jg-ledger" aria-label="Ledger rows">
      <div class="jg-tablewrap">
        <table class="jg-table">
          <caption class="jg-sr">
            {shownCap} rounds of the blind test: date, axis, the loudness both takes were matched to, and the winner.
          </caption>
          <thead>
            <tr>
              <th scope="col">date</th>
              <th scope="col">axis</th>
              <th scope="col" class="jg-num">lufs</th>
              <th scope="col">winner</th>
            </tr>
          </thead>
          <tbody>
            {lines.map((l, i) => (
              <tr class:list={["jg-line", "jg-row", { "is-day": l.newDay, "is-break": l.endDay }]} style={`--i:${i}`}>
                <td class="jg-d">{l.newDay ? l.d : ""}</td>
                <td class="jg-a">{l.axis}</td>
                <td class="jg-l jg-num">{l.lufs}</td>
                <td class="jg-w"><span class:list={["jg-dot", l.orig ? "is-keep" : "is-move"]} aria-hidden="true"></span><span class={l.orig ? "jg-win-keep" : "jg-win-move"}>{l.orig ? "original" : "render"}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="jg-foot">the first {leading} of {b.rounds} rounds, and the latest</p>
    </section>

    <section class="jg-verdict" aria-label="What the ledger adds up to">
      <p class="jg-n">{b.chose_original} of {b.votes}</p>
      <p class="jg-t">blind votes went to the untouched original</p>
      <div class="jg-bar" aria-hidden="true">
        <span class="jg-track">
          <span class="jg-fill" style={`width:${share.toFixed(2)}%`}></span>
          <span class="jg-half"></span>
        </span>
        <span class="jg-halfmark">50%</span>
      </div>
      {/* one line where it fits; in a narrow column each clause keeps its own
          line (a date never splits at its hyphen) and the dot leads it */}
      <p class="jg-caveat">
        <span>one rater (me)</span> <span>· {b.rounds} rounds in {b.sessions} sessions</span> <span>· {b.first} to {b.last}</span> <span>· no catch trials yet</span>
      </p>
    </section>
  </div>
</div>

<script>
  import { onPlay, prefersReduced } from "./lib/motion";

  document.querySelectorAll<HTMLElement>('[data-proof="judge"]').forEach((root) => {
    // Settled state is the default in CSS: no JS, no motion, or a throttled
    // tab all leave the ledger fully readable. Arming is what opts into the
    // reveal, so it can only ever hide rows while the script is in control.
    if (prefersReduced()) {
      root.classList.add("is-on");
      return;
    }
    root.classList.add("is-armed");

    const reveal = () => root.classList.add("is-on");
    onPlay(root, reveal, { threshold: 0.15 });

    // Backstop for headless/backgrounded tabs: if the module has a box on
    // screen and nothing has played it, settle it. A panel still collapsed
    // (height 0) stays armed so its reveal survives for the first open.
    window.setTimeout(() => {
      if (root.getBoundingClientRect().height > 1) reveal();
    }, 2200);
  });
</script>

<style>
  /* The module sits on the proof panel's ground (the room's, day and night)
     and states no palette of its own: every ink, card and hairline is the
     panel's token, with its day value as the fallback. The one exception is
     the accent, green, which is declared here with its night value. */
  .pf-judge {
    --jg-ink: var(--pf-ink, #141210);
    --jg-dim: var(--pf-dim, #6a6660);
    --jg-card: var(--pf-card, #ffffff);
    --jg-line: var(--pf-line, color-mix(in oklab, #141210 18%, transparent));
    --jg-soft: var(--pf-soft, color-mix(in oklab, #141210 9%, transparent));
    --jg-sans: var(--pf-sans, "Instrument Sans", "Helvetica Neue", Arial, sans-serif);
    --jg-mono: var(--pf-mono, "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace);
    --jg-display: var(--pf-display, "Outfit", "Instrument Sans", "Helvetica Neue", Arial, sans-serif);
    /* the original's wins, and nothing else */
    --jg-accent: #178650;

    container: judge / inline-size;
    margin: 0;
    color: var(--jg-ink);
    font-family: var(--jg-sans);
    font-weight: 400;
    text-align: left;
  }
  :global(html[data-night]) .pf-judge {
    --jg-accent: #4cc38a;
  }

  .jg-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* labels and captions: one voice */
  .pf-kicker,
  .jg-table th,
  .jg-foot,
  .jg-t,
  .jg-halfmark,
  .jg-caveat {
    font-family: var(--jg-mono);
    font-weight: 500;
    font-size: 0.6875rem;
    line-height: 1.5;
    letter-spacing: 0.12em;
    text-transform: lowercase;
    color: var(--jg-dim);
  }

  /* ── head: what it is, then how a round works ── */
  .pf-head {
    margin: 0;
  }
  .pf-kicker {
    margin: 0;
  }
  .jg-date {
    white-space: nowrap;
  }
  .jg-lead {
    margin: 12px 0 0;
    max-width: 60ch;
    font-family: var(--jg-sans);
    font-size: 1rem;
    line-height: 1.6;
    color: var(--jg-ink);
    text-wrap: balance;
  }

  /* ── body: the ledger, and beside it on a wide panel what it adds up to ── */
  .jg-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 32px;
    margin-top: 24px;
  }
  @container judge (min-width: 40rem) {
    .jg-body {
      /* the ledger keeps its natural width; the verdict takes the rest */
      grid-template-columns: auto minmax(0, 1fr);
    }
  }

  /* ── the ledger: one card of paper ── */
  .jg-ledger {
    min-width: 0;
  }
  /* on a phone the card scrolls sideways rather than breaking a field name
     like raw_vs_processed across two lines */
  .jg-tablewrap {
    overflow-x: auto;
    background: var(--jg-card);
    border: 1px solid var(--jg-line);
    border-radius: 12px;
  }
  .jg-table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    font-family: var(--jg-mono);
    font-size: 0.75rem;
    font-weight: 400;
    line-height: 1.5;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    color: var(--jg-ink);
  }
  .jg-table th {
    padding: 12px 12px 8px;
    text-align: left;
    border-bottom: 1px solid var(--jg-line);
  }
  .jg-table td {
    padding: 8px 12px;
    vertical-align: baseline;
    border-bottom: 1px solid var(--jg-soft);
  }
  .jg-table th:first-child,
  .jg-table td:first-child {
    padding-left: 16px;
  }
  .jg-table th:last-child,
  .jg-table td:last-child {
    padding-right: 16px;
  }
  .jg-table tbody tr:last-child td {
    border-bottom: 0;
  }
  /* a session break gets the firmer rule, the way the log groups by date */
  .jg-row.is-break td {
    border-bottom-color: var(--jg-line);
  }
  .jg-table .jg-num {
    text-align: right;
  }
  .jg-d {
    color: var(--jg-dim);
  }

  .jg-dot {
    display: inline-block;
    box-sizing: border-box;
    width: 6px;
    height: 6px;
    margin-right: 8px;
    border-radius: 50%;
    vertical-align: 1px;
  }
  .jg-dot.is-keep {
    background: var(--jg-accent);
  }
  .jg-dot.is-move {
    border: 1px solid var(--jg-dim);
  }
  .jg-win-keep {
    color: var(--jg-accent);
  }
  .jg-win-move {
    color: var(--jg-dim);
  }

  .jg-foot {
    margin: 8px 0 0;
  }

  /* ── what it adds up to: the number, what it counts, the one bar ── */
  .jg-verdict {
    min-width: 0;
  }
  .jg-n {
    margin: 0;
    font-family: var(--jg-display);
    font-weight: 500;
    font-size: 2.5rem;
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--jg-ink);
  }
  .jg-t {
    margin: 8px 0 0;
    text-wrap: balance;
  }

  .jg-bar {
    display: block;
    margin: 24px 0 0;
  }
  .jg-track {
    position: relative;
    display: block;
    height: 8px;
    border-radius: 4px;
    background: var(--jg-soft);
  }
  .jg-fill {
    display: block;
    height: 100%;
    border-radius: 4px;
    background: var(--jg-accent);
    transform-origin: left center;
  }
  /* even odds: where a coin would land */
  .jg-half {
    position: absolute;
    top: -4px;
    bottom: -4px;
    left: 50%;
    width: 0;
    border-left: 1px dashed var(--jg-dim);
  }
  .jg-halfmark {
    display: block;
    width: max-content;
    margin: 8px 0 0 50%;
    transform: translateX(-50%);
  }

  /* ── the caveat, stated plainly and last ── */
  .jg-caveat {
    margin: 24px 0 0;
    padding-top: 12px;
    border-top: 1px solid var(--jg-line);
  }
  .jg-caveat span {
    white-space: nowrap;
  }

  /* ── reveal: settled by default, armed only when the script takes over ── */
  .pf-judge.is-armed .jg-line {
    opacity: 0;
    transform: translateY(3px);
    transition: opacity 340ms ease, transform 340ms cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(var(--i, 0) * 38ms);
  }
  .pf-judge.is-armed .jg-fill {
    transform: scaleX(0);
    transition: transform 780ms cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(560ms + var(--i, 0) * 90ms);
  }
  .pf-judge.is-armed.is-on .jg-line { opacity: 1; transform: none; }
  .pf-judge.is-armed.is-on .jg-fill { transform: scaleX(1); }

  @media (prefers-reduced-motion: reduce) {
    .pf-judge .jg-line {
      opacity: 1 !important;
      transform: none !important;
    }
    .pf-judge .jg-fill { transform: none !important; }
    .pf-judge .jg-line,
    .pf-judge .jg-fill { transition: none !important; }
  }
</style>
