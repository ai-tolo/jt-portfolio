---
// PROOF for the Engineer bullet: the taste model was overfitting my ratings, so
// the judging moved out of the model and into a blind, loudness-matched test.
//
// This module is the CHECKABLE ARTIFACT: it does not assert the story, it shows
// the ledger. Every row, date, LUFS value, listening note and aggregate below
// is read from src/lib/judge-ledger.json, a dated snapshot of the real harness
// database (mix_judgements / mix_jobs / mix_variants on the M1). Nothing here is
// authored for effect and nothing animates a number into existence.
//
// It opens by default, so it is built for a cold glance: the numbers are static
// in the HTML, only the ledger lines and the two bars have a reveal, and any
// reduced-motion or no-JS reader gets the settled state immediately.
import ledger from "../../lib/judge-ledger.json";

type Row = { d: string; axis: string; lufs: number; orig: boolean; note?: string };

const rows = ledger.rows as Row[];
const b = ledger.blind;
const j = ledger.jobs;
const r = ledger.renders;

// share of decisions where the winning take was the untouched original
const pctVotes = Math.round((b.chose_original / b.votes) * 100); // 45
const pctRuns = Math.round((j.champion_original / j.with_champion) * 100); // 54

// flatten to display lines so the ledger reveal can stagger row + note alike,
// and so a date only prints when the session changes (as the log reads)
type Line =
  | { kind: "row"; d: string; axis: string; lufs: string; orig: boolean; newDay: boolean }
  | { kind: "note"; text: string };

const lines: Line[] = [];
rows.forEach((row, i) => {
  lines.push({
    kind: "row",
    d: row.d,
    axis: row.axis,
    lufs: row.lufs.toFixed(2),
    orig: row.orig,
    newDay: i === 0 || rows[i - 1].d !== row.d,
  });
  if (row.note) lines.push({ kind: "note", text: row.note });
});

const BARS = [
  { label: "blind votes", pct: pctVotes, num: b.chose_original, den: b.votes },
  { label: "decided runs", pct: pctRuns, num: j.champion_original, den: j.with_champion },
];
---

<div class="pf pf-judge" data-proof="judge">
  <header class="pf-head">
    <p class="pf-kicker">the harness ledger · snapshot {ledger.snapshot}</p>
    <h4 class="pf-title">
      The taste model was overfitting my ratings, not improving the audio. I shelved it and built a blind judge.
    </h4>
    <p class="jg-method">
      each round: two takes, unlabeled, matched to the same LUFS, judged on one axis
      (focal, dynamics, space, raw vs processed). the original is always on the ballot.
    </p>
  </header>

  <div class="jg-body">
    <section class="jg-ledger" aria-label="Ledger rows">
      <div class="jg-secthead">
        <span class="jg-seclabel">the ledger</span>
        <span class="jg-secmeta">{rows.length} of {b.rounds} rounds</span>
      </div>

      <div class="jg-tablewrap">
        <table class="jg-table">
          <caption class="jg-sr">
            Ten rounds from the blind listening ledger: date, axis, the LUFS both takes were
            matched to, and which take won. Listening notes are quoted under their round.
          </caption>
          <colgroup>
            <col class="jg-c-d" /><col class="jg-c-a" /><col class="jg-c-l" /><col class="jg-c-w" />
          </colgroup>
          <thead>
            <tr>
              <th scope="col">date</th>
              <th scope="col">axis</th>
              <th scope="col" class="jg-num">matched lufs</th>
              <th scope="col">winner</th>
            </tr>
          </thead>
          <tbody>
            {lines.map((l, i) =>
              l.kind === "row" ? (
                <tr class:list={["jg-line", "jg-row", { "is-day": l.newDay }]} style={`--i:${i}`}>
                  <td class="jg-d">{l.newDay ? l.d : ""}</td>
                  <td class="jg-a">{l.axis}</td>
                  <td class="jg-l jg-num">{l.lufs}</td>
                  <td class="jg-w"><span class:list={["jg-dot", l.orig ? "is-keep" : "is-move"]} aria-hidden="true"></span><span class={l.orig ? "jg-win-keep" : "jg-win-move"}>{l.orig ? "original" : "render"}</span></td>
                </tr>
              ) : (
                <tr class="jg-line jg-noteline" style={`--i:${i}`}>
                  <td colspan="4"><span class="jg-note">{l.text}</span></td>
                </tr>
              )
            )}
          </tbody>
        </table>
      </div>

      <p class="jg-foot">the first nine rounds and the latest. behind them: {j.total_runs} runs, {r.total} renders, {r.avg_per_run} per run ({r.max_per_run} at most).</p>
    </section>

    <section class="jg-verdict" aria-label="What the ledger adds up to">
      <dl class="jg-agg">
        <dt class="jg-n">{b.votes}</dt>
        <dd class="jg-t">blind loudness-matched votes</dd>
        <dt class="jg-n">{b.chose_original}</dt>
        <dd class="jg-t">kept the original</dd>
        <dt class="jg-n jg-word">single</dt>
        <dd class="jg-t">rater</dd>
      </dl>

      <div class="jg-restraint">
        <p class="jg-rlabel">how often the original won</p>
        <div class="jg-bars">
          {BARS.map((bar, i) => (
            <div class="jg-barrow">
              <span class="jg-blabel">{bar.label}</span>
              <span class="jg-track">
                <span class="jg-fill" style={`width:${bar.pct}%;--i:${i}`}></span>
                <span class="jg-half" aria-hidden="true"></span>
              </span>
              <span class="jg-bval">{bar.num}<span class="jg-slash">/</span>{bar.den}</span>
            </div>
          ))}
        </div>
        <p class="jg-scale"><span class="jg-halfkey" aria-hidden="true"></span> dashed line: 50%</p>
        <p class="jg-read">
          of {j.with_champion} runs that reached a champion, {j.champion_original} champions were the
          original. doing nothing won {pctRuns}% of decided runs.
        </p>
      </div>

      <p class="jg-caveat">
        <span class="jg-flag" aria-hidden="true"></span>
        <span>
          single rater so far, {b.rounds} rounds across {b.sessions} sessions, {b.first} to {b.last}.
          a multi-rater blind run is the next gate. no catch trials yet.
        </span>
      </p>
    </section>
  </div>
</div>

<script>
  import { onPlay, prefersReduced } from "./lib/motion";

  document.querySelectorAll<HTMLElement>('[data-proof="judge"]').forEach((root) => {
    // Settled state is the default in CSS: no JS, no motion, or a throttled
    // tab all leave the ledger fully readable. Arming is what opts into the
    // reveal, so it can only ever hide rows while the script is in control.
    if (prefersReduced()) {
      root.classList.add("is-on");
      return;
    }
    root.classList.add("is-armed");

    const reveal = () => root.classList.add("is-on");
    onPlay(root, reveal, { threshold: 0.15 });

    // Backstop for headless/backgrounded tabs: if the module has a box on
    // screen and nothing has played it, settle it. A panel still collapsed
    // (height 0) stays armed so its reveal survives for the first open.
    window.setTimeout(() => {
      if (root.getBoundingClientRect().height > 1) reveal();
    }, 2200);
  });
</script>

<style>
  /* The module sits inside the sheet's dark proof panel (#101216), so it draws
     no card of its own and it does not read theme tokens: the surrounding page
     is a white résumé in a light theme. Palette is stated outright. */
  .pf-judge {
    --ink: #e7ecf3;
    --mid: #97a2b3;
    --dim: #6c7787;
    --line: rgba(160, 190, 230, 0.14);
    --line-soft: rgba(160, 190, 230, 0.07);
    --keep: #00d44a;
    --move: #0ec4fc;
    --warn: #ffb347;
    --mono: "IBM Plex Mono", ui-monospace, SFMono-Regular, Menlo, monospace;

    margin: 0;
    color: var(--ink);
    font-weight: 400;
    text-align: left;
  }

  .jg-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* ── head ── */
  .pf-head {
    display: block;
    margin: 0 0 clamp(12px, 2vw, 18px);
  }
  .pf-kicker {
    margin: 0 0 7px;
    font-family: var(--mono);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    color: var(--move);
  }
  .pf-title {
    margin: 0;
    max-width: 62ch;
    font-size: clamp(0.95rem, 1.5vw, 1.075rem);
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .jg-method {
    margin: 8px 0 0;
    max-width: 68ch;
    font-family: var(--mono);
    font-size: 0.6875rem;
    line-height: 1.6;
    color: var(--mid);
  }

  /* ── body: ledger left, what it adds up to right ── */
  .jg-body {
    display: grid;
    gap: clamp(14px, 2.4vw, 26px);
    border-top: 1px solid var(--line);
    padding-top: clamp(12px, 2vw, 18px);
  }
  @media (min-width: 46rem) {
    .jg-body {
      grid-template-columns: minmax(0, 1.22fr) minmax(0, 0.9fr);
    }
    .jg-verdict {
      border-left: 1px solid var(--line);
      padding-left: clamp(14px, 2.4vw, 26px);
    }
  }

  /* ── the ledger ── */
  .jg-ledger { min-width: 0; }
  .jg-secthead {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 8px;
    font-family: var(--mono);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
  }
  .jg-seclabel { color: var(--ink); }
  .jg-secmeta { color: var(--dim); }

  /* on a phone the ledger scrolls sideways rather than breaking a field name
     like raw_vs_processed across two lines */
  .jg-tablewrap { overflow-x: auto; }
  .jg-table {
    width: 100%;
    min-width: 356px;
    table-layout: fixed;
    border-collapse: collapse;
    font-family: var(--mono);
    font-size: 0.6875rem;
    line-height: 1.4;
  }
  .jg-c-d { width: 24%; }
  .jg-c-a { width: 30%; }
  .jg-c-l { width: 21%; }
  .jg-c-w { width: 25%; }

  .jg-table th {
    padding: 0 0 6px;
    font-weight: 400;
    font-size: 0.5625rem;
    letter-spacing: 0.12em;
    color: var(--dim);
    text-align: left;
    border-bottom: 1px solid var(--line);
  }
  .jg-table td {
    padding: 5px 8px 5px 0;
    vertical-align: baseline;
    border-bottom: 1px solid var(--line-soft);
  }
  .jg-table td:last-child { padding-right: 0; }
  .jg-num { text-align: right; font-variant-numeric: tabular-nums; }
  .jg-table th.jg-num { text-align: right; padding-right: 10px; }
  .jg-table td.jg-l { padding-right: 10px; color: var(--mid); }
  .jg-d { color: var(--mid); font-variant-numeric: tabular-nums; }
  .jg-a { color: var(--ink); }

  /* a session break gets a real rule, the way the log groups by date */
  .jg-row.is-day:not(:first-child) td { border-top: 1px solid var(--line); }

  .jg-w { white-space: nowrap; }
  .jg-dot {
    display: inline-block;
    width: 5px;
    height: 5px;
    margin-right: 7px;
    border-radius: 50%;
    vertical-align: 1px;
  }
  .jg-dot.is-keep { background: var(--keep); }
  .jg-dot.is-move { background: transparent; box-shadow: inset 0 0 0 1.5px var(--move); }
  .jg-win-keep { color: var(--keep); }
  .jg-win-move { color: var(--move); opacity: 0.85; }

  .jg-noteline td {
    padding: 0 0 7px;
    border-bottom: 1px solid var(--line-soft);
  }
  .jg-note {
    display: block;
    padding-left: 9px;
    border-left: 1px solid var(--line);
    font-size: 0.65rem;
    line-height: 1.5;
    color: var(--dim);
  }
  .jg-note::before { content: "\201C"; }
  .jg-note::after { content: "\201D"; }

  .jg-foot {
    margin: 9px 0 0;
    font-family: var(--mono);
    font-size: 0.625rem;
    line-height: 1.55;
    color: var(--dim);
  }

  /* ── what it adds up to ── */
  .jg-verdict { min-width: 0; }
  /* the aggregate, big and quiet: the number, then what it counts */
  .jg-agg {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: baseline;
    column-gap: 11px;
    row-gap: 5px;
    margin: 0;
    font-family: var(--mono);
  }
  .jg-n {
    margin: 0;
    text-align: right;
    font-size: 1.3rem;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .jg-word { font-size: 0.95rem; }
  .jg-t {
    margin: 0;
    font-size: 0.6875rem;
    line-height: 1.4;
    color: var(--mid);
  }

  .jg-restraint {
    margin-top: clamp(12px, 2vw, 18px);
    padding-top: clamp(11px, 1.8vw, 15px);
    border-top: 1px solid var(--line);
  }
  .jg-rlabel {
    margin: 0 0 9px;
    font-family: var(--mono);
    font-size: 0.5625rem;
    letter-spacing: 0.12em;
    color: var(--dim);
  }
  .jg-bars { display: grid; gap: 7px; }
  .jg-barrow {
    display: grid;
    grid-template-columns: minmax(0, auto) minmax(60px, 1fr) auto;
    align-items: center;
    gap: 9px;
    font-family: var(--mono);
    font-size: 0.625rem;
  }
  .jg-blabel { color: var(--mid); white-space: nowrap; }
  .jg-track {
    position: relative;
    display: block;
    height: 6px;
    border-radius: 3px;
    background: rgba(160, 190, 230, 0.1);
  }
  .jg-fill {
    display: block;
    height: 100%;
    border-radius: 3px;
    background: var(--keep);
    opacity: 0.8;
    transform-origin: left center;
  }
  .jg-half {
    position: absolute;
    top: -3px;
    bottom: -3px;
    left: 50%;
    width: 0;
    border-left: 1px dashed rgba(231, 236, 243, 0.5);
  }
  .jg-bval { color: var(--ink); font-variant-numeric: tabular-nums; }
  .jg-slash { color: var(--dim); padding: 0 1px; }

  .jg-scale {
    margin: 7px 0 0;
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--mono);
    font-size: 0.5625rem;
    color: var(--dim);
  }
  .jg-halfkey {
    display: inline-block;
    width: 0;
    height: 12px;
    transform: translateY(2px);
    border-left: 1px dashed rgba(231, 236, 243, 0.5);
  }
  .jg-read {
    margin: 10px 0 0;
    font-family: var(--mono);
    font-size: 0.6875rem;
    line-height: 1.6;
    color: var(--mid);
  }

  /* ── the caveat, stated plainly and last ── */
  .jg-caveat {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin: clamp(11px, 1.8vw, 16px) 0 0;
    padding-top: clamp(10px, 1.6vw, 14px);
    border-top: 1px solid var(--line);
    font-family: var(--mono);
    font-size: 0.625rem;
    line-height: 1.6;
    color: var(--dim);
  }
  .jg-flag {
    flex: none;
    width: 5px;
    height: 5px;
    border-radius: 1px;
    background: var(--warn);
    transform: translateY(-1px);
  }

  /* ── reveal: settled by default, armed only when the script takes over ── */
  .pf-judge.is-armed .jg-line {
    opacity: 0;
    transform: translateY(3px);
    transition: opacity 340ms ease, transform 340ms cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(var(--i, 0) * 38ms);
  }
  .pf-judge.is-armed .jg-fill {
    transform: scaleX(0);
    transition: transform 780ms cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(560ms + var(--i, 0) * 90ms);
  }
  .pf-judge.is-armed.is-on .jg-line { opacity: 1; transform: none; }
  .pf-judge.is-armed.is-on .jg-fill { transform: scaleX(1); }

  @media (max-width: 30rem) {
    .jg-table { font-size: 0.625rem; }
    .jg-barrow { grid-template-columns: minmax(0, auto) minmax(44px, 1fr) auto; gap: 7px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .pf-judge .jg-line {
      opacity: 1 !important;
      transform: none !important;
    }
    .pf-judge .jg-fill { transform: none !important; }
    .pf-judge .jg-line,
    .pf-judge .jg-fill { transition: none !important; }
  }
</style>
