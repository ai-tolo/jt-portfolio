---
// PROOF — the Engineer bullet: "works as an agent, not a button... renders
// several masters, runs a blind loudness-matched A/B, weighs the votes to pick
// a winner, composes a king, and a grounded step decides whether to blend
// layers." Instead of asserting it, this runs the loop: five stages light in
// sequence on Run, so the multi-step, takes-actions-and-reasons-over-state
// shape reads at a glance. Theme-aware, reduced-motion-safe, vertical flow so
// it never overflows on mobile.

const STAGES = [
  { id: "render", label: "Render", detail: "6 masters across taste axes" },
  { id: "ab", label: "Blind A/B", detail: "loudness-matched, labels hidden" },
  { id: "weigh", label: "Weigh votes", detail: "votes become win-rates" },
  { id: "crown", label: "Crown a king", detail: "composed from the winning takes" },
  { id: "decide", label: "Decide layers", detail: "grounded check, usually no" },
];
---

<div class="pf pf-loop" data-proof="agentloop">
  <div class="pf-head">
    <span class="pf-kicker">live · the agent loop</span>
    <h4 class="pf-title">Render, judge, decide. One pass.</h4>
    <button type="button" class="pf-replay" data-replay aria-label="Run the agent loop again">
      <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true"><path d="M13 8a5 5 0 1 1-1.46-3.54M13 2.5V5h-2.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <span data-run-label>Run</span>
    </button>
  </div>

  <ol class="lp-flow" data-flow>
    {STAGES.map((s, i) => (
      <li class="lp-stage" data-stage={s.id}>
        <span class="lp-idx" aria-hidden="true">{i + 1}</span>
        <div class="lp-body">
          <span class="lp-label">{s.label}</span>
          <span class="lp-detail">{s.detail}</span>
        </div>
        <span class="lp-tick" aria-hidden="true">
          <svg viewBox="0 0 16 16" width="12" height="12"><path d="M3.5 8.5l3 3 6-7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
      </li>
    ))}
  </ol>

  <div class="pf-meter" data-meter>
    <span><b data-c="renders">0</b> renders</span>
    <span class="pf-meter-sep">·</span>
    <span><b data-c="round">0</b> blind round</span>
    <span class="pf-meter-sep">·</span>
    <span><b data-c="king">0</b> king · <span data-status>idle</span></span>
  </div>
</div>

<script>
  import { onPlay, countUp, prefersReduced } from "./lib/motion";

  document.querySelectorAll<HTMLElement>('[data-proof="agentloop"]').forEach((root) => {
    const stages = Array.from(root.querySelectorAll<HTMLElement>(".lp-stage"));
    const runLabel = root.querySelector<HTMLElement>("[data-run-label]");
    const status = root.querySelector<HTMLElement>("[data-status]");
    const meter = {
      renders: root.querySelector<HTMLElement>('[data-c="renders"]'),
      round: root.querySelector<HTMLElement>('[data-c="round"]'),
      king: root.querySelector<HTMLElement>('[data-c="king"]'),
    };
    const STATUS = ["rendering…", "judging blind…", "weighing votes…", "crowning…", "deciding…"];

    let timers: number[] = [];
    const clear = () => { timers.forEach(clearTimeout); timers = []; };
    const after = (ms: number, fn: () => void) => { timers.push(window.setTimeout(fn, ms)); };

    const finish = () => {
      stages.forEach((s) => { s.classList.remove("is-active"); s.classList.add("is-done"); });
      if (status) status.textContent = "done";
      if (runLabel) runLabel.textContent = "Run again";
      if (meter.renders) countUp(meter.renders, 6, { dur: 700 });
      if (meter.round) countUp(meter.round, 1, { dur: 500 });
      if (meter.king) countUp(meter.king, 1, { dur: 500 });
    };

    const run = () => {
      clear();
      stages.forEach((s) => s.classList.remove("is-active", "is-done"));
      if (runLabel) runLabel.textContent = "Running";

      if (prefersReduced()) { finish(); return; }

      const step = 520;
      stages.forEach((s, i) => {
        after(i * step, () => {
          stages.forEach((x, j) => { if (j < i) { x.classList.remove("is-active"); x.classList.add("is-done"); } });
          s.classList.add("is-active");
          if (status) status.textContent = STATUS[i];
        });
      });
      after(stages.length * step, finish);
      // headless backstop
      after(stages.length * step + 400, finish);
    };

    root.querySelector<HTMLButtonElement>("[data-replay]")?.addEventListener("click", run);
    onPlay(root, run, { threshold: 0.3 });
  });
</script>

<style>
  .pf {
    --pf-radius: 8px;
    --pf-bg: color-mix(in srgb, var(--surface-1) 60%, var(--bg));
    margin-top: var(--space-4);
    border: 1.5px solid transparent;
    border-radius: var(--pf-radius);
    background:
      linear-gradient(var(--pf-bg), var(--pf-bg)) padding-box,
      linear-gradient(135deg, #ff3b6e 0%, #ff6e21 50%, #eeff00 100%) border-box;
    box-shadow: 0 0 22px rgba(255, 59, 110, 0.15), 0 10px 26px -12px rgba(0, 0, 0, 0.5);
    padding: var(--space-4);
    font-weight: var(--fw-regular);
  }
  .pf-head { display: flex; align-items: baseline; gap: var(--space-3); margin-bottom: var(--space-4); flex-wrap: wrap; }
  .pf-kicker { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.625rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--accent); }
  .pf-title { font-size: 0.9375rem; font-weight: var(--fw-semibold); letter-spacing: -0.01em; color: var(--text); flex: 1 1 auto; }
  .pf-replay {
    display: inline-flex; align-items: center; gap: 6px; appearance: none;
    border: 1px solid var(--line); background: var(--bg); color: var(--text);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.6875rem;
    letter-spacing: 0.04em; padding: 5px 11px; border-radius: 999px; cursor: pointer;
    transition: border-color 160ms ease, color 160ms ease;
  }
  .pf-replay:hover { border-color: var(--accent); color: var(--accent); }

  /* ── the loop ── */
  .lp-flow { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .lp-stage {
    position: relative;
    display: flex; align-items: center; gap: var(--space-3);
    padding: 9px 0 9px 0;
  }
  /* connecting rail down the index column */
  .lp-stage::before {
    content: ""; position: absolute; left: 13px; top: 0; bottom: 0; width: 2px;
    background: var(--line);
  }
  .lp-stage:first-child::before { top: 50%; }
  .lp-stage:last-child::before { bottom: 50%; }

  .lp-idx {
    position: relative; z-index: 1; flex-shrink: 0;
    width: 28px; height: 28px; border-radius: 50%;
    display: grid; place-items: center;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.75rem;
    color: var(--muted); background: var(--bg);
    border: 1.5px solid var(--line);
    transition: color 240ms ease, border-color 240ms ease, background 240ms ease, transform 240ms ease;
  }
  .lp-body { display: flex; flex-direction: column; gap: 1px; min-width: 0; flex: 1 1 auto; }
  .lp-label { font-size: 0.875rem; font-weight: var(--fw-semibold); color: var(--text); }
  .lp-detail { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.625rem; color: var(--muted); }
  .lp-tick {
    flex-shrink: 0; color: var(--accent); opacity: 0; transform: scale(0.6);
    transition: opacity 220ms ease, transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .lp-stage.is-active .lp-idx {
    color: var(--bg); background: var(--accent); border-color: var(--accent);
    transform: scale(1.08);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 22%, transparent);
  }
  .lp-stage.is-active .lp-label { color: var(--accent); }
  .lp-stage.is-done .lp-idx { color: var(--accent); border-color: var(--accent); background: color-mix(in srgb, var(--accent) 12%, var(--bg)); }
  .lp-stage.is-done .lp-tick { opacity: 1; transform: none; }

  /* ── meter ── */
  .pf-meter {
    display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 10px;
    margin-top: var(--space-4); padding-top: var(--space-3);
    border-top: 1px solid var(--line);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.6875rem; color: var(--muted);
  }
  .pf-meter b { color: var(--accent); font-variant-numeric: tabular-nums; font-size: 0.8125rem; }
  .pf-meter-sep { color: var(--line); }
  [data-status] { color: var(--accent); }

  @media (prefers-reduced-motion: reduce) {
    .lp-idx, .lp-tick { transition: none !important; }
  }
</style>
