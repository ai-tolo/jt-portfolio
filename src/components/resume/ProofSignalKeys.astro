---
// PROOF for the browser instrument's bullet: five notes, synthesized in this
// page. Five playable keys (A S D F G, an A minor pentatonic, so any order of
// presses sounds intentional), each two detuned triangles through a closing
// lowpass with a short attack and release, on the same Web Audio primitives as
// the homepage instrument. Hard constraints: SILENT until a deliberate press
// (no autoplay, no sound on hover; the AudioContext is made on the first
// press, never before), and the tag says it will make sound before it does,
// because recruiters screen in open offices.
//
// Clothes (2026-10-06): the room's material, no dark panel. The module draws
// no ground of its own: it reads the .proof-panel tokens (--pf-*, each with its
// day value as the fallback; night flips them on the panel). The keys are
// paper keycaps: a card face, 1px hairlines, depth drawn as a thicker bottom
// border and never a shadow; a press sinks the face 2px onto its base. Mono
// for the label, the tag and the caps, Instrument Sans for the note, the 4/8
// spacing scale, and ONE accent, blue, for a pressed key's letter and lamp.
---

<div class="pf pf-keys" data-proof="signalkeys">
  <div class="pk-head">
    <p class="pk-label">five notes, synthesized in this page</p>
    <span class="pk-soundtag" aria-hidden="true">
      <svg viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor"
        stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
        <path d="M2 6v4h3l4 3V3L5 6H2Z" /><path d="M11.5 5.5a3.5 3.5 0 0 1 0 5" />
      </svg>
      sound on press
    </span>
  </div>

  <div class="pk-row" data-pk-row>
    {["A", "S", "D", "F", "G"].map((k, i) => (
      <button type="button" class="pk-key" data-pk-key={i} aria-label={`Play note ${i + 1}`}>
        <span class="pk-cap">{k}</span>
        <i class="pk-lamp" aria-hidden="true"></i>
      </button>
    ))}
  </div>

  <p class="pk-note">
    Press a key. The whole instrument is at <a href="https://www.uxjon.com/#play">uxjon.com/#play</a>.
  </p>
</div>

<script>
  // One context, created lazily on the FIRST press — never before.
  const root = document.querySelector<HTMLElement>('[data-proof="signalkeys"]');
  if (root) {
    const FREQS = [220.0, 261.63, 293.66, 329.63, 392.0]; // A minor pentatonic
    let ctx: AudioContext | null = null;
    let master: GainNode | null = null;

    const ensure = () => {
      if (ctx) return;
      ctx = new AudioContext();
      const comp = ctx.createDynamicsCompressor();
      comp.threshold.value = -18;
      comp.knee.value = 24;
      comp.ratio.value = 6;
      master = ctx.createGain();
      master.gain.value = 0.22;
      master.connect(comp);
      comp.connect(ctx.destination);
    };

    const voices = new Map<number, { osc: OscillatorNode; osc2: OscillatorNode; g: GainNode }>();

    const noteOn = (i: number) => {
      ensure();
      if (!ctx || !master || voices.has(i)) return;
      if (ctx.state === "suspended") ctx.resume();
      const t = ctx.currentTime;
      const g = ctx.createGain();
      g.gain.setValueAtTime(0, t);
      g.gain.linearRampToValueAtTime(0.9, t + 0.012);
      const lp = ctx.createBiquadFilter();
      lp.type = "lowpass";
      lp.frequency.setValueAtTime(1800, t);
      lp.frequency.exponentialRampToValueAtTime(900, t + 0.5);
      lp.Q.value = 0.7;
      const osc = ctx.createOscillator();
      osc.type = "triangle";
      osc.frequency.value = FREQS[i];
      const osc2 = ctx.createOscillator();
      osc2.type = "triangle";
      osc2.frequency.value = FREQS[i];
      osc2.detune.value = 6;
      const g2 = ctx.createGain();
      g2.gain.value = 0.4;
      osc.connect(lp);
      osc2.connect(g2);
      g2.connect(lp);
      lp.connect(g);
      g.connect(master);
      osc.start(t);
      osc2.start(t);
      voices.set(i, { osc, osc2, g });
    };

    const noteOff = (i: number) => {
      const v = voices.get(i);
      if (!v || !ctx) return;
      voices.delete(i);
      const t = ctx.currentTime;
      v.g.gain.cancelScheduledValues(t);
      v.g.gain.setValueAtTime(v.g.gain.value, t);
      v.g.gain.exponentialRampToValueAtTime(0.0006, t + 0.42);
      v.osc.stop(t + 0.5);
      v.osc2.stop(t + 0.5);
    };

    const keys = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-pk-key]"));
    keys.forEach((k) => {
      const i = Number(k.dataset.pkKey);
      const down = (e: Event) => { e.preventDefault(); k.setAttribute("data-lit", ""); noteOn(i); };
      const up = () => { k.removeAttribute("data-lit"); noteOff(i); };
      k.addEventListener("pointerdown", down);
      k.addEventListener("pointerup", up);
      k.addEventListener("pointerleave", up);
      k.addEventListener("pointercancel", up);
      // keyboard on the focused button
      k.addEventListener("keydown", (e) => { if ((e.key === "Enter" || e.key === " ") && !e.repeat) down(e); });
      k.addEventListener("keyup", (e) => { if (e.key === "Enter" || e.key === " ") up(); });
    });

    // a/s/d/f/g work while focus is anywhere inside the module
    const MAP: Record<string, number> = { a: 0, s: 1, d: 2, f: 3, g: 4 };
    root.addEventListener("keydown", (e) => {
      const i = MAP[e.key?.toLowerCase?.()];
      if (i === undefined || e.repeat) return;
      keys[i]?.setAttribute("data-lit", "");
      noteOn(i);
    });
    root.addEventListener("keyup", (e) => {
      const i = MAP[e.key?.toLowerCase?.()];
      if (i === undefined) return;
      keys[i]?.removeAttribute("data-lit");
      noteOff(i);
    });
  }
</script>

<style>
  /* The room's material. The proof panel hands down the tokens (day values
     are the fallbacks; night flips them on the panel), so the module states
     no palette of its own beyond its one accent. */
  .pf-keys {
    --pk-ink: var(--pf-ink, #141210);
    --pk-dim: var(--pf-dim, #6a6660);
    --pk-card: var(--pf-card, #ffffff);
    --pk-line: var(--pf-line, color-mix(in oklab, #141210 18%, transparent));
    --pk-soft: var(--pf-soft, color-mix(in oklab, #141210 9%, transparent));
    --pk-sans: var(--pf-sans, "Instrument Sans", "Helvetica Neue", Arial, sans-serif);
    --pk-mono: var(--pf-mono, "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace);
    /* the one hue: a pressed key's letter and lamp (5.5:1 on the day card) */
    --pk-accent: #2a62d9;
    margin: 0;
    color: var(--pk-ink);
    font-family: var(--pk-sans);
  }
  :global(html[data-night]) .pf-keys {
    --pk-accent: #7aa2ff; /* 6.8:1 on the night card */
  }

  /* labels: one mono voice */
  .pk-label,
  .pk-soundtag {
    font-family: var(--pk-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    line-height: 1.5;
    letter-spacing: 0.12em;
    text-transform: lowercase;
    color: var(--pk-dim);
  }

  /* ── head: what it is, and the warning before any sound ── */
  .pk-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px 16px;
    margin-bottom: 16px;
  }
  .pk-label {
    margin: 0;
  }
  .pk-soundtag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .pk-soundtag svg {
    display: block;
    flex: none;
  }

  /* ── the keys: five paper keycaps ── */
  .pk-row {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }
  .pk-key {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
    /* a 60px face on a 1px top hairline and a 3px base: the cap stands 64px.
       content-box, so a press can thin the base without resizing the face */
    box-sizing: content-box;
    height: 60px;
    display: grid;
    place-items: center;
    margin: 0;
    padding: 0;
    appearance: none;
    background: var(--pk-card);
    border: 1px solid var(--pk-line);
    border-bottom-width: 3px;
    border-radius: 8px;
    color: var(--pk-ink);
    font: inherit;
    cursor: pointer;
    touch-action: none;
    transition: border-color 160ms ease, color 160ms ease;
  }
  .pk-cap {
    font-family: var(--pk-mono);
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1;
  }
  .pk-lamp {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--pk-soft);
    transition: background-color 160ms ease;
  }
  .pk-key:hover {
    border-color: var(--pk-ink);
  }
  .pk-key:focus-visible {
    outline: 2px solid var(--pk-ink);
    outline-offset: 2px;
  }
  /* pressed: the face sinks 2px onto its base, which thins from 3px to 1px,
     so the cap's foot stays put; the margin keeps the row's height. The press
     lands at once, the release eases. */
  .pk-key[data-lit] {
    transform: translateY(2px);
    border-bottom-width: 1px;
    margin-bottom: 2px;
    color: var(--pk-accent);
    transition: none;
  }
  .pk-key[data-lit] .pk-lamp {
    background: var(--pk-accent);
    transition: none;
  }

  /* ── the note: how to play, and where the whole instrument is ── */
  .pk-note {
    margin: 16px 0 0;
    font-family: var(--pk-sans);
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--pk-dim);
  }
  /* the room's link grammar: a hairline underline that goes to full ink */
  .pk-note a {
    color: var(--pk-ink);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: color-mix(in oklab, currentColor 32%, transparent);
    text-underline-offset: 4px;
    transition: text-decoration-color 140ms ease;
  }
  .pk-note a:hover,
  .pk-note a:focus-visible {
    text-decoration-color: currentColor;
  }
</style>
