---
// Interactive experience timeline. Renders the real roles as a small Gantt so
// the career SHAPE reads at a glance, including the freelance-while-starting
// overlap that a flat list hides. Positions are computed at build time from the
// role date strings (faithful to the résumé content); "Present" resolves to the
// build date. Hovering a bar lifts the matching role card below; clicking it
// scrolls there. Theme-aware, reduced-motion-safe, mobile-stacking.

import type { Role } from "../../lib/resumes";

interface Props {
  roles: Role[];
}
const { roles } = Astro.props;

const MONTHS: Record<string, number> = {
  january: 0, february: 1, march: 2, april: 3, may: 4, june: 5,
  july: 6, august: 7, september: 8, october: 9, november: 10, december: 11,
};

const now = new Date();
const nowIdx = now.getFullYear() * 12 + now.getMonth();

function tok(s: string) {
  const present = /present|current|now/i.test(s);
  const mo = s.toLowerCase().match(/([a-z]{3,})/);
  const yr = s.match(/(\d{4})/);
  return {
    present,
    month: mo && MONTHS[mo[1]] !== undefined ? MONTHS[mo[1]] : undefined,
    year: yr ? +yr[1] : undefined,
  };
}

function parseRange(dates: string): { start: number; end: number; present: boolean } | null {
  const parts = dates.split(/\s*[–—-]\s*/);
  if (parts.length < 2) return null;
  const a = tok(parts[0]);
  const b = tok(parts[1]);
  if (b.present) { b.year = now.getFullYear(); b.month = now.getMonth(); }
  if (a.year === undefined) a.year = b.year;
  if (b.year === undefined) b.year = a.year;
  if (a.year === undefined || b.year === undefined) return null;
  if (a.month === undefined) a.month = 0;
  if (b.month === undefined) b.month = b.present ? now.getMonth() : 11;
  return { start: a.year * 12 + a.month, end: b.year * 12 + b.month, present: b.present };
}

const parsed = roles
  .map((r) => ({ role: r, range: parseRange(r.dates) }))
  .filter((p): p is { role: Role; range: NonNullable<ReturnType<typeof parseRange>> } => !!p.range);

const hasTimeline = parsed.length >= 2;

// Range: Jan of the earliest year → one month past now, for clean year ticks.
const minStart = Math.min(...parsed.map((p) => p.range.start));
const startYear = Math.floor(minStart / 12);
const rangeStart = startYear * 12; // Jan of earliest year
const rangeEnd = nowIdx + 1;
const span = Math.max(1, rangeEnd - rangeStart);
const pct = (idx: number) => ((idx - rangeStart) / span) * 100;

const years: number[] = [];
for (let y = startYear; y <= now.getFullYear(); y++) years.push(y);

const fmtMonth = (idx: number) => {
  const y = Math.floor(idx / 12);
  const m = idx % 12;
  return `${["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"][m]} ${y}`;
};

// Newest role first (top row).
const rows = parsed
  .slice()
  .sort((a, b) => b.range.end - a.range.end || b.range.start - a.range.start);

const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
// Drop legal suffixes so short bars can show a clean label ("Raylu" not "Raylu, Inc.").
const shortCo = (s: string) => s.replace(/,?\s+(inc|llc|co|ltd|corp)\.?$/i, "");
---

{hasTimeline && (
  <div class="tl r-live" data-timeline>
    <div class="tl-head">
      <span class="tl-kicker">the shape of it</span>
      <span class="tl-span">to scale · {fmtMonth(minStart)} → present</span>
    </div>

    <div class="tl-chart" style={`--tl-rows:${rows.length}`}>
      <div class="tl-axis" aria-hidden="true">
        {years.map((y) => (
          <span class="tl-year" style={`left:${pct(y * 12)}%`}>{`'${String(y).slice(2)}`}</span>
        ))}
      </div>
      <div class="tl-plot">
        {years.map((y) => (
          <span class="tl-grid" style={`left:${pct(y * 12)}%`} aria-hidden="true"></span>
        ))}
        {rows.map((p, i) => (
          <button
            type="button"
            class:list={["tl-bar", { "is-present": p.range.present }]}
            style={`left:${pct(p.range.start)}%; width:${Math.max(2.2, pct(p.range.end) - pct(p.range.start))}%; top:calc(${i} * (var(--tl-rowh) + var(--tl-gap)))`}
            data-tl-bar={slug(p.role.company)}
            aria-label={`${p.role.company}, ${p.role.dates}`}
          >
            <span class="tl-bar-fill"></span>
            <span class="tl-bar-label">{shortCo(p.role.company)}</span>
            {p.range.present && <span class="tl-now" aria-hidden="true"></span>}
          </button>
        ))}
      </div>
    </div>
  </div>
)}

<script>
  import { onPlay, prefersReduced } from "./lib/motion";

  document.querySelectorAll<HTMLElement>("[data-timeline]").forEach((root) => {
    const bars = Array.from(root.querySelectorAll<HTMLElement>("[data-tl-bar]"));

    const play = () => {
      root.classList.add("is-drawn");
    };
    if (prefersReduced()) root.classList.add("is-drawn");
    else onPlay(root, play, { threshold: 0.4 });

    // Link a bar to its role card below.
    const card = (key: string) =>
      document.querySelector<HTMLElement>(`.role[data-company="${key}"]`);
    bars.forEach((bar) => {
      const key = bar.dataset.tlBar || "";
      const target = () => card(key);
      bar.addEventListener("mouseenter", () => target()?.classList.add("role-cued"));
      bar.addEventListener("mouseleave", () => target()?.classList.remove("role-cued"));
      bar.addEventListener("focus", () => target()?.classList.add("role-cued"));
      bar.addEventListener("blur", () => target()?.classList.remove("role-cued"));
      bar.addEventListener("click", () => {
        const t = target();
        if (!t) return;
        t.scrollIntoView({ behavior: prefersReduced() ? "auto" : "smooth", block: "center" });
        t.classList.add("role-flash");
        window.setTimeout(() => t.classList.remove("role-flash"), 1200);
      });
    });
  });
</script>

<style>
  .tl {
    --tl-rowh: 30px;
    --tl-gap: 8px;
    margin: 0 0 var(--space-6);
    padding: var(--space-4) var(--space-4) var(--space-5);
    border: 1px solid var(--line);
    border-radius: 8px;
    background: color-mix(in srgb, var(--surface-1) 55%, var(--bg));
  }
  .tl-head {
    display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-3);
    margin-bottom: var(--space-4); flex-wrap: wrap;
  }
  .tl-kicker {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.625rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--accent);
  }
  .tl-span {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.6875rem; color: var(--muted); font-variant-numeric: tabular-nums;
  }

  .tl-chart { position: relative; }
  .tl-axis { position: relative; height: 14px; margin-bottom: 6px; }
  .tl-year {
    position: absolute; top: 0; transform: translateX(-50%);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.5625rem; color: var(--muted);
  }
  .tl-plot {
    position: relative;
    height: calc(var(--tl-rows) * var(--tl-rowh) + (var(--tl-rows) - 1) * var(--tl-gap));
  }
  .tl-grid {
    position: absolute; top: 0; bottom: 0; width: 1px;
    background: color-mix(in srgb, var(--line) 70%, transparent);
  }

  .tl-bar {
    position: absolute;
    height: var(--tl-rowh);
    padding: 0;
    border: none;
    background: transparent;
    cursor: pointer;
    display: flex; align-items: center;
    border-radius: 6px;
    overflow: visible;
  }
  .tl-bar-fill {
    position: absolute; inset: 0;
    border-radius: 6px;
    background: color-mix(in srgb, var(--accent) 22%, var(--surface-1));
    border: 1px solid color-mix(in srgb, var(--accent) 45%, var(--line));
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 720ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .tl.is-drawn .tl-bar-fill { transform: scaleX(1); }
  .tl-bar:nth-child(2) .tl-bar-fill { transition-delay: 60ms; }
  .tl-bar:nth-child(3) .tl-bar-fill { transition-delay: 120ms; }
  .tl-bar:nth-child(4) .tl-bar-fill { transition-delay: 180ms; }
  .tl-bar.is-present .tl-bar-fill {
    background: color-mix(in srgb, var(--accent) 38%, var(--surface-1));
    border-color: var(--accent);
  }
  .tl-bar-label {
    position: relative; z-index: 1;
    padding: 0 9px;
    font-size: 0.6875rem; font-weight: var(--fw-semibold);
    color: var(--text);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    opacity: 0;
    transition: opacity 300ms ease 300ms;
  }
  .tl.is-drawn .tl-bar-label { opacity: 1; }
  .tl-bar:hover .tl-bar-fill { background: color-mix(in srgb, var(--accent) 32%, var(--surface-1)); border-color: var(--accent); }
  .tl-bar:hover { transform: translateY(-1px); }
  .tl-bar:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  .tl-now {
    position: absolute; right: -1px; top: -2px; bottom: -2px; width: 2px;
    background: var(--accent); border-radius: 2px;
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 60%, transparent);
    animation: tl-now-pulse 2.2s ease-in-out infinite;
  }
  @keyframes tl-now-pulse {
    0%, 100% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 55%, transparent); }
    50% { box-shadow: 0 0 6px 1px color-mix(in srgb, var(--accent) 45%, transparent); }
  }

  /* role-card cueing (the cards live in ResumeRenderer; classes applied here) */
  :global(.role.role-cued) {
    box-shadow: -10px 0 0 -8px var(--accent);
  }
  :global(.role.role-flash) {
    animation: tl-flash 1.2s ease;
  }
  @keyframes tl-flash {
    0%, 100% { background: transparent; }
    30% { background: color-mix(in srgb, var(--accent) 8%, transparent); }
  }

  @media (max-width: 32rem) {
    .tl { --tl-rowh: 26px; }
    .tl-bar-label { font-size: 0.625rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .tl-bar-fill, .tl-bar-label { transition: none !important; }
    .tl-now { animation: none; }
    .tl-bar:hover { transform: none; }
    :global(.role.role-flash) { animation: none; }
  }
</style>
