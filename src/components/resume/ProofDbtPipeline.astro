---
// PROOF — the CHS bullet: "parses the dbt API manifest into Excel, Power BI,
// and stakeholder briefs."
//
// What this module shows is the mechanism, not a mockup of the output. A dbt
// manifest excerpt (jaffle-shop-style, public sample names) goes into a real
// parser below: it filters model nodes, resolves depends_on refs to models,
// drops the source refs it cannot resolve, derives each model's depth by
// longest path, and returns the graph. Every number on screen and every column
// in the diagram comes out of that function. Nothing is hand-placed.
//
// Hovering a model runs a second computation in the browser: transitive
// upstream and downstream closure over the parsed edges, with the wires routed
// from measured node geometry. The three outputs are named as plain labels.
// The documents themselves are not shown, because the ones that matter are the
// company's and cannot be.

type ManifestModel = {
  name: string;
  resource_type: "model";
  config: { materialized: string };
  depends_on: { nodes: string[] };
};

// A faithful slice of a dbt manifest: unique_id keys, resource_type, config,
// and depends_on.nodes carrying both model and source refs (the parser has to
// tell them apart, which is most of the real work).
const manifest = {
  metadata: {
    project_name: "jaffle_shop",
    dbt_schema_version: "https://schemas.getdbt.com/dbt/manifest/v12.json",
  },
  sources: {
    "source.jaffle_shop.raw.customers": { name: "customers" },
    "source.jaffle_shop.raw.orders": { name: "orders" },
    "source.jaffle_shop.raw.payments": { name: "payments" },
  },
  nodes: {
    "model.jaffle_shop.stg_customers": {
      name: "stg_customers",
      resource_type: "model",
      config: { materialized: "view" },
      depends_on: { nodes: ["source.jaffle_shop.raw.customers"] },
    },
    "model.jaffle_shop.stg_orders": {
      name: "stg_orders",
      resource_type: "model",
      config: { materialized: "view" },
      depends_on: { nodes: ["source.jaffle_shop.raw.orders"] },
    },
    "model.jaffle_shop.stg_payments": {
      name: "stg_payments",
      resource_type: "model",
      config: { materialized: "view" },
      depends_on: { nodes: ["source.jaffle_shop.raw.payments"] },
    },
    "model.jaffle_shop.int_order_items": {
      name: "int_order_items",
      resource_type: "model",
      config: { materialized: "ephemeral" },
      depends_on: {
        nodes: ["model.jaffle_shop.stg_orders", "model.jaffle_shop.stg_payments"],
      },
    },
    "model.jaffle_shop.fct_orders": {
      name: "fct_orders",
      resource_type: "model",
      config: { materialized: "table" },
      depends_on: {
        nodes: ["model.jaffle_shop.int_order_items", "model.jaffle_shop.stg_customers"],
      },
    },
    "model.jaffle_shop.dim_customers": {
      name: "dim_customers",
      resource_type: "model",
      config: { materialized: "table" },
      depends_on: {
        nodes: ["model.jaffle_shop.stg_customers", "model.jaffle_shop.int_order_items"],
      },
    },
  } as Record<string, ManifestModel>,
};

type ParsedModel = {
  name: string;
  materialized: string;
  deps: string[];
  depth: number;
};

/** The parse: manifest object in, dependency graph out. */
function parseManifest(m: typeof manifest) {
  const modelEntries = Object.entries(m.nodes).filter(
    ([, n]) => n.resource_type === "model"
  );
  // unique_id -> model name, so depends_on refs can be resolved. Anything that
  // is not in this map (sources, tests, seeds) is not a model edge.
  const nameByUid = new Map(modelEntries.map(([uid, n]) => [uid, n.name]));

  const parents = new Map<string, string[]>();
  for (const [, n] of modelEntries) {
    parents.set(
      n.name,
      n.depends_on.nodes
        .filter((uid) => nameByUid.has(uid))
        .map((uid) => nameByUid.get(uid) as string)
    );
  }

  const edges: { from: string; to: string }[] = [];
  for (const [child, ps] of parents) {
    for (const p of ps) edges.push({ from: p, to: child });
  }

  // depth = longest path back to a model with no model parents
  const seen = new Map<string, number>();
  const depthOf = (name: string): number => {
    const hit = seen.get(name);
    if (hit !== undefined) return hit;
    seen.set(name, 0); // cycle guard
    const d = (parents.get(name) ?? []).reduce(
      (mx, p) => Math.max(mx, depthOf(p) + 1),
      0
    );
    seen.set(name, d);
    return d;
  };

  const models: ParsedModel[] = modelEntries.map(([, n]) => ({
    name: n.name,
    materialized: n.config.materialized,
    deps: parents.get(n.name) ?? [],
    depth: depthOf(n.name),
  }));

  const layerCount = models.reduce((mx, mm) => Math.max(mx, mm.depth), 0) + 1;
  const columns: ParsedModel[][] = Array.from({ length: layerCount }, (_, d) =>
    models.filter((mm) => mm.depth === d)
  );

  return {
    models,
    edges,
    columns,
    stats: { models: models.length, edges: edges.length, layers: layerCount },
  };
}

const graph = parseManifest(manifest);
const { columns, edges, stats } = graph;
---

<div class="pf pf-dbt" data-proof="dbt">
  <div class="pf-head">
    <span class="pf-kicker">the mechanism, on sample data</span>
    <h4 class="pf-title">One manifest in, three documents out</h4>
    <p class="pf-sub">sample models; the real one runs on the company manifest</p>
  </div>

  <div class="pf-strip">
    <code class="pf-strip-file">manifest.json</code>
    <span class="pf-strip-tag">jaffle-shop sample</span>
    <span class="pf-strip-arrow" aria-hidden="true">→</span>
    <code class="pf-strip-step">parse</code>
    <span class="pf-strip-arrow" aria-hidden="true">→</span>
    <span class="pf-strip-out">
      {stats.models} models · {stats.edges} edges · {stats.layers} layers
    </span>
  </div>

  <div class="pf-dag" data-dag style={`--pd-cols:${columns.length}`}>
    <svg class="pf-wires" data-wires preserveAspectRatio="none" aria-hidden="true">
      {edges.map((e) => (
        <path class="pf-wire" data-from={e.from} data-to={e.to} fill="none" />
      ))}
    </svg>

    {columns.map((col, i) => (
      <div class="pf-col">
        <span class="pf-depth">depth {i}</span>
        <div class="pf-stack">
          {col.map((m) => (
            <button
              type="button"
              class="pf-node"
              data-node={m.name}
              data-deps={m.deps.join(",")}
              aria-pressed="false"
            >
              <span class="pf-node-name">{m.name}</span>
              <span class="pf-node-mat">{m.materialized}</span>
            </button>
          ))}
        </div>
      </div>
    ))}
  </div>

  <p class="pf-readout" data-readout aria-live="polite">
    <span class="pf-read-idle" data-r-idle>hover a model to trace its lineage</span>
    <span class="pf-read-trace">
      <span class="pf-read-name" data-r-name></span>
      <span class="pf-read-arrow" aria-hidden="true">←</span>
      <span class="pf-read-deps" data-r-deps></span>
      <span class="pf-read-count" data-r-count></span>
    </span>
  </p>

  <div class="pf-out">
    <span class="pf-out-label">fans out to</span>
    <span class="pf-chip">Excel</span>
    <span class="pf-chip">Power BI</span>
    <span class="pf-chip">briefs</span>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-proof="dbt"]').forEach((root) => {
    const dag = root.querySelector<HTMLElement>("[data-dag]");
    const svg = root.querySelector<SVGSVGElement>("[data-wires]");
    const nodes = Array.from(root.querySelectorAll<HTMLElement>("[data-node]"));
    const wires = Array.from(root.querySelectorAll<SVGPathElement>(".pf-wire"));
    const rName = root.querySelector<HTMLElement>("[data-r-name]");
    const rDeps = root.querySelector<HTMLElement>("[data-r-deps]");
    const rCount = root.querySelector<HTMLElement>("[data-r-count]");
    if (!dag || !svg) return;

    // Rebuild the adjacency the parser produced, then walk it both ways.
    const parents = new Map<string, string[]>();
    nodes.forEach((n) => {
      const id = n.dataset.node || "";
      parents.set(id, (n.dataset.deps || "").split(",").filter(Boolean));
    });
    const children = new Map<string, string[]>();
    parents.forEach((ps, child) => {
      ps.forEach((p) => children.set(p, [...(children.get(p) ?? []), child]));
    });

    const closure = (start: string, map: Map<string, string[]>) => {
      const out = new Set<string>();
      const stack = [...(map.get(start) ?? [])];
      while (stack.length) {
        const n = stack.pop() as string;
        if (out.has(n)) continue;
        out.add(n);
        stack.push(...(map.get(n) ?? []));
      }
      return out;
    };

    // ── wires: routed from measured geometry, redrawn whenever the box moves ──
    const round = (v: number) => Math.round(v * 10) / 10;
    const draw = () => {
      const box = dag.getBoundingClientRect();
      if (box.width < 40 || box.height < 24) return; // panel still folded
      svg.setAttribute("viewBox", `0 0 ${round(box.width)} ${round(box.height)}`);
      wires.forEach((w) => {
        const a = nodes.find((n) => n.dataset.node === w.dataset.from);
        const b = nodes.find((n) => n.dataset.node === w.dataset.to);
        if (!a || !b) return;
        const ra = a.getBoundingClientRect();
        const rb = b.getBoundingClientRect();
        const acx = ra.left + ra.width / 2;
        const bcx = rb.left + rb.width / 2;
        const acy = ra.top + ra.height / 2;
        const bcy = rb.top + rb.height / 2;
        let d: string;
        if (Math.abs(bcx - acx) >= Math.abs(bcy - acy)) {
          // columns side by side: leave the right edge, arrive at the left
          const x1 = round(ra.right - box.left);
          const y1 = round(acy - box.top);
          const x2 = round(rb.left - box.left);
          const y2 = round(bcy - box.top);
          const dx = Math.max(14, (x2 - x1) * 0.5);
          d = `M${x1} ${y1} C${round(x1 + dx)} ${y1} ${round(x2 - dx)} ${y2} ${x2} ${y2}`;
        } else {
          // stacked (narrow): leave the bottom, arrive at the top
          const x1 = round(acx - box.left);
          const y1 = round(ra.bottom - box.top);
          const x2 = round(bcx - box.left);
          const y2 = round(rb.top - box.top);
          const dy = Math.max(10, (y2 - y1) * 0.5);
          d = `M${x1} ${y1} C${x1} ${round(y1 + dy)} ${x2} ${round(y2 - dy)} ${x2} ${y2}`;
        }
        w.setAttribute("d", d);
      });
      dag.setAttribute("data-wired", "true");
    };

    // ── lineage: light the upstream chain, report both directions ──
    const apply = (name: string | null) => {
      if (!name) {
        root.classList.remove("is-tracing");
        nodes.forEach((n) => n.classList.remove("is-target", "is-up", "is-off"));
        wires.forEach((w) => w.classList.remove("is-lit", "is-off"));
        return;
      }
      const up = closure(name, parents);
      const down = closure(name, children);
      const lit = new Set([name, ...up]);

      nodes.forEach((n) => {
        const id = n.dataset.node || "";
        n.classList.toggle("is-target", id === name);
        n.classList.toggle("is-up", id !== name && up.has(id));
        n.classList.toggle("is-off", !lit.has(id));
      });
      wires.forEach((w) => {
        const on = lit.has(w.dataset.from || "") && lit.has(w.dataset.to || "");
        w.classList.toggle("is-lit", on);
        w.classList.toggle("is-off", !on);
      });

      const deps = parents.get(name) ?? [];
      if (rName) rName.textContent = name;
      if (rDeps) rDeps.textContent = deps.length ? deps.join(", ") : "a raw source";
      if (rCount) rCount.textContent = `${up.size} upstream · ${down.size} downstream`;
      root.classList.add("is-tracing");
    };

    let pinned: string | null = null;
    nodes.forEach((n) => {
      const id = n.dataset.node || "";
      n.addEventListener("pointerenter", () => apply(id));
      n.addEventListener("pointerleave", () => apply(pinned));
      n.addEventListener("focus", () => apply(id));
      n.addEventListener("blur", () => apply(pinned));
      n.addEventListener("click", () => {
        pinned = pinned === id ? null : id;
        nodes.forEach((o) =>
          o.setAttribute("aria-pressed", String(o.dataset.node === pinned))
        );
        apply(pinned ?? id);
      });
    });

    // The panel unfolds from display:none, so measure on the resize that
    // reveals it (and again once webfonts settle the node widths).
    if (typeof ResizeObserver !== "undefined") {
      new ResizeObserver(() => draw()).observe(dag);
    }
    window.addEventListener("resize", draw);
    root.addEventListener("play", draw);
    document.fonts?.ready.then(() => draw());
    draw();
  });
</script>

<style>
  /* The module renders inside the sheet's dark panel, so it carries its own
     ink and never inherits the paper's light tokens. */
  .pf.pf-dbt {
    --pd-ink: #e8edf4;
    --pd-dim: #93a0b1;
    --pd-faint: #6b7686;
    --pd-line: rgba(160, 190, 230, 0.14);
    --pd-well: #0c0e12;
    --pd-chip: #14181f;
    --pd-cy: #0ec4fc;
    --pd-mono: "IBM Plex Mono", ui-monospace, monospace;

    display: flex;
    flex-direction: column;
    gap: 14px;
    color: var(--pd-ink);
    font-weight: 400;
  }

  /* ── head ── */
  .pf-head { display: flex; flex-direction: column; gap: 5px; }
  .pf-kicker {
    font-family: var(--pd-mono);
    font-size: 0.625rem;
    letter-spacing: 0.16em;
    color: var(--pd-cy);
  }
  .pf-title {
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--pd-ink);
  }
  .pf-sub {
    margin: 0;
    font-family: var(--pd-mono);
    font-size: 0.625rem;
    line-height: 1.5;
    color: var(--pd-faint);
  }

  /* ── the mechanism, one line ── */
  .pf-strip {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    padding: 7px 10px;
    border: 1px solid var(--pd-line);
    border-radius: 5px;
    background: var(--pd-well);
    font-family: var(--pd-mono);
    font-size: 0.6875rem;
    color: var(--pd-dim);
  }
  .pf-strip-file { color: var(--pd-ink); }
  .pf-strip-step { color: var(--pd-ink); }
  .pf-strip-tag { font-size: 0.5625rem; color: var(--pd-faint); }
  .pf-strip-arrow { color: var(--pd-faint); }
  .pf-strip-out { color: var(--pd-cy); font-variant-numeric: tabular-nums; }

  /* ── the graph ── */
  .pf-dag {
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--pd-cols, 3), minmax(0, 1fr));
    gap: 0 clamp(30px, 7%, 68px);
    align-items: stretch;
    padding: 12px 2px 14px;
  }
  /* addressed through .pf-dag so the rules never depend on the scope
     attribute landing on SVG children */
  .pf-dag .pf-wires {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    opacity: 0;
    transition: opacity 260ms ease;
  }
  .pf-dag[data-wired="true"] .pf-wires { opacity: 1; }
  .pf-dag .pf-wire {
    stroke: rgba(160, 190, 230, 0.22);
    stroke-width: 1;
    transition: stroke 180ms ease, stroke-width 180ms ease, opacity 180ms ease;
  }
  .pf-dag .pf-wire.is-lit { stroke: var(--pd-cy); stroke-width: 1.6; }
  .pf-dag .pf-wire.is-off { opacity: 0.18; }

  .pf-col { position: relative; z-index: 1; display: flex; flex-direction: column; gap: 8px; }
  .pf-depth {
    font-family: var(--pd-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.1em;
    color: var(--pd-faint);
  }
  .pf-stack {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 8px;
  }

  .pf-node {
    appearance: none;
    display: flex;
    flex-direction: column;
    gap: 2px;
    width: 100%;
    padding: 6px 8px;
    text-align: left;
    border: 1px solid var(--pd-line);
    border-radius: 5px;
    background: var(--pd-chip);
    color: var(--pd-ink);
    cursor: pointer;
    transition: border-color 180ms ease, background 180ms ease, color 180ms ease,
      opacity 180ms ease;
  }
  .pf-node-name {
    font-family: var(--pd-mono);
    font-size: 0.6875rem;
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .pf-node-mat {
    font-family: var(--pd-mono);
    font-size: 0.5rem;
    letter-spacing: 0.08em;
    color: var(--pd-faint);
  }
  .pf-node:hover { border-color: rgba(14, 196, 252, 0.45); }
  .pf-node.is-up {
    border-color: rgba(14, 196, 252, 0.45);
    color: var(--pd-ink);
  }
  .pf-node.is-target {
    border-color: var(--pd-cy);
    background: rgba(14, 196, 252, 0.1);
  }
  .pf-node.is-target .pf-node-name { color: var(--pd-cy); }
  .pf-node.is-off { opacity: 0.3; }
  .pf-node:focus-visible {
    outline: 1px solid var(--pd-cy);
    outline-offset: 2px;
  }

  /* ── readout ── */
  .pf-readout {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 6px 10px;
    min-height: 1.15rem;
    margin: 0;
    padding-top: 10px;
    border-top: 1px solid var(--pd-line);
    font-family: var(--pd-mono);
    font-size: 0.625rem;
    line-height: 1.15rem;
    color: var(--pd-dim);
  }
  .pf-read-idle { color: var(--pd-faint); }
  .pf-read-trace { display: none; align-items: baseline; flex-wrap: wrap; gap: 6px; }
  .pf-dbt.is-tracing .pf-read-idle { display: none; }
  .pf-dbt.is-tracing .pf-read-trace { display: inline-flex; }
  .pf-read-name { color: var(--pd-cy); }
  .pf-read-arrow { color: var(--pd-faint); }
  .pf-read-deps { color: var(--pd-ink); }
  .pf-read-count { color: var(--pd-dim); font-variant-numeric: tabular-nums; }
  .pf-read-count::before { content: "·"; margin-right: 8px; color: var(--pd-faint); }

  /* ── the three destinations, named plainly ── */
  .pf-out {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    font-family: var(--pd-mono);
    font-size: 0.625rem;
  }
  .pf-out-label { color: var(--pd-faint); letter-spacing: 0.1em; }
  .pf-chip {
    padding: 4px 9px;
    border: 1px solid var(--pd-line);
    border-radius: 999px;
    background: var(--pd-chip);
    color: var(--pd-ink);
    font-size: 0.625rem;
  }

  /* Stacked fallback: one column, so a wire between two boxes would run
     straight down behind the boxes between them and say nothing. The depth
     headings carry the flow instead; the lineage highlight still works. */
  @media (max-width: 34rem) {
    .pf-dag { grid-template-columns: 1fr; gap: 14px 0; }
    .pf-stack { justify-content: flex-start; }
    .pf-dag .pf-wires { display: none; }
  }

  /* Reduced motion: nothing eases in, every state is its settled one. */
  @media (prefers-reduced-motion: reduce) {
    .pf-dag .pf-wires,
    .pf-dag .pf-wire,
    .pf-node { transition: none !important; }
    .pf-dag .pf-wires { opacity: 1; }
  }
</style>
