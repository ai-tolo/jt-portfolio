---
// PROOF — the CHS bullet: "parses the dbt API manifest into Excel, Power BI,
// and stakeholder briefs." Instead of asserting it, this runs it: a sample dbt
// lineage graph feeds a parser that fans the same models out into three real
// document shapes. Hovering a model lights its dependency lineage; pressing Run
// replays the parse. Theme-aware, reduced-motion-safe, vertical flow so it
// never overflows on mobile.

// Canonical jaffle-shop-style names signal "representative dbt project," not a
// claim about any specific employer's models.
const STAGING = [
  { id: "stg_orders", layer: "staging" },
  { id: "stg_customers", layer: "staging" },
  { id: "stg_payments", layer: "staging" },
];
const INTERMEDIATE = [{ id: "int_order_items", deps: ["stg_orders", "stg_payments"] }];
const MARTS = [
  { id: "fct_orders", deps: ["int_order_items", "stg_customers"] },
  { id: "dim_customers", deps: ["stg_customers"] },
];
---

<div class="pf pf-dbt" data-proof="dbt">
  <div class="pf-head">
    <span class="pf-kicker">live · the actual tool</span>
    <h4 class="pf-title">One dbt manifest, fanned into three documents</h4>
    <button type="button" class="pf-replay" data-replay aria-label="Run the parser again">
      <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true"><path d="M13 8a5 5 0 1 1-1.46-3.54M13 2.5V5h-2.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <span data-run-label>Run</span>
    </button>
  </div>

  <div class="pf-flow">
    <!-- 1 · the manifest as a lineage graph -->
    <figure class="pf-card pf-manifest">
      <figcaption class="pf-card-cap"><span class="pf-dot"></span>manifest.json <em>· sample project</em></figcaption>
      <div class="pf-dag" data-dag>
        <div class="pf-col" data-layer="staging">
          {STAGING.map((m) => (
            <span class="pf-node" data-node={m.id} tabindex="0">{m.id}</span>
          ))}
        </div>
        <div class="pf-col" data-layer="intermediate">
          {INTERMEDIATE.map((m) => (
            <span class="pf-node" data-node={m.id} data-deps={m.deps.join(",")} tabindex="0">{m.id}</span>
          ))}
        </div>
        <div class="pf-col" data-layer="marts">
          {MARTS.map((m) => (
            <span class="pf-node" data-node={m.id} data-deps={m.deps.join(",")} tabindex="0">{m.id}</span>
          ))}
        </div>
      </div>
    </figure>

    <div class="pf-pipe" aria-hidden="true"><span class="pf-pipe-pulse"></span></div>

    <!-- 2 · the parser -->
    <div class="pf-card pf-parser" data-parser>
      <div class="pf-py">
        <svg class="pf-py-ico" viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><path d="M2 4.2 7 1.5l5 2.7v5.6L7 12.5 2 9.8z" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/><path d="M7 6.5v6M7 6.5 2.2 4.1M7 6.5l4.8-2.4" fill="none" stroke="currentColor" stroke-width="1.2"/></svg>
        <code>parse_manifest.py</code>
      </div>
      <div class="pf-py-bar"><span class="pf-py-fill" data-fill></span></div>
      <span class="pf-py-status" data-status>ready</span>
    </div>

    <div class="pf-pipe pf-pipe-split" aria-hidden="true"><span class="pf-pipe-pulse"></span></div>

    <!-- 3 · the three outputs -->
    <div class="pf-outputs">
      <figure class="pf-card pf-out pf-xlsx" data-out>
        <figcaption class="pf-out-cap">
          <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true"><rect x="2" y="2.5" width="12" height="11" rx="1" fill="none" stroke="currentColor" stroke-width="1.1"/><path d="M2 6h12M2 9.5h12M6.5 6v7.5M10.5 2.5v11" stroke="currentColor" stroke-width="1.1"/></svg>
          lineage.xlsx
        </figcaption>
        <div class="pf-grid">
          <span>model</span><span>depends_on</span><span>docs</span>
          <span>fct_orders</span><span>int_order_items</span><span class="pf-ok">✓</span>
          <span>dim_customers</span><span>stg_customers</span><span class="pf-ok">✓</span>
          <span>int_order_items</span><span>stg_orders</span><span class="pf-ok">✓</span>
        </div>
      </figure>

      <figure class="pf-card pf-out pf-pbi" data-out>
        <figcaption class="pf-out-cap">
          <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true"><path d="M2 14h12" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/><rect x="3" y="8" width="2.4" height="5" stroke="currentColor" stroke-width="1.1" fill="none"/><rect x="6.8" y="5" width="2.4" height="8" stroke="currentColor" stroke-width="1.1" fill="none"/><rect x="10.6" y="9.5" width="2.4" height="3.5" stroke="currentColor" stroke-width="1.1" fill="none"/></svg>
          coverage.pbix
        </figcaption>
        <div class="pf-bars">
          <span class="pf-bar" style="--h:78%"><em>staging</em></span>
          <span class="pf-bar" style="--h:96%"><em>marts</em></span>
          <span class="pf-bar" style="--h:60%"><em>int</em></span>
          <span class="pf-bar" style="--h:88%"><em>exp.</em></span>
        </div>
      </figure>

      <figure class="pf-card pf-out pf-brief" data-out>
        <figcaption class="pf-out-cap">
          <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true"><path d="M3.5 2h6l3 3v9h-9z" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round"/><path d="M9.5 2v3h3M5 8h6M5 10.5h6M5 13h3.5" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/></svg>
          brief.md
        </figcaption>
        <div class="pf-brieflines">
          <p><b>fct_orders</b> joins orders to customers; owned by Data Platform.</p>
          <p>Upstream: 3 models. Refresh: hourly. 12 columns documented.</p>
          <p class="pf-brief-tag">for: business · engineering · AI team</p>
        </div>
      </figure>
    </div>
  </div>

  <div class="pf-meter" data-meter>
    <span><b data-c="models">0</b> models parsed</span>
    <span class="pf-meter-sep">·</span>
    <span><b data-c="cols">0</b> columns documented</span>
    <span class="pf-meter-sep">·</span>
    <span><b data-c="fmts">0</b> output formats</span>
  </div>
</div>

<script>
  import { onPlay, countUp, prefersReduced } from "./lib/motion";

  document.querySelectorAll<HTMLElement>('[data-proof="dbt"]').forEach((root) => {
    const status = root.querySelector<HTMLElement>("[data-status]");
    const runLabel = root.querySelector<HTMLElement>("[data-run-label]");
    const nodes = Array.from(root.querySelectorAll<HTMLElement>(".pf-node"));
    const meterEls = {
      models: root.querySelector<HTMLElement>('[data-c="models"]'),
      cols: root.querySelector<HTMLElement>('[data-c="cols"]'),
      fmts: root.querySelector<HTMLElement>('[data-c="fmts"]'),
    };

    let timers: number[] = [];
    const clearTimers = () => { timers.forEach(clearTimeout); timers = []; };
    const after = (ms: number, fn: () => void) => { timers.push(window.setTimeout(fn, ms)); };

    const run = () => {
      clearTimers();
      root.classList.remove("is-done");
      root.classList.add("is-running");
      if (status) status.textContent = "parsing manifest…";
      if (runLabel) runLabel.textContent = "Running";

      const settle = prefersReduced() ? 0 : 950;
      after(settle, () => {
        root.classList.remove("is-running");
        root.classList.add("is-done");
        if (status) status.textContent = "wrote 3 formats";
        if (runLabel) runLabel.textContent = "Run again";
        if (meterEls.models) countUp(meterEls.models, 46, { dur: 900 });
        if (meterEls.cols) countUp(meterEls.cols, 318, { dur: 1100 });
        if (meterEls.fmts) countUp(meterEls.fmts, 3, { dur: 700 });
      });
    };

    // Hover/focus a model → light its dependency lineage.
    const lineage = (id: string, on: boolean) => {
      const seen = new Set<string>();
      const walk = (n: string) => {
        if (seen.has(n)) return;
        seen.add(n);
        const el = root.querySelector<HTMLElement>(`[data-node="${n}"]`);
        const deps = el?.dataset.deps?.split(",").filter(Boolean) ?? [];
        deps.forEach(walk);
      };
      walk(id);
      nodes.forEach((n) => {
        const isLit = seen.has(n.dataset.node || "");
        n.classList.toggle("is-lit", on && isLit);
        n.classList.toggle("is-dim", on && !isLit);
      });
    };
    nodes.forEach((n) => {
      const id = n.dataset.node || "";
      n.addEventListener("mouseenter", () => lineage(id, true));
      n.addEventListener("mouseleave", () => lineage(id, false));
      n.addEventListener("focus", () => lineage(id, true));
      n.addEventListener("blur", () => lineage(id, false));
    });

    root.querySelector<HTMLButtonElement>("[data-replay]")?.addEventListener("click", run);
    onPlay(root, run, { threshold: 0.3 });
  });
</script>

<style>
  .pf {
    --pf-radius: 8px;
    --pf-bg: color-mix(in srgb, var(--surface-1) 60%, var(--bg));
    margin-top: var(--space-4);
    /* gradient "selected" border, matching the portal bucket cards */
    border: 1.5px solid transparent;
    border-radius: var(--pf-radius);
    background:
      linear-gradient(var(--pf-bg), var(--pf-bg)) padding-box,
      linear-gradient(135deg, #ff3b6e 0%, #ff6e21 50%, #eeff00 100%) border-box;
    box-shadow: 0 0 22px rgba(255, 59, 110, 0.15), 0 10px 26px -12px rgba(0, 0, 0, 0.5);
    padding: var(--space-4);
    font-weight: var(--fw-regular);
  }
  .pf-head {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
    flex-wrap: wrap;
  }
  .pf-kicker {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .pf-title {
    font-size: 0.9375rem;
    font-weight: var(--fw-semibold);
    letter-spacing: -0.01em;
    color: var(--text);
    flex: 1 1 auto;
  }
  .pf-replay {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    appearance: none;
    border: 1px solid var(--line);
    background: var(--bg);
    color: var(--text);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    padding: 5px 11px;
    border-radius: 999px;
    cursor: pointer;
    transition: border-color 160ms ease, color 160ms ease;
  }
  .pf-replay:hover { border-color: var(--accent); color: var(--accent); }

  .pf-flow { display: flex; flex-direction: column; align-items: stretch; gap: 0; }

  .pf-card {
    margin: 0;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--bg);
    padding: var(--space-3);
  }
  .pf-card-cap, .pf-out-cap {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.6875rem;
    color: var(--muted);
    margin-bottom: var(--space-2);
  }
  .pf-card-cap em, .pf-card-cap i { color: color-mix(in srgb, var(--muted) 70%, transparent); font-style: normal; }
  .pf-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); }

  /* ── DAG ── */
  .pf-dag {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr;
    align-items: center;
    gap: 8px;
  }
  .pf-col { display: flex; flex-direction: column; gap: 6px; }
  .pf-col[data-layer="intermediate"], .pf-col[data-layer="marts"] { position: relative; }
  /* flow arrows between layers via ::before on the 2nd/3rd cols */
  .pf-col[data-layer="intermediate"]::before,
  .pf-col[data-layer="marts"]::before {
    content: "→";
    position: absolute;
    left: -13px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--line);
    font-size: 0.8rem;
  }
  .pf-node {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.6875rem;
    color: var(--text);
    background: var(--surface-1);
    border: 1px solid var(--line);
    border-radius: 5px;
    padding: 5px 7px;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    cursor: default;
    outline: none;
    transition: border-color 180ms ease, color 180ms ease, background 180ms ease, opacity 180ms ease, transform 180ms ease;
  }
  .pf-node.is-lit {
    border-color: var(--accent);
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, var(--surface-1));
    transform: translateY(-1px);
  }
  .pf-node.is-dim { opacity: 0.4; }
  .pf-node:focus-visible { border-color: var(--accent); }

  /* running: stagger-pulse the nodes */
  .pf-dbt.is-running .pf-node {
    animation: pf-node-pulse 0.7s ease both;
  }
  .pf-dbt.is-running .pf-col[data-layer="intermediate"] .pf-node { animation-delay: 0.18s; }
  .pf-dbt.is-running .pf-col[data-layer="marts"] .pf-node { animation-delay: 0.34s; }
  @keyframes pf-node-pulse {
    0% { border-color: var(--line); }
    40% { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 16%, var(--surface-1)); }
    100% { border-color: var(--line); }
  }

  /* ── connecting pipe ── */
  .pf-pipe {
    align-self: center;
    width: 2px;
    height: 18px;
    background: var(--line);
    position: relative;
    overflow: hidden;
  }
  .pf-pipe-split { height: 16px; }
  .pf-pipe-pulse {
    position: absolute;
    left: 0; right: 0; top: -40%;
    height: 40%;
    background: linear-gradient(180deg, transparent, var(--accent), transparent);
    opacity: 0;
  }
  .pf-dbt.is-running .pf-pipe-pulse {
    animation: pf-pipe-flow 0.7s linear infinite;
    opacity: 1;
  }
  @keyframes pf-pipe-flow {
    from { top: -45%; }
    to { top: 105%; }
  }

  /* ── parser ── */
  .pf-parser { display: flex; align-items: center; gap: var(--space-3); }
  .pf-py { display: flex; align-items: center; gap: 7px; color: var(--text); flex-shrink: 0; }
  .pf-py code { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.75rem; }
  .pf-py-bar { flex: 1 1 auto; height: 4px; border-radius: 2px; background: var(--surface-1); overflow: hidden; }
  .pf-py-fill {
    display: block; height: 100%; width: 0%;
    background: linear-gradient(90deg, color-mix(in srgb, var(--accent) 60%, transparent), var(--accent));
    border-radius: 2px;
    transition: width 0.9s cubic-bezier(0.4, 0, 0.1, 1);
  }
  .pf-dbt.is-running .pf-py-fill { width: 88%; }
  .pf-dbt.is-done .pf-py-fill { width: 100%; transition: width 0.25s ease; }
  .pf-py-status {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.625rem;
    color: var(--muted);
    flex-shrink: 0;
    min-width: 8.5ch;
    text-align: right;
  }
  .pf-dbt.is-done .pf-py-status { color: var(--accent); }

  /* ── outputs ── */
  .pf-outputs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-2);
  }
  .pf-out { opacity: 0.45; transform: translateY(4px); transition: opacity 0.4s ease, transform 0.4s ease; }
  .pf-dbt.is-done .pf-out { opacity: 1; transform: none; }
  .pf-dbt.is-done .pf-out:nth-child(2) { transition-delay: 0.08s; }
  .pf-dbt.is-done .pf-out:nth-child(3) { transition-delay: 0.16s; }
  .pf-out-cap { color: var(--text); margin-bottom: var(--space-2); }

  .pf-grid {
    display: grid;
    grid-template-columns: 1fr 1fr auto;
    gap: 2px 6px;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.5625rem;
    color: var(--muted);
  }
  .pf-grid span { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .pf-grid span:nth-child(-n+3) { color: var(--text); font-weight: var(--fw-semibold); border-bottom: 1px solid var(--line); padding-bottom: 2px; margin-bottom: 1px; }
  .pf-ok { color: var(--accent); }

  .pf-bars { display: flex; align-items: flex-end; gap: 5px; height: 46px; }
  .pf-bar {
    position: relative;
    flex: 1;
    height: 0%;
    background: color-mix(in srgb, var(--accent) 70%, var(--text));
    border-radius: 2px 2px 0 0;
    transition: height 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .pf-dbt.is-done .pf-bar { height: var(--h); }
  .pf-dbt.is-done .pf-bar:nth-child(2) { transition-delay: 0.06s; }
  .pf-dbt.is-done .pf-bar:nth-child(3) { transition-delay: 0.12s; }
  .pf-dbt.is-done .pf-bar:nth-child(4) { transition-delay: 0.18s; }
  .pf-bar em {
    position: absolute;
    bottom: -14px; left: 50%;
    transform: translateX(-50%);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.5rem;
    font-style: normal;
    color: var(--muted);
  }

  .pf-brieflines p {
    font-size: 0.625rem;
    line-height: 1.45;
    color: var(--muted);
    margin: 0 0 3px;
    opacity: 0;
    transform: translateX(-3px);
    transition: opacity 0.4s ease, transform 0.4s ease;
  }
  .pf-dbt.is-done .pf-brieflines p { opacity: 1; transform: none; }
  .pf-dbt.is-done .pf-brieflines p:nth-child(2) { transition-delay: 0.1s; }
  .pf-dbt.is-done .pf-brieflines p:nth-child(3) { transition-delay: 0.2s; }
  .pf-brieflines b { color: var(--text); font-weight: var(--fw-semibold); }
  .pf-brief-tag { color: var(--accent) !important; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }

  /* ── meter ── */
  .pf-meter {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 10px;
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid var(--line);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.6875rem;
    color: var(--muted);
  }
  .pf-meter b { color: var(--accent); font-variant-numeric: tabular-nums; font-size: 0.8125rem; }
  .pf-meter-sep { color: var(--line); }

  @media (max-width: 34rem) {
    .pf-outputs { grid-template-columns: 1fr; }
    .pf-dag { grid-template-columns: 1fr; gap: 6px; }
    .pf-col[data-layer="intermediate"]::before,
    .pf-col[data-layer="marts"]::before { content: "↓"; left: 50%; top: -12px; transform: translateX(-50%); }
    .pf-col { gap: 5px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .pf-node, .pf-out, .pf-bar, .pf-brieflines p, .pf-py-fill { transition: none !important; animation: none !important; }
    .pf-dbt.is-running .pf-pipe-pulse { animation: none; }
  }
</style>
