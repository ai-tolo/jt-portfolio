---
// The one-page résumé sheet. On screen it is /resume's paper view; in print
// it is the ONLY thing on the page (the page chrome, marks, and dock hide).
// All prose comes from src/lib/resume-print.ts (the single source; the old
// Notion-driven screen résumé is retired). The PDF asset is a headless-Chrome
// print of this sheet; regenerate it after any content change.
//
// ATS contract (verified with headless Chrome + pypdf, do not regress):
// - STATIC Geist, not the variable build. Chrome's PDF export of variable
//   fonts compensates instanced advance widths with per-glyph offsets that
//   text extractors read as spurious spaces ("m astering").
// - No position:absolute/relative and no opacity<1 on text: both force a
//   later paint phase and scramble the PDF text stream out of reading order.
//   Bullets are normal-flow hanging indents (inline-block ::before marker
//   with negative margin).
// - letter-spacing on headings stays <= 0.12em; 0.15em tracking extracts
//   with injected spaces and breaks ATS section-heading matching.
// - Kerning/ligatures off: their advance adjustments also read back as
//   spaces in extraction.
import "@fontsource/geist/latin-400.css";
import "@fontsource/geist/latin-500.css";
import "@fontsource/geist/latin-600.css";
import "@fontsource/geist/latin-700.css";
import { printContent as c } from "../../lib/resume-print";

const isUrl = (s: string) => /^[a-z0-9.-]+\.[a-z]{2,}(\/|$)/i.test(s) && !s.includes("@") && !/^\(/.test(s);
const isEmail = (s: string) => s.includes("@");
const isPhone = (s: string) => /^\(?\d{3}\)?[\s.-]?\d{3}[\s.-]?\d{4}$/.test(s.trim());
---

<div class="print-resume">
  <header class="pr-header">
    <div class="pr-name-row">
      <div class="pr-name">{c.name}</div>
      <div class="pr-role">{c.title}</div>
    </div>
    {/* Contact policy (Jon, 2026-09-21): phone is PRINT-ONLY (its separator
        hides with it, so no capture path can read a doubled dot); no
        LinkedIn on the sheet, the page's actions row and floor carry the
        icon. Every item is a real text node, so DOM and PDF extraction read
        the same line. */}
    <div class="pr-contact">
      {c.contact.map((item, i) => {
        const phone = isPhone(item);
        return (
          <span class={phone ? "pr-ct pr-print-only" : "pr-ct"}>
            {i > 0 && <span class="pr-ct-sep"> · </span>}
            {isUrl(item) ? <a href={`https://www.${item.replace(/^www\./, "")}`}>{item}</a>
              : isEmail(item) ? <a href={`mailto:${item}`}>{item}</a>
              : phone ? <a href={`tel:+1${item.replace(/\D/g, "")}`}>{item}</a>
              : item}
          </span>
        );
      })}
    </div>
  </header>

  <section>
    <h2>Summary</h2>
    <div class="pr-summary">{c.summary}</div>
  </section>

  {[
    { heading: "Selected Builds", entries: c.builds },
    { heading: "Experience", entries: c.experience },
  ].map(({ heading, entries }) => (
    <section id={heading === "Experience" ? "experience" : undefined}>
      <h2>{heading}</h2>
      {entries.map((e) => (
        <div class="pr-entry" data-pr-org={e.org}>
          <div class="pr-entry-head">
            <div class="pr-org">{e.org}{e.pos && <span class="pr-pos"><span class="pr-pos-sep"> · </span>{e.pos}</span>}</div>
            <div class="pr-dates">{e.dates}</div>
          </div>
          <ul>
            {e.bullets.map((b, bi) => <li data-bi={bi}>{b}</li>)}
          </ul>
          {e.url && (
            <div class="pr-link"><a href={e.url.href}>{e.url.text}</a></div>
          )}
        </div>
      ))}
    </section>
  ))}

  <section>
    <h2>Education</h2>
    <div class="pr-edu-grid">
      {c.education.map((s) => (
        <div class="pr-school">
          <div class="pr-edu-head"><div class="pr-org pr-org-edu">{s.name}</div><div class="pr-dates">{s.dates}</div></div>
          <div class="pr-deg">{s.degree}</div>
          {s.honors && <div class="pr-hon">{s.honors}</div>}
        </div>
      ))}
    </div>
  </section>

  <section>
    <h2>Skills</h2>
    <div class="pr-skills">
      {c.skillRows.map((row) => (
        <div>
          {/* one line on purpose: a newline here renders a stray space before the dot */}
          {row.map((g, i) => (
            <>{i > 0 && <span class="pr-skill-sep">&nbsp;·&nbsp;</span>}<span class="pr-skill"><span class="pr-skill-k">{g.label}<span class="pr-skill-colon">:</span></span> {g.items}</span></>
          ))}
        </div>
      ))}
    </div>
  </section>

  {/* the label and the prose are separated by a REAL space: extractors that
      read the DOM (not the print) used to join them ("OutsideDiary"). */}
  <div class="pr-outside"><span class="pr-outside-k">{c.closer.label}</span>{" "}<span set:html={c.closer.html} /></div>
</div>

<style is:global>
  /* Visibility contract: in print the curated sheet is the ONLY thing on
     the page. On screen it hides UNLESS the page opts it in — /resume shows
     it as the default "paper" view (Jon, 2026-08-20) via data-resume-view.
     @page must live in a global block (Astro can't scope it). */
  @media screen {
    .print-resume { display: none !important; }
    [data-resume-view="paper"] .print-resume { display: block !important; }
    .print-resume .pr-print-only { display: none !important; }
  }
  @media print {
    @page { size: letter; margin: 0.34in 0.48in; }
    html, body { background: #ffffff !important; background-image: none !important; }
    .site-header,
    .footer,
    .theme-toggle,
    .cursor-dot,
    .cursor-ring,
    .resume-dl-cta,
    .awayrail,
    [data-night-toggle],
    .resume-page .rs-root {
      display: none !important;
    }
    .resume-page { padding: 0 !important; margin: 0 !important; }
    .print-resume { display: block !important; }
  }
</style>

<style>
  /* All selectors are prefixed with .print-resume so they out-rank the local
     reset below (which would otherwise zero the li hanging indents and section
     rhythm — the reset's :is() carries class specificity). */
  .print-resume {
    line-height: 1.35;
    font-family: "Geist", -apple-system, "Segoe UI", Helvetica, Arial, sans-serif;
    font-size: 9.7pt;
    color: #222228;
    font-kerning: none;
    font-feature-settings: "kern" 0, "liga" 0;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }
  /* local reset: keep the site's screen styles out of the print sheet */
  .print-resume :is(div, section, header, ul, li, h2, a, span) {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }
  .print-resume a { color: inherit; text-decoration: none; }

  .print-resume .pr-header { border-bottom: 1.5pt solid #B33A2A; padding-bottom: 5pt; margin-bottom: 10pt; }
  .print-resume .pr-name-row { display: flex; justify-content: space-between; align-items: baseline; gap: 12pt; }
  .print-resume .pr-name { font-size: 19pt; font-weight: 700; letter-spacing: -0.02em; line-height: 1; color: #16161c; }
  .print-resume .pr-role { font-size: 10.5pt; font-weight: 600; color: #B33A2A; letter-spacing: 0.01em; }
  .print-resume .pr-contact { font-size: 8.75pt; color: #56565e; margin-top: 4pt; letter-spacing: 0.01em; }

  /* the rhythm (2026-10-06, density is the enemy): more air between sections
     and entries than inside them. The shorter text left ~120pt spare; these
     gaps spend most of it and the page still prints as one. */
  .print-resume section { margin-bottom: 11pt; }
  .print-resume h2 {
    font-size: 8pt; font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em;
    color: #B33A2A; margin-bottom: 5pt; padding-bottom: 2pt;
    border-bottom: 0.75pt solid #e3dfda;
    line-height: 1.38;
  }
  .print-resume .pr-summary { font-size: 9.7pt; line-height: 1.36; }

  .print-resume .pr-entry { margin-bottom: 9pt; }
  .print-resume .pr-entry:last-child { margin-bottom: 0; }
  .print-resume .pr-entry-head { display: flex; justify-content: space-between; align-items: baseline; gap: 12pt; }
  .print-resume .pr-org { font-size: 10.5pt; font-weight: 700; letter-spacing: -0.005em; color: #16161c; }
  /* Org names are static text (Jon, 2026-09-21: the case studies live in a
     row UNDER the sheet, not inside it). The one bare URL line under the
     mastering agent keeps the document's link grammar on screen: the
     document's own ink with a hairline rule — red on this sheet means
     structure only (role, section heads, bullet glyphs), never "click
     here" (Jon, 2026-09-18). Static text in normal flow, so the ATS
     contract above holds. */
  @media screen {
    .print-resume .pr-link a {
      color: #16161c;
      text-decoration: underline;
      text-decoration-color: rgba(22, 22, 28, 0.32);
      text-decoration-thickness: 1px;
      text-underline-offset: 3px;
      text-decoration-skip-ink: none;
      transition: text-decoration-color 140ms ease;
    }
    .print-resume .pr-link a:hover,
    .print-resume .pr-link a:focus-visible { text-decoration-color: #16161c; text-decoration-thickness: 2px; }
  }
  @media screen {
    #experience { scroll-margin-top: 28px; }
  }
  .print-resume .pr-pos { font-weight: 500; color: #56565e; }
  .print-resume .pr-dates { font-size: 8.5pt; color: #71717a; white-space: nowrap; font-variant-numeric: tabular-nums; }

  .print-resume ul { list-style: none; margin-top: 2.5pt; }
  .print-resume li { padding-left: 12pt; margin-bottom: 2.5pt; line-height: 1.33; }
  .print-resume li:last-child { margin-bottom: 0; }
  .print-resume li::before { content: "\203A"; display: inline-block; width: 12pt; margin-left: -12pt; color: #B33A2A; font-weight: 700; }
  .print-resume .pr-link { font-size: 8.75pt; color: #56565e; margin-top: 4pt; }
  .print-resume .pr-link a { font-weight: 600; }
  /* print keeps the sheet's red on these small links (the PDF asset is
     unchanged); on screen they take the org-link grammar above */
  @media print { .print-resume .pr-link a { color: #B33A2A; } }

  .print-resume .pr-edu-grid { display: grid; grid-template-columns: 1fr 1fr; column-gap: 26pt; }
  /* the phone stack must live HERE in the scoped block: the is:global
     version loses to this rule's scope-attribute specificity, and nested
     @media doesn't survive the pipeline (2026-08-25 lesson) */
  @media screen and (max-width: 520px) {
    .print-resume .pr-edu-grid { grid-template-columns: 1fr; row-gap: 8pt; }
  }
  .print-resume .pr-edu-head { display: flex; justify-content: space-between; align-items: baseline; gap: 8pt; }
  .print-resume .pr-org-edu { font-size: 10pt; }
  .print-resume .pr-deg { font-size: 9pt; color: #222228; margin-top: 1pt; }
  .print-resume .pr-hon { font-size: 8.5pt; color: #56565e; margin-top: 1pt; }

  .print-resume .pr-skills div { font-size: 9.25pt; line-height: 1.4; }
  .print-resume .pr-skill-k { font-weight: 700; color: #16161c; }

  .print-resume .pr-outside { font-size: 8.5pt; color: #56565e; margin-top: 2pt; padding-top: 2pt; border-top: 0.75pt solid #e3dfda; }
  .print-resume .pr-outside-k { font-weight: 700; color: #B33A2A; text-transform: uppercase; letter-spacing: 0.1em; font-size: 7.75pt; margin-right: 5pt; }
  .print-resume .pr-outside :global(em) { font-style: italic; }

  /* ── THE SHEET ON SCREEN (Jon's pick, 2026-10-06: direction B, square):
     re-set in the work room's material — Instrument Sans body, JetBrains
     Mono labels, Outfit names, the 4/8 scale, hairlines at 18 % ink, no red;
     the section labels stand in a left column on desks. SCREEN-ONLY: print
     keeps the Geist sheet above, so the PDF and the ATS stream never move.
     These rules come after the print rules at equal weight, so they win on
     screen; night flips the --rb-* inks (the old red-night block is gone).
     SCREEN-ONLY matters for night too: printing from a night tab still has
     html[data-night] set, and print-color-adjust: exact would put night
     inks on paper. ── */
  @media screen {
    .print-resume {
      --rb-ink: #141210;
      --rb-dim: #6a6660;
      --rb-line: color-mix(in oklab, #141210 18%, transparent);
      --rb-sans: "Instrument Sans", "Helvetica Neue", Arial, sans-serif;
      --rb-mono: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
      --rb-display: "Outfit", "Instrument Sans", "Helvetica Neue", Arial, sans-serif;
      font-family: var(--rb-sans);
      font-size: 1rem;
      line-height: 1.6;
      color: var(--rb-ink);
      font-kerning: normal;
      font-feature-settings: normal;
    }
    :global(html[data-night]) .print-resume {
      --rb-ink: #e8ecf4;
      --rb-dim: #7d8798;
      --rb-line: color-mix(in oklab, #e8ecf4 18%, transparent);
    }
    /* the head: the role as the room's mono label, then the name in Outfit */
    .print-resume .pr-header { border-bottom: 1px solid var(--rb-line); padding-bottom: 32px; margin-bottom: 0; }
    .print-resume .pr-name-row { display: flex; flex-direction: column-reverse; align-items: flex-start; gap: 12px; }
    .print-resume .pr-role { font: 500 0.6875rem/1.5 var(--rb-mono); letter-spacing: 0.12em; text-transform: lowercase; color: var(--rb-dim); }
    .print-resume .pr-name { font: 500 2.125rem/1.15 var(--rb-display); letter-spacing: -0.01em; color: var(--rb-ink); }
    .print-resume .pr-contact { margin-top: 16px; font: 400 0.75rem/1.6 var(--rb-mono); letter-spacing: 0.04em; color: var(--rb-dim); }
    /* sections: a mono label in the left column, the content on a 36rem measure beside it */
    .print-resume > section {
      display: grid;
      grid-template-columns: 9.5rem minmax(0, 1fr);
      column-gap: 32px;
      margin: 0;
      padding: 32px 0;
      border-top: 1px solid var(--rb-line);
    }
    .print-resume > .pr-header + section { border-top: 0; }
    .print-resume > section > h2 {
      grid-column: 1;
      margin: 0;
      padding: 5px 0 0;
      border: 0;
      font: 500 0.6875rem/1.5 var(--rb-mono);
      letter-spacing: 0.12em;
      text-transform: lowercase;
      color: var(--rb-dim);
    }
    .print-resume > section > :not(h2) { grid-column: 2; min-width: 0; }
    .print-resume .pr-summary { max-width: 36rem; font-size: 1.0625rem; line-height: 1.6; }
    /* an entry: the name in Outfit, its stack or title in the mono beneath, the dates beside */
    .print-resume .pr-entry { margin: 0 0 32px; max-width: 36rem; }
    .print-resume .pr-entry:last-child { margin-bottom: 0; }
    .print-resume .pr-entry-head { gap: 4px 16px; flex-wrap: wrap; }
    .print-resume .pr-org { font: 500 1.25rem/1.3 var(--rb-display); letter-spacing: -0.01em; color: var(--rb-ink); }
    .print-resume .pr-pos { display: block; margin-top: 4px; font: 400 0.75rem/1.5 var(--rb-mono); letter-spacing: 0.04em; color: var(--rb-dim); }
    .print-resume .pr-pos-sep { display: none; }
    .print-resume .pr-dates { font: 400 0.75rem/1.5 var(--rb-mono); letter-spacing: 0.04em; color: var(--rb-dim); }
    .print-resume ul { margin-top: 12px; }
    .print-resume li { padding-left: 20px; margin-bottom: 8px; font-size: 0.9375rem; line-height: 1.6; }
    .print-resume li::before { content: "\2013"; width: 20px; margin-left: -20px; color: var(--rb-dim); font-weight: 400; }
    .print-resume .pr-link { margin-top: 12px; font: 400 0.75rem/1.5 var(--rb-mono); letter-spacing: 0.04em; color: var(--rb-dim); }
    .print-resume .pr-link a { font-weight: 500; color: var(--rb-ink); text-decoration-color: color-mix(in oklab, var(--rb-ink) 32%, transparent); }
    .print-resume .pr-link a:hover,
    .print-resume .pr-link a:focus-visible { text-decoration-color: var(--rb-ink); }
    /* education + skills */
    .print-resume .pr-edu-grid { grid-template-columns: minmax(0, 1fr); row-gap: 20px; max-width: 36rem; }
    .print-resume .pr-org-edu { font: 500 1.125rem/1.3 var(--rb-display); }
    .print-resume .pr-deg { margin-top: 6px; font-size: 0.9375rem; line-height: 1.55; color: var(--rb-ink); }
    .print-resume .pr-hon { margin-top: 4px; font-size: 0.875rem; line-height: 1.55; color: var(--rb-dim); }
    .print-resume .pr-skills > div { display: contents; }
    .print-resume .pr-skill-sep,
    .print-resume .pr-skill-colon { display: none; }
    .print-resume .pr-skill { display: grid; grid-template-columns: 7.5rem minmax(0, 1fr); column-gap: 16px; max-width: 36rem; font-size: 0.9375rem; line-height: 1.6; }
    .print-resume .pr-skill-sep + .pr-skill,
    .print-resume .pr-skills > div + div .pr-skill { margin-top: 8px; }
    .print-resume .pr-skill-k { padding-top: 3px; font: 500 0.6875rem/1.5 var(--rb-mono); letter-spacing: 0.12em; text-transform: lowercase; color: var(--rb-dim); }
    /* the closer: the same label column */
    .print-resume .pr-outside {
      display: grid;
      grid-template-columns: 9.5rem minmax(0, 1fr);
      column-gap: 32px;
      margin: 0;
      padding: 32px 0 0;
      border-top: 1px solid var(--rb-line);
      font-size: 0.9375rem;
      line-height: 1.6;
      color: var(--rb-ink);
    }
    .print-resume .pr-outside-k { margin: 0; padding-top: 3px; font: 500 0.6875rem/1.5 var(--rb-mono); letter-spacing: 0.12em; text-transform: lowercase; color: var(--rb-dim); }
    .print-resume .pr-outside > span:last-child { max-width: 36rem; }
  }
  /* phones and narrow windows: the label column folds above its content */
  @media screen and (max-width: 720px) {
    .print-resume > section,
    .print-resume .pr-outside { grid-template-columns: minmax(0, 1fr); row-gap: 12px; padding: 24px 0; }
    .print-resume > section > :not(h2) { grid-column: 1; }
    .print-resume > section > h2 { padding-top: 0; }
    .print-resume .pr-outside { padding-bottom: 0; }
    .print-resume .pr-entry { margin-bottom: 28px; }
    .print-resume .pr-name { font-size: 1.75rem; }
    .print-resume .pr-header { padding-bottom: 24px; }
    .print-resume .pr-skill { grid-template-columns: minmax(0, 1fr); row-gap: 2px; }
    .print-resume .pr-skill-k { padding-top: 0; }
  }
</style>
