---
// ResumeShell — the page frame around the résumé.
//
// The résumé reads as a clean, literal page at rest. The interactive parts are
// flagged with handwritten Post-it filing tabs (see ResumeTab) that stick out
// the right edge; clicking one reveals/plays that element inline. There is no
// view-mode toggle: the resting state IS the clean document, and the pristine
// one-page PDF is always one click away via Download PDF (or Cmd+P).
//
// Visibility contract (kept dead simple now that modes are gone):
//   .r-live = screen-only adornments (tabs, proofs, timeline, skills field).
//   .r-doc  = print-only substrate the live view replaces on screen (the plain
//             ATS skills list).
// Theme-aware (tokens only). Honors prefers-reduced-motion. All chrome resets
// under @media print so the PDF stays byte-faithful to ResumeRenderer's layout.
---

<div class="rs-root" data-resume-shell>
  <div class="rs-bar print-hide" role="toolbar" aria-label="Résumé actions">
    <div class="rs-id">
      <svg class="rs-id-icon" viewBox="0 0 16 20" width="15" height="18" aria-hidden="true">
        <path d="M2.5 1.5h7l4 4v13a0.5 0.5 0 0 1-0.5 0.5H2.5a0.5 0.5 0 0 1-0.5-0.5V2a0.5 0.5 0 0 1 0.5-0.5Z" fill="none" stroke="currentColor" stroke-width="1.1"/>
        <path d="M9.5 1.5v4h4" fill="none" stroke="currentColor" stroke-width="1.1"/>
        <path d="M4.6 9h6.8M4.6 11.6h6.8M4.6 14.2h4.2" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/>
      </svg>
      <span class="rs-id-label">Résumé</span>
      <span class="rs-id-note">tabbed</span>
    </div>

    <button class="rs-dl" type="button" data-rs-download aria-label="Download the clean PDF résumé">
      <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
        <path d="M8 1.5v8.5M4.5 7l3.5 3.5L11.5 7" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M2.5 13.5h11" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
      </svg>
      <span>Download PDF</span>
    </button>
  </div>

  <div class="rs-deskwrap">
    <div class="rs-sheet">
      <slot />
    </div>
    <p class="rs-hint print-hide">
      <span>The <b>tabs</b> mark what comes alive. Pull one.</span>
      <span class="rs-hint-pdf">Prefer it plain? <kbd>⌘P</kbd> or Download PDF, always one page.</span>
    </p>
  </div>
</div>

<style>
  .rs-root { --rs-sheet-max: 58rem; --rs-radius: 5px; position: relative; }

  /* ── Toolbar ── */
  .rs-bar {
    position: sticky;
    top: var(--rs-bar-top, 0px);
    z-index: 40;
    max-width: var(--rs-sheet-max);
    margin: 0 auto var(--space-5);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-3) var(--space-3) var(--space-4);
    background: color-mix(in srgb, var(--surface-1) 86%, transparent);
    -webkit-backdrop-filter: saturate(1.4) blur(10px);
    backdrop-filter: saturate(1.4) blur(10px);
    border: 1px solid var(--line);
    border-radius: var(--rs-radius);
    box-shadow: 0 10px 30px -22px rgba(0, 0, 0, 0.5);
  }
  .rs-id { display: flex; align-items: center; gap: var(--space-2); min-width: 0; }
  .rs-id-icon { color: var(--muted); flex-shrink: 0; }
  .rs-id-label {
    font-family: "Space Grotesk Variable", "Space Grotesk", ui-sans-serif, system-ui, sans-serif;
    font-weight: var(--fw-semibold);
    font-size: 0.9375rem;
    letter-spacing: -0.01em;
    color: var(--text);
  }
  .rs-id-note {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
    border-radius: 999px;
    padding: 2px 8px;
  }

  .rs-dl {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    appearance: none;
    border: 1px solid var(--accent);
    background: var(--accent);
    color: #fff;
    font-family: inherit;
    font-size: 0.8125rem;
    font-weight: var(--fw-semibold);
    padding: 7px 14px;
    border-radius: 999px;
    cursor: pointer;
    white-space: nowrap;
    transition: transform 160ms ease, box-shadow 200ms ease, filter 160ms ease;
    box-shadow: 0 6px 18px -10px color-mix(in srgb, var(--accent) 70%, transparent);
  }
  .rs-dl svg { color: #fff; }
  .rs-dl:hover { transform: translateY(-1px); filter: brightness(1.05); box-shadow: 0 10px 22px -10px color-mix(in srgb, var(--accent) 80%, transparent); }
  .rs-dl:active { transform: translateY(0); }

  /* ── Sheet ── */
  .rs-deskwrap { position: relative; }
  .rs-sheet {
    position: relative;
    max-width: var(--rs-sheet-max);
    margin: 0 auto;
    background: var(--surface-1);
    border: 1px solid var(--line);
    border-radius: var(--rs-radius);
    box-shadow:
      0 1px 0 color-mix(in srgb, var(--text) 6%, transparent),
      0 28px 64px -40px rgba(0, 0, 0, 0.6),
      0 6px 18px -14px rgba(0, 0, 0, 0.4);
    /* visible so the Post-it tabs can stick out the right edge */
    overflow: visible;
  }
  .rs-sheet::before {
    content: "";
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    border-radius: var(--rs-radius) var(--rs-radius) 0 0;
    background: linear-gradient(90deg, var(--accent), color-mix(in srgb, var(--accent) 35%, transparent));
    z-index: 2;
  }

  .rs-hint {
    max-width: var(--rs-sheet-max);
    margin: var(--space-5) auto 0;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--muted);
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    align-items: baseline;
  }
  .rs-hint b { color: var(--accent); font-weight: var(--fw-semibold); }
  .rs-hint-pdf { opacity: 0.85; }
  .rs-hint kbd {
    font-family: inherit;
    font-size: 0.6875rem;
    border: 1px solid var(--line);
    border-bottom-width: 2px;
    border-radius: 4px;
    padding: 1px 5px;
    color: var(--text);
  }

  @media (max-width: 40rem) {
    .rs-bar { padding: var(--space-2) var(--space-3); }
    .rs-id-note { display: none; }
    .rs-dl span { display: none; }
    .rs-dl { padding: 8px 10px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .rs-dl { transition: none; }
  }

  /* ── Print: dissolve all chrome, leave the clean document ── */
  @media print {
    .rs-bar, .rs-hint { display: none !important; }
    .rs-root, .rs-deskwrap { margin: 0 !important; padding: 0 !important; }
    .rs-sheet {
      max-width: 100%;
      margin: 0 !important;
      padding: 0 !important;
      background: #fff !important;
      border: none !important;
      border-radius: 0 !important;
      box-shadow: none !important;
      overflow: visible;
    }
    .rs-sheet::before { display: none !important; }
    .rs-root { --rs-sheet-max: 100%; }
  }
</style>

<style is:global>
  /* ── Live / Print visibility contract ──
     .r-live = screen-only (tabs, proofs, timeline, skills field).
     .r-doc  = print-only substrate (the plain ATS skills list).
     Wrapped per-medium so print is never affected by screen rules. */
  @media screen {
    .r-doc { display: none !important; }
  }
  @media print {
    .r-live { display: none !important; }
    /* the route wrapper must not add page height, or the tuned one-page layout
       (especially the slightly taller tailored variants) spills to a 2nd sheet */
    .resume-page { padding: 0 !important; margin: 0 !important; }
  }
</style>

<script>
  (() => {
    const root = document.querySelector<HTMLElement>("[data-resume-shell]");
    if (!root) return;

    // Sit the sticky toolbar just below the site header (height unknown; we
    // can't edit shared chrome, so measure it).
    const placeBar = () => {
      const header = document.querySelector<HTMLElement>(".site-header, header.site-header, header[class*='header']");
      const h = header ? Math.round(header.getBoundingClientRect().height) : 0;
      root.style.setProperty("--rs-bar-top", `${h + 8}px`);
    };
    placeBar();
    window.addEventListener("resize", placeBar);

    root.querySelector<HTMLButtonElement>("[data-rs-download]")?.addEventListener("click", () => window.print());
  })();
</script>
