---
// A Post-it page flag that hangs off the edge of the résumé sheet. Two parts:
//   .rtab-stick — the translucent adhesive that lies ON the page (you can read
//                 the résumé through it), a frosted tint of the flag color.
//   .rtab-flag  — the solid, fun-colored flag that hangs OFF the edge and
//                 carries the handwritten label.
// `side` decides which edge it hangs off (left or right). Vertical placement is
// set by JS (its target's center); the horizontal hang is CSS (--rtab-hang,
// which shrinks with the viewport so flags never overflow). It IS the trigger
// for an interactive element (button + aria-controls).
interface Props {
  label: string;
  color: string;
  ink: string;          // label color, chosen per flag for contrast
  side: "left" | "right";
  rot?: number;
  controls: string;     // id of the panel this opens
  target: string;       // id of the element it sits beside (for alignment + focus)
  ariaLabel?: string;
}
const { label, color, ink, side, rot = -2, controls, target, ariaLabel } = Astro.props;
---

<button
  type="button"
  class="rtab r-live"
  data-proof-tab
  data-side={side}
  data-target={target}
  aria-expanded="false"
  aria-controls={controls}
  aria-label={ariaLabel ?? label}
  style={`--tab-color:${color}; --tab-ink:${ink}; --tab-rot:${rot}deg;`}
>
  <span class="rtab-stick" aria-hidden="true"></span>
  <span class="rtab-flag"><span class="rtab-ink">{label}</span></span>
</button>

<style>
  .rtab {
    position: absolute;
    top: var(--rtab-top, 50%);
    z-index: 6;
    display: inline-flex;
    align-items: stretch;
    height: 34px;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    transform: translateY(-50%) rotate(var(--tab-rot, -2deg));
    transform-origin: center;
    transition: transform 240ms cubic-bezier(0.22, 1, 0.36, 1), top 360ms cubic-bezier(0.22, 1, 0.36, 1), filter 220ms ease, opacity 300ms ease;
    -webkit-tap-highlight-color: transparent;
  }
  .rtab[data-side="right"] { right: calc(-1 * var(--rtab-hang, 30px)); }
  .rtab[data-side="left"] { left: calc(-1 * var(--rtab-hang, 30px)); flex-direction: row-reverse; }

  /* translucent adhesive that lies on the page */
  .rtab-stick {
    width: 44px;
    background: color-mix(in srgb, var(--tab-color) 24%, transparent);
    -webkit-backdrop-filter: blur(1.5px) saturate(1.3);
    backdrop-filter: blur(1.5px) saturate(1.3);
    border: 1px solid color-mix(in srgb, var(--tab-color) 38%, transparent);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.25);
  }
  .rtab[data-side="right"] .rtab-stick { border-radius: 4px 0 0 4px; border-right: none; }
  .rtab[data-side="left"] .rtab-stick { border-radius: 0 4px 4px 0; border-left: none; }

  /* the solid fun-colored flag hanging off the edge */
  .rtab-flag {
    display: flex;
    align-items: center;
    padding: 0 15px;
    background: var(--tab-color);
    background-image: linear-gradient(157deg, rgba(255, 255, 255, 0.32) 0%, rgba(255, 255, 255, 0) 46%, rgba(0, 0, 0, 0.1) 100%);
    box-shadow:
      0 6px 14px -6px color-mix(in srgb, var(--tab-color) 60%, transparent),
      0 2px 4px rgba(0, 0, 0, 0.22);
  }
  .rtab[data-side="right"] .rtab-flag { border-radius: 0 7px 7px 0; }
  .rtab[data-side="left"] .rtab-flag { border-radius: 7px 0 0 7px; }

  .rtab-ink {
    font-family: "Bradley Hand", "Bradley Hand ITC", "Segoe Print", "Chalkboard SE", "Comic Sans MS", cursive;
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    color: var(--tab-ink);
    line-height: 1;
    white-space: nowrap;
    transform: rotate(-1.1deg);
    text-shadow: 0 1px 0 rgba(0, 0, 0, 0.08);
  }

  /* hover: lift + pull a touch further off the page */
  .rtab:hover, .rtab:focus-visible { outline: none; filter: brightness(1.05); }
  .rtab[data-side="right"]:hover, .rtab[data-side="right"]:focus-visible {
    transform: translateY(-50%) rotate(var(--tab-rot)) translateX(5px) scale(1.04);
  }
  .rtab[data-side="left"]:hover, .rtab[data-side="left"]:focus-visible {
    transform: translateY(-50%) rotate(var(--tab-rot)) translateX(-5px) scale(1.04);
  }
  .rtab:focus-visible .rtab-flag { box-shadow: 0 0 0 2px var(--tab-color), 0 6px 14px -6px color-mix(in srgb, var(--tab-color) 60%, transparent); }

  /* open: pressed into the page */
  .rtab[aria-expanded="true"][data-side="right"] {
    transform: translateY(-50%) rotate(calc(var(--tab-rot) * 0.4)) translateX(-6px);
  }
  .rtab[aria-expanded="true"][data-side="left"] {
    transform: translateY(-50%) rotate(calc(var(--tab-rot) * 0.4)) translateX(6px);
  }
  .rtab[aria-expanded="true"] .rtab-flag {
    box-shadow: inset 0 0 0 2px color-mix(in srgb, var(--tab-ink) 22%, transparent), 0 2px 5px rgba(0,0,0,0.2);
  }

  @media (max-width: 48rem) {
    .rtab { height: 28px; }
    .rtab-stick { width: 30px; }
    .rtab-flag { padding: 0 11px; }
    .rtab-ink { font-size: 0.8125rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .rtab { transition: opacity 300ms ease; }
    .rtab:hover, .rtab:focus-visible,
    .rtab[aria-expanded="true"] { transform: translateY(-50%) rotate(var(--tab-rot)); }
  }
</style>
