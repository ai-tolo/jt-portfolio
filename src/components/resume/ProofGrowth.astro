---
// PROOF — the Crediverso bullet: "Designed and ran the pre-launch growth
// program. Organic campaigns grew the channel 125% (700 to 2,100 followers)
// through A/B-tested messaging." Instead of asserting it, this draws it: a
// growth curve climbs from 700 to 2,100 followers over 8 pre-launch weeks, the
// follower count tallies up, and the moment an A/B test picked a winner the
// curve visibly steepens (variant B beats A). Theme-aware, reduced-motion-safe,
// fluid SVG so it never overflows on mobile.

// 8 weekly samples on a 0..100 x 0..100 grid (y inverted: 0 = top).
// The winning path (B) is what shipped: steady early, then it pulls away from
// the losing variant (A) after the week-4 A/B call. Endpoints are faithful:
// week 0 sits at 700 followers, week 8 lands on 2,100.
const W = 320;
const H = 132;
// winning curve (organic, shipped) — y values are 0..H, lower = more followers
const WIN = [
  [0, 116], [40, 108], [80, 98], [120, 86],
  [160, 70], [200, 52], [240, 34], [320, 16],
];
// losing variant A: tracks the winner until the week-4 split, then flattens.
const LOSE = [
  [160, 70], [200, 62], [240, 56], [320, 50],
];
const toPath = (pts: number[][]) =>
  pts.map((p, i) => `${i ? "L" : "M"}${p[0]} ${p[1]}`).join(" ");
const WIN_D = toPath(WIN);
const LOSE_D = toPath(LOSE);
// area = winning line, then down to the baseline and back to start
const AREA_D = `${WIN_D} L${W} ${H} L0 ${H} Z`;
// the A/B split point (week 4) where the curve earns its lift
const SPLIT = WIN[4]; // [160, 70]
---

<div class="pf pf-growth" data-proof="growth">
  <div class="pf-head">
    <span class="pf-kicker">live · the actual growth</span>
    <h4 class="pf-title">700 to 2,100 followers, pre-launch and organic</h4>
    <button type="button" class="pf-replay" data-replay aria-label="Replay the growth curve">
      <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true"><path d="M13 8a5 5 0 1 1-1.46-3.54M13 2.5V5h-2.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <span data-run-label>Replay</span>
    </button>
  </div>

  <div class="pf-board">
    <!-- the live tally -->
    <div class="pf-tally">
      <div class="pf-count-row">
        <b class="pf-count" data-count>700</b>
        <span class="pf-count-unit">followers</span>
      </div>
      <span class="pf-badge" data-badge>+125%</span>
    </div>

    <!-- the growth chart -->
    <figure class="pf-chart">
      <svg class="pf-svg" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" role="img" aria-label="Follower growth from 700 to 2,100 over eight pre-launch weeks">
        <!-- faint horizontal gridlines -->
        <g class="pf-grid-lines" aria-hidden="true">
          <line x1="0" y1="0.5" x2={W} y2="0.5"></line>
          <line x1="0" y1={H * 0.5} x2={W} y2={H * 0.5}></line>
          <line x1="0" y1={H - 0.5} x2={W} y2={H - 0.5}></line>
        </g>
        <!-- area fill under the winning curve -->
        <path class="pf-area" data-area d={AREA_D} aria-hidden="true"></path>
        <!-- losing variant A (faint, dashed) -->
        <path class="pf-lose" data-lose d={LOSE_D} fill="none" aria-hidden="true"></path>
        <!-- winning curve (B), drawn via stroke-dashoffset reveal -->
        <path class="pf-line" data-line d={WIN_D} fill="none"></path>
        <!-- A/B split marker -->
        <g class="pf-split" data-split aria-hidden="true">
          <circle class="pf-split-dot" cx={SPLIT[0]} cy={SPLIT[1]} r="3.2"></circle>
        </g>
        <!-- endpoint dot lands at 2,100 -->
        <circle class="pf-end-dot" data-enddot cx={WIN[WIN.length - 1][0]} cy={WIN[WIN.length - 1][1]} r="3.4" aria-hidden="true"></circle>
      </svg>

      <!-- overlay labels (positioned in % so they track the fluid SVG) -->
      <span class="pf-pt pf-pt-start" aria-hidden="true">700</span>
      <span class="pf-pt pf-pt-end" data-endlabel aria-hidden="true">2,100</span>
      <span class="pf-ab" data-ab style={`left:${(SPLIT[0] / W) * 100}%;top:${(SPLIT[1] / H) * 100}%`} aria-hidden="true">A/B · B won</span>

      <figcaption class="pf-axis" aria-hidden="true">
        <span>8 weeks pre-launch</span>
        <span>launch</span>
      </figcaption>
    </figure>
  </div>

  <div class="pf-meter" data-meter>
    <span><b data-c="weeks">0</b> weeks pre-launch</span>
    <span class="pf-meter-sep">·</span>
    <span>all organic</span>
    <span class="pf-meter-sep">·</span>
    <span>A/B tested messaging</span>
  </div>
</div>

<script>
  import { onPlay, countUp, prefersReduced } from "./lib/motion";

  document.querySelectorAll<HTMLElement>('[data-proof="growth"]').forEach((root) => {
    const countEl = root.querySelector<HTMLElement>("[data-count]");
    const runLabel = root.querySelector<HTMLElement>("[data-run-label]");
    const line = root.querySelector<SVGPathElement>("[data-line]");
    const meterEls = {
      weeks: root.querySelector<HTMLElement>('[data-c="weeks"]'),
    };

    // Measure the winning path so the dashoffset reveal is exact.
    const len = line?.getTotalLength?.() ?? 320;
    if (line) {
      line.style.strokeDasharray = `${len}`;
      line.style.strokeDashoffset = `${len}`;
    }

    let timers: number[] = [];
    const clearTimers = () => { timers.forEach(clearTimeout); timers = []; };
    const after = (ms: number, fn: () => void) => { timers.push(window.setTimeout(fn, ms)); };

    // Force the chart to its final drawn state, no transition.
    const settle = () => {
      if (line) {
        line.style.transition = "none";
        line.style.strokeDashoffset = "0";
      }
      root.classList.remove("is-running");
      root.classList.add("is-done");
    };

    const play = () => {
      clearTimers();
      root.classList.remove("is-done");
      if (runLabel) runLabel.textContent = "Replaying";

      // count the follower number 700 -> 2,100 (countUp self-backstops)
      if (countEl) countUp(countEl, 2100, { from: 700, dur: 1700 });

      if (prefersReduced()) {
        settle();
        if (runLabel) runLabel.textContent = "Replay";
        if (meterEls.weeks) countUp(meterEls.weeks, 8, { dur: 0 });
        return;
      }

      // draw the curve: reset, then animate the dashoffset to 0
      root.classList.add("is-running");
      if (line) {
        line.style.transition = "none";
        line.style.strokeDashoffset = `${len}`;
        // next frame: re-enable transition so the reveal animates
        requestAnimationFrame(() => requestAnimationFrame(() => {
          line.style.transition = "stroke-dashoffset 1.7s cubic-bezier(0.4, 0, 0.1, 1)";
          line.style.strokeDashoffset = "0";
        }));
      }

      after(1750, () => {
        root.classList.remove("is-running");
        root.classList.add("is-done");
        if (runLabel) runLabel.textContent = "Replay";
        if (meterEls.weeks) countUp(meterEls.weeks, 8, { dur: 700 });
      });

      // Headless/throttled backstop: force the final drawn state regardless.
      after(2100, settle);
    };

    root.querySelector<HTMLButtonElement>("[data-replay]")?.addEventListener("click", play);
    onPlay(root, play, { threshold: 0.3 });
  });
</script>

<style>
  .pf {
    --pf-radius: 8px;
    --pf-bg: color-mix(in srgb, var(--surface-1) 60%, var(--bg));
    margin-top: var(--space-4);
    /* gradient "selected" border, matching the portal bucket cards */
    border: 1.5px solid transparent;
    border-radius: var(--pf-radius);
    background:
      linear-gradient(var(--pf-bg), var(--pf-bg)) padding-box,
      linear-gradient(135deg, #ff3b6e 0%, #ff6e21 50%, #eeff00 100%) border-box;
    box-shadow: 0 0 22px rgba(255, 59, 110, 0.15), 0 10px 26px -12px rgba(0, 0, 0, 0.5);
    padding: var(--space-4);
    font-weight: var(--fw-regular);
  }
  .pf-head {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
    flex-wrap: wrap;
  }
  .pf-kicker {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .pf-title {
    font-size: 0.9375rem;
    font-weight: var(--fw-semibold);
    letter-spacing: -0.01em;
    color: var(--text);
    flex: 1 1 auto;
  }
  .pf-replay {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    appearance: none;
    border: 1px solid var(--line);
    background: var(--bg);
    color: var(--text);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    padding: 5px 11px;
    border-radius: 999px;
    cursor: pointer;
    transition: border-color 160ms ease, color 160ms ease;
  }
  .pf-replay:hover { border-color: var(--accent); color: var(--accent); }

  .pf-board { display: flex; flex-direction: column; gap: var(--space-3); }

  /* ── live tally ── */
  .pf-tally {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  .pf-count-row { display: flex; align-items: baseline; gap: 7px; }
  .pf-count {
    font-size: 2rem;
    font-weight: var(--fw-bold);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }
  .pf-count-unit {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.6875rem;
    color: var(--muted);
  }
  .pf-badge {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.6875rem;
    font-weight: var(--fw-semibold);
    letter-spacing: 0.02em;
    color: #fff;
    background: var(--accent);
    border-radius: 999px;
    padding: 3px 9px;
    opacity: 0;
    transform: translateY(2px) scale(0.96);
    transition: opacity 0.4s ease, transform 0.4s ease;
  }
  .pf-growth.is-running .pf-badge,
  .pf-growth.is-done .pf-badge { opacity: 1; transform: none; transition-delay: 0.9s; }

  /* ── chart ── */
  .pf-chart { margin: 0; position: relative; }
  .pf-svg {
    display: block;
    width: 100%;
    height: 132px;
    overflow: visible;
  }
  .pf-grid-lines line { stroke: var(--line); stroke-width: 1; opacity: 0.5; vector-effect: non-scaling-stroke; }

  .pf-area {
    fill: color-mix(in srgb, var(--accent) 14%, transparent);
    opacity: 0;
    transition: opacity 0.9s ease 0.5s;
  }
  .pf-growth.is-running .pf-area,
  .pf-growth.is-done .pf-area { opacity: 1; }

  .pf-lose {
    stroke: var(--muted);
    stroke-width: 1.4;
    stroke-dasharray: 3 3;
    vector-effect: non-scaling-stroke;
    opacity: 0;
    transition: opacity 0.5s ease 0.85s;
  }
  .pf-growth.is-running .pf-lose,
  .pf-growth.is-done .pf-lose { opacity: 0.55; }

  .pf-line {
    stroke: var(--accent);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  .pf-split-dot {
    fill: var(--bg);
    stroke: var(--muted);
    stroke-width: 1.6;
    vector-effect: non-scaling-stroke;
    opacity: 0;
    transition: opacity 0.4s ease 0.7s;
  }
  .pf-growth.is-running .pf-split-dot,
  .pf-growth.is-done .pf-split-dot { opacity: 1; }

  .pf-end-dot {
    fill: var(--accent);
    stroke: var(--bg);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
    opacity: 0;
    transform: scale(0.4);
    transform-origin: center;
    transform-box: fill-box;
    transition: opacity 0.3s ease, transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .pf-growth.is-done .pf-end-dot { opacity: 1; transform: none; transition-delay: 0.05s; }

  /* ── overlay labels ── */
  .pf-pt {
    position: absolute;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.5625rem;
    color: var(--muted);
    white-space: nowrap;
    pointer-events: none;
  }
  .pf-pt-start { left: 0; bottom: -2px; }
  .pf-pt-end {
    right: 0; top: -2px;
    color: var(--accent);
    font-weight: var(--fw-semibold);
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  .pf-growth.is-done .pf-pt-end { opacity: 1; transition-delay: 0.1s; }

  .pf-ab {
    position: absolute;
    transform: translate(8px, -130%);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.5rem;
    letter-spacing: 0.04em;
    color: var(--accent);
    background: color-mix(in srgb, var(--bg) 86%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 40%, var(--line));
    border-radius: 4px;
    padding: 1px 4px;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.45s ease 0.85s;
  }
  .pf-growth.is-running .pf-ab,
  .pf-growth.is-done .pf-ab { opacity: 1; }

  .pf-axis {
    display: flex;
    justify-content: space-between;
    margin-top: var(--space-3);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.5625rem;
    color: var(--muted);
  }

  /* ── meter ── */
  .pf-meter {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 10px;
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid var(--line);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.6875rem;
    color: var(--muted);
  }
  .pf-meter b { color: var(--accent); font-variant-numeric: tabular-nums; font-size: 0.8125rem; }
  .pf-meter-sep { color: var(--line); }

  @media (max-width: 34rem) {
    .pf-count { font-size: 1.75rem; }
    .pf-svg { height: 120px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .pf-area, .pf-lose, .pf-line, .pf-split-dot, .pf-end-dot,
    .pf-badge, .pf-pt-end, .pf-ab { transition: none !important; }
  }
</style>
