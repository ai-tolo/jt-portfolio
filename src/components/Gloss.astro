---
/**
 * THE GLOSS (2026-10-23): a niche word carries its own line. `<Gloss w="Ableton" />` prints the word;
 * `<Gloss w="Ableton">Ableton</Gloss>` prints the slot. The word is a button (inline, the text's own face and size, a
 * 1px dotted underline in the dim ink, never the accent: it is not a link); its line floats in a small paper pop under
 * it (gloss-client.ts). The list is src/lib/gloss.ts; Glossed.astro marks words inside a copy string.
 */
import { glossId, glossLine, type GlossWord } from "../lib/gloss";
import "../styles/gloss.css";
interface Props { w: GlossWord }
const { w } = Astro.props;
glossLine(w); // an unknown word fails the build
---
{/* the script first and the button flush against it: a newline between them printed a space after the word */}
<script>
  import "../lib/gloss-client";
</script><button type="button" class="gl" data-gl={w} aria-expanded="false" aria-describedby={glossId(w)}><slot>{w}</slot></button>