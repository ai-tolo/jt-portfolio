---
// src/components/IntakeCatchAll.astro
// THE CATCH-ALL (2026-10-21, branch intake-v4, fresh eyes after five attempts in two days). Jon kept, from the pile:
// the lived frame (the phone as it was, sorted into Intake), one press at a time, a calendar beneath that changes, the
// memo whose words arrive as spoken. He rejected: the ribbon of numerals ("the view of the calendar isn't good enough
// to be relevant"), the second phone ("I don't know why we need the phone to be on the right side as well"), the junk
// ("too many other notifications with extra words") and the hint ("tap what's yours is stupid and weird").
//
// So: LEFT, the LOCK SCREEN as it was, FIVE things he sent himself and nothing else (his notifications are off), each
// its own press, breathing (the touch rim, the house vocabulary). BESIDE IT, INTAKE'S CARDS AND NOTHING ELSE (round
// two, 2026-10-21, Jon: "I don't know why it needs to look like a phone or why there needs to be header info there
// and the dark black background. What matters is showing the cards"): one 1px hairline in the phone's silhouette on
// the sheet's paper, empty at rest, its list reserved to six cards from the first paint. BENEATH BOTH, HIS CALENDAR: a real month,
// drawn as the iPhone's Calendar draws one (the weekday letters, the bold numerals, today ringed), the object's full
// width. A PRESS opens the thing the way iOS opens a notification (the photo, the screenshot, the listing full width in
// the pill; the memo into its strip, the words typed IN SEQUENCE as spoken), holds so you see it, flies one arc into
// Intake and is the card as it lands (a receipt or an open card); a dated landing pages the month to the day and
// the day takes its bar. After the fifth the lock screen is the clock alone: the phone is quiet. The watch under it is
// the live memo (IntakeHero, live only). NO HINT, EVER: the rims say what can be pressed; the foot holds the runline
// while a press plays and the house Replay after the fifth.
//
// Usage:   <IntakeCatchAll />   (inside a .sheet: it reads --sheet-ink / --sheet-acc / --sheet-mono from the host)
// Data:    src/data/intake-catchall.json (every line a DRAFT, Jon's to rewrite); images in public/intake/board/
// Needs:   public/archive/phone-blank.png (AudioDexDoor's body)
// Slot:    public/intake/memo-nico.m4a (existsSync at build time, like the Studio captures): present, the memo plays
//          WITH sound and the words pace to its length; absent, the words type at 400 ms each, no sound.
//
// INTAKE IS THE HERO: its outline on screen from the first paint, its cards at every landing and the whole end state.
// NOTHING PRESSES ITSELF: every motion follows a press. NOTHING MOVES THE PAGE: the phone (an aspect ratio), the panel
// (the phone's height; its list reserved), the month (five rows at a fixed height) and the foot (one slot) hold one
// height from the first paint. Reduced motion: no opening, no arc, no paging, no typing; a press shows the card and
// the bar at once.
import fs from 'node:fs';
import path from 'node:path';
import data from '../data/intake-catchall.json';

const { lock, feed, memo, cal, say } = data;
const clip: string | null = fs.existsSync(path.join(process.cwd(), 'public', memo.clip.replace(/^\//, ''))) ? memo.clip : null;

// the app icons on the lock screen: a rounded square in the app's colour with one white glyph (drawn, not Apple's);
// Intake's is the wrist (the memo came from the watch)
const ICON: Record<string, string> = {
  messages: '<path d="M12 4C7.6 4 4 7 4 10.6c0 2 1.1 3.8 2.9 5L6 19l3.6-1.8c.8.2 1.6.3 2.4.3 4.4 0 8-3 8-6.9S16.4 4 12 4z" fill="#fff"/>',
  intake: '<rect x="7" y="2.5" width="10" height="19" rx="3.2" fill="none" stroke="#fff" stroke-width="1.8"/><rect x="9.2" y="7.2" width="5.6" height="9.6" rx="1.4" fill="#fff"/>',
};
const TINT: Record<string, string> = { messages: '#34c759', intake: '#ff6b4a' };
const CHECK = '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 8.5l3.5 3.5 7.5-8.5"/></svg>';
const WORDS = memo.words.split(' ');
// the memo's wave: the watch's own bars (IntakeHero), half of them
const BARS = [4.43, 11.39, 22.15, 32.91, 22.78, 25.32, 29.11, 13.92, 26.58, 24.05, 10.76, 5.06, 2.53, 6.96, 16.46, 27.85, 30.38, 18.35, 35.44, 20.89, 18.99, 31.65, 15.82, 7.59];

// THE MONTH: one page per month a landing needs (today's first), each a grid of whole weeks from the Sunday on or
// before the 1st; every page the same number of rows (the tallest's), so the object never changes height
const NAMES = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
const DOW = ['S', 'M', 'T', 'W', 'T', 'F', 'S'];
const iso = (d: Date) => d.toISOString().slice(0, 10);
const ymOf = (s: string) => s.slice(0, 7);
const TODAY = cal.today;
type Land = { id: string; date: string; cal: string; title: string; time?: string };
const lands: Land[] = Object.entries(cal.lands).map(([id, l]) => ({ id, ...l }));
const landAt: Record<string, Land> = {};
for (const l of lands) landAt[l.date] = l;
const months = Array.from(new Set([ymOf(TODAY), ...lands.map((l) => ymOf(l.date))])).sort();
type Cell = { iso: string; d: number; other: boolean; today: boolean; land?: Land };
type Page = { ym: string; title: string; cells: Cell[]; rows: number };
const pages: Page[] = months.map((ym) => {
  const [y, m] = ym.split('-').map(Number);
  const first = new Date(Date.UTC(y, m - 1, 1));
  const start = new Date(first.getTime() - first.getUTCDay() * 86400000);
  const daysIn = new Date(Date.UTC(y, m, 0)).getUTCDate();
  const rows = Math.ceil((first.getUTCDay() + daysIn) / 7);
  const cells: Cell[] = [];
  for (let i = 0; i < rows * 7; i++) {
    const d = new Date(start.getTime() + i * 86400000);
    const s = iso(d);
    cells.push({ iso: s, d: d.getUTCDate(), other: d.getUTCMonth() !== m - 1, today: s === TODAY, land: landAt[s] });
  }
  return { ym, title: `${NAMES[m - 1]} ${y}`, cells, rows };
});
const ROWS = Math.max(...pages.map((p) => p.rows));
const pageOf = (id: string) => months.indexOf(ymOf(cal.lands[id as keyof typeof cal.lands].date));
const landPages = JSON.stringify(Object.fromEntries(lands.map((l) => [l.id, pageOf(l.id)])));
---
<section class="ica" data-ica data-mine={lock.items.length} data-pages={landPages} data-say-done={say.done} data-pace="400" data-seconds={memo.seconds} aria-label="Intake: five things sent to yourself, filed one at a time into one feed and the calendar">
  {clip && <audio data-clip preload="metadata" src={clip}></audio>}
  <div class="ica-top">
    {/* THE LOCK SCREEN: the date over the clock, the five things under them (newest first, as iOS stacks them), each a
        press; a press OPENS it (the picture full width in the pill; the memo into its strip) before it goes */}
    <div class="ica-phone" data-lock>
      <i class="shadow" aria-hidden="true"></i>
      <div class="screen">
        <div class="face">
          <div class="sb" aria-hidden="true"><span class="lock-g"><svg viewBox="0 0 12 14"><rect x="1" y="6" width="10" height="7" rx="1.6" fill="currentColor"/><path d="M3.5 6V4.2a2.5 2.5 0 0 1 5 0V6" fill="none" stroke="currentColor" stroke-width="1.4"/></svg></span><span class="batt"><i></i></span></div>
          <p class="date" aria-hidden="true">{lock.date}</p>
          <p class="clock" aria-hidden="true">{lock.time}</p>
          <ol class="pile" data-pile>
            {lock.items.map((n, i) => (
              <li class:list={['ntf', { memo: n.id === 'memo' }]} data-id={n.id} data-cards={n.cards.join(' ')} data-land={n.land} data-say={n.say} style={`--i:${i};--tint:${TINT[n.icon] || '#8e8e93'}`}>
                <span class="ico" aria-hidden="true"><svg viewBox="0 0 24 24" set:html={ICON[n.icon] || ''} /></span>
                <span class="txt" aria-hidden="true">
                  <span class="row"><b class="app">{n.app}</b><span class="when">{n.when}</span></span>
                  <b class="t">{n.title}</b>
                  <span class="b">{n.body}</span>
                </span>
                {n.thumb && <img class="th" src={n.thumb} alt="" width="80" height="80" decoding="async" aria-hidden="true" />}
                {/* THE OPENING: the thing itself, full width in the pill (iOS's long-press), closed at rest */}
                {n.open && (
                  <div class="more" data-more aria-hidden="true">
                    <img class="big" src={n.open.src} width={n.open.w} height={n.open.h} alt="" decoding="async" loading="lazy" />
                  </div>
                )}
                {n.id === 'memo' && (
                  <div class="more mstrip" data-more data-mstrip aria-hidden="true">
                    <div class="mtop">
                      <span class="mwave" data-mwave>{BARS.map((h, k) => <i style={`height:${(h * 0.52 + 1.4).toFixed(2)}cqw;animation-delay:-${((k * 0.37) % 1.6).toFixed(2)}s`}></i>)}</span>
                      <span class="mclock" data-mclock>0:00</span>
                    </div>
                    <p class="mwords" data-mwords>{WORDS.map((w) => <span class="w">{w} </span>)}</p>
                  </div>
                )}
                <button class="hit" type="button" data-press aria-label={n.label}></button>
              </li>
            ))}
          </ol>
        </div>
      </div>
      <img class="body" src="/archive/phone-blank.png" alt="" width="864" height="1760" decoding="async" loading="lazy" draggable="false" />
    </div>

    {/* INTAKE'S CARDS (round two, 2026-10-21, Jon: "Maybe just the outline of a phone, literally a thin border, and
        then just focus on the parts of UI they need to see"): the phone's silhouette as one hairline on the paper,
        empty at rest; inside, only the cards: a receipt is the ✓ and its title over the compact line, an open card its
        title over its one line (the thumb only where the thing was an image). The six stand in the flow unseen (the
        list is reserved to its fullest state); a landing shows the next one, moved up to the landed group so the list
        fills top down */}
    <div class="ica-app" data-app aria-hidden="true">
      <i class="sil"></i>
      <div class="feed" data-feed>
        {feed.cards.map((c) => (
          <article class:list={['tk', c.state]} data-card={c.id}>
            <div class="tmain">
              <h3 class="tt">{c.state === 'receipt' && <span class="rc" set:html={CHECK} />}{c.title}</h3>
              <p class="what">{c.what}</p>
            </div>
            {c.thumb && <img class="mthumb" src={c.thumb} alt="" width="88" height="88" decoding="async" />}
          </article>
        ))}
      </div>
    </div>

    {/* THE MONTH (Jon: "we're missing the beauty of the calendar … that also changes"; the ribbon was "not good
        enough to be relevant"): his calendar as the iPhone draws a month, a panel the phone's height beside Intake so
        the whole moment stands in one screen (beneath, the rows the bars take fell under the fold at 1440 × 900): the
        month's name, the weekday letters, the bold numerals, the other months' days dim, today in its red ring; the
        bars in the two calendars' colours (Intake red, Idea yellow, as cal-before / cal-after wear them). One page per
        month a landing needs; a dated landing slides the track to that page (520 ms) and the day takes its bar.
        Reduced motion: jumps */}
    <div class="cm" data-cal style={`--p:0;--rows:${ROWS}`} aria-hidden="true">
      <div class="cm-win">
        <div class="cm-track" data-track>
          {pages.map((p) => (
          <div class="cm-page" data-ym={p.ym}>
            <p class="cm-title">{p.title}</p>
            <div class="cm-head">{DOW.map((w) => <span class="cm-w">{w}</span>)}</div>
            <ol class="cm-grid">
              {p.cells.map((c) => (
                <li class:list={['cm-day', { other: c.other, today: c.today }]}>
                  <span class="cm-n">{c.d}</span>
                  {c.land && <span class="cm-bar" data-bar={c.land.id} data-cal={c.land.cal}><b>{c.land.title}</b>{c.land.time && <i>{c.land.time}</i>}</span>}
                </li>
              ))}
            </ol>
          </div>
          ))}
        </div>
      </div>
    </div>
  </div>

  <div class="foot">
    {/* "you're watching" (2026-10-19): the press → its landing; no hint, ever (Jon, 2026-10-20) */}
    <span class="runline" aria-hidden="true" data-runline><i></i></span>
    <button type="button" class="replay" data-replay aria-label="Replay: put the five things back and file them again">
      <svg viewBox="0 0 20 20" class="ico" aria-hidden="true"><path d="M4 10a6 6 0 1 0 1.8-4.3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M4 3v3.5h3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      Replay
    </button>
  </div>
  <p class="sr" role="status" aria-live="polite" data-status></p>
</section>

<style>
  .ica {
    --ink: var(--sheet-ink, #141210);
    --ground: #e9e8e5;
    --acc: var(--sheet-acc, #ff6b4a);
    --ring-a: #47B6FF; --ring-b: #8A5CF6; /* the touch signal: the watch's ring's pair (AudioDexDoor's) */
    --hint-mix: 74%; /* #ff6b4a mixed toward the sheet ink until 4.5:1 (IntakeHero's rule): the runline's fill */
    --sans: -apple-system, 'Instrument Sans', 'Helvetica Neue', system-ui, sans-serif;
    --mono: var(--sheet-mono, 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace);
    /* the lock screen by day: a light wallpaper, frosted glass, black type (iOS's light look) */
    --wall: linear-gradient(165deg, #cfe0f4 0%, #e3d6ee 42%, #f4dfcc 100%);
    --glass: rgba(255, 255, 255, 0.64); --glass-ink: #0b0b0d; --glass-dim: rgba(20, 20, 24, 0.56); --sfg: #1a1a1c;
    --rcpt: #79a465; /* the receipt's ✓: Intake's own green (intake_web.py) */
    /* the month: the iPhone's Calendar by day (white, hairlines, red today) and the two calendars' bars as cal-before /
       cal-after wear them */
    --cm-ground: #fff; --cm-line: color-mix(in oklab, var(--ink) 12%, transparent); --cm-ink: #111; --cm-dim: #a7a7ad; --cm-red: #ff3b30;
    --cal-intake-bg: #ffd1da; --cal-intake-ink: #8a1631; --cal-intake-time: #c22a4d;
    --cal-idea-bg: #fde6b4; --cal-idea-ink: #6e4600; --cal-idea-time: #a26a08;
    --dim: color-mix(in oklab, var(--ink) 58%, transparent);
    --edge: color-mix(in oklab, var(--ink) 16%, transparent);
    position: relative;
    container: ica / inline-size;
    width: 100%;
    color: var(--ink);
    font-family: var(--sans);
  }
  :global(html[data-night]) .ica {
    --ground: #0b0e14; --hint-mix: 100%;
    --wall: linear-gradient(165deg, #182746 0%, #2d2047 48%, #1a1b2e 100%);
    --glass: rgba(52, 52, 60, 0.7); --glass-ink: #fff; --glass-dim: rgba(255, 255, 255, 0.58); --sfg: #f2f2f5;
    --cm-ground: #1c1c1f; --cm-line: rgba(255, 255, 255, 0.14); --cm-ink: #f2f2f5; --cm-dim: #6b6b72;
    --cal-intake-bg: color-mix(in oklab, #ff375f 30%, #1c1c1f); --cal-intake-ink: #ffc2cf; --cal-intake-time: #ff8fa6;
    --cal-idea-bg: color-mix(in oklab, #ffcc00 24%, #1c1c1f); --cal-idea-ink: #ffe3a3; --cal-idea-time: #f2bd52;
  }
  .sr { position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .ico { width: 1em; height: 1em; flex: none; }

  /* ── the top: THREE COLUMNS the phone's height, all in one screen: the phone at the host's cap (--ica-w), INTAKE's
     cards in its twin outline (round two: the phone's width), THE MONTH taking the rest; one gutter */
  .ica-top {
    --pw: var(--ica-w, 28cqw); /* the phone's width: the host's cap on a wide sheet, 40cqw on a middling one */
    display: grid;
    grid-template-columns: minmax(0, var(--pw)) minmax(0, var(--pw)) minmax(0, 1fr);
    /* the ROW is at least the phone's own height, written out (its width × 1760/864): left auto, the row grew to
       Intake's reserved list and the phone, stretched, followed its aspect ratio PAST its column (288 in a 202
       column at 1024). The phone and its twin outline keep their own height (align-self: start); the month fills the row */
    grid-template-rows: minmax(calc(var(--pw) * 1760 / 864), auto);
    column-gap: var(--ica-gap, 24px); /* the photographed body's buttons stand outside its column: 20 overlapped the panel */
    align-items: stretch;
  }
  /* ── the phone (the photographed body, the screen drawn under its cut-out: AudioDexDoor's numbers) */
  .ica-phone {
    position: relative; align-self: start; width: 100%;
    aspect-ratio: 864 / 1760;
    container: phone / inline-size;
    -webkit-tap-highlight-color: transparent;
  }
  .shadow { position: absolute; inset: 0.6% 1.2%; border-radius: 16.2% / 7.95%; box-shadow: 0 2.2cqw 5cqw rgba(20, 16, 10, 0.26), 0 0.6cqw 1.4cqw rgba(20, 16, 10, 0.16); }
  :global(html[data-night]) .ica .shadow { box-shadow: 0 2.6cqw 6cqw rgba(0, 0, 0, 0.7), 0 0.6cqw 1.4cqw rgba(0, 0, 0, 0.5); }
  .screen {
    position: absolute; z-index: 1; left: 4.745%; top: 1.875%; width: 90.51%; height: 96.25%;
    border-radius: 13.8% / 6.38%; overflow: hidden; background: var(--wall); color: var(--sfg);
    -webkit-font-smoothing: antialiased;
  }
  .body { position: absolute; inset: 0; z-index: 2; width: 100%; height: 100%; pointer-events: none; user-select: none; }
  /* the presses are the five items themselves: the body image takes no pointer, so a click reaches the pill under it */

  /* ── the face (the phone's cqw; the screen is 90.51 of them wide, ≈ 196 tall) */
  .face { position: absolute; inset: 0; display: flex; flex-direction: column; font-size: 4cqw; line-height: 1.25; }
  .sb { position: relative; height: 10.4cqw; flex: none; }
  .lock-g { position: absolute; left: 50%; top: 6.2cqw; width: 2.6cqw; height: 3cqw; margin-left: -1.3cqw; color: currentColor; }
  .lock-g svg { display: block; width: 100%; height: 100%; }
  .batt { position: absolute; right: 8.4cqw; top: 5.2cqw; width: 6cqw; height: 2.9cqw; box-sizing: border-box; border: 0.35cqw solid currentColor; border-radius: 0.9cqw; opacity: 0.9; }
  .batt::after { content: ''; position: absolute; right: -1cqw; top: 0.6cqw; width: 0.5cqw; height: 1.1cqw; background: currentColor; border-radius: 0 0.3cqw 0.3cqw 0; }
  .batt i { position: absolute; inset: 0.35cqw; width: 70%; background: currentColor; border-radius: 0.35cqw; }
  /* THE LOCK SCREEN: the date over the clock (the thin large numerals), the five under them */
  .date { margin: 2.4cqw 0 0; text-align: center; font-size: 4.2cqw; font-weight: 600; letter-spacing: -0.005em; }
  .clock { margin: -0.6cqw 0 0; text-align: center; font-size: 21cqw; font-weight: 200; line-height: 1.05; letter-spacing: -0.03em; font-variant-numeric: tabular-nums; }
  .pile { list-style: none; margin: 5cqw 0 0; padding: 0 2.6cqw; display: flex; flex-direction: column; }
  .ntf {
    position: relative;
    display: grid; grid-template-columns: 10cqw minmax(0, 1fr) auto; align-items: center; column-gap: 2.6cqw;
    box-sizing: border-box; margin: 0 0 1.6cqw; padding: 2.6cqw 3cqw 2.7cqw; border-radius: 5.2cqw;
    background: var(--glass); -webkit-backdrop-filter: blur(18px); backdrop-filter: blur(18px); color: var(--glass-ink);
    transition: transform 160ms ease, opacity 300ms ease;
  }
  .ico { display: grid; place-items: center; width: 10cqw; height: 10cqw; border-radius: 2.6cqw; background: var(--tint); box-shadow: inset 0 0 0 0.3cqw rgba(255, 255, 255, 0.12); }
  .ntf .ico svg { width: 6.8cqw; height: 6.8cqw; }
  .ntf .txt { display: flex; flex-direction: column; min-width: 0; gap: 0.3cqw; }
  .ntf .row { display: flex; align-items: baseline; justify-content: space-between; gap: 2cqw; }
  .ntf .app { font-size: 3.5cqw; font-weight: 600; letter-spacing: 0.005em; }
  .ntf .when { font-size: 3.2cqw; color: var(--glass-dim); white-space: nowrap; }
  .ntf .t { font-size: 3.9cqw; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ntf .b { font-size: 3.9cqw; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .ntf .th { width: 10.4cqw; height: 10.4cqw; border-radius: 2.2cqw; object-fit: cover; }
  /* THE PRESS: the hit covers the pill; THE TOUCH SIGNAL (one vocabulary with the watch and the AudioDex phones): the
     rim and its inward light breathe on each until it is pressed; hover = still and full */
  .hit { position: absolute; inset: 0; z-index: 2; margin: 0; padding: 0; border: 0; background: transparent; border-radius: inherit; cursor: pointer; -webkit-tap-highlight-color: transparent; }
  .hit:focus-visible { outline: 0.6cqw solid var(--ring-a); outline-offset: 0.3cqw; }
  .ntf::before, .ntf::after { content: ''; position: absolute; inset: 0; border-radius: inherit; pointer-events: none; animation: touch-breathe 2s ease-in-out infinite; transition: opacity 0.35s; }
  .ntf::after {
    box-sizing: border-box; padding: 0.55cqw; background: linear-gradient(135deg, var(--ring-a), var(--ring-b));
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor;
    mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); mask-composite: exclude;
  }
  .ntf::before { box-shadow: inset 1.6cqw 1.6cqw 4cqw color-mix(in oklab, var(--ring-a) 40%, transparent), inset -1.6cqw -1.6cqw 4cqw color-mix(in oklab, var(--ring-b) 40%, transparent); }
  .ntf:has(.hit:hover)::before, .ntf:has(.hit:hover)::after { animation: none; opacity: 1; }
  /* an EXACT COPY of the watch's keyframe (IntakeHero.astro, AudioDexDoor.astro): change both or neither */
  @keyframes touch-breathe { 0%, 100% { opacity: 0.45; } 50% { opacity: 1; } }
  /* THE OPENING (iOS's long-press): the pressed pill lifts and opens to the thing itself; the others step back */
  .ntf.lift { transform: scale(1.03); z-index: 3; }
  .ntf.lift::before, .ntf.lift::after { animation: none; opacity: 0; }
  .busy .ntf:not(.lift):not(.gone) { opacity: 0.3; }
  .busy .ntf:not(.lift)::before, .busy .ntf:not(.lift)::after { animation: none; opacity: 0; }
  .more { grid-column: 1 / -1; height: 0; overflow: hidden; transition: height 320ms cubic-bezier(0.2, 0.8, 0.2, 1); }
  .big { display: block; width: 100%; height: auto; margin-top: 2.6cqw; border-radius: 3cqw; }
  /* a pressed item goes (the flyer carries its picture); its slot closes under it */
  .ntf.gone { visibility: hidden; }
  .ntf.gone::before, .ntf.gone::after { animation: none; opacity: 0; }
  .ntf.closed { height: 0 !important; margin-bottom: 0; padding-top: 0; padding-bottom: 0; overflow: hidden; }
  .ntf.closing { transition: height 320ms ease, margin 320ms ease, padding 320ms ease; }
  /* THE MEMO'S STRIP: the pill opens into the wave (the sheet's accent), the clock and the words, typed as spoken */
  .mstrip { transition: height 300ms ease; }
  .mtop { display: flex; align-items: center; gap: 3cqw; padding: 2.6cqw 0.4cqw 1.2cqw; }
  .mwave { display: flex; align-items: center; gap: 1cqw; height: 9cqw; flex: 1; }
  .mwave i { display: block; width: 1.3cqw; border-radius: 0.7cqw; background: var(--acc); transform: scaleY(0.35); }
  .playing .mwave i { animation: ica-bar 1.6s ease-in-out infinite; }
  .mclock { font: 500 3.6cqw/1 var(--mono); font-variant-numeric: tabular-nums; color: var(--glass-dim); }
  .mwords { margin: 0; padding: 0 0.4cqw 1cqw; font-size: 3.9cqw; line-height: 1.35; min-height: calc(3.9cqw * 1.35 * 4); }
  .mwords .w { opacity: 0; transition: opacity 180ms ease; }
  .mwords .w.said { opacity: 1; }
  @keyframes ica-bar { 0%, 100% { transform: scaleY(0.35); } 50% { transform: scaleY(1); } }

  /* THE FLYER: the open pill's picture on the one arc from the lock screen to Intake's list (host-level, over both);
     its wrap is a container the phone's width, so the pill's cqw hold on the arc */
  .flyer { position: absolute; left: 0; top: 0; z-index: 6; pointer-events: none; transform-origin: 0 0; container-type: inline-size; }
  .flyer > .ntf { margin: 0; opacity: 1; }
  .flyer > .ntf::before, .flyer > .ntf::after { animation: none; opacity: 0; }
  .flyer > .ntf .more { height: auto; }
  .flyer > .mstrip { box-sizing: border-box; padding: 0 3cqw; border-radius: 5.2cqw; background: var(--glass); color: var(--glass-ink); -webkit-backdrop-filter: blur(18px); backdrop-filter: blur(18px); }

  /* ── INTAKE'S CARDS (round two, 2026-10-21, Jon: "What matters is showing the cards"): no app costume. The box is
     the lock screen's twin (the phone's width, its aspect ratio, so the row never changes); the hairline is the
     body's silhouette (the shadow's inset and corners), 1px, the sheet ink at 14 %; the cards stand in the screen's
     rectangle on the paper, the sheet's faces, hairlines between them. The list clips at the foot like a screen */
  .ica-app {
    position: relative; align-self: start; justify-self: center; width: 100%; min-width: 0;
    aspect-ratio: 864 / 1760;
    container: app / inline-size;
    color: var(--ink);
  }
  .sil { position: absolute; inset: 0.6% 1.2%; border-radius: 16.2% / 7.95%; border: 1px solid color-mix(in oklab, var(--ink) 14%, transparent); pointer-events: none; }
  .feed { position: absolute; left: 4.745%; top: 1.875%; width: 90.51%; height: 96.25%; box-sizing: border-box; padding: 10cqw 7cqw 6cqw; overflow: hidden; }
  /* a card: the title (Instrument Sans) over its one line (the label face, dim); a receipt's ✓ in Intake's green
     before its title; the thumb at the right where the thing was an image. Unseen until it lands */
  .tk { display: flex; align-items: center; gap: 10px; padding: 11px 0; opacity: 0; }
  .tk + .tk { border-top: 1px solid color-mix(in oklab, var(--ink) 14%, transparent); }
  .tk.in { opacity: 1; transition: opacity 220ms ease; }
  .tmain { flex: 1; min-width: 0; }
  .tt { margin: 0; font: 600 14px/1.3 'Instrument Sans', -apple-system, 'Helvetica Neue', system-ui, sans-serif; letter-spacing: -0.005em; color: var(--ink); text-wrap: pretty; }
  .rc { display: inline-block; width: 13px; height: 13px; margin-right: 6px; vertical-align: -1px; color: var(--rcpt); }
  .rc :global(svg) { display: block; width: 100%; height: 100%; }
  .what { margin: 3px 0 0; font: 500 11px/1.35 var(--mono); letter-spacing: 0.02em; color: var(--dim); }
  .receipt .what { padding-left: 19px; } /* under the title, past the ✓ */
  .mthumb { flex: none; width: 40px; height: 40px; border-radius: 6px; object-fit: cover; object-position: 18% 60%; }

  /* ── THE MONTH: the iPhone's Calendar grammar at the object's width. The weekday letters stand still over a window;
     the pages (one per month) ride a track that slides to --p. Each page: the month's name, then the grid (whole weeks,
     --rows of them at --row each: fixed). Today's numeral white in the red ring; the other months' days dim */
  .cm {
    position: relative; display: flex; flex-direction: column; min-width: 0; box-sizing: border-box;
    border: 1px solid var(--cm-line); border-radius: 16px; background: var(--cm-ground); color: var(--cm-ink);
    padding: 12px 10px 10px;
    font-family: -apple-system, 'Instrument Sans', 'Helvetica Neue', system-ui, sans-serif;
    transition: background 560ms ease, color 560ms ease, border-color 560ms ease;
  }
  .cm-win { flex: 1; min-height: 0; overflow: hidden; }
  .cm-track { display: flex; height: 100%; transform: translateX(calc(var(--p, 0) * -100%)); transition: transform 520ms cubic-bezier(0.25, 0.8, 0.25, 1); }
  .cm-page { flex: none; display: flex; flex-direction: column; width: 100%; height: 100%; }
  .cm-title { margin: 0; padding: 2px 6px 8px; font-size: 16px; font-weight: 700; letter-spacing: -0.01em; }
  .cm-head { display: grid; grid-template-columns: repeat(7, 1fr); padding: 0 0 5px; border-bottom: 1px solid var(--cm-line); }
  .cm-w { text-align: center; font-size: 11px; font-weight: 600; color: var(--cm-dim); }
  /* the rows share the panel's height (the phone's); beneath, on a middling sheet, they are a fixed 58px */
  .cm-grid { list-style: none; margin: 0; padding: 0; flex: 1; min-height: 0; display: grid; grid-template-columns: repeat(7, 1fr); grid-auto-rows: minmax(0, 1fr); }
  .cm-day { position: relative; display: flex; flex-direction: column; align-items: center; padding-top: 3px; border-top: 1px solid var(--cm-line); min-width: 0; }
  .cm-grid .cm-day:nth-child(-n + 7) { border-top-color: transparent; }
  .cm-n { display: grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; font-size: 15px; font-weight: 600; font-variant-numeric: tabular-nums; letter-spacing: -0.02em; }
  .cm-day.other .cm-n { color: var(--cm-dim); }
  .cm-day.today .cm-n { background: var(--cm-red); color: #fff; }
  /* the bar under the numeral (the iPhone's: the title over the time, up to three lines, the colour's fill): lit by
     its landing with the pop the pile's bars had */
  .cm-bar {
    position: absolute; left: 1px; right: 1px; top: 30px; box-sizing: border-box; padding: 3px 4px; border-radius: 4px;
    display: flex; flex-direction: column; gap: 1px; min-width: 0;
    background: var(--cal-intake-bg); color: var(--cal-intake-ink);
    opacity: 0; transform: scale(0.7); transform-origin: 0 0; transition: opacity 180ms ease, transform 260ms cubic-bezier(0.2, 0.9, 0.25, 1.15);
  }
  .cm-bar b { font-size: 10.5px; font-weight: 700; line-height: 1.15; letter-spacing: -0.01em; display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }  /* 2026-10-21 (round two left the month 19px narrower and "Thundercat" broke across three lines): one line, cut with an ellipsis, as the iPhone's month cuts a long title */
  .cm-bar i { font-style: normal; font-size: 10.5px; line-height: 1.15; color: var(--cal-intake-time); }
  .cm-bar[data-cal='idea'] { background: var(--cal-idea-bg); color: var(--cal-idea-ink); }
  .cm-bar[data-cal='idea'] i { color: var(--cal-idea-time); }
  .cm-bar[data-on] { opacity: 1; transform: none; }
  /* a middling sheet (a 1024 desk): the phone and Intake side by side, the month beneath them at the sheet's width */
  @container ica (max-width: 899px) {
    .ica-top { --pw: 40cqw; grid-template-columns: minmax(0, var(--pw)) minmax(0, 1fr); }
    .ica-app { width: var(--pw); } /* the outline the phone's twin, centred in what is left */
    .cm { grid-column: 1 / -1; margin-top: 20px; }
    .cm-page { height: auto; }
    .cm-grid { grid-auto-rows: 58px; flex: none; }
    .cm-bar b { -webkit-line-clamp: 1; white-space: nowrap; text-overflow: ellipsis; display: block; }
  }

  /* ── the foot: the runline through each press, Replay after the fifth; one slot, no hint */
  .foot { display: grid; min-height: 30px; margin-top: 16px; align-items: start; justify-items: center; }
  .foot > * { grid-area: 1 / 1; }
  /* THE REPLAY: the AudioDex foot carries the same pill (AudioDexDoor's .replay); change both or neither */
  .replay {
    display: inline-flex; align-items: center; gap: 6px; padding: 8px 14px; border: 0; border-radius: 999px;
    background: var(--ink); color: var(--ground); font: 500 0.72rem/1 var(--mono); letter-spacing: 0.04em;
    cursor: pointer; opacity: 0; pointer-events: none; transition: opacity 0.4s, background 120ms, color 560ms ease;
  }
  .replay .ico { width: 1.1em; height: 1.1em; }
  .replay:hover { background: color-mix(in oklab, var(--ink) 82%, var(--ground)); }
  .replay:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
  .done .replay { opacity: 1; pointer-events: auto; transition: opacity 0.6s 0.8s, background 120ms, color 560ms ease; }
  /* "YOU'RE WATCHING" (2026-10-19): one hairline in the foot's slot from the press until the run lands, so nothing
     below moves; the accent fills it left to right, linearly, over the press's planned length (the script's own
     numbers). In 200 on the press, out 400 at the landing. Not a control: aria-hidden, no pointer, no label. Reduced
     motion: none. EXACT COPY in IntakeHero.astro and AudioDexDoor.astro: change both or neither */
  .runline {
    grid-area: 1 / 1; align-self: center; width: 96px; height: 1.5px;
    background: color-mix(in oklab, var(--sheet-ink) 14%, transparent);
    opacity: 0; pointer-events: none; transition: opacity 400ms ease;
  }
  .runline > i {
    display: block; height: 100%; transform: scaleX(0); transform-origin: left;
    background: color-mix(in oklab, var(--sheet-acc) var(--hint-mix), var(--sheet-ink));
  }
  [data-running] .runline { opacity: 1; transition-duration: 200ms; }
  @media (max-width: 899px) { .runline { width: 72px; } }
  @media (prefers-reduced-motion: reduce) { .runline { display: none; } }

  /* ── a narrow sheet: the lock screen smaller and centred, the outline its twin under it (round two), the month
     under that */
  @container ica (max-width: 619px) {
    .ica-top { grid-template-columns: minmax(0, 1fr); grid-template-rows: none; row-gap: 20px; }
    .ica-phone { width: 82cqw; justify-self: center; } /* the room's only object on a phone: as large as the pile's */
    .ica-app { width: 82cqw; }
    .cm { margin-top: 0; }
    .cm-grid { grid-auto-rows: 54px; }
    .cm-bar { top: 29px; padding: 2px 4px; }
    .cm-bar i { display: none; } /* the time would cut at the row's foot: the title alone on a phone */
  }

  /* a replay puts everything back in one step, no stagger */
  .still .ntf, .still .tk, .still .cm-track, .still .cm-bar, .still .more, .still .mwords .w { transition: none; }
  @media (prefers-reduced-motion: reduce) {
    .ntf::before, .ntf::after { animation: none; opacity: 0.75; }
    .ntf, .tk, .tk.in, .cm-track, .cm-bar, .more, .mwords .w, .ntf.closing { transition: none; }
    .playing .mwave i { animation: none; transform: scaleY(0.6); }
  }
</style>

<script>
  /* Drives every [data-ica]. Plain JS. Five presses file the phone; nothing starts by itself. */
  const OPEN = 320, HOLD = 600, LIFT = 160, FLY = 500, CLOSE = 320, CAL_AFTER = 300, SLIDE = 520, STRIP = 300, TICKET_GAP = 300;
  // the line's fill: from empty to full, linearly, over the press's planned ms (or at once to full, ms 0)
  const fillLine = (fill, ms) => {
    if (!fill) return;
    fill.style.transition = 'none';
    fill.style.transform = ms ? 'scaleX(0)' : 'scaleX(1)';
    if (!ms) return;
    void fill.offsetWidth;
    fill.style.transition = `transform ${ms}ms linear`;
    fill.style.transform = 'scaleX(1)';
  };
  const fmt = (s) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;

  function init(root) {
    if (root.dataset.ready) return;
    root.dataset.ready = '1';
    const status = root.querySelector('[data-status]');
    const replay = root.querySelector('[data-replay]');
    const runFill = root.querySelector('[data-runline] > i');
    const feed = root.querySelector('[data-feed]');
    const cards = Array.from(root.querySelectorAll('[data-card]'));
    const cardOrder = cards.slice();
    const cardOf = (id) => cards.find((c) => c.dataset.card === id);
    const items = Array.from(root.querySelectorAll('.ntf'));
    const calEl = root.querySelector('[data-cal]');
    const pages = JSON.parse(root.dataset.pages || '{}');
    const audio = root.querySelector('[data-clip]');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    const mine = Number(root.dataset.mine) || items.length;
    let timers = [];
    let running = false;
    let sorted = 0;
    const later = (ms, fn) => timers.push(window.setTimeout(fn, ms));
    const say = (m) => { if (status) { status.textContent = ''; later(30, () => { status.textContent = m; }); } };
    const rel = (el) => { const a = el.getBoundingClientRect(), b = root.getBoundingClientRect(); return { x: a.left - b.left, y: a.top - b.top, w: a.width, h: a.height }; };

    // THE MONTH: slide to the landing's page (or stay) and light its bar as the slide ends
    const pageNow = () => Number(getComputedStyle(calEl).getPropertyValue('--p')) || 0;
    const calTo = (barId) => {
      const bar = root.querySelector(`[data-bar="${barId}"]`);
      const p = pages[barId] ?? pageNow();
      const moving = p !== pageNow();
      calEl.style.setProperty('--p', String(p));
      const light = () => { if (bar) bar.setAttribute('data-on', ''); };
      if (reduce.matches || !moving) { later(reduce.matches ? 0 : 200, light); return; }
      later(SLIDE - 120, light);
    };
    const calMs = (barId) => (reduce.matches ? 0 : pages[barId] !== pageNow() ? CAL_AFTER + SLIDE : CAL_AFTER + 200);

    // THE ONE ARC: the open pill's picture flies from its place on the lock screen to the card's place in the list
    // and is the card as it lands (the card moves up to the landed group first, so the list fills top down)
    const place = (card) => {
      const inFeed = Array.from(feed.querySelectorAll('[data-card]'));
      const lastIn = inFeed.filter((c) => c.classList.contains('in')).pop();
      if (lastIn) lastIn.after(card); else feed.prepend(card);
    };
    const fly = (fromEl, card, onLand) => {
      place(card);
      root.classList.add('started');
      if (reduce.matches) { card.classList.add('in'); onLand && onLand(); return 0; }
      const a = rel(fromEl), b = rel(card);
      const phone = fromEl.closest('.ica-phone');
      const wrap = document.createElement('div');
      for (const at of fromEl.attributes) if (at.name.startsWith('data-astro-cid')) wrap.setAttribute(at.name, '');
      wrap.className = 'flyer';
      wrap.style.width = `${phone.getBoundingClientRect().width}px`;
      const ghost = fromEl.cloneNode(true);
      ghost.classList.remove('lift', 'memo');
      ghost.querySelectorAll('.hit').forEach((n) => n.remove());
      ghost.style.width = `${a.w}px`; ghost.style.height = `${a.h}px`;
      ghost.style.setProperty('--tint', getComputedStyle(fromEl).getPropertyValue('--tint'));
      wrap.appendChild(ghost);
      root.appendChild(wrap);
      // it shrinks into the card's place (never grows): the card appears under it as it arrives
      const s = Math.min(b.w / a.w, b.h / a.h, 1);
      const mx = (a.x + b.x) / 2, my = Math.min(a.y, b.y) - 40;
      const anim = wrap.animate([
        { transform: `translate(${a.x}px, ${a.y}px) scale(1)`, opacity: 1 },
        { transform: `translate(${mx}px, ${my}px) scale(${(1 + s) / 2})`, opacity: 1, offset: 0.5 },
        { transform: `translate(${b.x}px, ${b.y}px) scale(${s})`, opacity: 1, offset: 0.8 },
        { transform: `translate(${b.x}px, ${b.y}px) scale(${s})`, opacity: 0 },
      ], { duration: FLY, easing: 'cubic-bezier(0.3, 0.6, 0.3, 1)', fill: 'forwards' });
      later(FLY * 0.72, () => { card.classList.add('in'); });
      anim.onfinish = () => { wrap.remove(); onLand && onLand(); };
      return FLY;
    };
    // the pressed pill lifts and opens; then goes, and its slot closes
    const lift = (li) => { li.classList.add('lift'); root.classList.add('busy'); };
    const open = (li) => { const m = li.querySelector('[data-more]'); if (m) m.style.height = `${m.scrollHeight}px`; };
    const close = (li) => {
      li.style.height = `${li.offsetHeight}px`;
      li.classList.add('gone');
      void li.offsetWidth;
      li.classList.add('closing', 'closed');
      root.classList.remove('busy');
    };
    const afterPress = (li) => {
      sorted++;
      say(li.dataset.say || '');
      if (sorted >= mine) later(0, () => { root.classList.add('done'); say(root.dataset.sayDone || ''); });
      root.removeAttribute('data-running');
      running = false;
    };

    // a plain item: open (if there is anything to open) → fly → the card; the month after a dated landing
    const pressItem = (li) => {
      const card = cardOf((li.dataset.cards || '').split(' ')[0]);
      const land = li.dataset.land;
      const more = li.querySelector('[data-more]');
      const R = reduce.matches;
      const lead = R ? 0 : more ? OPEN + HOLD : LIFT;
      const total = R ? 0 : lead + FLY + (land ? calMs(land) : CLOSE) - 60;
      if (!R) { root.setAttribute('data-running', ''); fillLine(runFill, total); }
      lift(li);
      if (more && !R) open(li);
      later(lead, () => {
        fly(li, card, () => {});
        close(li);
        if (land) later(R ? 0 : FLY + CAL_AFTER - 60, () => calTo(land));
      });
      later(total, () => afterPress(li));
    };

    // THE MEMO: the strip opens, the words type as spoken (or pace to the sound's length), then the two tickets fly
    // one at a time and the month takes the reminder
    const pressMemo = (li) => {
      const strip = li.querySelector('[data-mstrip]');
      const words = Array.from(li.querySelectorAll('.mwords .w'));
      const clock = li.querySelector('[data-mclock]');
      const ids = (li.dataset.cards || '').split(' ');
      const land = li.dataset.land;
      const R = reduce.matches;
      const secs = Number(root.dataset.seconds) || 18;
      let pace = Number(root.dataset.pace) || 400;
      let playMs = words.length * pace;
      if (audio && audio.duration && isFinite(audio.duration)) { playMs = audio.duration * 1000; pace = playMs / words.length; }
      const total = R ? 0 : STRIP + playMs + 200 + LIFT + FLY + TICKET_GAP + FLY + calMs(land);
      if (!R) { root.setAttribute('data-running', ''); fillLine(runFill, total); }
      lift(li);
      if (R) {
        words.forEach((w) => w.classList.add('said'));
        ids.forEach((id) => fly(li, cardOf(id)));
        calTo(land);
        close(li);
        later(0, () => afterPress(li));
        return;
      }
      open(li);
      root.classList.add('playing');
      li.classList.remove('lift');
      li.classList.add('lift');
      if (audio) { try { audio.currentTime = 0; audio.play().catch(() => {}); } catch (_) { /* no sound */ } }
      const t0 = performance.now() + STRIP;
      words.forEach((w, k) => later(STRIP + k * pace, () => w.classList.add('said')));
      // the clock paces to the words (the memo's 0:18 over the play), to the sound when there is one
      const tick = () => {
        const f = Math.min(1, (performance.now() - t0) / playMs);
        clock.textContent = fmt(Math.max(0, f) * secs);
        if (f < 1) timers.push(window.setTimeout(tick, 120));
      };
      later(STRIP, tick);
      let t = STRIP + playMs + 200;
      later(t, () => { root.classList.remove('playing'); clock.textContent = fmt(secs); });
      t += LIFT;
      later(t, () => fly(strip, cardOf(ids[0])));
      t += FLY + TICKET_GAP;
      later(t, () => { fly(strip, cardOf(ids[1])); });
      later(t + FLY + CAL_AFTER - 60, () => calTo(land));
      later(t + FLY, () => close(li));
      later(total, () => afterPress(li));
    };

    const press = (li) => {
      if (running || li.classList.contains('gone')) return;
      running = true;
      if (li.classList.contains('memo')) pressMemo(li); else pressItem(li);
    };

    const reset = () => {
      timers.forEach(clearTimeout); timers = [];
      root.classList.add('still');
      root.classList.remove('started', 'done', 'playing', 'busy');
      root.removeAttribute('data-running');
      root.querySelectorAll('.flyer').forEach((f) => f.remove());
      items.forEach((li) => { li.classList.remove('lift', 'gone', 'closing', 'closed'); li.style.height = ''; });
      root.querySelectorAll('[data-more]').forEach((m) => { m.style.height = ''; });
      root.querySelectorAll('.mwords .w').forEach((w) => w.classList.remove('said'));
      const clock = root.querySelector('[data-mclock]'); if (clock) clock.textContent = '0:00';
      if (audio) { try { audio.pause(); audio.currentTime = 0; } catch (_) { /* fine */ } }
      // the cards back to their resting order, unseen
      cards.forEach((c) => c.classList.remove('in'));
      cardOrder.forEach((c) => feed.appendChild(c));
      root.querySelectorAll('[data-bar]').forEach((b) => b.removeAttribute('data-on'));
      calEl.style.setProperty('--p', '0');
      void root.offsetWidth;
      root.classList.remove('still');
      sorted = 0; running = false;
    };

    items.forEach((li) => { const b = li.querySelector('[data-press]'); if (b) b.addEventListener('click', () => press(li)); });
    if (replay) replay.addEventListener('click', reset);
  }
  const all = () => document.querySelectorAll('[data-ica]').forEach(init);
  all();
  document.addEventListener('astro:page-load', all);
</script>
