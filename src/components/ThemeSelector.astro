---
// Chromatic theme selector. Minimal, glyphic.
// "T_" key prompt with a blinking terminal caret signals keyboard interactivity
// without being literal. The selector fades in after the hero animation
// completes, so it appears as an invitation rather than chrome.
const themes = [
  { id: "dark", label: "Carbon", swatch: "#0A0A0A" },
  { id: "powder", label: "Powder", swatch: "#A8C9D9" },
  { id: "field", label: "Field", swatch: "#5C9248" },
  { id: "honey", label: "Honey", swatch: "#E8C246" },
];
---

<aside class="theme-toggle" aria-label="Color theme. Press T to cycle.">
  <span class="key" aria-hidden="true">
    T<span class="caret">_</span>
  </span>
  <ul role="list">
    {themes.map((t) => (
      <li>
        <button
          type="button"
          data-theme-btn={t.id}
          aria-label={t.label}
          title={t.label}
          style={`--swatch: ${t.swatch};`}
        ></button>
      </li>
    ))}
  </ul>
</aside>

<style>
  .theme-toggle {
    position: fixed;
    bottom: var(--space-6);
    right: var(--space-6);
    z-index: 100;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    /* Fade in after the hero stagger lands (chunks finish ~1s) */
    animation: toggle-in 700ms cubic-bezier(0.2, 0, 0, 1) 1200ms backwards;
  }

  @keyframes toggle-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .key {
    font-size: 11px;
    font-weight: var(--fw-semibold);
    color: var(--text);
    letter-spacing: 0.05em;
    padding: 2px 6px 3px;
    border: 1px solid var(--line);
    line-height: 1;
    font-feature-settings: "tnum";
    transition: color 280ms ease, border-color 280ms ease;
  }
  .caret {
    display: inline-block;
    margin-left: 1px;
    color: var(--accent);
    animation: blink 1.05s steps(1) infinite;
  }

  @keyframes blink {
    0%, 49% { opacity: 1; }
    50%, 100% { opacity: 0; }
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    gap: 6px;
  }
  button {
    width: 12px;
    height: 12px;
    border: 1px solid var(--line);
    background: var(--swatch);
    cursor: pointer;
    border-radius: 0;
    padding: 0;
    transition: transform 220ms cubic-bezier(0.2, 0, 0, 1),
                border-color 220ms ease;
  }
  .theme-toggle:hover button {
    transform: scale(1.15);
  }
  button:hover {
    transform: scale(1.6) !important;
    border-color: var(--text);
  }
  button[aria-current="true"] {
    outline: 1px solid var(--text);
    outline-offset: 2px;
  }
  button:focus-visible {
    outline: 2px solid var(--text);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .caret { animation: none; opacity: 1; }
    .theme-toggle { animation: none; }
  }
</style>

<script>
  const root = document.documentElement;
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-theme-btn]");
  const order = ["dark", "powder", "field", "honey"];
  const validSet = new Set(order);

  const applyTheme = (theme: string) => {
    if (!validSet.has(theme)) theme = "dark";
    root.dataset.theme = theme;
    try {
      localStorage.setItem("theme", theme);
    } catch {
      // localStorage may be blocked. Theme still applies for the session.
    }
    buttons.forEach((b) => {
      if (b.dataset.themeBtn === theme) {
        b.setAttribute("aria-current", "true");
      } else {
        b.removeAttribute("aria-current");
      }
    });
  };

  applyTheme(root.dataset.theme || "dark");

  buttons.forEach((b) => {
    b.addEventListener("click", () => {
      const theme = b.dataset.themeBtn;
      if (theme) applyTheme(theme);
    });
  });

  // Keyboard shortcut: T cycles through themes — only when the switcher is actually
  // present (it's hidden on the homepage, so T shouldn't silently re-theme there).
  if (buttons.length) document.addEventListener("keydown", (e) => {
    if (e.key.toLowerCase() !== "t") return;
    if (e.metaKey || e.ctrlKey || e.altKey) return;
    const target = e.target as HTMLElement | null;
    const tag = target?.tagName?.toLowerCase();
    if (tag === "input" || tag === "textarea" || target?.isContentEditable) return;

    const current = root.dataset.theme || "dark";
    const idx = order.indexOf(current);
    const next = order[(idx + 1) % order.length];
    applyTheme(next);
  });
</script>
