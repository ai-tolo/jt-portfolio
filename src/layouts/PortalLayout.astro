---
import "@fontsource-variable/geist";
import "../styles/tokens.css";
import TabStrip from "../components/portal/TabStrip.astro";

interface Props {
  title: string;
  /** Which tab to highlight. Listening room passes "surprise" since it's a
   * downstream surface from the Surprise/Workbench tabs. */
  current: "surprise" | "library" | "projects" | "workbench" | "diary";
  /** Hide the tab strip entirely (e.g. Listening room takes over the viewport). */
  bare?: boolean;
}

const { title, current, bare = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>{title} · Portal</title>
    {/* Theme bootstrap — same logic as the public Layout. Inherits whatever
        theme Jon last set on the public site. */}
    <script is:inline>
      (() => {
        const valid = new Set(["dark", "powder", "field", "honey"]);
        const apply = () => {
          try {
            const stored = localStorage.getItem("theme");
            document.documentElement.dataset.theme =
              stored && valid.has(stored) ? stored : "dark";
          } catch {
            document.documentElement.dataset.theme = "dark";
          }
        };
        apply();
        window.addEventListener("pageshow", apply);
      })();
    </script>
  </head>
  <body>
    {!bare && (
      <header class="portal-header">
        <div class="inner">
          <a class="brand" href="/portal" aria-label="The Console — Portal home">
            <span class="dot" aria-hidden="true"></span>
            <span>The Console</span>
          </a>

          <TabStrip current={current} />

          <form method="POST" action="/api/console/logout" class="logout">
            <button type="submit" aria-label="Log out">Log out</button>
          </form>
        </div>
      </header>
    )}

    <main class="portal-main">
      <slot />
    </main>

    {/* Queue storage: data-action="queue" buttons add the data-path attribute
        to localStorage. Reflects already-queued items by toggling [data-queued].
        Listened to globally so any Card on any tab works without per-page wiring. */}
    <script>
      const QUEUE_KEY = "portal:queue";

      type QueueEntry = { path: string; addedAt: number };
      const readQueue = (): QueueEntry[] => {
        try {
          const raw = localStorage.getItem(QUEUE_KEY);
          if (!raw) return [];
          const parsed = JSON.parse(raw);
          return Array.isArray(parsed) ? parsed : [];
        } catch {
          return [];
        }
      };
      const writeQueue = (q: QueueEntry[]) => {
        try { localStorage.setItem(QUEUE_KEY, JSON.stringify(q)); } catch {}
        window.dispatchEvent(new CustomEvent("portal:queue-changed", { detail: q }));
      };

      const reflectQueueState = () => {
        const queued = new Set(readQueue().map((e) => e.path));
        document
          .querySelectorAll<HTMLElement>('[data-action="queue"][data-path]')
          .forEach((b) => {
            const path = b.dataset.path!;
            const isIn = queued.has(path);
            b.dataset.queued = isIn ? "true" : "false";
            b.textContent = isIn ? "✓ Queued" : "+ Queue";
          });
      };

      document.addEventListener("click", (e) => {
        const target = e.target as HTMLElement | null;
        const btn = target?.closest<HTMLElement>('[data-action="queue"][data-path]');
        if (!btn) return;
        const path = btn.dataset.path!;
        const q = readQueue();
        const idx = q.findIndex((e) => e.path === path);
        if (idx === -1) q.push({ path, addedAt: Date.now() });
        else q.splice(idx, 1);
        writeQueue(q);
        reflectQueueState();
      });

      // Also let other surfaces (Workbench) trigger removal via custom event.
      document.addEventListener("click", (e) => {
        const target = e.target as HTMLElement | null;
        const btn = target?.closest<HTMLElement>('[data-action="unqueue"][data-path]');
        if (!btn) return;
        const path = btn.dataset.path!;
        writeQueue(readQueue().filter((e) => e.path !== path));
        reflectQueueState();
        // Workbench removes its own card on click. Dispatch so it can react.
        window.dispatchEvent(new CustomEvent("portal:queue-removed", { detail: { path } }));
      });

      reflectQueueState();
      window.addEventListener("pageshow", reflectQueueState);

      // Friendly Names: click the title button on any Card to inline-edit.
      // Save persists to /api/console/items-display-name; Suggest fetches a
      // proposal from /api/console/suggest-name; Cancel/Esc restores.
      function buildRenameForm(currentLabel: string, fallback: string) {
        const form = document.createElement("span");
        form.className = "rename-form";
        const input = document.createElement("input");
        input.type = "text";
        input.value = currentLabel;
        input.maxLength = 200;
        const save = document.createElement("button");
        save.type = "button";
        save.className = "primary";
        save.dataset.role = "rename-save";
        save.textContent = "Save";
        const suggest = document.createElement("button");
        suggest.type = "button";
        suggest.dataset.role = "rename-suggest";
        suggest.textContent = "Suggest";
        const cancel = document.createElement("button");
        cancel.type = "button";
        cancel.dataset.role = "rename-cancel";
        cancel.textContent = "Cancel";
        form.append(input, save, suggest, cancel);
        form.dataset.fallback = fallback;
        return { form, input };
      }

      function exitRenameMode(form: HTMLElement, label: string, isRenamed: boolean) {
        const container = form.parentElement!;
        const path = form.dataset.path!;
        const filename = form.dataset.filename!;
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "title-edit";
        btn.dataset.action = "rename";
        btn.dataset.path = path;
        if (isRenamed) btn.dataset.renamed = "true";
        btn.title = `Click to rename. Real filename: ${filename}`;
        btn.textContent = label;
        container.replaceChildren(btn);
        // Notify other surfaces (Workbench metaCache, etc.).
        window.dispatchEvent(new CustomEvent("portal:display-name-changed", {
          detail: { path, display_name: isRenamed ? label : null },
        }));
      }

      document.addEventListener("click", async (e) => {
        const target = e.target as HTMLElement | null;

        // Enter edit mode.
        const trigger = target?.closest<HTMLButtonElement>('[data-action="rename"][data-path]');
        if (trigger) {
          const path = trigger.dataset.path!;
          const card = trigger.closest<HTMLElement>("[data-path]");
          const filename = card?.dataset.filename ?? trigger.textContent ?? "";
          const current = trigger.textContent ?? "";
          const { form, input } = buildRenameForm(current.trim(), filename);
          form.dataset.path = path;
          form.dataset.filename = filename;
          trigger.replaceWith(form);
          input.focus();
          input.select();
          return;
        }

        // Save / Suggest / Cancel within an active rename-form.
        const formBtn = target?.closest<HTMLButtonElement>('.rename-form button');
        if (!formBtn) return;
        const form = formBtn.closest<HTMLElement>(".rename-form");
        if (!form) return;
        const input = form.querySelector<HTMLInputElement>("input")!;
        const path = form.dataset.path!;
        const role = formBtn.dataset.role;

        if (role === "rename-cancel") {
          const filename = form.dataset.filename ?? "";
          exitRenameMode(form, filename, false);
          return;
        }
        if (role === "rename-suggest") {
          formBtn.disabled = true;
          try {
            const params = new URLSearchParams({ path });
            const res = await fetch(`/api/console/suggest-name?${params}`);
            if (res.ok) {
              const data = await res.json();
              if (typeof data.suggested === "string") input.value = data.suggested;
            }
          } finally {
            formBtn.disabled = false;
            input.focus();
          }
          return;
        }
        if (role === "rename-save") {
          formBtn.disabled = true;
          const value = input.value.trim();
          const filename = form.dataset.filename ?? "";
          try {
            const res = await fetch("/api/console/items-display-name", {
              method: "POST",
              headers: { "content-type": "application/json" },
              body: JSON.stringify({ path, display_name: value || null }),
            });
            if (!res.ok) {
              formBtn.title = `Save failed (HTTP ${res.status})`;
              return;
            }
            const data = await res.json();
            const newLabel = data.display_name ?? filename;
            exitRenameMode(form, newLabel, !!data.display_name);
          } catch {
            formBtn.title = "Save failed (network)";
          } finally {
            formBtn.disabled = false;
          }
        }
      });

      // Trash: click the small ✕ in any Card header to hide it from all
      // surfaces. The file on disk stays; row keeps existing. Restore from
      // /portal/trash.
      document.addEventListener("click", async (e) => {
        const target = e.target as HTMLElement | null;
        const btn = target?.closest<HTMLButtonElement>('[data-action="trash"][data-path]');
        if (!btn) return;
        const path = btn.dataset.path!;
        const card = btn.closest<HTMLElement>(".card, .wb-card");
        if (card) card.dataset.trashing = "true";
        try {
          const res = await fetch("/api/console/items-trashed", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({ path, trashed: true }),
          });
          if (!res.ok) {
            if (card) card.removeAttribute("data-trashing");
            btn.title = `Trash failed (HTTP ${res.status})`;
            return;
          }
          // Remove the card from the DOM.
          if (card) {
            const li = card.closest<HTMLElement>("li");
            (li ?? card).remove();
          }
          window.dispatchEvent(new CustomEvent("portal:trashed-changed", {
            detail: { path, trashed: true },
          }));
          // Also drop it from the localStorage queue if present.
          const q = readQueue().filter((e) => e.path !== path);
          writeQueue(q);
          reflectQueueState();
        } catch {
          if (card) card.removeAttribute("data-trashing");
          btn.title = "Trash failed (network)";
        }
      });

      // Esc cancels active rename, blur outside the form cancels too.
      document.addEventListener("keydown", (e) => {
        if (e.key !== "Escape") return;
        const active = document.activeElement;
        const form = active?.closest<HTMLElement>(".rename-form");
        if (form) {
          const filename = form.dataset.filename ?? "";
          exitRenameMode(form, filename, false);
        }
      });

      // Public toggle: click any [data-action="toggle-public"][data-path] to
      // flip the asset's `public` flag via the auth-gated proxy. Optimistic
      // UI, rolled back on failure.
      function applyPublicState(btn: HTMLButtonElement, isPublic: boolean) {
        btn.setAttribute("aria-pressed", isPublic ? "true" : "false");
        btn.textContent = isPublic ? "● Public" : "○ Public";
        btn.classList.toggle("on", isPublic);
      }

      document.addEventListener("click", async (e) => {
        const target = e.target as HTMLElement | null;
        const btn = target?.closest<HTMLButtonElement>('[data-action="toggle-public"][data-path]');
        if (!btn) return;
        const path = btn.dataset.path!;
        const wasPublic = btn.getAttribute("aria-pressed") === "true";
        const desired = !wasPublic;
        btn.disabled = true;
        applyPublicState(btn, desired); // optimistic
        try {
          const res = await fetch("/api/console/items-public", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({ path, public: desired }),
          });
          if (!res.ok) {
            applyPublicState(btn, wasPublic); // rollback
            btn.title = `Save failed (HTTP ${res.status})`;
            return;
          }
          const data = await res.json();
          applyPublicState(btn, Boolean(data.public));
          btn.title = data.public ? "Public on /sounds" : "Mark this item public on /sounds";
          window.dispatchEvent(new CustomEvent("portal:public-changed", {
            detail: { path, public: Boolean(data.public) },
          }));
        } catch {
          applyPublicState(btn, wasPublic);
          btn.title = "Save failed (network)";
        } finally {
          btn.disabled = false;
        }
      });
    </script>

    {/* T cycles themes — reuse the public site's keyboard wiring. Inline so
        it doesn't depend on importing the ThemeSelector component (which has
        its own UI we don't want on Portal). */}
    <script>
      const root = document.documentElement;
      const order = ["dark", "powder", "field", "honey"];
      const valid = new Set(order);
      document.addEventListener("keydown", (e) => {
        if (e.key.toLowerCase() !== "t") return;
        if (e.metaKey || e.ctrlKey || e.altKey) return;
        const target = e.target as HTMLElement | null;
        const tag = target?.tagName?.toLowerCase();
        if (tag === "input" || tag === "textarea" || target?.isContentEditable) return;
        const current = root.dataset.theme || "dark";
        const idx = order.indexOf(current);
        const next = order[(idx + 1) % order.length];
        if (valid.has(next)) {
          root.dataset.theme = next;
          try { localStorage.setItem("theme", next); } catch {}
        }
      });
    </script>

    {/* tokens.css hides the system cursor site-wide and the public site
        replaces it with a custom cursor component. The Portal doesn't load
        that component, so restore the native cursor here. */}
    <style is:global>
      body,
      a,
      button,
      input,
      [role="button"] {
        cursor: auto;
      }
      a,
      button,
      [role="button"] {
        cursor: pointer;
      }
    </style>

    <style>
      .portal-header {
        position: sticky;
        top: 0;
        z-index: 50;
        background: color-mix(in srgb, var(--bg) 88%, transparent);
        backdrop-filter: saturate(140%) blur(10px);
        -webkit-backdrop-filter: saturate(140%) blur(10px);
        border-bottom: 1px solid var(--line);
      }
      .inner {
        max-width: var(--content-max);
        margin: 0 auto;
        padding: var(--space-3) var(--content-pad);
        display: flex;
        align-items: center;
        gap: var(--space-6);
        flex-wrap: wrap;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: var(--fs-eyebrow);
        font-weight: var(--fw-semibold);
        letter-spacing: var(--ls-eyebrow);
        text-transform: uppercase;
        color: var(--text);
        opacity: 0.88;
        transition: opacity 200ms ease;
      }
      .brand:hover { opacity: 1; }
      .dot {
        width: 8px;
        height: 8px;
        background: var(--accent);
        display: inline-block;
        border-radius: 999px;
      }

      .logout {
        margin-left: auto;
      }
      .logout button {
        font: inherit;
        font-size: var(--fs-eyebrow);
        font-weight: var(--fw-semibold);
        letter-spacing: var(--ls-eyebrow);
        text-transform: uppercase;
        color: var(--muted);
        background: transparent;
        border: 0;
        padding: 8px 0;
        cursor: pointer;
        transition: color 160ms ease;
      }
      .logout button:hover,
      .logout button:focus-visible {
        color: var(--accent);
      }

      .portal-main {
        max-width: var(--content-max);
        margin: 0 auto;
        padding: var(--space-8) var(--content-pad) var(--space-16);
      }
    </style>
  </body>
</html>
