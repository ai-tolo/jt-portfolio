---
import "@fontsource-variable/geist";
import "@fontsource-variable/space-grotesk";
import "../styles/tokens.css";
import Cursor from "../components/Cursor.astro";
import NightBoot from "../components/NightBoot.astro";

interface Props {
  title: string;
  description?: string;
  /** Override the default OG image. Path relative to site root, e.g. "/og-case-study.png". */
  ogImage?: string;
}

const DEFAULT_DESCRIPTION =
  "Jonathan Tollefson — design engineer. Browser instruments, audio tools, and AI product work: Web Audio, React/TypeScript, blind evaluation systems.";

const {
  title,
  description = DEFAULT_DESCRIPTION,
  ogImage = "/og-image.png",
} = Astro.props;

// Astro.site is set in astro.config.mjs. Falls back to uxjon.com if missing.
const siteOrigin = Astro.site?.origin ?? "https://uxjon.com";
const canonical = new URL(Astro.url.pathname, siteOrigin).toString();
const ogImageUrl = new URL(ogImage, siteOrigin).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#e9e8e5" />

    {/* Icons. SVG for modern browsers (with built-in dark-mode swap); PNG
        fallbacks for older browsers and search results; Apple touch icon
        for iOS home-screen pinning. */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    {/* Open Graph — used by iMessage, Slack, Facebook, LinkedIn, etc. */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Jonathan Tollefson" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Jonathan Tollefson — Design engineer: browser instruments and audio tools" />

    {/* Twitter / X */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {/* One theme axis sitewide: day by default, html[data-night] via the
        switch. Applied pre-paint (the old 4-theme cycler is retired). */}
    <NightBoot />
  </head>
  <body>
    <Cursor />
    <slot />
  </body>
</html>
