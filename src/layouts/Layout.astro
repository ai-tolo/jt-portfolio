---
import "@fontsource-variable/geist";
import "@fontsource-variable/space-grotesk";
import "../styles/tokens.css";
import Cursor from "../components/Cursor.astro";
import NightBoot from "../components/NightBoot.astro";

interface Props {
  title: string;
  description?: string;
  /** Override the default OG image. Path relative to site root, e.g. "/og-case-study.png". */
  ogImage?: string;
}

const DEFAULT_DESCRIPTION =
  "Jonathan Tollefson — design engineer. Browser instruments, audio tools, and AI product work: Web Audio, React/TypeScript, blind evaluation systems.";

// the default share card is Jon's cassette, 2000 × 1224 as he cut it (2026-09-22;
// the desk screenshot is retired). Pages that pass their own cover keep the
// 1200 × 630 card their covers were cut to.
const DEFAULT_OG = "/og-tape.png";

const {
  title,
  description = DEFAULT_DESCRIPTION,
  ogImage = DEFAULT_OG,
} = Astro.props;
const [ogWidth, ogHeight] = ogImage === DEFAULT_OG ? [2000, 1224] : [1200, 630];
const ogAlt = ogImage === DEFAULT_OG ? "A cassette tape, JT on the label" : title;

// Astro.site is set in astro.config.mjs (the www host: the apex 308-redirects
// to it, so canonical/og URLs must never name the apex). Fallback matches.
const siteOrigin = Astro.site?.origin ?? "https://www.uxjon.com";
const canonical = new URL(Astro.url.pathname, siteOrigin).toString();
const ogImageUrl = new URL(ogImage, siteOrigin).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#e9e8e5" />

    {/* Icons. SVG for modern browsers (with built-in dark-mode swap); PNG
        fallbacks for older browsers and search results; Apple touch icon
        for iOS home-screen pinning. */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {/* the Intake hero's faces (IntakeHero.astro): Instrument Sans · JetBrains Mono · Outfit */}
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Outfit:wght@300;400;500&display=swap" rel="stylesheet" />

    {/* Open Graph — used by iMessage, Slack, Facebook, LinkedIn, etc. */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Jonathan Tollefson" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(ogWidth)} />
    <meta property="og:image:height" content={String(ogHeight)} />
    <meta property="og:image:alt" content={ogAlt} />

    {/* Twitter / X */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {/* Structured data: one Person record carrying only facts the résumé
        already states (no ratings, no invented fields). set:html because
        Astro does not interpolate inside <script> bodies. */}
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Person",
        name: "Jonathan Tollefson",
        jobTitle: "Design Engineer",
        url: `${siteOrigin}/`,
        sameAs: [
          "https://www.linkedin.com/in/jtollefson123",
          "https://jontolo.substack.com",
        ],
        address: {
          "@type": "PostalAddress",
          addressLocality: "Minneapolis",
          addressRegion: "MN",
          addressCountry: "US",
        },
      })}
    />

    {/* One theme axis sitewide: day by default, html[data-night] via the
        switch. Applied pre-paint (the old 4-theme cycler is retired). */}
    <NightBoot />
  </head>
  <body>
    <Cursor />
    <slot />
  </body>
</html>
