---
// /writing/<slug> — one Diary of a Soundbender post, full text ON the site
// (Jon, 2026-08-16: homepage shows preview tiles; essays live here, sourced
// from writing-manifest.json — the Substack is the origin, not the venue).
import Layout from "../../layouts/Layout.astro";
import AwayRail from "../../components/studio/AwayRail.astro";
import SiteFloor from "../../components/studio/SiteFloor.astro";
import writing from "../../components/studio/rooms/writing-manifest.json";

export const prerender = true;

export function getStaticPaths() {
  return (writing.posts ?? []).map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Post {
  slug: string;
  title: string;
  date: string;
  subtitle?: string;
  cover?: string | null;
  paragraphs: string[];
}
const { post } = Astro.props as { post: Post };
// Meta description: a bare subtitle ("Oranges in the Shower", 21 chars) is
// what every search snippet and link preview showed. Short subtitles now
// yield to the essay's first sentence, trimmed to snippet length.
const firstSentence = (html: string | undefined) => {
  const text = (html ?? "").replace(/<[^>]+>/g, " ").replace(/\s+/g, " ").trim();
  if (!text) return "";
  const cut = text.search(/[.!?](\s|$)/);
  const sentence = cut > 40 ? text.slice(0, cut + 1) : text;
  return sentence.length > 155 ? sentence.slice(0, 152).trimEnd() + "…" : sentence;
};
const description =
  post.subtitle && post.subtitle.length >= 60
    ? post.subtitle
    : firstSentence(post.paragraphs?.[0]) || `Diary of a Soundbender — ${post.title}`;
const fmtDate = (iso: string) => {
  const d = new Date(iso + "T12:00:00");
  return isNaN(d.getTime()) ? iso : d.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" });
};
---

<Layout
  title={`${post.title} — Jonathan Tollefson`}
  description={description}
  ogImage={post.cover || undefined}
>
  <AwayRail />
  <main class="wpage">
    <article class="wpost">
      <header class="whead">
        <h1>{post.title}</h1>
        {post.subtitle && <p class="wsub">{post.subtitle}</p>}
        <p class="wmeta">Diary of a Soundbender · {fmtDate(post.date)}</p>
      </header>
      {post.cover && <img class="wcover" src={post.cover} alt="" />}
      {post.paragraphs.map((para) => <p class="wp">{para}</p>)}
      {/* provenance + the follow path a reader asked for (review, 2026-08-25) */}
      <p class="wsource">
        from <a href={`https://jontolo.substack.com/p/${post.slug}`} target="_blank" rel="noopener noreferrer">Diary of a Soundbender — read on Substack →</a>
      </p>
    </article>

    {/* the floor: the sitewide object (SiteFloor.astro, email + LinkedIn) */}
    <SiteFloor />
  </main>
</Layout>

<style>
  /* ground + ink ride the sitewide day/night tokens (tokens.css owns
     html/body; the old static #e9e8e5 pins would have blocked night) */
  .wpage {
    min-height: 100svh;
    background: var(--bg);
    color: var(--text);
    font-family: "IBM Plex Sans", ui-sans-serif, system-ui, sans-serif;
    padding: 34px 20px 110px;
    transition: background 560ms ease, color 560ms ease;
  }
  @media (min-width: 900px) {
    .wpage {
      padding-left: var(--railw, 110px);
    }
  }
  .wpost {
    max-width: 660px;
    margin: 0 auto;
    background: rgba(248, 244, 234, 0.96);
    border: 1px solid rgba(90, 74, 50, 0.25);
    border-radius: 8px;
    padding: clamp(28px, 5vw, 54px);
    box-shadow: 0 18px 44px -24px rgba(20, 12, 4, 0.35);
    transition: background 560ms ease, border-color 560ms ease;
  }
  /* night: the paper goes dark with the room (Jon's homepage-sheet rule,
     extended sitewide 2026-08-28) — same clothes as the homepage sheets.
     Screen-only: printing from a night tab still has html[data-night]
     set, and these borders were leaking onto paper (QA print lens). */
  @media screen {
    :global(html[data-night]) .wpost {
      background: #0b0e14;
      border-color: #1c222e;
    }
    :global(html[data-night]) .wcover,
    :global(html[data-night] .floor),
    :global(html[data-night]) .wsource {
      border-color: #1c222e;
    }
  }
  .whead h1 {
    margin: 0 0 10px;
    font-size: clamp(1.4rem, 3.2vw, 1.9rem);
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
  .wsub {
    margin: 0 0 12px;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--muted);
  }
  .wmeta {
    margin: 0 0 26px;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  .wcover {
    width: 100%;
    border-radius: 6px;
    border: 1px solid rgba(90, 74, 50, 0.25);
    margin: 0 0 28px;
    display: block;
  }
  .wp {
    margin: 0 0 16px;
    font-size: 1rem;
    line-height: 1.7;
  }
  .wp:last-child {
    margin-bottom: 0;
  }
  /* the floor — the sitewide object (SiteFloor.astro); this page owns
     its placement: the column's width, a hairline above */
  :global(.floor) {
    max-width: 660px;
    margin: 48px auto 0;
    padding: 22px 20px 8px;
    border-top: 1px solid rgba(90, 74, 50, 0.2);
  }

  .wsource {
    margin: 26px 0 0;
    padding-top: 14px;
    border-top: 1px solid rgba(90, 74, 50, 0.2);
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--muted);
  }
  .wsource a {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  /* print: ink on white no matter the night state (this route has no
     PrintResume-style backstop, so the guard lives here). The floor is
     hidden to match /resume's print contract — paper gets the essay and
     its source line, not site chrome. */
  @media print {
    :global(html),
    :global(body),
    .wpage,
    .wpost {
      background: #fff !important;
      color: #141210 !important;
      box-shadow: none !important;
      border-color: #ddd !important;
    }
    .wcover,
    .wsource {
      border-color: #ddd !important;
    }
    :global(.floor) {
      display: none !important;
    }
    .wsource {
      color: #555 !important;
    }
  }
</style>
