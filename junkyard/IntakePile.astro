---
// src/components/IntakePile.astro
// THE PILE, SORTED BY HAND (2026-10-20, branch intake-v3, round two). Round one (WHAT INTAKE REPLACED, IntakeStream)
// was Jon's pick: "I like three the most … one-by-one instead of all at once, having the user click on certain things …
// we're missing the beauty of the calendar: a horizontal calendar beneath everything that also changes … implement how
// number two had the audio playback, but the text should appear in sequence." The Intake sheet's top object. TWO
// PHONES (the AudioDex shape). LEFT, the phone as it was: the LOCK SCREEN, a dozen notifications piled past the bottom
// edge; FIVE are his and breathe (the touch rim, the house vocabulary), each its own press; seven are everyone's junk,
// flat and inert. RIGHT, INTAKE, the real app as intake_web.py draws it (the dark ground, Intake · Stream · Rows ·
// Log), its feed empty with its own line, its list RESERVED to six cards from the first paint. THE RIBBON under both
// phones: one strip of days, today centred and ringed; a dated landing slides it to the day and the day takes its bar.
// A PRESS lifts that one item, flies it the one arc into the Stream and lands it as its card (receipt or open); the
// dated ones move the ribbon 300 ms after; the fifth, a memo from the wrist, opens into a strip and plays, its words
// typed IN SEQUENCE as spoken, then its two tickets fly one at a time. After the fifth the junk fades: the phone is
// quiet. The watch under it is the live memo (IntakeHero, live only).
//
// Usage:   <IntakePile />   (inside a .sheet: it reads --sheet-ink / --sheet-acc / --sheet-mono from the host)
// Data:    src/data/intake-pile.json (every line a DRAFT, Jon's to rewrite); images in public/intake/board/
// Needs:   public/archive/phone-blank.png (AudioDexDoor's body)
// Slot:    public/intake/memo-nico.m4a (existsSync at build time, like the Studio captures): present, the memo plays
//          WITH sound and the words pace to its length; absent, the words type at 400 ms each, no sound.
//
// INTAKE IS THE HERO: on screen from the first paint (the right phone), at every landing, and the whole end state.
// NOTHING PRESSES ITSELF: every motion follows a press. NOTHING MOVES THE PAGE: the phones (an aspect ratio), the
// Stream's list (six cards in the flow, unseen) and the ribbon (fixed height) hold one height from the first paint;
// the foot is one slot (hint · runline · Replay). On a narrow sheet the two phones share ONE spot: the lock screen
// stands, Intake crossfades over it for a beat at each landing and stays after the fifth. Reduced motion: no arc,
// no slide, no typing; a press shows the card and the bar at once.
import fs from 'node:fs';
import path from 'node:path';
import data from '../data/intake-pile.json';

const { lock, feed, memo, ribbon, say, hint } = data;
const clip: string | null = fs.existsSync(path.join(process.cwd(), 'public', memo.clip.replace(/^\//, ''))) ? memo.clip : null;

// the app icons on the lock screen: a rounded square in the app's colour with one white glyph (drawn, not Apple's);
// Intake's is the wrist (the memo came from the watch)
const ICON: Record<string, string> = {
  messages: '<path d="M12 4C7.6 4 4 7 4 10.6c0 2 1.1 3.8 2.9 5L6 19l3.6-1.8c.8.2 1.6.3 2.4.3 4.4 0 8-3 8-6.9S16.4 4 12 4z" fill="#fff"/>',
  phone: '<path d="M7.5 4.5l2.6 2.7-1.5 2.1a9 9 0 0 0 6.1 6.1l2.1-1.5 2.7 2.6-1.4 2.4c-.4.6-1.1.9-1.8.8C9.8 19 5 14.2 4.3 7.7c-.1-.7.2-1.4.8-1.8z" fill="#fff"/>',
  box: '<path d="M4 8l8-4 8 4v8l-8 4-8-4z" fill="none" stroke="#fff" stroke-width="1.8" stroke-linejoin="round"/><path d="M4 8l8 4 8-4M12 12v8" fill="none" stroke="#fff" stroke-width="1.8"/>',
  mail: '<rect x="3.5" y="6" width="17" height="12" rx="2" fill="none" stroke="#fff" stroke-width="1.8"/><path d="M4 7l8 6 8-6" fill="none" stroke="#fff" stroke-width="1.8"/>',
  weather: '<circle cx="9" cy="10" r="3.6" fill="#fff"/><path d="M8 18h9a3 3 0 0 0 .3-6 4.2 4.2 0 0 0-8-1.2A3.6 3.6 0 0 0 8 18z" fill="#fff"/>',
  heart: '<path d="M12 20C7 15.5 3.5 12.3 3.5 8.6 3.5 6 5.5 4 8 4c1.6 0 3 .8 4 2.1C13 4.8 14.4 4 16 4c2.5 0 4.5 2 4.5 4.6 0 3.7-3.5 6.9-8.5 11.4z" fill="#fff"/>',
  chat: '<path d="M5 5h14a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1h-8l-5 4v-4H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1z" fill="#fff"/>',
  flame: '<path d="M12 3c1 3 4 4.5 4 8.5A4 4 0 0 1 8 12c0-1.2.4-2 .9-2.8.2 1.1.8 1.8 1.6 1.8C11 6.5 9.5 5.5 12 3z" fill="#fff"/><path d="M8 11.5A4 4 0 1 0 16 11.5" fill="#fff"/>',
  intake: '<rect x="7" y="6" width="10" height="12" rx="3" fill="none" stroke="#fff" stroke-width="1.8"/><path d="M9.5 6V3h5v3M9.5 18v3h5v-3" fill="none" stroke="#fff" stroke-width="1.8" stroke-linejoin="round"/><path d="M12 9.5v3l1.8 1.2" fill="none" stroke="#fff" stroke-width="1.6" stroke-linecap="round"/>',
};
const TINT: Record<string, string> = {
  messages: '#34c759', phone: '#34c759', box: '#8a6a4b', mail: '#1f8fff', weather: '#2f95ff',
  heart: '#e1306c', chat: '#5b4bd6', flame: '#f29a2e', intake: '#ff6b4a',
};
const SPARK = '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l2.2 6.6L21 11l-6.8 2.4L12 20l-2.2-6.6L3 11l6.8-2.4z"/></svg>';
const X = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>';
const CHECK = '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 8.5l3.5 3.5 7.5-8.5"/></svg>';
const PHONE = '<svg viewBox="0 0 14 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="1.5" y="1" width="11" height="18" rx="2.5"/><path d="M5.5 16h3"/></svg>';
const LINK = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 14a4.5 4.5 0 0 0 6.4 0l3.2-3.2a4.5 4.5 0 0 0-6.4-6.4L12 5.6"/><path d="M14 10a4.5 4.5 0 0 0-6.4 0l-3.2 3.2a4.5 4.5 0 0 0 6.4 6.4l1.2-1.2"/></svg>';
// the Stream's kind colours (intake_web.py's KIND_COLORS)
const KIND: Record<string, string> = { idea: '#8fbf6f', task: '#e0a35b', calendar: '#d9a845', reminder: '#d9a845', claude: '#e05b45' };
const MINE = lock.notifications.filter((n) => n.id).length;
const WORDS = memo.words.split(' ');
// the memo's wave: the watch's own bars (IntakeHero), half of them
const BARS = [4.43, 11.39, 22.15, 32.91, 22.78, 25.32, 29.11, 13.92, 26.58, 24.05, 10.76, 5.06, 2.53, 6.96, 16.46, 27.85, 30.38, 18.35, 35.44, 20.89, 18.99, 31.65, 15.82, 7.59];

// THE RIBBON: every day from `from` to `to`, one cell each; the bars in their cells, unlit
const NAMES = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
const DOW = ['S', 'M', 'T', 'W', 'T', 'F', 'S'];
const d0 = new Date(ribbon.from + 'T00:00:00Z'), d1 = new Date(ribbon.to + 'T00:00:00Z');
type Day = { iso: string; d: number; w: string; m: number; y: number };
const days: Day[] = [];
for (let t = d0.getTime(); t <= d1.getTime(); t += 86400000) {
  const d = new Date(t);
  days.push({ iso: d.toISOString().slice(0, 10), d: d.getUTCDate(), w: DOW[d.getUTCDay()], m: d.getUTCMonth(), y: d.getUTCFullYear() });
}
const TODAY = days.findIndex((d) => d.iso === ribbon.today);
const landAt: Record<string, { id: string; cal: string; title: string; time?: string }> = {};
for (const [id, l] of Object.entries(ribbon.lands)) landAt[l.date] = { id, ...l };
const monthOf = (i: number) => `${NAMES[days[i].m]}${days[i].y !== days[TODAY].y ? ' ' + days[i].y : ''}`;
const monthsJson = JSON.stringify(days.map((d, i) => (i === 0 || d.d === 1 ? monthOf(i) : '')));
---
<section class="ipile" data-ipile data-mine={MINE} data-today={TODAY} data-months={monthsJson} data-say-done={say.done} data-pace="400" data-seconds={memo.seconds} aria-label="Intake: the phone's notifications, sorted by hand into one feed">
  {clip && <audio data-clip preload="metadata" src={clip}></audio>}
  <div class="ip-pair">
    {/* THE LOCK SCREEN: the clock and the date on the wallpaper, the pile under them (newest first, as iOS stacks it),
        the last ones cut by the bottom edge; five of them his, each a press; the memo's opens into its strip */}
    <div class="ip-phone ip-lock" data-lock>
      <i class="shadow" aria-hidden="true"></i>
      <div class="screen">
        <div class="face">
          <div class="sb" aria-hidden="true"><span class="lock-g"><svg viewBox="0 0 12 14"><rect x="1" y="6" width="10" height="7" rx="1.6" fill="currentColor"/><path d="M3.5 6V4.2a2.5 2.5 0 0 1 5 0V6" fill="none" stroke="currentColor" stroke-width="1.4"/></svg></span><span class="batt"><i></i></span></div>
          <p class="date" aria-hidden="true">{lock.date}</p>
          <p class="clock" aria-hidden="true">{lock.time}</p>
          <ol class="pile" data-pile>
            {lock.notifications.map((n, i) => (
              <li class:list={['ntf', { mine: !!n.id, memo: n.id === 'memo' }]} data-id={n.id} data-cards={n.cards?.join(' ')} data-land={n.land} data-say={n.say} style={`--i:${i};--tint:${TINT[n.icon] || '#8e8e93'}`} aria-hidden={n.id ? undefined : 'true'}>
                <span class="ico" aria-hidden="true"><svg viewBox="0 0 24 24" set:html={ICON[n.icon] || ''} /></span>
                <span class="txt" aria-hidden="true">
                  <span class="row"><b class="app">{n.app}</b><span class="when">{n.when}</span></span>
                  <b class="t">{n.title}</b>
                  <span class="b">{n.body}</span>
                </span>
                {n.thumb && <img class="th" src={n.thumb} alt="" width="80" height="80" decoding="async" aria-hidden="true" />}
                {n.id === 'memo' && (
                  <div class="mstrip" data-mstrip aria-hidden="true">
                    <div class="mtop">
                      <span class="mwave" data-mwave>{BARS.map((h, k) => <i style={`height:${(h * 0.52 + 1.4).toFixed(2)}cqw;animation-delay:-${((k * 0.37) % 1.6).toFixed(2)}s`}></i>)}</span>
                      <span class="mclock" data-mclock>0:00</span>
                    </div>
                    <p class="mwords" data-mwords>{WORDS.map((w) => <span class="w">{w} </span>)}</p>
                  </div>
                )}
                {n.id && <button class="hit" type="button" data-press aria-label={n.label}></button>}
              </li>
            ))}
          </ol>
        </div>
      </div>
      <img class="body" src="/archive/phone-blank.png" alt="" width="864" height="1760" decoding="async" loading="lazy" draggable="false" />
    </div>

    {/* INTAKE: the real app (intake_web.py): the status strip, the nav (the brand, Stream on, Rows, Log at the right),
        the feed: empty at rest with its own line, the six cards in the flow unseen (the list is reserved to its
        fullest state); a landing shows the next one, moved up to the landed group so the Stream fills top down */}
    <div class="ip-phone ip-app" data-app>
      <i class="shadow" aria-hidden="true"></i>
      <div class="screen" aria-hidden="true">
        <div class="face">
          <div class="sb"><span class="sb-t">{lock.time}</span><span class="batt"><i></i></span></div>
          <nav class="nav"><span class="brand">Intake</span><span class="tab on">Stream</span><span class="tab">Rows</span><span class="tab log">Log</span></nav>
          <div class="feed" data-feed>
            <p class="empty">{feed.empty}</p>
            {feed.cards.map((c) => (
              <article class:list={['tk', c.state]} data-card={c.id} style={`--src:${c.src}`}>
                <div class="thead">
                  <span class="age">{c.age}</span>
                  {c.phone && <span class="ph" set:html={PHONE} />}
                  {c.state === 'receipt'
                    ? <span class="rc" set:html={CHECK} />
                    : <span class="chip" style={`--kc:${KIND[c.kind || 'idea']}`}>{c.kind}</span>}
                  <span class="xb" set:html={X} />
                </div>
                <h3 class="tt">{c.title}</h3>
                {c.state === 'receipt' && <p class="what">{c.what}</p>}
                {c.state === 'open' && c.thumb && (
                  <div class="mrow"><img class="mthumb" src={c.thumb} alt="" width="88" height="88" decoding="async" /><p class="det dom"><span class="lk" set:html={LINK} />{c.domain}</p></div>
                )}
                {c.state === 'open' && (
                  <div class="verbs"><span class="v v-claude">Claude <span class="spark" set:html={SPARK} /></span><span class="v">Zzzz</span><span class="v">Add to…</span></div>
                )}
              </article>
            ))}
          </div>
        </div>
      </div>
      <img class="body" src="/archive/phone-blank.png" alt="" width="864" height="1760" decoding="async" loading="lazy" draggable="false" />
    </div>
  </div>

  {/* THE RIBBON (Jon: "a horizontal calendar beneath everything that also changes"): one strip of days under both
      phones, the month at the left edge, today centred and ringed; a dated landing slides it to the day (700 ms, the
      month name changing as it passes) and the day takes its bar. Fixed height. Reduced motion: jumps */}
  <div class="ribbon" data-ribbon style={`--c:${TODAY}`} aria-hidden="true">
    <p class="rb-month" data-month>{monthOf(TODAY)}</p>
    <div class="rb-win">
      <ol class="rb-track" data-track>
        {days.map((d, i) => (
          <li class:list={['rb-day', { today: i === TODAY }]} data-i={i}>
            <span class="rb-w">{d.w}</span>
            <span class="rb-n">{d.d}</span>
            {landAt[d.iso] && (
              <span class="rb-bar" data-bar={landAt[d.iso].id} data-cal={landAt[d.iso].cal}>{landAt[d.iso].title}{landAt[d.iso].time && <i> · {landAt[d.iso].time}</i>}</span>
            )}
          </li>
        ))}
      </ol>
    </div>
  </div>

  <div class="foot">
    <p class="hint" aria-hidden="true">{hint}</p>
    {/* "you're watching" (2026-10-19): the press → its landing, in the hint's place */}
    <span class="runline" aria-hidden="true" data-runline><i></i></span>
    <button type="button" class="replay" data-replay aria-label="Replay: put the notifications back and sort again">
      <svg viewBox="0 0 20 20" class="ico" aria-hidden="true"><path d="M4 10a6 6 0 1 0 1.8-4.3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M4 3v3.5h3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      Replay
    </button>
  </div>
  <p class="sr" role="status" aria-live="polite" data-status></p>
</section>

<style>
  .ipile {
    --ink: var(--sheet-ink, #141210);
    --ground: #e9e8e5;
    --acc: var(--sheet-acc, #ff6b4a);
    --ring-a: #47B6FF; --ring-b: #8A5CF6; /* the touch signal: the watch's ring's pair (AudioDexDoor's) */
    --hint-mix: 74%; /* #ff6b4a mixed toward the sheet ink until 4.5:1 (IntakeHero's rule) */
    --sans: -apple-system, 'Instrument Sans', 'Helvetica Neue', system-ui, sans-serif;
    --mono: var(--sheet-mono, 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace);
    /* the lock screen by day: a light wallpaper, frosted glass, black type (iOS's light look) */
    --wall: linear-gradient(165deg, #cfe0f4 0%, #e3d6ee 42%, #f4dfcc 100%);
    --glass: rgba(255, 255, 255, 0.64); --glass-ink: #0b0b0d; --glass-dim: rgba(20, 20, 24, 0.56); --sfg: #1a1a1c;
    /* INTAKE's own ground, always dark (intake_web.py's :root): the drawn app keeps its own light */
    --bg: #141613; --surface: #1c1f1b; --s2: #23271f; --line: #2e332c; --aink: #eaece5; --muted: #9ca294; --faint: #767c6f;
    --amber: #e0a35b; --rcpt: #79a465;
    /* the two calendars' bars, as the iOS month draws them (cal-before / cal-after): the ribbon's only fills */
    --cal-intake-bg: #ffd1da; --cal-intake-ink: #8a1631; --cal-intake-time: #c22a4d;
    --cal-idea-bg: #fde6b4; --cal-idea-ink: #6e4600; --cal-idea-time: #a26a08;
    --dim: color-mix(in oklab, var(--ink) 58%, transparent);
    --edge: color-mix(in oklab, var(--ink) 16%, transparent);
    position: relative;
    container: ipile / inline-size;
    width: 100%;
    color: var(--ink);
    font-family: var(--sans);
  }
  :global(html[data-night]) .ipile {
    --ground: #0b0e14; --hint-mix: 100%;
    --wall: linear-gradient(165deg, #182746 0%, #2d2047 48%, #1a1b2e 100%);
    --glass: rgba(52, 52, 60, 0.7); --glass-ink: #fff; --glass-dim: rgba(255, 255, 255, 0.58); --sfg: #f2f2f5;
    --cal-intake-bg: color-mix(in oklab, #ff375f 30%, #1c1c1f); --cal-intake-ink: #ffc2cf; --cal-intake-time: #ff8fa6;
    --cal-idea-bg: color-mix(in oklab, #ffcc00 24%, #1c1c1f); --cal-idea-ink: #ffe3a3; --cal-idea-time: #f2bd52;
  }
  .sr { position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .ico { width: 1em; height: 1em; flex: none; }

  /* ── the pair: two equal phones, one gutter, centred (AudioDexDoor's grid, the host's cap --ip-w) */
  .ip-pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, var(--ip-w, 34cqw)));
    justify-content: center;
    column-gap: var(--ip-gap, 8cqw);
  }
  /* ── a phone (the photographed body, the screen drawn under its cut-out: AudioDexDoor's numbers) */
  .ip-phone {
    position: relative;
    aspect-ratio: 864 / 1760;
    container: phone / inline-size;
    -webkit-tap-highlight-color: transparent;
  }
  .shadow { position: absolute; inset: 0.6% 1.2%; border-radius: 16.2% / 7.95%; box-shadow: 0 2.2cqw 5cqw rgba(20, 16, 10, 0.26), 0 0.6cqw 1.4cqw rgba(20, 16, 10, 0.16); }
  :global(html[data-night]) .ipile .shadow { box-shadow: 0 2.6cqw 6cqw rgba(0, 0, 0, 0.7), 0 0.6cqw 1.4cqw rgba(0, 0, 0, 0.5); }
  .screen {
    position: absolute; z-index: 1; left: 4.745%; top: 1.875%; width: 90.51%; height: 96.25%;
    border-radius: 13.8% / 6.38%; overflow: hidden;
    -webkit-font-smoothing: antialiased;
  }
  .ip-lock .screen { background: var(--wall); color: var(--sfg); }
  .ip-app .screen { background: var(--bg); color: var(--aink); }
  .body { position: absolute; inset: 0; z-index: 2; width: 100%; height: 100%; pointer-events: none; user-select: none; }
  /* the presses are the five items themselves: the body image takes no pointer, so a click reaches the pill under it */

  /* ── the faces (the phone's cqw; the screen is 90.51 of them wide, ≈ 196 tall) */
  .face { position: absolute; inset: 0; display: flex; flex-direction: column; font-size: 3.6cqw; line-height: 1.25; }
  /* the status strip both phones wear: the lock glyph or the time at the left, the battery at the right */
  .sb { position: relative; height: 10.4cqw; flex: none; }
  .lock-g { position: absolute; left: 50%; top: 6.2cqw; width: 2.6cqw; height: 3cqw; margin-left: -1.3cqw; color: currentColor; }
  .lock-g svg { display: block; width: 100%; height: 100%; }
  .sb-t { position: absolute; left: 9cqw; top: 4.4cqw; font-size: 3.6cqw; font-weight: 600; letter-spacing: -0.01em; }
  .batt { position: absolute; right: 8.4cqw; top: 5.2cqw; width: 6cqw; height: 2.9cqw; box-sizing: border-box; border: 0.35cqw solid currentColor; border-radius: 0.9cqw; opacity: 0.9; }
  .batt::after { content: ''; position: absolute; right: -1cqw; top: 0.6cqw; width: 0.5cqw; height: 1.1cqw; background: currentColor; border-radius: 0 0.3cqw 0.3cqw 0; }
  .batt i { position: absolute; inset: 0.35cqw; width: 70%; background: currentColor; border-radius: 0.35cqw; }

  /* THE LOCK SCREEN: the date over the clock (the thin large numerals), the pile under them */
  .date { margin: 2.4cqw 0 0; text-align: center; font-size: 4.2cqw; font-weight: 600; letter-spacing: -0.005em; }
  .clock { margin: -0.6cqw 0 0; text-align: center; font-size: 21cqw; font-weight: 200; line-height: 1.05; letter-spacing: -0.03em; font-variant-numeric: tabular-nums; }
  .pile { list-style: none; margin: 3.2cqw 0 0; padding: 0 2.8cqw; display: flex; flex-direction: column; }
  .ntf {
    position: relative;
    display: grid; grid-template-columns: 9.4cqw minmax(0, 1fr) auto; align-items: center; column-gap: 2.6cqw;
    box-sizing: border-box; margin: 0 0 1.5cqw; padding: 2.4cqw 3cqw 2.5cqw; border-radius: 5.2cqw;
    background: var(--glass); -webkit-backdrop-filter: blur(18px); backdrop-filter: blur(18px); color: var(--glass-ink);
    transition: transform 160ms ease, opacity 600ms ease;
  }
  .ico { display: grid; place-items: center; width: 9.4cqw; height: 9.4cqw; border-radius: 2.4cqw; background: var(--tint); box-shadow: inset 0 0 0 0.3cqw rgba(255, 255, 255, 0.12); }
  .ntf .ico svg { width: 6.4cqw; height: 6.4cqw; }
  .ntf .txt { display: flex; flex-direction: column; min-width: 0; gap: 0.3cqw; }
  .ntf .row { display: flex; align-items: baseline; justify-content: space-between; gap: 2cqw; }
  .ntf .app { font-size: 3.1cqw; font-weight: 600; letter-spacing: 0.005em; }
  .ntf .when { font-size: 2.9cqw; color: var(--glass-dim); white-space: nowrap; }
  .ntf .t { font-size: 3.4cqw; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ntf .b { font-size: 3.4cqw; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .ntf .th { width: 9.6cqw; height: 9.6cqw; border-radius: 2cqw; object-fit: cover; }
  /* THE PRESS: the five that are his. The hit covers the pill; THE TOUCH SIGNAL (one vocabulary with the watch and the
     AudioDex phones): the rim and its inward light breathe on each until it is pressed; hover = still and full */
  .hit { position: absolute; inset: 0; z-index: 2; margin: 0; padding: 0; border: 0; background: transparent; border-radius: inherit; cursor: pointer; -webkit-tap-highlight-color: transparent; }
  .hit:focus-visible { outline: 0.6cqw solid var(--ring-a); outline-offset: 0.3cqw; }
  .ntf.mine::before, .ntf.mine::after { content: ''; position: absolute; inset: 0; border-radius: inherit; pointer-events: none; animation: touch-breathe 2s ease-in-out infinite; transition: opacity 0.35s; }
  .ntf.mine::after {
    box-sizing: border-box; padding: 0.55cqw; background: linear-gradient(135deg, var(--ring-a), var(--ring-b));
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor;
    mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); mask-composite: exclude;
  }
  .ntf.mine::before { box-shadow: inset 1.6cqw 1.6cqw 4cqw color-mix(in oklab, var(--ring-a) 40%, transparent), inset -1.6cqw -1.6cqw 4cqw color-mix(in oklab, var(--ring-b) 40%, transparent); }
  .ntf.mine:has(.hit:hover)::before, .ntf.mine:has(.hit:hover)::after { animation: none; opacity: 1; }
  /* an EXACT COPY of the watch's keyframe (IntakeHero.astro, AudioDexDoor.astro): change both or neither */
  @keyframes touch-breathe { 0%, 100% { opacity: 0.45; } 50% { opacity: 1; } }
  /* a pressed item: lifts, then goes (the flyer carries its picture); its slot closes under it */
  .ntf.lift { transform: scale(1.03); z-index: 3; }
  .ntf.gone { visibility: hidden; }
  .ntf.gone::before, .ntf.gone::after { animation: none; opacity: 0; }
  .ntf.closed { height: 0 !important; margin-bottom: 0; padding-top: 0; padding-bottom: 0; overflow: hidden; }
  .ntf.closing { transition: height 320ms ease, margin 320ms ease, padding 320ms ease; }
  /* after the fifth: the junk fades (600 ms); the phone is quiet */
  .quiet .ntf:not(.mine) { opacity: 0; }
  /* THE MEMO'S STRIP (the fifth press): the notification opens into the wave (the sheet's accent), the clock and the
     words, typed as spoken; sits under the pill's row, full width */
  .mstrip { grid-column: 1 / -1; height: 0; overflow: hidden; transition: height 300ms ease; }
  .mtop { display: flex; align-items: center; gap: 3cqw; padding: 2.6cqw 0.4cqw 1.2cqw; }
  .mwave { display: flex; align-items: center; gap: 1cqw; height: 9cqw; flex: 1; }
  .mwave i { display: block; width: 1.3cqw; border-radius: 0.7cqw; background: var(--acc); transform: scaleY(0.35); }
  .playing .mwave i { animation: ip-bar 1.6s ease-in-out infinite; }
  .mclock { font: 500 3.4cqw/1 var(--mono); font-variant-numeric: tabular-nums; color: var(--glass-dim); }
  .mwords { margin: 0; padding: 0 0.4cqw 1cqw; font-size: 3.6cqw; line-height: 1.35; min-height: calc(3.6cqw * 1.35 * 4); }
  .mwords .w { opacity: 0; transition: opacity 180ms ease; }
  .mwords .w.said { opacity: 1; }
  @keyframes ip-bar { 0%, 100% { transform: scaleY(0.35); } 50% { transform: scaleY(1); } }

  /* THE FLYER: the pressed item's picture on the one arc from the pile to the Stream (host-level, over both bodies);
     its wrap is a container the width of the pile's phone, so the pill's cqw hold on the arc */
  .flyer { position: absolute; left: 0; top: 0; z-index: 6; pointer-events: none; transform-origin: 0 0; container-type: inline-size; }
  .flyer > .ntf { margin: 0; }
  .flyer > .mstrip { box-sizing: border-box; padding: 0 3cqw; border-radius: 5.2cqw; background: var(--glass); color: var(--glass-ink); -webkit-backdrop-filter: blur(18px); backdrop-filter: blur(18px); }

  /* INTAKE (intake_web.py's CSS at the phone's scale: 16px/390 ≈ 4.1cqw of the phone) */
  .nav { display: flex; align-items: center; gap: 1.4cqw; padding: 0.8cqw 3.6cqw 1.4cqw; }
  .brand { font-size: 4.9cqw; font-weight: 700; margin-right: 1cqw; }
  .tab { color: var(--muted); font-size: 3.7cqw; padding: 1.5cqw 3.4cqw; border-radius: 2cqw; border: 1px solid transparent; }
  .tab.on { color: var(--aink); background: var(--surface); border-color: var(--line); }
  .tab.log { margin-left: auto; }
  .feed { position: relative; flex: 1; min-height: 0; padding: 0.6cqw 3.6cqw 0; overflow: hidden; }
  .empty { position: absolute; left: 0; right: 0; top: 10cqw; margin: 0; padding: 0 6cqw; text-align: center; color: var(--muted); font-size: 3.8cqw; transition: opacity 300ms ease; }
  .started .empty { opacity: 0; }
  /* a card as the Stream draws it (article.ticket): the surface, the hairline, the source's 3px spine, 12 radius;
     thead: age · the phone glyph · the check or the kind's chip · the X; the title; the receipt's line or the link
     line; the three tiles on an open card. In the flow unseen until it lands (the list is reserved) */
  .tk {
    box-sizing: border-box; margin: 0 0 1.7cqw; padding: 2.2cqw 3.4cqw 2cqw;
    background: var(--surface); border: 1px solid var(--line); border-left: 0.8cqw solid var(--src, var(--line)); border-radius: 3cqw;
    opacity: 0;
  }
  .tk.in { opacity: 1; transition: opacity 220ms ease; }
  .tk.receipt.in { opacity: 0.85; }
  .thead { display: flex; align-items: center; gap: 2cqw; font-size: 2.95cqw; color: var(--faint); }
  .ph { display: inline-flex; width: 2.8cqw; height: 3.4cqw; margin-left: -0.6cqw; }
  .ph :global(svg), .rc :global(svg), .xb :global(svg), .spark :global(svg), .lk :global(svg) { display: block; width: 100%; height: 100%; }
  .rc { display: inline-flex; width: 3.6cqw; height: 3.6cqw; color: var(--rcpt); }
  .chip { padding: 0.3cqw 1.8cqw; border: 1px solid color-mix(in oklab, var(--kc) 34%, transparent); border-radius: 1.3cqw; font-size: 2.55cqw; font-weight: 600; letter-spacing: 0.07em; text-transform: uppercase; color: var(--kc); }
  .xb { display: inline-flex; width: 4cqw; height: 4cqw; margin-left: auto; color: var(--faint); }
  .tt { margin: 1.3cqw 0 0.7cqw; font-size: 3.9cqw; font-weight: 650; line-height: 1.28; color: var(--aink); text-wrap: pretty; }
  .tk.receipt .tt { margin: 1.2cqw 0 0.3cqw; font-size: 3.8cqw; font-weight: 600; }
  .what { margin: 0.3cqw 0 0; font-size: 3.2cqw; line-height: 1.4; color: var(--faint); }
  .det { margin: 0 0 2.2cqw; font-size: 3.5cqw; color: var(--muted); }
  .mrow { display: flex; align-items: center; gap: 2.8cqw; margin: 0.3cqw 0 2.2cqw; }
  .mrow .det { margin: 0; }
  .dom { display: inline-flex; align-items: center; gap: 1.4cqw; }
  .lk { display: inline-flex; width: 3.4cqw; height: 3.4cqw; color: var(--faint); }
  .mthumb { flex: none; width: 10cqw; height: 10cqw; border-radius: 1.8cqw; object-fit: cover; object-position: 18% 60%; background: var(--s2); }
  .verbs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2cqw; }
  .v { display: flex; align-items: center; justify-content: center; gap: 1.6cqw; min-height: 8.6cqw; padding: 1cqw 1cqw; box-sizing: border-box; background: var(--s2); border: 1px solid var(--line); border-radius: 2.3cqw; font-size: 3.3cqw; color: var(--aink); }
  .v-claude { color: var(--amber); border-color: color-mix(in oklab, var(--amber) 27%, transparent); }
  .spark { display: inline-flex; width: 3.6cqw; height: 3.6cqw; opacity: 0.75; }

  /* ── THE RIBBON: the month at the left edge, then the window of days; each day a fixed cell (the strip's width ÷ the
     visible count), the weekday letter over the numeral (the label face), the bar's row reserved under it. The track
     slides by --c (the centred day's index): 700 ms, eased */
  .ribbon { --vis: 9; --rb-h: 84px; position: relative; height: var(--rb-h); margin-top: 28px; container: ribbon / inline-size; }
  .rb-month { position: absolute; left: 0; top: 0; z-index: 2; margin: 0; font: 500 0.6875rem/1 var(--mono); letter-spacing: 0.12em; text-transform: lowercase; color: var(--dim); transition: opacity 160ms; }
  .rb-win { position: absolute; left: 0; right: 0; top: 20px; height: calc(var(--rb-h) - 20px); overflow: hidden; }
  .rb-track {
    list-style: none; margin: 0; padding: 0; display: flex; height: 100%;
    transform: translateX(calc((var(--vis) / 2 - 0.5 - var(--c, 0)) * 100cqw / var(--vis)));
    transition: transform 700ms cubic-bezier(0.25, 0.8, 0.25, 1);
  }
  .rb-day { position: relative; flex: none; width: calc(100cqw / var(--vis)); display: flex; flex-direction: column; align-items: center; gap: 2px; }
  .rb-w { font: 500 0.625rem/1 var(--mono); letter-spacing: 0.08em; color: var(--dim); }
  .rb-n { display: grid; place-items: center; width: 26px; height: 26px; border-radius: 50%; font: 600 0.8125rem/1 var(--mono); font-variant-numeric: tabular-nums; color: var(--ink); border: 1px solid transparent; }
  .rb-day.today .rb-n { border-color: color-mix(in oklab, var(--ink) 55%, transparent); }
  /* the bar under the numeral: lit by its landing; may run past its day to the right, as a bar does */
  .rb-bar {
    position: absolute; left: 2px; top: 44px; z-index: 1; box-sizing: border-box; padding: 3px 6px; border-radius: 4px; white-space: nowrap;
    max-width: calc(220cqw / var(--vis)); overflow: hidden; text-overflow: ellipsis;
    font: 500 11px/1.2 var(--mono); letter-spacing: 0.01em; background: var(--cal-intake-bg); color: var(--cal-intake-ink);
    opacity: 0; transform: scale(0.7); transform-origin: 0 0; transition: opacity 180ms ease, transform 260ms cubic-bezier(0.2, 0.9, 0.25, 1.15);
  }
  .rb-bar[data-cal='idea'] { background: var(--cal-idea-bg); color: var(--cal-idea-ink); }
  .rb-bar i { font-style: normal; color: var(--cal-intake-time); }
  .rb-bar[data-cal='idea'] i { color: var(--cal-idea-time); }
  .rb-bar[data-on] { opacity: 1; transform: none; }
  @container ipile (max-width: 819px) { .ribbon { --vis: 7; } .rb-bar { font-size: 10.5px; padding-inline: 5px; } }

  /* ── a narrow sheet: the two phones share ONE spot (the lock screen stands; Intake crossfades over it for a beat at
     each landing, the bodies identical, so only the screen changes; after the fifth it stays) */
  @container ipile (max-width: 619px) {
    .ip-pair { grid-template-columns: minmax(0, 76cqw); }
    .ip-phone { grid-area: 1 / 1; transition: opacity 400ms ease; }
    .ip-app { opacity: 0; pointer-events: none; }
    .peek .ip-app, .done .ip-app { opacity: 1; }
    .peek .ip-lock, .done .ip-lock { opacity: 0; pointer-events: none; }
  }

  /* ── the foot: the hint between presses, the runline through each, Replay after the fifth; one slot */
  .foot { display: grid; min-height: 30px; margin-top: 16px; align-items: start; justify-items: center; }
  .foot > * { grid-area: 1 / 1; }
  .hint {
    margin: 0; text-align: center; font: 600 0.6875rem/1.5 var(--mono); letter-spacing: 0.12em;
    color: color-mix(in oklab, var(--sheet-acc, #ff6b4a) var(--hint-mix), var(--sheet-ink, var(--ink)));
    transition: opacity 0.3s, color 560ms ease;
  }
  [data-running] .hint, .done .hint { opacity: 0; }
  /* THE REPLAY: the AudioDex foot carries the same pill (AudioDexDoor's .replay); change both or neither */
  .replay {
    display: inline-flex; align-items: center; gap: 6px; padding: 8px 14px; border: 0; border-radius: 999px;
    background: var(--ink); color: var(--ground); font: 500 0.72rem/1 var(--mono); letter-spacing: 0.04em;
    cursor: pointer; opacity: 0; pointer-events: none; transition: opacity 0.4s, background 120ms, color 560ms ease;
  }
  .replay .ico { width: 1.1em; height: 1.1em; }
  .replay:hover { background: color-mix(in oklab, var(--ink) 82%, var(--ground)); }
  .replay:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
  .done .replay { opacity: 1; pointer-events: auto; transition: opacity 0.6s 0.8s, background 120ms, color 560ms ease; }
  /* "YOU'RE WATCHING" (2026-10-19, Jon: "a super minimalistic progress bar … a casual visual communication that hey,
     you're witnessing something … you don't have to click anything"): one hairline in the foot's slot from the press
     until the run lands, so nothing below moves; the hint's own colour fills it left to right, linearly, over the run's
     planned length (the script's own numbers). In 200 on the press, out 400 at the landing, the Replay on its own delay
     after. Not a control: aria-hidden, no pointer, no label. Reduced motion: none (the run lands at once). EXACT COPY in
     IntakeHero.astro and AudioDexDoor.astro: change both or neither */
  .runline {
    grid-area: 1 / 1; align-self: center; width: 96px; height: 1.5px;
    background: color-mix(in oklab, var(--sheet-ink) 14%, transparent);
    opacity: 0; pointer-events: none; transition: opacity 400ms ease;
  }
  .runline > i {
    display: block; height: 100%; transform: scaleX(0); transform-origin: left;
    background: color-mix(in oklab, var(--sheet-acc) var(--hint-mix), var(--sheet-ink));
  }
  [data-running] .runline { opacity: 1; transition-duration: 200ms; }
  @media (max-width: 899px) { .runline { width: 72px; } }
  @media (prefers-reduced-motion: reduce) { .runline { display: none; } }

  /* a replay puts everything back in one step, no stagger */
  .still .ntf, .still .tk, .still .empty, .still .ip-phone, .still .rb-track, .still .rb-bar, .still .mstrip, .still .mwords .w { transition: none; }
  @media (prefers-reduced-motion: reduce) {
    .ntf.mine::before, .ntf.mine::after { animation: none; opacity: 0.75; }
    .ntf, .tk, .tk.in, .empty, .ip-phone, .rb-track, .rb-bar, .mstrip, .mwords .w, .ntf.closing { transition: none; }
    .playing .mwave i { animation: none; transform: scaleY(0.6); }
  }
</style>

<script>
  /* Drives every [data-ipile]. Plain JS. Five presses sort the phone; nothing starts by itself. */
  const LIFT = 160, FLY = 500, CLOSE = 320, RIBBON_AFTER = 300, SLIDE = 700, STRIP = 300, TICKET_GAP = 300, PEEK_HOLD = 1200, QUIET = 600;
  const ITEM_MS = LIFT + FLY + RIBBON_AFTER + SLIDE - 60;   // ≈ 1,600: a press, end to end
  // the line's fill: from empty to full, linearly, over the run's planned ms (or at once to full, ms 0)
  const fillLine = (fill, ms) => {
    if (!fill) return;
    fill.style.transition = 'none';
    fill.style.transform = ms ? 'scaleX(0)' : 'scaleX(1)';
    if (!ms) return;
    void fill.offsetWidth;
    fill.style.transition = `transform ${ms}ms linear`;
    fill.style.transform = 'scaleX(1)';
  };
  const fmt = (s) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;

  function init(root) {
    if (root.dataset.ready) return;
    root.dataset.ready = '1';
    const status = root.querySelector('[data-status]');
    const replay = root.querySelector('[data-replay]');
    const runFill = root.querySelector('[data-runline] > i');
    const feed = root.querySelector('[data-feed]');
    const cards = Array.from(root.querySelectorAll('[data-card]'));
    const cardOrder = cards.slice();
    const cardOf = (id) => cards.find((c) => c.dataset.card === id);
    const items = Array.from(root.querySelectorAll('.ntf.mine'));
    const ribbon = root.querySelector('[data-ribbon]');
    const track = root.querySelector('[data-track]');
    const monthEl = root.querySelector('[data-month]');
    const months = JSON.parse(root.dataset.months || '[]');
    const today = Number(root.dataset.today) || 0;
    const audio = root.querySelector('[data-clip]');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    const mine = Number(root.dataset.mine) || items.length;
    let timers = [];
    let running = false;
    let sorted = 0;
    let landed = 0;   // cards shown: the next lands under them
    let rafId = 0;
    let lit = 0;
    const later = (ms, fn) => timers.push(window.setTimeout(fn, ms));
    const say = (m) => { if (status) { status.textContent = ''; later(30, () => { status.textContent = m; }); } };
    const narrow = () => root.getBoundingClientRect().width < 620;
    const rel = (el) => { const a = el.getBoundingClientRect(), b = root.getBoundingClientRect(); return { x: a.left - b.left, y: a.top - b.top, w: a.width, h: a.height }; };

    // THE RIBBON: centre a day (by index), light its bar, and let the month at the left edge follow the slide
    const visible = () => parseFloat(getComputedStyle(ribbon).getPropertyValue('--vis')) || 9;
    const monthAt = () => {
      const m = new DOMMatrixReadOnly(getComputedStyle(track).transform);
      const cw = ribbon.getBoundingClientRect().width / visible();
      let i = Math.max(0, Math.round(-m.e / cw));
      let name = '';
      for (let k = i; k >= 0; k--) { if (months[k]) { name = months[k]; break; } }
      if (name && monthEl.textContent !== name) monthEl.textContent = name;
    };
    const follow = (ms) => {
      cancelAnimationFrame(rafId);
      const t0 = performance.now();
      const step = () => { monthAt(); if (performance.now() - t0 < ms) rafId = requestAnimationFrame(step); };
      rafId = requestAnimationFrame(step);
    };
    const slideTo = (i, barId) => {
      ribbon.style.setProperty('--c', String(i));
      const bar = barId ? root.querySelector(`[data-bar="${barId}"]`) : null;
      const light = () => { if (bar) { bar.setAttribute('data-on', ''); bar.style.zIndex = String(2 + ++lit); } };   // the newest bar on top where two meet
      if (reduce.matches) { monthAt(); light(); return; }
      follow(SLIDE + 60);
      later(SLIDE - 120, light);
    };
    const dayIndex = (barId) => {
      const bar = root.querySelector(`[data-bar="${barId}"]`);
      return bar ? Number(bar.closest('[data-i]').dataset.i) : today;
    };

    // THE ONE ARC: the item's picture flies from its place in the pile to the card's place in the Stream and is the
    // card as it lands (the card moves up to the landed group first, so the Stream fills top down)
    const place = (card) => {
      const inFeed = Array.from(feed.querySelectorAll('[data-card]'));
      const lastIn = inFeed.filter((c) => c.classList.contains('in')).pop();
      if (lastIn) lastIn.after(card); else feed.querySelector('.empty').after(card);
    };
    const fly = (fromEl, card, onLand) => {
      place(card);
      root.classList.add('started');
      if (narrow()) root.classList.add('peek');
      if (reduce.matches) { card.classList.add('in'); landed++; onLand && onLand(); return 0; }
      const a = rel(fromEl), b = rel(card);
      const phone = fromEl.closest('.ip-phone');
      const wrap = document.createElement('div');
      for (const at of fromEl.attributes) if (at.name.startsWith('data-astro-cid')) wrap.setAttribute(at.name, '');
      wrap.className = 'flyer';
      wrap.style.width = `${phone.getBoundingClientRect().width}px`;
      const ghost = fromEl.cloneNode(true);
      ghost.classList.remove('mine', 'lift', 'memo');
      ghost.querySelectorAll('.hit, .mstrip').forEach((n) => n.remove());
      ghost.style.width = `${a.w}px`; ghost.style.height = `${a.h}px`;
      ghost.style.setProperty('--tint', getComputedStyle(fromEl).getPropertyValue('--tint'));
      wrap.appendChild(ghost);
      root.appendChild(wrap);
      const s = b.w / a.w;
      const mx = (a.x + b.x) / 2, my = Math.min(a.y, b.y) - 40;
      const anim = wrap.animate([
        { transform: `translate(${a.x}px, ${a.y}px) scale(1)`, opacity: 1 },
        { transform: `translate(${mx}px, ${my}px) scale(${(1 + s) / 2})`, opacity: 1, offset: 0.5 },
        { transform: `translate(${b.x}px, ${b.y}px) scale(${s})`, opacity: 1, offset: 0.8 },
        { transform: `translate(${b.x}px, ${b.y}px) scale(${s})`, opacity: 0 },
      ], { duration: FLY, easing: 'cubic-bezier(0.3, 0.6, 0.3, 1)', fill: 'forwards' });
      later(FLY * 0.72, () => { card.classList.add('in'); landed++; });
      anim.onfinish = () => { wrap.remove(); onLand && onLand(); };
      return FLY;
    };
    // the pressed item lifts, goes, and its slot closes
    const lift = (li) => { li.classList.add('lift'); };
    const close = (li) => {
      li.style.height = `${li.offsetHeight}px`;
      li.classList.add('gone');
      void li.offsetWidth;
      li.classList.add('closing', 'closed');
    };
    const afterPress = (li) => {
      sorted++;
      say(li.dataset.say || '');
      if (sorted >= mine) {
        root.classList.add('quiet');
        later(QUIET, () => { root.classList.add('done'); root.classList.remove('peek'); say(root.dataset.sayDone || ''); });
      } else if (narrow()) {
        later(PEEK_HOLD, () => root.classList.remove('peek'));
      }
      root.removeAttribute('data-running');
      running = false;
    };

    // a plain item: lift → fly → the card; the ribbon 300 ms after a dated landing
    const pressItem = (li) => {
      const card = cardOf((li.dataset.cards || '').split(' ')[0]);
      const land = li.dataset.land;
      const R = reduce.matches;
      const total = R ? 0 : ITEM_MS;
      if (!R) { root.setAttribute('data-running', ''); fillLine(runFill, total); }
      lift(li);
      later(R ? 0 : LIFT, () => {
        fly(li, card, () => {});
        close(li);
        if (land) later(R ? 0 : FLY + RIBBON_AFTER - 60, () => slideTo(dayIndex(land), land));
      });
      later(total, () => afterPress(li));
    };

    // THE MEMO: the strip opens, the words type as spoken (or pace to the sound's length), then the two tickets fly
    // one at a time and the ribbon takes the reminder
    const pressMemo = (li) => {
      const strip = li.querySelector('[data-mstrip]');
      const words = Array.from(li.querySelectorAll('.mwords .w'));
      const clock = li.querySelector('[data-mclock]');
      const ids = (li.dataset.cards || '').split(' ');
      const R = reduce.matches;
      const secs = Number(root.dataset.seconds) || 18;
      let pace = Number(root.dataset.pace) || 400;
      let playMs = words.length * pace;
      if (audio && audio.duration && isFinite(audio.duration)) { playMs = audio.duration * 1000; pace = playMs / words.length; }
      const total = R ? 0 : STRIP + playMs + 200 + LIFT + FLY + TICKET_GAP + FLY + RIBBON_AFTER + SLIDE;
      if (!R) { root.setAttribute('data-running', ''); fillLine(runFill, total); }
      lift(li);
      if (R) {
        words.forEach((w) => w.classList.add('said'));
        ids.forEach((id) => fly(li, cardOf(id)));
        slideTo(dayIndex(li.dataset.land), li.dataset.land);
        close(li);
        later(0, () => afterPress(li));
        return;
      }
      // open the strip to its content's height
      strip.style.height = `${strip.scrollHeight}px`;
      root.classList.add('playing');
      li.classList.remove('lift');
      if (audio) { try { audio.currentTime = 0; audio.play().catch(() => {}); } catch (_) { /* no sound */ } }
      const t0 = performance.now() + STRIP;
      words.forEach((w, k) => later(STRIP + k * pace, () => w.classList.add('said')));
      // the clock paces to the words (the memo's 0:18 over the play), to the sound when there is one
      const tick = () => {
        const f = Math.min(1, (performance.now() - t0) / playMs);
        clock.textContent = fmt(Math.max(0, f) * secs);
        if (f < 1) timers.push(window.setTimeout(tick, 120));
      };
      later(STRIP, tick);
      let t = STRIP + playMs + 200;
      later(t, () => { root.classList.remove('playing'); clock.textContent = fmt(secs); });
      t += LIFT;
      later(t, () => fly(strip, cardOf(ids[0])));
      t += FLY + TICKET_GAP;
      later(t, () => { fly(strip, cardOf(ids[1])); });
      later(t + FLY + RIBBON_AFTER - 60, () => slideTo(dayIndex(li.dataset.land), li.dataset.land));
      later(t + FLY, () => close(li));
      later(total, () => afterPress(li));
    };

    const press = (li) => {
      if (running || li.classList.contains('gone')) return;
      running = true;
      if (li.classList.contains('memo')) pressMemo(li); else pressItem(li);
    };

    const reset = () => {
      timers.forEach(clearTimeout); timers = [];
      cancelAnimationFrame(rafId);
      root.classList.add('still');
      root.classList.remove('started', 'quiet', 'done', 'peek', 'playing');
      root.removeAttribute('data-running');
      root.querySelectorAll('.flyer').forEach((f) => f.remove());
      items.forEach((li) => { li.classList.remove('lift', 'gone', 'closing', 'closed'); li.style.height = ''; });
      root.querySelectorAll('.mwords .w').forEach((w) => w.classList.remove('said'));
      const strip = root.querySelector('[data-mstrip]'); if (strip) strip.style.height = '';
      const clock = root.querySelector('[data-mclock]'); if (clock) clock.textContent = '0:00';
      if (audio) { try { audio.pause(); audio.currentTime = 0; } catch (_) { /* fine */ } }
      // the cards back to their resting order, unseen
      cards.forEach((c) => c.classList.remove('in'));
      cardOrder.forEach((c) => feed.appendChild(c));
      root.querySelectorAll('[data-bar]').forEach((b) => { b.removeAttribute('data-on'); b.style.zIndex = ''; });
      lit = 0;
      ribbon.style.setProperty('--c', String(today));
      monthAt();
      void root.offsetWidth;
      root.classList.remove('still');
      sorted = 0; landed = 0; running = false;
    };

    items.forEach((li) => { const b = li.querySelector('[data-press]'); if (b) b.addEventListener('click', () => press(li)); });
    if (replay) replay.addEventListener('click', reset);
    monthAt();
  }
  const all = () => document.querySelectorAll('[data-ipile]').forEach(init);
  all();
  document.addEventListener('astro:page-load', all);
</script>
