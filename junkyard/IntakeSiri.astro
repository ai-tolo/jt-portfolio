---
// junkyard/IntakeSiri.astro — A RECORD, NOT A PART (retired 2026-10-22, round seven of the catch-all).
// THE SIRI MODULE of round six (IntakeProof.astro, 2026-10-22): the orb and Siri's real reply to the wedding sentence,
// drawn on the paper with no phone and no frame ("There's nothing called “no longer going to the wedding” on your
// calendar.", verbatim from Jon's screenshot of 2026-10-15). Jon's thesis in round seven ("a catch-all system that
// doesn't care about the location or medium of how the information is getting into the system") made the fold's
// second answer BY HAND (what the sentence costs in the Calendar app) instead of Siri; the markup and CSS are kept
// here as they stood. Its import no longer resolves from here.
const siri = "There's nothing called “no longer going to the wedding” on your calendar.";
---
<div class="pf-side">
  <p class="sheet-t">Siri</p>
  <div class="siri">
    <span class="orb" aria-hidden="true"></span>
    <p class="siri-t">{siri}</p>
  </div>
</div>

<style>
  /* ── SIRI: the orb, then the reply, iOS's grammar on the paper (the system face), nothing else */
  .siri { flex: 1; display: flex; flex-direction: column; align-items: flex-start; gap: 14px; padding-top: 2px; }
  .orb {
    width: 30px; height: 30px; border-radius: 50%; flex: none;
    background:
      radial-gradient(circle at 36% 34%, rgba(255, 255, 255, 0.95) 0, rgba(255, 255, 255, 0.55) 22%, rgba(255, 255, 255, 0) 52%),
      conic-gradient(from 210deg, #ff5fa2, #8a5cf6 30%, #47b6ff 55%, #5ee6c6 72%, #ff8a5b 88%, #ff5fa2);
    box-shadow: 0 0 0 1px color-mix(in oklab, #8a5cf6 22%, transparent), 0 4px 14px color-mix(in oklab, #47b6ff 28%, transparent);
  }
  .siri-t {
    margin: 0; max-width: 30ch;
    font: 500 1.0625rem/1.4 -apple-system, system-ui, 'Instrument Sans', 'Helvetica Neue', sans-serif;
    letter-spacing: -0.005em; text-wrap: pretty;
    color: var(--mx-ink, var(--sheet-ink));
    transition: color 560ms ease;
  }
</style>
