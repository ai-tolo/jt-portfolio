# Notion integration token. Internal integration secret; starts with "ntn_"
# or "secret_". Create at https://www.notion.so/profile/integrations and
# share your Case Studies and Resumes databases with the integration.
NOTION_TOKEN=

# Case Studies database ID. Reference only. The consuming data-source IDs
# are constants in src/lib/notion.ts and src/lib/resumes.ts. Swap them when
# forking against your own Notion workspace.
NOTION_DATABASE_ID=00000000-0000-0000-0000-000000000000

# --- The Console (private /portal route) ---
# Base URL of the Build 1 M1 brain API. Tailscale hostname; never exposed to
# the browser (the Astro server-side proxy at /api/console/* handles all
# fetches).
CONSOLE_API_BASE=http://macbook-pro-tolo:8765

# Shared password for the /portal/login form. Single user, single password.
# In production this lives in Vercel project env vars; never commit.
CONSOLE_PASSWORD=

# HMAC secret for signing the portal_session cookie. Generate locally with:
#   openssl rand -hex 32
# Different value in local .env and Vercel. Rotating it invalidates every
# existing session (forces re-login).
CONSOLE_SESSION_SECRET=

# Shared API key the Astro server sends as `Authorization: Bearer <key>` to
# the M1 brain. Same value must live on the M1 (in the launchd plist env vars).
# Without this, a leaked Tailscale Funnel URL exposes Jon's personal catalog.
CONSOLE_API_KEY=
